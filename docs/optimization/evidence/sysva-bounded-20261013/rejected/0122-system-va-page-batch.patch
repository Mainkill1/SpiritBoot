--- a/ntoskrnl/xb/mm/pagesupply.c
+++ b/ntoskrnl/xb/mm/pagesupply.c
@@ -279,6 +279,45 @@ NxkPageSupplyTakeTitleZero(ULONG Color)
     return Pfn;
 }
 
+/* SYSVA keeps these frames ownerless and private until its zero/publication
+ * transaction completes. A short batch is normal, not exhaustion: append
+ * only constant-time takes after the first existing allocator search. */
+ULONG
+NxkPageSupplyTakeSystemBatch(PFN_NUMBER *Pages, ULONG Wanted)
+{
+    PFN_NUMBER Pfn;
+    ULONG Count = 0;
+
+    MI_ASSERT_PFN_LOCK_HELD();
+    ASSERT(Wanted != 0 && Wanted <= 16);
+#if XBOX_RESERVE_UPPER_RAM
+    Pfn = NxkPageSupplyTakeTitleAny(0);
+#else
+    Pfn = NxkPageSupplyTakeAny(0);
+#endif
+    if (Pfn == 0) return 0;
+    Pages[Count++] = Pfn;
+    while (Count < Wanted)
+    {
+#if XBOX_RESERVE_UPPER_RAM
+        /* Title data cannot spill into firmware-reserved upper RAM.
+         * Preserve ascending placement, stopping before another scan. */
+        if (Pfn + 1 >= (NXK_KSEG0_RAM_SIZE >> PAGE_SHIFT) ||
+            !(NxpLinks[Pfn + 1] & NXP_FREE)) break;
+        Pfn++;
+        NxpSpillHint = Pfn;
+#else
+        /* A kernel-class take is O(1). Never aggregate title spill
+         * searches under one lock, including at the class boundary. */
+        if (NxpFreeHeadKernel == 0) break;
+        Pfn = NxpFreeHeadKernel;
+#endif
+        NxpUnlink(Pfn);
+        Pages[Count++] = Pfn;
+    }
+    return Count;
+}
+
 PFN_NUMBER
 NTAPI
 NxkPageSupplyTitleAvailable(VOID)
@@ -851,6 +890,17 @@ NxkPageSupplyTakeTitleZero(ULONG Color)
     return NxkPageSupplyTakeZero(Color);
 }
 
+ULONG
+NxkPageSupplyTakeSystemBatch(PFN_NUMBER *Pages, ULONG Wanted)
+{
+    PFN_NUMBER Pfn;
+    ASSERT(Wanted != 0 && Wanted <= 16);
+    Pfn = NxkPageSupplyTakeAny(0);
+    if (Pfn == 0) return 0;
+    Pages[0] = Pfn;
+    return 1;
+}
+
 PFN_NUMBER
 NTAPI
 NxkPageSupplyTitleAvailable(VOID)
