diff --git a/tests/xbe/mm-system-transaction/main.c b/tests/xbe/mm-system-transaction/main.c
new file mode 100644
index 00000000..5efc4336
--- /dev/null
+++ b/tests/xbe/mm-system-transaction/main.c
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include <string.h>
+#include "regression.h"
+
+static void system_case(ULONG pages, ULONG protect)
+{
+    SIZE_T size = pages * 4096;
+    PUCHAR p = MmAllocateSystemMemory(size, protect);
+    regression_require(p != NULL, "system allocation succeeds");
+    BOOLEAN zero = TRUE;
+    for (SIZE_T i = 0; i < size; ++i) if (p[i]) { zero = FALSE; break; }
+    regression_check(zero, "entire system allocation is zero");
+    if (protect == PAGE_READWRITE) {
+        memset(p, 0x5a, size);
+        regression_check(p[0] == 0x5a && p[size - 1] == 0x5a,
+                         "system allocation is writable through both ends");
+    }
+    tap_comment("system pages=%lu protect=%lu VA=%p PA=%08lx", pages, protect,
+                p, (ULONG)MmGetPhysicalAddress(p));
+    regression_check(MmFreeSystemMemory(p, size) == pages, "system free returns exact page count");
+}
+
+static BOOLEAN verify_bytes(const UCHAR *p, ULONG size, UCHAR salt)
+{
+    for (ULONG i = 0; i < size; ++i) if (p[i] != (UCHAR)(i ^ salt)) return FALSE;
+    return TRUE;
+}
+
+/* A 1 MiB window surrounding a live page can include unrelated immovable
+ * kernel frames. Pin only the observed page: success now proves relocation
+ * admission and byte preservation rather than a layout-dependent diagnostic. */
+static void relocate_case(BOOLEAN pool)
+{
+    PVOID memory = NULL;
+    SIZE_T size = 4096;
+    if (pool) memory = ExAllocatePoolWithTag(size, 'rSyN');
+    else regression_require(NT_SUCCESS(NtAllocateVirtualMemory(&memory, 0, &size,
+                                      MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)),
+                            "reserve and commit relocation page");
+    regression_require(memory != NULL, "live relocation allocation succeeds");
+    PUCHAR p = memory;
+    for (ULONG i = 0; i < 4096; ++i) p[i] = (UCHAR)(i ^ 0x79);
+    ULONG before = (ULONG)MmGetPhysicalAddress(p) & ~4095UL;
+    regression_require(before && before < 0x04000000, "relocation page is inside retail physical window");
+    PVOID pin = MmAllocateContiguousMemoryEx(4096, before, before + 4095, 0, PAGE_READWRITE);
+    regression_check(pin != NULL, "exact live-page contiguous request succeeds");
+    ULONG after = (ULONG)MmGetPhysicalAddress(p) & ~4095UL;
+    regression_check(after != before, "live page moves outside requested exact frame");
+    regression_check(verify_bytes(p, 4096, 0x79), "all live-page bytes survive relocation");
+    if (pin) {
+        regression_check(((ULONG)MmGetPhysicalAddress(pin) & ~4095UL) == before,
+                         "contiguous allocation owns the requested old frame");
+        memset(pin, 0xaa, 4096);
+        regression_check(verify_bytes(p, 4096, 0x79), "old-frame writes cannot alter relocated live bytes");
+        MmFreeContiguousMemory(pin);
+    }
+    tap_comment("relocation kind=%s old=%08lx new=%08lx pin=%p", pool ? "pool" : "VM", before, after, pin);
+    if (pool) ExFreePool(memory);
+    else { size = 0; regression_check(NT_SUCCESS(NtFreeVirtualMemory(&memory, &size, MEM_RELEASE)),
+                                     "release relocated VM allocation"); }
+}
+
+static void pinned_case(void)
+{
+    PVOID memory = NULL; SIZE_T size = 4096;
+    regression_require(NT_SUCCESS(NtAllocateVirtualMemory(&memory, 0, &size,
+                            MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)), "commit pinned VM page");
+    memset(memory, 0x6b, 4096);
+    ULONG before = (ULONG)MmGetPhysicalAddress(memory) & ~4095UL;
+    MmLockUnlockBufferPages(memory, 4096, FALSE);
+    PVOID pin = MmAllocateContiguousMemoryEx(4096, before, before + 4095, 0, PAGE_READWRITE);
+    regression_check(pin == NULL, "physical pin blocks live-page relocation");
+    regression_check(((ULONG)MmGetPhysicalAddress(memory) & ~4095UL) == before &&
+                     ((PUCHAR)memory)[4095] == 0x6b, "pinned page stays at same physical frame with intact bytes");
+    if (pin) MmFreeContiguousMemory(pin);
+    MmLockUnlockBufferPages(memory, 4096, TRUE);
+    size = 0; NtFreeVirtualMemory(&memory, &size, MEM_RELEASE);
+}
+
+static void pressure_case(void)
+{
+    /* Force supply failure after earlier batches, while retaining existing
+     * live data. The public fallback may also return NULL; do not infer its
+     * internal failure stage from the public status alone. */
+    PUCHAR witness = MmAllocateSystemMemory(17 * 4096, PAGE_READWRITE);
+    regression_require(witness != NULL, "pressure witness allocation succeeds");
+    memset(witness, 0xc7, 17 * 4096);
+    MM_STATISTICS stats = { .Length = sizeof(MM_STATISTICS) };
+    regression_require(NT_SUCCESS(MmQueryStatistics(&stats)), "query supply before exhaustion");
+    SIZE_T request = ((SIZE_T)stats.AvailablePages + 32) * 4096;
+    regression_require(request < 64 * 1024 * 1024, "exhaustion request fits system aperture");
+    PVOID huge = MmAllocateSystemMemory(request, PAGE_READWRITE);
+    regression_check(huge == NULL, "oversized system request fails cleanly on 64 MiB setup");
+    if (huge) MmFreeSystemMemory(huge, request);
+    BOOLEAN intact = TRUE;
+    for (ULONG i = 0; i < 17 * 4096; ++i) if (witness[i] != 0xc7) { intact = FALSE; break; }
+    regression_check(intact, "failed request preserves neighboring live allocation");
+    regression_check(MmFreeSystemMemory(witness, 17 * 4096) == 17, "witness free returns exact page count");
+    system_case(17, PAGE_READWRITE);
+}
+
+int main(void)
+{
+    regression_begin();
+    MM_STATISTICS stats = { .Length = sizeof(MM_STATISTICS) };
+    regression_require(NT_SUCCESS(MmQueryStatistics(&stats)), "query memory profile");
+    regression_require(stats.TotalPhysicalPages <= 16384, "fixture runs on pinned 64 MiB profile");
+    ULONG counts[] = {1, 2, 8, 9, 16, 17, 1024, 1025, 4096};
+    for (unsigned i = 0; i < sizeof(counts) / sizeof(counts[0]); ++i) system_case(counts[i], PAGE_READWRITE);
+    system_case(17, PAGE_READONLY);
+    relocate_case(FALSE); relocate_case(TRUE); pinned_case(); pressure_case();
+    regression_finish();
+}
diff --git a/tests/xbe/mm-system-transaction/regression.h b/tests/xbe/mm-system-transaction/regression.h
new file mode 100644
index 00000000..305b1f1f
--- /dev/null
+++ b/tests/xbe/mm-system-transaction/regression.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "tap.h"
+#include <xboxkrnl/xboxkrnl.h>
+
+static unsigned regression_checks, regression_failures;
+
+static void regression_begin(void)
+{
+    tap_version(14);
+}
+
+static void regression_check(int passed, const char *description)
+{
+    ++regression_checks;
+    if (passed) {
+        tap_ok(regression_checks, description);
+    } else {
+        ++regression_failures;
+        tap_not_ok(regression_checks, description);
+    }
+}
+
+static void regression_finish(void) __attribute__((noreturn));
+static void regression_finish(void)
+{
+    LARGE_INTEGER delay = { .QuadPart = -5000000 };
+    tap_comment("checks=%u failures=%u", regression_checks, regression_failures);
+    tap_plan(regression_checks);
+    tap_drain();
+    KeDelayExecutionThread(KernelMode, FALSE, &delay);
+    HalWriteSMBusValue(0x20, 0x02, FALSE, 0x80);
+    /* A failed shutdown remains a timeout, never a passing capture. */
+    for (;;) __asm__ __volatile__("hlt");
+}
+
+static inline void regression_require(int passed, const char *description)
+{
+    regression_check(passed, description);
+    if (!passed) regression_finish();
+}
diff --git a/tests/xbe/mm-system-transaction/tap.c b/tests/xbe/mm-system-transaction/tap.c
new file mode 100644
index 00000000..009bb8a8
--- /dev/null
+++ b/tests/xbe/mm-system-transaction/tap.c
@@ -0,0 +1,166 @@
+/*
+ * TAP 14 emitter.  Bytes go out the LPC47M157 SuperIO's COM1 at 115200 8N1
+ * (I/O 0x3F8).  We program the UART ourselves at first call so the suite
+ * works against both nxkrnl (which already programs it for DbgPrint) and
+ * the retail kernel (which doesn't).  isa-debugcon (port 0xE9) was the
+ * historical target but the upstream xemu AppImage builds without it.
+ */
+
+#include "tap.h"
+#include <stdio.h>
+#include <stdarg.h>
+
+#define COM1     0x3F8
+#define COM1_THR (COM1 + 0)
+#define COM1_DLL (COM1 + 0)
+#define COM1_IER (COM1 + 1)
+#define COM1_DLH (COM1 + 1)
+#define COM1_LCR (COM1 + 3)
+#define COM1_MCR (COM1 + 4)
+#define COM1_LSR (COM1 + 5)
+
+#define LSR_THRE 0x20  /* transmit holding register empty */
+#define LSR_TEMT 0x40  /* transmitter empty (shift + holding both drained) */
+#define LCR_DLAB 0x80
+#define LCR_8N1  0x03
+
+static inline void outb(unsigned short port, unsigned char val)
+{
+    __asm__ __volatile__("outb %0, %1" : : "a"(val), "Nd"(port));
+}
+
+static inline unsigned char inb(unsigned short port)
+{
+    unsigned char ret;
+    __asm__ __volatile__("inb %1, %0" : "=a"(ret) : "Nd"(port));
+    return ret;
+}
+
+/* Xbox is single-CPU: prevent a scheduled kernel/debug writer from entering
+ * between bytes. Restore the caller's full flags, including an already-clear
+ * IF. Formatting stays outside this span; no kernel-private lock is borrowed. */
+static inline unsigned int tap_irq_save(void)
+{
+    unsigned int flags;
+    __asm__ __volatile__("pushfl; popl %0; cli" : "=r"(flags) : : "memory");
+    return flags;
+}
+
+static inline void tap_irq_restore(unsigned int flags)
+{
+    __asm__ __volatile__("pushl %0; popfl" : : "r"(flags) : "memory", "cc");
+}
+
+static void com_init(void)
+{
+    static int initialized = 0;
+    if (initialized) return;
+    initialized = 1;
+    outb(COM1_IER, 0x00);             /* disable all interrupts */
+    outb(COM1_LCR, LCR_DLAB);         /* DLAB=1 to set divisor */
+    outb(COM1_DLL, 0x01);             /* 115200 baud (1.8432 MHz / 16 / 1) */
+    outb(COM1_DLH, 0x00);
+    outb(COM1_LCR, LCR_8N1);          /* DLAB=0, 8N1 */
+    /* Retain the existing FIFO mode and queued bytes. THRE polling works
+     * with either the reset/default UART or a kernel-configured FIFO; changing
+     * FIFO enable or clearing it could discard the preceding debug message. */
+    outb(COM1_MCR, 0x0B);             /* DTR + RTS + OUT2 */
+}
+
+static void com_putc(char c)
+{
+    while ((inb(COM1_LSR) & LSR_THRE) == 0) { }
+    outb(COM1_THR, (unsigned char)c);
+}
+
+void tap_drain(void)
+{
+    while ((inb(COM1_LSR) & LSR_TEMT) == 0) { }
+}
+
+static void com_puts(const char *s)
+{
+    unsigned int flags = tap_irq_save();
+    com_init();
+    while (*s) com_putc(*s++);
+    tap_irq_restore(flags);
+}
+
+static void com_vprintf(const char *fmt, va_list ap)
+{
+    char buf[256];
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_puts(buf);
+}
+
+static void com_printf(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    com_vprintf(fmt, ap);
+    va_end(ap);
+}
+
+void tap_puts(const char *s)
+{
+    com_puts(s);
+}
+
+void tap_version(unsigned int v)
+{
+    com_printf("TAP version %u\n", v);
+}
+
+void tap_plan(unsigned int n)
+{
+    com_printf("1..%u\n", n);
+}
+
+void tap_ok(unsigned int n, const char *desc)
+{
+    com_printf("ok %u - %s\n", n, desc);
+}
+
+void tap_not_ok(unsigned int n, const char *desc)
+{
+    com_printf("not ok %u - %s\n", n, desc);
+}
+
+void tap_diag_begin(void)
+{
+    com_puts("  ---\n");
+}
+
+void tap_diag_end(void)
+{
+    com_puts("  ...\n");
+}
+
+void tap_diag_kv(const char *key, const char *fmt, ...)
+{
+    char buf[192];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_printf("  %s: %s\n", key, buf);
+}
+
+void tap_comment(const char *fmt, ...)
+{
+    char buf[192];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_printf("# %s\n", buf);
+}
diff --git a/tests/xbe/mm-system-transaction/tap.h b/tests/xbe/mm-system-transaction/tap.h
new file mode 100644
index 00000000..0f39d98a
--- /dev/null
+++ b/tests/xbe/mm-system-transaction/tap.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <stdarg.h>
+#include <stdbool.h>
+
+void tap_version(unsigned int v);
+void tap_plan(unsigned int n);
+void tap_ok(unsigned int n, const char *desc);
+void tap_not_ok(unsigned int n, const char *desc);
+
+/* Open / close a YAML diagnostic block underneath a `not ok` line. */
+void tap_diag_begin(void);
+void tap_diag_end(void);
+void tap_diag_kv(const char *key, const char *fmt, ...);
+
+void tap_comment(const char *fmt, ...);
+
+/* Drop a raw string verbatim (no formatting / framing).  Used for the
+ * "== api-regression begin ==" / "== ... end ==" markers in main.c so
+ * the runner can slice the TAP block out of the surrounding kernel
+ * debug stream. */
+void tap_puts(const char *s);
+
+/* Block until the UART transmitter is fully drained.  Call before
+ * issuing an SMC shutdown so the final bytes aren't lost. */
+void tap_drain(void);
