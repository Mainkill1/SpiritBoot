+    CHECK(complete_child(STATUS_SUCCESS,512,1)==STATUS_MORE_PROCESSING_REQUIRED);
+    CHECK(read.irp.host_completed&&read.irp.IoStatus.Status==STATUS_SUCCESS&&
+          read.irp.IoStatus.Information==512);
+
+    init_parent(&cancelled,IRP_MJ_READ,512);
+    cancelled.irp.Flags|=IRP_XBOX_DEFER_NATIVE_READ;
+    CHECK(NxNativeDispatchReadWrite(device,&cancelled.irp)==STATUS_PENDING);
