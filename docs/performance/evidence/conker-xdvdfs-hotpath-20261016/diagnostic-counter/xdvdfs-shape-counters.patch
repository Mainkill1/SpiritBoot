 static XDVD_GLOBALS XdvdGlobals;
 
 /*
+ * Diagnostic-only release build counters.  Index zero counts validated file
+ * read dispatches; indexes 1-15 are mutually exclusive terminal decisions in
+ * the frozen Rust model's order; index 16 is the noncached subset of eligible
+ * reads.  This patch is never part of the product series.
+ */
+enum XDVD_SHAPE_COUNTER
+{
+    XdvdShapeTotal = 0,
+    XdvdShapeCompleteZero,
+    XdvdShapeNegativeOffset,
+    XdvdShapeDiscRange,
+    XdvdShapeSectorShape,
+    XdvdShapePaging,
+    XdvdShapeAssociated,
+    XdvdShapeNoLowerStack,
+    XdvdShapeMissingMdl,
+    XdvdShapeChainedMdl,
+    XdvdShapeUnprovedResidency,
+    XdvdShapeInvalidPfnSpan,
+    XdvdShapeMdlTooShort,
+    XdvdShapeBufferRange,
+    XdvdShapeBufferAlignment,
+    XdvdShapeEligible,
+    XdvdShapeEligibleNoncached,
+    XdvdShapeCounterCount
+};
+
+DECLSPEC_ALIGN(64) volatile ULONG XdvdShapeCounters[XdvdShapeCounterCount];
+
+
