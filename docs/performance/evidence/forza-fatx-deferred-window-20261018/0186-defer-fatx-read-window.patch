+/* Deterministically vary window-overflow release, timer release, ordinary
+ * FIFO boundaries, and cancellation.  With spare transport slots, the number of
+ * calls reaching the lower driver is an external invariant for the model's
+ * held-tail count after every transition. */
+static int randomized_batch_state_machine_preserves_waiting_model(void)
+{
+    enum { ROUNDS=64, PARENTS=1024 };
+    PDEVICE_OBJECT d=make_device(16);
+    parent_fixture parents[PARENTS];
+    parent_fixture *held[13];
+    uint32_t random=0x185a11ceu;
+    unsigned used=0;
+    lower_pending=1;pending_child_count=0;lower_calls=cancel_calls=0;
+    armed_timer_count=timer_set_calls=queued_dpc_count=0;
+    for(unsigned round=0;round<ROUNDS;++round) {
+        unsigned waiting=0,expected_lower=lower_calls;
+        unsigned initial=1+((random=random*1664525u+1013904223u)>>31);
+        CHECK(!armed_timer_count&&!queued_dpc_count&&!pending_child_count);
+        for(unsigned i=0;i<initial;++i) {
+            parent_fixture *parent=&parents[used++];
+            init_parent(parent,IRP_MJ_READ,4096);
+            parent->stack.Parameters.Read.ByteOffset=(int64_t)(used%128)*4096;
+            parent->irp.Flags=IRP_XB_FATX_BATCHED_READ;
+            CHECK(NxNativeDispatchReadWrite(d,&parent->irp)==STATUS_PENDING);
+            held[waiting++]=parent;
+            CHECK(lower_calls==expected_lower);
+        }
+        random=random*1664525u+1013904223u;
+        if((random&1)&&waiting) {
+            unsigned pick=(random>>8)%waiting;
+            cancel_parent=&held[pick]->irp;cancel_now();cancel_parent=NULL;
+            CHECK(held[pick]->irp.host_completed&&
+                  held[pick]->irp.IoStatus.Status==STATUS_CANCELLED);
+            held[pick]=held[--waiting];
+            CHECK(lower_calls==expected_lower&&!cancel_calls);
+        }
+        random=random*1664525u+1013904223u;
+        switch((random>>16)&3) {
+        case 0:
+            while(waiting<13) {
+                parent_fixture *parent=&parents[used++];
+                init_parent(parent,IRP_MJ_READ,4096);
+                parent->stack.Parameters.Read.ByteOffset=(int64_t)(used%128)*4096;
+                parent->irp.Flags=IRP_XB_FATX_BATCHED_READ;
+                CHECK(NxNativeDispatchReadWrite(d,&parent->irp)==STATUS_PENDING);
+                held[waiting++]=parent;
+                if(waiting<13) CHECK(lower_calls==expected_lower);
+            }
+            expected_lower+=waiting;waiting=0;
+            CHECK(lower_calls==expected_lower);
+            break;
+        case 1:
+            fire_timers();expected_lower+=waiting;waiting=0;
+            CHECK(lower_calls==expected_lower);
+            break;
+        case 2: {
+            parent_fixture *barrier=&parents[used++];
+            init_parent(barrier,IRP_MJ_WRITE,4096);
+            CHECK(NxNativeDispatchReadWrite(d,&barrier->irp)==STATUS_PENDING);
+            expected_lower+=waiting+1;waiting=0;
+            CHECK(lower_calls==expected_lower);
+            break;
+        }
+        default:
+            while(waiting) {
+                parent_fixture *parent=held[--waiting];
+                cancel_parent=&parent->irp;cancel_now();cancel_parent=NULL;
+                CHECK(parent->irp.host_completed&&
+                      parent->irp.IoStatus.Status==STATUS_CANCELLED);
+                CHECK(lower_calls==expected_lower&&!cancel_calls);
+            }
+            break;
+        }
+        while(pending_child_count)
+            CHECK(complete_specific_child(pending_children[0],STATUS_SUCCESS,4096,1)==
+                  STATUS_MORE_PROCESSING_REQUIRED);
+        fire_timers();
+        CHECK(lower_calls==expected_lower&&!armed_timer_count&&!queued_dpc_count);
+    }
+    for(unsigned i=0;i<used;++i) CHECK(parents[i].irp.host_completed);
+    CHECK(used<=PARENTS);
+    lower_pending=0;return 1;
+}
