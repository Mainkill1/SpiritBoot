+/* Open a bounded prefix of the marked tail already owned by the ordinary
+ * FIFO.  A finite limit keeps each timer callback short; UINT32_MAX is used by
+ * an ordering boundary that must expose the complete preceding read prefix. */
+static void release_waiting_batch_locked(NX_NATIVE_ADAPTER *adapter,unsigned limit)
+{
+    NX_NATIVE_ENVELOPE *cursor;
+    unsigned released=0;
+    for(cursor=adapter->waiting_head;cursor && released<limit;
+        cursor=cursor->next_waiting) {
+        if(!cursor->batch_wait) continue;
+        cursor->batch_wait=0;
+        ++released;
+    }
+    if(released>adapter->batch_waiting) adapter->batch_waiting=0;
+    else adapter->batch_waiting-=released;
