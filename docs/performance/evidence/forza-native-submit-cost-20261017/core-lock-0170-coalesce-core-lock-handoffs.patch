+/* Cost invariant: callers transfer pump ownership with the lock they already
+ * hold. The transport lock assertions above independently enforce boundaries. */
+static int owner_handoff_cost(unsigned route)
+{
+    fixture f; nx_config cfg=config(); CHECK(init(&f,&cfg)); f.delayed=1;
+    parent p=fresh(); nx_handle h; nx_request r=request(&f,&p,NX_READ,0,512);
+    unsigned before=f.lock_entries;
+    CHECK(nx_start(&f.dev,&r,&h)==NX_PENDING);
+    if(route==0) CHECK(f.lock_entries-before==4);
+    if(route==1) {
+        before=f.lock_entries; finish_held(&f,h.slot,NX_OK,512,0);
+        CHECK(f.lock_entries-before==3);
+        CHECK(p.completions==1 && p.status==NX_OK && p.bytes==512);
+    } else {
+        if(route==2 || route==3) {
+            before=f.lock_entries;
+            if(route==2) nx_cancel(&f.dev,h); else nx_quarantine(&f.dev);
+            CHECK(f.lock_entries-before==2);
+            CHECK(f.cancels==1 && !p.completions && f.held_live[h.slot]);
+        }
+        finish_held(&f,h.slot,NX_OK,512,0);
+        CHECK(p.completions==1 && p.bytes==512);
+    }
+    CHECK(!f.lock_depth && !f.dev.pumping); cleanup(&f); return 1;
+}
+static int start_transfers_owned_lock(void) { return owner_handoff_cost(0); }
+static int lower_done_transfers_owned_lock(void) { return owner_handoff_cost(1); }
+static int cancel_transfers_owned_lock(void) { return owner_handoff_cost(2); }
+static int quarantine_transfers_owned_lock(void) { return owner_handoff_cost(3); }
+static int completion_at_idle_release_is_not_lost(void)
+{
+    fixture f; nx_config cfg=config(); CHECK(init(&f,&cfg));
+    f.delayed=1; f.inject_idle_done=1;
+    parent p=fresh(); nx_handle h; nx_request r=request(&f,&p,NX_READ,0,512);
+    CHECK(nx_start(&f.dev,&r,&h)==NX_PENDING);
+    CHECK(!f.inject_idle_done && p.completions==1 && p.status==NX_OK && p.bytes==512);
+    CHECK(p.pending==1 && !f.lock_depth && !f.dev.pumping);
+    cleanup(&f); return 1;
+}
