+/* Diagnostic-only: account for HDD DMA, which bypasses bmdma_rw_buf. */
+static void ide_trace_dma_payload(IDEState *s, const char *stage, int ret)
+{
+    uint64_t offset = (uint64_t)ide_get_sector(s) * BDRV_SECTOR_SIZE;
+    uint8_t data[512];
+
+    if (!trace_event_get_state_backends(TRACE_IDE_DMA_PAYLOAD)) {
+        return;
+    }
+    for (int i = 0; i < s->sg.nsg; i++) {
+        dma_addr_t addr = s->sg.sg[i].base;
+        dma_addr_t left = s->sg.sg[i].len;
+        while (left) {
+            size_t size = MIN(left, sizeof(data));
+            MemTxResult tx = dma_memory_read(s->sg.as, addr, data, size,
