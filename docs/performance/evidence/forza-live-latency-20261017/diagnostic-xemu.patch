+/* Local diagnostic. Function PCs and optimized calling conventions were checked
+ * against add882b6's xboxkrnl.unstripped.exe. No guest memory is written. */
+static uint32_t spirit_read32(CPUX86State *env, uint32_t address)
+{
+    uint8_t bytes[4];
+    if (!address || cpu_memory_rw_debug(env_cpu(env), address, bytes, 4, false)) {
+        return 0;
+    }
+    return ldl_le_p(bytes);
+}
+
+void helper_spirit_menu_trace(CPUX86State *env, uint32_t pc)
+{
+    uint32_t a[10], esp=env->regs[R_ESP], ctx=0, irp=0, fo=0, sl=0;
+    const char *kind="unknown";
+    bool returning=false;
+    for (int i=0;i<10;i++) a[i]=spirit_read32(env,esp+i*4);
+    switch (pc) {
+    case 0x8402695c: kind="title_apc_dispatch"; break;
+    case 0x001103e0: kind="world_completion_callback"; break;
+    case 0x84022cec: kind="memory_statistics_query"; break;
+    case 0x84026ac8: kind="wait_single_ex"; break;
+    case 0x840269a4: kind="wait_multiple_ex"; break;
+    case 0x8401989c: kind="delay_thread"; break;
+
+    case 0x84027730: kind="_NxMmAllocateContiguousMemory@4"; break;
+    case 0x84027764: kind="_NxMmAllocateContiguousMemoryEx@20"; break;
+    case 0x84043eac: kind="_VfatTryMapRead"; break;
+    case 0x8404b504: kind="_XeNtAllocateVirtualMemory@20"; break;
+    case 0x8404bf4c: kind="_XeNtFreeVirtualMemory@12"; break;
+    case 0x8404cec4: kind="_XeNtReadFile@32"; break;
+    case 0x8404cf14: kind="_XeNtReadFileScatter@32"; break;
+    case 0x840281f4: kind="native_submit"; break;
+    case 0x840159f0: kind="io_complete"; break;
+    case 0x84051400: kind="port_complete"; break;
+    case 0x840517ab: kind="lower_submit"; break;
+    case 0x840162d0: kind="io_apc_delivery"; break;
+    case 0x8403f3f4: kind="fatx_dispatch"; break;
+    case 0x84041cd8: kind="fatx_queue"; break;
+    case 0x84041d42: kind="fatx_overflow"; break;
+    case 0x84041e51: kind="fatx_worker_dispatch"; break;
+    case 0x8404f5a3: kind="envelope_alloc_return"; break;
+    case 0x8404f5f5: kind="child_alloc_return"; break;
+    case 0x8404f622: kind="control_mdl_return"; break;
+    case 0x84027761: kind="_NxMmAllocateContiguousMemory@4"; returning=true; break;
+    case 0x8402790c: kind="_NxMmAllocateContiguousMemoryEx@20"; returning=true; break;
+    case 0x840442a6: kind="_VfatTryMapRead"; returning=true; break;
+    case 0x8404b535: kind="_XeNtAllocateVirtualMemory@20"; returning=true; break;
+    case 0x8404c175: kind="_XeNtFreeVirtualMemory@12"; returning=true; break;
+    case 0x8404cf10: kind="_XeNtReadFile@32"; returning=true; break;
+    case 0x8404cf51: kind="_XeNtReadFileScatter@32"; returning=true; break;
+    }
+    if(pc==0x8403f3f4) ctx=env->regs[R_EAX];
+    if(pc==0x84041cd8 || pc==0x84041d42) ctx=env->regs[R_EBX];
+    if(pc==0x84041e51) ctx=env->regs[R_ESI];
+    if(ctx){irp=spirit_read32(env,ctx);fo=spirit_read32(env,ctx+0x28);sl=spirit_read32(env,ctx+0x20);}
+    if(pc==0x840281f4) irp=env->regs[R_EDX];
+    if(pc==0x840159f0) irp=env->regs[R_ECX];
+    if(pc==0x84051400) irp=a[2];
+    if(pc==0x840517ab) irp=spirit_read32(env,env->regs[R_EBX]+4);
+    if(pc==0x840162d0) irp=a[1]-0x3c;
+    uint32_t mdl=irp?spirit_read32(env,irp+0x6c):0;
+    uint32_t dev=ctx?spirit_read32(env,ctx+8):0;
+    char name[257]={0};
+    if(fo){
+        uint32_t chars=(spirit_read32(env,fo+0x60)&0xffff)/2;
+        uint32_t ptr=spirit_read32(env,fo+0x64);
+        chars=MIN(chars,256);
+        for(unsigned i=0;i<chars;i++){
+            uint32_t ch=spirit_read32(env,ptr+i*2)&0xffff;
+            name[i]=(ch>=33 && ch<127)?ch:'_';
+        }
+    }
+    qemu_log_mask(LOG_GUEST_ERROR,
+      "forza_io kind=%s returning=%u pc=%08x host_ns=%" PRId64 " virtual_ns=%" PRId64
+      " thread=%08x free_pages=%u fatx_queued=%u esp=%08x ret=%08x eax=%08x ecx=%08x edx=%08x"
+      " a1=%08x a2=%08x a3=%08x a4=%08x a5=%08x a6=%08x a7=%08x a8=%08x"
+      " p4=%08x p4hi=%08x p1=%08x p2=%08x p3=%08x p8=%08x p8hi=%08x ctx=%08x flags=%x"
+      " irp=%08x status=%08x info=%u iosb=%08x buffer=%08x bytes=%u child=%08x"
+      " file=%08x name=%s length=%u offset=%08x posted=%u overflow=%u\n",
+      kind,returning,pc,qemu_clock_get_ns(QEMU_CLOCK_HOST),qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+      spirit_read32(env,0xffdff124),spirit_read32(env,0x84062220),spirit_read32(env,0x84068f98),
+      esp,a[0],(uint32_t)env->regs[R_EAX],(uint32_t)env->regs[R_ECX],(uint32_t)env->regs[R_EDX],
+      a[1],a[2],a[3],a[4],a[5],a[6],a[7],a[8],spirit_read32(env,a[4]),a[4]?spirit_read32(env,a[4]+4):0,spirit_read32(env,a[1]),spirit_read32(env,a[2]),
+      spirit_read32(env,a[3]),spirit_read32(env,a[8]),a[8]?spirit_read32(env,a[8]+4):0,
+      ctx,ctx?spirit_read32(env,ctx+0xc):0,irp,irp?spirit_read32(env,irp+0x10):0,
+      irp?spirit_read32(env,irp+0x14):0,irp?spirit_read32(env,irp+0x1c):0,
+      mdl?spirit_read32(env,mdl+0x10)+spirit_read32(env,mdl+0x18):0,
+      mdl?spirit_read32(env,mdl+0x14):0,pc==0x840517ab?(uint32_t)env->regs[R_EDX]:0,
+      fo,name,sl?spirit_read32(env,sl+4):0,sl?spirit_read32(env,sl+0xc):0,
+      dev?spirit_read32(env,dev+0x108):0,dev?spirit_read32(env,dev+0x104):0);
+}
