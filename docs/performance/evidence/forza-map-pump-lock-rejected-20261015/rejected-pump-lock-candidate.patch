+/* The pump already owns the state lock when it becomes the dispatcher.  A
+ * first pending request must not drop and reacquire it before selecting work. */
+static int first_pending_submit_keeps_pump_entry_lock(void)
+{
+    fixture f; nx_config cfg=config(); CHECK(init(&f,&cfg)); f.delayed=1;
+    parent p=fresh(); nx_handle h; nx_request r=request(&f,&p,NX_READ,0,512);
+    unsigned before=f.lock_entries;
+    CHECK(nx_start(&f.dev,&r,&h)==NX_PENDING);
+    CHECK(f.lock_entries-before==5);
+    finish_held(&f,h.slot,NX_OK,512,0); cleanup(&f); return 1;
+}
