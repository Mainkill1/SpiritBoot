diff --git a/drivers/storage/class/nxstorage/request.c b/drivers/storage/class/nxstorage/request.c
index 2cef7fb..a22c67f 100644
--- a/drivers/storage/class/nxstorage/request.c
+++ b/drivers/storage/class/nxstorage/request.c
@@ -182,12 +182,12 @@ static void pump(nx_device *d)
     lock(d);
     if (d->pumping) { unlock(d); return; }
     d->pumping=1;
-    unlock(d);
+    unsigned lock_held=1;
     for (;;) {
         enum { NONE, SEND, RETIRE, CANCEL, COMPLETE } action=NONE;
         nx_slot *s=NULL; uint32_t index=0;
         void *parent=NULL; nx_status final=NX_OK; uint64_t bytes=0;
-        lock(d);
+        if(!lock_held) { lock(d); lock_held=1; }
         for (uint32_t scanned=0;scanned<d->count;++scanned) {
             index=d->cursor; d->cursor=index+1u==d->count ? 0:index+1u;
             s=&d->slots[index];
@@ -225,42 +225,41 @@ static void pump(nx_device *d)
         }
         if (action==NONE) {
             /* A command construction failure created a terminal runnable slot. */
-            if (s && s->active && s->terminal && !s->inflight) { unlock(d); continue; }
+            if (s && s->active && s->terminal && !s->inflight) continue;
             d->pumping=0; unlock(d); return;
         }
-        unlock(d);
+        unlock(d); lock_held=0;
         if (action==COMPLETE) {
             d->port.complete(d->port.context,parent,final,bytes);
         } else if (action==CANCEL) {
             d->port.cancel(d->port.context,&s->command);
         } else if (action==RETIRE) {
             d->port.retire(d->port.context,&s->command);
-            lock(d); record_result(d,s); unlock(d);
+            lock(d); record_result(d,s); lock_held=1;
         } else {
             nx_status prepared=d->port.prepare(d->port.context,&s->command);
-            lock(d);
+            lock(d); lock_held=1;
             if (prepared!=NX_OK) {
                 preparation_failed(d,s,prepared>NX_OK ? NX_PROTOCOL_ERROR:prepared);
-                unlock(d); continue;
+                continue;
             }
             if (d->quarantined && !s->recovery) {
-                unlock(d); d->port.retire(d->port.context,&s->command);
-                lock(d); s->final_status=NX_IO_ERROR; s->terminal=1; unlock(d); continue;
+                unlock(d); lock_held=0; d->port.retire(d->port.context,&s->command);
+                lock(d); lock_held=1; s->final_status=NX_IO_ERROR; s->terminal=1; continue;
             }
             if (s->cancelled && !s->recovery) {
-                unlock(d); d->port.retire(d->port.context,&s->command);
-                lock(d); s->final_status=NX_CANCELLED; s->terminal=1; unlock(d); continue;
+                unlock(d); lock_held=0; d->port.retire(d->port.context,&s->command);
+                lock(d); lock_held=1; s->final_status=NX_CANCELLED; s->terminal=1; continue;
             }
             /* Submission commit: subsequent cancellation may race with the
              * unlocked port call, so it must cancel/drain committed transport. */
             s->inflight=1; s->prepared=1;
-            unlock(d);
+            unlock(d); lock_held=0;
             int submitted_pending=d->port.submit(d->port.context,&s->command);
-            lock(d);
+            lock(d); lock_held=1;
             /* A return value never proves lower ownership ended. A broken
              * adapter that omits its terminal report keeps the pages live. */
             if (submitted_pending || !s->done) pending(d,s);
-            unlock(d);
         }
     }
 }
