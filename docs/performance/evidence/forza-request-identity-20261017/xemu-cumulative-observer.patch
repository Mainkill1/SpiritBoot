+/* Local owned-code attribution; aggregate within the title's read call. */
+static void forza_submit_profile(CPUX86State *env, uint32_t pc)
+{
+    static struct {
+        uint32_t thread, iosb, esp, bytes, stalls, stall_us;
+        int64_t start, starts[5], durations[5];
+        uint32_t counts[5];
+    } p;
+    const uint32_t enter[5] = {0x84013cc8,0x84022a0c,0x840281f4,0x840347e4,0x8401f35c};
+    const uint32_t leave[5] = {0x84013ddf,0x84022c23,0x8402880a,0x84034afa,0x8401f46e};
+    uint32_t thread=spirit_read32(env,0xffdff124), esp=env->regs[R_ESP];
+    int64_t now=qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (pc==0x8404cec4 && spirit_read32(env,esp)==0x0026741a) {
+        memset(&p,0,sizeof(p));p.thread=thread;p.iosb=spirit_read32(env,esp+20);
+        p.bytes=spirit_read32(env,esp+28);p.esp=esp+36;p.start=now;
+    }
+    if (!p.thread || thread!=p.thread) return;
+    if (pc==0x84002f67) {p.stalls++;p.stall_us+=spirit_read32(env,esp+4);}
+    for (unsigned i=0;i<5;i++) {
+        if(pc==enter[i]) {p.starts[i]=now;p.counts[i]++;}
+        if(pc==leave[i] && p.starts[i]) {p.durations[i]+=now-p.starts[i];p.starts[i]=0;}
+    }
+    if(pc==0x0026741a && esp==p.esp) {
+        qemu_log_mask(LOG_GUEST_ERROR,"forza_submit_profile virtual_ns=%" PRId64 " iosb=%08x bytes=%u total_ns=%" PRId64 " stalls=%u stall_us=%u irp_ns=%" PRId64 " pin_ns=%" PRId64 " adapter_ns=%" PRId64 " pata_ns=%" PRId64 " dpc_ns=%" PRId64 " irp_count=%u pin_count=%u adapter_count=%u pata_count=%u dpc_count=%u open=%u%u%u%u%u\n",
+            now,p.iosb,p.bytes,now-p.start,p.stalls,p.stall_us,p.durations[0],p.durations[1],p.durations[2],p.durations[3],p.durations[4],
+            p.counts[0],p.counts[1],p.counts[2],p.counts[3],p.counts[4],!!p.starts[0],!!p.starts[1],!!p.starts[2],!!p.starts[3],!!p.starts[4]);
+        p.thread=0;
+    }
+}
