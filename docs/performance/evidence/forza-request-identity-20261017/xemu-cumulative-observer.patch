+/* Local diagnostic. Function PCs and optimized calling conventions were checked
+ * against add882b6's xboxkrnl.unstripped.exe. No guest memory is written. */
+static uint32_t spirit_read32(CPUX86State *env, uint32_t address)
+{
+    uint8_t bytes[4];
+    if (!address || cpu_memory_rw_debug(env_cpu(env), address, bytes, 4, false)) {
+        return 0;
+    }
+    return ldl_le_p(bytes);
+}
