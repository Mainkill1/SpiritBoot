+/* Break: a generation-exhausted slot is returned to the admission free list
+ * and can wrap an old handle into a live request. */
+static int exhausted_generation_is_retired_from_free_list(void)
+{
+    fixture f; nx_config cfg=config(); CHECK(init(&f,&cfg));
+    f.slots[f.dev.free_head].generation=UINT64_MAX-1u;
+    parent a=fresh(),b=fresh(); nx_handle first,next;
+    nx_request r=request(&f,&a,NX_READ,0,512);
+    CHECK(nx_start(&f.dev,&r,&first)==NX_OK);
+    CHECK(first.slot==0 && first.generation==UINT64_MAX && a.completions==1);
+    r=request(&f,&b,NX_READ,512,512);
+    CHECK(nx_start(&f.dev,&r,&next)==NX_OK);
+    CHECK(next.slot!=first.slot && next.generation==1 && b.completions==1);
+    nx_cancel(&f.dev,first); CHECK(b.completions==1);
+    cleanup(&f); return 1;
+}
