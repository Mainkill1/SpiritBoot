+static nx_status build_command(nx_device *d, nx_slot *s, uint32_t index)
+{
+    nx_command *c=&s->command;
+    if (s->sequence==UINT64_MAX) return NX_PROTOCOL_ERROR;
+    if (s->sequence) clear_bytes(c,sizeof(*c));
+    c->token.slot=index; c->token.generation=s->generation; c->token.command=++s->sequence;
+    c->parent=s->request.parent; c->lease=s->request.lease;
+    c->function=s->recovery ? RELEASE:EXECUTE;
+    if (s->recovery) return NX_OK;
+    if (cache_sync(s)) { c->cdb_length=10;c->cdb[0]=SYNC10; return NX_OK; }
+    return plan_data_command(d,&s->request,s->transferred,c);
+}
