+int nx_plan_single_read(const nx_device *d,const nx_request *r,nx_command *c)
+{
+    if (!d || !r || !c || r->operation!=NX_READ || !r->bytes ||
+        validate(d,r)!=NX_OK) return 0;
+    clear_bytes(c,sizeof(*c));c->parent=r->parent;c->lease=r->lease;
