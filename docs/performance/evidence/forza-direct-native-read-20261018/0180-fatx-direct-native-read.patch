+    unsigned active[WINDOW]={0},request_index[WINDOW]={0};
+    uint8_t *payloads=aligned_alloc(4096,WINDOW*4096);
+    unsigned submitted=0,completed=0;lower_pending=1;pending_child_count=0;lower_calls=0;
+    CHECK(payloads!=NULL);memset(payloads,0xa5,WINDOW*4096);stamp_read_payloads=1;
+    burst_seed=0x36d2a9f1u;burst_complete_during_submit=1;
+    while(completed<TOTAL) {
+        for(unsigned i=0;i<WINDOW&&submitted<TOTAL;++i) if(!active[i]) {
+            init_parent(&reads[i],IRP_MJ_READ,4096);
