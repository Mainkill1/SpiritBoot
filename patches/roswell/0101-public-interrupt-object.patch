diff --git a/tests/xbe/interrupt-public-abi/README.md b/tests/xbe/interrupt-public-abi/README.md
new file mode 100644
index 00000000..45e5e92f
--- /dev/null
+++ b/tests/xbe/interrupt-public-abi/README.md
@@ -0,0 +1,7 @@
+# Public interrupt ABI probe
+
+This independently authored XBE checks the 112-byte Xbox interrupt object, public initialization fields, Connected transitions, bounds guards, and actual NV2A IRQ3 callback identity/context. It does not inspect reference implementation instructions. A real vblank triggers the handler and a two-second wait bounds delivery. The probe restores the saved PMC/PCRTC enables, disconnects, prints its 17 numbered TAP checks, and requests power-off.
+
+Build with the pinned nxdk container from `sources/firmware-lock.json` and run on a fresh 64 MiB xemu session with COM1 capture. The original test payload is frozen in the accompanying provenance evidence. See `docs/provenance/TITLE_INTERRUPT_PUBLIC_ABI.md` for controls and limits.
+
+This checks cold-boot interrupt behavior. Hardware testing, live connected reinitialization, and title-generated public dispatch code are outside this probe.
diff --git a/tests/xbe/interrupt-public-abi/main.c b/tests/xbe/interrupt-public-abi/main.c
new file mode 100644
index 00000000..89e1e0c4
--- /dev/null
+++ b/tests/xbe/interrupt-public-abi/main.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Independently authored public ABI probe; no reference implementation input.
+ */
+#include <xboxkrnl/xboxkrnl.h>
+#include <stdio.h>
+#include <string.h>
+#include "tap.h"
+
+#define PMC_INTR_ENABLE (*(volatile ULONG *)0xfd000140UL)
+#define PCRTC_INTR (*(volatile ULONG *)0xfd600100UL)
+#define PCRTC_INTR_ENABLE (*(volatile ULONG *)0xfd600140UL)
+#define VBLANK 1UL
+
+static struct {
+    ULONG prefix[16];
+    KINTERRUPT interrupt;
+    ULONG suffix[128];
+} guarded;
+static KEVENT observed;
+static volatile ULONG callback_count;
+static volatile ULONG callback_interrupt;
+static volatile ULONG callback_context;
+static ULONG owned_context = 0x49525133UL;
+static unsigned checks;
+static unsigned failures;
+
+static void check(int pass, const char *name)
+{
+    ++checks;
+    if (pass) tap_ok(checks, name);
+    else { ++failures; tap_not_ok(checks, name); }
+}
+
+static BOOLEAN NTAPI service(PKINTERRUPT interrupt, PVOID context)
+{
+    if (!(PCRTC_INTR & VBLANK)) return FALSE;
+    PCRTC_INTR = VBLANK;
+    callback_interrupt = (ULONG)interrupt;
+    callback_context = (ULONG)context;
+    ++callback_count;
+    KeSetEvent(&observed, 0, FALSE);
+    return TRUE;
+}
+
+static int guards_ok(void)
+{
+    unsigned i;
+    for (i = 0; i < sizeof(guarded.prefix)/sizeof(guarded.prefix[0]); ++i)
+        if (guarded.prefix[i] != 0xa5a5a5a5UL) return 0;
+    for (i = 0; i < sizeof(guarded.suffix)/sizeof(guarded.suffix[0]); ++i)
+        if (guarded.suffix[i] != 0xa5a5a5a5UL) return 0;
+    return 1;
+}
+
+static void finish(void) __attribute__((noreturn));
+static void finish(void)
+{
+    tap_comment("checks=%u failures=%u", checks, failures);
+    tap_plan(checks);
+    tap_puts("# interrupt_identity_probe_finished\n");
+    tap_drain();
+    HalWriteSMBusValue(0x20, 0x02, FALSE, 0x80);
+    for (;;) __asm__ __volatile__("hlt");
+}
+
+int main(void)
+{
+    KIRQL irql = 0;
+    ULONG vector, pmc, pcrtc;
+    BOOLEAN connected, disconnected;
+    NTSTATUS wait_status = STATUS_UNSUCCESSFUL;
+    LARGE_INTEGER timeout;
+
+    tap_version(14);
+    memset(&guarded, 0xa5, sizeof(guarded));
+    KeInitializeEvent(&observed, NotificationEvent, FALSE);
+    vector = HalGetInterruptVector(3, &irql);
+    tap_comment("public_object=%08lx bytes=%lu irq3_vector=%lu irql=%u context=%08lx",
+                (ULONG)&guarded.interrupt, (ULONG)sizeof(KINTERRUPT), vector,
+                (unsigned)irql, (ULONG)&owned_context);
+    check(sizeof(KINTERRUPT) == 112, "public interrupt structure is 112 bytes");
+    check(vector != 0 && irql > DISPATCH_LEVEL, "IRQ3 yields a usable public vector and IRQL");
+    if (!vector) finish();
+
+    KeInitializeInterrupt(&guarded.interrupt, service, &owned_context,
+                          vector, irql, LevelSensitive, TRUE);
+    check(guards_ok(), "initialization stays within the public object");
+    check(guarded.interrupt.BusInterruptLevel == 3,
+          "initialization publishes the hardware IRQ level");
+    check(guarded.interrupt.ServiceRoutine == service, "initialization publishes the service routine");
+    check(guarded.interrupt.ServiceContext == &owned_context, "initialization publishes the supplied context");
+    check(guarded.interrupt.Irql == irql, "initialization publishes the public IRQL");
+    check(guarded.interrupt.ShareVector && guarded.interrupt.Mode == LevelSensitive,
+          "initialization publishes sharing and trigger mode");
+    check(!guarded.interrupt.Connected, "initialized interrupt starts disconnected");
+    tap_comment("initialized_bus_level=%lu irql=%lu connected=%u service_count=%lu",
+                guarded.interrupt.BusInterruptLevel, guarded.interrupt.Irql,
+                (unsigned)guarded.interrupt.Connected, guarded.interrupt.ServiceCount);
+
+    pmc = PMC_INTR_ENABLE;
+    pcrtc = PCRTC_INTR_ENABLE;
+    PCRTC_INTR_ENABLE = 0;
+    PCRTC_INTR = VBLANK;
+    connected = KeConnectInterrupt(&guarded.interrupt);
+    check(connected, "owned interrupt connects");
+    check(guarded.interrupt.Connected == TRUE, "connect publishes public connected state");
+    if (connected) {
+        PCRTC_INTR_ENABLE = VBLANK;
+        PMC_INTR_ENABLE = 1;
+        timeout.QuadPart = -20000000LL;
+        wait_status = KeWaitForSingleObject(&observed, Executive, KernelMode,
+                                            FALSE, &timeout);
+    }
+    PCRTC_INTR_ENABLE = 0;
+    PMC_INTR_ENABLE = pmc;
+    PCRTC_INTR = VBLANK;
+    disconnected = connected ? KeDisconnectInterrupt(&guarded.interrupt) : FALSE;
+    PCRTC_INTR_ENABLE = pcrtc;
+    tap_comment("wait=%08lx callbacks=%lu received_object=%08lx received_context=%08lx",
+                (ULONG)wait_status, callback_count, callback_interrupt, callback_context);
+    check(wait_status == STATUS_SUCCESS && callback_count != 0, "bounded vblank interrupt reaches the owned handler");
+    check(callback_interrupt == (ULONG)&guarded.interrupt, "handler receives the original public interrupt object");
+    check(callback_context == (ULONG)&owned_context, "handler receives the supplied context");
+    check(disconnected, "owned interrupt disconnects");
+    check(!guarded.interrupt.Connected, "disconnect clears public connected state");
+    check(guards_ok(), "complete lifecycle preserves neighboring guards");
+    finish();
+}
diff --git a/tests/xbe/interrupt-public-abi/tap.c b/tests/xbe/interrupt-public-abi/tap.c
new file mode 100644
index 00000000..009bb8a8
--- /dev/null
+++ b/tests/xbe/interrupt-public-abi/tap.c
@@ -0,0 +1,166 @@
+/*
+ * TAP 14 emitter.  Bytes go out the LPC47M157 SuperIO's COM1 at 115200 8N1
+ * (I/O 0x3F8).  We program the UART ourselves at first call so the suite
+ * works against both nxkrnl (which already programs it for DbgPrint) and
+ * the retail kernel (which doesn't).  isa-debugcon (port 0xE9) was the
+ * historical target but the upstream xemu AppImage builds without it.
+ */
+
+#include "tap.h"
+#include <stdio.h>
+#include <stdarg.h>
+
+#define COM1     0x3F8
+#define COM1_THR (COM1 + 0)
+#define COM1_DLL (COM1 + 0)
+#define COM1_IER (COM1 + 1)
+#define COM1_DLH (COM1 + 1)
+#define COM1_LCR (COM1 + 3)
+#define COM1_MCR (COM1 + 4)
+#define COM1_LSR (COM1 + 5)
+
+#define LSR_THRE 0x20  /* transmit holding register empty */
+#define LSR_TEMT 0x40  /* transmitter empty (shift + holding both drained) */
+#define LCR_DLAB 0x80
+#define LCR_8N1  0x03
+
+static inline void outb(unsigned short port, unsigned char val)
+{
+    __asm__ __volatile__("outb %0, %1" : : "a"(val), "Nd"(port));
+}
+
+static inline unsigned char inb(unsigned short port)
+{
+    unsigned char ret;
+    __asm__ __volatile__("inb %1, %0" : "=a"(ret) : "Nd"(port));
+    return ret;
+}
+
+/* Xbox is single-CPU: prevent a scheduled kernel/debug writer from entering
+ * between bytes. Restore the caller's full flags, including an already-clear
+ * IF. Formatting stays outside this span; no kernel-private lock is borrowed. */
+static inline unsigned int tap_irq_save(void)
+{
+    unsigned int flags;
+    __asm__ __volatile__("pushfl; popl %0; cli" : "=r"(flags) : : "memory");
+    return flags;
+}
+
+static inline void tap_irq_restore(unsigned int flags)
+{
+    __asm__ __volatile__("pushl %0; popfl" : : "r"(flags) : "memory", "cc");
+}
+
+static void com_init(void)
+{
+    static int initialized = 0;
+    if (initialized) return;
+    initialized = 1;
+    outb(COM1_IER, 0x00);             /* disable all interrupts */
+    outb(COM1_LCR, LCR_DLAB);         /* DLAB=1 to set divisor */
+    outb(COM1_DLL, 0x01);             /* 115200 baud (1.8432 MHz / 16 / 1) */
+    outb(COM1_DLH, 0x00);
+    outb(COM1_LCR, LCR_8N1);          /* DLAB=0, 8N1 */
+    /* Retain the existing FIFO mode and queued bytes. THRE polling works
+     * with either the reset/default UART or a kernel-configured FIFO; changing
+     * FIFO enable or clearing it could discard the preceding debug message. */
+    outb(COM1_MCR, 0x0B);             /* DTR + RTS + OUT2 */
+}
+
+static void com_putc(char c)
+{
+    while ((inb(COM1_LSR) & LSR_THRE) == 0) { }
+    outb(COM1_THR, (unsigned char)c);
+}
+
+void tap_drain(void)
+{
+    while ((inb(COM1_LSR) & LSR_TEMT) == 0) { }
+}
+
+static void com_puts(const char *s)
+{
+    unsigned int flags = tap_irq_save();
+    com_init();
+    while (*s) com_putc(*s++);
+    tap_irq_restore(flags);
+}
+
+static void com_vprintf(const char *fmt, va_list ap)
+{
+    char buf[256];
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_puts(buf);
+}
+
+static void com_printf(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    com_vprintf(fmt, ap);
+    va_end(ap);
+}
+
+void tap_puts(const char *s)
+{
+    com_puts(s);
+}
+
+void tap_version(unsigned int v)
+{
+    com_printf("TAP version %u\n", v);
+}
+
+void tap_plan(unsigned int n)
+{
+    com_printf("1..%u\n", n);
+}
+
+void tap_ok(unsigned int n, const char *desc)
+{
+    com_printf("ok %u - %s\n", n, desc);
+}
+
+void tap_not_ok(unsigned int n, const char *desc)
+{
+    com_printf("not ok %u - %s\n", n, desc);
+}
+
+void tap_diag_begin(void)
+{
+    com_puts("  ---\n");
+}
+
+void tap_diag_end(void)
+{
+    com_puts("  ...\n");
+}
+
+void tap_diag_kv(const char *key, const char *fmt, ...)
+{
+    char buf[192];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_printf("  %s: %s\n", key, buf);
+}
+
+void tap_comment(const char *fmt, ...)
+{
+    char buf[192];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_printf("# %s\n", buf);
+}
diff --git a/tests/xbe/interrupt-public-abi/tap.h b/tests/xbe/interrupt-public-abi/tap.h
new file mode 100644
index 00000000..0f39d98a
