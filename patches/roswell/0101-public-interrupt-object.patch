diff --git a/ntoskrnl/xb/interrupt.c b/ntoskrnl/xb/interrupt.c
index cebe50d6..1b11fcf8 100644
--- a/ntoskrnl/xb/interrupt.c
+++ b/ntoskrnl/xb/interrupt.c
@@ -22,6 +22,28 @@ KeInitializeInterrupt(IN PKINTERRUPT Interrupt,
 NTKERNELAPI BOOLEAN NTAPI KeConnectInterrupt(IN PKINTERRUPT Interrupt);
 NTKERNELAPI BOOLEAN NTAPI KeDisconnectInterrupt(IN PKINTERRUPT Interrupt);
 
+/* The public Xbox object has a different header from NT's KINTERRUPT.
+ * Keep that layout explicit even though the exported prototypes use the
+ * native pointer typedef. The dispatch-code tail belongs to the public ABI;
+ * our native IDT route does not execute or modify it. */
+typedef struct _XE_PUBLIC_INTERRUPT
+{
+    PKSERVICE_ROUTINE ServiceRoutine;
+    PVOID ServiceContext;
+    ULONG BusInterruptLevel;
+    ULONG Irql;
+    BOOLEAN Connected;
+    BOOLEAN ShareVector;
+    UCHAR Mode;
+    UCHAR Padding;
+    ULONG ServiceCount;
+    ULONG DispatchCode[22];
+} XE_PUBLIC_INTERRUPT;
+
+C_ASSERT(sizeof(XE_PUBLIC_INTERRUPT) == 112);
+C_ASSERT(FIELD_OFFSET(XE_PUBLIC_INTERRUPT, Connected) == 0x10);
+C_ASSERT(FIELD_OFFSET(XE_PUBLIC_INTERRUPT, DispatchCode) == 0x18);
+
 /* KINTERRUPT shadow.  Xbox KINTERRUPT is 112 bytes; NT's is 484 (60-byte
  * header + 424-byte DispatchCode tail).  Letting NT initialise into the
  * caller's buffer writes 372 bytes past the end.  Maintain an NT-shaped
@@ -39,6 +61,7 @@ typedef struct _XBE_INTERRUPT_SHADOW
 #define XBE_INTERRUPT_SHADOW_SLOTS 8
 
 static XBE_INTERRUPT_SHADOW XeInterruptShadows[XBE_INTERRUPT_SHADOW_SLOTS];
+C_ASSERT(sizeof(KINTERRUPT) <= sizeof(XeInterruptShadows[0].NtInterruptStorage));
 
 static XBE_INTERRUPT_SHADOW *
 XeInterruptGetShadow(PKINTERRUPT XboxInt, BOOLEAN Allocate)
@@ -92,11 +115,25 @@ static PKINTERRUPT XeInterruptNative(XBE_INTERRUPT_SHADOW *shadow)
            (PKINTERRUPT)shadow->NtInterruptStorage;
 }
 
+/* NT dispatch passes its own object to an ISR. Translate at that boundary so
+ * title code sees its original public object and caller-supplied context. */
+static BOOLEAN NTAPI
+XeInterruptDispatch(PKINTERRUPT Native, PVOID Context)
+{
+    XBE_INTERRUPT_SHADOW *Shadow = Context;
+    XE_PUBLIC_INTERRUPT *Public = (XE_PUBLIC_INTERRUPT *)Shadow->XboxInterrupt;
+
+    /* An IRQ may arrive as native Connect lowers IRQL, before the exported
+     * wrapper returns. Publish its actual state before entering title code. */
+    Public->Connected = Native->Connected;
+    return Public->ServiceRoutine(Shadow->XboxInterrupt, Public->ServiceContext);
+}
+
 /* Xbox KeInitializeInterrupt has no caller-supplied spin lock and no SMP
  * params; NT's does.  Pass NULL for the lock (use KINTERRUPT's built-in
  * one), mirror Irql as the synchronize IRQL, pin processor 0 without FP
- * save.  Writes 484 bytes into the *shadow*; the title's buffer is left
- * alone (its address is still the lookup key for Connect/Disconnect). */
+ * save. Initialize the public header separately from the native shadow.
+ * ServiceCount and the opaque public dispatch tail retain their contents. */
 VOID NTAPI
 XeKeInitializeInterrupt(PKINTERRUPT Interrupt,
                           PKSERVICE_ROUTINE ServiceRoutine,
@@ -107,6 +144,8 @@ XeKeInitializeInterrupt(PKINTERRUPT Interrupt,
                           BOOLEAN ShareVector)
 {
     XBE_INTERRUPT_SHADOW *Shadow = XeInterruptGetShadow(Interrupt, TRUE);
+    XE_PUBLIC_INTERRUPT *Public = (XE_PUBLIC_INTERRUPT *)Interrupt;
+    KIRQL OldIrql;
     if (Shadow == NULL)
     {
         XbDbg("KeInitializeInterrupt: shadow table full, KINTERRUPT %p "
@@ -114,10 +153,21 @@ XeKeInitializeInterrupt(PKINTERRUPT Interrupt,
         return;
     }
     if (Shadow->DriverOwned) return; /* title cannot replace active IRQ owner */
+
+    /* Publish the routine/context together while hardware IRQs are excluded. */
+    KeRaiseIrql(HIGH_LEVEL, &OldIrql);
+    Public->ServiceRoutine = ServiceRoutine;
+    Public->ServiceContext = ServiceContext;
+    Public->BusInterruptLevel = Vector - 0x30;
+    Public->Irql = Irql;
+    Public->Connected = FALSE;
+    Public->ShareVector = ShareVector;
+    Public->Mode = (UCHAR)InterruptMode;
     KeInitializeInterrupt((PKINTERRUPT)Shadow->NtInterruptStorage,
-                          ServiceRoutine, ServiceContext,
+                          XeInterruptDispatch, Shadow,
                           NULL, Vector, Irql, Irql, InterruptMode,
                           ShareVector, 0, FALSE);
+    KeLowerIrql(OldIrql);
 }
 
 /* Title KINTERRUPT leaves ActualLock NULL.  NT's KeSynchronizeExecution
@@ -161,6 +211,8 @@ BOOLEAN NTAPI
 XeKeConnectInterrupt(PKINTERRUPT Interrupt)
 {
     XBE_INTERRUPT_SHADOW *Shadow = XeInterruptGetShadow(Interrupt, FALSE);
+    PKINTERRUPT Native;
+    BOOLEAN Connected;
     if (Shadow == NULL)
     {
         XbDbg("KeConnectInterrupt(%p): no shadow; ignored\n", Interrupt);
@@ -174,15 +226,23 @@ XeKeConnectInterrupt(PKINTERRUPT Interrupt)
         if (old < DISPATCH_LEVEL) KeLowerIrql(old);
         return connected;
     }
-    return KeConnectInterrupt(XeInterruptNative(Shadow));
+    Native = XeInterruptNative(Shadow);
+    Connected = KeConnectInterrupt(Native);
+    ((XE_PUBLIC_INTERRUPT *)Interrupt)->Connected = Native->Connected;
+    return Connected;
 }
 
 BOOLEAN NTAPI
 XeKeDisconnectInterrupt(PKINTERRUPT Interrupt)
 {
     XBE_INTERRUPT_SHADOW *Shadow = XeInterruptGetShadow(Interrupt, FALSE);
+    PKINTERRUPT Native;
+    BOOLEAN Disconnected;
     if (Shadow == NULL)
         return FALSE;
     if (Shadow->DriverOwned) return FALSE; /* driver owns lifecycle, even detached */
-    return KeDisconnectInterrupt(XeInterruptNative(Shadow));
+    Native = XeInterruptNative(Shadow);
+    Disconnected = KeDisconnectInterrupt(Native);
+    ((XE_PUBLIC_INTERRUPT *)Interrupt)->Connected = Native->Connected;
+    return Disconnected;
 }
