diff --git a/ntoskrnl/xb/mm/poolpages.c b/ntoskrnl/xb/mm/poolpages.c
index 1e0d5915bc9feb64ba0757a8a2f46684846c7d06..56fe6b14a817e9e844e5bf42281602fe47ba9f2e 100644
--- a/ntoskrnl/xb/mm/poolpages.c
+++ b/ntoskrnl/xb/mm/poolpages.c
@@ -147,6 +147,28 @@ NxPoolPagesOwns(
     return Va >= NXPP_BASE && Va < NXPP_END;
 }
 
+/* Query only an active run start. Raw page-layer ownership remains private;
+ * ExQueryPoolBlockSize separately excludes small-object bucket pages. */
+SIZE_T
+NxPoolPagesQueryRunBytes(PVOID BaseAddress)
+{
+    ULONG_PTR Va = (ULONG_PTR)BaseAddress;
+    ULONG Start, Count;
+    KIRQL OldIrql;
+
+    if (NxppRunPages == NULL || !NxppLockInit ||
+        !NxPoolPagesOwns(BaseAddress) || (Va & (PAGE_SIZE - 1)) != 0)
+        return 0;
+    Start = (ULONG)((Va - NXPP_BASE) >> PAGE_SHIFT);
+    KeAcquireSpinLock(&NxppLock, &OldIrql);
+    Count = NxppRunPages[Start];
+    if (!(NxppUsedMap[Start >> 5] & (1UL << (Start & 31))) ||
+        Count > NXPP_PAGES - Start)
+        Count = 0;
+    KeReleaseSpinLock(&NxppLock, OldIrql);
+    return (SIZE_T)Count << PAGE_SHIFT;
+}
+
 PVOID
 NxPoolPagesAlloc(
     IN SIZE_T NumberOfBytes)
diff --git a/tests/host/pool-size/check.py b/tests/host/pool-size/check.py
new file mode 100644
index 0000000000000000000000000000000000000000..56d450246bfe7aae42fed27e3722dc23ead925dc
--- /dev/null
+++ b/tests/host/pool-size/check.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile public pool-size query and authoritative run query with lock shims."""
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+sys.dont_write_bytecode = True
+root=Path(__file__).resolve().parents[3]
+out=Path(sys.argv[1]).resolve();out.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('extract',root/'tests/host/kernel-performance/check.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
+pool=(root/'ntoskrnl/xb/mm/pool.c').read_text();pages=(root/'ntoskrnl/xb/mm/poolpages.c').read_text()
+body=m.function(pages,'NxPoolPagesOwns')+m.function(pages,'NxPoolPagesQueryRunBytes')+m.function(pool,'ExQueryPoolBlockSize')
+shim=r'''
+#include <stdint.h>
+#include <stddef.h>
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+typedef uintptr_t ULONG_PTR;
+typedef uint32_t ULONG;
+typedef size_t SIZE_T;
+typedef unsigned char BOOLEAN, *PBOOLEAN, KIRQL;
+typedef void *PVOID;
+#define IN
+#define OUT
+#define NTAPI
+#define FALSE 0
+#define PAGE_SIZE 4096u
+#define PAGE_SHIFT 12
+#define PAGE_ALIGN(p) ((PVOID)((uintptr_t)(p)&~(uintptr_t)4095))
+#define ASSERT assert
+#define NXPP_BASE 0x90000000u
+#define NXPP_PAGES 4096u
+#define NXPP_END (NXPP_BASE+NXPP_PAGES*PAGE_SIZE)
+#define NXP_NOT_BUCKET 255
+#define NXP_PAGE_INDEX(p) (((uintptr_t)(p)-NXPP_BASE)/PAGE_SIZE)
+#define NXP_MAGIC_ALLOC 42
+#define NXP_CLASSES 1
+static unsigned NxpClassSize[]={32};
+typedef struct {unsigned Magic,ClassIndex;} NXP_HEADER;
+static uint16_t runs[NXPP_PAGES], *NxppRunPages=runs;
+static uint32_t NxppUsedMap[NXPP_PAGES/32];
+static unsigned char NxpPageState[NXPP_PAGES];
+static int NxppLockInit=1,NxppLock,NxpLock, held;
+static void KeAcquireSpinLock(int *lock,KIRQL *old) {assert(!held);held=1;*lock=1;*old=0;}
+static void KeReleaseSpinLock(int *lock,KIRQL old) {(void)old;assert(held&&*lock);*lock=0;held=0;}
+'''
+main=r'''
+int main(void) {
+ memset(NxpPageState,NXP_NOT_BUCKET,sizeof(NxpPageState));
+ for(unsigned i=0;i<160;i++) {
+  unsigned start=i*3; runs[start]=2;NxppUsedMap[start/32]|=1u<<(start%32);
+  void *p=(void*)(uintptr_t)(NXPP_BASE+start*PAGE_SIZE);
+  BOOLEAN quota=1;assert(ExQueryPoolBlockSize(p,&quota)==8192&&!quota);
+  assert(ExQueryPoolBlockSize((char*)p+PAGE_SIZE,NULL)==0);
+ }
+ assert(ExQueryPoolBlockSize(NULL,NULL)==0);
+ assert(ExQueryPoolBlockSize((void*)NXPP_END,NULL)==0);
+ assert(NxPoolPagesQueryRunBytes((void*)(NXPP_BASE+1))==0);
+ NxpPageState[0]=0;assert(ExQueryPoolBlockSize((void*)NXPP_BASE,NULL)==0);
+ NxpPageState[0]=NXP_NOT_BUCKET;runs[0]=0;
+ assert(ExQueryPoolBlockSize((void*)NXPP_BASE,NULL)==0);
+ runs[0]=2;NxppUsedMap[0]=0;
+ assert(ExQueryPoolBlockSize((void*)NXPP_BASE,NULL)==0);
+ NxppLockInit=0;assert(NxPoolPagesQueryRunBytes((void*)NXPP_BASE)==0);
+ assert(!held);puts("pool-size: 160 active runs, interiors, bucket/free/outside boundaries and nonnested locks PASS");
+}
+'''
+(out/'pool-size.c').write_text(shim+'\n#define NXK_MM_POOLPAGES\n'+body+main)
+subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-fsanitize=address,undefined',str(out/'pool-size.c'),'-o',str(out/'pool-size')],check=True)
+subprocess.run([str(out/'pool-size')],check=True)
