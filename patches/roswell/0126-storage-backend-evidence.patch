diff --git a/tools/lto-init-relink.py b/tools/lto-init-relink.py
index f38583f9..afe3de15 100755
--- a/tools/lto-init-relink.py
+++ b/tools/lto-init-relink.py
@@ -53,6 +53,16 @@ WILDCARD = re.compile(r"[*?\[\]]")
 
 
 def run(cmd):
+    # Observe each actually executed GCC pass while preserving the existing
+    # INIT placement and original compiler argv. The last successful pass is
+    # the kernel consumed by the unchanged post-link/export pipeline.
+    recorder = os.environ.get("NXK_STORAGE_LINK_RECORDER")
+    if recorder and out and os.path.basename(out) == "xboxkrnl.exe":
+        cmd = [sys.executable, recorder,
+               "--record", os.environ["NXK_STORAGE_LINK_RECORD"],
+               "--source", os.environ["NXK_STORAGE_SOURCE"],
+               "--source-tree", os.environ["NXK_STORAGE_SOURCE_TREE"],
+               "--"] + cmd
     return subprocess.run(cmd).returncode
 
 
