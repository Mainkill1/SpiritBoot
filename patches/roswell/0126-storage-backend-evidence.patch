+    target_link_options(ntoskrnl PRIVATE -ffunction-sections "-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/storage-kernel.map")
     set_target_properties(ntoskrnl PROPERTIES RULE_LAUNCH_LINK
-        "${CMAKE_COMMAND} -E env LTO_INIT_FINDTOOL=${REACTOS_SOURCE_DIR}/tools/find-init-candidates.py DEF=${CMAKE_CURRENT_BINARY_DIR}/xboxkrnl.def NM=${CMAKE_NM} OBJDUMP=${CMAKE_OBJDUMP} AR=${CMAKE_AR} python3 ${REACTOS_SOURCE_DIR}/tools/lto-init-relink.py")
+        "${CMAKE_COMMAND} -E env \"NXK_STORAGE_LINK_RECORDER=${NXK_LINK_RECORDER}\" \"NXK_STORAGE_LINK_RECORD=${CMAKE_CURRENT_BINARY_DIR}/storage-link-run.json\" \"NXK_STORAGE_SOURCE=${REACTOS_SOURCE_DIR}\" \"NXK_STORAGE_SOURCE_TREE=${NXK_STORAGE_SOURCE_TREE}\" \"LTO_INIT_FINDTOOL=${REACTOS_SOURCE_DIR}/tools/find-init-candidates.py\" \"DEF=${CMAKE_CURRENT_BINARY_DIR}/xboxkrnl.def\" \"NM=${CMAKE_NM}\" \"OBJDUMP=${CMAKE_OBJDUMP}\" \"AR=${CMAKE_AR}\" python3 ${REACTOS_SOURCE_DIR}/tools/lto-init-relink.py")
