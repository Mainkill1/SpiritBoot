diff --git a/drivers/storage/class/CMakeLists.txt b/drivers/storage/class/CMakeLists.txt
index 71142489..b53c170f 100644
--- a/drivers/storage/class/CMakeLists.txt
+++ b/drivers/storage/class/CMakeLists.txt
@@ -1,8 +1,27 @@
 # the stock cdrom driver is KMDF (32 KLOC, pulls in wdf01000/wdfldr);
 # nxcdrom is a minimal classpnp-based replacement folded into the kernel.
-add_subdirectory(nxcdrom)
-add_subdirectory(classpnp)
-add_subdirectory(disk)
+if(NXK_STORAGE_BACKEND STREQUAL "legacy-reference")
+    add_subdirectory(nxcdrom)
+    add_subdirectory(classpnp)
+    add_subdirectory(disk)
+elseif(NXK_STORAGE_BACKEND STREQUAL "partial-lab-prototype")
+    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/nxstorage/CMakeLists.txt")
+        message(FATAL_ERROR "Partial backend requires actual independently authored nxstorage sources")
+    endif()
+    add_subdirectory(nxstorage)
+    # Laboratory-only hybrid; old class behavior remains until the vertical slice.
+    add_subdirectory(nxcdrom)
+    add_subdirectory(classpnp)
+    add_subdirectory(disk)
+elseif(NXK_STORAGE_BACKEND STREQUAL "complete-candidate")
+    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/nxstorage/driver.c")
+        message(FATAL_ERROR "Complete backend has no implemented independent kernel adapter")
+    endif()
+    add_subdirectory(nxstorage)
+    add_subdirectory(nxcdrom)
+else()
+    message(FATAL_ERROR "Missing/unknown storage backend; refusing implicit legacy fallback")
+endif()
 if(NOT SARCH STREQUAL "xbox")
     add_subdirectory(ramdisk)
 endif()
