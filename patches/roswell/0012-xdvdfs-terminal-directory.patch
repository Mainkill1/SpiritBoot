+++ b/tests/xbe/xdvdfs-directory/main.c
@@ -0,0 +1,22 @@
+#include <stdio.h>
+#include <string.h>
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include <hal/video.h>
+#include <nxdk/mount.h>
+int main(void) {
+ XVideoSetMode(640,480,32,REFRESH_DEFAULT);
+ if(!nxIsDriveMounted('E'))nxMountDrive('E',"\\Device\\Harddisk0\\Partition1");
+ FILE *out=fopen("E:\\directory-result.txt","wb");if(!out)for(;;)Sleep(1000);
+ const char *paths[]={"\\??\\D:\\", "\\??\\D:\\Cache", "\\??\\D:\\Cache\\", "\\??\\D:\\Cache\\Resource", "\\??\\D:\\Cache\\Resource\\", "\\??\\D:\\Cache\\Missing\\", "\\??\\D:\\Cache\\Resource\\probe.bin\\"};
+ unsigned failures=0;
+ for(unsigned i=0;i<sizeof(paths)/sizeof(paths[0]);i++){
+  OBJECT_STRING name={(USHORT)strlen(paths[i]),(USHORT)(strlen(paths[i])+1),(PCHAR)paths[i]};
+  OBJECT_ATTRIBUTES oa={NULL,&name,OBJ_CASE_INSENSITIVE};IO_STATUS_BLOCK iosb={0};HANDLE h=NULL;
+  NTSTATUS s=NtOpenFile(&h,FILE_LIST_DIRECTORY|SYNCHRONIZE,&oa,&iosb,FILE_SHARE_READ,FILE_DIRECTORY_FILE|FILE_SYNCHRONOUS_IO_NONALERT);
+  unsigned bad=i<5?!NT_SUCCESS(s):NT_SUCCESS(s);failures+=bad;
+  fprintf(out,"%s path=%s status=%08lx\n",bad?"FAIL":"PASS",paths[i],s);fflush(out);
+  if(NT_SUCCESS(s))NtClose(h);
+ }
+ fprintf(out,"COMPLETE checks=7 failures=%u\n",failures);fclose(out);for(;;)Sleep(1000);
+}
