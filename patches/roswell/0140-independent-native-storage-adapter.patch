+void NTAPI NxNativeAdapterCancel(PDEVICE_OBJECT device,PIRP parent)
+{
+    NX_NATIVE_ENVELOPE *envelope=(NX_NATIVE_ENVELOPE *)parent->Tail.Overlay.DriverContext[0];
+    NX_NATIVE_ADAPTER *adapter;
+    nx_handle handle;
