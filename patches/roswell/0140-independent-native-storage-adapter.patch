+static NTSTATUS finish_control_result(NX_NATIVE_ENVELOPE *envelope,
+                                      const nx_packet_result *result,
+                                      nx_packet_status captured)
+{
+    NX_NATIVE_ADAPTER *adapter=envelope->adapter;
+    nx_status status=core_status(result,captured);
+    NTSTATUS native=native_status(status);
+    PIRP parent=envelope->parent;
+    KIRQL cancel_irql;
+    unsigned finish=0;
+    if(envelope->control_code==IOCTL_CDROM_READ_TOC &&
+       result->status==(ULONG)STATUS_BUFFER_OVERFLOW && result->srb_base==NX_SRB_SUCCESS)
+        status=NX_OK,native=STATUS_SUCCESS;
+    if(status==NX_OK) {
+        if(envelope->control_code==IOCTL_DISK_GET_DRIVE_GEOMETRY ||
+           envelope->control_code==IOCTL_DISK_GET_DRIVE_GEOMETRY_EX ||
+           envelope->control_code==IOCTL_CDROM_GET_DRIVE_GEOMETRY ||
+           envelope->control_code==IOCTL_DISK_GET_LENGTH_INFO) {
+            uint32_t last,sector;
+            uint64_t blocks,capacity;
+            if(result->reported_bytes<8) native=STATUS_IO_DEVICE_ERROR;
+            else {
+                last=read_be32(envelope->control_data);sector=read_be32(envelope->control_data+4);
+                blocks=(uint64_t)last+1u;capacity=blocks*sector;
+                if(last==UINT32_MAX || !sector || (sector&(sector-1u)) ||
+                   sector>adapter->core.config.page_bytes ||
+                   capacity/sector!=blocks || capacity>INT64_MAX) native=STATUS_NOT_SUPPORTED;
+                else {
+                    port_enter(adapter);adapter->media_capacity=capacity;adapter->media_sector=sector;
+                    adapter->media_present=1;++adapter->media_generation;
+                    adapter->core.config.capacity_bytes=capacity;
+                    adapter->core.config.sector_bytes=sector;
+                    adapter->core.sector_mask=sector-1u;adapter->core.sector_shift=0;
+                    { uint32_t value=sector;while(value>1u){++adapter->core.sector_shift;value>>=1;} }
+                    port_leave(adapter);
+                    native=complete_control_output(envelope);
+                }
+            }
+        } else if(envelope->control_code==IOCTL_CDROM_READ_TOC) {
+            if(envelope->control_output<NX_CONTROL_BYTES || !parent->AssociatedIrp.SystemBuffer ||
+               !result->reported_bytes || result->reported_bytes>NX_CONTROL_BYTES)
+                native=STATUS_IO_DEVICE_ERROR;
+            else {
+                copy_bytes(parent->AssociatedIrp.SystemBuffer,envelope->control_data,
+                           (size_t)result->reported_bytes);
+                parent->IoStatus.Information=(ULONG_PTR)result->reported_bytes;
+            }
+        } else if(envelope->control_code==IOCTL_CDROM_CHECK_VERIFY) {
+            if(envelope->control_output && envelope->control_output<4) native=STATUS_BUFFER_TOO_SMALL;
+            else if(envelope->control_output) {
+                port_enter(adapter);++adapter->media_generation;
