+    envelope->terminal_status=native==STATUS_SUCCESS ? NX_OK:
+        native==STATUS_CANCELLED ? NX_CANCELLED:NX_IO_ERROR;
+    envelope->terminal_bytes=parent->IoStatus.Information;
+    envelope->terminal_ready=1;
+    parent->IoStatus.Status=native;
+    if(native!=STATUS_SUCCESS) parent->IoStatus.Information=0;
+    if(!envelope->cancel_active&&!envelope->completed) finish=1;
+    port_leave(adapter);
+    if(finish) {
+        parent->Tail.Overlay.DriverContext[0]=NULL;envelope->completed=1;
+        IofCompleteRequest(parent,native==STATUS_SUCCESS ? IO_DISK_INCREMENT:IO_NO_INCREMENT);
+        port_enter(adapter);release_envelope_locked(envelope);port_leave(adapter);
+    }
+    return native;
+}
