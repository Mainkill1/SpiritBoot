diff --git a/drivers/storage/class/nxstorage/driver.c b/drivers/storage/class/nxstorage/driver.c
new file mode 100644
index 0000000..17e28b0
--- /dev/null
+++ b/drivers/storage/class/nxstorage/driver.c
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "native_driver.h"
+#include "nxdisk_owner.h"
+#include "nxcdrom_profile.h"
+
+enum { NX_NATIVE_DEFAULT_SLOTS = 8 };
+
+typedef struct NX_NATIVE_CLASS_CONTEXT {
+    PDRIVER_OBJECT driver;
+    nxd_driver owner;
+    nxd_device device;
+    nxd_class_kind kind;
+    HANDLE object_directory;
+} NX_NATIVE_CLASS_CONTEXT;
+
+static NX_NATIVE_CLASS_CONTEXT disk_context, cdrom_context;
+static WCHAR disk_directory_buffer[] = {'\\','D','e','v','i','c','e','\\','H','a','r','d','d','i','s','k','0',0};
+static WCHAR disk_name_buffer[] = {'\\','D','e','v','i','c','e','\\','H','a','r','d','d','i','s','k','0','\\','P','a','r','t','i','t','i','o','n','0',0};
+static WCHAR cdrom_name_buffer[] = {'\\','D','e','v','i','c','e','\\','C','d','R','o','m','0',0};
+static WCHAR cdrom_link_buffer[] = {'\\','D','o','s','D','e','v','i','c','e','s','\\','C','d','R','o','m','0',0};
+static UNICODE_STRING disk_directory = {34,36,disk_directory_buffer};
+static UNICODE_STRING disk_name = {56,58,disk_name_buffer};
+static UNICODE_STRING cdrom_name = {28,30,cdrom_name_buffer};
+static UNICODE_STRING cdrom_link = {38,40,cdrom_link_buffer};
+
+static nxd_status owner_status(NTSTATUS status)
+{
+    if(status==STATUS_SUCCESS) return NXD_SUCCESS;
+    if(status==STATUS_PENDING) return NXD_PENDING;
+    if(status==STATUS_INVALID_PARAMETER) return NXD_INVALID_PARAMETER;
+    if(status==STATUS_INVALID_DEVICE_REQUEST) return NXD_INVALID_DEVICE_REQUEST;
+    if(status==STATUS_BUFFER_TOO_SMALL) return NXD_BUFFER_TOO_SMALL;
+    if(status==STATUS_INSUFFICIENT_RESOURCES) return NXD_NO_MEMORY;
+    if(status==STATUS_DEVICE_NOT_READY) return NXD_NO_DEVICE;
+    if(status==STATUS_MEDIA_WRITE_PROTECTED) return NXD_WRITE_PROTECTED;
+    if(status==STATUS_NOT_SUPPORTED) return NXD_NOT_IMPLEMENTED;
+    return NXD_IO_ERROR;
+}
+
+static NTSTATUS ensure_disk_directory(NX_NATIVE_CLASS_CONTEXT *context)
+{
+    OBJECT_ATTRIBUTES attributes;
+    NTSTATUS status;
+    if(context->object_directory) return STATUS_SUCCESS;
+    InitializeObjectAttributes(&attributes,&disk_directory,
+        OBJ_CASE_INSENSITIVE|OBJ_PERMANENT|OBJ_KERNEL_HANDLE,NULL,NULL);
+    status=ZwCreateDirectoryObject(&context->object_directory,
+                                   DIRECTORY_ALL_ACCESS,&attributes);
+    return status;
+}
+
+static void discard_disk_directory(NX_NATIVE_CLASS_CONTEXT *context)
+{
+    if(!context->object_directory) return;
+    (void)ZwMakeTemporaryObject(context->object_directory);
+    (void)ZwClose(context->object_directory);
+    context->object_directory=NULL;
+}
+
+static nxd_status register_class(void *opaque,nxd_class_kind kind)
+{
+    NX_NATIVE_CLASS_CONTEXT *context=opaque;
+    return context && context->driver && context->kind==kind ?
+        NXD_SUCCESS:NXD_INVALID_PARAMETER;
+}
+
+static nxd_status create_class(void *opaque,nxd_class_kind kind,
+    const nxd_class_identity *identity,const nxd_device_config *config,
+    void *lower,void **created)
+{
+    NX_NATIVE_CLASS_CONTEXT *context=opaque;
+    NX_NATIVE_DEVICE_INIT init;
+    NTSTATUS status;
+    (void)identity;
+    if(!context || !config || !lower || !created || context->kind!=kind)
+        return NXD_INVALID_PARAMETER;
+    if(kind==NXD_CDROM) {
+        status=NxCdromBuildDeviceInit(&init,&cdrom_name,&cdrom_link,
+                                      NX_NATIVE_DEFAULT_SLOTS);
+        if(!NT_SUCCESS(status)) return owner_status(status);
+    } else {
+        status=ensure_disk_directory(context);
+        if(!NT_SUCCESS(status)) return owner_status(status);
+        init.DeviceName=&disk_name;init.SymbolicLinkName=NULL;
+        init.DeviceType=FILE_DEVICE_DISK;init.DeviceCharacteristics=0;
+        init.Config.sector_bytes=config->geometry.bytes_per_sector;
+        init.Config.page_bytes=4096;init.Config.max_bytes=0x20000;
+        init.Config.max_pages=33;init.Config.alignment_mask=config->alignment_mask;
+        init.Config.ata_max_blocks=256;init.Config.capacity_bytes=config->capacity_bytes;
+        init.Config.optical=0;init.Config.cache=NX_CACHE_UNQUALIFIED;
+        init.SlotCount=NX_NATIVE_DEFAULT_SLOTS;
+    }
+    status=NxNativeCreateClassDevice(context->driver,(PDEVICE_OBJECT)lower,
+                                    &init,(PDEVICE_OBJECT *)created);
+    if(!NT_SUCCESS(status) && kind==NXD_DISK) discard_disk_directory(context);
+    return owner_status(status);
+}
+
+static void seal_class(void *opaque,void *created)
+{
+    (void)opaque;
+    NxNativeSealClassDevice((PDEVICE_OBJECT)created);
+}
+
+static nxd_status submit_native(void *opaque,nxd_device *device,
+    const nxd_io *io,nxd_result *result)
+{
+    NTSTATUS status;
+    (void)opaque;
+    if(!device || !io || !result || !io->native_request)
+        return NXD_INVALID_PARAMETER;
+    if(io->major==NXD_READ || io->major==NXD_WRITE)
+        status=NxNativeDispatchReadWrite((PDEVICE_OBJECT)device->class_device,
+                                         (PIRP)io->native_request);
+    else
+        status=NxNativeDispatchFlush((PDEVICE_OBJECT)device->class_device,
+                                     (PIRP)io->native_request);
+    result->status=owner_status(status);result->information=0;
+    return result->status;
+}
+
+static nxd_status forward_native(void *opaque,nxd_device *device,
+    nxd_forward_operation operation,const nxd_io *io,nxd_result *result)
+{
+    NTSTATUS status;
+    (void)opaque;(void)operation;
+    if(!device || !io || !result || !io->native_request)
+        return NXD_INVALID_PARAMETER;
+    status=NxNativeDispatchControl((PDEVICE_OBJECT)device->class_device,
+                                   (PIRP)io->native_request);
+    result->status=owner_status(status);result->information=0;
+    return result->status;
+}
+
+static nxd_owner_port owner_port(NX_NATIVE_CLASS_CONTEXT *context)
+{
+    nxd_owner_port port={context,register_class,create_class,seal_class,
+                         submit_native,forward_native};
+    return port;
+}
+
+static NTSTATUS NTAPI complete_simple(PDEVICE_OBJECT device,PIRP irp)
+{
+    (void)device;
+    irp->IoStatus.Status=STATUS_SUCCESS;irp->IoStatus.Information=0;
+    IofCompleteRequest(irp,IO_NO_INCREMENT);return STATUS_SUCCESS;
+}
+
+static NTSTATUS NTAPI reject_irp(PDEVICE_OBJECT device,PIRP irp)
+{
+    (void)device;
+    irp->IoStatus.Status=STATUS_INVALID_DEVICE_REQUEST;irp->IoStatus.Information=0;
+    IofCompleteRequest(irp,IO_NO_INCREMENT);return STATUS_INVALID_DEVICE_REQUEST;
+}
+
+static nxd_device_config initial_config(nxd_class_kind kind,
+                                        PDEVICE_OBJECT lower)
+{
+    nxd_device_config config;
+    ULONG alignment=lower ? lower->AlignmentRequirement:0;
+    config.capacity_bytes=0;
+    config.geometry.cylinders=0;
+    config.geometry.media_type=kind==NXD_DISK ? 12:0;
+    config.geometry.tracks_per_cylinder=0;
+    config.geometry.sectors_per_track=0;
+    config.geometry.bytes_per_sector=kind==NXD_DISK ? 512:2048;
+    config.alignment_mask=alignment<config.geometry.bytes_per_sector ? alignment:0;
+    config.removable=kind==NXD_CDROM;
+    return config;
+}
+
+static NTSTATUS add_class_device(NX_NATIVE_CLASS_CONTEXT *context,
+                                 PDEVICE_OBJECT lower)
+{
+    nxd_device_config config=initial_config(context->kind,lower);
+    nxd_status status=nxd_add_device(&context->owner,&context->device,lower,&config);
+    if(status==NXD_SUCCESS) status=nxd_start_device(&context->device,&config);
+    return status==NXD_SUCCESS ? STATUS_SUCCESS:
+        status==NXD_NO_MEMORY ? STATUS_INSUFFICIENT_RESOURCES:
+        status==NXD_INVALID_PARAMETER ? STATUS_INVALID_PARAMETER:STATUS_IO_DEVICE_ERROR;
+}
+
+static NTSTATUS NTAPI add_disk(PDRIVER_OBJECT driver,PDEVICE_OBJECT lower)
+{
+    (void)driver;return add_class_device(&disk_context,lower);
+}
+
+static NTSTATUS NTAPI add_cdrom(PDRIVER_OBJECT driver,PDEVICE_OBJECT lower)
+{
+    (void)driver;return add_class_device(&cdrom_context,lower);
+}
+
+static NTSTATUS install(PDRIVER_OBJECT driver,NX_NATIVE_CLASS_CONTEXT *context,
+                        nxd_class_kind kind,PDRIVER_ADD_DEVICE add_device)
+{
+    ULONG index;
+    nxd_owner_port port;
+    nxd_status status;
+    if(!driver || !driver->DriverExtension) return STATUS_INVALID_PARAMETER;
+    context->driver=driver;context->kind=kind;port=owner_port(context);
+    status=nxd_driver_entry(&context->owner,kind,&port);
+    if(status!=NXD_SUCCESS) return STATUS_INVALID_PARAMETER;
+    for(index=0;index<=IRP_MJ_MAXIMUM_FUNCTION;++index)
+        driver->MajorFunction[index]=reject_irp;
+    driver->MajorFunction[IRP_MJ_CREATE]=complete_simple;
+    driver->MajorFunction[IRP_MJ_CLOSE]=complete_simple;
+    driver->MajorFunction[IRP_MJ_READ]=NxNativeDispatchReadWrite;
+    driver->MajorFunction[IRP_MJ_WRITE]=NxNativeDispatchReadWrite;
+    driver->MajorFunction[IRP_MJ_DEVICE_CONTROL]=NxNativeDispatchControl;
+    driver->MajorFunction[IRP_MJ_PNP]=NxNativeDispatchPnp;
+    driver->MajorFunction[IRP_MJ_FLUSH_BUFFERS]=NxNativeDispatchFlush;
+    driver->MajorFunction[IRP_MJ_SHUTDOWN]=NxNativeDispatchFlush;
+    driver->DriverExtension->AddDevice=add_device;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS NTAPI DiskDriverEntry(PDRIVER_OBJECT driver,PUNICODE_STRING registry)
+{
+    (void)registry;return install(driver,&disk_context,NXD_DISK,add_disk);
+}
+
+NTSTATUS NTAPI CdromDriverEntry(PDRIVER_OBJECT driver,PUNICODE_STRING registry)
+{
+    (void)registry;return install(driver,&cdrom_context,NXD_CDROM,add_cdrom);
+}
diff --git a/drivers/storage/class/nxstorage/native_adapter.c b/drivers/storage/class/nxstorage/native_adapter.c
new file mode 100644
index 0000000..92624d7
--- /dev/null
+++ b/drivers/storage/class/nxstorage/native_adapter.c
@@ -0,0 +1,746 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "native_adapter.h"
+
+enum { NX_NATIVE_SENSE_BYTES=32, NX_NATIVE_TIMEOUT_SECONDS=30,
+       NX_NATIVE_TIMEOUT_LIMIT_SECONDS=120, NX_SRB_SUCCESS=1,
+       NX_CONTROL_BYTES=804 };
+
+typedef struct NX_NATIVE_ENVELOPE {
+    struct NX_NATIVE_ADAPTER *adapter;
+    PIRP parent;
+    PIRP child;
+    SCSI_REQUEST_BLOCK srb;
+    UCHAR sense[NX_NATIVE_SENSE_BYTES];
+    nx_packet_ticket ticket;
+    nx_packet_result deferred_result;
+    nx_packet_status deferred_capture;
+    nx_handle handle;
+    nx_status terminal_status;
+    uint64_t terminal_bytes;
+    unsigned active, dispatch_active, cancel_active, cancel_latched;
+    unsigned handle_valid, terminal_ready, completed;
+    unsigned submit_active, result_deferred, packet_live;
+    PMDL control_mdl;
+    ULONG control_code, control_output;
+    UCHAR control_data[NX_CONTROL_BYTES];
+    unsigned control_active;
+} NX_NATIVE_ENVELOPE;
+
+struct NX_NATIVE_ADAPTER {
+    KSPIN_LOCK lock;
+    KIRQL saved_irql;
+    PDEVICE_OBJECT lower;
+    nx_device core;
+    nx_slot *slots;
+    NX_NATIVE_ENVELOPE *envelopes;
+    ULONG count;
+    unsigned sealed;
+    uint64_t media_capacity;
+    ULONG media_sector, media_generation;
+    unsigned media_present;
+};
+
+typedef struct NX_NATIVE_DEVICE_EXTENSION {
+    NX_NATIVE_ADAPTER adapter;
+    PDEVICE_OBJECT self;
+    PDEVICE_OBJECT lower;
+    PUNICODE_STRING symbolic_link;
+} NX_NATIVE_DEVICE_EXTENSION;
+
+static void zero_bytes(void *pointer,size_t bytes)
+{
+    UCHAR *p=pointer;
+    while(bytes--) *p++=0;
+}
+
+static void copy_bytes(void *to,const void *from,size_t bytes)
+{
+    UCHAR *d=to;const UCHAR *s=from;
+    while(bytes--) *d++=*s++;
+}
+
+static uint32_t read_be32(const UCHAR *p)
+{
+    return (uint32_t)p[0]<<24|(uint32_t)p[1]<<16|(uint32_t)p[2]<<8|p[3];
+}
+
+static void write_le32(UCHAR *p,uint32_t value)
+{
+    p[0]=(UCHAR)value;p[1]=(UCHAR)(value>>8);p[2]=(UCHAR)(value>>16);p[3]=(UCHAR)(value>>24);
+}
+
+static void write_le64(UCHAR *p,uint64_t value)
+{
+    write_le32(p,(uint32_t)value);write_le32(p+4,(uint32_t)(value>>32));
+}
+
+static NTSTATUS native_status(nx_status status)
+{
+    switch(status) {
+    case NX_OK:return STATUS_SUCCESS;
+    case NX_PENDING:return STATUS_PENDING;
+    case NX_INVALID:case NX_RANGE:return STATUS_INVALID_PARAMETER;
+    case NX_NO_MEMORY:return STATUS_INSUFFICIENT_RESOURCES;
+    case NX_SHORT_TRANSFER:return STATUS_BUFFER_OVERFLOW;
+    case NX_CANCELLED:return STATUS_CANCELLED;
+    case NX_WRITE_PROTECTED:return STATUS_MEDIA_WRITE_PROTECTED;
+    case NX_DURABILITY_UNSUPPORTED:return STATUS_NOT_SUPPORTED;
+    default:return STATUS_IO_DEVICE_ERROR;
+    }
+}
+
+static nx_status core_status(const nx_packet_result *result,nx_packet_status captured)
+{
+    if(captured!=NX_PACKET_OK) return NX_PROTOCOL_ERROR;
+    if(result->status==(ULONG)STATUS_CANCELLED) return NX_CANCELLED;
+    if(result->status==(ULONG)STATUS_INSUFFICIENT_RESOURCES) return NX_NO_MEMORY;
+    if((NTSTATUS)result->status<0 || result->srb_base!=NX_SRB_SUCCESS)
+        return NX_IO_ERROR;
+    return NX_OK;
+}
+
+static void port_enter(void *context)
+{
+    NX_NATIVE_ADAPTER *adapter=context;
+    adapter->saved_irql=KfAcquireSpinLock(&adapter->lock);
+}
+
+static void port_leave(void *context)
+{
+    NX_NATIVE_ADAPTER *adapter=context;
+    KfReleaseSpinLock(&adapter->lock,adapter->saved_irql);
+}
+
+static NX_NATIVE_ENVELOPE *find_parent(NX_NATIVE_ADAPTER *adapter,PIRP parent)
+{
+    ULONG index;
+    for(index=0;index<adapter->count;++index)
+        if(adapter->envelopes[index].active && adapter->envelopes[index].parent==parent)
+            return &adapter->envelopes[index];
+    return NULL;
+}
+
+static nx_status port_prepare(void *context,const nx_command *command)
+{
+    NX_NATIVE_ADAPTER *adapter=context;
+    NX_NATIVE_ENVELOPE *envelope=find_parent(adapter,(PIRP)command->parent);
+    nx_packet_resources resources;
+    nx_packet_command packet;
+    PMDL mdl;
+    uint32_t pfn_capacity=0;
+    if(!envelope || envelope->packet_live) return NX_PROTOCOL_ERROR;
+    mdl=envelope->parent->MdlAddress;
+    if(mdl && mdl->Size>=(int)sizeof(*mdl))
+        pfn_capacity=((uint32_t)mdl->Size-(uint32_t)sizeof(*mdl))/(uint32_t)sizeof(ULONG);
+    zero_bytes(&resources,sizeof(resources));
+    resources.child=envelope->child;
+    resources.srb=&envelope->srb;
+    resources.mdl=mdl;
+    resources.sense=envelope->sense;
+    resources.sense_capacity=sizeof(envelope->sense);
+    resources.pfn_capacity=pfn_capacity;
+    resources.driver_owned_idle=1;
+    resources.thread_unlinked=1;
+    zero_bytes(&packet,sizeof(packet));
+    packet.token=command->token;
+    packet.mdl_virtual=command->mdl_virtual;
+    packet.data_virtual=command->data_virtual;
+    packet.bytes=command->bytes;
+    packet.direction=command->direction;
+    packet.function=command->function;
+    packet.cdb_length=command->cdb_length;
+    {
+        unsigned index;
+        for(index=0;index<command->cdb_length;++index) packet.cdb[index]=command->cdb[index];
+    }
+    packet.timeout_seconds=NX_NATIVE_TIMEOUT_SECONDS;
+    packet.timeout_limit_seconds=NX_NATIVE_TIMEOUT_LIMIT_SECONDS;
+    packet.max_bytes=adapter->core.config.max_bytes;
+    packet.max_pages=adapter->core.config.max_pages;
+    packet.alignment_mask=adapter->core.config.alignment_mask;
+    packet.lower_stack_count=adapter->lower->StackSize;
+    packet.completion=NxNativeAdapterChildComplete;
+    packet.completion_context=envelope;
+    if(nx_packet_prepare(&resources,&packet,&envelope->ticket)!=NX_PACKET_OK)
+        return NX_INVALID;
+    envelope->packet_live=1;
+    return NX_OK;
+}
+
+static void report_result(NX_NATIVE_ENVELOPE *envelope,const nx_packet_result *result,
+                          nx_packet_status captured)
+{
+    nx_status status=core_status(result,captured);
+    uint32_t bytes=status==NX_PROTOCOL_ERROR ? 0:(uint32_t)result->reported_bytes;
+    uint32_t flags=result->queue_frozen ? NX_LOWER_QUEUE_FROZEN:0;
+    nx_lower_done(&envelope->adapter->core,result->token,status,bytes,flags);
+}
+
+static int port_submit(void *context,const nx_command *command)
+{
+    NX_NATIVE_ADAPTER *adapter=context;
+    NX_NATIVE_ENVELOPE *envelope=find_parent(adapter,(PIRP)command->parent);
+    NTSTATUS status;
+    nx_packet_result deferred;
+    nx_packet_status captured=NX_PACKET_OK;
+    unsigned report=0;
+    if(!envelope || !envelope->packet_live) return 0;
+    port_enter(adapter);
+    envelope->submit_active=1;
+    port_leave(adapter);
+    status=IofCallDriver(adapter->lower,envelope->child);
+    port_enter(adapter);
+    envelope->submit_active=0;
+    if(envelope->result_deferred) {
+        deferred=envelope->deferred_result;
+        captured=envelope->deferred_capture;
+        envelope->result_deferred=0;
+        report=1;
+    }
+    port_leave(adapter);
+    if(report) report_result(envelope,&deferred,captured);
+    return status==STATUS_PENDING;
+}
+
+static void port_retire(void *context,const nx_command *command)
+{
+    NX_NATIVE_ADAPTER *adapter=context;
+    NX_NATIVE_ENVELOPE *envelope=find_parent(adapter,(PIRP)command->parent);
+    if(envelope) envelope->packet_live=0;
+}
+
+static void port_cancel(void *context,const nx_command *command)
+{
+    NX_NATIVE_ADAPTER *adapter=context;
+    NX_NATIVE_ENVELOPE *envelope=find_parent(adapter,(PIRP)command->parent);
+    if(envelope && envelope->packet_live) (void)IoCancelIrp(envelope->child);
+}
+
+static void port_pending(void *context,void *parent)
+{
+    (void)context;
+    IoMarkIrpPending((PIRP)parent);
+}
+
+static void release_envelope_locked(NX_NATIVE_ENVELOPE *envelope)
+{
+    if(envelope->completed && !envelope->dispatch_active && !envelope->cancel_active) {
+        envelope->active=0;
+        envelope->parent=NULL;
+        envelope->handle_valid=0;
+        envelope->terminal_ready=0;
+    }
+}
+
+static void finish_parent(NX_NATIVE_ENVELOPE *envelope)
+{
+    PIRP parent=envelope->parent;
+    NTSTATUS status=native_status(envelope->terminal_status);
+    parent->Tail.Overlay.DriverContext[0]=NULL;
+    parent->IoStatus.Status=status;
+    parent->IoStatus.Information=(ULONG_PTR)envelope->terminal_bytes;
+    envelope->completed=1;
+    IofCompleteRequest(parent,status==STATUS_SUCCESS ? IO_DISK_INCREMENT:IO_NO_INCREMENT);
+}
+
+static NTSTATUS complete_control_output(NX_NATIVE_ENVELOPE *envelope)
+{
+    PIRP parent=envelope->parent;
+    NX_NATIVE_ADAPTER *adapter=envelope->adapter;
+    UCHAR *output=parent->AssociatedIrp.SystemBuffer;
+    uint64_t capacity;
+    ULONG sector;
+    port_enter(adapter);capacity=adapter->media_capacity;sector=adapter->media_sector;port_leave(adapter);
+    if(!output) return STATUS_INVALID_PARAMETER;
+    if(envelope->control_code==IOCTL_DISK_GET_LENGTH_INFO) {
+        if(envelope->control_output<8) return STATUS_BUFFER_TOO_SMALL;
+        write_le64(output,capacity);parent->IoStatus.Information=8;return STATUS_SUCCESS;
+    }
+    if(envelope->control_code==IOCTL_STORAGE_GET_DEVICE_NUMBER) {
+        if(envelope->control_output<12) return STATUS_BUFFER_TOO_SMALL;
+        zero_bytes(output,12);write_le32(output,adapter->core.config.optical ? FILE_DEVICE_CD_ROM:FILE_DEVICE_DISK);
+        parent->IoStatus.Information=12;return STATUS_SUCCESS;
+    }
+    if(envelope->control_code==IOCTL_DISK_GET_DRIVE_GEOMETRY ||
+       envelope->control_code==IOCTL_CDROM_GET_DRIVE_GEOMETRY ||
+       envelope->control_code==IOCTL_DISK_GET_DRIVE_GEOMETRY_EX) {
+        ULONG required=envelope->control_code==IOCTL_DISK_GET_DRIVE_GEOMETRY_EX ? 32:24;
+        uint64_t denominator=(uint64_t)sector*255u*63u;
+        uint64_t cylinders=denominator ? capacity/denominator:0;
+        if(envelope->control_output<required) return STATUS_BUFFER_TOO_SMALL;
+        if(!cylinders) cylinders=1;
+        zero_bytes(output,required);write_le64(output,cylinders);write_le32(output+8,12);
