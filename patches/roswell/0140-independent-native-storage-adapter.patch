+#!/usr/bin/env python3
+from pathlib import Path
+import os, subprocess, sys
+root=Path(__file__).resolve().parents[3]
+source=root/'drivers/storage/class/nxstorage'
+tests=Path(__file__).resolve().parent
+out=Path(sys.argv[1]).resolve();out.mkdir(parents=True,exist_ok=True)
+cc=os.environ.get('CC','clang')
+base=[cc,'-std=c11','-O1','-g','-Wall','-Wextra','-Werror','-DNX_NATIVE_ADAPTER_HOST',
+      '-I'+str(source),'-I'+str(tests),'-include',str(tests/'native_adapter_host_platform.h')]
+inputs=[str(source/'request.c'),str(source/'native_packet.c'),str(source/'native_adapter.c'),
+        str(source/'nxdisk_owner.c'),str(source/'nxcdrom_profile.c'),str(source/'driver.c'),
+        str(tests/'native_adapter_test.c')]
+for name,flags in [('adapter-plain',[]),('adapter-sanitized',['-fsanitize=address,undefined','-fno-omit-frame-pointer'])]:
+    exe=out/name;subprocess.run(base+flags+inputs+['-o',str(exe)],check=True)
+    result=subprocess.run([str(exe)],check=True,text=True,capture_output=True,
+      env=dict(os.environ,ASAN_OPTIONS='detect_leaks=0:halt_on_error=1',UBSAN_OPTIONS='halt_on_error=1'))
+    print(name+': '+result.stdout.splitlines()[-1])
