+        command.cdb[7]=(UCHAR)(NX_CONTROL_BYTES>>8);command.cdb[8]=(UCHAR)NX_CONTROL_BYTES;
+    } else if(code==IOCTL_CDROM_CHECK_VERIFY) {
+        command.bytes=0;command.direction=0;command.data_virtual=0;command.mdl_virtual=0;
+        command.cdb_length=6;command.cdb[0]=0;
+    }
+    command.timeout_seconds=NX_NATIVE_TIMEOUT_SECONDS;
+    command.timeout_limit_seconds=NX_NATIVE_TIMEOUT_LIMIT_SECONDS;command.max_bytes=NX_CONTROL_BYTES;
+    command.max_pages=2;command.lower_stack_count=adapter->lower->StackSize;command.completion=NxNativeControlComplete;command.completion_context=envelope;
+    if(nx_packet_prepare(&resources,&command,&envelope->ticket)!=NX_PACKET_OK) {
+        envelope->terminal_status=NX_INVALID;envelope->terminal_bytes=0;port_complete(adapter,irp,NX_INVALID,0);return STATUS_INVALID_PARAMETER;
+    }
+    envelope->packet_live=1;envelope->submit_active=1;IoMarkIrpPending(irp);
+    dispatched=IofCallDriver(adapter->lower,envelope->child);
+    port_enter(adapter);envelope->submit_active=0;
+    if(envelope->result_deferred){deferred=envelope->deferred_result;
+        captured=envelope->deferred_capture;envelope->result_deferred=0;report=1;}
+    port_leave(adapter);
+    if(report) (void)finish_control_result(envelope,&deferred,captured);
+    dispatched=STATUS_PENDING;
+    port_enter(adapter);envelope->dispatch_active=0;release_envelope_locked(envelope);port_leave(adapter);
+    return dispatched;
+}
