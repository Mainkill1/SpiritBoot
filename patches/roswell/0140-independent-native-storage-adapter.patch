+    adapter->envelopes=ExAllocatePool(NonPagedPool,(size_t)slot_count*sizeof(*adapter->envelopes));
+    if(!adapter->slots || !adapter->envelopes) goto no_memory;
+    zero_bytes(adapter->envelopes,(size_t)slot_count*sizeof(*adapter->envelopes));
+    adapter->lower=lower;adapter->count=slot_count;KeInitializeSpinLock(&adapter->lock);
+    adapter->media_capacity=config->capacity_bytes;adapter->media_sector=config->sector_bytes;
+    adapter->media_present=config->capacity_bytes!=0;
