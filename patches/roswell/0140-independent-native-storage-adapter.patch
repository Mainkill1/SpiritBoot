+        }
+    }
+    IoAcquireCancelSpinLock(&cancel_irql);
+    if(parent->CancelRoutine==NxNativeAdapterCancel) parent->CancelRoutine=NULL;
+    IoReleaseCancelSpinLock(cancel_irql);
+    port_enter(adapter);
