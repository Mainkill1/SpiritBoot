+
+void NxNativeAdapterSeal(NX_NATIVE_ADAPTER *adapter)
+{
+    if(!adapter) return;
+    port_enter(adapter);adapter->sealed=1;port_leave(adapter);
+}
+
+static void destroy_unpublished_adapter(NX_NATIVE_ADAPTER *adapter)
+{
+    ULONG index;
+    if(!adapter) return;
+    if(adapter->envelopes) {
+        for(index=0;index<adapter->count;++index) {
+            if(adapter->envelopes[index].child)
