+static NTSTATUS NTAPI NxNativeControlComplete(PDEVICE_OBJECT device,PIRP child,PVOID context)
+{
+    NX_NATIVE_ENVELOPE *envelope=context;
+    NX_NATIVE_ADAPTER *adapter=envelope->adapter;
+    nx_packet_result result;
+    nx_packet_status captured;
+    unsigned defer;
+    (void)device;
+    if(child!=envelope->child) return STATUS_MORE_PROCESSING_REQUIRED;
+    captured=nx_packet_capture(&envelope->ticket,&result);
+    port_enter(adapter);defer=envelope->submit_active;
+    if(defer) { envelope->deferred_result=result;envelope->deferred_capture=captured;
+        envelope->result_deferred=1; }
+    port_leave(adapter);
+    if(!defer) (void)finish_control_result(envelope,&result,captured);
+    return STATUS_MORE_PROCESSING_REQUIRED;
+}
+
+static void port_complete(void *context,void *parent,nx_status status,uint64_t bytes)
+{
+    NX_NATIVE_ADAPTER *adapter=context;
+    NX_NATIVE_ENVELOPE *envelope;
+    KIRQL cancel_irql;
+    unsigned finish=0;
+    IoAcquireCancelSpinLock(&cancel_irql);
+    envelope=(NX_NATIVE_ENVELOPE *)((PIRP)parent)->Tail.Overlay.DriverContext[0];
+    if(envelope && ((PIRP)parent)->CancelRoutine==NxNativeAdapterCancel)
+        ((PIRP)parent)->CancelRoutine=NULL;
+    IoReleaseCancelSpinLock(cancel_irql);
+    if(!envelope) return;
+    port_enter(adapter);
+    envelope->terminal_status=status;
+    envelope->terminal_bytes=bytes;
+    envelope->terminal_ready=1;
+    if(!envelope->cancel_active && !envelope->completed) finish=1;
+    port_leave(adapter);
+    if(finish) {
+        finish_parent(envelope);
+        port_enter(adapter);release_envelope_locked(envelope);port_leave(adapter);
+    }
+}
