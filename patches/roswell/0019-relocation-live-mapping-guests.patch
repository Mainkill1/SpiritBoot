diff --git a/tests/xbe/relocation-active-stack/main.c b/tests/xbe/relocation-active-stack/main.c
new file mode 100644
index 00000000..9438be84
--- /dev/null
+++ b/tests/xbe/relocation-active-stack/main.c
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "../relocation-checks.h"
+
+static __attribute__((noinline)) void exercise_stack(void)
+{
+    volatile uint32_t marker[256];
+    uintptr_t esp;
+    for (unsigned i = 0; i < 256; ++i) marker[i] = 0x88990000u + i;
+    __asm__ __volatile__("movl %%esp, %0" : "=r"(esp));
+    PVOID page = (PVOID)(esp & ~(uintptr_t)0xfffu);
+    ULONG before = MmGetPhysicalAddress(page);
+    regression_require(before && before < RELOCATION_UPPER_RAM,
+                       "caller stack source inside title contiguous range");
+    relocation_restore_upper_spill();
+    tap_comment("caller esp=%08lx source=%08lx", (ULONG)esp, before);
+    PVOID pin = relocation_claim(before);
+    regression_require(pin && MmGetPhysicalAddress(pin) == before,
+                       "claim exact frame of a still-active caller stack page");
+    ULONG after = MmGetPhysicalAddress(page);
+    tap_comment("caller stack destination=%08lx", after);
+    regression_check(after && after != before, "active caller stack mapping moved");
+    int intact = 1;
+    for (unsigned i = 0; i < 256; ++i)
+        if (marker[i] != 0x88990000u + i) intact = 0;
+    regression_check(intact, "stack markers and call returns survive relocation");
+    /* Overwrite the original frame only after the allocator has returned.
+     * A stale stack translation would corrupt this function's live frame. */
+    relocation_fill(pin, 0x99aa0000u);
+    intact = 1;
+    for (unsigned i = 0; i < 256; ++i)
+        if (marker[i] != 0x88990000u + i) intact = 0;
+    regression_check(intact, "old stack frame overwrite leaves active markers intact");
+    MmFreeContiguousMemory(pin);
+}
+
+static void NTAPI worker(PVOID context)
+{
+    (void)context;
+    exercise_stack();
+    regression_check(1, "return to parent caller after stack relocation and cleanup");
+}
+
+static void NTAPI system_routine(PKSTART_ROUTINE start, PVOID context)
+{
+    start(context);
+    PsTerminateSystemThread(STATUS_SUCCESS);
+}
+
+int main(void)
+{
+    regression_begin();
+    relocation_prepare_low_source();
+    HANDLE thread = NULL;
+    regression_require(NT_SUCCESS(PsCreateSystemThreadEx(&thread, 0,
+        65536, 0, NULL, worker, NULL, TRUE, FALSE, system_routine)),
+        "create low-backed worker stack");
+    /* The creator finishes its TAP emission before allowing the worker
+     * to write the shared finite-test counters. It emits again only
+     * after the worker has terminated. */
+    if (!NT_SUCCESS(NtResumeThread(thread, NULL)))
+        regression_require(0, "resume worker");
+    LARGE_INTEGER timeout = {.QuadPart = -50000000};
+    regression_require(NtWaitForSingleObject(thread, FALSE, &timeout) == STATUS_SUCCESS,
+                       "worker returns and terminates after stack relocation");
+    regression_check(NT_SUCCESS(NtClose(thread)), "close worker handle");
+    relocation_release_pressure();
+    regression_finish();
+}
diff --git a/tests/xbe/relocation-checks.h b/tests/xbe/relocation-checks.h
new file mode 100644
index 00000000..fa2b0c5d
--- /dev/null
+++ b/tests/xbe/relocation-checks.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <stdint.h>
+#include "regression.h"
+
+#define RELOCATION_PAGE_BYTES 4096u
+#define RELOCATION_UPPER_RAM 0x04000000u
+
+static inline void relocation_fill(PVOID page, uint32_t seed)
+{
+    volatile uint32_t *words = page;
+    for (unsigned i = 0; i < RELOCATION_PAGE_BYTES / sizeof(*words); ++i)
+        words[i] = seed + i;
+}
+
+static inline int relocation_matches(PVOID page, uint32_t seed)
+{
+    volatile uint32_t *words = page;
+    for (unsigned i = 0; i < RELOCATION_PAGE_BYTES / sizeof(*words); ++i)
+        if (words[i] != seed + i) return 0;
+    return 1;
+}
+
+static inline PVOID relocation_claim(ULONG physical)
+{
+    return MmAllocateContiguousMemoryEx(RELOCATION_PAGE_BYTES, physical,
+        physical + RELOCATION_PAGE_BYTES - 1, RELOCATION_PAGE_BYTES,
+        PAGE_READWRITE);
+}
+
+#define RELOCATION_MAX_REGIONS 112u
+static PVOID relocation_regions[RELOCATION_MAX_REGIONS];
+static unsigned relocation_region_count;
+static PVOID relocation_upper_spill;
+
+/* New VM/page-table/thread allocations normally start in upper devkit
+ * RAM. Exhaust that domain to make a low source reachable through the
+ * title contiguous API. Restore the upper spill only after the source
+ * is allocated, otherwise a page table may consume that frame itself. */
+static inline void relocation_prepare_low_source(void)
+{
+    PVOID high = NULL;
+    int reached_low = 0;
+    while (relocation_region_count < RELOCATION_MAX_REGIONS && !reached_low) {
+        SIZE_T size = 1024u * 1024u;
+        PVOID *region = &relocation_regions[relocation_region_count];
+        if (!NT_SUCCESS(NtAllocateVirtualMemory(region, 0, &size,
+            MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE))) break;
+        ++relocation_region_count;
+        for (unsigned off = 0; off < size; off += RELOCATION_PAGE_BYTES) {
+            PVOID page = (PUCHAR)*region + off;
+            ULONG physical = MmGetPhysicalAddress(page);
+            if (!high && physical >= RELOCATION_UPPER_RAM) high = page;
+            if (physical && physical < RELOCATION_UPPER_RAM) reached_low = 1;
+        }
+    }
+    regression_require(reached_low && high, "both low source and upper spill domains available");
+    tap_comment("pressure regions=%u", relocation_region_count);
+    relocation_upper_spill = high;
+}
+
+static inline void relocation_restore_upper_spill(void)
+{
+    SIZE_T size = RELOCATION_PAGE_BYTES;
+    regression_require(NT_SUCCESS(NtFreeVirtualMemory(&relocation_upper_spill, &size, MEM_DECOMMIT)),
+                       "restore upper relocation destination");
+}
+
+static inline void relocation_release_pressure(void)
+{
+    int released = 1;
+    for (unsigned i = 0; i < relocation_region_count; ++i) {
+        SIZE_T size = 0;
+        PVOID base = relocation_regions[i];
+        if (!NT_SUCCESS(NtFreeVirtualMemory(&base, &size, MEM_RELEASE))) released = 0;
+    }
+    regression_check(released, "release all pressure allocations");
+}
