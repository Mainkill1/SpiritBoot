diff --git a/tests/xbe/relocation-page-table/main.c b/tests/xbe/relocation-page-table/main.c
new file mode 100644
index 00000000..3db66bf7
--- /dev/null
+++ b/tests/xbe/relocation-page-table/main.c
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "../relocation-checks.h"
+
+static ULONG entries[1024];
+
+int main(void)
+{
+    /* This guest intentionally inspects the kernel's x86 self-map. It is
+     * a privileged relocation regression, not a portable title workload. */
+    PVOID base = (PVOID)0x18000000u;
+    SIZE_T size = 4 * RELOCATION_PAGE_BYTES;
+    regression_begin();
+    relocation_prepare_low_source();
+    regression_require(NT_SUCCESS(NtAllocateVirtualMemory(&base, 0, &size,
+        MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)), "allocate isolated page-table extent");
+    volatile ULONG *pde = (volatile ULONG *)0xc0300000u + ((uintptr_t)base >> 22);
+    ULONG before_entry = *pde;
+    regression_require((before_entry & 0x81u) == 1,
+                       "extent uses a present non-large page table");
+    ULONG before = before_entry & ~0xfffu;
+    volatile ULONG *table = (volatile ULONG *)(0xc0000000u +
+                                             (((uintptr_t)base >> 22) << 12));
+    regression_require(before && before < RELOCATION_UPPER_RAM,
+                       "page-table source inside title contiguous range");
+    relocation_restore_upper_spill();
+    ULONG physical[3];
+    for (unsigned i = 0; i < 3; ++i) {
+        PVOID page = (PUCHAR)base + i * RELOCATION_PAGE_BYTES;
+        physical[i] = MmGetPhysicalAddress(page);
+        relocation_fill(page, 0x55660000u + i * 0x10000u);
+    }
+    for (unsigned i = 0; i < 1024; ++i) entries[i] = table[i];
+    tap_comment("page table source=%08lx pde=%08lx", before, before_entry);
+    PVOID pin = relocation_claim(before);
+    regression_require(pin && MmGetPhysicalAddress(pin) == before,
+                       "claim exact physical frame backing live page table");
+    ULONG after_entry = *pde;
+    tap_comment("page table destination=%08lx", after_entry & ~0xfffu);
+    regression_check((after_entry & ~0xfffu) != before && (after_entry & 1),
+                     "owning PDE points to relocated page table");
+    int bytes_match = 1, mappings_match = 1;
+    for (unsigned i = 0; i < 3; ++i) {
+        PVOID page = (PUCHAR)base + i * RELOCATION_PAGE_BYTES;
+        bytes_match &= relocation_matches(page, 0x55660000u + i * 0x10000u);
+        mappings_match &= MmGetPhysicalAddress(page) == physical[i];
+    }
+    regression_check(bytes_match, "all mapped data bytes survive page-table relocation");
+    regression_check(mappings_match, "all mapped physical data frames unchanged");
+    int table_match = 1;
+    for (unsigned i = 0; i < 1024; ++i)
+        if ((table[i] & ~0x60u) != (entries[i] & ~0x60u)) table_match = 0;
+    regression_check(table_match, "all 1024 PTEs preserved except hardware accessed/dirty bits");
+    relocation_fill(pin, 0x77880000u);
+    bytes_match = 1;
+    for (unsigned i = 0; i < 3; ++i)
+        bytes_match &= relocation_matches((PUCHAR)base + i * RELOCATION_PAGE_BYTES,
+                                         0x55660000u + i * 0x10000u);
+    regression_check(bytes_match, "old page-table frame overwrite leaves translations intact");
+    mappings_match = 1;
+    for (unsigned i = 0; i < 3; ++i)
+        mappings_match &= MmGetPhysicalAddress((PUCHAR)base + i * RELOCATION_PAGE_BYTES) == physical[i];
+    regression_check(mappings_match, "fresh PTE reads remain valid after old table overwrite");
+    /* No guest load/store has touched this fourth VA. Its first access
+     * after poisoning the old page-table frame requires a cold walk. */
+    PVOID cold = (PUCHAR)base + 3 * RELOCATION_PAGE_BYTES;
+    int zero = 1;
+    volatile uint32_t *cold_words = cold;
+    for (unsigned i = 0; i < RELOCATION_PAGE_BYTES / sizeof(*cold_words); ++i)
+        if (cold_words[i] != 0) zero = 0;
+    relocation_fill(cold, 0xaabb0000u);
+    regression_check(zero && relocation_matches(cold, 0xaabb0000u),
+                     "cold virtual page walk remains zeroed and writable after overwrite");
+    MmFreeContiguousMemory(pin);
+    size = 0;
+    regression_check(NT_SUCCESS(NtFreeVirtualMemory(&base, &size, MEM_RELEASE)),
+                     "release extent through relocated page table");
+    relocation_release_pressure();
+    regression_finish();
+}
