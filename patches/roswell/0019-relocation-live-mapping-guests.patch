diff --git a/tests/xbe/relocation-upper-source/main.c b/tests/xbe/relocation-upper-source/main.c
new file mode 100644
index 00000000..e322eea3
--- /dev/null
+++ b/tests/xbe/relocation-upper-source/main.c
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "../relocation-checks.h"
+
+int main(void)
+{
+    PVOID base = NULL;
+    SIZE_T size = 3 * RELOCATION_PAGE_BYTES;
+    regression_begin();
+    regression_require(NT_SUCCESS(NtAllocateVirtualMemory(&base, 0, &size,
+        MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE)), "allocate upper-source extent");
+    PVOID victim = (PUCHAR)base + RELOCATION_PAGE_BYTES;
+    PVOID right = (PUCHAR)victim + RELOCATION_PAGE_BYTES;
+    ULONG before = MmGetPhysicalAddress(victim);
+    ULONG left_pa = MmGetPhysicalAddress(base), right_pa = MmGetPhysicalAddress(right);
+    regression_require(before >= RELOCATION_UPPER_RAM,
+                       "source is beyond the 64 MiB direct-map window");
+    relocation_fill(base, 0x11220000u);
+    relocation_fill(victim, 0x22330000u);
+    relocation_fill(right, 0x33440000u);
+    tap_comment("upper source=%08lx", before);
+    PVOID pin = relocation_claim(before);
+    regression_require(pin == NULL,
+                       "upper-source window rejected by title API's 64 MiB bound");
+    ULONG after = MmGetPhysicalAddress(victim);
+    tap_comment("upper source after rejection=%08lx", after);
+    regression_check(after == before, "rejected source mapping unchanged");
+    regression_check(relocation_matches(victim, 0x22330000u),
+                     "all 4096 bytes preserved after rejection");
+    regression_check(relocation_matches(base, 0x11220000u) &&
+                     relocation_matches(right, 0x33440000u), "both neighbors preserved");
+    regression_check(MmGetPhysicalAddress(base) == left_pa &&
+                     MmGetPhysicalAddress(right) == right_pa, "neighbor mappings unchanged");
+    size = 0;
+    regression_check(NT_SUCCESS(NtFreeVirtualMemory(&base, &size, MEM_RELEASE)),
+                     "release unchanged extent");
+    regression_finish();
+}
