@@ -162,11 +162,13 @@ static VOID
 NxvFreePageAtPte(
     IN PULONG Pte)
 {
-    PFN_NUMBER Pfn = (*Pte) >> PAGE_SHIFT;
+    PFN_NUMBER Pfn;
     KIRQL OldIrql;
 
-    *Pte = 0;
     OldIrql = MiAcquirePfnLock();
+    /* Relocation can retarget this PTE until the PFN lock is held. */
