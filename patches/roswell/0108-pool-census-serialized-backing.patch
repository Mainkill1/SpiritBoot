@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#define _GNU_SOURCE
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+typedef uint32_t ULONG, POOL_TYPE, KSPIN_LOCK, PFN_NUMBER, *PULONG;
+typedef uint16_t USHORT, *PUSHORT;
+typedef uint8_t UCHAR, BOOLEAN, KIRQL, *PBOOLEAN, *PUCHAR;
+typedef uintptr_t ULONG_PTR;
+typedef uint64_t ULONGLONG;
+typedef size_t SIZE_T;
+typedef void VOID, *PVOID;
+#define IN
+#define OUT
+#define NTAPI
+#define TRUE 1
+#define FALSE 0
+#define DBG 0
+#define ASSERT assert
+#define NXK_MM_POOLPAGES 1
+#define NXK_POOL_CENSUS 1
+#define PAGE_SHIFT 12
+#define PAGE_SIZE 4096u
+#define NXK_POOL_WINDOW_BASE 0xC1000000UL
+#define NXK_POOL_WINDOW_PAGES 4096u
+#define BYTES_TO_PAGES(n) (((n) + PAGE_SIZE - 1) >> PAGE_SHIFT)
+#define PAGE_ALIGN(p) ((PVOID)((ULONG_PTR)(p) & ~(ULONG_PTR)(PAGE_SIZE - 1)))
+#define RTL_NUMBER_OF(a) (sizeof(a) / sizeof((a)[0]))
+#define C_ASSERT(e) _Static_assert((e), #e)
+#define FIELD_OFFSET(t,f) __builtin_offsetof(t,f)
+#define UNREFERENCED_PARAMETER(p) ((void)(p))
+#define RtlZeroMemory(p,n) memset((p),0,(n))
+#define RtlFillMemory(p,n,v) memset((p),(v),(n))
+#define MAXULONG UINT32_MAX
+#define KeMemoryBarrier() __asm__ __volatile__("" ::: "memory")
+#define DPRINT1(...) ((void)0)
+#define NonPagedPool 0
+#define BASE_POOL_TYPE_MASK 1
+#define MUST_SUCCEED_POOL_MASK 0x100
+#define POOL_RAISE_IF_ALLOCATION_FAILURE 0x10
+#define MUST_SUCCEED_POOL_EMPTY 1
+#define BAD_POOL_CALLER 2
+#define BAD_POOL_HEADER 3
+#define STATUS_INSUFFICIENT_RESOURCES 4
+#define TAG_NONE 0x656e6f4e
+static KSPIN_LOCK NxpLock, NxppLock, NxpPoolCensusLock;
+static KIRQL CurrentIrql;
+static BOOLEAN PfnHeld, CheckAtUnlock, BucketRequest, DenyPt;
+static ULONG ModelBacking, ModelPeak, DataTakes, FailDataAt;
+static UCHAR FrameUsed[1024], FrameBucket[1024];
+static int Preemption;
+static PVOID PreemptedAllocation;
+static void CheckBacking(void);
+static void PreemptAfterPageUnlock(void);
+static void KeInitializeSpinLock(KSPIN_LOCK *lock) { *lock = 0; }
+static void KeAcquireSpinLock(KSPIN_LOCK *lock, KIRQL *old) {
+    assert(!*lock && !NxpPoolCensusLock);
+    if (lock == &NxpLock) assert(!NxppLock && !PfnHeld);
+    if (lock == &NxppLock) assert(!NxpLock && !PfnHeld);
+    *old = CurrentIrql; CurrentIrql = 2; *lock = 1;
+}
+static void KeReleaseSpinLock(KSPIN_LOCK *lock, KIRQL old) {
+    assert(*lock); *lock = 0; CurrentIrql = old;
+    if (lock == &NxppLock) {
+        assert(!PfnHeld && !NxpPoolCensusLock && !NxpLock);
+        if (CheckAtUnlock) CheckBacking();
+        PreemptAfterPageUnlock();
+    }
+}
+static KIRQL MiAcquirePfnLock(void) {
+    assert(NxppLock && !PfnHeld && !NxpPoolCensusLock);
+    PfnHeld = TRUE; return CurrentIrql;
+}
+static void MiReleasePfnLock(KIRQL old) {
