diff --git a/tests/host/pool-census-pages/cases.c b/tests/host/pool-census-pages/cases.c
new file mode 100644
index 00000000..d68cb1c9
--- /dev/null
+++ b/tests/host/pool-census-pages/cases.c
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+static void CheckBacking(void) {
+    if (NxpPoolCensusData.BucketPagesCurrent != ModelBacking ||
+        NxpPoolCensusData.BucketPagesPeak != ModelPeak) {
+        fprintf(stderr,"backing mismatch: census %u/%u, physical model %u/%u\n",
+                NxpPoolCensusData.BucketPagesCurrent,NxpPoolCensusData.BucketPagesPeak,
+                ModelBacking,ModelPeak);
+        abort();
+    }
+}
+static PVOID Allocate(SIZE_T bytes, BOOLEAN title) {
+    BOOLEAN previous = BucketRequest;
+    BucketRequest = bytes <= NXP_SMALL_MAX;
+    PVOID p = title ? NxTitleAllocatePoolWithTag(bytes,0x434e5353) :
+                      ExAllocatePoolWithTag(NonPagedPool,bytes,0x434e5353);
+    BucketRequest = previous;
+    return p;
+}
+static void PreemptAfterPageUnlock(void) {
+    int event = Preemption;
+    if (!event) return;
+    Preemption = 0;
+    PVOID p = Allocate(64,FALSE);
+    assert(p);
+    if (event == 1) {
+        ExFreePool(p);
+        assert(NxpReclaimEmptyBucketPages() == 1);
+    } else {
+        PreemptedAllocation = p;
+    }
+}
+static void CheckSettled(void) {
+    ULONG rows = 0;
+    CheckBacking();
+    for (ULONG d = 0; d < NXP_POOL_CENSUS_DOMAIN_COUNT; ++d)
+        for (ULONG c = 0; c < NXP_POOL_CENSUS_CLASS_COUNT; ++c)
+            rows += NxpPoolCensusData.Pages[d][c].CurrentActive +
+                    NxpPoolCensusData.Pages[d][c].CurrentEmpty;
+    assert(rows == ModelBacking);
+    assert(!NxpPoolCensusData.PageUnderflows && !NxpPoolCensusData.Saturations);
+    assert(!NxpPoolCensusData.KeyOverflows && !NxpPoolCensusData.LargeFreeMisses);
+    assert(!NxpPoolCensusData.UntrackedFrees && !(NxpPoolCensusData.Sequence & 1));
+    assert(!NxpLock && !NxppLock && !NxpPoolCensusLock && !PfnHeld);
+}
+static void Map(ULONG_PTR address, SIZE_T bytes) {
+    assert(mmap((PVOID)address,bytes,PROT_READ|PROT_WRITE,
+                MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0) == (PVOID)address);
+}
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    Map(0xC0000000UL,4 * 1024 * 1024);
+    Map(NXK_POOL_WINDOW_BASE,NXK_POOL_WINDOW_PAGES * PAGE_SIZE);
+    PVOID metadata = calloc(1,NxPoolPagesMetadataSize());
+    assert(metadata); NxPoolPagesInitialize(metadata); InitializePool(NonPagedPool,0);
+    if (!strcmp(argv[1],"fresh") || !strcmp(argv[1],"fresh-peak")) {
+        /* Another thread acquires/releases backing before the first caller
+         * has attached its newly acquired page to a class. Physical peak=2. */
+        CheckAtUnlock = !strcmp(argv[1],"fresh"); Preemption = 1;
+        PVOID p = Allocate(32,FALSE); assert(p);
+        assert(NxPoolPagesQueryRunBytes(PAGE_ALIGN(p)) == PAGE_SIZE);
+        assert(ModelBacking == 1 && ModelPeak == 2); CheckSettled();
+        ExFreePool(p); NxpReclaimEmptyBucketPages();
+    } else if (!strcmp(argv[1],"release") || !strcmp(argv[1],"release-peak")) {
+        PVOID p = Allocate(32,FALSE); assert(p); ExFreePool(p);
+        /* Another thread refills immediately after the old physical backing
+         * has been returned. Physical peak stays one, including the refill. */
+        CheckAtUnlock = !strcmp(argv[1],"release"); Preemption = 2;
+        assert(NxpReclaimEmptyBucketPages() == 1);
+        assert(PreemptedAllocation && ModelBacking == 1 && ModelPeak == 1);
+        CheckSettled(); ExFreePool(PreemptedAllocation); NxpReclaimEmptyBucketPages();
+    } else if (!strcmp(argv[1],"rollback")) {
+        /* A failed bucket commit after PT allocation must add no backing. */
+        CheckAtUnlock = TRUE; FailDataAt = 1;
+        assert(!Allocate(32,FALSE)); assert(!ModelBacking && !ModelPeak);
+        /* The ordinary whole-page rollback may return already taken frames;
+         * those frames are not bucket backing. */
+        DataTakes = 0; FailDataAt = 2;
+        assert(!Allocate(8192,FALSE)); assert(!ModelBacking && !ModelPeak);
+        FailDataAt = 0;
+        PVOID whole = Allocate(8192,FALSE); assert(whole);
+        assert(NxPoolPagesQueryRunBytes(whole) == 8192);
+        CheckBacking(); ExFreePool(whole);
+    } else if (!strcmp(argv[1],"pt-failure")) {
+        CheckAtUnlock = TRUE; DenyPt = TRUE;
+        assert(!Allocate(32,FALSE)); assert(!ModelBacking && !ModelPeak);
+    } else if (!strcmp(argv[1],"reuse")) {
+        CheckAtUnlock = TRUE;
+        PVOID p = Allocate(32,FALSE); assert(p); ExFreePool(p);
+        ULONG takes = DataTakes;
+        PVOID same = Allocate(32,FALSE); assert(same); ExFreePool(same);
+        PVOID different = Allocate(512,FALSE); assert(different);
+        assert(PAGE_ALIGN(p) == PAGE_ALIGN(different));
+        assert(ModelBacking == 1 && ModelPeak == 1 && DataTakes == takes);
+        CheckSettled(); ExFreePool(different); NxpReclaimEmptyBucketPages();
+    } else if (!strcmp(argv[1],"domain")) {
+        CheckAtUnlock = TRUE;
+        PVOID kernel = Allocate(32,FALSE); assert(kernel); ExFreePool(kernel);
+        PVOID title = Allocate(512,TRUE); assert(title);
+        assert(ModelBacking == (XBOX_RESERVE_UPPER_RAM ? 2U : 1U));
+        CheckSettled(); ExFreePool(title); NxpReclaimEmptyBucketPages();
+    } else { assert(!"unknown test case"); }
+    CheckSettled(); assert(!ModelBacking);
+    free(metadata);
+    printf("pool census backing: reserve=%d, %s PASS (modeled schedule)\n",
+           XBOX_RESERVE_UPPER_RAM,argv[1]);
+    return 0;
+}
diff --git a/tests/host/pool-census-pages/check.py b/tests/host/pool-census-pages/check.py
new file mode 100644
index 00000000..132027e0
--- /dev/null
+++ b/tests/host/pool-census-pages/check.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Real pool/page/census bodies: backing commits and modeled preemption."""
+import argparse
+import importlib.util
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("output", type=Path)
+parser.add_argument("--source", type=Path, default=root,
+                    help="Kernel tree supplying the maintained production bodies")
+arguments = parser.parse_args()
+source_root = arguments.source.resolve()
+out = arguments.output.resolve()
+out.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location(
+    "extract", root / "tests/host/kernel-performance/check.py")
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+pool = (source_root / "ntoskrnl/xb/mm/pool.c").read_text()
+pages = (source_root / "ntoskrnl/xb/mm/poolpages.c").read_text()
+header = (source_root / "ntoskrnl/xb/mm/pool-census.h").read_text().replace("#pragma once", "")
+census = (source_root / "ntoskrnl/xb/mm/poolcensus.c").read_text()
+census = census.replace("#include <ntoskrnl.h>", "").replace('#include "pool-census.h"', "")
+macros = pool[pool.index("#ifdef NXK_POOL_CENSUS"):pool.index("/* SIZE CLASSES")]
+macros = macros.replace('#include "pool-census.h"', "")
+definitions = pool[pool.index("static const USHORT NxpClassSize"):pool.index("/* BIG-BLOCK TABLE")]
+page_definitions = pages[pages.index("/* WINDOW"):pages.index("/* PUBLIC")]
+page_bodies = pages[pages.index("/* PUBLIC"):pages.index("/*\n * Make a window-mapped")]
+pool_names = ("InitializePool", "NxpDetachEmptyBucketPage", "NxpReuseEmptyBucketPage",
+              "NxpAllocFailed", "NxpAllocatePoolWithTag", "ExAllocatePoolWithTag",
+              "NxTitleAllocatePoolWithTag", "NxTitleAllocatePool", "ExFreePoolWithTag",
+              "ExFreePool", "NxpReclaimEmptyBucketPages", "ExQueryPoolBlockSize")
+pool_bodies = "".join(extract.function(pool, name) for name in pool_names)
+cases = (Path(__file__).parent / "cases.c").read_text()
+shim = (Path(__file__).parent / "shim.c").read_text()
+for reserve in (0, 1):
+    source = out / f"backing-{reserve}.c"
+    source.write_text(shim + f"\n#define XBOX_RESERVE_UPPER_RAM {reserve}\n" +
+                      header + census + page_definitions + page_bodies +
+                      macros + definitions + "\nULONG NxpReclaimEmptyBucketPages(VOID);\n" +
+                      pool_bodies + cases)
+    binary = source.with_suffix("")
+    subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-g",
+                    "-fsanitize=undefined", "-fno-sanitize-recover=all", str(source),
+                    "-o", str(binary)], check=True)
+    for case in ("fresh", "fresh-peak", "release", "release-peak", "rollback",
+                 "pt-failure", "reuse", "domain"):
+        subprocess.run([str(binary), case], check=True)
