+static VOID XbSgFreeMdl(PMDL Mdl)
+{
+    if (Mdl->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA)
+        MmUnmapLockedPages(Mdl->MappedSystemVa, Mdl);
+    IoFreeMdl(Mdl);
+}
+
+/* All caller frames have already been validated and pinned. Establish the
+ * CPU mapping before dispatch, so failure can still select the bounce route. */
+static PMDL XbSgDirectWriteMdl(XB_SG_REQUEST *Request)
+{
+    PMDL mdl;
+    PPFN_NUMBER pfns;
+    ULONG i;
+    for (i = 0; i < Request->Count; ++i)
+        if (!XbSgPageIsWriteBack(Request->Pages[i].Buffer)) return NULL;
+    mdl = IoAllocateMdl(Request->Pages[0].Buffer, Request->Length,
+                        FALSE, FALSE, NULL);
+    if (!mdl) return NULL;
+    if (MmGetMdlByteOffset(mdl) != 0 ||
+        MmGetMdlByteCount(mdl) != Request->Length) {
+        IoFreeMdl(mdl);
+        return NULL;
+    }
+    pfns = MmGetMdlPfnArray(mdl);
+    for (i = 0; i < Request->Count; ++i) pfns[i] = Request->Pages[i].Pfn;
+    mdl->MdlFlags |= MDL_PAGES_LOCKED;
+    if (!MmMapLockedPagesSpecifyCache(mdl, KernelMode, MmCached,
+                                      NULL, FALSE, NormalPagePriority)) {
+        IoFreeMdl(mdl);
+        return NULL;
+    }
+    return mdl;
+}
