+/* Mapping a non-WB source as WB would create a conflicting cache alias.
+ * Xbox has fixed PAT indices: require index zero on the caller's live map. */
+static BOOLEAN XbSgPageIsWriteBack(PVOID Page)
+{
+    ULONG va = (ULONG)(ULONG_PTR)Page;
+    ULONG pde = *(volatile ULONG *)(NXK_PDE_BASE + (va >> 22) * sizeof(ULONG));
+    ULONG pte;
+    if ((pde & 0x19) != 1) return FALSE;
+    if (pde & 0x80) return (pde & 0x1000) == 0;
+    pte = *(volatile ULONG *)(NXK_PTE_BASE + (va >> PAGE_SHIFT) * sizeof(ULONG));
+    return (pte & 0x99) == 1;
+}
