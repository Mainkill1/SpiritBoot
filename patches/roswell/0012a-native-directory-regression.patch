@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production resolver's fields, bounded names and table ownership.
+
+Directory I/O is injected here; the maintained guest exercises actual XDVDFS.
+The inherited negative-status differences remain tracked by issue #36.
+"""
+from pathlib import Path
+import subprocess
+import sys
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+source = (root / 'drivers/filesystems/xdvdfs/xdvdfs.c').read_text()
+start = source.index('static NTSTATUS\nXdvdResolvePath(')
+end = source.index('\n}\n', start) + 3
+preamble = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <strings.h>
+#define _In_
+#define _Out_writes_(n)
+#define _Out_
+#define TRUE 1
+#define FALSE 0
+#define NT_SUCCESS(s) ((s)>=0)
+#define STATUS_SUCCESS 0
+#define STATUS_OBJECT_NAME_INVALID ((int32_t)0xc0000033)
+#define STATUS_OBJECT_NAME_NOT_FOUND ((int32_t)0xc0000034)
+#define STATUS_OBJECT_PATH_NOT_FOUND ((int32_t)0xc000003a)
+#define XDVD_ATTR_DIRECTORY 0x10
+#define XDVD_TAG 0x58445644
+#define RtlZeroMemory(p,n) memset(p,0,n)
+typedef int32_t NTSTATUS;
+typedef unsigned char BOOLEAN,UCHAR,*PUCHAR;
+typedef char CHAR;
+typedef uint16_t WCHAR,*PWCHAR,USHORT;
+typedef uint32_t ULONG;
+typedef ULONG *PULONG;
+typedef void *PVOID;
+typedef struct {USHORT Length,MaximumLength;PWCHAR Buffer;} UNICODE_STRING,*PUNICODE_STRING;
+typedef struct {ULONG RootSector,RootSize;} XDVD_VCB,*PXDVD_VCB;
+typedef struct {PXDVD_VCB Vcb;BOOLEAN IsRoot,IsDirectory;UCHAR Attributes;
+ ULONG DataSector,DataSize;UNICODE_STRING Name;} XDVD_FCB,*PXDVD_FCB;
+typedef struct {ULONG DataSector,DataSize;UCHAR Attributes,NameLength;CHAR Name[64];}
+ XDVD_DIR_ENTRY,*PXDVD_DIR_ENTRY,*PXDVD_DIRENT;
+static unsigned allocations,frees,reads,live;
+static NTSTATUS XdvdReadDirentTable(PXDVD_VCB vcb,ULONG sector,ULONG size,
+ PVOID *out,PULONG bytes)
+{
+ (void)vcb;assert(size==2048);reads++;
+ XDVD_DIR_ENTRY *table=calloc(1,sizeof(*table));assert(table);allocations++;live++;
+ if(sector==1){table->DataSector=10;table->DataSize=2048;
+  table->Attributes=XDVD_ATTR_DIRECTORY;strcpy(table->Name,"Cache");}
+ else if(sector==10){table->DataSector=20;table->DataSize=2048;
+  table->Attributes=XDVD_ATTR_DIRECTORY;strcpy(table->Name,"Resource");}
+ else {assert(sector==20);table->DataSector=21;table->DataSize=18;
+  strcpy(table->Name,"probe.bin");}
+ table->NameLength=strlen(table->Name);*out=table;*bytes=sizeof(*table);return 0;
+}
+static PXDVD_DIR_ENTRY XdvdFindInTable(PVOID table,ULONG bytes,CHAR *name,ULONG len)
+{
+ PXDVD_DIR_ENTRY d=table;assert(bytes==sizeof(*d));
+ return len==d->NameLength&&!strncasecmp(name,d->Name,len)?d:NULL;
+}
+static void ExFreePoolWithTag(PVOID p,ULONG tag)
+{
+ assert(p&&tag==XDVD_TAG&&live==1);free(p);frees++;live--;
+}
+'''
+tests = r'''
+static unsigned cases;
+static void run(const char *text,unsigned length,NTSTATUS expected,unsigned sector,
+ const char *basename,unsigned expected_reads)
+{
+ WCHAR input[256],name[256];memset(name,0xcc,sizeof(name));
+ unsigned available=strlen(text);assert(available<256&&length<=available);
+ /* Deliberately omit a NUL. Bytes after Length may name a missing child. */
+ for(unsigned i=0;i<available;i++)input[i]=(unsigned char)text[i];
+ for(unsigned i=available;i<256;i++)input[i]=0x7777;
+ UNICODE_STRING path={(USHORT)(length*2),(USHORT)(length*2),input};
+ XDVD_VCB vcb={1,2048};XDVD_FCB fcb;
+ allocations=frees=reads=live=0;
+ NTSTATUS got=XdvdResolvePath(&vcb,&path,&fcb,name);
+ assert(got==expected&&reads==expected_reads&&allocations==frees&&live==0);
+ if(got==0){
+  assert(fcb.Vcb==&vcb&&fcb.DataSector==sector);
+  assert(fcb.Name.Buffer==name&&fcb.Name.Length==strlen(basename)*2);
+  for(unsigned i=0;i<strlen(basename);i++)assert(name[i]==(unsigned char)basename[i]);
+  assert(fcb.IsRoot==(sector==1));assert(fcb.IsDirectory==(sector!=21));
+  assert(fcb.DataSize==(sector==21?18:2048));
+  assert(fcb.Attributes==(sector==21?0:XDVD_ATTR_DIRECTORY));
+ }
+ cases++;
+}
+#define TEST(path,status,sector,name,reads) run(path,strlen(path),status,sector,name,reads)
+int main(void)
+{
+ for(unsigned repeat=0;repeat<32;repeat++){
+  TEST("",0,1,"",0);TEST("\\",0,1,"",0);
+  TEST("\\Cache",0,10,"Cache",1);TEST("\\Cache\\",0,10,"Cache",1);
+  TEST("\\Cache\\Resource",0,20,"Resource",2);
+  TEST("\\Cache\\Resource\\",0,20,"Resource",2);
+  TEST("\\Cache\\Resource\\probe.bin",0,21,"probe.bin",3);
+  run("\\Cache\\Missing",7,0,10,"Cache",1);
+  run("\\Cache\\Resource\\Missing",16,0,20,"Resource",2);
+  TEST("\\Cache\\Missing",STATUS_OBJECT_NAME_NOT_FOUND,0,"",2);
+  TEST("\\Cache\\Missing\\",STATUS_OBJECT_PATH_NOT_FOUND,0,"",2);
+  TEST("\\Cache\\Missing\\Child",STATUS_OBJECT_PATH_NOT_FOUND,0,"",2);
+  TEST("\\Cache\\Resource\\probe.bin\\",STATUS_OBJECT_PATH_NOT_FOUND,0,"",3);
+  TEST("\\Cache\\\\Resource",STATUS_OBJECT_NAME_INVALID,0,"",1);
+ }
+ printf("PASS: %u production resolver cases; exact fields, bounds, reads and balanced tables\n",cases);
+}
+'''
+(out / 'actual-directory.c').write_text(preamble + source[start:end] + tests)
+subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+ '-fsanitize=address,undefined', '-fno-omit-frame-pointer',
+ str(out / 'actual-directory.c'), '-o', str(out / 'directory-check')], check=True)
+subprocess.run([str(out / 'directory-check')], check=True)
