--- a/tests/xbe/xdvdfs-directory/main.c
+++ b/tests/xbe/xdvdfs-directory/main.c
@@ -1,22 +1,122 @@
-#include <stdio.h>
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "../regression.h"
+#include <stdint.h>
 #include <string.h>
-#include <windows.h>
-#include <xboxkrnl/xboxkrnl.h>
-#include <hal/video.h>
-#include <nxdk/mount.h>
-int main(void) {
- XVideoSetMode(640,480,32,REFRESH_DEFAULT);
- if(!nxIsDriveMounted('E'))nxMountDrive('E',"\\Device\\Harddisk0\\Partition1");
- FILE *out=fopen("E:\\directory-result.txt","wb");if(!out)for(;;)Sleep(1000);
- const char *paths[]={"\\??\\D:\\", "\\??\\D:\\Cache", "\\??\\D:\\Cache\\", "\\??\\D:\\Cache\\Resource", "\\??\\D:\\Cache\\Resource\\", "\\??\\D:\\Cache\\Missing\\", "\\??\\D:\\Cache\\Resource\\probe.bin\\"};
- unsigned failures=0;
- for(unsigned i=0;i<sizeof(paths)/sizeof(paths[0]);i++){
-  OBJECT_STRING name={(USHORT)strlen(paths[i]),(USHORT)(strlen(paths[i])+1),(PCHAR)paths[i]};
-  OBJECT_ATTRIBUTES oa={NULL,&name,OBJ_CASE_INSENSITIVE};IO_STATUS_BLOCK iosb={0};HANDLE h=NULL;
-  NTSTATUS s=NtOpenFile(&h,FILE_LIST_DIRECTORY|SYNCHRONIZE,&oa,&iosb,FILE_SHARE_READ,FILE_DIRECTORY_FILE|FILE_SYNCHRONOUS_IO_NONALERT);
-  unsigned bad=i<5?!NT_SUCCESS(s):NT_SUCCESS(s);failures+=bad;
-  fprintf(out,"%s path=%s status=%08lx\n",bad?"FAIL":"PASS",paths[i],s);fflush(out);
-  if(NT_SUCCESS(s))NtClose(h);
- }
- fprintf(out,"COMPLETE checks=7 failures=%u\n",failures);fclose(out);for(;;)Sleep(1000);
+
+struct summary {
+    ULONG attributes;
+    LONGLONG size;
+    ULONG name_bytes;
+    unsigned char name[256];
+};
+
+static HANDLE open_path(char *buffer, unsigned length, int directory, NTSTATUS *status)
+{
+    OBJECT_STRING name = {(USHORT)length, (USHORT)length, buffer};
+    OBJECT_ATTRIBUTES oa = {NULL, &name, OBJ_CASE_INSENSITIVE};
+    IO_STATUS_BLOCK iosb = {0};
+    HANDLE handle = NULL;
+    *status = NtOpenFile(&handle, SYNCHRONIZE | (directory ? FILE_LIST_DIRECTORY : GENERIC_READ),
+        &oa, &iosb, FILE_SHARE_READ,
+        FILE_SYNCHRONOUS_IO_NONALERT | (directory ? FILE_DIRECTORY_FILE : FILE_NON_DIRECTORY_FILE));
+    return handle;
+}
+
+static void directory(char *path, unsigned length, struct summary *result)
+{
+    NTSTATUS status;
+    HANDLE handle = open_path(path, length, 1, &status);
+    tap_comment("DIRECTORY length=%u status=%08x", length, (unsigned)status);
+    regression_require(status == STATUS_SUCCESS && handle, "open specified directory");
+    IO_STATUS_BLOCK iosb = {0};
+    FILE_BASIC_INFORMATION basic;
+    regression_require(NtQueryInformationFile(handle, &iosb, &basic, sizeof(basic),
+        FileBasicInformation) == STATUS_SUCCESS && (basic.FileAttributes & FILE_ATTRIBUTE_DIRECTORY),
+        "opened object has directory attributes");
+    FILE_STANDARD_INFORMATION standard;
+    regression_require(NtQueryInformationFile(handle, &iosb, &standard, sizeof(standard),
+        FileStandardInformation) == STATUS_SUCCESS && standard.Directory,
+        "standard information identifies a directory");
+    union { ULONG alignment; unsigned char bytes[512]; } name_buffer;
+    memset(&name_buffer, 0, sizeof(name_buffer));
+    FILE_NAME_INFORMATION *name = (FILE_NAME_INFORMATION *)&name_buffer;
+    regression_require(NtQueryInformationFile(handle, &iosb, name, sizeof(name_buffer),
+        FileNameInformation) == STATUS_SUCCESS && name->FileNameLength <= sizeof(result->name),
+        "query bounded resolved-name payload");
+    result->attributes = basic.FileAttributes;
+    result->size = standard.EndOfFile.QuadPart;
+    result->name_bytes = name->FileNameLength;
+    memset(result->name, 0, sizeof(result->name));
+    memcpy(result->name, name->FileName, name->FileNameLength);
+    regression_require(NtClose(handle) == STATUS_SUCCESS, "close directory handle");
+}
+
+static int same(const struct summary *a, const struct summary *b)
+{
+    return a->attributes == b->attributes && a->size == b->size &&
+        a->name_bytes == b->name_bytes && !memcmp(a->name, b->name, a->name_bytes);
+}
+
+static void negative(char *path, NTSTATUS expected)
+{
+    NTSTATUS status;
+    HANDLE handle = open_path(path, strlen(path), 1, &status);
+    tap_comment("NEGATIVE path=%s status=%08x expected_current=%08x", path,
+        (unsigned)status, (unsigned)expected);
+    if (NT_SUCCESS(status)) NtClose(handle);
+    regression_require(status == expected, "exact inherited negative status (compatibility issue #36 remains open)");
+}
+
+static void read_fixture(void)
+{
+    char path[] = "\\??\\D:\\Cache\\Resource\\probe.bin";
+    NTSTATUS status;
+    HANDLE handle = open_path(path, strlen(path), 0, &status);
+    regression_require(status == STATUS_SUCCESS && handle, "open exact disc fixture file");
+    FILE_BASIC_INFORMATION info; IO_STATUS_BLOCK iosb = {0};
+    regression_require(NtQueryInformationFile(handle, &iosb, &info, sizeof(info),
+        FileBasicInformation) == STATUS_SUCCESS && !(info.FileAttributes & FILE_ATTRIBUTE_DIRECTORY),
+        "fixture remains a file");
+    char bytes[18]; LARGE_INTEGER offset = {.QuadPart = 0};
+    status = NtReadFile(handle, NULL, NULL, NULL, &iosb, bytes, sizeof(bytes), &offset);
+    regression_require(status == STATUS_SUCCESS && iosb.Information == sizeof(bytes) &&
+        !memcmp(bytes, "directory-fixture\n", sizeof(bytes)), "disc file returns all 18 expected bytes");
+    regression_require(NtClose(handle) == STATUS_SUCCESS, "close fixture handle");
+}
+
+int main(void)
+{
+    char *paths[] = {"\\??\\D:\\", "\\??\\D:\\Cache", "\\??\\D:\\Cache\\",
+        "\\??\\D:\\Cache\\Resource", "\\??\\D:\\Cache\\Resource\\"};
+    struct summary results[5], bounded;
+    regression_begin();
+    for (unsigned i = 0; i < 5; ++i) directory(paths[i], strlen(paths[i]), &results[i]);
+    /* Raw paired name equality does not claim ANSI/UTF-16 ABI equivalence.
+     * The production resolver fixture separately checks the exact basename,
+     * sector and size. The native test checks both real opens agree.
+     */
+    regression_require(results[1].name_bytes > 0 && same(&results[1], &results[2]),
+                       "Cache with/without terminal separator has identical attributes, size and name");
+    regression_require(results[3].name_bytes > 0 && same(&results[3], &results[4]),
+                       "Resource with/without terminal separator has identical attributes, size and name");
+    char bounded_name[] = "\\??\\D:\\Cache\\Missing";
+    unsigned length = strlen(paths[2]);
+    /* No NUL within Length or at Buffer[Length]; an overread names Missing. */
+    directory(bounded_name, length, &bounded);
+    regression_require(same(&results[2], &bounded), "non-NUL length-bounded name resolves only the specified directory");
+    /* These exact current statuses intentionally expose inherited differences
+     * from original BIOS: Missing\\ = NAME_NOT_FOUND, file\\ = NOT_A_DIRECTORY.
+     * Issue #36 owns that repair; #27 must not hide it as compatible.
+     */
+    negative("\\??\\D:\\Cache\\Missing\\", STATUS_OBJECT_PATH_NOT_FOUND);
+    negative("\\??\\D:\\Cache\\Resource\\probe.bin\\", STATUS_OBJECT_PATH_NOT_FOUND);
+    negative("\\??\\D:\\Cache\\Missing\\Child", STATUS_OBJECT_PATH_NOT_FOUND);
+    negative("\\??\\D:\\Cache\\\\Resource", STATUS_OBJECT_NAME_INVALID);
+    read_fixture();
+    /* Repeated bounded open/query/close through the repaired terminal path. */
+    for (unsigned i = 0; i < 16; ++i) {
+        directory(paths[i & 1 ? 2 : 4], strlen(paths[i & 1 ? 2 : 4]), &bounded);
+        regression_require(same(&bounded, &results[i & 1 ? 2 : 4]), "repeated terminal open preserves resolved identity");
+    }
+    regression_finish();
 }
