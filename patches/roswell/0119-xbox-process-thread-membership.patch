+typedef struct LIST_ENTRY {struct LIST_ENTRY *Flink,*Blink;} LIST_ENTRY,*PLIST_ENTRY;
+typedef struct NATIVE_PROCESS {CHAR BasePriority;} NATIVE_PROCESS;
+typedef struct KTHREAD {
+ UCHAR XeXboxShadow[0x140]; CHAR Priority,BasePriority; LONG Quantum,QuantumReset;
+ LONG PriorityDecrement,Saturation; ULONG_PTR XeXboxFs4;
+ LONG State;
+ struct {NATIVE_PROCESS *Process;} ApcState;
+ struct {NATIVE_PROCESS *Process;} *ApcStatePointer[1];
