+/* SPDX-License-Identifier: GPL-2.0-or-later */
+static void reset(void) {
+ assert(!pool_lock_held);
+ memset(used,0,sizeof(used));memset(runs,0,sizeof(runs));
+ memset(NxpFreeLists,0,sizeof(NxpFreeLists));
+ committed=peak=allocations=releases=0;allow_pages=1;page_limit=NXK_POOL_WINDOW_PAGES;
+ InitializePool(NonPagedPool,0);
+}
+static void invariant(void) {
+ unsigned seen[NXK_POOL_WINDOW_PAGES]={0};
+ for(unsigned c=0;c<NXP_BUCKET_LISTS;c++) {
+  unsigned traversed=0;
+  for(NXP_FREE *f=NxpFreeLists[c];f;f=f->Next) {
+   assert(++traversed<=NXK_POOL_WINDOW_PAGES*128u);
+   unsigned page=NXP_PAGE_INDEX(f);assert(page<NXK_POOL_WINDOW_PAGES&&used[page]);
+   NXP_HEADER *h=((NXP_HEADER*)f)-1;assert(h->Magic==NXP_MAGIC_FREE&&h->ClassIndex==c);seen[page]++;
+  }
+ }
+ for(unsigned i=0;i<NXK_POOL_WINDOW_PAGES;i++) {
+  if(NxpPageState[i]==NXP_NOT_BUCKET)continue;
+  assert(used[i]);NXP_HEADER *h=(NXP_HEADER*)(arena+i*PAGE_SIZE);
+  assert(seen[i]+NxpPageState[i]==PAGE_SIZE/NxpClassSize[NXP_SIZE_CLASS(h->ClassIndex)]);
+ }
+}
+int main(void) {
+ arena=aligned_alloc(PAGE_SIZE,NXK_POOL_WINDOW_PAGES*PAGE_SIZE);assert(arena);
+ reset();void *a=ExAllocatePoolWithTag(NonPagedPool,64,7);assert(a);
+ ExFreePoolWithTag(a,7);assert(committed==1);
+ void *b=ExAllocatePoolWithTag(NonPagedPool,1024,8);assert(b);
+ if(committed!=1){fprintf(stderr,"FAIL cross-class refill requires extra physical page (%u)\n",committed);return 1;}
+ assert(releases==0&&peak==1);invariant();ExFreePoolWithTag(b,8);
+ allow_pages=0;b=ExAllocatePoolWithTag(NonPagedPool,256,9);assert(b&&committed==1&&releases==0);invariant();ExFreePoolWithTag(b,9);
+ puts("PASS cross-class empty backing reuse, including supplier denial");
+ reset();a=ExAllocatePoolWithTag(NonPagedPool,64,11);memset(a,0x73,64);
+ b=ExAllocatePoolWithTag(NonPagedPool,1024,12);ExFreePoolWithTag(b,12);
+ void *c=ExAllocatePoolWithTag(NonPagedPool,512,13);assert(committed==2);
+ for(unsigned i=0;i<64;i++)assert(((unsigned char*)a)[i]==0x73);
+ invariant();ExFreePoolWithTag(a,11);ExFreePoolWithTag(c,13);
+ assert(NxpReclaimEmptyBucketPages()==2&&committed==0);invariant();
+ puts("PASS live objects preserved, pressure reclamation removes every free-list link");
+ reset();static const unsigned sizes[]={1,24,32,56,64,120,128,248,256,504,512,1024,2040};
+ for(unsigned round=0;round<512;round++) {
+  unsigned n=sizes[round%RTL_NUMBER_OF(sizes)];a=ExAllocatePoolWithTag(NonPagedPool,n,round+1);assert(a);
+  assert(ExQueryPoolBlockSize(a,NULL)>=n);memset(a,0x59,n);
+  for(unsigned i=0;i<n;i++)assert(((unsigned char*)a)[i]==0x59);
+  ExFreePoolWithTag(a,round+1);assert(committed==1&&peak==1);invariant();
+ }
+ assert(NxpReclaimEmptyBucketPages()==1&&committed==0);
+ puts("PASS 512 retypes, capacity/content/free/list integrity");
+#if XBOX_RESERVE_UPPER_RAM
+ reset();a=ExAllocatePoolWithTag(NonPagedPool,64,21);ExFreePoolWithTag(a,21);
+ b=NxTitleAllocatePoolWithTag(1024,22);assert(committed==2);
+ assert((unsigned char*)b<arena+(NXK_POOL_WINDOW_PAGES/2)*PAGE_SIZE);
+ ExFreePoolWithTag(b,22);allow_pages=0;
+ a=ExAllocatePoolWithTag(NonPagedPool,512,23);b=NxTitleAllocatePoolWithTag(256,24);
+ assert(a&&b&&committed==2);assert((unsigned char*)a>=arena+(NXK_POOL_WINDOW_PAGES/2)*PAGE_SIZE);
+ assert((unsigned char*)b<arena+(NXK_POOL_WINDOW_PAGES/2)*PAGE_SIZE);invariant();
+ ExFreePoolWithTag(a,23);ExFreePoolWithTag(b,24);assert(NxpReclaimEmptyBucketPages()==2);
+ puts("PASS independent upper firmware/lower title refill domains");
+#endif
+ free(arena);return 0;
+}
