+        NXP_FREE *Block = (NXP_FREE *)(Header + 1);
+        ASSERT(Header->Magic == NXP_MAGIC_FREE &&
+               Header->ClassIndex == Class);
+        if (Block->Prev) Block->Prev->Next = Block->Next;
+        else NxpFreeLists[Class] = Block->Next;
+        if (Block->Next) Block->Next->Prev = Block->Prev;
+    }
+    NxpPageState[Index] = NXP_NOT_BUCKET;
+    return Page;
+}
+
+/* Reuse mapped backing, preserving the kernel/title allocation domain. */
+static PUCHAR
+NxpReuseEmptyBucketPage(ULONG Class)
+{
+    ULONG i;
+    for (i = 0; i < NXK_POOL_WINDOW_PAGES; ++i)
+    {
+#if XBOX_RESERVE_UPPER_RAM
+        ULONG OldClass;
+#endif
+        if (NxpPageState[i] != 0) continue;
