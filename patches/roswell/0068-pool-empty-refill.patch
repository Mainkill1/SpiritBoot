+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <sanitizer/asan_interface.h>
+typedef uint32_t ULONG, POOL_TYPE;
+typedef uint16_t USHORT;
+typedef uint8_t UCHAR, BOOLEAN, KIRQL, *PBOOLEAN;
+typedef uintptr_t ULONG_PTR;
+typedef size_t SIZE_T;
+typedef void VOID, *PVOID;
+typedef unsigned char *PUCHAR;
+typedef int KSPIN_LOCK;
+#define IN
+#define OUT
+#define NTAPI
+#define UNREFERENCED_PARAMETER(p) ((void)(p))
+#define FALSE 0
+#define TRUE 1
+#define DBG 0
+#define ASSERT assert
+#define NXK_MM_POOLPAGES 1
+#define PAGE_SHIFT 12
+#define PAGE_SIZE 4096u
+#define NXK_POOL_WINDOW_PAGES 4096u
+static unsigned char *arena;
+#define NXK_POOL_WINDOW_BASE ((uintptr_t)arena)
+#define RTL_NUMBER_OF(a) (sizeof(a) / sizeof((a)[0]))
+#define C_ASSERT(a) _Static_assert(a, #a)
+#define NonPagedPool 0
+#define BASE_POOL_TYPE_MASK 1
+#define MUST_SUCCEED_POOL_MASK 0x100
+#define POOL_RAISE_IF_ALLOCATION_FAILURE 0x10
+#define MUST_SUCCEED_POOL_EMPTY 1
+#define BAD_POOL_CALLER 2
+#define BAD_POOL_HEADER 3
+#define STATUS_INSUFFICIENT_RESOURCES 4
+#define TAG_NONE 0x656e6f4e
+#define PAGE_ALIGN(p) ((void *)((uintptr_t)(p) & ~(uintptr_t)(PAGE_SIZE - 1)))
+#define RtlFillMemory(p,n,v) memset(p,v,n)
+#define RtlZeroMemory(p,n) memset(p,0,n)
+static unsigned char used[NXK_POOL_WINDOW_PAGES];
+static unsigned short runs[NXK_POOL_WINDOW_PAGES];
+static unsigned committed, peak, allocations, releases;
+static unsigned page_limit = NXK_POOL_WINDOW_PAGES;
+static int pool_lock_held, allow_pages = 1;
+static void KeInitializeSpinLock(KSPIN_LOCK *p) { *p = 0; }
+static void KeAcquireSpinLock(KSPIN_LOCK *p, KIRQL *old) {
+    assert(!pool_lock_held && !*p); pool_lock_held = 1; *p = 1; *old = 0;
+}
+static void KeReleaseSpinLock(KSPIN_LOCK *p, KIRQL old) {
+    (void)old; assert(pool_lock_held && *p); pool_lock_held = 0; *p = 0;
+}
+static void KeBugCheckEx(ULONG b, ULONG_PTR a, ULONG_PTR c, ULONG_PTR d, ULONG_PTR e) {
+    (void)b;(void)a;(void)c;(void)d;(void)e;assert(!"unexpected bugcheck");
+}
+static void ExRaiseStatus(ULONG status) { (void)status;assert(!"unexpected raise"); }
+static void *pages_alloc(size_t bytes, int title) {
+    assert(!pool_lock_held); allocations++;
+    if (!allow_pages) return NULL;
+    unsigned count = (unsigned)((bytes + PAGE_SIZE - 1) / PAGE_SIZE);
+    if (count > page_limit || committed > page_limit - count) return NULL;
+    unsigned first = title ? 0 : NXK_POOL_WINDOW_PAGES / 2;
+    unsigned end = title ? NXK_POOL_WINDOW_PAGES / 2 : NXK_POOL_WINDOW_PAGES;
+    for (unsigned i = first; i + count <= end; i++) {
+        unsigned j;
+        for (j = 0; j < count && !used[i+j]; j++) {}
+        if (j != count) continue;
+        memset(used+i, 1, count); runs[i] = (unsigned short)count;
+        __asan_unpoison_memory_region(arena+i*PAGE_SIZE, count*PAGE_SIZE);
+        memset(arena+i*PAGE_SIZE, 0xcc, count*PAGE_SIZE);
+        committed += count; if (committed > peak) peak = committed;
+        return arena+i*PAGE_SIZE;
+    }
+    return NULL;
+}
+static void *NxPoolPagesAlloc(size_t bytes) { return pages_alloc(bytes, 0); }
+static void *NxPoolPagesAllocTitle(size_t bytes) __attribute__((unused));
+static void *NxPoolPagesAllocTitle(size_t bytes) { return pages_alloc(bytes, 1); }
+static void NxPoolPagesFree(void *p) {
+    assert(!pool_lock_held && PAGE_ALIGN(p) == p);
+    unsigned i = (unsigned)(((unsigned char *)p-arena)/PAGE_SIZE), n = runs[i];
+    assert(n); for(unsigned j=0;j<n;j++)assert(used[i+j]);
+    memset(used+i,0,n);runs[i]=0;committed-=n;releases++;
+    memset(p,0xdd,n*PAGE_SIZE);
+    __asan_poison_memory_region(p,n*PAGE_SIZE);
+}
+static int NxPoolPagesOwns(void *p) {
+    return (uintptr_t)p >= (uintptr_t)arena && (uintptr_t)p < (uintptr_t)arena+NXK_POOL_WINDOW_PAGES*PAGE_SIZE;
+}
+static size_t NxPoolPagesQueryRunBytes(void *p) {
+    assert(!pool_lock_held);return (size_t)runs[((unsigned char *)p-arena)/PAGE_SIZE]*PAGE_SIZE;
+}
