+/* Caller owns NxpLock; no live block may reference this page. */
+static PUCHAR
+NxpDetachEmptyBucketPage(ULONG Index)
+{
+    PUCHAR Page = (PUCHAR)(NXK_POOL_WINDOW_BASE +
+                          ((ULONG_PTR)Index << PAGE_SHIFT));
+    ULONG Class = ((NXP_HEADER *)Page)->ClassIndex;
