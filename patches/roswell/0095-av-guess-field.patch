diff --git a/tests/host/av-encoder-option/check.py b/tests/host/av-encoder-option/check.py
new file mode 100644
index 0000000000000000000000000000000000000000..aa7f2c6f919a2b68f489101b2c571a9883f7a194
--- /dev/null
+++ b/tests/host/av-encoder-option/check.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Exercise the production AV encoder option dispatcher."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import sys
+
+root, out = map(Path, sys.argv[1:3])
+out.mkdir(parents=True, exist_ok=True)
+text = (root / "hal/halx86/xbox/av.c").read_text()
+
+match = re.search(r"VOID NTAPI\s+AvSendTVEncoderOption\s*\(", text)
+assert match, "missing AvSendTVEncoderOption"
+brace = text.index("{", match.start())
+end, depth = brace + 1, 1
+while depth:
+    depth += (text[end] == "{") - (text[end] == "}")
+    end += 1
+production = text[match.start():end]
+
+shim = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+typedef void VOID, *PVOID;
+typedef uint8_t UCHAR, *PUCHAR;
+typedef uint32_t ULONG, *PULONG;
+#define NTAPI
+#define _In_
+#define _Out_opt_
+#define UNREFERENCED_PARAMETER(x) ((void)(x))
+#define XbDbg(...) ((void)0)
+#define AV_OPTION_GET_SETTINGS 6
+#define AV_OPTION_VIDEO_ENABLE 9
+#define AV_OPTION_FLICKER_FILTER 11
+#define AV_OPTION_SOFTEN_FILTER 14
+#define AV_OPTION_GUESS_FIELD 15
+#define SMBUS_ENCODER_CONEXANT 0x45
+#define ACPI_VIDEO_GATE 0x80d3
+#define ACPI_VIDEO_ON 4
+#define ACPI_VIDEO_OFF 5
+static UCHAR NxkAvEncoderAddress(void) { return 0; }
+static ULONG NxkAvGetEncoderSettings(void) { return 0x004e0104; }
+static void WRITE_PORT_UCHAR(UCHAR *port, UCHAR value)
+{ (void)port; (void)value; }
+static void HalpXboxSmBusWriteByte(UCHAR encoder, UCHAR reg, UCHAR value)
+{ (void)encoder; (void)reg; (void)value; }
+'''
+
+main = r'''
+int main(void)
+{
+    ULONG result = 0xdeadbeef;
+    AvSendTVEncoderOption(NULL, AV_OPTION_GUESS_FIELD, 0, &result);
+    assert(result == 0);
+    AvSendTVEncoderOption(NULL, AV_OPTION_GUESS_FIELD, 0, NULL);
+
+    result = 0xdeadbeef;
+    AvSendTVEncoderOption(NULL, AV_OPTION_GET_SETTINGS, 0, &result);
+    assert(result == 0x004e0104);
+    puts("AV option 15 initializes its optional output");
+    return 0;
+}
+'''
+
+source = out / "check.c"
+binary = out / "check"
+source.write_text(shim + production + main)
+subprocess.run([
+    "cc", "-std=c11", "-O2", "-g", "-Wall", "-Wextra", "-Werror",
+    "-fsanitize=address,undefined", "-fno-omit-frame-pointer",
+    str(source), "-o", str(binary),
+], check=True)
+subprocess.run([str(binary)], check=True,
+               env=dict(os.environ, ASAN_OPTIONS="detect_leaks=0"))
