diff --git a/ntoskrnl/xb/mm/poolcensus.c b/ntoskrnl/xb/mm/poolcensus.c
index 5dfab7ec..d8b7dd1d 100644
--- a/ntoskrnl/xb/mm/poolcensus.c
+++ b/ntoskrnl/xb/mm/poolcensus.c
@@ -247,9 +247,13 @@ NxPoolCensusInitialize(VOID)
 USHORT
 NxPoolCensusBinForSize(SIZE_T NumberOfBytes)
 {
-    SIZE_T Bin = NumberOfBytes / 16;
-    if ((NumberOfBytes & 15) != 0) Bin++;
-    if (Bin > NXP_POOL_CENSUS_BIN_OVERFLOW)
+    SIZE_T Bin;
+    if (NumberOfBytes <= NXP_POOL_CENSUS_SMALL_MAX)
+        Bin = (NumberOfBytes + 7) / 8;
+    else if (NumberOfBytes <= 65536)
+        Bin = NXP_POOL_CENSUS_LARGE_BIN_BASE +
+              (NumberOfBytes - NXP_POOL_CENSUS_SMALL_MAX - 1) / 16;
+    else
         Bin = NXP_POOL_CENSUS_BIN_OVERFLOW;
     return (USHORT)Bin;
 }
