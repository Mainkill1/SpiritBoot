+/* The loader has already installed readonly ROM PTEs at the original image
+ * VAs. Release the unused RAM shadows only after every replacement is live.
+ * Warm-persistent owners are restored through the separate RAM alias first.
+ * The ROM PFNs never enter the RAM allocator or its pin/ownership tables. */
+VOID
+NxkMmRetireRomPages(VOID)
+{
+    const UCHAR *Image = (const UCHAR *)__ImageBase;
+    volatile ULONG *PdeBase = (volatile ULONG *)NXK_PDE_BASE;
+    volatile ULONG *PteBase = (volatile ULONG *)NXK_PTE_BASE;
+    ULONG Pe = NxRomRead32(Image + 0x3c);
+    ULONG Bytes, i, j;
+    int Count;
+
+    if (Pe > 4096 - 88) return;
+    Bytes = NxRomRead32(Image + Pe + 24 + 56);
+    if (Bytes > NXBL_IMAGE_BYTES ||
+        Bytes > XBOX_RAM_MIB * 1024u * 1024u - NXBL_IMAGE_PA) return;
+    Count = NxRomCount(Image, Bytes);
+    if (Count <= 0) return;
+
+    for (i = 0; i < (ULONG)Count; ++i)
+    {
+        const UCHAR *Span = Image + NX_ROM_TABLE_OFFSET + 16 + i * 16;
+        ULONG Rva = NxRomRead32(Span), Pages = NxRomRead32(Span + 4);
+        ULONG RomPa = NxRomRead32(Span + 8);
+        for (j = 0; j < Pages; ++j)
+        {
+            ULONG Va = NXBL_IMAGE_BASE + Rva + j * 4096;
+            ULONG Pde = PdeBase[Va >> 22], Pte;
+            if (!(Pde & 1) || (Pde & 0x80)) return;
+            Pte = PteBase[Va >> 12];
+            if ((Pte & 3) != 1 ||
+                (Pte & ~4095u) != RomPa + j * 4096) return;
+        }
+    }
+    if (InterlockedCompareExchange(&NxRomPagesRetired, 1, 0)) return;
+
