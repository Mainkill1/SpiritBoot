+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <stdio.h>
+#include <string.h>
+#include "rom-kernel.h"
+#include "warm-stage.h"
+static const unsigned char source[0x6000] = {
+#include "image.inc"
+};
+static unsigned char image[sizeof(source)];
+static unsigned checks, failures;
+static void check(int pass,const char *name)
+{++checks;if(!pass){++failures;fprintf(stderr,"FAIL: %s\n",name);}}
+static void put(unsigned offset,unsigned value)
+{for(unsigned i=0;i<4;i++)image[offset+i]=(unsigned char)(value>>(8*i));}
+int main(void)
+{
+ memcpy(image,source,sizeof(image));
+ check(NxRomCount(image,sizeof(image))==2,"owned immutable spans accepted");
+ unsigned first=NxRomRead32(image+0x818);
+ check(NxRomPhysical(image,sizeof(image),0x2000)==first,"selected VA maps to its original ROM bytes");
+ check(!NxRomPhysical(image,sizeof(image),0x1000)&&!NxRomPhysical(image,sizeof(image),0x3000),"patched code and writable state stay RAM");
+ check(NxRomPhysical(image,sizeof(image),0x2fff)==first+4095,"last byte stays inside span");
+ check(!NxRomPhysical(image,sizeof(image),0x6000),"image end rejected");
+ check(NxWarmDonated(image,sizeof(image),2)&&NxWarmDonated(image,sizeof(image),4),"warm admission accepts replaced ROM shadow pages");
+ check(!NxWarmDonated(image,sizeof(image),1)&&!NxWarmDonated(image,sizeof(image),3),"warm admission rejects live patched-code and writable-state frames");
+ const unsigned offsets[]={0x804,0x808,0x80c,0x810,0x814,0x818,0x820,0x824,0x828};
+ const unsigned bad[]={2,33,0x60000,0,0xffffffff,0xff7ff000,0x2000,0xffffffff,0xff000001};
+ for(unsigned i=0;i<sizeof(bad)/sizeof(*bad);i++){
+  memcpy(image,source,sizeof(image));put(offsets[i],bad[i]);
+  check(NxRomCount(image,sizeof(image))==-1,"malformed version/count/extent/overlap/physical mapping rejected");
+ }
+ memcpy(image,source,sizeof(image));put(0x178+36,0xe0000020);
+ check(NxRomCount(image,sizeof(image))==-1,"writable section cannot become ROM");
+ memcpy(image,source,sizeof(image));put(0x178+2*40+36,0x42000040);
+ check(NxRomCount(image,sizeof(image))==-1,"discardable section cannot become permanent ROM");
+ memset(image+0x800,0,0x300);check(NxRomCount(image,sizeof(image))==0,"legacy RAM image has no ROM spans");
+ check(NxRomCount(image,0x800)==0,"short legacy input never reads table outside bounds");
+ printf("ROM table: %u checks, %u failures\n",checks,failures);
+ return failures!=0;
+}
