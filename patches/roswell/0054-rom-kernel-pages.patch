+typedef unsigned char UCHAR;
+typedef uint32_t ULONG;
+typedef uintptr_t ULONG_PTR;
+#define NXKRNL_XZ_MAGIC 0x494b584eUL
+#define NXKRNL_ROM_MAGIC 0x5249584eUL
+#define XZ_ARENA_SIZE (48*1024)
+#define KernelPayloadMaxSize ((const UCHAR *)sizeof(KernelPayloadVa))
+#define dprintf(...) ((void)0)
+typedef struct {ULONG Magic,CompressedSize,DecompressedSize;} NXKRNL_XZ_HEADER;
+static UCHAR XzArena[XZ_ARENA_SIZE],KernelPayloadVa[0x10000];
+static ULONG XzArenaUsed,LoaderFailCode,LoaderPhase;
+static const UCHAR rom_payload[]={
+#include "rom.inc"
+};
+static const UCHAR legacy_payload[]={
+#include "legacy.inc"
+};
+static const UCHAR wrong_payload[]={
+#include "wrong.inc"
+};
+static const UCHAR rom_bytes[]={
+#include "rom-bytes.inc"
+};
+static unsigned checks,failures;
+static void check(int pass,const char *name)
+{++checks;if(!pass){++failures;fprintf(stderr,"FAIL: %s\n",name);}}
+#include "loader.inc"
+static const void *run(const UCHAR *p,unsigned length)
+{memset(KernelPayloadVa,0,sizeof(KernelPayloadVa));memcpy(KernelPayloadVa,p,length);XzArenaUsed=0;LoaderFailCode=0;return DecompressKernel();}
+int main(void)
+{
+ void *ram=mmap((void *)NXBL_IMAGE_PA,0x100000,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+ UCHAR *flash=mmap((void *)(uintptr_t)NX_ROM_BASE,0x80000,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+ if(ram==MAP_FAILED||flash==MAP_FAILED){perror("mmap");return 2;}
+ memcpy(flash+ROM_OFFSET,rom_bytes,sizeof(rom_bytes));
+ check(run(rom_payload,sizeof(rom_payload))==ram,"production decoder accepts ROM framing with validated raw CRCs");
+ check(NxRomCount(ram,0x6000)==2&&!((UCHAR *)ram)[0x2000],"ROM preparation leaves no live RAM code duplicate");
+ flash[ROM_OFFSET+17]^=1;
+ check(!run(rom_payload,sizeof(rom_payload))&&LoaderFailCode,"corrupted raw ROM is rejected before any paging handoff");
+ flash[ROM_OFFSET+17]^=1;
+ check(!run(wrong_payload,sizeof(wrong_payload)),"legacy framing cannot silently admit ROM-dependent image");
+ check(run(legacy_payload,sizeof(legacy_payload))==ram&&((UCHAR *)ram)[0x2000]==37,"legacy RAM firmware still decompresses its original instructions");
+ printf("ROM production loader %u MiB: %u checks, %u failures\n",XBOX_RAM_MIB,checks,failures);
+ munmap(ram,0x100000);munmap(flash,0x80000);return failures!=0;
