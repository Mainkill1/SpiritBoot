+def prepare_rom_kernel_image(kernel: bytes, image_max: int, flash_bytes: int,
+                             retain_pages=frozenset()):
+    """Keep immutable page spans in flash, with no live image RAM duplicate.
+
+    The table lives in unused first-page padding, not in a PE field. Each span
+    preserves its RVA and carries a CRC over the complete zero-padded pages.
+    Runtime-patched pages supplied by the symbol audit remain in RAM.
+    """
+    if flash_bytes not in (0x40000, 0x80000, 0x100000):
+        raise ValueError('unsupported ROM capacity')
+    if len(kernel) < 64:
+        raise ValueError('missing kernel header')
+    pe = struct.unpack_from('<I', kernel, 0x3c)[0]
+    if pe > len(kernel) - 88:
+        raise ValueError('invalid kernel header')
+    if struct.unpack_from('<I', kernel, pe + 24 + 60)[0] > 0x800:
+        raise ValueError('kernel headers overlap ROM table')
+    image = bytearray(prepare_kernel_image(kernel, image_max))
+    for page in retain_pages:
+        if page < 4096 or page & 4095 or page >= len(image):
+            raise ValueError('invalid retained code page')
+    sections = struct.unpack_from('<H', kernel, pe + 6)[0]
+    table = pe + 24 + struct.unpack_from('<H', kernel, pe + 20)[0]
+    spans = []
+    for i in range(sections):
+        sh = table + i * 40
+        size, rva, raw_size = struct.unpack_from('<III', kernel, sh + 8)
+        flags = struct.unpack_from('<I', kernel, sh + 36)[0]
+        if not flags & 0x40000000 or flags & (0x80000000 | 0x02000000):
+            continue
+        end = rva + ((max(size, raw_size) + 4095) & ~4095)
+        next_rva = (struct.unpack_from('<I', kernel, sh + 40 + 12)[0]
+                    if i + 1 < sections else len(image))
+        if end > next_rva or end > len(image):
+            raise ValueError('immutable span exceeds its owned section')
+        start = None
+        for page in range(rva, end + 4096, 4096):
+            if page == end or page in retain_pages:
+                if start is not None:
+                    spans.append((start, page - start)); start = None
+            elif start is None:
+                start = page
+    if not spans or len(spans) > 32:
+        raise ValueError('unsupported immutable span count')
+    raw_bytes = sum(size for _, size in spans)
+    rom_start = flash_bytes - 4096 - raw_bytes
+    if rom_start < 4096:
+        raise ValueError('immutable pages do not fit in ROM')
+    rom = bytearray()
+    struct.pack_into('<IIII', image, 0x800, 0x5052584e, 1, len(spans), flash_bytes)
+    for i, (rva, size) in enumerate(spans):
+        data = bytes(image[rva:rva+size])
+        struct.pack_into('<IIII', image, 0x810 + i * 16, rva, size // 4096,
+                         0xff000000 + rom_start + len(rom), zlib.crc32(data))
+        rom.extend(data)
+        image[rva:rva+size] = bytes(size)
+    # Replaced image RAM is still touched during decompression. Warm-reset
+    # staging must protect it just as it protects donated INIT and workspace.
+    with open(os.path.join(os.path.dirname(__file__), 'warm-handoff.h')) as f:
+        capacity = int(re.search(r'#define PM_MAX_STAGES (\d+)u', f.read())[1])
+    with open(os.path.join(os.path.dirname(__file__), 'boot-layout.h')) as f:
+        workspace = int(re.search(r'#define NXBL_RETIRED_BOOT_PAGES (\d+)', f.read())[1])
+    discarded = 0
+    for i in range(sections):
+        sh = table + i * 40
+        flags = struct.unpack_from('<I', kernel, sh + 36)[0]
+        if flags & 0x02000000 or kernel[sh:sh+8].rstrip(b'\0') == b'INIT':
+            size, _, raw_size = struct.unpack_from('<III', kernel, sh + 8)
+            discarded += (max(size, raw_size) + 4095) // 4096
+    if workspace + discarded + raw_bytes // 4096 > capacity:
+        raise ValueError('warm persistence staging capacity exceeded')
+    return bytes(image), rom_start, bytes(rom)
+
