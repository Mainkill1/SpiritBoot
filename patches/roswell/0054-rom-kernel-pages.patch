+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#define _GNU_SOURCE
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include "boot-layout.h"
+#include "rom-kernel.h"
+#define VOID void
+#define ULONG uint32_t
+#define ULONG_PTR uintptr_t
+#define UCHAR unsigned char
+#define LONG int32_t
+#define PAGE_SIZE 4096u
+#define PD_PA 0xf000u
+#define KSEG0_BASE 0x80000000u
+#define PCR_REGION_PAGES 16u
+#define PCR_REGION_VA 0xffdf0000u
+#define PTE_FLAGS 3u
+#define PD_INDEX(v) ((v)>>22)
+#define PT_INDEX(v) (((v)>>12)&1023)
+#define NXK_PTE_BASE 0xc0000000u
+#define NXK_PDE_BASE 0xc0300000u
+#define dprintf(...) ((void)0)
+#define DPRINT1(...) ((void)0)
+static UCHAR __ImageBase[0x6000] = {
+#include "image.inc"
+};
+static unsigned char ram[128u*1024*1024];
+static unsigned checks,failures,restored[0x8000],donated[0x8000];
+static LONG NxRomPagesRetired;
+static unsigned LoaderKernelSize=sizeof(__ImageBase);
+static unsigned *host_page(unsigned pa){return (unsigned *)(ram+pa);}
+static LONG InterlockedCompareExchange(LONG *p,LONG n,LONG old)
+{return __sync_val_compare_and_swap(p,old,n);}
+static void check(int pass,const char *name)
+{++checks;if(!pass){++failures;fprintf(stderr,"FAIL: %s\n",name);}}
+static void NxkMmRestoreInitPages(uintptr_t pa,unsigned pages)
+{while(pages--)++restored[(pa>>12)+pages];}
+static void NxkMmDonateHeapPages(uintptr_t pa,unsigned pages)
+{while(pages--){unsigned p=(pa>>12)+pages;check(restored[p]==1,"restoration precedes donation");++donated[p];}}
+#include "paging.inc"
+#include "retire.inc"
+int main(void)
+{
+ void *recursive=mmap((void *)NXK_PTE_BASE,0x400000,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+ if(recursive==MAP_FAILED){perror("mmap");return 2;}
+ PagingInit();unsigned *pd=host_page(PD_PA),*pt=host_page(pd[0x210]&~4095u);
+ check(pt[2]==(NxRomPhysical(__ImageBase,sizeof(__ImageBase),0x2000)|1),"actual loader maps code span readonly from ROM");
+ check(pt[4]==(NxRomPhysical(__ImageBase,sizeof(__ImageBase),0x4000)|1),"actual loader maps immutable table readonly from ROM");
+ check(pt[1]==NXBL_IMAGE_PA+0x1000+3&&pt[3]==NXBL_IMAGE_PA+0x3000+3,"actual loader retains patched code and writable state in RAM");
+ unsigned *pdes=(unsigned *)NXK_PDE_BASE;
+ pdes[0x210]=pd[0x210];unsigned *live=(unsigned *)NXK_PTE_BASE+(0x84000000u>>12);
+ memcpy(live,pt,PAGE_SIZE);
+ unsigned code=NXBL_IMAGE_PA/4096+2,data=NXBL_IMAGE_PA/4096+4;
+ live[4]=NXBL_IMAGE_PA+0x4000+3;
+ NxkMmRetireRomPages();check(!donated[code]&&!donated[data],"incomplete replacement mapping cannot free any original RAM");
+ live[4]=pt[4];NxkMmRetireRomPages();
+ check(donated[code]==1&&donated[data]==1,"actual retirement releases both replaced physical RAM pages");
+ check(!donated[code-1]&&!donated[code+1],"patched code and writable-state frames stay reserved");
+ NxkMmRetireRomPages();check(donated[code]==1&&donated[data]==1,"repeat retirement cannot double free frames");
+ check(live[2]==pt[2]&&live[4]==pt[4],"retirement retains executable/readable ROM mappings");
+ printf("ROM paging/retirement %u MiB: %u checks, %u failures\n",XBOX_RAM_MIB,checks,failures);
+ munmap(recursive,0x400000);return failures!=0;
+}
