diff --git a/boot/nxldr/rom-kernel.h b/boot/nxldr/rom-kernel.h
new file mode 100644
index 00000000..e8168d70
--- /dev/null
+++ b/boot/nxldr/rom-kernel.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Private prepared-image residency table in unused header-page padding.
+ * Immutable bytes live in the first flash mirror; kernel VAs stay unchanged.
+ * No allocation or library calls: usable by the loader and warm admission.
+ */
+#ifndef NX_ROM_KERNEL_H
+#define NX_ROM_KERNEL_H
+#define NX_ROM_TABLE_OFFSET 0x800u
+#define NX_ROM_TABLE_MAGIC 0x5052584eu /* NXRP */
+#define NX_ROM_BASE 0xff000000u
+#define NX_ROM_MAX_SPANS 32u
+static inline unsigned NxRomRead16(const unsigned char *P)
+{ return P[0] | ((unsigned)P[1] << 8); }
+static inline unsigned NxRomRead32(const unsigned char *P)
+{ return NxRomRead16(P) | (NxRomRead16(P + 2) << 16); }
+/* Zero: legacy RAM image. Negative: malformed residency table. */
+static inline int NxRomCount(const unsigned char *Image, unsigned Bytes)
+{
+    unsigned count, flash, pe, table, sections, previous = 4096, physical = 0;
+    unsigned i, j;
+    const unsigned char *t;
+    if (Bytes < 4096) return 0;
+    t = Image + NX_ROM_TABLE_OFFSET;
+    if (NxRomRead32(t) != NX_ROM_TABLE_MAGIC) return 0;
+    count = NxRomRead32(t + 8); flash = NxRomRead32(t + 12);
+    if (NxRomRead32(t + 4) != 1 || !count || count > NX_ROM_MAX_SPANS ||
+        (flash != 0x40000 && flash != 0x80000 && flash != 0x100000) ||
+        (Bytes & 4095) || Image[0] != 'M' || Image[1] != 'Z') return -1;
+    pe = NxRomRead32(Image + 0x3c);
+    if (pe > Bytes - 88 || NxRomRead32(Image + pe) != 0x4550 ||
+        NxRomRead16(Image + pe + 4) != 0x14c ||
+        NxRomRead16(Image + pe + 20) < 64 ||
+        NxRomRead32(Image + pe + 24 + 28) != 0x84000000 ||
+        NxRomRead32(Image + pe + 24 + 56) != Bytes ||
+        NxRomRead32(Image + pe + 24 + 60) > NX_ROM_TABLE_OFFSET) return -1;
+    table = pe + 24 + NxRomRead16(Image + pe + 20);
+    sections = NxRomRead16(Image + pe + 6);
+    if (table > NX_ROM_TABLE_OFFSET || !sections ||
+        sections > (NX_ROM_TABLE_OFFSET - table) / 40) return -1;
+    for (i = 0; i < count; ++i) {
+        const unsigned char *span = t + 16 + i * 16;
+        unsigned rva = NxRomRead32(span), pages = NxRomRead32(span + 4);
+        unsigned pa = NxRomRead32(span + 8), size, owned = 0;
+        if ((rva & 4095) || rva < previous || rva > Bytes || !pages ||
+            pages > (Bytes - rva) / 4096) return -1;
+        size = pages * 4096;
+        if ((pa & 4095) || pa < NX_ROM_BASE + 4096 || pa < physical ||
+            pa - NX_ROM_BASE > flash - 4096 ||
+            size > flash - 4096 - (pa - NX_ROM_BASE)) return -1;
+        for (j = 0; j < sections; ++j) {
+            const unsigned char *section = Image + table + j * 40;
+            unsigned start = NxRomRead32(section + 12);
+            unsigned extent = NxRomRead32(section + 8);
+            unsigned raw = NxRomRead32(section + 16);
+            unsigned flags = NxRomRead32(section + 36);
+            if (raw > extent) extent = raw;
+            if (start > Bytes || extent > Bytes - start) return -1;
+            if ((flags & 0x40000000) && !(flags & 0x82000000) &&
+                rva >= start && rva - start < extent &&
+                (rva - start) / 4096 + pages <=
+                    extent / 4096 + (extent % 4096 != 0)) owned = 1;
+        }
+        if (!owned) return -1;
+        previous = rva + size; physical = pa + size;
+    }
+    return (int)count;
+}
+static inline unsigned NxRomPhysical(const unsigned char *Image,
+                                     unsigned Bytes, unsigned Rva)
+{
+    int count = NxRomCount(Image, Bytes);
+    unsigned i;
+    for (i = 0; count > 0 && i < (unsigned)count; ++i) {
+        const unsigned char *span = Image + NX_ROM_TABLE_OFFSET + 16 + i * 16;
+        unsigned start = NxRomRead32(span), size = NxRomRead32(span + 4) * 4096;
+        if (Rva >= start && Rva - start < size)
+            return NxRomRead32(span + 8) + Rva - start;
+    }
+    return 0;
+}
+#endif
