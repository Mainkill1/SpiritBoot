diff --git a/ntoskrnl/xb/mm/sysva.c b/ntoskrnl/xb/mm/sysva.c
index 9fa8a767..4784a5d7 100644
--- a/ntoskrnl/xb/mm/sysva.c
+++ b/ntoskrnl/xb/mm/sysva.c
@@ -30,6 +30,10 @@
 static KSPIN_LOCK NxSysVaLock;
 static LONG       NxSysVaReady = 0;
 
+/* A few INVLPGs avoid the substantially broader CR3 reload while keeping
+ * large mappings on one bounded global invalidation. */
+#define NXK_SYSVA_LOCAL_TLB_MAX 4
+
 /* Page supply (xb/mm/pagesupply.c).  Both require the PFN lock. */
 extern PFN_NUMBER NTAPI NxkPageSupplyTakeZero(ULONG Color);
 extern PFN_NUMBER NTAPI NxkPageSupplyTakeAny(ULONG Color);
@@ -172,18 +176,28 @@ NxkSysVaAllocate(SIZE_T Size, ULONG Protect)
             for (j = 0; j < i; j++)
             {
                 ULONG Idx = (ULONG)(Va >> PAGE_SHIFT) + j;
-                NxkPageSupplyReturn(Pte[Idx] >> PAGE_SHIFT);
+                PFN_NUMBER RollbackPfn = Pte[Idx] >> PAGE_SHIFT;
                 Pte[Idx] = 0;
+                if (i <= NXK_SYSVA_LOCAL_TLB_MAX)
+                    __invlpg((PVOID)(Va + ((ULONG_PTR)j << PAGE_SHIFT)));
+                NxkPageSupplyReturn(RollbackPfn);
             }
             MiReleasePfnLock(PfnIrql);
-            __writecr3(__readcr3());
+            if (i > NXK_SYSVA_LOCAL_TLB_MAX)
+                __writecr3(__readcr3());
             KeReleaseSpinLock(&NxSysVaLock, OldIrql);
             return NULL;
         }
         Pte[(Va >> PAGE_SHIFT) + i] =
             ((ULONG)Pfn << PAGE_SHIFT) | NXK_PTE_VALID;
     }
-    __writecr3(__readcr3());
+    if (Pages <= NXK_SYSVA_LOCAL_TLB_MAX)
+    {
+        for (i = 0; i < Pages; i++)
+            __invlpg((PVOID)(Va + ((ULONG_PTR)i << PAGE_SHIFT)));
+    }
+    else
+        __writecr3(__readcr3());
 
     KeReleaseSpinLock(&NxSysVaLock, OldIrql);
     return (PVOID)Va;
@@ -217,12 +231,15 @@ NxkSysVaFree(PVOID VaPtr, SIZE_T Size)
         if (!(PteVal & 1)) continue;           /* already free */
 
         Pte[Idx] = 0;
+        if (Pages <= NXK_SYSVA_LOCAL_TLB_MAX)
+            __invlpg((PVOID)(Va + ((ULONG_PTR)i << PAGE_SHIFT)));
         PfnIrql = MiAcquirePfnLock();
         NxkPageSupplyReturn(PteVal >> PAGE_SHIFT);
         MiReleasePfnLock(PfnIrql);
         Freed++;
     }
-    __writecr3(__readcr3());
+    if (Pages > NXK_SYSVA_LOCAL_TLB_MAX)
+        __writecr3(__readcr3());
     KeReleaseSpinLock(&NxSysVaLock, OldIrql);
 
     return Freed;
