+    /* Xbox is single-CPU. Exclude the clock ISR as well as other queries,
+     * preserving an already-disabled caller and its current IRQL. */
+    Flags = __readeflags();
+    _disable();
     cur  = READ_PORT_ULONG(XB_PMT_PORT) & XB_PMT_MASK;
     last = NxkPmtLastLow;
     if (cur < last)
