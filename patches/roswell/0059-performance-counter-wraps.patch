+VOID NTAPI NxkUpdatePerformanceCounter(ULONGLONG InterruptTime)
+{
+    /* Called only by the clock ISR, with IRQs disabled. The elapsed-time
+     * deadline is independent of the configured clock tick increment.
+     * Normal sampling must occur within one hardware wrap; a debugger or
+     * an IRQ-disabled interval longer than that cannot recover lost wraps. */
+    if (InterruptTime < NxkPmtNextSample)
+        return;
+    NxkPmtNextSample = InterruptTime + 10000000ULL;
+    NxkReadPmt();
+}
