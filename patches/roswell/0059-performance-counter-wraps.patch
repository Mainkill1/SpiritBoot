@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the actual PM timer extension and clock interrupt bodies."""
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+xbe = (root / "ntoskrnl/xb/xbe.c").read_text()
+start = xbe.index("#define XB_PMT_PORT")
+end = xbe.index("/* Xbox ExQueryPoolBlockSize", start)
+pmt = xbe[start:end]
+time_source = (root / "ntoskrnl/ke/time.c").read_text()
+start = time_source.index("VOID\nFASTCALL\nKeUpdateSystemTime(")
+brace = time_source.index("{", start)
+end = brace + 1
+depth = 1
+while depth:
+    depth += (time_source[end] == "{") - (time_source[end] == "}")
+    end += 1
+clock = time_source[start:end]
+fixture = Path(__file__).with_name("fixture.c").read_text()
+fixture = fixture.replace("/* PRODUCTION_PMT */", pmt)
+fixture = fixture.replace("/* PRODUCTION_CLOCK */", clock)
+fixture = fixture.replace("/* RESET_SAMPLE_DEADLINE */",
+    "NxkPmtNextSample = 10000000ULL;" if "NxkPmtNextSample" in pmt else "")
+(out / "counter.c").write_text(fixture)
+subprocess.run(["cc", "-std=c11", "-O2", "-g", "-fsanitize=undefined,address",
+                "-fno-omit-frame-pointer", "-Wall", "-Wextra", "-Werror",
+                "-Wno-unused-parameter", "-Wno-unused-function", "-fno-strict-aliasing",
+                str(out / "counter.c"),
+                "-o", str(out / "counter")], check=True)
+subprocess.run([str(out / "counter")], check=True)
diff --git a/tests/host/performance-counter/fixture.c b/tests/host/performance-counter/fixture.c
new file mode 100644
index 0000000000000000000000000000000000000000..e7a55ce52b18ca965cc196bd748c5da37e5200c1
--- /dev/null
+++ b/tests/host/performance-counter/fixture.c
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define VOID void
+#define NTAPI
+#define FASTCALL
+#define IN
+#define _M_IX86
+#define DISPATCH_LEVEL 2
+#define FALSE false
+#define EFLAGS_INTERRUPT_MASK 0x200u
+#define DbgPrint(...) ((void)0)
+typedef uint8_t KIRQL;
+typedef uint32_t ULONG, *PULONG, ULONG_PTR;
+typedef int32_t LONG;
+typedef uint64_t ULONGLONG, ULONG64;
+typedef union { struct { ULONG LowPart; LONG HighPart; }; int64_t QuadPart; } LARGE_INTEGER;
+/* Match the host's uint64_t alignment for production counter loads. */
+typedef struct { ULONG LowPart; LONG High1Time; LONG High2Time; }
+    __attribute__((aligned(8))) KSYSTEM_TIME;
+typedef struct { bool SkipTick; unsigned InterruptCount; } PRCB, *PKPRCB;
+typedef void *PKTRAP_FRAME;
+static PRCB prcb;
+static struct { KSYSTEM_TIME InterruptTime, SystemTime, TickCount; } shared;
+#define SharedUserData (&shared)
+static KSYSTEM_TIME KeInterruptTime, KeSystemTime, KeTickCount;
+static LONG KiTickOffset = 10000;
+static ULONG KeTimeAdjustment = 10000, KeMaximumIncrement = 10000;
+static bool KdDebuggerEnabled;
+static uint64_t hardware;
+static uint32_t flags = EFLAGS_INTERRUPT_MASK | 2;
+static KIRQL irql;
+static unsigned port_reads;
+static ULONG __readeflags(void) { return flags; }
+static void _disable(void) { flags &= ~EFLAGS_INTERRUPT_MASK; }
+static void __writeeflags(ULONG value) { flags = value; }
+static void KeRaiseIrql(KIRQL value, KIRQL *old) { *old = irql; irql = value; }
+static void KeLowerIrql(KIRQL old) { irql = old; }
+static ULONG READ_PORT_ULONG(PULONG port)
+{
+    assert((uintptr_t)port == 0x8008);
+    ++port_reads;
+    return hardware & 0x00ffffffu;
+}
+static PKPRCB KeGetCurrentPrcb(void) { return &prcb; }
+static void KiWriteSystemTime(KSYSTEM_TIME *p, LARGE_INTEGER t)
+{ p->High2Time = t.HighPart; p->LowPart = t.LowPart; p->High1Time = t.HighPart; }
+static void KiCheckForTimerExpiration(PKPRCB p, PKTRAP_FRAME f, LARGE_INTEGER t) { }
+static LONG InterlockedExchangeAdd(LONG *p, LONG v) { LONG old = *p; *p += v; return old; }
+static bool KdPollBreakIn(void) { return false; }
+static void DbgBreakPointWithStatus(unsigned value) { }
+#define DBG_STATUS_CONTROL_C 1
+static void KeUpdateRunTime(PKTRAP_FRAME f, KIRQL i) { }
+static void KiEndInterrupt(KIRQL i, PKTRAP_FRAME f) { }
+/* PRODUCTION_PMT */
+/* PRODUCTION_CLOCK */
+
+static void reset(uint64_t start)
+{
+    memset(&shared, 0, sizeof(shared));
+    memset(&KeInterruptTime, 0, sizeof(KeInterruptTime));
+    memset(&KeSystemTime, 0, sizeof(KeSystemTime));
+    memset(&KeTickCount, 0, sizeof(KeTickCount));
+    memset(&prcb, 0, sizeof(prcb));
+    KiTickOffset = 10000;
+    NxkPmtHigh = 0; NxkPmtLastLow = 0;
+    /* RESET_SAMPLE_DEADLINE */
+    hardware = start; port_reads = 0;
+    flags = EFLAGS_INTERRUPT_MASK | 2; irql = 0;
+}
+
+static void clock_tick(unsigned increment)
+{
+    ULONG old_flags = flags;
+    KIRQL old_irql = irql;
+    hardware += 3375000ULL * increment / 10000000;
+    _disable(); irql = 28;
+    KeUpdateSystemTime(NULL, increment, old_irql);
+    assert(!(flags & EFLAGS_INTERRUPT_MASK));
+    assert(irql == 28);
+    flags = old_flags; irql = old_irql;
+}
+
+static void quiet(unsigned milliseconds, unsigned increment)
+{
+    uint64_t before = XeKeQueryPerformanceCounter();
+    uint64_t physical_before = hardware;
+    unsigned steps = milliseconds * 10000u / increment;
+    for (unsigned i = 0; i < steps; ++i) clock_tick(increment);
+    uint64_t delta = XeKeQueryPerformanceCounter() - before;
+    uint64_t expected = hardware - physical_before;
+    printf("quiet=%u ms increment=%u counter=%llu expected=%llu reads=%u\n",
+           milliseconds, increment, (unsigned long long)delta,
+           (unsigned long long)expected, port_reads);
+    fflush(stdout);
+    assert(delta == expected);
+}
+
+int main(void)
+{
+    reset(0);
+    quiet(250, 10000);
+    quiet(6000, 10000);
+    quiet(11000, 10000);
+    assert(port_reads <= 25); /* No port read for each 1 ms tick. */
+    reset(0x00ffffffu - 1000);
+    quiet(6000, 10000);
+    reset(0);
+    quiet(11000, 100000); /* Deadline is elapsed time, not tick count. */
+    for (unsigned level = 0; level <= 31; level += 2) {
+        for (unsigned enabled = 0; enabled < 2; ++enabled) {
+            irql = level; flags = 2 | (enabled ? EFLAGS_INTERRUPT_MASK : 0);
+            ULONG saved_flags = flags;
+            uint64_t a = XeKeQueryPerformanceCounter();
+            hardware += 3375;
+            assert(XeKeQueryPerformanceCounter() == a + 3375);
+            assert(flags == saved_flags && irql == level);
+        }
+    }
+    assert(KeQueryPerformanceFrequency() == 3374488);
+    puts("PASS: production clock/query sparse intervals, wraps and IRQ state");
+    return 0;
+}
