@@ -0,0 +1,7 @@
+# Performance counter quiet-interval regression
+
+An owned public-API guest compares performance-counter elapsed time with interrupt time across 250 ms, 6 s and 11 s intervals without querying the counter during the waits. It produces 13 TAP checks over COM1 and requests normal SMC shutdown.
+
+Build with `NXDK_DIR=/path/to/nxdk PATH=/path/to/nxdk/bin:$PATH make`. Run on a disposable HDD/EEPROM copy with the same emulator configuration for each BIOS. The guest reads no commercial kernel code.
+
+The one-percent tolerance plus two clock ticks covers sample ordering and the unchanged published frequency's calibration difference. This is a correctness test, not a frame-rate benchmark.
diff --git a/tests/xbe/performance-counter/main.c b/tests/xbe/performance-counter/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..46daada9128c7f569b7507d13419b4b2cd3cf98c
--- /dev/null
+++ b/tests/xbe/performance-counter/main.c
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <xboxkrnl/xboxkrnl.h>
+#include "../regression.h"
+
+static void quiet_interval(unsigned milliseconds, ULONGLONG frequency)
+{
+    LARGE_INTEGER delay = { .QuadPart = -(LONGLONG)milliseconds * 10000 };
+    ULONGLONG interrupt_start = KeQueryInterruptTime();
+    ULONGLONG counter_start = KeQueryPerformanceCounter();
+    NTSTATUS status = KeDelayExecutionThread(KernelMode, FALSE, &delay);
+    ULONGLONG counter_end = KeQueryPerformanceCounter();
+    ULONGLONG interrupt_end = KeQueryInterruptTime();
+    ULONGLONG counter_delta = counter_end - counter_start;
+    ULONGLONG interrupt_delta = interrupt_end - interrupt_start;
+    ULONGLONG observed = counter_delta * 10000000ULL;
+    ULONGLONG expected = interrupt_delta * frequency;
+    ULONGLONG error = observed > expected ? observed - expected : expected - observed;
+    /* One-percent allowance plus two clock ticks covers sample order and
+     * the published frequency's small calibration difference. */
+    ULONGLONG tolerance = expected / 100 + frequency * 20000ULL;
+    tap_comment("quiet_ms=%u status=%08lx frequency=%llu counter_start=%llu "
+                "counter_end=%llu counter_delta=%llu interrupt_100ns=%llu",
+                milliseconds, (unsigned long)status,
+                (unsigned long long)frequency,
+                (unsigned long long)counter_start,
+                (unsigned long long)counter_end,
+                (unsigned long long)counter_delta,
+                (unsigned long long)interrupt_delta);
+    regression_check(NT_SUCCESS(status), "quiet delay returns successfully");
+    regression_check(interrupt_delta >= (ULONGLONG)milliseconds * 10000,
+                     "independent interrupt time covers requested wait");
+    regression_check(counter_end > counter_start,
+                     "performance counter advances across quiet interval");
+    regression_check(error <= tolerance,
+                     "performance counter retains every elapsed timer wrap");
+}
+
+int main(void)
+{
+    regression_begin();
+    ULONGLONG frequency = KeQueryPerformanceFrequency();
+    regression_require(frequency >= 3000000 && frequency <= 4000000,
+                       "published Xbox performance frequency is plausible");
+    quiet_interval(250, frequency);
+    quiet_interval(6000, frequency);
+    quiet_interval(11000, frequency);
+    regression_finish();
+}
