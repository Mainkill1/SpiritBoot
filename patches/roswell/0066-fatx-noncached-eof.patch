diff --git a/tests/xbe/fatx-noncached-eof/main.c b/tests/xbe/fatx-noncached-eof/main.c
new file mode 100644
index 00000000..1035ae4d
--- /dev/null
+++ b/tests/xbe/fatx-noncached-eof/main.c
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Distinguish logical EOF from a sector-rounded noncached disk transfer. */
+#include <stdio.h>
+#include <string.h>
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include <nxdk/mount.h>
+#include "../regression.h"
+
+#define FILE_BYTES (65536 + 37)
+static unsigned char data[8192] __attribute__((aligned(4096)));
+static IO_STATUS_BLOCK iosb;
+static volatile LONG callbacks;
+static ULONG callback_bytes;
+static NTSTATUS callback_status;
+
+static void NTAPI completed(PVOID context, PIO_STATUS_BLOCK result,
+                           ULONG reserved)
+{
+    (void)reserved;
+    if (context != &iosb || result != &iosb) return;
+    callback_status = result->Status;
+    callback_bytes = result->Information;
+    InterlockedIncrement(&callbacks);
+}
+
+static void read_check(HANDLE reader, HANDLE event, unsigned mode,
+                       unsigned offset, unsigned length, unsigned expected)
+{
+    LARGE_INTEGER position = { .QuadPart = offset };
+    memset(data, 0xcc, sizeof(data));
+    iosb.Status = STATUS_PENDING;
+    iosb.Information = 0;
+    callbacks = 0;
+    callback_bytes = 0;
+    callback_status = STATUS_PENDING;
+    ResetEvent(event);
+    NTSTATUS status = NtReadFile(reader, mode && mode != 3 ? event : NULL,
+        mode == 3 ? completed : NULL, mode == 3 ? &iosb : NULL,
+        &iosb, data, length, &position);
+    if (!expected) {
+        regression_require(status == (NTSTATUS)STATUS_END_OF_FILE,
+            "beyond EOF terminates without an outstanding request");
+        regression_check(iosb.Information == 0, "EOF completes zero bytes");
+        return;
+    }
+    regression_require(NT_SUCCESS(status), "read accepted");
+    if (mode == 3) {
+        DWORD end = GetTickCount() + 5000;
+        while (!callbacks && (LONG)(end - GetTickCount()) > 0)
+            SleepEx(10, TRUE);
+        regression_require(callbacks == 1, "one native APC is delivered");
+        regression_check(callback_status == STATUS_SUCCESS,
+            "APC reports successful completion");
+        regression_check(callback_bytes == expected,
+            "APC reports logical file bytes, not sector padding");
+    } else if (mode) {
+        regression_require(WaitForSingleObject(event, 5000) == WAIT_OBJECT_0,
+            "event observes completion before buffer reuse");
+    }
+    regression_check(iosb.Status == STATUS_SUCCESS, "IOSB completion succeeds");
+    regression_check(iosb.Information == expected,
+        "IOSB reports logical file bytes, not sector padding");
+    unsigned wrong = 0;
+    for (unsigned i = 0; i < expected; ++i)
+        wrong += data[i] != (unsigned char)((offset + i) ^ ((offset + i) >> 8));
+    regression_check(!wrong, "every logical completed byte matches");
+    tap_comment("fatx_eof mode=%u offset=%u requested=%u expected=%u actual=%lu",
+        mode, offset, length, expected, iosb.Information);
+}
+
+int main(void)
+{
+    regression_begin();
+    if (!nxIsDriveMounted('E'))
+        nxMountDrive('E', "\\Device\\Harddisk0\\Partition1");
+    HANDLE writer = CreateFile("E:\\fatx-eof-regression.bin", GENERIC_WRITE,
+        0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    regression_require(writer != INVALID_HANDLE_VALUE, "private fixture opens");
+    for (unsigned offset = 0; offset < FILE_BYTES; offset += sizeof(data)) {
+        unsigned length = FILE_BYTES - offset;
+        if (length > sizeof(data)) length = sizeof(data);
+        for (unsigned i = 0; i < length; ++i)
+            data[i] = (unsigned char)((offset + i) ^ ((offset + i) >> 8));
+        DWORD written = 0;
+        regression_require(WriteFile(writer, data, length, &written, NULL) &&
+            written == length, "fixture block written exactly");
+    }
+    regression_require(CloseHandle(writer), "writer closes before reading");
+    HANDLE event = CreateEvent(NULL, TRUE, FALSE, NULL);
+    regression_require(event != NULL, "completion event created");
+    for (unsigned mode = 0; mode < 4; ++mode) {
+        DWORD flags = FILE_ATTRIBUTE_NORMAL;
+        if (mode) flags |= FILE_FLAG_OVERLAPPED;
+        if (mode >= 2) flags |= FILE_FLAG_NO_BUFFERING;
+        HANDLE reader = CreateFile("E:\\fatx-eof-regression.bin", GENERIC_READ,
+            FILE_SHARE_READ, NULL, OPEN_EXISTING, flags, NULL);
+        regression_require(reader != INVALID_HANDLE_VALUE, "reader opens");
+        read_check(reader, event, mode, 4096, 512, 512);
+        read_check(reader, event, mode, 65536, 512, 37);
+        read_check(reader, event, mode, 65536, 8192, 37);
+        read_check(reader, event, mode, 66048, 512, 0);
+        CloseHandle(reader);
+    }
+    CloseHandle(event);
+    regression_finish();
+}
