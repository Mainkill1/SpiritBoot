--- /dev/null
+++ b/tests/xbe/contig-extent/main.c
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Requests observed through public Forza APIs, plus page-boundary controls. */
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include "../regression.h"
+int main(void)
+{
+    static const ULONG sizes[]={1,4,16,48,152,256,4095,4096,4097,4192,8191,8192,16416,77824};
+    regression_begin();
+    for(unsigned method=0;method<3;++method) {
+        for(unsigned i=0;i<sizeof(sizes)/sizeof(sizes[0]);++i) {
+            ULONG bytes=sizes[i],rounded=(bytes+4095)&~4095UL;
+            PVOID base=method==0?MmAllocateContiguousMemory(bytes):
+                MmAllocateContiguousMemoryEx(bytes,0,0x03ffffff,method==1?16384:4096,
+                    PAGE_READWRITE|(method==2?PAGE_WRITECOMBINE:0));
+            regression_require(base!=NULL,"allocate bounded contiguous request");
+            ULONG actual=MmQueryAllocationSize(base);
+            tap_comment("allocation method=%u requested=%lu rounded=%lu base=%08lx actual=%lu",
+                method,bytes,rounded,(ULONG)base,actual);
+            regression_check(actual==rounded,"query returns occupied whole-page size");
+            /* Allocation query establishes the valid owned extent before use. */
+            if(actual==rounded) {
+                volatile unsigned char *buffer=base;
+                buffer[0]=0x5a;buffer[rounded-1]=0xa5;
+                regression_check(buffer[0]==0x5a && buffer[rounded-1]==0xa5,
+                    "first and last reported bytes are accessible");
+            } else {
+                regression_check(0,"first and last reported bytes require correct extent");
+            }
+            MmFreeContiguousMemory(base);
+        }
+    }
+    regression_finish();
+}
