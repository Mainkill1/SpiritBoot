From f5a3c6507a56b065e84ad9973056b595740035f9 Mon Sep 17 00:00:00 2001
From: Mainkill1 <Mainkill1@users.noreply.github.com>
Date: Fri, 9 Oct 2026 04:38:34 -0700
Subject: [PATCH] mm: resolve WB physical addresses from live page tables

---
 ntoskrnl/xb/mm/iospace.c             | 14 ++---
 tests/host/physical-address/check.py | 90 ++++++++++++++++++++++++++++
 2 files changed, 96 insertions(+), 8 deletions(-)
 create mode 100644 tests/host/physical-address/check.py

diff --git a/ntoskrnl/xb/mm/iospace.c b/ntoskrnl/xb/mm/iospace.c
index a41d7249..d826af9b 100644
--- a/ntoskrnl/xb/mm/iospace.c
+++ b/ntoskrnl/xb/mm/iospace.c
@@ -46,22 +46,20 @@ NxMmIsAddressValid(IN PVOID Va)
 
 /* VA -> PA *****************************************************************/
 
-/* ULONG_PTR MmGetPhysicalAddress(PVOID Va).  Constant-time for the KSEG0
- * alias / device MMIO / WC RAM aperture; falls back to walking the page
- * tables for VAs outside our static windows (pool, title commits, and the
- * demand-mapped 0xD0000000 system-VA aperture). */
+/* ULONG_PTR MmGetPhysicalAddress(PVOID Va).  Device MMIO / WC apertures
+ * retain their identity-address contract. WB RAM must use the live page
+ * tables: the identity paint stops at System PTE Space, and addresses
+ * above that boundary can map a different frame or be unmapped. */
 ULONG_PTR
 NTAPI
 NxMmGetPhysicalAddress(IN PVOID Va)
 {
     ULONG_PTR V = (ULONG_PTR)Va;
 
-    if (V >= NXK_KSEG0_BASE && V < NXK_KSEG0_BASE + NXK_KSEG0_RAM_SIZE)
-        return V & NXK_PHYS_MASK;
     if (V >= NXK_WC_BASE && V < NXK_MMIO_LIMIT)
-        return V;       /* identity-mapped MMIO + WC mirror */
+        return V;       /* preserve the device/WC API address contract */
 
-    /* Anything else: defer to ARM3's page-table walker. */
+    /* RAM aliases, pool, and system-VA mappings follow their live PTEs. */
     return MmGetPhysicalAddress(Va).LowPart;
 }
 
diff --git a/tests/host/physical-address/check.py b/tests/host/physical-address/check.py
new file mode 100644
index 00000000..bf1f310d
--- /dev/null
+++ b/tests/host/physical-address/check.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Exercise the maintained Xbox address adapter and page-table walker bodies."""
+import pathlib
+import re
+import subprocess
+import sys
+
+root = pathlib.Path(__file__).resolve().parents[3]
+output = pathlib.Path(sys.argv[1]).resolve()
+output.mkdir(parents=True, exist_ok=True)
+
+
+def body(path, name):
+    text = (root / path).read_text()
+    match = re.search(r"\n" + re.escape(name) + r"\s*\(", text)
+    if match is None:
+        raise ValueError(name)
+    start = text.index("{", match.end())
+    depth = 1
+    end = start + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+c = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint32_t ULONG;
+typedef uintptr_t ULONG_PTR;
+typedef void *PVOID;
+typedef union { uint64_t QuadPart; struct { uint32_t LowPart, HighPart; }; } PHYSICAL_ADDRESS;
+typedef union { uint32_t Long; struct { uint32_t Valid:1, Other:6, LargePage:1, Rest:24; } Hard; } ENTRY;
+typedef struct { ENTRY u; } MMPDE, MMPTE, *PMMPDE, *PMMPTE;
+static MMPDE pdes[1024];
+static MMPTE ptes[1024][1024];
+#define MiAddressToPde(v) (&pdes[((uintptr_t)(v) >> 22) & 1023])
+#define MiAddressToPte(v) (&ptes[((uintptr_t)(v) >> 22) & 1023][((uintptr_t)(v) >> 12) & 1023])
+#define NTAPI
+#define IN
+#define NXK_KSEG0_BASE 0x80000000u
+#define NXK_KSEG0_RAM_SIZE 0x04000000u
+#define NXK_PHYS_MASK 0x03ffffffu
+#define NXK_WC_BASE 0xf0000000u
+#define NXK_MMIO_LIMIT 0xffc00000u
+#define PAGE_SIZE 4096
+'''
+c += "\nPHYSICAL_ADDRESS NTAPI MmGetPhysicalAddress(IN PVOID Address)\n" + body("ntoskrnl/xb/mm/fault.c", "MmGetPhysicalAddress")
+c += "\nULONG_PTR NTAPI NxMmGetPhysicalAddress(IN PVOID Va)\n" + body("ntoskrnl/xb/mm/iospace.c", "NxMmGetPhysicalAddress")
+c += r'''
+static void large(uint32_t va, uint32_t pa) { MiAddressToPde((void *)(uintptr_t)va)->u.Long = pa | 0x83; }
+static void small(uint32_t va, uint32_t pa) {
+    MiAddressToPde((void *)(uintptr_t)va)->u.Long = 1;
+    MiAddressToPte((void *)(uintptr_t)va)->u.Long = pa | 1;
+}
+static unsigned failures;
+static void check(const char *name, uint32_t va, uint32_t expected) {
+    uint32_t actual = NxMmGetPhysicalAddress((void *)(uintptr_t)va);
+    printf("%s: %s (actual=%08x expected=%08x)\n", actual == expected ? "PASS" : "FAIL", name, actual, expected);
+    failures += actual != expected;
+}
+int main(void) {
+    large(0x80000000, 0);
+    check("lower WB identity large page", 0x80123456, 0x00123456);
+    small(0x83a01000, 0x01234000);
+    check("system-PTE remapped WB address", 0x83a01000, 0x01234000);
+    check("remapped address preserves page offset", 0x83a01720, 0x01234720);
+    small(0x83a01000, 0x01567000);
+    check("same VA observes replacement mapping", 0x83a01720, 0x01567720);
+    MiAddressToPte((void *)(uintptr_t)0x83a01000)->u.Long = 0;
+    check("same VA observes removed mapping", 0x83a01720, 0);
+    large(0x83000000, 0x01800000);
+    check("nonidentity WB large page", 0x83012a40, 0x01812a40);
+    check("unmapped WB address", 0x83e01000, 0);
+    small(0x84000000, 0x03400000);
+    check("64-MiB relocated kernel image", 0x84000120, 0x03400120);
+    check("invalid PDE", 0xd0401234, 0);
+    small(0xd0001000, 0x00401000);
+    check("system-memory aperture", 0xd0001234, 0x00401234);
+    check("WC aperture contract unchanged", 0xf0001234, 0xf0001234);
+    return failures ? 1 : 0;
+}
+'''
+source = output / "check.c"
+source.write_text(c)
+exe = output / "check"
+subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", str(source), "-o", str(exe)], check=True)
+raise SystemExit(subprocess.run([str(exe)]).returncode)
-- 
