 BS_INIT
 static VOID
+BsRenderCreditsPage(const SbSetup *Setup)
+{
+    CHAR PageLine[48];
+    ULONG Page = Setup->credits_page;
+
+    if (Page >= SB_CREDITS_PAGE_COUNT)
+        Page = 0;
+
+    /* The credits are left of the logo. Keep the right-hand artwork
+     * unchanged when changing page, and never scroll into it. */
+    InbvSolidColorFill(32, 72, SCREEN_WIDTH - 257, 455,
+                       BV_COLOR_BLACK);
+    InbvSetTextColor(BV_COLOR_WHITE);
+    InbvSetScrollRegion(32, 80, SCREEN_WIDTH - 257, 420);
+    InbvDisplayString((PCHAR)BsCreditsPages[Page]);
+
+    sprintf(PageLine, "Page %lu/%u  BACK/B: return",
+            Page + 1, SB_CREDITS_PAGE_COUNT);
+    InbvSetScrollRegion(32, 432, SCREEN_WIDTH - 257, 455);
+    InbvDisplayString(PageLine);
+}
+
+BS_INIT
+static VOID
+BsRenderCredits(const SbSetup *Setup)
+{
+    PVOID Logo;
+
+    /* One full clear on entering credits, never for button release or
+     * page navigation. The bitmap and text stay in INIT/INITDATA. */
+    InbvSolidColorFill(0, 0, SCREEN_WIDTH - 1, SCREEN_HEIGHT - 1,
+                       BV_COLOR_BLACK);
+    Logo = InbvGetResourceAddress(IDB_LOGO_DEFAULT);
+    if (Logo != NULL)
+        InbvBitBlt(Logo, SCREEN_WIDTH - 256, SCREEN_HEIGHT - 256);
+
+    InbvSetTextColor(BV_COLOR_WHITE);
+    InbvSetScrollRegion(32, 24, SCREEN_WIDTH - 257, 68);
+    InbvDisplayString("SpiritBoot Credits");
+    BsRenderCreditsPage(Setup);
+}
