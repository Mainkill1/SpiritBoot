+#!/usr/bin/env python3
+"""Verify the generated static entries in the owned i386 PE image."""
+from pathlib import Path
+import struct,subprocess,sys
+image=Path(sys.argv[1]);data=image.read_bytes();pe=struct.unpack_from('<I',data,0x3c)[0];count=struct.unpack_from('<H',data,pe+6)[0];opt=pe+24;optional_size=struct.unpack_from('<H',data,pe+20)[0];base=struct.unpack_from('<I',data,opt+28)[0]
+sections=[]
+for i in range(count):
+ o=opt+optional_size+40*i;name=data[o:o+8].rstrip(b'\0').decode();size,rva,raw_size,raw=struct.unpack_from('<4I',data,o+8);flags=struct.unpack_from('<I',data,o+36)[0];sections.append((name,size,rva,raw_size,raw,flags))
+text=subprocess.check_output(['i686-w64-mingw32-nm','--numeric-sort',str(image)],text=True)
+symbols={}
+for line in text.splitlines():
+ a=line.split()
+ if len(a)==3:
+  try:symbols[a[2]]=int(a[0],16)
+  except ValueError:pass
+start=symbols['_KiXboxInterruptDispatchStart'];common=symbols['_KiXboxInterruptDispatch'];table=symbols['_KiXboxInterruptObjects']
+def section(address):
+ return next(s for s in sections if base+s[2]<=address<base+s[2]+s[1])
+def read(address,n):
+ s=section(address);o=s[4]+address-base-s[2];assert o+n<=s[4]+s[3];return data[o:o+n]
+s=section(start);assert s[0]=='.text' and s[5]&0x20000000 and not s[5]&0x80000000
+assert common-start==16*16 and section(common)==s
+for i in range(16):
+ at=start+i*16;b=read(at,16);assert b[:2]==bytes((0x6a,i)),(i,b.hex())
+ if b[2]==0xe9:target=at+7+struct.unpack_from('<i',b,3)[0]
+ else:
+  assert b[2]==0xeb;target=at+4+struct.unpack_from('<b',b,3)[0]
+ assert target==common,(i,target,common)
+# The pushed index (4B) plus this shared 0x64B allocation is exactly the
+# original trap frame's 0x68B space before the CPU-supplied EIP/CS/EFLAGS.
+assert read(common,3)==b'\x83\xec\x64'
+s=section(table);assert s[0]=='.bss' and s[5]&0x80000000 and not s[5]&0x20000000
+assert table+64<=base+s[2]+s[1]
+print('built static IRQ entries: all 16 immutable entries, exact stride/target/frame and separate 64-byte data table pass')
