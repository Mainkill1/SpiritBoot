+#!/usr/bin/env python3
+"""Exercise the production incremental boot-menu renderers with Inbv spies."""
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+def function(text: str, name: str) -> str:
+    match = re.search(r"(?:BS_INIT\n)?static\s+\w+\s+\n?" +
+                      re.escape(name) + r"\s*\([^;]*?\)\s*\n\{", text,
+                      re.S)
+    if match is None:
+        raise AssertionError(f"missing production function {name}")
+    start = match.start()
+    body = text.index("{", match.start())
+    end = body + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    chunk = text[start:end]
+    return chunk.removeprefix("BS_INIT\n")
+
+
+def function_body(text: str, name: str) -> str:
+    match = re.search(r"\n" + re.escape(name) + r"\s*\([^;]*?\)\s*\n\{",
+                      text, re.S)
+    if match is None:
+        raise AssertionError(f"missing production function body {name}")
+    start = text.index("{", match.start())
+    end = start + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+root = Path(sys.argv[1]).resolve()
+out = Path(sys.argv[2]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+native = (root / "ntoskrnl/xb/bootsetup_native.c").read_text()
+
+required = {
+    "BS_LEFT": "32u",
+    "BS_TEXT_RIGHT": "383u",
+    "BS_FIRST_ROW_Y": "80u",
+    "BS_ROW_PITCH": "14u",
+    "BS_FOOTER_Y": "248u",
+    "BS_FOOTER_BOTTOM": "275u",
+}
+for name, value in required.items():
+    assert re.search(rf"#define\s+{name}\s+{value}\b", native), name
+assert 'BsMenuLine[] = "  %c %-20.20s %.19s";' in native
+
+loop = function_body(native, "NxkBootSetupRun")
+assert "PreviousButtons" not in loop
+assert "Input.buttons !=" not in loop
+assert "Before = Setup;" in loop
+assert "BsMenuDirtyRows(&Before, &Setup)" in loop
+
+credits = function(native, "BsRenderCredits")
+assert "SCREEN_WIDTH - 1" not in credits
+assert "InbvBitBlt" not in credits
+initial = function(native, "BsRenderMenuInitial")
+assert "SCREEN_WIDTH - 1" in initial
+assert "InbvBitBlt" in initial
+
+names = [
+    "BsRenderCreditsPage", "BsRenderCredits", "BsDrawMenuRow",
+    "BsDrawFooterLine", "BsRenderFooter", "BsRenderMenuContent",
+    "BsRenderMenuInitial", "BsMenuDirtyRows",
+]
+production = "\n\n".join(function(native, name) for name in names)
+
+fixture = out / "boot-menu-render.c"
+fixture.write_text(r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef unsigned long ULONG;
+typedef void VOID;
+typedef void *PVOID;
+typedef char CHAR;
+typedef char *PCHAR;
+typedef const char *PCSTR;
+typedef enum {
+    SB_MENU_EDIT, SB_MENU_CONFIRM_SAVE, SB_MENU_CONFIRM_DISCARD,
+    SB_MENU_CONTINUE, SB_MENU_REBOOT, SB_MENU_RECOVERY, SB_MENU_CREDITS
+} SbMenuState;
+typedef unsigned SbSetupRow;
+enum { SB_ROW_COUNT = 11, SB_CREDITS_PAGE_COUNT = 3 };
+typedef struct {
+    SbSetupRow row;
+    SbMenuState state;
+    uint8_t credits_page;
+    char values[SB_ROW_COUNT][48];
+} SbSetup;
+
+#define SCREEN_WIDTH 640u
+#define SCREEN_HEIGHT 480u
+#define BS_LEFT 32u
+#define BS_TEXT_RIGHT 383u
+#define BS_SCROLL_RIGHT 607u
+#define BS_TITLE_TOP 24u
+#define BS_TITLE_BOTTOM 79u
+#define BS_FIRST_ROW_Y 80u
+#define BS_ROW_PITCH 14u
+#define BS_FONT_HEIGHT 13u
+#define BS_FOOTER_Y 248u
+#define BS_FOOTER_BOTTOM 275u
+#define BS_CONTENT_BOTTOM 455u
+#define BV_COLOR_BLACK 0u
+#define BV_COLOR_WHITE 15u
+#define IDB_LOGO_DEFAULT 1u
