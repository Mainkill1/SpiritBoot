+
+static const char BsMenuLine[] = "  %c %-20.20s %.19s";
+static const char BsMenuTitle[] = "SpiritBoot Settings";
+static const char BsConfirmSave1[] = "Save these settings and reboot?";
+static const char BsConfirmSave2[] = "A: yes   B: no";
+static const char BsConfirmDiscard1[] = "Discard changes and continue?";
+static const char BsConfirmDiscard2[] = "A: yes   B: no";
+static const char BsRecovery1[] = "EEPROM write was incomplete.";
+static const char BsRecovery2[] = "Press A to repair/retry.";
+static const char * const BsCreditsPages[] = { "core", "testing", "research" };
+static const char * const Labels[SB_ROW_COUNT] = {
