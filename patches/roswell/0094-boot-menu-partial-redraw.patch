+}
+
+int main(void)
+{
+    SbSetup before = make_setup();
+    SbSetup after = before;
+    ULONG dirty;
+    unsigned row;
+
+    reset_spy();
+    BsRenderMenuInitial(&before);
+    assert(blit_count == 1);
+    assert(fill_count >= 1);
+    assert(fills[0].l == 0 && fills[0].t == 0);
+    assert(fills[0].r == 639 && fills[0].b == 479);
+
+    reset_spy();
+    dirty = BsMenuDirtyRows(&before, &after);
+    assert(dirty == 0);
+    assert(fill_count == 0 && blit_count == 0 && string_count == 0);
+
+    after.row = 1;
+    dirty = BsMenuDirtyRows(&before, &after);
+    assert(dirty == ((1u << 0) | (1u << 1)));
+    for (row = 0; row < SB_ROW_COUNT; ++row)
+        if (dirty & (1u << row)) BsDrawMenuRow(&after, row);
+    assert(fill_count == 2 && blit_count == 0);
+    assert_no_logo_fill();
+    assert(strlen(strings[0]) <= 44 && strchr(strings[0], '\n') == NULL);
+
