+''' + production + r'''
+
+static SbSetup make_setup(void)
+{
+    SbSetup s = {0};
+    unsigned i;
+    s.state = SB_MENU_EDIT;
+    for (i = 0; i < SB_ROW_COUNT; ++i)
+        snprintf(s.values[i], sizeof(s.values[i]), "value%u", i);
+    return s;
+}
+
+static void assert_no_logo_fill(void)
+{
+    unsigned i;
+    for (i = 0; i < fill_count; ++i)
