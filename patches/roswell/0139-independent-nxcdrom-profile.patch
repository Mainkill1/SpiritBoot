+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NXCDROM_PROFILE_H
+#define NXCDROM_PROFILE_H
+
+#include "native_adapter.h"
+
+/* Prepare the immutable optical creation profile.  Device creation and all
+ * resource ownership remain with NxNativeCreateClassDevice and its caller. */
+NTSTATUS NxCdromBuildDeviceInit(NX_NATIVE_DEVICE_INIT *init,
+                                PUNICODE_STRING device_name,
+                                PUNICODE_STRING symbolic_link_name,
+                                ULONG slot_count);
+
+/* Select only the resident runtime dispatch paths owned by the native
+ * adapter.  DriverEntry/AddDevice/PnP ownership stays in the class owner. */
+NTSTATUS NxCdromInstallRuntimeDispatch(PDRIVER_OBJECT driver_object);
+
+#endif
diff --git a/tests/host/nxstorage-optical/check.py b/tests/host/nxstorage-optical/check.py
new file mode 100644
index 0000000000000000000000000000000000000000..59924b2fdf9968d0703ebdca47b108ee47355b92
--- /dev/null
+++ b/tests/host/nxstorage-optical/check.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Compile the actual optical profile for host and i386 freestanding use."""
+
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+
+root = Path(__file__).resolve().parents[3]
+source = root / "drivers/storage/class/nxstorage"
+tests = Path(__file__).resolve().parent
+output = Path(sys.argv[1]).resolve()
+output.mkdir(parents=True, exist_ok=True)
+cc = os.environ.get("CC", "clang")
+common = [
+    cc, "-std=c11", "-O1", "-g", "-Wall", "-Wextra", "-Werror",
+    "-I" + str(tests), "-I" + str(source),
+    "-include", str(tests / "optical_host_platform.h"),
+    str(source / "nxcdrom_profile.c"), str(tests / "nxcdrom_profile_test.c"),
+]
+for name, flags in (
+    ("optical-profile-plain", []),
+    ("optical-profile-sanitized", [
+        "-fsanitize=address,undefined", "-fno-omit-frame-pointer",
+    ]),
+):
+    executable = output / name
+    subprocess.run(common + flags + ["-o", str(executable)], check=True)
+    result = subprocess.run(
+        [str(executable)], check=True, text=True, capture_output=True,
+        env=dict(os.environ, ASAN_OPTIONS="detect_leaks=1:halt_on_error=1",
+                 UBSAN_OPTIONS="halt_on_error=1"),
+    )
+    (output / (name + ".log")).write_text(result.stdout + result.stderr)
+    print(name + ": " + result.stdout.splitlines()[-1])
+
+target = ["-target", "i386-none-elf"] if Path(cc).name.startswith("clang") else ["-m32"]
+obj = output / "nxcdrom-profile.i386.o"
+subprocess.run([
+    cc, *target, "-std=c11", "-O2", "-ffreestanding", "-fno-pic", "-fno-pie",
+    "-fno-builtin", "-fno-stack-protector", "-Wall", "-Wextra", "-Werror",
+    "-I" + str(tests), "-I" + str(source),
+    "-include", str(tests / "optical_host_platform.h"),
+    "-c", str(source / "nxcdrom_profile.c"), "-o", str(obj),
+], check=True)
+undefined = {
+    line.split()[-1].lstrip("_")
+    for line in subprocess.check_output([shutil.which("nm") or "nm", "-u", str(obj)], text=True).splitlines()
+}
+expected = {
+    "NxNativeDispatchControl", "NxNativeDispatchFlush", "NxNativeDispatchReadWrite",
+}
+if undefined != expected:
+    raise SystemExit(f"unexpected i386 dependency closure: {sorted(undefined)}")
+print("optical-profile-i386: clean")
