--- /dev/null
+++ b/drivers/storage/class/nxstorage/nxcdrom_profile.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "nxcdrom_profile.h"
+
+NTSTATUS
+NxCdromBuildDeviceInit(NX_NATIVE_DEVICE_INIT *init,
+                       PUNICODE_STRING device_name,
+                       PUNICODE_STRING symbolic_link_name,
+                       ULONG slot_count)
+{
+    NX_NATIVE_DEVICE_INIT clean = {0};
+
+    if (init == 0 || device_name == 0 || symbolic_link_name == 0 ||
+        device_name->Buffer == 0 || symbolic_link_name->Buffer == 0 ||
+        slot_count == 0)
+        return STATUS_INVALID_PARAMETER;
+
+    clean.DeviceName = device_name;
+    clean.SymbolicLinkName = symbolic_link_name;
+    clean.DeviceType = FILE_DEVICE_CD_ROM;
+    clean.DeviceCharacteristics = FILE_READ_ONLY_DEVICE | FILE_REMOVABLE_MEDIA;
+    clean.Config.sector_bytes = 2048;
+    clean.Config.page_bytes = 4096;
+    clean.Config.max_bytes = 0x20000;
+    clean.Config.max_pages = 33;
+    clean.Config.alignment_mask = 0;
+    clean.Config.ata_max_blocks = 0xffff;
+    clean.Config.capacity_bytes = 0;
+    clean.Config.optical = 1;
+    clean.Config.cache = NX_CACHE_DISABLED;
+    clean.SlotCount = slot_count;
+    *init = clean;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS
+NxCdromInstallRuntimeDispatch(PDRIVER_OBJECT driver_object)
+{
+    if (driver_object == 0)
+        return STATUS_INVALID_PARAMETER;
+
+    driver_object->MajorFunction[IRP_MJ_READ] = NxNativeDispatchReadWrite;
+    driver_object->MajorFunction[IRP_MJ_WRITE] = NxNativeDispatchReadWrite;
+    driver_object->MajorFunction[IRP_MJ_DEVICE_CONTROL] = NxNativeDispatchControl;
+    driver_object->MajorFunction[IRP_MJ_FLUSH_BUFFERS] = NxNativeDispatchFlush;
+    driver_object->MajorFunction[IRP_MJ_SHUTDOWN] = NxNativeDispatchFlush;
+    return STATUS_SUCCESS;
+}
