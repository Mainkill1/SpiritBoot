diff --git a/tests/host/nxstorage-optical/nxcdrom_profile_test.c b/tests/host/nxstorage-optical/nxcdrom_profile_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..a1ee02b7761994c06a6e20d7e08eba33466e399a
--- /dev/null
+++ b/tests/host/nxstorage-optical/nxcdrom_profile_test.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "nxcdrom_profile.h"
+#include <stdio.h>
+#include <string.h>
+
+#define CHECK(x) do { if (!(x)) { \
+    fprintf(stderr, "%s:%d: %s\n", __func__, __LINE__, #x); return 0; \
+} } while (0)
+
+static unsigned reads, controls, flushes;
+static NTSTATUS NTAPI sentinel(PDEVICE_OBJECT device, PIRP request)
+{ (void)device; (void)request; return 41; }
+NTSTATUS NTAPI NxNativeDispatchReadWrite(PDEVICE_OBJECT device, PIRP request)
+{ (void)device; (void)request; ++reads; return 42; }
+NTSTATUS NTAPI NxNativeDispatchControl(PDEVICE_OBJECT device, PIRP request)
+{ (void)device; (void)request; ++controls; return 43; }
+NTSTATUS NTAPI NxNativeDispatchFlush(PDEVICE_OBJECT device, PIRP request)
+{ (void)device; (void)request; ++flushes; return 44; }
+
+static void names(UNICODE_STRING *device, UNICODE_STRING *link,
+                  WCHAR *device_buffer, WCHAR *link_buffer)
+{
+    *device = (UNICODE_STRING){28, 30, device_buffer};
+    *link = (UNICODE_STRING){38, 40, link_buffer};
+}
+
+static int builds_exact_unknown_media_profile(void)
+{
+    WCHAR db[15] = {0}, lb[20] = {0};
+    UNICODE_STRING device, link;
+    NX_NATIVE_DEVICE_INIT init;
+    names(&device, &link, db, lb);
+    memset(&init, 0xa5, sizeof(init));
+    CHECK(NxCdromBuildDeviceInit(&init, &device, &link, 5) == STATUS_SUCCESS);
+    CHECK(init.DeviceName == &device && init.SymbolicLinkName == &link);
+    CHECK(init.DeviceType == FILE_DEVICE_CD_ROM);
+    CHECK(init.DeviceCharacteristics ==
+          (FILE_READ_ONLY_DEVICE | FILE_REMOVABLE_MEDIA));
+    CHECK(init.Config.sector_bytes == 2048);
+    CHECK(init.Config.page_bytes == 4096);
+    CHECK(init.Config.max_bytes == 0x20000);
+    CHECK(init.Config.max_pages == 33);
+    CHECK(init.Config.alignment_mask == 0);
+    CHECK(init.Config.ata_max_blocks == 0xffff);
+    CHECK(init.Config.capacity_bytes == 0);
+    CHECK(init.Config.optical == 1);
+    CHECK(init.Config.cache == NX_CACHE_DISABLED);
+    CHECK(init.SlotCount == 5);
+    return 1;
+}
+
+static int rejects_invalid_profile_without_mutation(void)
+{
+    WCHAR db[15] = {0}, lb[20] = {0};
+    UNICODE_STRING device, link;
+    names(&device, &link, db, lb);
+    for (unsigned test = 0; test < 6; ++test) {
+        NX_NATIVE_DEVICE_INIT init, before;
+        UNICODE_STRING d = device, l = link;
+        NX_NATIVE_DEVICE_INIT *out = &init;
+        PUNICODE_STRING dp = &d, lp = &l;
+        ULONG slots = 1;
+        memset(&init, 0xa5, sizeof(init));
+        before = init;
+        if (test == 0) out = NULL;
+        if (test == 1) dp = NULL;
+        if (test == 2) lp = NULL;
+        if (test == 3) d.Buffer = NULL;
+        if (test == 4) l.Buffer = NULL;
+        if (test == 5) slots = 0;
+        CHECK(NxCdromBuildDeviceInit(out, dp, lp, slots) ==
+              STATUS_INVALID_PARAMETER);
+        CHECK(memcmp(&init, &before, sizeof(init)) == 0);
+    }
+    return 1;
+}
+
+static int installs_only_adapter_runtime_routes(void)
+{
+    DRIVER_OBJECT driver;
+    for (unsigned i = 0; i < 28; ++i)
+        driver.MajorFunction[i] = sentinel;
+    CHECK(NxCdromInstallRuntimeDispatch(&driver) == STATUS_SUCCESS);
+    CHECK(driver.MajorFunction[IRP_MJ_READ] == NxNativeDispatchReadWrite);
+    CHECK(driver.MajorFunction[IRP_MJ_WRITE] == NxNativeDispatchReadWrite);
+    CHECK(driver.MajorFunction[IRP_MJ_DEVICE_CONTROL] == NxNativeDispatchControl);
+    CHECK(driver.MajorFunction[IRP_MJ_FLUSH_BUFFERS] == NxNativeDispatchFlush);
+    CHECK(driver.MajorFunction[IRP_MJ_SHUTDOWN] == NxNativeDispatchFlush);
+    CHECK(driver.MajorFunction[0] == sentinel);
+    CHECK(driver.MajorFunction[27] == sentinel);
+    CHECK(NxCdromInstallRuntimeDispatch(NULL) == STATUS_INVALID_PARAMETER);
+    return 1;
+}
+
+static int routes_without_child_ownership(void)
+{
+    DRIVER_OBJECT driver;
+    PDEVICE_OBJECT device = (PDEVICE_OBJECT)(uintptr_t)1;
+    PIRP request = (PIRP)(uintptr_t)2;
+    reads = controls = flushes = 0;
+    memset(&driver, 0, sizeof(driver));
+    CHECK(NxCdromInstallRuntimeDispatch(&driver) == STATUS_SUCCESS);
+    CHECK(driver.MajorFunction[IRP_MJ_READ](device, request) == 42);
+    CHECK(driver.MajorFunction[IRP_MJ_WRITE](device, request) == 42);
+    CHECK(driver.MajorFunction[IRP_MJ_DEVICE_CONTROL](device, request) == 43);
+    CHECK(driver.MajorFunction[IRP_MJ_FLUSH_BUFFERS](device, request) == 44);
+    CHECK(driver.MajorFunction[IRP_MJ_SHUTDOWN](device, request) == 44);
+    CHECK(reads == 2 && controls == 1 && flushes == 2);
+    return 1;
+}
+
+int main(void)
+{
+    struct { const char *name; int (*run)(void); } groups[] = {
+        {"unknown_media_profile", builds_exact_unknown_media_profile},
+        {"invalid_profile", rejects_invalid_profile_without_mutation},
+        {"runtime_routes", installs_only_adapter_runtime_routes},
+        {"no_child_ownership", routes_without_child_ownership},
+    };
+    unsigned failures = 0;
+    for (unsigned i = 0; i < sizeof(groups) / sizeof(groups[0]); ++i) {
+        int passed = groups[i].run();
+        printf("%s %s\n", passed ? "PASS" : "FAIL", groups[i].name);
+        failures += !passed;
+    }
+    printf("4 groups, %u failures\n", failures);
+    return failures ? 1 : 0;
+}
