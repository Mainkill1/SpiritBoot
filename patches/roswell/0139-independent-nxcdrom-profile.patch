@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NX_OPTICAL_HOST_PLATFORM_H
+#define NX_OPTICAL_HOST_PLATFORM_H
+
+#include <stdint.h>
+
+#define NX_NATIVE_ADAPTER_H
+#define NTAPI
+typedef int32_t NTSTATUS;
+typedef uint32_t ULONG;
+typedef void VOID;
+typedef uint16_t WCHAR;
+typedef struct _UNICODE_STRING {
+    uint16_t Length, MaximumLength;
+    WCHAR *Buffer;
+} UNICODE_STRING, *PUNICODE_STRING;
+typedef void *PDEVICE_OBJECT;
+typedef void *PIRP;
+typedef NTSTATUS (NTAPI *PDRIVER_DISPATCH)(PDEVICE_OBJECT, PIRP);
+typedef struct _DRIVER_OBJECT {
+    PDRIVER_DISPATCH MajorFunction[28];
+} DRIVER_OBJECT, *PDRIVER_OBJECT;
+
+typedef enum nx_cache {
+    NX_CACHE_DISABLED,
+    NX_CACHE_ENABLED,
+    NX_CACHE_UNQUALIFIED
+} nx_cache;
+typedef struct nx_config {
+    uint32_t sector_bytes, page_bytes, max_bytes, max_pages, alignment_mask;
+    uint32_t ata_max_blocks;
+    uint64_t capacity_bytes;
+    int optical;
+    nx_cache cache;
+} nx_config;
+typedef struct NX_NATIVE_DEVICE_INIT {
+    PUNICODE_STRING DeviceName;
+    PUNICODE_STRING SymbolicLinkName;
+    ULONG DeviceType;
+    ULONG DeviceCharacteristics;
+    nx_config Config;
+    ULONG SlotCount;
+} NX_NATIVE_DEVICE_INIT;
+
+#define STATUS_SUCCESS ((NTSTATUS)0)
+#define STATUS_INVALID_PARAMETER ((NTSTATUS)(int32_t)0xc000000dU)
+#define FILE_DEVICE_CD_ROM 2U
+#define FILE_REMOVABLE_MEDIA 1U
+#define FILE_READ_ONLY_DEVICE 2U
+#define IRP_MJ_READ 2U
+#define IRP_MJ_WRITE 3U
+#define IRP_MJ_FLUSH_BUFFERS 6U
+#define IRP_MJ_DEVICE_CONTROL 14U
+#define IRP_MJ_SHUTDOWN 16U
+
+NTSTATUS NTAPI NxNativeDispatchControl(PDEVICE_OBJECT, PIRP);
+NTSTATUS NTAPI NxNativeDispatchReadWrite(PDEVICE_OBJECT, PIRP);
+NTSTATUS NTAPI NxNativeDispatchFlush(PDEVICE_OBJECT, PIRP);
+
+#endif
