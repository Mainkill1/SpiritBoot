+static KEVENT gate;
+static volatile LONG signal_count;
+
+static DWORD WINAPI signaler(void *argument)
+{
+    unsigned count = (unsigned)(uintptr_t)argument;
+    /* Main has higher priority: after releasing this gate it enters the
+     * object wait before this lower-priority signaler can run. */
+    KeWaitForSingleObject(&gate, Executive, KernelMode, FALSE, NULL);
+    InterlockedIncrement(&signal_count);
+    for (unsigned i = 0; i < count; ++i) NtSetEvent(handles[i], NULL);
+    return 0;
+}
+
+int main(void)
+{
+    const unsigned counts[] = {3, 4, 5, 64};
+    regression_begin();
+    for (unsigned c = 0; c < 4; ++c) {
+        unsigned n = counts[c];
+        for (unsigned i = 0; i < n; ++i)
+            regression_require(NT_SUCCESS(NtCreateEvent(&handles[i], NULL,
+                NotificationEvent, i == n - 1)), "create wait object");
+        LARGE_INTEGER zero = {.QuadPart = 0};
+        NTSTATUS status = NtWaitForMultipleObjectsEx(n, handles, WaitAny,
+                                                   KernelMode, FALSE, &zero);
+        regression_check(status == (NTSTATUS)(STATUS_WAIT_0 + n - 1),
+                         "signaled WaitAny returns final index");
+        for (unsigned i = 0; i < n; ++i) NtSetEvent(handles[i], NULL);
+        status = NtWaitForMultipleObjectsEx(n, handles, WaitAll, KernelMode,
+                                          FALSE, &zero);
+        regression_check(status == STATUS_SUCCESS, "signaled WaitAll");
+        for (unsigned kind = 0; kind < 2; ++kind) {
+            for (unsigned i = 0; i < n; ++i) NtClearEvent(handles[i]);
+            KeInitializeEvent(&gate, NotificationEvent, FALSE);
+            HANDLE thread = CreateThread(NULL, 0, signaler,
+                (void *)(uintptr_t)(kind ? n : 1), CREATE_SUSPENDED, NULL);
+            regression_require(thread != NULL, "create delayed signaler");
+            regression_require(SetThreadPriority(thread, THREAD_PRIORITY_LOWEST),
+                               "set delayed signaler below waiting thread");
+            ResumeThread(thread);
+            LONG before = signal_count;
+            KeSetEvent(&gate, 0, FALSE);
+            LARGE_INTEGER timeout = {.QuadPart = -20000000};
+            status = NtWaitForMultipleObjectsEx(n, handles, kind ? WaitAll : WaitAny,
+                                               KernelMode, FALSE, &timeout);
+            regression_check(status == STATUS_SUCCESS && signal_count == before + 1,
+                             kind ? "blocking WaitAll completes" :
+                                    "blocking WaitAny completes");
+            regression_require(WaitForSingleObject(thread, 2000) == WAIT_OBJECT_0,
+                               "join delayed signaler");
+            CloseHandle(thread);
+        }
+        for (unsigned i = 0; i < n; ++i) NtClearEvent(handles[i]);
+        LARGE_INTEGER timeout = {.QuadPart = -100000};
+        status = NtWaitForMultipleObjectsEx(n, handles, WaitAny, KernelMode,
+                                          FALSE, &timeout);
+        regression_check(status == STATUS_TIMEOUT, "nonzero unsignaled timeout");
+        for (unsigned i = 0; i < n; ++i) NtClose(handles[i]);
+    }
+    regression_finish();
 }
