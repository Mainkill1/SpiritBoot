diff --git a/tests/xbe/thread-stack/main.c b/tests/xbe/thread-stack/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..4eb6eea529ae9b90626954ef210d6ecac56e000e
--- /dev/null
+++ b/tests/xbe/thread-stack/main.c
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <stdint.h>
+#include "../regression.h"
+
+static volatile uint32_t checksum, scratch_physical;
+
+static void NTAPI worker(PVOID argument)
+{
+    volatile unsigned char scratch[6144];
+    (void)argument;
+    scratch_physical = MmGetPhysicalAddress((PVOID)scratch);
+    for (unsigned i = 0; i < sizeof(scratch); ++i) scratch[i] = (unsigned char)i;
+    LARGE_INTEGER delay = {.QuadPart = -100000};
+    KeDelayExecutionThread(KernelMode, FALSE, &delay);
+    uint32_t sum = 0;
+    for (unsigned i = 0; i < sizeof(scratch); ++i) sum += scratch[i];
+    checksum = sum;
+}
+
+static void NTAPI system_routine(PKSTART_ROUTINE start, PVOID context)
+{
+    start(context);
+    PsTerminateSystemThread(STATUS_SUCCESS);
+}
+
+int main(void)
+{
+    const unsigned sizes[] = {0, 65536, 1, 4095, 4096, 4097, 49153};
+    regression_begin();
+    for (unsigned round = 0; round < 4; ++round) {
+        for (unsigned i = 0; i < sizeof(sizes) / sizeof(sizes[0]); ++i) {
+            HANDLE thread = NULL;
+            checksum = scratch_physical = 0;
+            tap_comment("round=%u requested=%u", round, sizes[i]);
+            regression_require(NT_SUCCESS(PsCreateSystemThreadEx(&thread, 0,
+                sizes[i], 0, NULL, worker, NULL, FALSE, FALSE, system_routine)),
+                "create thread with explicit stack request");
+            LARGE_INTEGER timeout = {.QuadPart = -20000000};
+            regression_require(NtWaitForSingleObject(thread, FALSE, &timeout) ==
+                               STATUS_SUCCESS, "thread completes");
+            regression_check(checksum == 783360, "six KiB scratch survives scheduling");
+            regression_check(scratch_physical != 0, "scratch has physical backing");
+            NtClose(thread);
+        }
+    }
+    /* Actual allocated extent/guard-page teardown are not asserted here.
+     * Size normalization is covered by the production allocator fixture. */
+    regression_finish();
+}
