+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "native_packet.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"%s:%d %s\n",__func__,__LINE__,#x); return 0; } } while(0)
+#define MUST(x) do { if (!(x)) abort(); } while(0)
+typedef struct fixture {
+    IRP child; IO_STACK_LOCATION stack[3]; SCSI_REQUEST_BLOCK srb;
+    MDL mdl; uint32_t pfns[3]; uint8_t physical[3][4096], sense[96];
+    nx_packet_resources resources; nx_packet_command command; nx_packet_ticket ticket;
+} fixture;
+static fixture *active;
+static unsigned reuse_calls;
+static void cancel_marker(void *d, PIRP i) { (void)d; (void)i; }
+static NTSTATUS completion(void *d, PIRP i, void *c) { (void)d;(void)i;(void)c;return 0; }
+VOID IoReuseIrp(PIRP i, NTSTATUS status)
+{
+    MUST(active && i==&active->child && !i->CancelRoutine);
+    int8_t count=i->StackCount; ++reuse_calls;
+    memset(i,0,sizeof(*i)); i->StackCount=count; i->CurrentLocation=count+1;
+    i->Tail.Overlay.CurrentStackLocation=active->stack+count; i->IoStatus.Status=status;
+}
+static void init(fixture *f)
+{
+    memset(f,0,sizeof(*f)); active=f; reuse_calls=0;
+    f->child.StackCount=3; f->child.IoStatus.Status=-9;
+    f->mdl.StartVa=(void *)(uintptr_t)0; f->mdl.ByteCount=8192;
+    f->mdl.MappedSystemVa=f->physical; /* Deliberately distinct CPU alias. */
+    f->pfns[0]=2; f->pfns[1]=2; f->pfns[2]=0;
+    f->resources=(nx_packet_resources){&f->child,&f->srb,&f->mdl,f->sense,96,2,1,1};
+    f->command=(nx_packet_command){.token={1,2,3},.mdl_virtual=0,.data_virtual=0,
+        .bytes=4096,.direction=0x80,.function=0,.cdb_length=10,.cdb={0x2a},
+        .timeout_seconds=30,.timeout_limit_seconds=120,.max_bytes=8192,.max_pages=2,
+        .alignment_mask=0,.lower_stack_count=2,.completion=completion,.completion_context=f};
+    memset(&f->srb,0xa5,sizeof(f->srb)); memset(f->sense,0xa5,sizeof(f->sense));
+    memset(&f->ticket,0xa5,sizeof(f->ticket));
+}
+/* Consume the packet's original-domain address via independently owned PFNs.
+ * Never treat that numeric address as a dereferenceable host pointer. */
+static uint8_t physical_byte(fixture *f, unsigned offset)
+{
+    MUST(f->srb.OriginalRequest==&f->child && f->child.MdlAddress==&f->mdl);
+    uintptr_t domain=(uintptr_t)f->mdl.StartVa+f->mdl.ByteOffset;
+    uintptr_t at=(uintptr_t)f->srb.DataBuffer-domain+f->mdl.ByteOffset+offset;
+    MUST(at<f->mdl.ByteCount+f->mdl.ByteOffset);
+    return f->physical[f->pfns[at/4096]][at%4096];
+}
+static int prepares_zero_domain_and_fragmented_subranges(void)
+{
+    fixture f; init(&f); memset(f.physical[2],0x62,4096);
+    MDL saved=f.mdl;
+    CHECK(nx_packet_prepare(&f.resources,&f.command,&f.ticket)==NX_PACKET_OK);
+    CHECK(reuse_calls==1 && !memcmp(&saved,&f.mdl,sizeof(saved)));
+    CHECK(f.child.MdlAddress==&f.mdl && f.srb.OriginalRequest==&f.child);
+    CHECK(f.stack[2].MajorFunction==0x0b && f.stack[2].Parameters.Scsi.Srb==&f.srb);
+    CHECK(f.stack[2].CompletionRoutine==completion && f.stack[2].Context==&f);
+    CHECK(f.stack[2].Control==0xe0 && f.srb.Length==sizeof(f.srb));
+    CHECK(f.srb.CdbLength==10 && f.srb.Cdb[0]==0x2a && f.srb.Cdb[15]==0);
+    CHECK(f.srb.DataBuffer==NULL && f.srb.DataTransferLength==4096 && f.srb.SrbFlags==0x80);
+    CHECK(f.srb.TimeOutValue==30 && f.srb.SenseInfoBuffer==f.sense && f.srb.SenseInfoBufferLength==96);
