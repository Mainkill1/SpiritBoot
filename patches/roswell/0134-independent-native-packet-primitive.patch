+    CHECK(!f.srb.PathId && !f.srb.TargetId && !f.srb.Lun);
+    CHECK(!f.sense[0] && !f.sense[95] && physical_byte(&f,0)==0x62);
+    f.command.data_virtual=4096;
+    CHECK(nx_packet_prepare(&f.resources,&f.command,&f.ticket)==NX_PACKET_OK);
+    CHECK((uintptr_t)f.srb.DataBuffer==4096 && physical_byte(&f,4095)==0x62);
+    /* A different PFN for the next subrange must remain a different page. */
+    f.pfns[1]=0; f.physical[0][0]=0x18; CHECK(physical_byte(&f,0)==0x18);
