+#!/usr/bin/env python3
+"""Run the actual unlinked owned packet functions and existing request core."""
+from pathlib import Path
+import os
+import subprocess
+import sys
+root=Path(__file__).resolve().parents[3]
+source=root/'drivers/storage/class/nxstorage'
+tests=Path(__file__).resolve().parent
+out=Path(sys.argv[1]).resolve()
+out.mkdir(parents=True,exist_ok=True)
+cc=os.environ.get('CC','clang')
+base=[cc,'-std=c11','-O1','-g','-Wall','-Wextra','-Werror','-I'+str(source),
+      '-include',str(tests/'packet_host_platform.h')]
+inputs=[str(source/'native_packet.c'),str(source/'request.c'),str(tests/'native_packet_test.c')]
+for name,flags in [('packet-plain',[]),('packet-sanitized',['-fsanitize=address,undefined','-fno-omit-frame-pointer'])]:
+    exe=out/name
+    subprocess.run(base+flags+inputs+['-o',str(exe)],check=True)
+    result=subprocess.run([str(exe)],check=True,text=True,capture_output=True,
+        env=dict(os.environ,ASAN_OPTIONS='detect_leaks=1:halt_on_error=1:detect_stack_use_after_return=1',UBSAN_OPTIONS='halt_on_error=1'))
+    (out/(name+'.log')).write_text(result.stdout+result.stderr)
+    print(name+': '+result.stdout.splitlines()[-1])
