+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "native_packet.h"
+
+enum { EXECUTE=0, RELEASE_QUEUE=4, DATA_IN=0x40, DATA_OUT=0x80,
+       SCSI_MAJOR=0x0b, INVOKE_ALL=0xe0, SRB_FROZEN=0x40, SRB_SENSE=0x80 };
+
+static void clear_bytes(void *p, size_t n)
+{
+    uint8_t *b=p;
+    for (size_t i=0;i<n;++i) b[i]=0;
+}
+
+static int data_range(const nx_packet_resources *r, const nx_packet_command *c)
+{
+    PMDL mdl=r->mdl;
+    if (!c->bytes) return c->direction==0 && c->data_virtual==0;
+    if (!mdl || mdl->Next || !mdl->ByteCount ||
+        (c->direction!=DATA_IN && c->direction!=DATA_OUT)) return 0;
+    uintptr_t start=(uintptr_t)mdl->StartVa;
+    if ((start & (NX_PACKET_PAGE_BYTES-1u)) || mdl->ByteOffset>=NX_PACKET_PAGE_BYTES ||
+        mdl->ByteOffset>UINTPTR_MAX-start) return 0;
+    uintptr_t base=start+mdl->ByteOffset;
+    if (mdl->ByteCount>UINTPTR_MAX-base || c->mdl_virtual!=base || c->data_virtual<base ||
+        c->data_virtual-base>mdl->ByteCount ||
+        c->bytes>mdl->ByteCount-(c->data_virtual-base) ||
+        c->bytes>UINTPTR_MAX-c->data_virtual ||
+        (c->data_virtual & c->alignment_mask)) return 0;
+    uint64_t pages=((uint64_t)mdl->ByteOffset+mdl->ByteCount+NX_PACKET_PAGE_BYTES-1u)/NX_PACKET_PAGE_BYTES;
+    uint64_t segment_pages=((c->data_virtual & (NX_PACKET_PAGE_BYTES-1u))+
+        (uint64_t)c->bytes+NX_PACKET_PAGE_BYTES-1u)/NX_PACKET_PAGE_BYTES;
+    return pages<=r->pfn_capacity && segment_pages<=c->max_pages;
+}
+
+nx_packet_status nx_packet_prepare(const nx_packet_resources *r,
+    const nx_packet_command *c, nx_packet_ticket *ticket)
+{
+    if (!r || !c || !ticket || !r->child || !r->srb || !r->sense ||
+        !r->sense_capacity || r->sense_capacity>NX_PACKET_SENSE_MAX ||
+        r->driver_owned_idle!=1 || r->thread_unlinked!=1 || r->child->CancelRoutine ||
+        !c->completion || !c->lower_stack_count || r->child->StackCount<=0 ||
+        c->lower_stack_count>(unsigned)r->child->StackCount ||
+        !c->timeout_seconds || c->timeout_seconds>c->timeout_limit_seconds ||
+        !c->max_bytes || !c->max_pages || c->bytes>c->max_bytes ||
+        c->alignment_mask>=NX_PACKET_PAGE_BYTES ||
+        (c->alignment_mask & (c->alignment_mask+1u))) return NX_PACKET_INVALID;
+    if (c->function==EXECUTE) {
+        if (c->cdb_length!=6 && c->cdb_length!=10 && c->cdb_length!=12 && c->cdb_length!=16)
+            return NX_PACKET_INVALID;
+    } else if (c->function!=RELEASE_QUEUE || c->cdb_length || c->bytes || c->direction)
+        return NX_PACKET_INVALID;
+    if (!data_range(r,c)) return NX_PACKET_INVALID;
+
+    /* Ownership/thread association are caller preconditions, not inferred from
+     * numeric addresses. Reuse resets packet state but frees no MDL or sense. */
+    IoReuseIrp(r->child,(NTSTATUS)0x103);
+    clear_bytes(r->srb,sizeof(*r->srb));
+    clear_bytes(r->sense,r->sense_capacity);
+    r->child->MdlAddress=c->bytes ? r->mdl:NULL;
+    PIO_STACK_LOCATION next=r->child->Tail.Overlay.CurrentStackLocation-1;
+    clear_bytes(next,sizeof(*next));
+    next->MajorFunction=SCSI_MAJOR;
+    next->Parameters.Scsi.Srb=r->srb;
+    next->CompletionRoutine=c->completion;
+    next->Context=c->completion_context;
+    next->Control=INVOKE_ALL;
+    r->srb->Length=(USHORT)sizeof(*r->srb);
+    r->srb->Function=c->function;
+    r->srb->CdbLength=c->cdb_length;
+    r->srb->SenseInfoBufferLength=(UCHAR)r->sense_capacity;
+    r->srb->SrbFlags=c->direction;
+    r->srb->DataTransferLength=c->bytes;
+    r->srb->TimeOutValue=c->timeout_seconds;
+    r->srb->DataBuffer=c->bytes ? (void *)c->data_virtual:NULL;
+    r->srb->SenseInfoBuffer=r->sense;
+    r->srb->OriginalRequest=r->child;
+    for (unsigned i=0;i<c->cdb_length;++i) r->srb->Cdb[i]=c->cdb[i];
+    *ticket=(nx_packet_ticket){r->child,r->srb,r->sense,c->token,c->bytes,r->sense_capacity};
+    return NX_PACKET_OK;
+}
+
+nx_packet_status nx_packet_capture(const nx_packet_ticket *t, nx_packet_result *out)
+{
+    if (!t || !out || !t->child || !t->srb || !t->sense ||
+        !t->supplied_sense || t->supplied_sense>NX_PACKET_SENSE_MAX) return NX_PACKET_INVALID;
+    nx_packet_result result;
+    clear_bytes(&result,sizeof(result));
+    result.token=t->token;
+    result.status=(uint32_t)t->child->IoStatus.Status;
+    result.reported_bytes=t->child->IoStatus.Information;
+    result.srb_status=t->srb->SrbStatus;
+    result.srb_base=result.srb_status & ~(SRB_FROZEN|SRB_SENSE);
+    result.scsi_status=t->srb->ScsiStatus;
+    result.queue_frozen=(result.srb_status & SRB_FROZEN)!=0;
+    result.autosense_valid=(result.srb_status & SRB_SENSE)!=0;
+    nx_packet_status status=NX_PACKET_OK;
+    if (result.status==0x103u || result.reported_bytes>t->submitted_bytes ||
+        ((result.status & 0x80000000u)==0 && result.srb_base==0)) status=NX_PACKET_PROTOCOL;
+    if (result.autosense_valid) {
+        unsigned count=t->srb->SenseInfoBufferLength;
+        if (t->srb->SenseInfoBuffer!=t->sense || count>t->supplied_sense)
+            status=NX_PACKET_PROTOCOL;
+        else {
+            result.sense_bytes=count;
+            for (unsigned i=0;i<count;++i) result.sense[i]=t->sense[i];
+        }
+    }
+    *out=result;
+    return status;
+}
