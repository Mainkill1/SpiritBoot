+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NX_NATIVE_PACKET_H
+#define NX_NATIVE_PACKET_H
+#include <stddef.h>
+#include <stdint.h>
+#include "request.h"
+/* Admitted IRP/MDL/SRB/platform declarations must precede this header. */
+enum { NX_PACKET_SENSE_MAX=96, NX_PACKET_PAGE_BYTES=4096 };
+typedef enum nx_packet_status { NX_PACKET_OK, NX_PACKET_INVALID, NX_PACKET_PROTOCOL } nx_packet_status;
+typedef struct nx_packet_resources {
+    PIRP child;
+    PSCSI_REQUEST_BLOCK srb;
+    PMDL mdl;
+    uint8_t *sense;
+    uint32_t sense_capacity;
+    /* Trusted platform evidence: valid, resident single descriptor and actual
+     * PFN-vector capacity. This module neither walks nor invents PFNs. */
+    uint32_t pfn_capacity;
+    unsigned driver_owned_idle, thread_unlinked;
+} nx_packet_resources;
+typedef struct nx_packet_command {
+    nx_token token;
+    uintptr_t mdl_virtual, data_virtual;
+    uint32_t bytes, direction;
+    uint8_t function, cdb_length, cdb[16];
+    uint32_t timeout_seconds, timeout_limit_seconds;
+    uint32_t max_bytes, max_pages, alignment_mask;
+    uint8_t lower_stack_count;
+    PIO_COMPLETION_ROUTINE completion;
+    void *completion_context;
+} nx_packet_command;
+/* Immutable per-submission copy, held by the future owner through capture.
+ * Contains native pointers only as source locators, never a rundown guarantee. */
+typedef struct nx_packet_ticket {
+    PIRP child;
+    PSCSI_REQUEST_BLOCK srb;
+    uint8_t *sense;
+    nx_token token;
+    uint32_t submitted_bytes, supplied_sense;
+} nx_packet_ticket;
+typedef struct nx_packet_result {
+    nx_token token;
+    uint32_t status;
+    uint64_t reported_bytes;
+    uint8_t srb_status, srb_base, scsi_status, queue_frozen, autosense_valid;
+    uint32_t sense_bytes;
+    uint8_t sense[NX_PACKET_SENSE_MAX];
+} nx_packet_result;
+/* Caller owns nonoverlapping writable resources, live borrowed MDL/pages and
+ * idle driver-allocated child. No concurrent mutation, installed cancel routine
+ * or thread association. Reuse is not retirement and is not made safe here.
+ * Invalid preparation changes neither resources nor ticket. No submission,
+ * allocation, mapping, cancellation, parent completion or resource release.
+ * Target is the already selected retained ATAPI PDO: that lower fills
+ * PathId/TargetId/Lun and clears SrbExtension for its own transport scratch.
+ * This is not a generic miniport-facing builder or caller-owned scratch API. */
+nx_packet_status nx_packet_prepare(const nx_packet_resources *, const nx_packet_command *, nx_packet_ticket *);
+/* Caller establishes terminal ownership and source residency. Copy before any
+ * recycle. A protocol result retains raw status/count, but authorizes no bytes
+ * or completion. Result has no pointers into native packet/sense storage. */
+nx_packet_status nx_packet_capture(const nx_packet_ticket *, nx_packet_result *);
+#endif
