+static int copies_terminal_before_reuse(void)
+{
+    fixture f;init(&f);CHECK(nx_packet_prepare(&f.resources,&f.command,&f.ticket)==NX_PACKET_OK);
+    f.child.IoStatus.Status=(int32_t)0x80000005u;f.child.IoStatus.Information=12;
+    f.srb.SrbStatus=0xd2;f.srb.ScsiStatus=2;f.srb.SenseInfoBufferLength=3;
+    f.sense[0]=0x70;f.sense[1]=0x12;f.sense[2]=0x34;
+    nx_packet_result r;
+    CHECK(nx_packet_capture(&f.ticket,&r)==NX_PACKET_OK);
+    CHECK(r.status==0x80000005u && r.reported_bytes==12 && r.srb_status==0xd2);
+    CHECK(r.srb_base==0x12 && r.queue_frozen && r.autosense_valid && r.scsi_status==2);
+    CHECK(r.sense_bytes==3 && r.sense[0]==0x70 && r.sense[2]==0x34 && r.sense[3]==0);
+    memset(&f.child,0xa5,sizeof(f.child));memset(&f.srb,0xa5,sizeof(f.srb));memset(f.sense,0xa5,sizeof(f.sense));
+    CHECK(r.token.slot==1 && r.token.generation==2 && r.token.command==3 && r.sense[2]==0x34);
+    return 1;
+}
+static int bounded_terminal_failures(void)
+{
+    for (unsigned n=0;n<11;++n) {
+        fixture f;init(&f);CHECK(nx_packet_prepare(&f.resources,&f.command,&f.ticket)==NX_PACKET_OK);
+        f.child.IoStatus.Status=0;f.child.IoStatus.Information=4096;f.srb.SrbStatus=1;
+        switch(n) {
+            case 0:f.child.IoStatus.Information=4097;break;
+            case 1:f.child.IoStatus.Status=0x103;break;
+            case 2:f.srb.SrbStatus=0;break;
+            case 3:f.srb.SrbStatus=0x81;f.srb.SenseInfoBufferLength=97;break;
+            case 4:f.srb.SrbStatus=0x81;f.srb.SenseInfoBuffer=(void *)(uintptr_t)1;break;
+            case 5:f.child.IoStatus.Status=(int32_t)0xc00000b5u;f.child.IoStatus.Information=0;f.srb.SrbStatus=9;break;
+            case 6:f.child.IoStatus.Status=(int32_t)0xc000009au;f.child.IoStatus.Information=0;f.srb.SrbStatus=0x30;break;
+            case 7:f.child.IoStatus.Information=12;break;
+            case 8:f.child.IoStatus.Status=0x40000000;break;
+            case 9:f.child.IoStatus.Status=0x40000000;f.srb.SrbStatus=0;break;
+            case 10:f.child.IoStatus.Status=(int32_t)0xc000009au;f.child.IoStatus.Information=0;f.srb.SrbStatus=0;break;
+        }
+        nx_packet_result r;CHECK(nx_packet_capture(&f.ticket,&r)==((n<5 || n==9)?NX_PACKET_PROTOCOL:NX_PACKET_OK));
+        CHECK(r.reported_bytes==f.child.IoStatus.Information && r.status==(uint32_t)f.child.IoStatus.Status);
+        CHECK(r.sense_bytes==0 && r.sense[95]==0);
+        if(n==7) CHECK(r.reported_bytes==12 && f.srb.DataTransferLength==4096);
+    }
+    return 1;
+}
+static int sense_extent_and_cdb16(void)
+{
+    fixture f; init(&f); f.resources.sense_capacity=8; f.command.cdb_length=16;
+    for(unsigned i=0;i<16;++i) f.command.cdb[i]=(uint8_t)(0xa0+i);
+    CHECK(nx_packet_prepare(&f.resources,&f.command,&f.ticket)==NX_PACKET_OK);
+    CHECK(f.srb.Cdb[15]==0xaf && f.srb.SenseInfoBufferLength==8);
+    CHECK(!f.sense[7] && f.sense[8]==0xa5 && f.sense[95]==0xa5);
+    f.srb.SrbStatus=0x81;f.child.IoStatus.Status=0;f.child.IoStatus.Information=4096;
+    f.sense[7]=0x5c; nx_packet_result r;
+    CHECK(nx_packet_capture(&f.ticket,&r)==NX_PACKET_OK);
+    CHECK(r.sense_bytes==8 && r.sense[7]==0x5c && !r.sense[8]);
+    f.srb.SenseInfoBufferLength=9;
+    CHECK(nx_packet_capture(&f.ticket,&r)==NX_PACKET_PROTOCOL && !r.sense_bytes);
+    f.srb.SrbStatus=1; f.srb.SenseInfoBuffer=(void *)(uintptr_t)1;
+    CHECK(nx_packet_capture(&f.ticket,&r)==NX_PACKET_OK && !r.sense_bytes);
+    CHECK(nx_packet_prepare(NULL,&f.command,&f.ticket)==NX_PACKET_INVALID);
+    CHECK(nx_packet_capture(NULL,&r)==NX_PACKET_INVALID);
+    return 1;
+}
+/* Production packet/core interoperability, not a native lifecycle adapter. */
+typedef struct core_fixture {
+    fixture packet; nx_device device; nx_slot slot;
+    unsigned commands, retired, completed, pending, locked;
+    uintptr_t addresses[3]; uint8_t opcodes[3]; nx_status status; uint64_t bytes;
+} core_fixture;
+static void core_enter(void *v) { core_fixture *f=v;MUST(!f->locked);f->locked=1; }
+static void core_leave(void *v) { core_fixture *f=v;MUST(f->locked);f->locked=0; }
+static nx_status core_prepare(void *v,const nx_command *c)
+{
+    core_fixture *f=v; nx_packet_command p=f->packet.command;
+    p.token=c->token;p.mdl_virtual=c->mdl_virtual;p.data_virtual=c->data_virtual;
+    p.bytes=c->bytes;p.direction=c->direction;p.function=c->function;p.cdb_length=c->cdb_length;
+    memset(p.cdb,0,sizeof(p.cdb));memcpy(p.cdb,c->cdb,c->cdb_length);
+    return nx_packet_prepare(&f->packet.resources,&p,&f->packet.ticket)==NX_PACKET_OK ? NX_OK:NX_INVALID;
+}
+static int core_submit(void *v,const nx_command *c)
+{
+    core_fixture *f=v;MUST(f->commands<3 && !f->locked);
+    f->addresses[f->commands]=(uintptr_t)f->packet.srb.DataBuffer;
+    f->opcodes[f->commands++]=f->packet.srb.Cdb[0];
+    f->packet.child.IoStatus.Status=0;f->packet.child.IoStatus.Information=c->bytes;
+    f->packet.srb.SrbStatus=1;nx_packet_result r;
+    MUST(nx_packet_capture(&f->packet.ticket,&r)==NX_PACKET_OK);
+    nx_lower_done(&f->device,r.token,NX_OK,(uint32_t)r.reported_bytes,0);
+    return 0;
+}
+static void core_retire(void *v,const nx_command *c) { core_fixture *f=v;(void)c;++f->retired; }
+static void core_cancel(void *v,const nx_command *c) { (void)v;(void)c;abort(); }
+static void core_pending(void *v,void *p) { core_fixture *f=v;MUST(p==f);++f->pending; }
+static void core_complete(void *v,void *p,nx_status s,uint64_t n)
+{ core_fixture *f=v;MUST(p==f && !f->locked);++f->completed;f->status=s;f->bytes=n; }
+static int core_zero_domain_write_through(void)
+{
+    core_fixture f;memset(&f,0,sizeof(f));init(&f.packet);
+    nx_config cfg={512,4096,4096,1,0,256,65536,0,NX_CACHE_ENABLED};
+    nx_port port={&f,core_enter,core_leave,core_prepare,core_submit,core_retire,core_cancel,core_pending,core_complete};
+    CHECK(nx_device_init(&f.device,&cfg,&port,&f.slot,1,sizeof(f.slot))==NX_OK);
+    nx_request r={.parent=&f,.operation=NX_WRITE,.offset=0,.bytes=8192,
+        .mdl_virtual=0,.mdl_bytes=8192,.lease=&f,.flags=NX_WRITE_THROUGH,.mdl_present=1};
+    nx_handle h;CHECK(nx_start(&f.device,&r,&h)==NX_OK);
+    CHECK(f.completed==1 && f.status==NX_OK && f.bytes==8192 && !f.pending);
+    CHECK(f.commands==3 && f.retired==3 && f.addresses[0]==0 && f.addresses[1]==4096);
+    CHECK(f.opcodes[0]==0x2a && f.opcodes[1]==0x2a && f.opcodes[2]==0x35);
+    CHECK(f.packet.mdl.ByteCount==8192 && f.packet.mdl.MappedSystemVa==f.packet.physical);
+    return 1;
+}
+int main(void)
+{
+    struct {const char *name; int (*run)(void);} cases[]={
+        {"zero_domain_fragmented",prepares_zero_domain_and_fragmented_subranges},
+        {"reject_before_mutation",rejects_before_mutation},
+        {"odd_and_nodata",allows_odd_domain_and_nodata},
+        {"terminal_copy",copies_terminal_before_reuse},
+        {"bounded_terminal",bounded_terminal_failures},
+        {"core_zero_domain",core_zero_domain_write_through},
+        {"sense_extent_cdb16",sense_extent_and_cdb16}};
+    unsigned failed=0;
+    for(unsigned i=0;i<sizeof(cases)/sizeof(cases[0]);++i) {
+        int ok=cases[i].run();printf("%s %s\n",ok?"PASS":"FAIL",cases[i].name);failed+=!ok;
+    }
+    printf("7 groups, %u failures\n",failed);return failed?1:0;
+}
