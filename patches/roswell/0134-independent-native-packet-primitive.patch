+            case 18:f.command.completion=NULL;break;
+            case 19:f.command.alignment_mask=5;break;
+            case 20:f.child.CancelRoutine=cancel_marker;break;
+            case 21:f.child.StackCount=0;break;
+            case 22:f.command.lower_stack_count=0;break;
+            case 23:f.command.timeout_seconds=0;break;
+            case 24:f.command.max_pages=0;break;
+            case 25:f.resources.sense=NULL;break;
+            case 26:f.mdl.StartVa=(void *)(UINTPTR_MAX-4095);f.command.bytes=512;
