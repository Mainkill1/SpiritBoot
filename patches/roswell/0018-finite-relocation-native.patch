diff --git a/tests/xbe/relocation-alias/Makefile b/tests/xbe/relocation-alias/Makefile
index 514561df..c6fd742b 100644
--- a/tests/xbe/relocation-alias/Makefile
+++ b/tests/xbe/relocation-alias/Makefile
@@ -1,6 +1,6 @@
 XBE_TITLE = RELOCATION-ALIAS
 GEN_XISO = relocation.iso
-SRCS = $(CURDIR)/main.c
+SRCS = $(CURDIR)/main.c $(CURDIR)/../api-regression/tap.c
 NXDK_DIR ?= $(CURDIR)/../../../third_party/nxdk
 NXDK_CFLAGS += -O2 -Wall -Wextra -Werror
