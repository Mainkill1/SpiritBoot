diff --git a/boot/nxldr/early-warm.c b/boot/nxldr/early-warm.c
new file mode 100644
index 00000000..305bb0cf
--- /dev/null
+++ b/boot/nxldr/early-warm.c
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Runs entirely from ROM, before loader copy/BSS or page-table writes.
+ * The caller supplies the existing reserved PCR page as a bounded stack.
+ * No mutable globals, allocator, logger or RAM-resident library calls.
+ */
+#include "nxldr.h"
+#include "warm-handoff.h"
+extern const UCHAR KernelPayloadVa[];
+
+int NxPreserveWarmBoot(void)
+{
+    PM_HANDOFF *h = (PM_HANDOFF *)0xD000;
+    const NXKRNL_XZ_HEADER *payload = (const void *)KernelPayloadVa;
+    unsigned launch = *(const unsigned *)0xE000 == PM_LAUNCH_MAGIC ?
+        PmHash((const unsigned char *)0xE000, PM_LAUNCH_BYTES) : 0;
+    unsigned count, i;
+    if (h->Magic != PM_MAGIC || h->Version != PM_VERSION ||
+        h->BitmapBytes != PM_BYTES || h->ImageBase != NXBL_IMAGE_BASE ||
+        h->StageCount > PM_MAX_STAGES || h->LaunchHash != launch ||
+        h->Checksum != PmChecksum(h)) return 1;
+    if (h->StageCount || payload->Magic != NXKRNL_XZ_MAGIC ||
+        !NxWarmPlan(h->Pages, payload->DecompressedSize,
+                    h->Stages, PM_MAX_STAGES, &count)) return 0;
+    for (i = 0; i < count; ++i) {
+        volatile unsigned *to = (void *)((ULONG_PTR)h->Stages[i].Temporary << 12);
+        const volatile unsigned *from = (const void *)((ULONG_PTR)h->Stages[i].Original << 12);
+        unsigned word;
+        /* Volatile words prohibit lowering the loop to RAM memcpy. */
+        for (word = 0; word < 1024; ++word) to[word] = from[word];
+    }
+    h->StageCount = count;
+    h->Checksum = PmChecksum(h);
+    return 1;
+}
