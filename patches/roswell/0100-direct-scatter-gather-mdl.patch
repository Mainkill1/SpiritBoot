+    if (!Request->Length || !Request->Count) return NULL;
+    Mdl = IoAllocateMdl(Request->Pages[0].Buffer, Request->Length,
+                        FALSE, FALSE, NULL);
+    if (!Mdl) return NULL;
+
+    MdlPages = (Mdl->ByteOffset + Mdl->ByteCount + PAGE_SIZE - 1) >> PAGE_SHIFT;
+    RequiredSize = sizeof(*Mdl) + MdlPages * sizeof(PFN_NUMBER);
+    if (Mdl->StartVa != Request->Pages[0].Buffer || Mdl->ByteOffset != 0 ||
+        Mdl->ByteCount != Request->Length || MdlPages != Request->Count ||
+        (USHORT)Mdl->Size < RequiredSize ||
+        (Mdl->MdlFlags & MDL_MAPPED_TO_SYSTEM_VA)) {
+        IoFreeMdl(Mdl);
+        return NULL;
+    }
