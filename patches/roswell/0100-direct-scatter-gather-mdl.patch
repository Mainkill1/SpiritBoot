+    /* IoAllocateMdl can return a recycled lookaside entry.  Initialize the
+     * mapping fields for these pinned physical pages, while preserving its
+     * allocation flags and validated size/VA shape. */
+    Mdl->MappedSystemVa = NULL;
+    Mdl->Process = NULL;
+    Mdl->MdlFlags |= MDL_PAGES_LOCKED;
+    Pfns = MmGetMdlPfnArray(Mdl);
+    for (i = 0; i < Request->Count; ++i)
+        Pfns[i] = Request->Pages[i].Pfn;
+    return Mdl;
+#else
+    UNREFERENCED_PARAMETER(Request);
+    return NULL;
+#endif
+}
