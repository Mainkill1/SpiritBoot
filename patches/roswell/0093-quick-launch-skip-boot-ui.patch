--- /dev/null
+++ b/tests/host/quick-launch-ui/check.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Exercise the production quick-launch marker and audit the boot UI branch."""
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+def function(text: str, name: str) -> str:
+    match = re.search(r"\n" + re.escape(name) + r"\s*\([^;]*?\)\s*\n\{", text,
+                      re.S)
+    if match is None:
+        raise AssertionError(f"missing production function {name}")
+    start = text.index("{", match.start())
+    end = start + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+def block_after(text: str, marker: str) -> str:
+    start = text.index(marker)
+    start = text.index("{", start)
+    end = start + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+root = Path(sys.argv[1]).resolve()
+out = Path(sys.argv[2]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+xbe = (root / "ntoskrnl/xb/xbe.c").read_text()
+init = (root / "ntoskrnl/ex/init.c").read_text()
+
+query = function(xbe, "NxkQuickLaunchPending")
+source = out / "quick-launch-query.c"
+source.write_text(
+    """
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+typedef bool BOOLEAN;
+typedef void VOID;
+typedef uint32_t ULONG;
+typedef struct _XB_PERSIST_SLOT { ULONG Magic; ULONG Payload; } XB_PERSIST_SLOT;
+typedef XB_PERSIST_SLOT *PXB_PERSIST_SLOT;
+static XB_PERSIST_SLOT TestSlot;
+#define XB_PERSIST_MAGIC 0x6E78436CUL
+#define XB_PERSIST_VA ((uintptr_t)&TestSlot)
+static BOOLEAN NxkQuickLaunchPending(VOID)
+""" + query + """
+int main(void)
+{
+    TestSlot = (XB_PERSIST_SLOT){0};
+    assert(!NxkQuickLaunchPending());
+    assert(TestSlot.Magic == 0);
+    TestSlot.Magic = 0x12345678;
+    assert(!NxkQuickLaunchPending());
+    assert(TestSlot.Magic == 0x12345678);
+    TestSlot.Magic = XB_PERSIST_MAGIC;
+    assert(NxkQuickLaunchPending());
+    assert(TestSlot.Magic == XB_PERSIST_MAGIC);
+    return 0;
+}
+""")
+binary = out / "quick-launch-query"
+subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror",
+                str(source), "-o", str(binary)], check=True)
+subprocess.run([str(binary)], check=True)
+
+phase = function(init, "Phase1InitializationDiscard")
+peek = phase.index("QuickLaunch = NxkQuickLaunchPending()")
+video = phase.index("NxkInitializeVideo()")
+bootvid = phase.index("InbvDriverInitialize")
+assert peek < video < bootvid
+
+cold = block_after(phase, "if (!QuickLaunch)")
+assert "InbvDriverInitialize" in cold
+assert "NxkBootSetupRun" in cold
+assert "SB_WINDOW_MS" not in phase
+assert phase.count("InbvDriverInitialize") == 1
+assert "NxkBootSetupRun" not in phase.replace(cold, "")
+assert "if (!QuickLaunch && InbvBootDriverInstalled) FinalizeBootLogo();" in phase
+assert "if (!QuickLaunch)\n            InbvRetireBootDriver();" in phase
+assert "NxkMmReleaseBootFramebuffer();" in phase
+
+tail = phase[phase.index("else", phase.index("if (!QuickLaunch)")):]
+assert "InbvEnableBootDriver(FALSE);" not in tail
+assert "InbvEnableDisplayString(FALSE);" in tail
+print("PASS: quick-launch marker is read-only and boot UI is cold-boot only")
