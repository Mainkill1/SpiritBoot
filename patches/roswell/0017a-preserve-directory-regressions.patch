diff --git a/tests/xbe/xdvdfs-related-directory/main.c b/tests/xbe/xdvdfs-related-directory/main.c
new file mode 100644
index 00000000..62a3bbb4
--- /dev/null
+++ b/tests/xbe/xdvdfs-related-directory/main.c
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <string.h>
+#include "../regression.h"
+
+#ifndef STATUS_NOT_A_DIRECTORY
+#define STATUS_NOT_A_DIRECTORY ((NTSTATUS)0xc0000103)
+#endif
+
+static NTSTATUS open_path(HANDLE root, const char *path, ULONG options,
+                          HANDLE *handle)
+{
+    /* Deliberately not NUL terminated at Length: neither adapter nor driver
+     * may consume the unrelated suffix. */
+    char bounded[128];
+    size_t length = strlen(path);
+    memset(bounded, 'X', sizeof(bounded));
+    memcpy(bounded, path, length);
+    OBJECT_STRING name = {(USHORT)length, sizeof(bounded), bounded};
+    OBJECT_ATTRIBUTES oa = {root, &name, OBJ_CASE_INSENSITIVE};
+    IO_STATUS_BLOCK iosb = {0};
+    *handle = NULL;
+    NTSTATUS status = NtOpenFile(handle, GENERIC_READ | SYNCHRONIZE,
+        &oa, &iosb, FILE_SHARE_READ,
+        options | FILE_SYNCHRONOUS_IO_NONALERT);
+    tap_comment("path=%s status=%08lx", path, (unsigned long)status);
+    return status;
+}
+
+int main(void)
+{
+    const char *directories[] = {
+        "\\??\\D:\\", "\\??\\D:\\Cache", "\\??\\D:\\Cache\\",
+        "\\??\\D:\\Cache\\Resource", "\\??\\D:\\Cache\\Resource\\"
+    };
+    const char *children[] = {
+        "Cache\\Resource\\probe.bin", "Resource\\probe.bin",
+        "Resource\\probe.bin", "probe.bin", "probe.bin"
+    };
+    const struct {
+        const char *path;
+        ULONG options;
+        NTSTATUS expected;
+    } negatives[] = {
+        {"\\??\\D:\\Cache\\Missing\\", FILE_DIRECTORY_FILE,
+         STATUS_OBJECT_NAME_NOT_FOUND},
+        {"\\??\\D:\\Cache\\Resource\\probe.bin\\", FILE_DIRECTORY_FILE,
+         STATUS_NOT_A_DIRECTORY},
+        {"\\??\\D:\\Missing\\probe.bin", FILE_NON_DIRECTORY_FILE,
+         STATUS_OBJECT_PATH_NOT_FOUND},
+        {"\\??\\D:\\Cache\\Resource\\missing.bin", FILE_NON_DIRECTORY_FILE,
+         STATUS_OBJECT_NAME_NOT_FOUND},
+        {"\\??\\D:\\Cache\\Resource\\probe.bin", FILE_DIRECTORY_FILE,
+         STATUS_NOT_A_DIRECTORY},
+        {"\\??\\D:\\Cache\\Resource", FILE_NON_DIRECTORY_FILE,
+         STATUS_FILE_IS_A_DIRECTORY}
+    };
+    regression_begin();
+    for (unsigned i = 0; i < sizeof(directories) / sizeof(directories[0]); ++i) {
+        HANDLE parent = NULL, child = NULL;
+        NTSTATUS status = open_path(NULL, directories[i], FILE_DIRECTORY_FILE,
+                                    &parent);
+        int parent_open = status == STATUS_SUCCESS;
+        regression_check(parent_open, "length-bounded directory opens");
+        FILE_BASIC_INFORMATION info = {0};
+        IO_STATUS_BLOCK iosb = {0};
+        status = parent_open ? NtQueryInformationFile(parent, &iosb, &info,
+            sizeof(info), FileBasicInformation) : STATUS_UNSUCCESSFUL;
+        regression_check(status == STATUS_SUCCESS &&
+                         (info.FileAttributes & FILE_ATTRIBUTE_DIRECTORY),
+                         "opened object has directory attributes");
+        status = parent_open ? open_path(parent, children[i],
+            FILE_NON_DIRECTORY_FILE, &child) : STATUS_UNSUCCESSFUL;
+        int child_open = status == STATUS_SUCCESS;
+        regression_check(child_open, "relative child uses exact directory");
+        status = parent_open ? NtClose(parent) : STATUS_UNSUCCESSFUL;
+        regression_check(status == STATUS_SUCCESS,
+                         "parent closes before child read");
+        char data[18] = {0};
+        LARGE_INTEGER offset = {.QuadPart = 0};
+        status = child_open ? NtReadFile(child, NULL, NULL, NULL, &iosb, data,
+            sizeof(data), &offset) : STATUS_UNSUCCESSFUL;
+        regression_check(status == STATUS_SUCCESS &&
+            iosb.Information == sizeof(data) &&
+            memcmp(data, "directory-fixture\n", sizeof(data)) == 0,
+            "child retains exact bytes after parent closes");
+        if (child_open) NtClose(child);
+    }
+    for (unsigned i = 0; i < sizeof(negatives) / sizeof(negatives[0]); ++i) {
+        HANDLE handle;
+        NTSTATUS status = open_path(NULL, negatives[i].path,
+                                    negatives[i].options, &handle);
+        regression_check(status == negatives[i].expected,
+                         "exact missing and file/directory rejection status");
+        if (NT_SUCCESS(status)) NtClose(handle);
+    }
+    regression_finish();
+}
