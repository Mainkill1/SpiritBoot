diff --git a/ntoskrnl/CMakeLists.txt b/ntoskrnl/CMakeLists.txt
index 0cb67bdf..ba127b79 100644
--- a/ntoskrnl/CMakeLists.txt
+++ b/ntoskrnl/CMakeLists.txt
@@ -176,6 +176,17 @@ if(NXK_MM_POOL)
     add_definitions(-DNXK_MM_POOL)
 endif()
 
+# Diagnostic-only request/tag/lifetime census for evidence-based pool-class
+# selection.  This adds fixed BSS storage and counters to opt-in builds only.
+option(NXK_POOL_CENSUS "Enable diagnostic pool allocation census" OFF)
+if(NXK_POOL_CENSUS)
+    if(NOT NXK_MM_POOL)
+        message(FATAL_ERROR "NXK_POOL_CENSUS requires NXK_MM_POOL")
+    endif()
+    list(APPEND NTOSKRNL_SOURCE xb/mm/poolcensus.c)
+    list(APPEND PCH_SKIP_SOURCE xb/mm/poolcensus.c)
+endif()
+
 # nxpoolpages: whole pages for nxpool come from a PTE-mapped VA window
 # backed by the nxmm supply (xb/mm/poolpages.c) instead of the
 # ARM3 pool page layer.  Revert = -DNXK_MM_POOLPAGES=OFF.
@@ -270,6 +281,9 @@ add_executable(ntoskrnl
     ${PCH_SKIP_SOURCE}
     ntoskrnl.rc
     ${NXK_EXPORT_ROOTS_SOURCE})
+if(NXK_POOL_CENSUS)
+    target_compile_definitions(ntoskrnl PRIVATE NXK_POOL_CENSUS=1)
+endif()
 target_link_options(ntoskrnl PRIVATE
     -Wl,-u,_NxkExportRoots -Wl,-u,_NxkExportDirectory)
 
diff --git a/ntoskrnl/xb/mm/pool-census.h b/ntoskrnl/xb/mm/pool-census.h
new file mode 100644
index 00000000..0cdaca81
--- /dev/null
+++ b/ntoskrnl/xb/mm/pool-census.h
@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#define NXP_POOL_CENSUS_MAGIC 0x4E435031UL /* NCP1 */
+#define NXP_POOL_CENSUS_SCHEMA 1UL
+#define NXP_POOL_CENSUS_BIN_OVERFLOW 4097U
+#define NXP_POOL_CENSUS_BIN_SLOTS (NXP_POOL_CENSUS_BIN_OVERFLOW + 1U)
+#define NXP_POOL_CENSUS_KEY_SLOTS 1024U
+#define NXP_POOL_CENSUS_LARGE_SLOTS 1024U
+#define NXP_POOL_CENSUS_SAMPLE_SLOTS 256U
+#define NXP_POOL_CENSUS_SAMPLE_BUCKETS 256U
+#define NXP_POOL_CENSUS_NO_SLOT 0xFFFFU
+#define NXP_POOL_CENSUS_DOMAIN_KERNEL 0U
+#define NXP_POOL_CENSUS_DOMAIN_TITLE 1U
+#define NXP_POOL_CENSUS_DOMAIN_SHARED 2U
+#define NXP_POOL_CENSUS_DOMAIN_COUNT 3U
+#define NXP_POOL_CENSUS_CLASS_COUNT 7U
+
+#define NXP_POOL_CENSUS_CLASS_MASK 0x000FU
+#define NXP_POOL_CENSUS_BIN_SHIFT 4U
+#define NXP_POOL_CENSUS_BIN_MASK 0x0FF0U
+#define NXP_POOL_CENSUS_DOMAIN_MASK 0x1000U
+#define NXP_POOL_CENSUS_SAMPLED_MASK 0x2000U
+
+#ifdef NXK_POOL_CENSUS
+typedef struct _NXP_POOL_CENSUS_ENTRY
+{
+    ULONG Tag;
+    USHORT Bin;
+    UCHAR Domain;
+    UCHAR Used;
+    ULONG Allocations;
+    ULONG Frees;
+    ULONG Live;
+    ULONG Peak;
+    ULONG LifeShort;
+    ULONG LifeMedium;
+    ULONG LifeRetained;
+} NXP_POOL_CENSUS_ENTRY;
+
+typedef struct _NXP_POOL_CENSUS_PAGE_STATS
+{
+    ULONG FreshRefills;
+    ULONG EmptyReuses;
+    ULONG Detaches;
+    ULONG CurrentActive;
+    ULONG PeakActive;
+    ULONG CurrentEmpty;
+    ULONG PeakEmpty;
+} NXP_POOL_CENSUS_PAGE_STATS;
+
+typedef struct _NXP_POOL_CENSUS_LARGE
+{
+    PVOID Address;
+    USHORT KeyIndex;
+    USHORT Bin;
+    UCHAR Used;
+    UCHAR Sampled;
+} NXP_POOL_CENSUS_LARGE;
+
+typedef struct _NXP_POOL_CENSUS_SAMPLE
+{
+    PVOID Address;
+    ULONGLONG StartedAt;
+    USHORT KeyIndex;
+    USHORT Next;
+} NXP_POOL_CENSUS_SAMPLE;
+
+typedef struct _NXP_POOL_CENSUS_DATA
+{
+    ULONG Magic;
+    ULONG Schema;
+    ULONG Bytes;
+    volatile ULONG Sequence;
+    ULONG Allocations;
+    ULONG Frees;
+    ULONG AllocationSequence;
+    ULONG KeyOverflows;
+    ULONG LargeOverflows;
+    ULONG LargeFreeMisses;
+    ULONG LifetimeOverflows;
+    ULONG LifetimeMisses;
+    ULONG UntrackedFrees;
+    ULONG Saturations;
+    ULONG PageUnderflows;
+    ULONG LifetimeActive;
+    ULONG LifetimeActivePeak;
+    ULONG BinSlots;
+    ULONG PageDomainCount;
+    ULONG PageClassCount;
+    ULONG PageStatsBytes;
+    ULONG EntryCount;
+    ULONG EntryBytes;
+    ULONG BinAllocationsOffset;
+    ULONG BinLiveOffset;
+    ULONG BinPeakOffset;
+    ULONG PagesOffset;
+    ULONG EntriesOffset;
+    ULONG BinAllocations[NXP_POOL_CENSUS_BIN_SLOTS];
+    ULONG BinLive[NXP_POOL_CENSUS_BIN_SLOTS];
+    ULONG BinPeak[NXP_POOL_CENSUS_BIN_SLOTS];
+    NXP_POOL_CENSUS_PAGE_STATS Pages[NXP_POOL_CENSUS_DOMAIN_COUNT]
+                                             [NXP_POOL_CENSUS_CLASS_COUNT];
+    NXP_POOL_CENSUS_ENTRY Entries[NXP_POOL_CENSUS_KEY_SLOTS];
+    NXP_POOL_CENSUS_LARGE Large[NXP_POOL_CENSUS_LARGE_SLOTS];
+    NXP_POOL_CENSUS_SAMPLE Samples[NXP_POOL_CENSUS_SAMPLE_SLOTS];
+    USHORT SampleHash[NXP_POOL_CENSUS_SAMPLE_BUCKETS];
+} NXP_POOL_CENSUS_DATA;
+
+/* Read this symbol only with the guest stopped.  The record is diagnostic
+ * state, not a synchronized public ABI.  Current samples are right-censored
+ * live allocations; completed lifetime buckets use <1 s, 1-30 s, and >=30 s. */
+extern NXP_POOL_CENSUS_DATA NxpPoolCensusData;
+
+VOID NxPoolCensusInitialize(VOID);
+USHORT NxPoolCensusBinForSize(SIZE_T NumberOfBytes);
+BOOLEAN NxPoolCensusAllocate(PVOID Address,
+                             ULONG Tag,
+                             SIZE_T NumberOfBytes,
+                             UCHAR Domain,
+                             BOOLEAN LargeAllocation);
+VOID NxPoolCensusFree(PVOID Address,
+                      ULONG Tag,
+                      USHORT Bin,
+                      UCHAR Domain,
+                      BOOLEAN Sampled);
+VOID NxPoolCensusFreeLarge(PVOID Address);
+VOID NxPoolCensusPageAttach(ULONG ClassIndex,
+                            UCHAR Domain,
+                            BOOLEAN Reused);
+VOID NxPoolCensusPageBecameActive(ULONG ClassIndex, UCHAR Domain);
+VOID NxPoolCensusPageBecameEmpty(ULONG ClassIndex, UCHAR Domain);
+VOID NxPoolCensusPageDetach(ULONG ClassIndex, UCHAR Domain);
+
+#define NXP_POOL_CENSUS_PACK_CLASS(Class, Bin, Domain, Sampled) \
+    ((USHORT)(((Class) & NXP_POOL_CENSUS_CLASS_MASK) | \
+              (((Bin) << NXP_POOL_CENSUS_BIN_SHIFT) & NXP_POOL_CENSUS_BIN_MASK) | \
+              (((Domain) & 1U) ? NXP_POOL_CENSUS_DOMAIN_MASK : 0U) | \
+              ((Sampled) ? NXP_POOL_CENSUS_SAMPLED_MASK : 0U)))
+#define NXP_POOL_CENSUS_GET_CLASS(Value) \
+    ((USHORT)((Value) & NXP_POOL_CENSUS_CLASS_MASK))
+#define NXP_POOL_CENSUS_GET_BIN(Value) \
+    ((USHORT)(((Value) & NXP_POOL_CENSUS_BIN_MASK) >> NXP_POOL_CENSUS_BIN_SHIFT))
+#define NXP_POOL_CENSUS_GET_DOMAIN(Value) \
+    ((UCHAR)(((Value) & NXP_POOL_CENSUS_DOMAIN_MASK) != 0))
+#define NXP_POOL_CENSUS_GET_SAMPLED(Value) \
+    ((BOOLEAN)(((Value) & NXP_POOL_CENSUS_SAMPLED_MASK) != 0))
+#endif
