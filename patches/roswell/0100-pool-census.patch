diff --git a/ntoskrnl/xb/mm/poolcensus.c b/ntoskrnl/xb/mm/poolcensus.c
new file mode 100644
index 00000000..955db6bd
--- /dev/null
+++ b/ntoskrnl/xb/mm/poolcensus.c
@@ -0,0 +1,446 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <ntoskrnl.h>
+#include "pool-census.h"
+
+#ifdef NXK_POOL_CENSUS
+
+C_ASSERT(NXP_POOL_CENSUS_KEY_SLOTS == 1024);
+C_ASSERT(NXP_POOL_CENSUS_LARGE_SLOTS == 1024);
+C_ASSERT(NXP_POOL_CENSUS_SAMPLE_SLOTS == NXP_POOL_CENSUS_SAMPLE_BUCKETS);
+C_ASSERT(NXP_POOL_CENSUS_SAMPLE_SLOTS < NXP_POOL_CENSUS_NO_SLOT);
+C_ASSERT(sizeof(NXP_POOL_CENSUS_ENTRY) == 36);
+C_ASSERT(sizeof(NXP_POOL_CENSUS_PAGE_STATS) == 28);
+
+/* All state is diagnostic-only and preallocated.  The 16-byte size histogram
+ * covers requests through 64 KiB; larger requests use its overflow bin. */
+NXP_POOL_CENSUS_DATA NxpPoolCensusData;
+static KSPIN_LOCK NxpPoolCensusLock;
+
+static VOID
+NxpPoolCensusIncrement(ULONG *Value)
+{
+    if (*Value == MAXULONG)
+        NxpPoolCensusData.Saturations++;
+    else
+        (*Value)++;
+}
+
+/* Readers stop the guest, then require an even sequence value around their
+ * copy.  Odd means the stop landed during an update and the reader should
+ * resume briefly before trying again. */
+static VOID
+NxpPoolCensusAcquire(KIRQL *OldIrql)
+{
+    KeAcquireSpinLock(&NxpPoolCensusLock, OldIrql);
+    NxpPoolCensusData.Sequence++;
+    KeMemoryBarrier();
+}
+
+static VOID
+NxpPoolCensusRelease(KIRQL OldIrql)
+{
+    KeMemoryBarrier();
+    NxpPoolCensusData.Sequence++;
+    KeReleaseSpinLock(&NxpPoolCensusLock, OldIrql);
+}
+
+static USHORT
+NxpPoolCensusFindEntry(ULONG Tag, USHORT Bin, UCHAR Domain, BOOLEAN Create)
+{
+    ULONG Hash = Tag ^ ((ULONG)Bin * 0x9E3779B9UL) ^ ((ULONG)Domain * 0x85EBCA6BUL);
+    ULONG Index = Hash & (NXP_POOL_CENSUS_KEY_SLOTS - 1);
+
+    for (ULONG Probe = 0; Probe < NXP_POOL_CENSUS_KEY_SLOTS; ++Probe)
+    {
+        NXP_POOL_CENSUS_ENTRY *Entry = &NxpPoolCensusData.Entries[Index];
+
+        if (!Entry->Used)
+        {
+            if (!Create) return NXP_POOL_CENSUS_NO_SLOT;
+            Entry->Tag = Tag;
+            Entry->Bin = Bin;
+            Entry->Domain = Domain;
+            Entry->Used = TRUE;
+            return (USHORT)Index;
+        }
+        if (Entry->Tag == Tag && Entry->Bin == Bin && Entry->Domain == Domain)
+            return (USHORT)Index;
+        Index = (Index + 1) & (NXP_POOL_CENSUS_KEY_SLOTS - 1);
+    }
+    return NXP_POOL_CENSUS_NO_SLOT;
+}
+
+static USHORT
+NxpPoolCensusFindLarge(PVOID Address, BOOLEAN Create)
+{
+    ULONG Start = ((ULONG)(ULONG_PTR)Address >> 4) &
+                  (NXP_POOL_CENSUS_LARGE_SLOTS - 1);
+    USHORT FreeSlot = NXP_POOL_CENSUS_NO_SLOT;
+
+    for (ULONG Probe = 0; Probe < NXP_POOL_CENSUS_LARGE_SLOTS; ++Probe)
+    {
+        ULONG Index = (Start + Probe) & (NXP_POOL_CENSUS_LARGE_SLOTS - 1);
+        NXP_POOL_CENSUS_LARGE *Entry = &NxpPoolCensusData.Large[Index];
+
+        if (!Entry->Used)
+        {
+            if (FreeSlot == NXP_POOL_CENSUS_NO_SLOT) FreeSlot = (USHORT)Index;
+            continue;
+        }
+        if (Entry->Address == Address) return (USHORT)Index;
+    }
+    return Create ? FreeSlot : NXP_POOL_CENSUS_NO_SLOT;
+}
+
+static USHORT
+NxpPoolCensusFindSample(PVOID Address, BOOLEAN Create)
+{
+    ULONG Bucket = ((ULONG)(ULONG_PTR)Address >> 4) &
+                   (NXP_POOL_CENSUS_SAMPLE_BUCKETS - 1);
+    USHORT Slot = NxpPoolCensusData.SampleHash[Bucket];
+
+    while (Slot != NXP_POOL_CENSUS_NO_SLOT)
+    {
+        NXP_POOL_CENSUS_SAMPLE *Sample = &NxpPoolCensusData.Samples[Slot];
+        if (Sample->Address == Address) return Slot;
+        Slot = Sample->Next;
+    }
+    if (!Create) return NXP_POOL_CENSUS_NO_SLOT;
+
+    for (Slot = 0; Slot < NXP_POOL_CENSUS_SAMPLE_SLOTS; ++Slot)
+    {
+        NXP_POOL_CENSUS_SAMPLE *Sample = &NxpPoolCensusData.Samples[Slot];
+        if (Sample->Address != NULL) continue;
+        Sample->Address = Address;
+        Sample->Next = NxpPoolCensusData.SampleHash[Bucket];
+        NxpPoolCensusData.SampleHash[Bucket] = Slot;
+        return Slot;
+    }
+    return NXP_POOL_CENSUS_NO_SLOT;
+}
+
+static VOID
+NxpPoolCensusRemoveSample(USHORT Slot)
+{
+    PVOID Address = NxpPoolCensusData.Samples[Slot].Address;
+    ULONG Bucket = ((ULONG)(ULONG_PTR)Address >> 4) &
+                   (NXP_POOL_CENSUS_SAMPLE_BUCKETS - 1);
+    USHORT Previous = NXP_POOL_CENSUS_NO_SLOT;
+    USHORT Current = NxpPoolCensusData.SampleHash[Bucket];
+
+    while (Current != NXP_POOL_CENSUS_NO_SLOT)
+    {
+        NXP_POOL_CENSUS_SAMPLE *Sample = &NxpPoolCensusData.Samples[Current];
+        if (Current == Slot)
+        {
+            if (Previous == NXP_POOL_CENSUS_NO_SLOT)
+                NxpPoolCensusData.SampleHash[Bucket] = Sample->Next;
+            else
+                NxpPoolCensusData.Samples[Previous].Next = Sample->Next;
+            Sample->Address = NULL;
+            Sample->KeyIndex = NXP_POOL_CENSUS_NO_SLOT;
+            Sample->Next = NXP_POOL_CENSUS_NO_SLOT;
+            return;
+        }
+        Previous = Current;
+        Current = Sample->Next;
+    }
+    NxpPoolCensusIncrement(&NxpPoolCensusData.LifetimeMisses);
+}
+
+static VOID
+NxpPoolCensusRecordFree(USHORT KeyIndex,
+                        USHORT Bin,
+                        PVOID Address,
+                        BOOLEAN Sampled)
+{
+    NXP_POOL_CENSUS_ENTRY *Entry = NULL;
+    BOOLEAN Untracked = FALSE;
+
+    if (Bin >= NXP_POOL_CENSUS_BIN_SLOTS)
+    {
+        Bin = NXP_POOL_CENSUS_BIN_OVERFLOW;
+        Untracked = TRUE;
+    }
+    if (NxpPoolCensusData.BinLive[Bin] == 0)
+        Untracked = TRUE;
+    else
+        NxpPoolCensusData.BinLive[Bin]--;
+
+    if (KeyIndex != NXP_POOL_CENSUS_NO_SLOT &&
+        KeyIndex < NXP_POOL_CENSUS_KEY_SLOTS)
+    {
+        Entry = &NxpPoolCensusData.Entries[KeyIndex];
+        NxpPoolCensusIncrement(&Entry->Frees);
+        if (Entry->Live == 0)
+            Untracked = TRUE;
+        else
+            Entry->Live--;
+    }
+    else
+    {
+        Untracked = TRUE;
+    }
+    if (Untracked)
+        NxpPoolCensusIncrement(&NxpPoolCensusData.UntrackedFrees);
+    NxpPoolCensusIncrement(&NxpPoolCensusData.Frees);
+
+    if (Sampled)
+    {
+        USHORT Slot = NxpPoolCensusFindSample(Address, FALSE);
+        if (Slot == NXP_POOL_CENSUS_NO_SLOT)
+        {
+            NxpPoolCensusIncrement(&NxpPoolCensusData.LifetimeMisses);
+            return;
+        }
+        NXP_POOL_CENSUS_SAMPLE *Sample = &NxpPoolCensusData.Samples[Slot];
+        ULONGLONG Lifetime = KeQueryInterruptTime() - Sample->StartedAt;
+        if (NxpPoolCensusData.LifetimeActive == 0)
+            NxpPoolCensusIncrement(&NxpPoolCensusData.LifetimeMisses);
+        else
+            NxpPoolCensusData.LifetimeActive--;
+        if (Entry != NULL)
+        {
+            if (Lifetime < 10000000ULL)
+                NxpPoolCensusIncrement(&Entry->LifeShort);
+            else if (Lifetime < 300000000ULL)
+                NxpPoolCensusIncrement(&Entry->LifeMedium);
+            else
+                NxpPoolCensusIncrement(&Entry->LifeRetained);
+        }
+        NxpPoolCensusRemoveSample(Slot);
+    }
+}
+
+VOID
+NxPoolCensusInitialize(VOID)
+{
+    RtlZeroMemory(&NxpPoolCensusData, sizeof(NxpPoolCensusData));
+    for (ULONG i = 0; i < NXP_POOL_CENSUS_SAMPLE_BUCKETS; ++i)
+        NxpPoolCensusData.SampleHash[i] = NXP_POOL_CENSUS_NO_SLOT;
+    for (ULONG i = 0; i < NXP_POOL_CENSUS_SAMPLE_SLOTS; ++i)
+    {
+        NxpPoolCensusData.Samples[i].KeyIndex = NXP_POOL_CENSUS_NO_SLOT;
+        NxpPoolCensusData.Samples[i].Next = NXP_POOL_CENSUS_NO_SLOT;
+    }
+    NxpPoolCensusData.Magic = NXP_POOL_CENSUS_MAGIC;
+    NxpPoolCensusData.Schema = NXP_POOL_CENSUS_SCHEMA;
+    NxpPoolCensusData.Bytes = sizeof(NxpPoolCensusData);
+    NxpPoolCensusData.BinSlots = NXP_POOL_CENSUS_BIN_SLOTS;
+    NxpPoolCensusData.PageDomainCount = NXP_POOL_CENSUS_DOMAIN_COUNT;
+    NxpPoolCensusData.PageClassCount = NXP_POOL_CENSUS_CLASS_COUNT;
+    NxpPoolCensusData.PageStatsBytes = sizeof(NXP_POOL_CENSUS_PAGE_STATS);
+    NxpPoolCensusData.EntryCount = NXP_POOL_CENSUS_KEY_SLOTS;
+    NxpPoolCensusData.EntryBytes = sizeof(NXP_POOL_CENSUS_ENTRY);
+    NxpPoolCensusData.BinAllocationsOffset =
+        FIELD_OFFSET(NXP_POOL_CENSUS_DATA, BinAllocations);
+    NxpPoolCensusData.BinLiveOffset =
+        FIELD_OFFSET(NXP_POOL_CENSUS_DATA, BinLive);
+    NxpPoolCensusData.BinPeakOffset =
+        FIELD_OFFSET(NXP_POOL_CENSUS_DATA, BinPeak);
+    NxpPoolCensusData.PagesOffset = FIELD_OFFSET(NXP_POOL_CENSUS_DATA, Pages);
+    NxpPoolCensusData.EntriesOffset = FIELD_OFFSET(NXP_POOL_CENSUS_DATA, Entries);
+    KeInitializeSpinLock(&NxpPoolCensusLock);
+}
+
+USHORT
+NxPoolCensusBinForSize(SIZE_T NumberOfBytes)
+{
+    SIZE_T Bin = NumberOfBytes / 16;
+    if ((NumberOfBytes & 15) != 0) Bin++;
+    if (Bin > NXP_POOL_CENSUS_BIN_OVERFLOW)
+        Bin = NXP_POOL_CENSUS_BIN_OVERFLOW;
+    return (USHORT)Bin;
+}
+
+BOOLEAN
+NxPoolCensusAllocate(PVOID Address,
+                     ULONG Tag,
+                     SIZE_T NumberOfBytes,
+                     UCHAR Domain,
+                     BOOLEAN LargeAllocation)
+{
+    KIRQL OldIrql;
+    USHORT Bin = NxPoolCensusBinForSize(NumberOfBytes);
+    USHORT KeyIndex, LargeIndex = NXP_POOL_CENSUS_NO_SLOT;
+    BOOLEAN Sampled = FALSE;
+
+    if (Domain >= NXP_POOL_CENSUS_DOMAIN_COUNT)
+        Domain = NXP_POOL_CENSUS_DOMAIN_SHARED;
+    NxpPoolCensusAcquire(&OldIrql);
+    NxpPoolCensusIncrement(&NxpPoolCensusData.Allocations);
+    NxpPoolCensusIncrement(&NxpPoolCensusData.BinAllocations[Bin]);
+    NxpPoolCensusIncrement(&NxpPoolCensusData.BinLive[Bin]);
+    if (NxpPoolCensusData.BinLive[Bin] > NxpPoolCensusData.BinPeak[Bin])
+        NxpPoolCensusData.BinPeak[Bin] = NxpPoolCensusData.BinLive[Bin];
+    KeyIndex = NxpPoolCensusFindEntry(Tag, Bin, Domain, TRUE);
+    if (KeyIndex == NXP_POOL_CENSUS_NO_SLOT)
+        NxpPoolCensusIncrement(&NxpPoolCensusData.KeyOverflows);
+    else
+    {
+        NXP_POOL_CENSUS_ENTRY *Entry = &NxpPoolCensusData.Entries[KeyIndex];
+        NxpPoolCensusIncrement(&Entry->Allocations);
+        NxpPoolCensusIncrement(&Entry->Live);
+        if (Entry->Live > Entry->Peak) Entry->Peak = Entry->Live;
+    }
+
+    if (LargeAllocation)
+    {
+        LargeIndex = NxpPoolCensusFindLarge(Address, TRUE);
+        if (LargeIndex == NXP_POOL_CENSUS_NO_SLOT)
+            NxpPoolCensusIncrement(&NxpPoolCensusData.LargeOverflows);
+        else
+        {
+            NXP_POOL_CENSUS_LARGE *Entry = &NxpPoolCensusData.Large[LargeIndex];
+            Entry->Address = Address;
+            Entry->KeyIndex = KeyIndex;
+            Entry->Bin = Bin;
+            Entry->Used = TRUE;
+            Entry->Sampled = FALSE;
+        }
+    }
+
+    /* This is a sampling phase, not a reported metric.  Let it wrap so a
+     * long diagnostic session keeps the same one-in-64 sampling cadence. */
+    NxpPoolCensusData.AllocationSequence++;
+    if ((NxpPoolCensusData.AllocationSequence & 63) == 0 &&
+        KeyIndex != NXP_POOL_CENSUS_NO_SLOT &&
+        (!LargeAllocation || LargeIndex != NXP_POOL_CENSUS_NO_SLOT))
+    {
+        USHORT Slot = NxpPoolCensusFindSample(Address, TRUE);
+        if (Slot == NXP_POOL_CENSUS_NO_SLOT)
+            NxpPoolCensusIncrement(&NxpPoolCensusData.LifetimeOverflows);
+        else
+        {
+            NXP_POOL_CENSUS_SAMPLE *Sample = &NxpPoolCensusData.Samples[Slot];
+            Sample->StartedAt = KeQueryInterruptTime();
+            Sample->KeyIndex = KeyIndex;
+            Sampled = TRUE;
+            NxpPoolCensusIncrement(&NxpPoolCensusData.LifetimeActive);
+            if (NxpPoolCensusData.LifetimeActive >
+                NxpPoolCensusData.LifetimeActivePeak)
+                NxpPoolCensusData.LifetimeActivePeak =
+                    NxpPoolCensusData.LifetimeActive;
+            if (LargeAllocation)
+                NxpPoolCensusData.Large[LargeIndex].Sampled = TRUE;
+        }
+    }
+    NxpPoolCensusRelease(OldIrql);
+    return Sampled;
+}
+
+VOID
+NxPoolCensusFree(PVOID Address,
+                 ULONG Tag,
+                 USHORT Bin,
+                 UCHAR Domain,
+                 BOOLEAN Sampled)
+{
+    KIRQL OldIrql;
+    USHORT KeyIndex;
+
+    if (Domain >= NXP_POOL_CENSUS_DOMAIN_COUNT)
+        Domain = NXP_POOL_CENSUS_DOMAIN_SHARED;
+    NxpPoolCensusAcquire(&OldIrql);
+    KeyIndex = NxpPoolCensusFindEntry(Tag, Bin, Domain, FALSE);
+    NxpPoolCensusRecordFree(KeyIndex, Bin, Address, Sampled);
+    NxpPoolCensusRelease(OldIrql);
+}
+
+VOID
+NxPoolCensusFreeLarge(PVOID Address)
+{
+    KIRQL OldIrql;
+    USHORT LargeIndex;
+
+    NxpPoolCensusAcquire(&OldIrql);
+    LargeIndex = NxpPoolCensusFindLarge(Address, FALSE);
+    if (LargeIndex == NXP_POOL_CENSUS_NO_SLOT)
+    {
+        NxpPoolCensusIncrement(&NxpPoolCensusData.LargeFreeMisses);
+        NxpPoolCensusIncrement(&NxpPoolCensusData.Frees);
+    }
+    else
+    {
+        NXP_POOL_CENSUS_LARGE *Large = &NxpPoolCensusData.Large[LargeIndex];
+        NxpPoolCensusRecordFree(Large->KeyIndex, Large->Bin,
+                                Address, Large->Sampled);
+        Large->Address = NULL;
+        Large->KeyIndex = NXP_POOL_CENSUS_NO_SLOT;
+        Large->Bin = NXP_POOL_CENSUS_NO_SLOT;
+        Large->Used = FALSE;
+        Large->Sampled = FALSE;
+    }
+    NxpPoolCensusRelease(OldIrql);
+}
+
+static NXP_POOL_CENSUS_PAGE_STATS *
+NxpPoolCensusPageStats(ULONG ClassIndex, UCHAR Domain)
+{
+    ULONG Class = ClassIndex % NXP_POOL_CENSUS_CLASS_COUNT;
+    if (Domain >= NXP_POOL_CENSUS_DOMAIN_COUNT)
+        Domain = NXP_POOL_CENSUS_DOMAIN_SHARED;
+    return &NxpPoolCensusData.Pages[Domain][Class];
+}
+
+VOID
+NxPoolCensusPageAttach(ULONG ClassIndex, UCHAR Domain, BOOLEAN Reused)
+{
+    KIRQL OldIrql;
+    NXP_POOL_CENSUS_PAGE_STATS *Stats = NxpPoolCensusPageStats(ClassIndex, Domain);
+    NxpPoolCensusAcquire(&OldIrql);
+    NxpPoolCensusIncrement(Reused ? &Stats->EmptyReuses : &Stats->FreshRefills);
+    NxpPoolCensusIncrement(&Stats->CurrentActive);
+    if (Stats->CurrentActive > Stats->PeakActive)
+        Stats->PeakActive = Stats->CurrentActive;
+    NxpPoolCensusRelease(OldIrql);
+}
+
+VOID
+NxPoolCensusPageBecameActive(ULONG ClassIndex, UCHAR Domain)
+{
+    KIRQL OldIrql;
+    NXP_POOL_CENSUS_PAGE_STATS *Stats = NxpPoolCensusPageStats(ClassIndex, Domain);
+    NxpPoolCensusAcquire(&OldIrql);
+    if (Stats->CurrentEmpty == 0)
+        NxpPoolCensusIncrement(&NxpPoolCensusData.PageUnderflows);
+    else
+        Stats->CurrentEmpty--;
+    NxpPoolCensusIncrement(&Stats->CurrentActive);
+    if (Stats->CurrentActive > Stats->PeakActive)
+        Stats->PeakActive = Stats->CurrentActive;
+    NxpPoolCensusRelease(OldIrql);
+}
+
+VOID
+NxPoolCensusPageBecameEmpty(ULONG ClassIndex, UCHAR Domain)
+{
+    KIRQL OldIrql;
+    NXP_POOL_CENSUS_PAGE_STATS *Stats = NxpPoolCensusPageStats(ClassIndex, Domain);
+    NxpPoolCensusAcquire(&OldIrql);
+    if (Stats->CurrentActive == 0)
+        NxpPoolCensusIncrement(&NxpPoolCensusData.PageUnderflows);
+    else
+        Stats->CurrentActive--;
+    NxpPoolCensusIncrement(&Stats->CurrentEmpty);
+    if (Stats->CurrentEmpty > Stats->PeakEmpty)
+        Stats->PeakEmpty = Stats->CurrentEmpty;
+    NxpPoolCensusRelease(OldIrql);
+}
+
+VOID
+NxPoolCensusPageDetach(ULONG ClassIndex, UCHAR Domain)
+{
+    KIRQL OldIrql;
+    NXP_POOL_CENSUS_PAGE_STATS *Stats = NxpPoolCensusPageStats(ClassIndex, Domain);
+    NxpPoolCensusAcquire(&OldIrql);
+    if (Stats->CurrentEmpty == 0)
+        NxpPoolCensusIncrement(&NxpPoolCensusData.PageUnderflows);
+    else
+        Stats->CurrentEmpty--;
+    NxpPoolCensusIncrement(&Stats->Detaches);
+    NxpPoolCensusRelease(OldIrql);
+}
+
+#endif /* NXK_POOL_CENSUS */
diff --git a/tests/host/pool-census/check.py b/tests/host/pool-census/check.py
new file mode 100644
index 00000000..5c59d2c0
--- /dev/null
+++ b/tests/host/pool-census/check.py
@@ -0,0 +1,207 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile the production pool-census counters with kernel lock/time shims."""
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+header_path = root / "ntoskrnl/xb/mm/pool-census.h"
+source_path = root / "ntoskrnl/xb/mm/poolcensus.c"
+pool_path = root / "ntoskrnl/xb/mm/pool.c"
+cmake_path = root / "ntoskrnl/CMakeLists.txt"
+assert header_path.is_file() and source_path.is_file(), "pool census implementation missing"
+header = header_path.read_text()
+source = source_path.read_text()
+pool = pool_path.read_text()
+cmake = cmake_path.read_text()
+for hook in ("NxPoolCensusAllocate(", "NxPoolCensusFree(", "NxPoolCensusFreeLarge(",
+             "NxPoolCensusPageAttach(", "NxPoolCensusPageBecameEmpty(",
+             "NXP_POOL_CENSUS_PACK_CLASS", "NXP_POOL_CENSUS_GET_CLASS"):
+    assert hook in pool, f"production pool hook missing: {hook}"
+assert "option(NXK_POOL_CENSUS" in cmake
+assert "target_compile_definitions(ntoskrnl PRIVATE NXK_POOL_CENSUS=1)" in cmake
+source = source.replace('#include <ntoskrnl.h>', '').replace('#include "pool-census.h"', '')
+header = header.replace('#pragma once', '')
+
+shim = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t UCHAR, BOOLEAN;
+typedef uint16_t USHORT;
+typedef uint32_t ULONG, KSPIN_LOCK, KIRQL;
+typedef uintptr_t ULONG_PTR;
+typedef uint64_t ULONGLONG;
+typedef size_t SIZE_T;
+typedef void VOID, *PVOID;
+#define TRUE 1
+#define FALSE 0
+#define MAXULONG UINT32_MAX
+#define RTL_NUMBER_OF(a) (sizeof(a) / sizeof((a)[0]))
+#define C_ASSERT(e) _Static_assert((e), #e)
+#define FIELD_OFFSET(t, f) __builtin_offsetof(t, f)
+#define RtlZeroMemory(p,n) memset((p), 0, (n))
+#define RtlFillMemory(p,n,v) memset((p), (v), (n))
+#define KeMemoryBarrier() __asm__ __volatile__("" ::: "memory")
+static ULONGLONG FakeInterruptTime;
+static KIRQL LockHeld;
+static void KeInitializeSpinLock(KSPIN_LOCK *Lock) { *Lock = 0; }
+static void KeAcquireSpinLock(KSPIN_LOCK *Lock, KIRQL *OldIrql) {
+    assert(!LockHeld && !*Lock); LockHeld = 1; *Lock = 1; *OldIrql = 0;
+}
+static void KeReleaseSpinLock(KSPIN_LOCK *Lock, KIRQL OldIrql) {
+    (void)OldIrql; assert(LockHeld && *Lock); *Lock = 0; LockHeld = 0;
+}
+static ULONGLONG KeQueryInterruptTime(void) { return FakeInterruptTime; }
+'''
+
+main = r'''
+static NXP_POOL_CENSUS_ENTRY *entry_for(ULONG Tag, USHORT Bin, UCHAR Domain) {
+    for (ULONG i = 0; i < NXP_POOL_CENSUS_KEY_SLOTS; ++i) {
+        NXP_POOL_CENSUS_ENTRY *E = &NxpPoolCensusData.Entries[i];
+        if (E->Used && E->Tag == Tag && E->Bin == Bin && E->Domain == Domain)
+            return E;
+    }
+    return NULL;
+}
+
+int main(void) {
+    int a, b, title, large, sampled;
+    PVOID collision_a = (PVOID)(uintptr_t)0x10000;
+    PVOID collision_b = (PVOID)(uintptr_t)0x14000;
+    NXP_POOL_CENSUS_ENTRY *E;
+
+    assert(NxPoolCensusBinForSize(0) == 0);
+    assert(NxPoolCensusBinForSize(16) == 1);
+    assert(NxPoolCensusBinForSize(17) == 2);
+    assert(NxPoolCensusBinForSize(65520) == 4095);
+    assert(NxPoolCensusBinForSize(65521) == 4096);
+    assert(NxPoolCensusBinForSize(65536) == 4096);
+    assert(NxPoolCensusBinForSize(65537) == NXP_POOL_CENSUS_BIN_OVERFLOW);
+    assert(NXP_POOL_CENSUS_BIN_SLOTS == 4098);
+    USHORT Packed = NXP_POOL_CENSUS_PACK_CLASS(12, 128,
+                                                NXP_POOL_CENSUS_DOMAIN_TITLE, TRUE);
+    assert(NXP_POOL_CENSUS_GET_CLASS(Packed) == 12);
+    assert(NXP_POOL_CENSUS_GET_BIN(Packed) == 128);
+    assert(NXP_POOL_CENSUS_GET_DOMAIN(Packed));
+    assert(NXP_POOL_CENSUS_GET_SAMPLED(Packed));
+    NxPoolCensusInitialize();
+    assert(NxpPoolCensusData.Magic == NXP_POOL_CENSUS_MAGIC);
+    assert(NxpPoolCensusData.Schema == NXP_POOL_CENSUS_SCHEMA);
+    assert(NxpPoolCensusData.Bytes == sizeof(NXP_POOL_CENSUS_DATA));
+    assert((NxpPoolCensusData.Sequence & 1) == 0);
+    assert(NxpPoolCensusData.BinSlots == NXP_POOL_CENSUS_BIN_SLOTS);
+    assert(NxpPoolCensusData.EntryBytes == sizeof(NXP_POOL_CENSUS_ENTRY));
+    assert(NxpPoolCensusData.BinAllocationsOffset ==
+           FIELD_OFFSET(NXP_POOL_CENSUS_DATA, BinAllocations));
+    assert(NxpPoolCensusData.EntriesOffset ==
+           FIELD_OFFSET(NXP_POOL_CENSUS_DATA, Entries));
+
+    NxPoolCensusAllocate(&a, 0x41424344, 64, NXP_POOL_CENSUS_DOMAIN_KERNEL, FALSE);
+    NxPoolCensusAllocate(&b, 0x41424344, 64, NXP_POOL_CENSUS_DOMAIN_KERNEL, FALSE);
+    E = entry_for(0x41424344, 4, NXP_POOL_CENSUS_DOMAIN_KERNEL);
+    assert(E && E->Allocations == 2 && E->Live == 2 && E->Peak == 2);
+    assert(NxpPoolCensusData.BinAllocations[4] == 2);
+    assert(NxpPoolCensusData.BinLive[4] == 2 && NxpPoolCensusData.BinPeak[4] == 2);
+    NxPoolCensusFree(&a, 0x41424344, 4, NXP_POOL_CENSUS_DOMAIN_KERNEL, FALSE);
+    assert(E->Frees == 1 && E->Live == 1);
+    assert(NxpPoolCensusData.BinLive[4] == 1);
+
+    NxPoolCensusAllocate(&title, 0x41424344, 64, NXP_POOL_CENSUS_DOMAIN_TITLE, FALSE);
+    assert(entry_for(0x41424344, 4, NXP_POOL_CENSUS_DOMAIN_TITLE) != E);
+    assert(entry_for(0x41424344, 4, NXP_POOL_CENSUS_DOMAIN_TITLE)->Live == 1);
+    NxPoolCensusFree(&b, 0x41424344, 4, NXP_POOL_CENSUS_DOMAIN_KERNEL, FALSE);
+    NxPoolCensusFree(&title, 0x41424344, 4, NXP_POOL_CENSUS_DOMAIN_TITLE, FALSE);
+    assert(E->Live == 0 && E->Peak == 2);
+    assert(NxpPoolCensusData.BinLive[4] == 0 && NxpPoolCensusData.BinPeak[4] == 2);
+
+    NxPoolCensusAllocate(&large, 0x4c415247, 8192, NXP_POOL_CENSUS_DOMAIN_KERNEL, TRUE);
+    assert(NxpPoolCensusData.BinAllocations[512] == 1);
+    E = entry_for(0x4c415247, 512, NXP_POOL_CENSUS_DOMAIN_KERNEL);
+    assert(E && E->Live == 1);
+    NxPoolCensusFreeLarge(&large);
+    assert(E->Frees == 1 && E->Live == 0);
+
+    /* Deleting the first colliding slot must not hide later entries, and a
+     * miss must not be mistaken for the first empty slot. */
+    NxPoolCensusAllocate(collision_a, 0x434f4c41, 9000,
+                         NXP_POOL_CENSUS_DOMAIN_KERNEL, TRUE);
+    NxPoolCensusAllocate(collision_b, 0x434f4c42, 9000,
+                         NXP_POOL_CENSUS_DOMAIN_KERNEL, TRUE);
+    NxPoolCensusFreeLarge(collision_a);
+    NxPoolCensusFreeLarge(collision_b);
+    assert(NxpPoolCensusData.LargeFreeMisses == 0);
+    NxPoolCensusFreeLarge((PVOID)(uintptr_t)0x18000);
+    assert(NxpPoolCensusData.LargeFreeMisses == 1);
+
+    NxpPoolCensusData.AllocationSequence = 63;
+    assert(NxPoolCensusAllocate(&sampled, 0x53484f52, 80, NXP_POOL_CENSUS_DOMAIN_KERNEL, FALSE));
+    FakeInterruptTime += 5000000;
+    NxPoolCensusFree(&sampled, 0x53484f52, 5, NXP_POOL_CENSUS_DOMAIN_KERNEL, TRUE);
+    E = entry_for(0x53484f52, 5, NXP_POOL_CENSUS_DOMAIN_KERNEL);
+    assert(E && E->LifeShort == 1 && E->LifeMedium == 0 && E->LifeRetained == 0);
+    assert(NxpPoolCensusData.LifetimeActive == 0);
+
+    NxpPoolCensusData.AllocationSequence = 63;
+    assert(NxPoolCensusAllocate(&sampled, 0x4d454449, 80, NXP_POOL_CENSUS_DOMAIN_KERNEL, FALSE));
+    FakeInterruptTime += 20000000;
+    NxPoolCensusFree(&sampled, 0x4d454449, 5, NXP_POOL_CENSUS_DOMAIN_KERNEL, TRUE);
+    E = entry_for(0x4d454449, 5, NXP_POOL_CENSUS_DOMAIN_KERNEL);
+    assert(E && E->LifeMedium == 1);
+
+    NxpPoolCensusData.AllocationSequence = 63;
+    assert(NxPoolCensusAllocate(&sampled, 0x52455441, 80, NXP_POOL_CENSUS_DOMAIN_KERNEL, FALSE));
+    FakeInterruptTime += 400000000;
+    NxPoolCensusFree(&sampled, 0x52455441, 5, NXP_POOL_CENSUS_DOMAIN_KERNEL, TRUE);
+    E = entry_for(0x52455441, 5, NXP_POOL_CENSUS_DOMAIN_KERNEL);
+    assert(E && E->LifeRetained == 1);
+    assert(NxpPoolCensusData.LifetimeActive == 0);
+
+    NxPoolCensusPageAttach(2, NXP_POOL_CENSUS_DOMAIN_SHARED, FALSE);
+    NxPoolCensusPageBecameEmpty(2, NXP_POOL_CENSUS_DOMAIN_SHARED);
+    NxPoolCensusPageDetach(2, NXP_POOL_CENSUS_DOMAIN_SHARED);
+    NxPoolCensusPageAttach(2, NXP_POOL_CENSUS_DOMAIN_SHARED, TRUE);
+    assert(NxpPoolCensusData.Pages[NXP_POOL_CENSUS_DOMAIN_SHARED][2].FreshRefills == 1);
+    assert(NxpPoolCensusData.Pages[NXP_POOL_CENSUS_DOMAIN_SHARED][2].EmptyReuses == 1);
+    assert(NxpPoolCensusData.Pages[NXP_POOL_CENSUS_DOMAIN_SHARED][2].Detaches == 1);
+    assert(NxpPoolCensusData.Pages[NXP_POOL_CENSUS_DOMAIN_SHARED][2].CurrentActive == 1);
