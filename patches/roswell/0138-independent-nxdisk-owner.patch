+ CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_SUCCESS&&r.information==8&&u64(b)==f.disk.config.capacity_bytes&&b[8]==0xa5);return 1;}
+static int routes_bounded_controls(void){fixture f;init(&f);CHECK(start_both(&f));unsigned char b[804];nxd_result r;
+ nxd_io io={.major=NXD_DEVICE_CONTROL,.control_code=NXD_IOCTL_CDROM_CHECK_VERIFY,.buffer=b,.output_bytes=3};
+ CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_INVALID_DEVICE_REQUEST&&!f.forwards);
+ CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_BUFFER_TOO_SMALL&&!f.forwards);
+ io.output_bytes=4;CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_SUCCESS&&f.last_forward==NXD_FORWARD_VERIFY&&r.information==4);
+ io.control_code=NXD_IOCTL_CDROM_READ_TOC;io.output_bytes=803;CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_BUFFER_TOO_SMALL);
+ io.output_bytes=804;CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_SUCCESS&&f.last_forward==NXD_FORWARD_READ_TOC&&r.information==12);
+ io.control_code=NXD_IOCTL_CDROM_GET_GEOMETRY;io.output_bytes=24;
+ CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_SUCCESS&&f.last_forward==NXD_FORWARD_CDROM_GEOMETRY&&r.information==24);
+ io.control_code=NXD_IOCTL_CDROM_READ_TOC_EX;CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_NOT_IMPLEMENTED&&
+  f.last_forward==NXD_FORWARD_READ_TOC_EX&&!r.information);
+ io.control_code=NXD_IOCTL_STORAGE_QUERY_PROPERTY;CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_SUCCESS&&f.last_forward==NXD_FORWARD_PROPERTY&&r.information==8);return 1;}
+static int flush_shutdown_and_seal_are_owned(void){fixture f;init(&f);CHECK(start_both(&f));nxd_result r;
+ nxd_io io={.major=NXD_FLUSH};CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_SUCCESS&&f.submits==1&&!r.information);
+ io.major=NXD_SHUTDOWN;CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_SUCCESS&&f.submits==2);
+ CHECK(nxd_stop_device(&f.disk)==NXD_SUCCESS&&f.seals==1&&f.disk.class_device==(void*)0x100);
+ io.major=NXD_READ;io.length=512;CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_NO_DEVICE&&!r.information);
+ CHECK(nxd_stop_device(&f.disk)==NXD_SUCCESS&&f.seals==1);return 1;}
+static int sealed_device_stays_resident(void){fixture f;init(&f);CHECK(start_both(&f));
+ CHECK(nxd_stop_device(&f.cdrom)==NXD_SUCCESS&&f.seals==1&&f.cdrom.class_device==(void*)0x200);
+ nxd_result r;nxd_io io={.major=NXD_READ,.length=2048};CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_NO_DEVICE);
+ CHECK(nxd_stop_device(&f.cdrom)==NXD_SUCCESS&&f.seals==1&&f.cdrom.lower_device==(void*)0x400);return 1;}
