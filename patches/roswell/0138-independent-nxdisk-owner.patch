+static int registers_owned_disk_and_cdrom(void){fixture f;init(&f);CHECK(nxd_driver_entry(&f.disk_driver,NXD_DISK,&f.port)==NXD_SUCCESS);
+ CHECK(nxd_driver_entry(&f.cdrom_driver,NXD_CDROM,&f.port)==NXD_SUCCESS);CHECK(f.registrations[0]==1&&f.registrations[1]==1);
+ CHECK(nxd_driver_entry(&f.disk_driver,NXD_DISK,&f.port)==NXD_SUCCESS&&f.registrations[0]==1);
+ CHECK(nxd_driver_entry(&f.disk_driver,NXD_CDROM,&f.port)==NXD_INVALID_PARAMETER);return 1;}
+static int creates_namespaces_and_starts(void){fixture f;init(&f);CHECK(start_both(&f));
+ CHECK(f.creates==2);CHECK(f.event_count==4&&!memcmp(f.events,"dcCC",4));return 1;}
+static int unwinds_every_add_failure(void){fixture f;init(&f);f.fail_step=1;
+ CHECK(nxd_driver_entry(&f.cdrom_driver,NXD_CDROM,&f.port)==NXD_SUCCESS);
+ nxd_device_config c=config(NXD_CDROM);
+ CHECK(nxd_add_device(&f.cdrom_driver,&f.cdrom,(void*)0x400,&c)!=NXD_SUCCESS);
+ CHECK(!f.seals&&f.cdrom.state==0);return 1;}
+static int preserves_raw_offsets_and_read_policy(void){fixture f;init(&f);CHECK(start_both(&f));nxd_result r;
+ nxd_io io={.native_request=&f,.major=NXD_READ,.offset=0x123400,.length=512};
+ CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_SUCCESS&&r.information==512&&f.last_io.offset==0x123400);
+ io.offset=(int64_t)f.cdrom.config.capacity_bytes;io.length=4096;
+ CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_SUCCESS&&f.last_io.offset==io.offset);
+ io.offset=1;CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_INVALID_PARAMETER);
+ io.offset=0;io.major=NXD_WRITE;CHECK(nxd_dispatch(&f.cdrom,&io,&r)==NXD_WRITE_PROTECTED);
+ CHECK(f.submits==2);return 1;}
+static int returns_device_number_and_geometry(void){fixture f;init(&f);CHECK(start_both(&f));unsigned char b[40];nxd_result r;
+ memset(b,0xa5,sizeof(b));nxd_io io={.major=NXD_DEVICE_CONTROL,.control_code=NXD_IOCTL_STORAGE_GET_DEVICE_NUMBER,.buffer=b,.output_bytes=11};
+ CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_BUFFER_TOO_SMALL&&!r.information&&b[0]==0xa5);
+ io.output_bytes=12;CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_SUCCESS&&r.information==12);
+ CHECK(u32(b)==7&&!u32(b+4)&&!u32(b+8)&&b[12]==0xa5);
+ memset(b,0xa5,sizeof(b));io.control_code=NXD_IOCTL_DISK_GET_GEOMETRY;io.output_bytes=24;
+ CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_SUCCESS&&r.information==24);
+ CHECK(u64(b)==130&&u32(b+8)==12&&u32(b+12)==255&&u32(b+16)==63&&u32(b+20)==512&&b[24]==0xa5);return 1;}
+static int returns_extended_geometry_and_length(void){fixture f;init(&f);CHECK(start_both(&f));unsigned char b[48];nxd_result r;
+ memset(b,0xa5,sizeof(b));nxd_io io={.major=NXD_DEVICE_CONTROL,.control_code=NXD_IOCTL_DISK_GET_GEOMETRY_EX,.buffer=b,.output_bytes=31};
+ CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_BUFFER_TOO_SMALL&&b[0]==0xa5);
+ io.output_bytes=40;CHECK(nxd_dispatch(&f.disk,&io,&r)==NXD_SUCCESS&&r.information==32);
+ CHECK(u32(b+20)==512&&u64(b+24)==f.disk.config.capacity_bytes&&b[32]==0xa5);
