diff --git a/tests/xbe/gpu-instance/main.c b/tests/xbe/gpu-instance/main.c
new file mode 100644
index 00000000..b1f7b282
--- /dev/null
+++ b/tests/xbe/gpu-instance/main.c
@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Finite public-ABI ownership test. No display initialization or GPU writes:
+ * the guest temporarily owns instance pages, then shuts down via the SMC.
+ */
+#include <xboxkrnl/xboxkrnl.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include "../api-regression/tap.h"
+
+static unsigned number, failures;
+static void check(bool ok, const char *name)
+{
+    ++number;
+    if (ok) tap_ok(number, name);
+    else { tap_not_ok(number, name); ++failures; }
+}
+static ULONG available(void)
+{
+    MM_STATISTICS s = {0};
+    s.Length = sizeof(s);
+    if (MmQueryStatistics(&s) != 0) return UINT32_MAX;
+    return s.AvailablePages;
+}
+static PVOID pin(ULONG pa)
+{
+    return MmAllocateContiguousMemoryEx(4096, pa, pa + 4095, 4096,
+                                        PAGE_READWRITE);
+}
+static bool bytes(const void *p, unsigned char want)
+{
+    const unsigned char *b = p;
+    for (unsigned i = 0; i < 4096; ++i) if (b[i] != want) return false;
+    return true;
+}
+int main(void)
+{
+    SIZE_T padding = 0;
+    ULONG before, free_before_probe, free_after_probe;
+    PVOID idle[4] = {0};
+    PVOID held = NULL, duplicate = NULL, base;
+    tap_puts("== gpu-instance BEGIN schema=1 ==\n");
+    tap_version(14);
+    tap_plan(24);
+    /* Only this standalone guest uses the GPU window; no live title state
+     * is modified, and failure evidence is confined to the disposable VM. */
+    base = MmClaimGpuInstanceMemory(0, &padding);
+    check(base == (PVOID)0x83ff0000, "zero claim returns fixed base");
+    check(padding == 65536, "topology padding remains 64 KiB");
+    held = pin(0x03fed000);
+    check(held == (PVOID)0x83fed000, "exact owner acquired in future growth span");
+    if (held == NULL) goto done;
+    memset(held, 0xa5, 4096);
+    before = available();
+    check(before != UINT32_MAX, "public available-page query succeeds");
+    base = MmClaimGpuInstanceMemory(16384, &padding);
+    check(base == NULL, "unreclaimable owner rejects growth");
+    duplicate = pin(0x03fec000);
+    check(duplicate == (PVOID)0x83fec000,
+          "failed growth leaves unclaimed frame reusable");
+    if (duplicate != NULL) {
+        MmFreeContiguousMemory(duplicate);
+        duplicate = NULL;
+    }
+    check(bytes(held, 0xa5), "failed growth preserves owner bytes");
+    check(MmClaimGpuInstanceMemory(UINT32_MAX, NULL) == (PVOID)0x83ff0000,
+          "query sentinel remains read-only fixed-base operation");
+    check(MmClaimGpuInstanceMemory(0, NULL) == (PVOID)0x83ff0000,
+          "shrink after failure succeeds");
+    duplicate = pin(0x03fed000);
+    check(duplicate == NULL, "shrink cannot make another owner's frame free");
+    if (duplicate != NULL) {
+        /* Do not double-free an alias obtained from a broken reservation. */
+        held = NULL;
+        goto done;
+    }
+    check(bytes(held, 0xa5), "owner canary survives later shrink");
+    /* The failed allocation probe may reclaim unrelated empty slabs. */
+    MmFreeContiguousMemory(held); held = NULL;
+    duplicate = pin(0x03fed000);
+    check(duplicate == (PVOID)0x83fed000,
+          "ordinary owner release makes its frame reusable");
+    if (duplicate != NULL) {
+        MmFreeContiguousMemory(duplicate);
+        duplicate = NULL;
+    }
+    /* Force unrelated slab reclamation so stale global-count baselines
+     * cannot accidentally pass depending on background allocation history. */
+    for (unsigned i = 0; i < 4; ++i) idle[i] = ExAllocatePool(2040);
+    check(idle[0] && idle[1] && idle[2] && idle[3],
+          "slab interference fixture acquires four small objects");
+    if (!idle[0] || !idle[1] || !idle[2] || !idle[3]) goto done;
+    before = available();
+    check(MmClaimGpuInstanceMemory(16384, NULL) == (PVOID)0x83ff0000,
+          "growth succeeds after owner release");
+    check(available() + 4 == before, "successful growth owns all four pages");
+    for (unsigned i = 0; i < 4; ++i) { ExFreePool(idle[i]); idle[i] = NULL; }
+    free_before_probe = available();
+    duplicate = pin(0x03fed000);
+    free_after_probe = available();
+    check(free_after_probe > free_before_probe,
+          "failed exact allocation reclaims unrelated empty slab backing");
+    tap_comment("probe available before=%u after=%u",
+                free_before_probe, free_after_probe);
+    check(duplicate == NULL, "active reservation excludes exact allocations");
+    if (duplicate != NULL) goto done;
+    check(MmClaimGpuInstanceMemory(1, NULL) == (PVOID)0x83ff0000,
+          "one-byte claim rounds to one page");
+    held = pin(0x03fec000);
+    check(held == (PVOID)0x83fec000,
+          "shrink releases the former low edge");
+    if (held != NULL) { MmFreeContiguousMemory(held); held = NULL; }
+    duplicate = pin(0x03fef000);
+    check(duplicate == NULL, "shrink retains the current high-edge claim");
+    if (duplicate != NULL) goto done;
+    check(MmClaimGpuInstanceMemory(UINT32_MAX - 1, NULL) == (PVOID)0x83ff0000,
+          "large non-query request retains capped success contract");
+    duplicate = pin(0x03fe0000);
+    check(duplicate == NULL, "large request owns its low-edge frame");
+    if (duplicate != NULL) goto done;
+    check(MmClaimGpuInstanceMemory(0, NULL) == (PVOID)0x83ff0000,
+          "final zero releases complete reservation");
+    held = pin(0x03fe0000);
+    check(held == (PVOID)0x83fe0000,
+          "final zero makes the former low edge reusable");
+    if (held != NULL) { MmFreeContiguousMemory(held); held = NULL; }
+done:
+    for (unsigned i = 0; i < 4; ++i) if (idle[i]) ExFreePool(idle[i]);
+    if (held != NULL) MmFreeContiguousMemory(held);
+    tap_comment("completed=%u expected=24 failed=%u", number, failures);
+    tap_puts(number == 24 && failures == 0
+             ? "== gpu-instance END schema=1 status=PASS ==\n"
+             : "== gpu-instance END schema=1 status=FAIL ==\n");
+    tap_drain();
+    HalWriteSMBusValue(0x20, 0x02, FALSE, 0x80);
+    for (;;) __asm__ volatile("hlt");
+}
