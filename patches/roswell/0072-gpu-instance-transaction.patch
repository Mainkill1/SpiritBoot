diff --git a/tests/host/gpu-instance/check.py b/tests/host/gpu-instance/check.py
new file mode 100644
index 00000000..f5aec53d
--- /dev/null
+++ b/tests/host/gpu-instance/check.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the actual GPU claim and page-supply bodies against owned PFNs."""
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+
+
+def function(text, name):
+    hit = re.search(r"(?m)^" + name + r"\s*\([^;]*?\)\s*\{", text)
+    assert hit, name
+    start = text.rfind("\n\n", 0, hit.start()) + 2
+    brace = text.index("{", hit.start())
+    depth, end = 1, brace + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end] + "\n"
+
+
+supply = (root / "ntoskrnl/xb/mm/pagesupply.c").read_text()
+contig = (root / "ntoskrnl/xb/mm/contig.c").read_text()
+core = supply[supply.index("#define NXP_FREE"):
+              supply.index("VOID\nNTAPI\nNxkPageSupplyReturn")]
+core += "".join(function(supply, name) for name in (
+    "NxkPageSupplyReturn", "NxkPageSupplySetOwner",
+    "NxkPageSupplyGetOwner", "NxkPageSupplyIsFree",
+    "NxkPageSupplyTakeSpecific", "NxkPageSupplyTakeRun",
+    "NxkPageSupplyTakeAnyOutside"))
+if re.search(r"(?m)^NxpRelocationCapacity\s*\(", supply):
+    core += function(supply, "NxpRelocationCapacity")
+
+shim = r'''
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <assert.h>
+#include <sys/mman.h>
+typedef uint32_t ULONG, *PULONG, PFN_NUMBER, PFN_COUNT, SIZE_T;
+typedef uint16_t USHORT, *PUSHORT;
+typedef uint8_t UCHAR, BOOLEAN, KIRQL;
+typedef uintptr_t ULONG_PTR;
+typedef void VOID, *PVOID;
+#define NTAPI
+#define IN
+#define OUT
+#define TRUE 1
+#define FALSE 0
+#define PAGE_SIZE 4096u
+#define PAGE_SHIFT 12
+#define NXK_KSEG0_BASE 0x80000000u
+#define NXK_KSEG0_RAM_SIZE 0x04000000u
+#define NXK_HIGH_ZONE_BASE 0x03400000u
+#define NXK_HIGH_ZONE_LIMIT 0x03c00000u
+#define NXK_NV2A_HEAP_CEILING 0x03ff0000u
+#define NXK_NV2A_INSTANCE_BYTES 0x10000u
+#define NXK_NV2A_PADDING_BYTES 0x10000u
+#define MAXULONG_PTR UINT32_MAX
+#define NXK_MM_PHYS 1
+#define ASSERT assert
+#define MI_ASSERT_PFN_LOCK_HELD() assert(lockDepth==1)
+#define UNREFERENCED_PARAMETER(x) ((void)(x))
+#define RtlZeroMemory(p,n) memset(p,0,n)
+#define XbDbg(...) ((void)0)
+static int lockDepth;
+static PFN_NUMBER MmAvailablePages;
+static BOOLEAN NxkMmRetailShapedMap(void) { return TRUE; }
+static BOOLEAN NxkMmPersistentPage(PFN_NUMBER p) { (void)p; return FALSE; }
+static PVOID NxkTryGetVerifiedWbDirectAlias(PFN_NUMBER p) { (void)p; return NULL; }
+static void KeZeroPages(PVOID p, SIZE_T n) { memset(p,0,n); }
+static void MiZeroPhysicalPage(PFN_NUMBER p) { assert(p>0); }
+static KIRQL MiAcquirePfnLock(void) { assert(!lockDepth);lockDepth=1;return 0; }
+static void MiReleasePfnLock(KIRQL i) { (void)i;assert(lockDepth==1);lockDepth=0; }
+static void KeInvalidateTlbEntry(PVOID p) { (void)p; }
+'''
+relocation = r'''
+static PVOID NxpRelocationPtes=(PVOID)1;
+static UCHAR frames[0x8000][PAGE_SIZE];
+#define HIGH_LEVEL 31
+#define DPRINT1(...) ((void)0)
+static void KeRaiseIrql(KIRQL level,KIRQL *old) { (void)level;*old=0; }
+static void KeLowerIrql(KIRQL old) { (void)old; }
+static void NxpMapRelocationPages(PFN_NUMBER s,PFN_NUMBER d) { (void)s;(void)d; }
+static void NxpUnmapRelocationPages(void) {}
+/* Only privileged copy/PTE/TLB instructions are replaced. Production
+ * preflight, selection, counters, ownership and claim code run unchanged. */
+#define __asm__
+#define __volatile__(...) do { memcpy(frames[Dest],frames[Page],PAGE_SIZE); *Pte=NewEntry; } while(0)
+'''
+claim = "static SIZE_T NxkNv2aInstanceBytes;\n" + function(contig, "NxMmClaimGpuInstanceMemory")
+main = r'''
+#define TOP 0x3ff0u
+#define PTE(n) (((PULONG)0xc0000000)[0x20+(n)])
+static void require(int ok,const char *m) {
+    if(!ok) {fprintf(stderr,"FAIL: %s\n",m);exit(1);}
+}
+static void reset(void) {
+    static ULONG storage[0xc000];
+    memset(storage,0,sizeof(storage));memset((void*)0xc0000000,0,0x400000);
+    MmAvailablePages=0;NxpFreeHeadKernel=NxpFreeHeadTitle=0;NxpGenericAvail=0;
+    lockDepth=1;NxkPageSupplyInitialize(0x7fff,storage);
+    for(PFN_NUMBER p=TOP-16;p<TOP;p++) NxkPageSupplyReturn(p);
+    lockDepth=0;NxkNv2aInstanceBytes=0;
+}
+static void owned(PFN_NUMBER p,unsigned n,int pinned) {
+    lockDepth=1;require(NxkPageSupplyTakeSpecific(p),"owner acquires free frame");
+    PTE(n)=(p<<12)|3;NxkPageSupplySetOwner(p,(ULONG_PTR)&PTE(n));
+    NxpPins[p]=pinned?1:0;memset(frames[p],0x5a+n,PAGE_SIZE);lockDepth=0;
+}
+static PVOID claim_bytes(SIZE_T n) {
+    SIZE_T padding=0;PVOID p=NxMmClaimGpuInstanceMemory(n,&padding);
+    require(padding==65536,"padding contract remains fixed");
+    require(lockDepth==0,"all API exits release PFN lock");return p;
+}
+static void normal(void) {
+    require(claim_bytes(1)==(PVOID)0x83ff0000,"successful claim fixed base");
+    require(NxkNv2aInstanceBytes==4096&&MmAvailablePages==15,"one-byte claim rounds to one page");
+    require(claim_bytes(UINT32_MAX)==(PVOID)0x83ff0000&&MmAvailablePages==15,"query is read-only");
+    require(claim_bytes(4096)!=NULL&&MmAvailablePages==15,"unchanged claim has no page effect");
+    require(claim_bytes(8193)!=NULL&&NxkNv2aInstanceBytes==12288&&MmAvailablePages==13,"growth acquires every page");
+    require(claim_bytes(4097)!=NULL&&NxkNv2aInstanceBytes==8192&&MmAvailablePages==14,"shrink returns only removed tail page");
+    require(claim_bytes(0)!=NULL&&MmAvailablePages==16,"zero releases complete owned span");
+}
+static void failed(unsigned distance,int existing) {
+    PFN_NUMBER bad=TOP-distance;
+    if(existing) require(claim_bytes(4096)!=NULL,"existing claim succeeds");
+    owned(bad,0,1);PFN_NUMBER before=MmAvailablePages;
+    require(claim_bytes(4*4096)==NULL,"failed acquisition must not report success");
+    require(NxkNv2aInstanceBytes==(existing?4096u:0u)&&MmAvailablePages==before,"failure preserves previous claim/free count");
+    require(PTE(0)==((bad<<12)|3)&&NxpPins[bad]==1,"failure preserves pinned owner");
+    claim_bytes(UINT32_MAX);claim_bytes(0);
+    require(NxpLinks[bad]==((ULONG_PTR)&PTE(0)-0xc0000000u)/4&&NxpPins[bad]==1,"later shrink cannot release failed owner's page");
+}
+static void release_after_failed(void) {
+    owned(TOP-2,0,1);claim_bytes(3*4096);claim_bytes(0);
+    require(NxpLinks[TOP-2]==((ULONG_PTR)&PTE(0)-0xc0000000u)/4&&NxpPins[TOP-2]==1,"shrink must preserve unreclaimed owner's metadata");
+}
+static void capacity(void) {
+    owned(TOP-1,0,0);ULONG old=PTE(0);PFN_NUMBER before=MmAvailablePages;
+    require(claim_bytes(65536)==NULL,"full window fails without an outside relocation frame");
+    require(PTE(0)==old&&MmAvailablePages==before&&NxkNv2aInstanceBytes==0,"capacity failure has no partial relocation/claim");
+}
+static void relocated(void) {
+    owned(TOP-1,0,0);owned(TOP-2,1,0);
+    lockDepth=1;NxkPageSupplyReturn(0x30);NxkPageSupplyReturn(0x31);lockDepth=0;
+    require(claim_bytes(3*4096)!=NULL,"complete span relocates live unpinned pages");
+    require((PTE(0)>>12)<TOP-16&&(PTE(1)>>12)<TOP-16,"relocation destinations lie outside instance window");
+    require((PTE(0)>>12)!=(PTE(1)>>12),"owners receive distinct frames");
+    require(memcmp(frames[TOP-1],frames[PTE(0)>>12],PAGE_SIZE)==0&&memcmp(frames[TOP-2],frames[PTE(1)>>12],PAGE_SIZE)==0,"relocated bytes remain exact");
+    require(MmAvailablePages==13,"claim accounts for every acquired page");
+    claim_bytes(0);require(MmAvailablePages==16,"shrink retains relocated live owners");
+}
+static void large(void) {
+    require(claim_bytes(UINT32_MAX-1)!=NULL,"large non-query request keeps existing capped contract");
+    require(NxkNv2aInstanceBytes==65536&&MmAvailablePages==0,"rounding cannot wrap large claim to zero");
+    claim_bytes(0);require(MmAvailablePages==16,"large claim releases exactly sixteen pages");
+}
+int main(int argc,char **argv) {
+    require(argc==2,"scenario argument");
+    require(mmap((void*)0xc0000000,0x400000,PROT_READ|PROT_WRITE,
+            MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0)==(void*)0xc0000000,"fixture self-map");
+    reset();
+    if(!strcmp(argv[1],"normal")) normal();
+    else if(!strcmp(argv[1],"blocked-first")) failed(1,0);
+    else if(!strcmp(argv[1],"partial-growth")) failed(2,0);
+    else if(!strcmp(argv[1],"existing-claim")) failed(3,1);
+    else if(!strcmp(argv[1],"shrink-failed-owner")) release_after_failed();
+    else if(!strcmp(argv[1],"capacity")) capacity();
+    else if(!strcmp(argv[1],"relocation")) relocated();
+    else if(!strcmp(argv[1],"large-request")) large();
+    else require(0,"unknown scenario");
+    printf("gpu-instance %s PASS\n",argv[1]);return 0;
+}
+'''
+source = out / "gpu-instance.c"
+source.write_text(shim + core + relocation
+                  + function(supply, "NxkPageSupplyTakeRunRelocate") + claim + main)
+failed_cases = []
+for reserved in (0, 1):
+    exe = out / f"gpu-instance-{reserved}"
+    subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror",
+                    "-Wno-unused-function", "-Wno-unused-variable",
+                    "-Wno-unused-but-set-variable", f"-DXBOX_RESERVE_UPPER_RAM={reserved}",
+                    str(source), "-o", str(exe)], check=True)
+    for case in ("normal", "blocked-first", "partial-growth", "existing-claim",
+                 "shrink-failed-owner", "capacity", "relocation", "large-request"):
+        if subprocess.run([str(exe), case]).returncode:
+            failed_cases.append((reserved, case))
+if failed_cases:
+    raise SystemExit(f"gpu-instance failures: {failed_cases}")
+print("gpu-instance: all 16 production claim/page-supply scenarios PASS")
