-/*
- * Match an ASCII name against the caller's UNICODE search pattern.  We
- * support '*' and exact-name only -- that's what titles typically pass for
- * D:\.  Anything more complex degrades to "match all" rather than failing.
- */
+/* Match optical ASCII names using the kernel's Xbox wildcard semantics. */
 static BOOLEAN
 XdvdMatchName(_In_reads_(NameLen) PCSTR Name, _In_ ULONG NameLen,
-                _In_opt_ PUNICODE_STRING Pattern)
-{
-    ULONG i;
+              _In_opt_ PUNICODE_STRING Pattern)
+{
+    WCHAR nameBuffer[255], patternBuffer[255];
+    UNICODE_STRING name, pattern;
+    ULONG i, patternChars;
 
     if (Pattern == NULL || Pattern->Length == 0)
         return TRUE;
 
-    /* "*" -- accept everything. */
-    if (Pattern->Length == sizeof(WCHAR) && Pattern->Buffer[0] == L'*')
-        return TRUE;
-
-    /* Exact ASCII compare against the unicode pattern. */
-    if (Pattern->Length != NameLen * sizeof(WCHAR))
+    if (NameLen > RTL_NUMBER_OF(nameBuffer) ||
+        Pattern->Buffer == NULL ||
+        Pattern->Length > sizeof(patternBuffer) ||
+        Pattern->Length % sizeof(WCHAR) != 0)
         return FALSE;
+
+    /* Fold ASCII only, as in the previous exact-name comparison.  Passing
+     * FALSE avoids allocating an uppercase copy for every directory entry. */
     for (i = 0; i < NameLen; ++i)
     {
-        UCHAR a = (UCHAR)Name[i];
-        WCHAR b = Pattern->Buffer[i];
-        if (a >= 'a' && a <= 'z') a -= ('a' - 'A');
