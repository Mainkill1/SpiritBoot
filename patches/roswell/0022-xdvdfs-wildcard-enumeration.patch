+        WCHAR c = (UCHAR)Name[i];
+        if (c >= L'a' && c <= L'z') c -= (L'a' - L'A');
+        nameBuffer[i] = c;
+    }
+    patternChars = Pattern->Length / sizeof(WCHAR);
+    for (i = 0; i < patternChars; ++i)
+    {
+        WCHAR c = Pattern->Buffer[i];
+        if (c >= L'a' && c <= L'z') c -= (L'a' - L'A');
+        patternBuffer[i] = c;
+    }
+    name.Buffer = nameBuffer;
+    name.Length = name.MaximumLength = NameLen * sizeof(WCHAR);
+    pattern.Buffer = patternBuffer;
