+static int observation_carries_its_exact_epoch(void)
+{
+    nx_lcq_state state; nx_lcq_init(&state,NX_CACHE_PROFILE_ATA);
+    CHECK(publish_full(&state,raw_enabled()));
+    nx_lcq_observation enabled=nx_lcq_observe(&state);
+    CHECK(enabled.snapshot.profile==NX_CACHE_PROFILE_ATA);
+    CHECK(enabled.snapshot.command_sets_known && enabled.snapshot.cache_supported);
+    CHECK(enabled.snapshot.cache_active && enabled.snapshot.selected_flush==0xe7);
+    CHECK(enabled.proof==NX_LCQ_PIO_COUNTED);
+    CHECK(enabled.ticket==atomic_load_explicit((_Atomic uint32_t *)&state.published,
+                                               memory_order_acquire));
+    CHECK(nx_lcq_observation_current(&state,enabled));
+    nx_lcq_revoke(&state);
+    nx_lcq_observation revoked=nx_lcq_observe(&state);
+    CHECK(revoked.ticket!=enabled.ticket);
+    CHECK(revoked.snapshot.profile==NX_CACHE_PROFILE_UNKNOWN);
+    CHECK(revoked.proof==NX_LCQ_UNPROVED);
+    CHECK(!revoked.snapshot.command_sets_known && !revoked.snapshot.cache_active);
+    CHECK(!nx_lcq_observation_current(&state,enabled));
+    CHECK(nx_lcq_observation_current(&state,revoked));
+    return 1;
+}
