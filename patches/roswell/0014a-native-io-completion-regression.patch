+/* Each request owns its IOSB, callback identity and payload independently. */
+struct request {
+    IO_STATUS_BLOCK status;
+    unsigned char bytes[8192];
+    PVOID issuer;
+    HANDLE event;
+    volatile LONG calls, errors;
+};
+static struct request requests[4];
+static HANDLE exit_ready, exit_go;
+static volatile LONG exit_errors;
+
+static void NTAPI queued_completed(DWORD error, DWORD bytes, PVOID overlapped)
+{
+    struct request *r = overlapped;
+    if (error || bytes != sizeof(r->bytes) || KeGetCurrentThread() != r->issuer)
+        InterlockedIncrement(&r->errors);
+    InterlockedIncrement(&r->calls);
+}
+static void NTAPI queued_raw(PVOID context, PIO_STATUS_BLOCK status, ULONG reserved)
+{
+    struct request *r = context;
+    (void)reserved;
+    if (status != &r->status) InterlockedIncrement(&r->errors);
+    queued_completed(NT_SUCCESS(status->Status) ? 0 : 1,
+                     (DWORD)status->Information, r);
+}
+static HANDLE reader_open(void)
+{
+    HANDLE reader = CreateFile("E:\\io-apc-data.bin", GENERIC_READ,
+        FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    regression_require(reader != INVALID_HANDLE_VALUE, "open independent async queue reader");
+    return reader;
+}
+static void request_init(struct request *r)
+{
+    memset(r, 0, sizeof(*r));
+    r->issuer = KeGetCurrentThread();
+    r->status.Status = STATUS_PENDING;
+    regression_require(NtCreateEvent(&r->event, NULL, NotificationEvent, FALSE)
+                       == STATUS_SUCCESS, "create per-request completion event");
+}
+static NTSTATUS request_submit(HANDLE reader, struct request *r, int raw, LONGLONG offset)
+{
+    LARGE_INTEGER position = {.QuadPart = offset};
+    return NtReadFile(reader, r->event,
+        raw ? queued_raw : (PIO_APC_ROUTINE)NtUserIoApcDispatcher,
+        raw ? (PVOID)r : (PVOID)queued_completed, &r->status,
+        r->bytes, sizeof(r->bytes), &position);
+}
+static void queues(void)
+{
+    for (int raw = 0; raw < 2; ++raw) {
+        HANDLE reader = reader_open();
+        for (unsigned n = 0; n < 4; ++n) {
+            request_init(&requests[n]);
+            regression_require(NT_SUCCESS(request_submit(reader, &requests[n], raw, 0)),
+                               "submit distinct IOSB/context with event plus APC");
+        }
+        LARGE_INTEGER timeout = {.QuadPart = -20000000};
+        for (unsigned n = 0; n < 4; ++n) {
+            regression_require(NtWaitForSingleObject(requests[n].event, FALSE, &timeout)
+                               == STATUS_SUCCESS, "completion event signals before alertable delivery");
+            regression_require(requests[n].status.Status == STATUS_SUCCESS &&
+                               requests[n].status.Information == sizeof(source),
+                               "completed IOSB published independently of callback");
+        }
+        for (unsigned n = 0; n < 4; ++n)
+            regression_require(requests[n].calls == (raw ? 1 : 0),
+                               "queued Win32 callbacks remain deferred; raw control delivered");
+        regression_require(SleepEx(100, TRUE) == (raw ? 0 : WAIT_IO_COMPLETION),
+                           "alertable boundary drains completed Win32 queue only");
+        for (unsigned n = 0; n < 4; ++n) {
+            regression_require(requests[n].calls == 1 && !requests[n].errors,
+                               "distinct request callback runs once on its issuer");
+            regression_require(!memcmp(requests[n].bytes, source, sizeof(source)),
+                               "every separately owned queued payload matches");
+            regression_require(NtClose(requests[n].event) == STATUS_SUCCESS,
+                               "close per-request completion event");
+        }
+        regression_require(SleepEx(1, TRUE) == 0, "drained queue has no synthetic extra completion");
+        regression_require(CloseHandle(reader), "close queue reader");
+    }
+    HANDLE reader = reader_open();
+    for (int raw = 0; raw < 2; ++raw) {
+        request_init(&requests[0]);
+        NTSTATUS status = request_submit(reader, &requests[0], raw, sizeof(source) * 2);
+        regression_require(status == (NTSTATUS)STATUS_END_OF_FILE, "past-EOF error returned by async submission");
+        regression_require(SleepEx(1, TRUE) == 0 && !requests[0].calls,
+                           "immediate failed request queues no completion");
+        regression_require(NtClose(requests[0].event) == STATUS_SUCCESS,
+                           "close immediate-error request event");
+    }
+    regression_require(CloseHandle(reader), "close error control reader");
+}
+static void NTAPI exit_worker(PVOID context)
+{
+    int raw = (int)(uintptr_t)context;
+    struct request *r = &requests[0];
+    HANDLE reader = CreateFile("E:\\io-apc-data.bin", GENERIC_READ,
+        FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    memset(r, 0, sizeof(*r));r->issuer = KeGetCurrentThread();r->status.Status = STATUS_PENDING;
+    if (reader == INVALID_HANDLE_VALUE || NtCreateEvent(&r->event, NULL, NotificationEvent, FALSE)
+        != STATUS_SUCCESS) { exit_errors++; NtSetEvent(exit_ready, NULL); return; }
+    LARGE_INTEGER timeout = {.QuadPart = -20000000};
+    if (!NT_SUCCESS(request_submit(reader, r, raw, 0)) ||
+        NtWaitForSingleObject(r->event, FALSE, &timeout) != STATUS_SUCCESS ||
+        r->status.Status != STATUS_SUCCESS || r->status.Information != sizeof(source) ||
+        r->calls != (raw ? 1 : 0) || r->errors || memcmp(r->bytes, source, sizeof(source)))
+        exit_errors++;
+    NtSetEvent(exit_ready, NULL);
+    if (NtWaitForSingleObject(exit_go, FALSE, &timeout) != STATUS_SUCCESS) exit_errors++;
+    NtClose(r->event);CloseHandle(reader);
+    /* Return without any alertable wait: queued Win32 normal callback must
+     * be rundown by thread exit, while raw control already ran normally. */
+}
+static void NTAPI exit_startup(PKSTART_ROUTINE start, PVOID context)
+{
+    start(context);PsTerminateSystemThread(STATUS_SUCCESS);
+}
+static void exits(void)
+{
+    for (unsigned round = 0; round < 4; ++round) for (int raw = 0; raw < 2; ++raw) {
+        exit_errors = 0;
+        regression_require(NtCreateEvent(&exit_ready, NULL, NotificationEvent, FALSE) == STATUS_SUCCESS,
+                           "create issuer exit-ready event");
+        regression_require(NtCreateEvent(&exit_go, NULL, NotificationEvent, FALSE) == STATUS_SUCCESS,
+                           "create controlled issuer exit gate");
+        HANDLE thread = NULL;
+        regression_require(PsCreateSystemThreadEx(&thread, 0, 0, 0, NULL, exit_worker,
+            (PVOID)(uintptr_t)raw, FALSE, FALSE, exit_startup) == STATUS_SUCCESS && thread,
+            "create independent I/O issuer");
+        LARGE_INTEGER timeout = {.QuadPart = -20000000};
+        regression_require(NtWaitForSingleObject(exit_ready, FALSE, &timeout) == STATUS_SUCCESS &&
+            !exit_errors && requests[0].calls == (raw ? 1 : 0),
+            "issuer completed I/O with correct pre-exit callback state");
+        regression_require(NtSetEvent(exit_go, NULL) == STATUS_SUCCESS, "permit issuer exit after verified completion");
+        regression_require(NtWaitForSingleObject(thread, FALSE, &timeout) == STATUS_SUCCESS,
+                           "issuer terminates without alertable delivery");
+        Sleep(1);
+        regression_require(!exit_errors && requests[0].calls == (raw ? 1 : 0),
+                           "no deferred normal callback runs during or after issuer exit");
+        regression_require(NtClose(thread) == STATUS_SUCCESS && NtClose(exit_ready) == STATUS_SUCCESS &&
+            NtClose(exit_go) == STATUS_SUCCESS, "close issuer lifecycle handles");
+    }
