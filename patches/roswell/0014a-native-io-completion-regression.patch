@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define SARCH_XBOX 1
+#define IN
+#define VOID void
+#define NTAPI
+#define _In_
+#define UNREFERENCED_PARAMETER(x) (void)(x)
+#define ASSERT(x) assert(x)
+#define IOTRACE(...) ((void)0)
+#define TRUE 1
+#define FALSE 0
+#define NULL_STATUS ((int32_t)0)
+#define NT_ERROR(s) (((uint32_t)(s) >> 30) == 3)
+#define NT_SUCCESS(s) ((int32_t)(s) >= 0)
+#define STATUS_VERIFY_REQUIRED ((int32_t)0x80000016)
+#define IRP_BUFFERED_IO 1u
+#define IRP_INPUT_OPERATION 2u
+#define IRP_DEALLOCATE_BUFFER 4u
+#define IRP_XB_SG_COMPLETION 8u
+#define IRP_SYNCHRONOUS_API 16u
+#define IRP_OB_QUERY_NAME 32u
+#define IRP_CREATE_OPERATION 64u
+#define IRP_WRITE_OPERATION 128u
+#define IRP_READ_OPERATION 256u
+#define FO_SYNCHRONOUS_IO 1u
+#define IopWriteTransfer 0
+#define IopReadTransfer 1
+#define IopOtherTransfer 2
+#define CONTAINING_RECORD(p,t,m) ((t *)((char *)(p) - offsetof(t,m)))
+#define RtlCopyMemory memcpy
+typedef uint32_t ULONG;
+typedef int32_t LONG;
+typedef int32_t NTSTATUS;
+typedef int BOOLEAN;
+typedef void *PVOID;
+typedef int KPROCESSOR_MODE;
+enum { KernelMode, UserMode, CurrentApcEnvironment = 0 };
+typedef struct { int32_t Status; uintptr_t Information; } IO_STATUS_BLOCK, *PIO_STATUS_BLOCK;
+typedef struct _LIST_ENTRY { struct _LIST_ENTRY *Flink, *Blink; } LIST_ENTRY, *PLIST_ENTRY;
+typedef struct { unsigned signals, refs; } KEVENT, *PKEVENT;
+typedef struct { unsigned Flags, refs; KEVENT Event; int32_t FinalStatus; } FILE_OBJECT, *PFILE_OBJECT;
+typedef struct _MDL { struct _MDL *Next; } MDL, *PMDL;
+typedef void (*PIO_APC_ROUTINE)(PVOID,PIO_STATUS_BLOCK,ULONG);
+typedef void (*PKNORMAL_ROUTINE)(PVOID,PVOID,PVOID);
+struct _KAPC;
+typedef void (*PKKERNEL_ROUTINE)(struct _KAPC *,PKNORMAL_ROUTINE *,PVOID *,PVOID *,PVOID *);
+typedef void (*PKRUNDOWN_ROUTINE)(struct _KAPC *);
+typedef struct _THREAD {
+    struct { LIST_ENTRY ApcListHead[2]; BOOLEAN UserApcPending; } ApcState;
+} THREAD, *PKTHREAD;
+typedef struct _KAPC {
+    LIST_ENTRY ApcListEntry;
+    PKTHREAD thread;
+    PKNORMAL_ROUTINE NormalRoutine;
+    PKKERNEL_ROUTINE KernelRoutine;
+    PKRUNDOWN_ROUTINE RundownRoutine;
+    PVOID NormalContext, SystemArgument1, SystemArgument2;
+    int mode, Inserted;
+} KAPC, *PKAPC;
+typedef struct {
+    unsigned Flags;
+    PMDL MdlAddress;
+    struct { PVOID SystemBuffer; } AssociatedIrp;
+    PVOID UserBuffer;
+    IO_STATUS_BLOCK IoStatus;
+    PIO_STATUS_BLOCK UserIosb;
+    PKEVENT UserEvent;
+    BOOLEAN PendingReturned;
+    KPROCESSOR_MODE RequestorMode;
+    struct { struct { PIO_APC_ROUTINE UserApcRoutine; PVOID UserApcContext; } AsynchronousParameters; } Overlay;
+    struct { KAPC Apc; } Tail;
+    int unqueued;
+} IRP, *PIRP;
+typedef int KLOCK_QUEUE_HANDLE;
+static THREAD issuer, other;
+static PKTHREAD current = &issuer;
+static unsigned allocated, freed, callbacks, mdls_freed, buffers_freed, case_count;
+static IO_STATUS_BLOCK expected[8];
+static unsigned expected_index, expected_count;
+static int exiting;
+static void init_list(PLIST_ENTRY l) { l->Flink = l->Blink = l; }
+static int IsListEmpty(PLIST_ENTRY l) { return l->Flink == l; }
+static void RemoveEntryList(PLIST_ENTRY l) { l->Blink->Flink=l->Flink; l->Flink->Blink=l->Blink; }
+static void append(PLIST_ENTRY head, PLIST_ENTRY l) {
+    l->Flink=head; l->Blink=head->Blink; head->Blink->Flink=l; head->Blink=l;
+}
+static PKTHREAD KeGetCurrentThread(void) { return current; }
+static void KiSetCurrentThreadUserApcPending(void) { current->ApcState.UserApcPending=1; }
+static void KiAcquireApcLockRaiseToDpc(PKTHREAD t,KLOCK_QUEUE_HANDLE *l) { assert(t==current); *l=1; }
+static void KiReleaseApcLock(KLOCK_QUEUE_HANDLE *l) { assert(*l); }
+static ULONG RtlNtStatusToDosError(int32_t status) { return (ULONG)status ^ 0x1357u; }
+static void IoFreeIrp(PIRP irp) { ++freed; assert(freed<=allocated); free(irp); }
+static void IoFreeMdl(PMDL m) { mdls_freed++; free(m); }
+static void ExFreePool(PVOID p) { buffers_freed++; free(p); }
+static void KeSetEvent(PKEVENT e,int boost,int wait) { (void)boost;(void)wait;e->signals++; }
+static PKEVENT referenced_event;
+static void dereference_event(PVOID p) {
+    assert(p==referenced_event && referenced_event->refs==1); referenced_event->refs--;
+}
+#define ObDereferenceObject dereference_event
+static void ObDereferenceObjectDeferDelete(PFILE_OBJECT f) { assert(f->refs==1); f->refs--; }
+static int IsIrpSynchronous(PIRP i,PFILE_OBJECT f) { return (i->Flags&IRP_SYNCHRONOUS_API)||(f&&(f->Flags&FO_SYNCHRONOUS_IO)); }
+static void IopUpdateTransferCount(int kind,ULONG bytes) { assert(kind<=2); (void)bytes; }
+static void IopUnQueueIrpFromThread(PIRP i) { assert(!i->unqueued); i->unqueued=1; }
+static void KeInitializeApc(PKAPC a,PKTHREAD t,int env,PKKERNEL_ROUTINE k,
+                            PKRUNDOWN_ROUTINE r,PKNORMAL_ROUTINE n,int mode,PVOID context) {
+    assert(CONTAINING_RECORD(a,IRP,Tail.Apc)->unqueued);
+    (void)env; a->thread=t; a->KernelRoutine=k; a->RundownRoutine=r;
+    a->NormalRoutine=n; a->mode=mode; a->NormalContext=context;
+}
+static void deliver_kernel(PKAPC a) {
+    PKNORMAL_ROUTINE n=a->NormalRoutine; PVOID c=a->NormalContext;
+    PVOID x=a->SystemArgument1,y=a->SystemArgument2;
+    PKKERNEL_ROUTINE k=a->KernelRoutine; a->Inserted=0;
+    k(a,&n,&c,&x,&y); if(n)n(c,x,y);
+}
+static int KeInsertQueueApc(PKAPC a,PVOID x,PVOID y,int boost) {
+    (void)boost; assert(a->thread==current); a->SystemArgument1=x;a->SystemArgument2=y;a->Inserted=1;
+    if(a->mode==KernelMode) deliver_kernel(a);
+    else {append(&a->thread->ApcState.ApcListHead[UserMode],&a->ApcListEntry);a->thread->ApcState.UserApcPending=1;}
+    return 1;
+}
+/* PRODUCTION_BODIES */
+static void win_completed(ULONG error,ULONG bytes,PVOID context) {
+    assert(!exiting && current==&issuer && expected_index<expected_count);
+    PIO_STATUS_BLOCK s=&expected[expected_index++]; assert(context==s);
+    assert(error==(NT_SUCCESS(s->Status)?0:RtlNtStatusToDosError(s->Status)));
+    assert(bytes==(NT_SUCCESS(s->Status)?s->Information:0)); callbacks++;
+}
+static void raw_completed(PVOID context,PIO_STATUS_BLOCK s,ULONG reserved) {
+    (void)context; (void)reserved;
+    assert(!exiting && current==&issuer && s==&expected[expected_index++]); callbacks++;
+}
+static void reset(void) {
+    assert(allocated==freed); memset(&issuer,0,sizeof(issuer)); memset(&other,0,sizeof(other));
+    for(unsigned i=0;i<2;i++){init_list(&issuer.ApcState.ApcListHead[i]);init_list(&other.ApcState.ApcListHead[i]);}
+    current=&issuer; callbacks=expected_index=0; exiting=0; referenced_event=NULL;
+}
+static void complete(unsigned slot,int dispatcher,int request_mode,int32_t status,int pending,
+                     PFILE_OBJECT file,PKEVENT event,int buffered) {
+    PIRP i=calloc(1,sizeof(*i)); assert(i); allocated++;
+    i->RequestorMode=request_mode; i->IoStatus.Status=status; i->IoStatus.Information=NT_SUCCESS(status)?8:0;
+    expected[slot].Status=(int32_t)0x103;expected[slot].Information=0;i->UserIosb=&expected[slot];
+    i->PendingReturned=pending; i->Flags=IRP_READ_OPERATION; i->UserEvent=event;
+    i->Overlay.AsynchronousParameters.UserApcRoutine=dispatcher?(PIO_APC_ROUTINE)NtUserIoApcDispatcher:raw_completed;
+    i->Overlay.AsynchronousParameters.UserApcContext=dispatcher?(PVOID)win_completed:NULL;
+    unsigned char output[8]={0}; i->UserBuffer=output;
+    if(buffered){i->Flags|=IRP_BUFFERED_IO|IRP_INPUT_OPERATION|IRP_DEALLOCATE_BUFFER;
+        i->AssociatedIrp.SystemBuffer=malloc(8);assert(i->AssociatedIrp.SystemBuffer);memset(i->AssociatedIrp.SystemBuffer,0x5a,8);
+        i->MdlAddress=calloc(1,sizeof(MDL));i->MdlAddress->Next=calloc(1,sizeof(MDL));assert(i->MdlAddress->Next);}
+    KAPC *a=&i->Tail.Apc; PKNORMAL_ROUTINE n=NULL;PVOID c=NULL,f=file,extra=NULL;
+    IopCompleteRequest(a,&n,&c,&f,&extra);
+    if(buffered&&NT_SUCCESS(status))for(unsigned k=0;k<8;k++)assert(output[k]==0x5a);
+    if(NT_ERROR(status)&&!pending){assert(IsListEmpty(&issuer.ApcState.ApcListHead[UserMode]));return;}
+    assert(expected[slot].Status==status && expected[slot].Information==(NT_SUCCESS(status)?8:0));
+    if(dispatcher || request_mode==UserMode){
+        assert(!IsListEmpty(&issuer.ApcState.ApcListHead[UserMode]));
+        PKAPC queued=CONTAINING_RECORD(issuer.ApcState.ApcListHead[UserMode].Blink,KAPC,ApcListEntry);
+        assert(queued->mode==UserMode && CONTAINING_RECORD(queued,IRP,Tail.Apc)->RequestorMode==request_mode);
+    }
+}
+static void rundown(void) {
+    PLIST_ENTRY h=&issuer.ApcState.ApcListHead[UserMode];exiting=1;
+    while(!IsListEmpty(h)){PKAPC a=CONTAINING_RECORD(h->Flink,KAPC,ApcListEntry);RemoveEntryList(&a->ApcListEntry);
+        PKRUNDOWN_ROUTINE r=a->RundownRoutine;a->Inserted=0;r(a);}
+}
+int main(void) {
+    const int32_t statuses[]={0,(int32_t)0xc0000011,(int32_t)0xc0000120};
+    for(int dispatcher=0;dispatcher<2;dispatcher++)for(int mode=0;mode<2;mode++)
+    for(unsigned s=0;s<3;s++)for(int event_on=0;event_on<2;event_on++)for(int buffered=0;buffered<2;buffered++){
+        reset();expected_count=1;FILE_OBJECT f={.refs=1};KEVENT e={.refs=1};referenced_event=&e;
+        unsigned before=freed;
+        complete(0,dispatcher,mode,statuses[s],1,&f,event_on?&e:NULL,buffered);
+        assert(!f.refs && (event_on?e.signals==1&&e.refs==0:f.Event.signals==1));
+        if(dispatcher||mode==UserMode){assert(!callbacks&&freed==before);KiDeliverUserApcs();}
+        assert(callbacks==1&&expected_index==1&&allocated==freed);
+        KiDeliverUserApcs();assert(callbacks==1);case_count++;
+    }
+    for(unsigned count=2;count<=8;count++)for(int aborting=0;aborting<2;aborting++){
+        reset();expected_count=count;
+        for(unsigned n=0;n<count;n++){FILE_OBJECT f={.refs=1};complete(n,1,KernelMode,0,1,&f,NULL,0);}
+        assert(callbacks==0 && allocated-freed==count);
+        if(aborting){rundown();assert(!callbacks);}else{KiDeliverUserApcs();assert(callbacks==count&&expected_index==count);}
+        assert(allocated==freed);KiDeliverUserApcs();assert(callbacks==(aborting?0:count));case_count++;
+    }
+    reset();expected_count=1;FILE_OBJECT f={.refs=1};complete(0,1,KernelMode,(int32_t)0xc0000011,0,&f,NULL,0);
+    assert(!callbacks&&allocated==freed);case_count++;
+    printf("io APC production completion/delivery/rundown: %u cases PASS, %u IRPs freed exactly once, %u MDLs and %u buffers freed\n",case_count,freed,mdls_freed,buffers_freed);
+}
