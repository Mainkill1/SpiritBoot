diff --git a/tests/host/io-apc-order/check.py b/tests/host/io-apc-order/check.py
new file mode 100644
index 00000000..6792d7fa
--- /dev/null
+++ b/tests/host/io-apc-order/check.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Run actual completion, trampoline, delivery and rundown bodies with OS shims.
+
+The dispatcher/allocator are modeled. This tests production control flow and
+lifetime ordering, not a native in-flight NtReadFile scheduling boundary.
+"""
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(sys.argv[2]).resolve() if len(sys.argv) > 2 else Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+
+def function(path, signature):
+    source = (root / path).read_text()
+    start = source.index(signature)
+    brace = source.index('{', start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end] + '\n'
+
+bodies = ''.join([
+    function('ntoskrnl/xb/xbe.c', 'VOID NTAPI NtUserIoApcDispatcher('),
+    function('ntoskrnl/io/iomgr/irp.c', 'VOID\nNTAPI\nIopFreeIrpKernelApc('),
+    function('ntoskrnl/io/iomgr/irp.c', 'VOID\nNTAPI\nIopAbortIrpKernelApc('),
+    function('ntoskrnl/io/iomgr/irp.c', 'VOID\nNTAPI\nIopCompleteRequest('),
+    function('ntoskrnl/ke/apc.c', 'VOID\nNTAPI\nKiDeliverUserApcs('),
+])
+source = Path(__file__).with_name('fixture.c').read_text()
+source = source.replace('/* PRODUCTION_BODIES */', bodies)
+(out / 'io-apc.c').write_text(source)
+subprocess.run(['cc', '-std=c11', '-O2', '-g', '-fsanitize=address,undefined',
+                '-fno-omit-frame-pointer', '-Wall', '-Wextra', '-Werror',
+                '-Wno-unused-parameter', '-Wno-unused-function', '-Wno-cast-function-type',
+                str(out / 'io-apc.c'), '-o', str(out / 'io-apc')], check=True)
+subprocess.run([str(out / 'io-apc')], check=True)
