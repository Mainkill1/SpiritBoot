Subject: [PATCH] FATX: bound on-disk name conversion

---
 drivers/filesystems/vfatfs/direntry.c |  26 +++++-
 drivers/filesystems/vfatfs/fsctl.c    |   9 +-
 drivers/filesystems/vfatfs/vfat.h     |   5 ++
 tests/host/fatx/check-name-bounds.py  | 122 ++++++++++++++++++++++++++
 4 files changed, 154 insertions(+), 8 deletions(-)
 create mode 100644 tests/host/fatx/check-name-bounds.py

diff --git a/drivers/filesystems/vfatfs/direntry.c b/drivers/filesystems/vfatfs/direntry.c
index c2d210b9..cde44476 100644
--- a/drivers/filesystems/vfatfs/direntry.c
+++ b/drivers/filesystems/vfatfs/direntry.c
@@ -477,6 +477,23 @@ FATGetNextDirEntry(
 }
 #endif /* !SARCH_XBOX */
 
+NTSTATUS
+VfatFatXNameToUnicode(
+    IN const FATX_DIR_ENTRY *DirEntry,
+    OUT PUNICODE_STRING Name)
+{
+    OEM_STRING StringO;
+
+    if (DirEntry->FilenameLength > sizeof(DirEntry->Filename))
+    {
+        return STATUS_FILE_CORRUPT_ERROR;
+    }
+
+    StringO.Buffer = (PCHAR)DirEntry->Filename;
+    StringO.Length = StringO.MaximumLength = DirEntry->FilenameLength;
+    return RtlOemStringToUnicodeString(Name, &StringO, FALSE);
+}
+
 NTSTATUS
 FATXGetNextDirEntry(
     PVOID *pContext,
@@ -487,7 +504,6 @@ FATXGetNextDirEntry(
 {
     LARGE_INTEGER FileOffset;
     PFATX_DIR_ENTRY fatxDirEntry;
-    OEM_STRING StringO;
     ULONG DirIndex = DirContext->DirIndex;
     NTSTATUS Status;
 
@@ -611,9 +627,11 @@ FATXGetNextDirEntry(
             fatxDirEntry++;
         }
     }
-    StringO.Buffer = (PCHAR)fatxDirEntry->Filename;
-    StringO.Length = StringO.MaximumLength = fatxDirEntry->FilenameLength;
-    RtlOemStringToUnicodeString(&DirContext->LongNameU, &StringO, FALSE);
+    Status = VfatFatXNameToUnicode(fatxDirEntry, &DirContext->LongNameU);
+    if (!NT_SUCCESS(Status))
+    {
+        return Status;
+    }
     DirContext->ShortNameU = DirContext->LongNameU;
     return STATUS_SUCCESS;
 }
