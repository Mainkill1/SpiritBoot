diff --git a/tests/host/fatx/check-name-bounds.py b/tests/host/fatx/check-name-bounds.py
new file mode 100644
index 00000000..d23afea2
--- /dev/null
+++ b/tests/host/fatx/check-name-bounds.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production FATX name conversion boundary."""
+
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+
+spec = importlib.util.spec_from_file_location(
+    "extract", root / "tests/host/kernel-performance/check.py")
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+
+source = (root / "drivers/filesystems/vfatfs/direntry.c").read_text()
+body = extract.function(source, "VfatFatXNameToUnicode")
+
+shim = r'''
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define IN
+#define OUT
+typedef int32_t NTSTATUS;
+typedef uint16_t USHORT;
+typedef char *PCHAR;
+typedef struct {
+    unsigned char FilenameLength;
+    unsigned char Attrib;
+    unsigned char Filename[42];
+    unsigned char Rest[20];
+} FATX_DIR_ENTRY, *PFATX_DIR_ENTRY;
+typedef struct {
+    USHORT Length;
+    USHORT MaximumLength;
+    char *Buffer;
+} OEM_STRING;
+typedef struct {
+    USHORT Length;
+    USHORT MaximumLength;
+    uint16_t *Buffer;
+} UNICODE_STRING, *PUNICODE_STRING;
+
+#define STATUS_SUCCESS 0
+#define STATUS_FILE_CORRUPT_ERROR ((NTSTATUS)0xc0000102)
+#define FALSE 0
+
+static unsigned conversions;
+static NTSTATUS RtlOemStringToUnicodeString(PUNICODE_STRING output,
+                                             const OEM_STRING *input,
+                                             int allocate)
+{
+    (void)allocate;
+    ++conversions;
+    if (input->Length > output->MaximumLength / sizeof(uint16_t))
+        return (NTSTATUS)0xc0000023;
+    for (USHORT i = 0; i < input->Length; ++i)
+        output->Buffer[i] = (unsigned char)input->Buffer[i];
+    output->Length = input->Length * sizeof(uint16_t);
+    return STATUS_SUCCESS;
+}
+'''
+
+cases = r'''
+static int checks;
+static int failures;
+static void check(int condition, const char *label)
+{
+    ++checks;
+    if (!condition) {
+        ++failures;
+        fprintf(stderr, "FAIL: %s\n", label);
+    }
+}
+
+int main(void)
+{
+    FATX_DIR_ENTRY entry = {0};
+    uint16_t output[64] = {0};
+    UNICODE_STRING name = {0, sizeof(output), output};
+    NTSTATUS status;
+
+    memset(entry.Filename, 'A', sizeof(entry.Filename));
+    entry.FilenameLength = 42;
+    conversions = 0;
+    status = VfatFatXNameToUnicode(&entry, &name);
+    check(status == STATUS_SUCCESS && conversions == 1 && name.Length == 84,
+          "maximum physical FATX name converts");
+
+    entry.FilenameLength = 43;
+    name.Length = 0;
+    conversions = 0;
+    status = VfatFatXNameToUnicode(&entry, &name);
+    check(status == STATUS_FILE_CORRUPT_ERROR && conversions == 0 &&
+          name.Length == 0,
+          "oversized on-disk name is rejected before conversion");
+
+    entry.FilenameLength = 255;
+    status = VfatFatXNameToUnicode(&entry, &name);
+    check(status == STATUS_FILE_CORRUPT_ERROR && conversions == 0,
+          "end marker cannot become a conversion length");
+
+    printf("FATX name boundary: %d checks, %d failures\n", checks, failures);
+    return failures != 0;
+}
+'''
+
+fixture = out / "name-bounds.c"
+fixture.write_text(shim + body + cases)
+subprocess.run([
+    "cc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
+    "-fsanitize=address,undefined", str(fixture), "-o", str(out / "name-bounds")
+], check=True)
+subprocess.run([str(out / "name-bounds")], check=True,
+               env={**os.environ, "ASAN_OPTIONS": "detect_leaks=0"})
