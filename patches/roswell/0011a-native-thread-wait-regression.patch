+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "../regression.h"
+#include <stdint.h>
+#include <string.h>
+
+static HANDLE events[64];
+static volatile struct {
+    uintptr_t native_thread;
+    unsigned count, kind;
+    NTSTATUS status;
+    ULONGLONG elapsed;
+    LONG done, apc_calls, calls_at_return;
+} trial;
+
+static void sleep_ms(unsigned ms)
+{
+    LARGE_INTEGER delay = { .QuadPart = -(LONGLONG)ms * 10000 };
+    KeDelayExecutionThread(KernelMode, FALSE, &delay);
+}
+
+static void NTAPI apc(PVOID a, PVOID b, PVOID c)
+{
+    (void)a; (void)b; (void)c;
+    InterlockedIncrement(&trial.apc_calls);
+}
+
+static void NTAPI worker(PVOID argument)
+{
+    uintptr_t thread;
+    (void)argument;
+    /* The public ordinal returns an Xbox shadow. The tested build's native
+     * offsets let this regression observe actual dispatcher suspension.
+     */
+    __asm__ __volatile__("movl %%fs:%c1,%0" : "=r"(thread)
+                         : "i"(NATIVE_PCR_THREAD_OFFSET));
+    trial.native_thread = thread;
+    LARGE_INTEGER timeout = { .QuadPart = trial.kind == 2 ? -2000000 : -20000000 };
+    ULONGLONG start = KeQueryInterruptTime();
+    trial.status = NtWaitForMultipleObjectsEx(trial.count, events,
+        trial.kind == 1 ? WaitAll : WaitAny,
+        trial.kind == 3 ? UserMode : KernelMode, trial.kind == 3, &timeout);
+    trial.elapsed = KeQueryInterruptTime() - start;
+    trial.calls_at_return = trial.apc_calls;
+    InterlockedExchange(&trial.done, 1);
+}
+
+static void NTAPI startup(PKSTART_ROUTINE start, PVOID context)
+{
+    start(context);
+    PsTerminateSystemThread(STATUS_SUCCESS);
+}
+
+static int is_blocked(void)
+{
+    uintptr_t thread = trial.native_thread;
+    return thread && !trial.done &&
+        *(volatile unsigned char *)(thread + NATIVE_THREAD_STATE_OFFSET) == NATIVE_WAITING;
+}
+
+static void blocking_trial(unsigned count, unsigned kind)
+{
+    HANDLE thread = NULL;
+    memset((void *)&trial, 0, sizeof(trial));
+    trial.count = count; trial.kind = kind;
+    int cleared = 1;
+    for (unsigned i = 0; i < count; ++i)
+        cleared &= NtClearEvent(events[i]) == STATUS_SUCCESS;
+    regression_require(cleared, "clear every event before blocking trial");
+    NTSTATUS status = PsCreateSystemThreadEx(&thread, 0, 0, 0, NULL, worker, NULL,
+                                            FALSE, FALSE, startup);
+    regression_require(status == STATUS_SUCCESS && thread, "create wait worker");
+    int blocked = 0;
+    /* A state handshake before signaling or queueing, not a presumed delay. */
+    for (unsigned i = 0; i < 100 && !trial.done; ++i) {
+        if (is_blocked()) { blocked = 1; break; }
+        sleep_ms(1);
+    }
+    regression_require(blocked, "worker is in native Waiting before completion action");
+    if (kind == 0) {
+        regression_require(NtSetEvent(events[count - 1], NULL) == STATUS_SUCCESS,
+                           "release delayed WaitAny through last event");
+    } else if (kind == 1) {
+        int signaled = 1;
+        for (unsigned i = 0; i + 1 < count; ++i)
+            signaled &= NtSetEvent(events[i], NULL) == STATUS_SUCCESS;
+        regression_require(signaled, "signal all except final WaitAll event");
+        sleep_ms(10);
+        regression_require(is_blocked(), "WaitAll remains blocked with final event unset");
+        regression_require(NtSetEvent(events[count - 1], NULL) == STATUS_SUCCESS,
+                           "release delayed WaitAll through final event");
+    } else if (kind == 3) {
+        regression_require(NtQueueApcThread(thread, apc, NULL, NULL, NULL) == STATUS_SUCCESS,
+                           "queue APC to blocked alertable UserMode waiter");
+    }
+    LARGE_INTEGER timeout = { .QuadPart = -30000000 };
+    regression_require(NtWaitForSingleObject(thread, FALSE, &timeout) == STATUS_SUCCESS,
+                       "wait worker joins within finite deadline");
+    NTSTATUS expected = kind == 0 ? (NTSTATUS)(STATUS_WAIT_0 + count - 1) :
+        kind == 1 ? STATUS_SUCCESS : kind == 2 ? STATUS_TIMEOUT : STATUS_USER_APC;
+    tap_comment("WAIT count=%u kind=%u status=%08x elapsed_100ns=%llu apcs=%ld",
+        count, kind, (unsigned)trial.status, trial.elapsed, (long)trial.apc_calls);
+    regression_require(trial.done && trial.status == expected, "blocking wait returns expected status");
+    if (kind == 2)
+        regression_require(trial.elapsed >= 2000000, "finite timeout waits its nonzero interval");
+    if (kind == 3)
+        regression_require(trial.apc_calls == 1 && trial.calls_at_return == 1,
+                           "APC runs exactly once before alertable wait returns");
+    regression_require(NtClose(thread) == STATUS_SUCCESS, "close joined wait-worker handle");
+}
+
+static void immediate(unsigned count)
+{
+    LARGE_INTEGER zero = { .QuadPart = 0 };
+    for (unsigned i = 0; i < count; ++i)
+        regression_require(NtClearEvent(events[i]) == STATUS_SUCCESS, "clear poll event");
+    regression_require(NtSetEvent(events[count - 1], NULL) == STATUS_SUCCESS, "signal final poll event");
+    regression_require(NtWaitForMultipleObjectsEx(count, events, WaitAny, KernelMode, FALSE, &zero)
+                       == (NTSTATUS)(STATUS_WAIT_0 + count - 1), "immediate WaitAny returns final index");
+    for (unsigned i = 0; i < count; ++i)
+        regression_require(NtSetEvent(events[i], NULL) == STATUS_SUCCESS, "signal WaitAll poll event");
+    regression_require(NtWaitForMultipleObjectsEx(count, events, WaitAll, KernelMode, FALSE, &zero)
+                       == STATUS_SUCCESS, "immediate WaitAll succeeds");
+    for (unsigned i = 0; i < count; ++i)
+        regression_require(NtClearEvent(events[i]) == STATUS_SUCCESS, "clear timeout poll event");
+    regression_require(NtWaitForMultipleObjectsEx(count, events, WaitAny, KernelMode, FALSE, &zero)
+                       == STATUS_TIMEOUT, "immediate unsignaled poll times out");
+}
+
+static int statistics(MM_STATISTICS *mm, PS_STATISTICS *ps)
+{
+    memset(mm, 0, sizeof(*mm)); mm->Length = sizeof(*mm);
+    memset(ps, 0, sizeof(*ps)); ps->Length = sizeof(*ps);
+    return MmQueryStatistics(mm) == STATUS_SUCCESS && PsQueryStatistics(ps) == STATUS_SUCCESS;
+}
+
+int main(void)
+{
+    static const unsigned poll_counts[] = {3, 4, 5, 64};
+    static const unsigned blocking_counts[] = {3, 4, 64};
+    regression_begin();
+    for (unsigned i = 0; i < 64; ++i)
+        regression_require(NtCreateEvent(&events[i], NULL, NotificationEvent, FALSE) == STATUS_SUCCESS,
+                           "create distinct wait event");
+    for (unsigned i = 0; i < 4; ++i) immediate(poll_counts[i]);
+    /* Warm dispatcher, stack and pool caches before bounded churn. */
+    for (unsigned i = 0; i < 3; ++i)
+        for (unsigned k = 0; k < 4; ++k) blocking_trial(blocking_counts[i], k);
+    sleep_ms(100);
+    MM_STATISTICS before, after; PS_STATISTICS ps_before, ps_after;
+    regression_require(statistics(&before, &ps_before), "query warmed accounting");
+    for (unsigned round = 0; round < 3; ++round)
+        for (unsigned i = 0; i < 3; ++i)
+            for (unsigned k = 0; k < 4; ++k) blocking_trial(blocking_counts[i], k);
+    int settled = 0;
+    for (unsigned i = 0; i < 50; ++i) {
+        sleep_ms(100);
+        if (!statistics(&after, &ps_after)) break;
+        if (ps_after.HandleCount == ps_before.HandleCount &&
+            ps_after.ThreadCount == ps_before.ThreadCount &&
+            after.StackPagesCommitted <= before.StackPagesCommitted &&
+            after.PoolPagesCommitted <= before.PoolPagesCommitted) { settled = 1; break; }
+    }
+    tap_comment("WAIT-CLEANUP pool=%lu/%lu stack=%lu/%lu threads=%lu/%lu handles=%lu/%lu",
+        (unsigned long)before.PoolPagesCommitted, (unsigned long)after.PoolPagesCommitted,
+        (unsigned long)before.StackPagesCommitted, (unsigned long)after.StackPagesCommitted,
+        (unsigned long)ps_before.ThreadCount, (unsigned long)ps_after.ThreadCount,
+        (unsigned long)ps_before.HandleCount, (unsigned long)ps_after.HandleCount);
+    regression_require(settled, "repeated waits restore warmed pool, stack, thread and handle accounting");
+    for (unsigned i = 0; i < 64; ++i)
+        regression_require(NtClose(events[i]) == STATUS_SUCCESS, "close wait event");
+    regression_finish();
 }
