+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Execute the production adapter with injected reference/allocator failures.
+
+The real dispatcher and suspension lifetime are covered by the native guest.
+This fixture extracts the maintained function rather than copying its policy.
+"""
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+source = (root / 'ntoskrnl/ob/obwait.c').read_text()
+start = source.index('NTSTATUS\nNTAPI\nNxkWaitForMultipleObjectsMode(')
+end = source.index('\n}\n', start) + 3
+preamble = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#define IN
+#define OPTIONAL
+#define NTAPI
+#define MAXIMUM_WAIT_OBJECTS 64
+#define THREAD_WAIT_OBJECTS 3
+#define SYNCHRONIZE 0x100000
+#define NonPagedPool 0
+#define TAG_WAIT 0x57414954
+#define STATUS_INVALID_PARAMETER ((int32_t)0xc000000d)
+#define STATUS_INSUFFICIENT_RESOURCES ((int32_t)0xc000009a)
+#define STATUS_INVALID_HANDLE ((int32_t)0xc0000008)
+#define NT_SUCCESS(s) ((s)>=0)
+typedef int32_t NTSTATUS;
+typedef uint32_t ULONG;
+typedef uintptr_t ULONG_PTR;
+typedef void *PVOID, *HANDLE;
+typedef HANDLE *PHANDLE;
+typedef unsigned char BOOLEAN;
+typedef enum {WaitAll,WaitAny} WAIT_TYPE;
+typedef enum {KernelMode,UserMode} KPROCESSOR_MODE;
+enum {UserRequest=6};
+typedef int64_t *PLARGE_INTEGER;
+typedef struct {uintptr_t words[6];} KWAIT_BLOCK, *PKWAIT_BLOCK;
+typedef struct {PVOID DefaultObject;} TYPE;
+typedef struct {TYPE *Type;} HEADER;
+typedef struct {HEADER header; uintptr_t waitable; unsigned refs;} OBJECT;
+static OBJECT objects[64];
+static TYPE types[64];
+#define OBJECT_TO_OBJECT_HEADER(p) (&((OBJECT *)(p))->header)
+#define IsPointerOffset(p) ((uintptr_t)(p)<4096)
+static unsigned ref_calls,alloc_calls,free_calls,dispatch_calls,live;
+static int fail_index,fail_alloc;
+static ULONG expected_count;
+static WAIT_TYPE expected_type;
+static KPROCESSOR_MODE expected_mode;
+static BOOLEAN expected_alertable;
+static PLARGE_INTEGER expected_timeout;
+static NTSTATUS dispatch_status;
+static NTSTATUS ObReferenceObjectByHandle(HANDLE h,ULONG access,PVOID type,
+ KPROCESSOR_MODE mode,PVOID *result,PVOID info)
+{
+ unsigned i=ref_calls++;
+ assert(access==SYNCHRONIZE&&type==NULL&&mode==KernelMode&&info==NULL);
+ if ((int)i==fail_index) return STATUS_INVALID_HANDLE;
+ assert(h==&objects[i]);objects[i].refs++;*result=h;return 0;
+}
+static void ObDereferenceObject(PVOID p)
+{
+ OBJECT *object=p;assert(object->refs==1);object->refs--;
+}
+static __attribute__((unused)) PVOID ExAllocatePoolWithTag(int pool,size_t size,int tag)
+{
+ alloc_calls++;assert(pool==NonPagedPool&&tag==TAG_WAIT);
+ assert(size==expected_count*sizeof(KWAIT_BLOCK));
+ /* Every object must already be referenced when allocation is attempted. */
+ for(unsigned i=0;i<expected_count;i++)assert(objects[i].refs==1);
+ if(fail_alloc)return NULL;
+ live++;return calloc(1,size);
+}
+static __attribute__((unused)) void ExFreePoolWithTag(PVOID p,int tag)
+{
+ assert(p&&tag==TAG_WAIT&&live==1);free_calls++;live--;free(p);
+}
+static NTSTATUS KeWaitForMultipleObjects(ULONG count,PVOID *waitables,
+ WAIT_TYPE type,int reason,KPROCESSOR_MODE mode,BOOLEAN alertable,
+ PLARGE_INTEGER timeout,PKWAIT_BLOCK blocks)
+{
+ dispatch_calls++;
+ assert(count==expected_count&&type==expected_type&&reason==UserRequest);
+ assert(mode==expected_mode&&alertable==expected_alertable);
+ assert(timeout==expected_timeout);
+ assert((count>THREAD_WAIT_OBJECTS)==(blocks!=NULL));
+ for(unsigned i=0;i<count;i++){
+  assert(objects[i].refs==1&&waitables[i]==&objects[i].waitable);
+  if(blocks)blocks[i].words[0]=i;
+ }
+ return dispatch_status;
+}
+'''
+tests = r'''
+static unsigned cases;
+static void run(ULONG count,WAIT_TYPE type,KPROCESSOR_MODE mode,
+ BOOLEAN alertable,int bad,int fail,NTSTATUS result,PLARGE_INTEGER timeout)
+{
+ HANDLE handles[64];
+ ref_calls=alloc_calls=free_calls=dispatch_calls=live=0;
+ fail_index=bad;fail_alloc=fail;expected_count=count;expected_type=type;
+ expected_mode=mode;expected_alertable=alertable;expected_timeout=timeout;
+ dispatch_status=result;
+ for(unsigned i=0;i<64;i++){
+  assert(objects[i].refs==0);handles[i]=&objects[i];
+  objects[i].header.Type=&types[i];
+  types[i].DefaultObject=i&1?(PVOID)offsetof(OBJECT,waitable):&objects[i].waitable;
+ }
+ NTSTATUS got=NxkWaitForMultipleObjectsMode(count,handles,type,mode,alertable,timeout);
+ int invalid=count==0||count>64||(type!=WaitAll&&type!=WaitAny);
+ NTSTATUS expected=invalid?STATUS_INVALID_PARAMETER:
+  bad>=0?STATUS_INVALID_HANDLE:fail&&count>3?STATUS_INSUFFICIENT_RESOURCES:result;
+ assert(got==expected);
+ assert(ref_calls==(invalid?0:bad>=0?(unsigned)bad+1:count));
+ unsigned allocation=!invalid&&bad<0&&count>3;
+ assert(alloc_calls==allocation);
+ assert(free_calls==(allocation&&!fail));
+ assert(dispatch_calls==(!invalid&&bad<0&&!(fail&&count>3)));
+ assert(live==0);for(unsigned i=0;i<64;i++)assert(objects[i].refs==0);
+ cases++;
+}
+int main(void)
+{
+ int64_t finite=-500000,zero=0;
+ const unsigned counts[]={1,3,4,5,64};
+ const NTSTATUS results[]={0,2,0x102,0xc0,(int32_t)0xc0000001};
+ for(unsigned c=0;c<5;c++){
+  for(unsigned t=0;t<2;t++)for(unsigned m=0;m<2;m++)
+   for(unsigned a=0;a<2;a++)for(unsigned r=0;r<5;r++)
+    run(counts[c],t,m,a,-1,0,results[r],r%3==0?NULL:r%3==1?&zero:&finite);
+  run(counts[c],WaitAny,KernelMode,0,-1,1,0,&finite);
+  run(counts[c],WaitAll,UserMode,1,0,0,0,&finite);
+  run(counts[c],WaitAll,UserMode,1,counts[c]/2,0,0,&finite);
+  run(counts[c],WaitAll,UserMode,1,counts[c]-1,0,0,&finite);
+ }
+ run(0,WaitAll,KernelMode,0,-1,0,0,NULL);
+ run(65,WaitAll,KernelMode,0,-1,0,0,NULL);
+ run(4,(WAIT_TYPE)2,KernelMode,0,-1,0,0,NULL);
+ printf("PASS: %u production adapter cases; references/pool balanced\n",cases);
+}
+'''
+(out / 'actual-wait.c').write_text(preamble.replace('#include <string.h>',
+    '#include <string.h>\n#include <stddef.h>') + source[start:end] + tests)
+subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                '-fsanitize=address,undefined', '-fno-omit-frame-pointer',
+                str(out / 'actual-wait.c'), '-o', str(out / 'wait-check')], check=True)
+subprocess.run([str(out / 'wait-check')], check=True)
