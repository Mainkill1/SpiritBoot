 not throughput or emulated cycle measurements. The initial 64-page pin
 budget remains a tuning candidate until paired guest timings establish its
 crossover, especially added translations on small rejected prefixes.
+
+DES round regression (pass the unmodified assembled source as `BASELINE`):
+
+```sh
+python3 tests/host/kernel-performance/des-rounds.py CANDIDATE BASELINE OUTPUT --optimized
+```
+
+This adds 4,096 block cases with arbitrary caller-owned schedules and 2,048
+CBC cases with overlapping input, output and feedback buffers, unaligned
+addresses, incomplete blocks and whole-arena comparisons. A host-only counter
+limits `DesBit` calls to the initial/final permutations: 128 per DES pass,
+versus 1,408 before combining S-box substitution with the P permutation.
+The work bound is deterministic; it does not claim native throughput.
diff --git a/tests/host/kernel-performance/des-rounds.py b/tests/host/kernel-performance/des-rounds.py
new file mode 100644
index 0000000000000000000000000000000000000000..0013b05a9db041b03722b33d804decdd91a742a8
--- /dev/null
+++ b/tests/host/kernel-performance/des-rounds.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""DES actual-source differential and bounded-work regression.
+
+Catches expansion/permutation bit-order bugs, changed mutable schedule behavior,
+CBC feedback/overlap/tail writes, and reintroduction of per-bit round work.
+The baseline source is an unmodified assembled tree, never the candidate.
+"""
+import argparse
+import ctypes as C
+import importlib.util
+from pathlib import Path
+import random
+import subprocess
+
+spec = importlib.util.spec_from_file_location('checks', Path(__file__).with_name('check.py'))
+checks = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(checks)
+
+
+def build(root, output):
+    output.mkdir(parents=True, exist_ok=True)
+    source = (root / 'ntoskrnl/xb/crypto.c').read_text()
+    des = source[source.index('#define DES_TABLE_BYTES'):source.index('/* --- the crypto vector')]
+    des = des.replace('DesBit(const UCHAR *Bytes, ULONG Position)\n{',
+                      'DesBit(const UCHAR *Bytes, ULONG Position)\n{\n ++counters[0];')
+    names = ['XcpKeyTable', 'XcpBlockCrypt', 'XcpBlockCryptCBC']
+    exports = '\n'.join('extern __typeof__(' + n + ') host_' + n + ' __attribute__((alias("' + n + '")));' for n in names)
+    path = output / 'des.c'
+    path.write_text(checks.SHIM + des + exports)
+    so = output / 'des.so'
+    subprocess.run(['cc', '-std=c11', '-O2', '-Wall', '-Wextra', '-Wno-unused-function', '-shared', '-fPIC', str(path), '-o', str(so)], check=True)
+    lib = C.CDLL(str(so.resolve()))
+    lib.counters = (C.c_uint64 * 16).in_dll(lib, 'counters')
+    for n in names:
+        getattr(lib, 'host_' + n).restype = None
+    return lib
+
+
+def run(candidate, baseline, optimized):
+    rng = random.Random(0xD35)
+    tests = 0
+    # Arbitrary schedules exercise all caller-mutable bits, independent of key
+    # schedule generation. Include bit-basis inputs to expose endian mistakes.
+    for index in range(4096):
+        cipher = [0, 1, 2, 0xffffffff][index % 4]
+        op = [0, 1, 2, 0xffffffff][index // 4 % 4]
+        block = (1 << index).to_bytes(8, 'big') if index < 64 else rng.randbytes(8)
+        table = C.create_string_buffer(rng.randbytes(384))
+        inp = C.create_string_buffer(block)
+        outputs = []
+        for lib in [candidate, baseline]:
+            out = C.create_string_buffer(b'\xa7' * 16)
+            lib.reset_counters()
+            lib.host_XcpBlockCrypt(C.c_uint32(cipher), out, inp, table, C.c_uint32(op))
+            outputs.append(out.raw)
+        assert outputs[0] == outputs[1], ('block', index)
+        if optimized:
+            budget = 128 * (1 if cipher == 0 else 3)
+            assert candidate.counters[0] <= budget, ('round bit-work exceeds boundary-only budget', candidate.counters[0], budget)
+        tests += 1
+    # Same backing allocation intentionally aliases buffers, feedback and table.
+    # Compare all bytes, including sentinels and incomplete block tails.
+    for index in range(2048):
+        cipher = index % 3
+        op = index // 3 % 3
+        length = [0,1,7,8,9,15,16,17,31,32,64,4096][index % 12]
+        source = 416 + index % 4
+        dest = source + [-8,-1,0,1,8,4352][index // 12 % 6]
+        feedback = [400,source,dest,source+8,dest+8][index // 72 % 5]
+        table = [index % 4, source, dest, feedback][index // 360 % 4]
+        data = rng.randbytes(9000)
+        results = []
+        for lib in [candidate, baseline]:
+            arena = C.create_string_buffer(data)
+            lib.host_XcpBlockCryptCBC(cipher, length, C.byref(arena,dest), C.byref(arena,source), C.byref(arena,table), op, C.byref(arena,feedback))
+            results.append(arena.raw)
+        assert results[0] == results[1], ('CBC', index, source, dest, feedback)
+        tests += 1
+    print(f'DES block/CBC differential: {tests}/{tests}; bounded round work: {optimized}')
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser()
+    p.add_argument('candidate', type=Path)
+    p.add_argument('baseline', type=Path)
+    p.add_argument('output', type=Path)
+    p.add_argument('--optimized', action='store_true')
+    a = p.parse_args()
+    run(build(a.candidate, a.output / 'candidate'), build(a.baseline, a.output / 'baseline'), a.optimized)
