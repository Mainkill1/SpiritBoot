+    nx_request r=request(&f,&p,NX_WRITE,0,512); r.flags=NX_WRITE_THROUGH;
+    CHECK(nx_start(&f.dev,&r,&h)==NX_PENDING);
+    r=request(&f,&later,NX_WRITE,512,512); CHECK(nx_start(&f.dev,&r,&lh)==NX_PENDING);
+    CHECK(!later.completions && f.commands==2);
+    r=request(&f,&rd,NX_READ,1024,512); CHECK(nx_start(&f.dev,&r,&rh)==NX_OK);
+    CHECK(rd.completions==1 && rd.bytes==512 && f.commands==3 && !p.completions);
+    finish_held(&f,h.slot,NX_OK,0,0);
+    CHECK(p.completions==1 && p.bytes==512 && later.completions==1 && later.bytes==512);
+    CHECK(f.commands==4 && f.log[3].parent==&later && f.log[3].cdb[0]==0x2a);
+    cleanup(&f); return 1;
+}
+/* Break: sync starts before previous ordinary writes have reached terminal completion. */
+static int write_through_sync_waits_for_prior_write(void)
+{
+    fixture f; nx_config cfg=config(); CHECK(init(&f,&cfg)); f.delayed=1;
+    parent earlier=fresh(), p=fresh(); nx_handle eh,h;
+    nx_request r=request(&f,&earlier,NX_WRITE,0,512); CHECK(nx_start(&f.dev,&r,&eh)==NX_PENDING);
+    r=request(&f,&p,NX_WRITE,512,512); r.flags=NX_WRITE_THROUGH; CHECK(nx_start(&f.dev,&r,&h)==NX_PENDING);
+    finish_held(&f,h.slot,NX_OK,512,0); CHECK(!p.completions && f.commands==2);
+    finish_held(&f,eh.slot,NX_OK,512,0);
+    CHECK(earlier.completions==1 && !p.completions && f.commands==3 && f.held[h.slot].cdb[0]==0x35);
+    finish_held(&f,h.slot,NX_OK,0,0); CHECK(p.completions==1 && p.bytes==512);
+    cleanup(&f); return 1;
+}
+/* Break: disabled cache skips required ordering or emits unnecessary cache commands. */
+static int write_through_disabled_cache_still_orders(void)
+{
+    fixture f; nx_config cfg=config(); cfg.cache=NX_CACHE_DISABLED; CHECK(init(&f,&cfg)); f.delayed=1;
+    parent earlier=fresh(), p=fresh(); nx_handle eh,h;
+    nx_request r=request(&f,&earlier,NX_WRITE,0,512); CHECK(nx_start(&f.dev,&r,&eh)==NX_PENDING);
+    r=request(&f,&p,NX_WRITE,512,512); r.flags=NX_WRITE_THROUGH; CHECK(nx_start(&f.dev,&r,&h)==NX_PENDING);
+    finish_held(&f,h.slot,NX_OK,512,0); CHECK(!p.completions && f.commands==2);
+    finish_held(&f,eh.slot,NX_OK,512,0); CHECK(p.completions==1 && p.status==NX_OK && p.bytes==512 && f.commands==2);
+    cleanup(&f); return 1;
+}
+/* Break: old data callbacks corrupt the live sync phase or duplicate parent delivery. */
+static int write_through_duplicate_data_and_sync_are_ignored(void)
+{
+    fixture f; nx_config cfg=config(); CHECK(init(&f,&cfg)); f.delayed=1;
+    parent p=fresh(); nx_handle h; nx_request r=request(&f,&p,NX_WRITE,0,512); r.flags=NX_WRITE_THROUGH;
+    CHECK(nx_start(&f.dev,&r,&h)==NX_PENDING); nx_token data=f.held[h.slot].token;
+    finish_held(&f,h.slot,NX_OK,512,0); CHECK(!p.completions && f.commands==2);
+    nx_token sync=f.held[h.slot].token;
+    nx_lower_done(&f.dev,data,NX_IO_ERROR,512,0); CHECK(!p.completions && f.retires==1);
+    finish_held(&f,h.slot,NX_OK,0,0); nx_lower_done(&f.dev,sync,NX_OK,0,0);
+    CHECK(p.completions==1 && p.bytes==512 && f.retires==2); cleanup(&f); return 1;
+}
+/* Break: unqualified durability or illegal flags reach lower transport. */
+static int write_through_zero_and_invalid_flags(void)
+{
+    const struct { nx_operation op; uint32_t flags; uint64_t bytes; nx_cache cache; nx_status want; } cases[]={
+        {NX_READ,NX_WRITE_THROUGH,512,NX_CACHE_ENABLED,NX_INVALID},
+        {NX_FLUSH,NX_WRITE_THROUGH,0,NX_CACHE_ENABLED,NX_INVALID},
+        {NX_WRITE,2,512,NX_CACHE_ENABLED,NX_INVALID},
+        {NX_WRITE,UINT32_C(2147483648),512,NX_CACHE_ENABLED,NX_INVALID},
+        {NX_WRITE,NX_WRITE_THROUGH|2,512,NX_CACHE_ENABLED,NX_INVALID},
+        {NX_WRITE,NX_WRITE_THROUGH,512,NX_CACHE_UNQUALIFIED,NX_DURABILITY_UNSUPPORTED},
+        {NX_WRITE,NX_WRITE_THROUGH,0,NX_CACHE_UNQUALIFIED,NX_DURABILITY_UNSUPPORTED},
+        {NX_WRITE,NX_WRITE_THROUGH,0,NX_CACHE_ENABLED,NX_OK},
+        {NX_WRITE,NX_WRITE_THROUGH,0,NX_CACHE_DISABLED,NX_OK},
+        {NX_WRITE,2,0,NX_CACHE_ENABLED,NX_INVALID}
+    };
+    for (unsigned i=0;i<sizeof(cases)/sizeof(cases[0]);++i) {
+        fixture f; nx_config cfg=config(); cfg.cache=cases[i].cache; CHECK(init(&f,&cfg));
+        parent p=fresh(); nx_handle h; nx_request r=request(&f,&p,cases[i].op,0,cases[i].bytes); r.flags=cases[i].flags;
+        if (!r.bytes) { r.mdl_virtual=0; r.mdl_bytes=0; }
+        CHECK(nx_start(&f.dev,&r,&h)==cases[i].want);
+        CHECK(p.completions==1 && p.status==cases[i].want && !p.bytes && !f.commands && !f.prepares);
+        cleanup(&f);
+    }
+    return 1;
+}
+/* Break: failed sync preparation leaks a slot or returns unwritten/full fabricated accounting. */
+static int write_through_sync_prepare_failure_preserves_data(void)
+{
+    fixture f; nx_config cfg=config(); CHECK(init(&f,&cfg)); f.fail_prepare=2;
+    parent p=fresh(); nx_handle h; nx_request r=request(&f,&p,NX_WRITE,0,512); r.flags=NX_WRITE_THROUGH;
+    CHECK(nx_start(&f.dev,&r,&h)==NX_NO_MEMORY);
+    CHECK(p.completions==1 && p.bytes==512 && p.status==NX_NO_MEMORY && f.commands==1 && f.retires==1);
+    parent next=fresh(); r=request(&f,&next,NX_WRITE,512,512); CHECK(nx_start(&f.dev,&r,&h)==NX_OK);
+    CHECK(next.completions==1 && next.bytes==512); cleanup(&f); return 1;
+}
+
+/* Break: init clears beyond caller-declared storage or multiplies an impossible count. */
+static int impossible_slot_count_rejects_before_any_clear(void)
+{
+    fixture f; nx_config cfg=config(); CHECK(init(&f,&cfg));
+    nx_port port=f.dev.port;
+    memset(&f.dev,0xa5,sizeof(f.dev)); memset(f.slots,0xa5,sizeof(f.slots));
+    CHECK(nx_device_init(&f.dev,&cfg,&port,f.slots,2,sizeof(nx_slot))==NX_INVALID);
+    const unsigned char *device=(const unsigned char *)&f.dev;
+    const unsigned char *slots=(const unsigned char *)f.slots;
+    for (size_t i=0;i<sizeof(f.dev);++i) CHECK(device[i]==0xa5);
+    for (size_t i=0;i<sizeof(f.slots);++i) CHECK(slots[i]==0xa5);
+    CHECK(nx_device_init(&f.dev,&cfg,&port,f.slots,UINT32_MAX,sizeof(f.slots))==NX_INVALID);
+    for (size_t i=0;i<sizeof(f.dev);++i) CHECK(device[i]==0xa5);
+    for (size_t i=0;i<sizeof(f.slots);++i) CHECK(slots[i]==0xa5);
+    cleanup(&f); return 1;
+}
