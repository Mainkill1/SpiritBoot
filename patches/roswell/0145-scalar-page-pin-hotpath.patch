diff --git a/tests/host/page-pin-hotpath/check.py b/tests/host/page-pin-hotpath/check.py
new file mode 100644
index 00000000..e1c24838
--- /dev/null
+++ b/tests/host/page-pin-hotpath/check.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Keep validated page-pin commits on their single-check hot paths."""
+from pathlib import Path
+import re
+import sys
+
+root = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else Path(__file__).resolve().parents[3]
+pages = (root / "ntoskrnl/xb/mm/pagesupply.c").read_text()
+scatter = (root / "ntoskrnl/xb/scattergather.c").read_text()
+
+
+def function(source, name):
+    match = re.search(r"(?:^|\n)(?:static\s+)?(?:__inline__\s+)?(?:__attribute__\(\([^)]*\)\)\s+)?(?:BOOLEAN|VOID)\s+" +
+                      re.escape(name) + r"\([^)]*\)\s*\{", source)
+    assert match, f"missing {name}"
+    start = match.start()
+    brace = source.index("{", match.start())
+    depth = 0
+    for index in range(brace, len(source)):
+        if source[index] == "{":
+            depth += 1
+        elif source[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:index + 1]
+    raise AssertionError(f"unterminated {name}")
+
+
+assert "static __inline__ __attribute__((__always_inline__))\nBOOLEAN NxpCanPin(" in pages
+private = function(pages, "NxpCanPin")
+public = function(pages, "NxkPageSupplyCanPin")
+pin = function(pages, "NxkPageSupplyPin")
+try_unlock = function(pages, "NxkPageSupplyTryUnlock")
+assert "return NxpCanPin(Page, Unlock);" in public
+assert "NxpCanPin(Page, Unlock)" in pin
+assert "NxkPageSupplyCanPin" not in pin
+assert "NxkPageSupplyCanPin(Page, TRUE)" in try_unlock
+assert "NxpCanPin(Page, TRUE)" not in try_unlock
+assert "NxpLinks == NULL" in private and "Page > NxpHighestPfn" in private
+assert "NXP_FREE" in private and "NXP_RETURN_PENDING" in private
+
+sg_start = scatter.index("pfnIrql = MiAcquirePfnLock();")
+sg_end = scatter.index("r->Pages[i].Buffer = page;", sg_start)
+sg_end = scatter.index("MiReleasePfnLock(pfnIrql);", sg_end) + len("MiReleasePfnLock(pfnIrql);")
+sg = scatter[sg_start:sg_end]
+assert sg.count("NxkPageSupplyCanPin(pfn, FALSE)") == 1
+assert sg.count("NxkPageSupplyCommitPin(pfn)") == 1
+assert "NxkPageSupplyPin(pfn, FALSE)" not in sg
+assert sg.index("NxkPageSupplyCanPin") < sg.index("NxkPageSupplyCommitPin") < sg.rindex("MiReleasePfnLock")
+print("page-pin hot-path source checks: PASS")
