+/* Catch allocation failure becoming successful stale data or leaking a lock. */
+static void test_builder_allocation_failure(void)
+{
+    struct fixture f;
+    setup(&f, 112);
+    f.allocation_failure = 1;
+    expect_failure(&f, STATUS_INSUFFICIENT_RESOURCES);
+    CHECK(f.builds == 1 && f.calls == 0 && f.allocations == 0);
+}
+
+/* Catch releasing an unacquired owner event or ignoring a failed wait. */
+static void test_owner_wait_failure(void)
+{
+    struct fixture f;
+    setup(&f, 112);
+    f.owner_wait_status = STATUS_INVALID_PARAMETER;
+    expect_failure(&f, STATUS_INVALID_PARAMETER);
+    CHECK(f.owner_waits == 1 && f.releases == 0 && f.builds == 0);
+}
+
+/* Catch abandoning stack-resident child output/IOSB on a transient wait fault. */
+static void test_completion_wait_retry(void)
+{
+    struct fixture f;
+    setup(&f, 112);
+    f.submission = STATUS_PENDING;
+    f.transient_wait_fault = 1;
+    CHECK(enclosing_dispatch(&f, &f.owner) == STATUS_SUCCESS);
+    CHECK(f.lower_waits == 2 && f.disposals == 1);
+    CHECK(memcmp(f.storage + 1, expected_full, 112) == 0);
+    cleanup(&f);
+}
+
+/* Catch dereferencing a child disposed inline before a pending return. */
+static void test_inline_completion_with_pending_return(void)
+{
+    struct fixture f;
+    setup(&f, 112);
+    f.submission = STATUS_PENDING;
+    f.inline_pending = 1;
+    CHECK(enclosing_dispatch(&f, &f.owner) == STATUS_SUCCESS);
+    CHECK(f.lower_waits == 1 && f.disposals == 1);
+    cleanup(&f);
+}
+
+/* Catch adapter-side parent completion/freeing; enclosing completion may
+ * release the upper allocation immediately after the adapter returns. */
+static void test_enclosing_completion_frees_upper(void)
+{
+    struct fixture f;
+    setup(&f, 112);
+    f.active_upper = malloc(sizeof(IRP));
+    CHECK(f.active_upper != NULL);
+    *f.active_upper = f.upper;
+    f.free_upper = 1;
+    CHECK(enclosing_dispatch(&f, &f.owner) == STATUS_SUCCESS);
+    CHECK(f.completed_information == 112 && f.completions == 1);
+    cleanup(&f);
+}
