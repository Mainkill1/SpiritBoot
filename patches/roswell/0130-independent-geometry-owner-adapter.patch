+int main(void)
+{
+    test_every_output_capacity();
+    test_submission_and_terminal_status();
+    test_unwritten_terminal_status();
+    test_lower_count_faults();
+    test_no_write_and_poison_geometry();
+    test_invalid_owner_snapshots();
+    test_gpt_raw_and_brfr();
+    test_owner_sector_mismatch();
+    test_snapshot_mutation_during_query();
+    test_owner_output_alias();
+    test_missing_arguments();
+    test_builder_allocation_failure();
+    test_owner_wait_failure();
+    test_completion_wait_retry();
+    test_inline_completion_with_pending_return();
+    test_enclosing_completion_frees_upper();
+    if (failures) {
+        fprintf(stderr, "%u failed assertions / %u checks\n", failures, checks);
+        return EXIT_FAILURE;
+    }
+    printf("PASS: 16 adapter scenarios, %u checks\n", checks);
+    return EXIT_SUCCESS;
+}
