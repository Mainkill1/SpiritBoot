+/* Catch silently accepting a disagreement in refreshed sector metadata. */
+static void test_owner_sector_mismatch(void)
+{
+    struct fixture f;
+    setup(&f, 112);
+    f.owner.DiskData.BytesPerSector = 4096;
+    expect_failure(&f, STATUS_UNRECOGNIZED_MEDIA);
+}
+
+/* Catch lock/cache-pointer borrowing or rereading changed owner metadata. */
+static void test_snapshot_mutation_during_query(void)
+{
+    unsigned pending;
+    for (pending = 0; pending < 2; ++pending) {
+        struct fixture f;
+        setup(&f, 112);
+        f.submission = pending ? STATUS_PENDING : STATUS_SUCCESS;
+        f.mutate_owner = 1;
+        CHECK(enclosing_dispatch(&f, &f.owner) == STATUS_SUCCESS);
+        CHECK(memcmp(f.storage + 1, expected_full, 112) == 0);
+        CHECK(f.owner.LayoutValid == 0 && f.owner.LayoutCache == NULL);
+        cleanup(&f);
+    }
+}
+
+/* Catch output mutation before copying aliased owner scalars. */
+static void test_owner_output_alias(void)
+{
+    union { FDO_EXTENSION owner; unsigned char writable[256]; } shared;
+    struct fixture f;
+    setup(&f, 112);
+    shared.owner = f.owner;
+    f.active_upper->AssociatedIrp.SystemBuffer = shared.writable;
+    CHECK(enclosing_dispatch(&f, &shared.owner) == STATUS_SUCCESS);
+    CHECK(memcmp(shared.writable, expected_full, 112) == 0);
+    cleanup(&f);
+}
+
+/* Catch null-argument dereferences and upper completion inside the adapter. */
+static void test_missing_arguments(void)
+{
+    struct fixture f;
+    setup(&f, 112);
+    CHECK(enclosing_dispatch(&f, NULL) == STATUS_INVALID_PARAMETER);
+    CHECK(f.completed_information == 0 && f.builds == 0);
+    cleanup(&f);
+    setup(&f, 112);
+    f.upper.AssociatedIrp.SystemBuffer = NULL;
+    expect_failure(&f, STATUS_INVALID_PARAMETER);
+    setup(&f, 112);
+    f.upper.Tail.Overlay.CurrentStackLocation = NULL;
+    expect_failure(&f, STATUS_INVALID_PARAMETER);
+    setup(&f, 112);
+    CHECK(NxPartComposeExtendedGeometry(&f.owner, NULL) == STATUS_INVALID_PARAMETER);
+    CHECK(f.completions == 0 && f.builds == 0);
+    cleanup(&f);
+}
