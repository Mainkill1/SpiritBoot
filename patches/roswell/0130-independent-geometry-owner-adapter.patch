new file mode 100644
index 00000000..e0d2e970
--- /dev/null
+++ b/drivers/storage/class/nxstorage/geometry_target_assertions.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Mandatory integration checks against approved actual target declarations.
+ * Host semantic types deliberately do not satisfy the target IRP layout.
+ */
+#ifndef INDEPENDENT_GEOMETRY_TARGET_ASSERTIONS_H
+#define INDEPENDENT_GEOMETRY_TARGET_ASSERTIONS_H
+
+#include <stddef.h>
+_Static_assert(sizeof(void *) == 4 && sizeof(NTSTATUS) == 4, "target scalar ABI");
+_Static_assert(sizeof(IRP) == 128 && _Alignof(IRP) == 8, "target IRP ABI");
+_Static_assert(offsetof(IRP, IoStatus) == 16, "target IOSB offset");
+_Static_assert(offsetof(IRP, AssociatedIrp.SystemBuffer) == 112, "target buffer offset");
+_Static_assert(offsetof(IRP, Tail.Overlay.CurrentStackLocation) == 92, "target stack offset");
+_Static_assert(sizeof(IO_STACK_LOCATION) == 36, "target stack ABI");
+_Static_assert(offsetof(IO_STACK_LOCATION, Parameters.DeviceIoControl.OutputBufferLength) == 4,
+               "target output-capacity offset");
+_Static_assert(sizeof(IO_STATUS_BLOCK) == 8 && offsetof(IO_STATUS_BLOCK, Information) == 4,
+               "target IOSB ABI");
+_Static_assert(sizeof(KEVENT) == 16 && _Alignof(KEVENT) == 4, "target event ABI");
+_Static_assert(sizeof(DISK_GEOMETRY) == 24 && _Alignof(DISK_GEOMETRY) == 8,
+               "target basic geometry ABI");
+_Static_assert(offsetof(DISK_GEOMETRY, BytesPerSector) == 20, "target sector offset");
+_Static_assert(offsetof(DISK_GEOMETRY_EX, DiskSize) == 24 &&
+               offsetof(DISK_GEOMETRY_EX, Data) == 32, "target extended geometry ABI");
+_Static_assert(sizeof(DISK_PARTITION_INFO) == 24 && sizeof(DISK_DETECTION_INFO) == 56,
+               "target optional records ABI");
+_Static_assert(sizeof(DISK_INT13_INFO) == 16 && sizeof(DISK_EX_INT13_INFO) == 32,
+               "target nested BIOS record sizes");
+_Static_assert(offsetof(DISK_EX_INT13_INFO, ExSectorsPerDrive) == 16,
+               "target extended BIOS 64-bit offset");
+_Static_assert(offsetof(DISK_DETECTION_INFO, Int13) == 8 &&
+               offsetof(DISK_DETECTION_INFO, ExInt13) == 24,
+               "target nested detection record offsets");
+_Static_assert(offsetof(DISK_PARTITION_INFO, Mbr.Signature) == 8 &&
+               offsetof(DISK_PARTITION_INFO, Mbr.CheckSum) == 12 &&
+               offsetof(DISK_PARTITION_INFO, Gpt.DiskId) == 8, "target identity offsets");
+_Static_assert(sizeof(((PFDO_EXTENSION)0)->DiskData.DiskSize) == 8 &&
+               sizeof(((PFDO_EXTENSION)0)->DiskData.BytesPerSector) == 4 &&
+               sizeof(((PFDO_EXTENSION)0)->DiskData.PartitionStyle) == 4 &&
+               sizeof(((PFDO_EXTENSION)0)->DiskData.Mbr.Signature) == 4 &&
+               sizeof(((PFDO_EXTENSION)0)->DiskData.Gpt.DiskId) == 16,
+               "retained owner field widths");
+_Static_assert((unsigned)STATUS_SUCCESS == 0 && (unsigned)STATUS_PENDING == 0x103u &&
+               (unsigned)STATUS_BUFFER_TOO_SMALL == 0xc0000023u &&
+               (unsigned)STATUS_INSUFFICIENT_RESOURCES == 0xc000009au &&
+               (unsigned)STATUS_INVALID_PARAMETER == 0xc000000du &&
+               (unsigned)STATUS_INVALID_DEVICE_REQUEST == 0xc0000010u &&
+               (unsigned)STATUS_INFO_LENGTH_MISMATCH == 0xc0000004u &&
+               (unsigned)STATUS_UNRECOGNIZED_MEDIA == 0xc0000014u,
+               "approved target status constants");
+_Static_assert(IOCTL_DISK_GET_DRIVE_GEOMETRY == 458752u && Executive == 0 &&
+               KernelMode == 0 && NotificationEvent == 0, "approved query constants");
+
+#endif
