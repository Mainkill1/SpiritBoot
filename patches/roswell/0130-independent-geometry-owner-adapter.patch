+ */
+#ifndef INDEPENDENT_GEOMETRY_KERNEL_API_H
+#define INDEPENDENT_GEOMETRY_KERNEL_API_H
+
+PIRP NTAPI IoBuildDeviceIoControlRequest(ULONG code, PDEVICE_OBJECT device,
+    PVOID input, ULONG input_bytes, PVOID output, ULONG output_bytes,
+    BOOLEAN internal, PKEVENT event, PIO_STATUS_BLOCK status);
+VOID NTAPI KeInitializeEvent(PKEVENT event, EVENT_TYPE type, BOOLEAN signaled);
+LONG NTAPI KeSetEvent(PKEVENT event, KPRIORITY increment, BOOLEAN wait);
+NTSTATUS NTAPI KeWaitForSingleObject(PVOID object, KWAIT_REASON reason,
+    KPROCESSOR_MODE mode, BOOLEAN alertable, PLARGE_INTEGER timeout);
+NTSTATUS FASTCALL IofCallDriver(PDEVICE_OBJECT device, PIRP child);
+
+#endif
diff --git a/drivers/storage/class/nxstorage/geometry_owner_adapter.c b/drivers/storage/class/nxstorage/geometry_owner_adapter.c
new file mode 100644
index 00000000..b5c91bb7
--- /dev/null
+++ b/drivers/storage/class/nxstorage/geometry_owner_adapter.c
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "geometry_owner_adapter.h"
+#include "geometry_composer.h"
+#include "geometry_kernel_api.h"
+#ifndef INDEPENDENT_GEOMETRY_HOST_PLATFORM_H
+#include "geometry_target_assertions.h"
+#endif
+
+_Static_assert(sizeof(DISK_GEOMETRY) == 24, "sized lower query output");
+_Static_assert(sizeof(NTSTATUS) == 4 && (NTSTATUS)-1 < 0, "signed target status ABI");
+_Static_assert(sizeof(GUID) == 16, "public GUID memory image");
+_Static_assert(_Generic(&NxPartComposeExtendedGeometry,
+                       NTSTATUS (*)(PFDO_EXTENSION, PIRP): 1, default: 0),
+               "ordinary C retained entrypoint convention");
+
+static NTSTATUS query_basic_geometry(PDEVICE_OBJECT device, DISK_GEOMETRY *geometry)
+{
+    KEVENT completion;
+    IO_STATUS_BLOCK terminal;
+    PIRP child;
+    NTSTATUS submitted, waited;
+    size_t index;
+
+    for (index = 0; index < sizeof(*geometry); ++index)
+        ((ig_u8 *)geometry)[index] = 0;
+    terminal.Status = STATUS_PENDING;
+    terminal.Information = 0;
+    KeInitializeEvent(&completion, NotificationEvent, 0);
+    child = IoBuildDeviceIoControlRequest(IOCTL_DISK_GET_DRIVE_GEOMETRY,
+        device, NULL, 0, geometry, sizeof(*geometry), 0, &completion, &terminal);
+    if (!child) return STATUS_INSUFFICIENT_RESOURCES;
+    submitted = IofCallDriver(device, child);
+    /* No child access or free: synchronous completion disposes it, including
+     * inline completion before IofCallDriver returns. Stack outputs stay live. */
+    if (submitted == STATUS_PENDING) {
+        do {
+            waited = KeWaitForSingleObject(&completion, Executive, KernelMode, 0, NULL);
+        } while (waited != STATUS_SUCCESS);
+    }
+    if (terminal.Status < 0) return terminal.Status;
+    if (submitted < 0) return submitted;
+    if (terminal.Status != STATUS_SUCCESS ||
+        (submitted != STATUS_SUCCESS && submitted != STATUS_PENDING))
+        return STATUS_INVALID_DEVICE_REQUEST;
+    if (terminal.Information != sizeof(*geometry)) return STATUS_INFO_LENGTH_MISMATCH;
+    return STATUS_SUCCESS;
+}
+
+/* boot-fixed caller contract: owner and its attached LowerDevice stay alive
+ * throughout this function. This does not add hot-remove reference protection. */
+NTSTATUS NxPartComposeExtendedGeometry(PFDO_EXTENSION owner, PIRP upper)
+{
+    struct ig_owner_snapshot snapshot = { 0 };
+    struct ig_lower_response base_input;
+    struct ig_result composed;
+    DISK_GEOMETRY geometry;
+    PDEVICE_OBJECT device = NULL;
+    ig_u64 capacity = 0;
+    ig_u32 sector_bytes = 0;
+    ig_u8 base[IG_BASE_BYTES];
+    PVOID output;
+    ULONG output_bytes;
+    NTSTATUS status;
+    size_t index;
+
+    if (!upper) return STATUS_INVALID_PARAMETER;
+    upper->IoStatus.Information = 0;
+    if (!owner || !upper->Tail.Overlay.CurrentStackLocation) return STATUS_INVALID_PARAMETER;
+    output_bytes = upper->Tail.Overlay.CurrentStackLocation->Parameters.DeviceIoControl.OutputBufferLength;
+    if (output_bytes < IG_BASE_BYTES) return STATUS_BUFFER_TOO_SMALL;
+    output = upper->AssociatedIrp.SystemBuffer;
+    if (!output) return STATUS_INVALID_PARAMETER;
+
+    status = KeWaitForSingleObject(&owner->SyncEvent, Executive, KernelMode, 0, NULL);
+    if (status != STATUS_SUCCESS)
+        return status < 0 ? status : STATUS_INVALID_DEVICE_REQUEST;
+    status = STATUS_INVALID_DEVICE_REQUEST;
+    if (owner->LayoutValid && owner->LayoutCache && owner->LowerDevice) {
+        device = owner->LowerDevice;
+        capacity = owner->DiskData.DiskSize;
+        sector_bytes = owner->DiskData.BytesPerSector;
+        snapshot.partition_style = owner->DiskData.PartitionStyle;
+        if (snapshot.partition_style == IG_PARTITION_MBR) {
+            snapshot.identity_available = 1;
+            snapshot.mbr_signature = owner->DiskData.Mbr.Signature;
+        } else if (snapshot.partition_style == IG_PARTITION_GPT) {
+            snapshot.identity_available = 1;
+            for (index = 0; index < sizeof(snapshot.gpt_disk_id); ++index)
+                snapshot.gpt_disk_id[index] = ((const ig_u8 *)&owner->DiskData.Gpt.DiskId)[index];
+        }
+        /* No owner checksum exists. Zero-initialized unavailable is policy. */
+        if (capacity != 0 && (capacity >> 63) == 0 && sector_bytes >= 128 &&
+            sector_bytes <= 65536 && (sector_bytes & (sector_bytes - 1)) == 0 &&
+            (capacity & (sector_bytes - 1)) == 0 &&
+            (snapshot.partition_style <= IG_PARTITION_RAW ||
+             snapshot.partition_style == IG_PARTITION_BRFR))
+            status = STATUS_SUCCESS;
+    }
+    KeSetEvent(&owner->SyncEvent, 0, 0);
+    if (status != STATUS_SUCCESS) return status;
+
+    status = query_basic_geometry(device, &geometry);
+    if (status != STATUS_SUCCESS) return status;
+    if (geometry.BytesPerSector != sector_bytes) return STATUS_UNRECOGNIZED_MEDIA;
+    for (index = 0; index < sizeof(geometry); ++index)
+        base[index] = ((const ig_u8 *)&geometry)[index];
+    for (index = 0; index < 8; ++index)
+        base[sizeof(geometry) + index] = (ig_u8)(capacity >> (index * 8));
+    base_input.status = 0;
+    base_input.buffer = base;
+    base_input.buffer_bytes = sizeof(base);
+    base_input.returned_bytes = sizeof(base);
+    composed = ig_compose_geometry(&base_input, &snapshot, output, output_bytes);
+    if (composed.outcome == IG_SUCCESS) {
+        upper->IoStatus.Information = composed.initialized_bytes;
+        return STATUS_SUCCESS;
+    }
+    if (composed.outcome == IG_INVALID_LOWER) return STATUS_UNRECOGNIZED_MEDIA;
+    return STATUS_INVALID_DEVICE_REQUEST;
+}
