+static VOID NTAPI
+NxkAvSetActiveArea(PVOID RegisterBase, ULONG Width, ULONG Height, UCHAR PixelFormat)
+{
+    UCHAR protect = NxkAvReadCrtc(RegisterBase, 0x11);
+    ULONG vertical = Height - 1;
+    NxkAvWriteCrtc(RegisterBase, 0x11, protect & ~0x80);
+    NxkAvWriteCrtc(RegisterBase, 1, Width / 8 - 1);
+    NxkAvWriteCrtc(RegisterBase, 0x12, vertical & 255);
+    NxkAvWriteCrtc(RegisterBase, 7, (NxkAvReadCrtc(RegisterBase, 7) & ~0x42) |
+                     ((vertical >> 7) & 2) | ((vertical >> 3) & 0x40));
+    NxkAvWriteCrtc(RegisterBase, 0x28, PixelFormat);
+    NxkAvWriteCrtc(RegisterBase, 0x11, protect);
+}
