 #endif
 #define PM_LAUNCH_MAGIC 0x6E78436CUL
-#define PM_LAUNCH_BYTES 3616
+#define PM_LAUNCH_BYTES 3640
 #define PM_MAX_STAGES 505u
 
 typedef struct _PM_HANDOFF {
