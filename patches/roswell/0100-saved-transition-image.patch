+/* Capture after shutdown callbacks, before the RAM handoff is hashed. */
+VOID NTAPI
+NxkAvCaptureState(NX_AV_HANDOFF *State)
+{
+    extern SIZE_T NTAPI NxMmQueryAllocationSize(PVOID BaseAddress);
+    ULONG_PTR address = (ULONG_PTR)NxkAvSavedDataAddress;
+    SIZE_T size;
+    UCHAR index, overflow;
+    RtlZeroMemory(State, sizeof(*State));
+    if (address < 0x80000000UL || address >= 0x84000000UL ||
+        (address & (PAGE_SIZE - 1))) return;
+    size = NxMmQueryAllocationSize((PVOID)address);
+    if (!size || size > 0x84000000UL - address) return;
+    State->SavedAddress = address;
+    State->AllocationBytes = size;
+    State->DisplayMode = NxkAvDisplayMode;
+    State->SourceFormat = NxkAvSourceFormat;
+    State->Pitch = NxkAvPitch;
+    State->FrameBuffer = *(volatile ULONG *)(0xFD000000UL + NV2A_PCRTC_START);
+    index = *(volatile UCHAR *)(0xFD000000UL + NV2A_PRMCIO_CR_INDEX);
+    State->Width = ((ULONG)NxkAvReadCrtc((PVOID)0xFD000000UL, 1) + 1) * 8;
+    overflow = NxkAvReadCrtc((PVOID)0xFD000000UL, 7);
+    State->Height = ((ULONG)NxkAvReadCrtc((PVOID)0xFD000000UL, 0x12) |
+                    ((overflow & 2) << 7) | ((overflow & 0x40) << 3)) + 1;
+    State->PixelFormat = NxkAvReadCrtc((PVOID)0xFD000000UL, 0x28);
+    *(volatile UCHAR *)(0xFD000000UL + NV2A_PRMCIO_CR_INDEX) = index;
+    State->GeneralControl = *(volatile ULONG *)(0xFD000000UL + NV2A_PRAMDAC_GENERAL_CONTROL);
+}
+
+/* The memory manager has already validated and admitted persistent pages.
+ * An ordinary boot or rejected range never publishes an old saved pointer. */
+CODE_SEG("INIT")
+VOID NTAPI
+NxkAvRestoreState(const NX_AV_HANDOFF *State)
+{
+    extern BOOLEAN NxkMmPersistentPage(ULONG_PTR Page);
+    ULONG address = State->SavedAddress;
+    ULONG physical, offset;
+    ULONG first, last, page;
+    ULONG depth, bytesPerPixel;
+    if (address < 0x80000000UL || address >= 0x84000000UL ||
+        (address & (PAGE_SIZE - 1)) || !State->AllocationBytes ||
+        State->AllocationBytes > 0x84000000UL - address) return;
+    physical = address - 0x80000000UL;
+    first = physical >> PAGE_SHIFT;
+    last = (physical + State->AllocationBytes - 1) >> PAGE_SHIFT;
+    /* Adjacent saved allocations share a restored run until late adoption.
+     * Check this allocation's pages, not the run's base. */
+    for (page = first; page <= last; ++page)
+        if (!NxkMmPersistentPage(page)) return;
+    AvSetSavedDataAddress((PVOID)address);
+    if (State->FrameBuffer < physical) return;
+    offset = State->FrameBuffer - physical;
+    if (offset >= State->AllocationBytes || !State->Pitch ||
+        State->Pitch > State->AllocationBytes - offset) return;
+    depth = State->PixelFormat & 3;
+    bytesPerPixel = depth == 3 ? 4 : depth;
+    if (!State->Width || State->Width > 2048 || (State->Width & 7) ||
+        !State->Height || State->Height > 1024 ||
+        State->PixelFormat > 255 || !depth ||
+        State->Width > State->Pitch / bytesPerPixel ||
+        State->Height > (State->AllocationBytes - offset) / State->Pitch) return;
+    /* Boot video can use a 720-pixel viewport. Restore the active area of
+     * the title's image independently of the firmware's boot mode. */
+    AvSetDisplayMode((PVOID)0xFD000000UL, 0, State->DisplayMode,
+                     State->SourceFormat, State->Pitch, State->FrameBuffer);
+    NxkAvSetActiveArea((PVOID)0xFD000000UL, State->Width, State->Height,
+                      State->PixelFormat);
+    *(volatile ULONG *)(0xFD000000UL + NV2A_PRAMDAC_GENERAL_CONTROL) = State->GeneralControl;
+}
+
+/* Run after INIT/workspace bytes have been restored, before the next title.
+ * Earlier adoption would detach admission bits still needed by staged copies.
+ * Split this known extent out of a maximal restored run so neighbors retain
+ * their ownership when the title unpersists and frees the saved image. */
+VOID NTAPI
+NxkAvAdoptSavedAllocation(const NX_AV_HANDOFF *State)
+{
+    extern BOOLEAN NxkMmAdoptRestored(PVOID Alias, SIZE_T Size);
+    ULONG_PTR address = (ULONG_PTR)AvGetSavedDataAddress();
+    SIZE_T size = State->AllocationBytes;
+    if (!address) return;
+    if (address != State->SavedAddress || address < 0x80000000UL ||
+        address >= 0x84000000UL || (address & (PAGE_SIZE - 1)) ||
+        !size || size > 0x84000000UL - address) {
+        AvSetSavedDataAddress(NULL);
+        return;
+    }
+    size = (size + PAGE_SIZE - 1) & ~(SIZE_T)(PAGE_SIZE - 1);
+    if (!NxkMmAdoptRestored((PVOID)address, size))
+        AvSetSavedDataAddress(NULL);
+}
