+static VOID NxkAvWriteCrtc(PVOID RegisterBase, UCHAR Index, UCHAR Value)
+{
+    *(volatile UCHAR *)((ULONG_PTR)RegisterBase + NV2A_PRMCIO_CR_INDEX) = Index;
+    *(volatile UCHAR *)((ULONG_PTR)RegisterBase + NV2A_PRMCIO_CR_DATA) = Value;
+}
+
+/* Public nxdk mode identifiers describe the active area independently of
+ * framebuffer pitch. Preserve unknown modes rather than infer their size. */
+static ULONG NTAPI NxkAvModeSize(ULONG Mode)
+{
+    switch (Mode) {
+    case 0x44030307: case 0x0401010B: case 0x04010101: case 0x04010103:
+    case 0x60030307: case 0x2001010B: case 0x20010101: case 0x20010103:
+    case 0x48030314: case 0x08010119: case 0x0801010D: case 0x88070701:
+    case 0xC0060601:
+        return (640UL << 16) | 480;
+    case 0x44040408: case 0x0402020C: case 0x04020202: case 0x04020204:
+    case 0x60040408: case 0x2002020C: case 0x20020202: case 0x20020204:
+    case 0x48040415: case 0x0802021A: case 0x0802020E: case 0x88080801:
+        return (720UL << 16) | 480;
+    case 0xC0030303: return (800UL << 16) | 600;
+    case 0xC0040404: return (1024UL << 16) | 768;
+    case 0x880B0A02: return (1280UL << 16) | 720;
+    default: return 0;
+    }
