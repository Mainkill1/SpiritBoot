diff --git a/tests/host/av-saved-image/check.py b/tests/host/av-saved-image/check.py
new file mode 100644
index 00000000..111cae00
--- /dev/null
+++ b/tests/host/av-saved-image/check.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""Execute the production saved-image capture/restore on controlled MMIO/RAM admission."""
+from pathlib import Path
+import os
+import re
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1])
+out.mkdir(parents=True, exist_ok=True)
+source = (root / 'hal/halx86/xbox/av.c').read_text()
+
+def body(name):
+    match = re.search(r'(?:PVOID|VOID|ULONG) NTAPI\s+' + name + r'\s*\([^;]*?\)\s*\{', source)
+    assert match, 'missing production function: ' + name
+    end = source.index('{', match.start()) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[match.start():end]
+
+shim = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+typedef void VOID, *PVOID;
+typedef uint32_t ULONG;
+typedef uint8_t UCHAR;
+typedef uintptr_t ULONG_PTR;
+typedef size_t SIZE_T;
+typedef int BOOLEAN;
+#define NTAPI
+#define CODE_SEG(x)
+#define _In_
+#define _In_opt_
+#define PAGE_SIZE 4096
+#define PAGE_SHIFT 12
+#define RtlZeroMemory(p,n) memset(p,0,n)
+#define UNREFERENCED_PARAMETER(x) ((void)(x))
+#define NV2A_PCRTC_START 0x600800
+#define NV2A_PRMCIO_CR_INDEX 0x6013d4
+#define NV2A_PRMCIO_CR_DATA 0x6013d5
+static PVOID NxkAvSavedDataAddress;
+static ULONG NxkAvDisplayMode, NxkAvSourceFormat, NxkAvPitch;
+static SIZE_T live, restored;
+static int adjacent;
+static int adopt_available = 1, adopt_calls;
+static SIZE_T adopted;
+SIZE_T NxMmQueryAllocationSize(PVOID address)
+{ return address == (PVOID)0x82000000UL ? live : 0; }
+SIZE_T NxkMmQueryRestored(PVOID address)
+{ return !adjacent && address == (PVOID)0x82000000UL ? restored : 0; }
+BOOLEAN NxkMmPersistentPage(ULONG_PTR page)
+{ return (adjacent && page == 0x1fff) ||
+         (page >= 0x2000 && page - 0x2000 < restored / PAGE_SIZE); }
+BOOLEAN NxkMmAdoptRestored(PVOID address, SIZE_T size)
+{
+    ++adopt_calls;
+    assert(address == (PVOID)0x82000000UL);
+    if (!adopt_available) return 0;
+    adopted = size;
+    return 1;
+}
+ULONG AvSetDisplayMode(PVOID, ULONG, ULONG, ULONG, ULONG, ULONG);
+'''
+
+main = r'''
+#define SCANOUT (*(volatile ULONG *)0xfd600800UL)
+static void boot(void) { AvSetSavedDataAddress(NULL); SCANOUT = 0x03c00000; }
+int main(void)
+{
+    void *mmio = mmap((void *)0xfd000000UL, 0x800000, PROT_READ|PROT_WRITE,
+        MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE, -1, 0);
+    assert(mmio != MAP_FAILED);
+    NX_AV_HANDOFF state;
+    live = 1228864;
+    AvSetSavedDataAddress((PVOID)0x82000000UL);
+    AvSetDisplayMode(mmio, 0, 0x88070701, 30, 2560, 0x02000040);
+    NxkAvCaptureState(&state);
+    assert(state.SavedAddress == 0x82000000 && state.AllocationBytes == 1228864);
+    boot(); restored = 1232896;
+    NxkAvRestoreState(&state);
+    assert(AvGetSavedDataAddress() == (PVOID)0x82000000UL && SCANOUT == 0x02000040);
+    boot(); adjacent = 1; NxkAvRestoreState(&state);
+    assert(AvGetSavedDataAddress() == (PVOID)0x82000000UL && SCANOUT == 0x02000040);
+    adjacent = 0;
+    assert(adopt_calls == 0); /* Staged copies still need their admission bits. */
+    NxkAvAdoptSavedAllocation(&state);
+    assert(adopt_calls == 1 && adopted == 1232896);
+    assert(AvGetSavedDataAddress() == (PVOID)0x82000000UL);
+    adopt_available = 0; NxkAvAdoptSavedAllocation(&state);
+    assert(AvGetSavedDataAddress() == NULL);
+    NxkAvAdoptSavedAllocation(&state); assert(adopt_calls == 2);
+    adopt_available = 1;
+
+    boot(); restored = 0; NxkAvRestoreState(&state);
+    assert(AvGetSavedDataAddress() == NULL && SCANOUT == 0x03c00000);
+    boot(); restored = 4096; NxkAvRestoreState(&state);
+    assert(AvGetSavedDataAddress() == NULL && SCANOUT == 0x03c00000);
+    restored = 1232896;
+    NX_AV_HANDOFF invalid = state;
+    invalid.SavedAddress = 0x7ffff000; NxkAvRestoreState(&invalid);
+    assert(AvGetSavedDataAddress() == NULL);
+    invalid = state; invalid.AllocationBytes = 0xffffffff; NxkAvRestoreState(&invalid);
+    assert(AvGetSavedDataAddress() == NULL);
+    invalid = state; invalid.FrameBuffer = 0x03f00000; NxkAvRestoreState(&invalid);
+    assert(AvGetSavedDataAddress() == (PVOID)0x82000000UL && SCANOUT == 0x03c00000);
+    boot(); invalid = state; invalid.Pitch = invalid.AllocationBytes;
+    NxkAvRestoreState(&invalid);
+    assert(SCANOUT == 0x03c00000);
+    boot(); NxkAvCaptureState(&invalid);
+    assert(invalid.SavedAddress == 0 && invalid.AllocationBytes == 0);
+    AvSetSavedDataAddress((PVOID)0x82000000UL); live = 0;
+    NxkAvCaptureState(&invalid); assert(invalid.SavedAddress == 0);
+    puts("saved image capture/restore: admitted RAM, missing/short RAM, stale ranges, scanout bounds and clear pass");
+}
+'''
+text = shim + (root/'boot/nxldr/av-handoff.h').read_text()
+for name in ('AvGetSavedDataAddress', 'AvSetSavedDataAddress', 'AvSetDisplayMode',
+             'NxkAvCaptureState', 'NxkAvRestoreState', 'NxkAvAdoptSavedAllocation'):
+    text += '\n' + body(name)
+unit = out/'check.c'; binary = out/'check'
+unit.write_text(text + main)
+subprocess.run(['cc','-std=c11','-D_GNU_SOURCE','-O2','-g','-Wall','-Wextra','-Werror',
+                # The fixed 32-bit MMIO window overlaps ASan's shadow gap.
+                '-Wno-int-to-pointer-cast','-fsanitize=undefined',
+                '-fno-omit-frame-pointer',str(unit),'-o',str(binary)],check=True)
+subprocess.run([str(binary)],check=True,env=dict(os.environ,ASAN_OPTIONS='detect_leaks=0'))
