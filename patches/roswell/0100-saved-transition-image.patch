+static UCHAR NxkAvReadCrtc(PVOID RegisterBase, UCHAR Index)
+{
+    *(volatile UCHAR *)((ULONG_PTR)RegisterBase + NV2A_PRMCIO_CR_INDEX) = Index;
+    return *(volatile UCHAR *)((ULONG_PTR)RegisterBase + NV2A_PRMCIO_CR_DATA);
