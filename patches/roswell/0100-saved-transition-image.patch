diff --git a/tests/xbe/saved-image/main.c b/tests/xbe/saved-image/main.c
new file mode 100644
index 00000000..6b5411cf
--- /dev/null
+++ b/tests/xbe/saved-image/main.c
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Independent public-API characterization. No reference implementation input.
+ * Reproduces the observed Morrowind public AV/persistence/quick-launch chain.
+ */
+#include <xboxkrnl/xboxkrnl.h>
+#include <hal/video.h>
+#include <hal/xbox.h>
+#include <string.h>
+#include <stdio.h>
+#include "../api-regression/tap.h"
+
+#define MAGIC 0x53495031UL
+#define BYTES (640 * 480 * 4)
+#define HEADER_BYTES 64
+#define SCANOUT (*(volatile ULONG *)0xFD600800UL)
+typedef struct {
+    ULONG magic, pointer, physical, allocation, scanout, before, after, mode_geometry;
+} State;
+static UCHAR cr_read(UCHAR index)
+{
+    *(volatile UCHAR *)0xfd6013d4 = index;
+    return *(volatile UCHAR *)0xfd6013d5;
+}
+static void check(ULONG n, BOOLEAN pass, const char *name)
+{
+    if (pass) tap_ok(n, name); else tap_not_ok(n, name);
+}
+static void stop(void)
+{
+    tap_puts("# saved_image_probe_finished\n");
+    tap_drain();
+    HalWriteSMBusValue(0x20, 0x02, FALSE, 0x80);
+    for (;;) __asm__ __volatile__("hlt");
+}
+static ULONG pixel(ULONG i)
+{
+    ULONG x = i % 640, y = i / 640;
+    return 0xff000000UL | ((x & 255) << 16) | ((y & 255) << 8) | ((x ^ y) & 255);
+}
+int main(void)
+{
+    State state = {0};
+    if (LaunchDataPage) memcpy(&state, LaunchDataPage->LaunchData, sizeof(state));
+    if (state.magic == MAGIC) {
+        ULONG scanout = SCANOUT;
+        UCHAR cr1 = cr_read(1), cr7 = cr_read(7), cr12 = cr_read(0x12), cr28 = cr_read(0x28);
+        ULONG width = (cr1 + 1) * 8;
+        ULONG height = (cr12 | ((cr7 & 2) << 7) | ((cr7 & 0x40) << 3)) + 1;
+        char dimensions[160];
+        snprintf(dimensions, sizeof(dimensions), "# geometry_after width=%lu height=%lu depth=%u\n", width, height, cr28 & 3);
+        tap_puts(dimensions);
+        PVOID saved = AvGetSavedDataAddress();
+        PULONG record = saved ? (PULONG)saved : (PULONG)state.pointer;
+        PULONG image = (PULONG)((PUCHAR)record + HEADER_BYTES);
+        tap_puts("# saved_image_stage2\n");
+        check(4, saved != NULL, "saved image is discoverable after quick title relaunch");
+        BOOLEAN contents = TRUE;
+        for (ULONG i = 0; i < BYTES / 4; ++i) if (image[i] != pixel(i)) { contents = FALSE; break; }
+        check(5, contents, "every retained image pixel survives relaunch");
+        check(6, MmQueryAllocationSize(record) == ((state.allocation + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1)),
+              "retained image keeps its allocation ownership");
+        ULONG physical = MmGetPhysicalAddress(record);
+        PVOID competitor = MmAllocateContiguousMemoryEx(PAGE_SIZE, physical,
+                physical + PAGE_SIZE - 1, PAGE_SIZE, PAGE_READWRITE);
+        check(7, competitor == NULL, "retained image cannot be allocated to a new owner");
+        if (competitor) MmFreeContiguousMemory(competitor);
+        check(8, scanout == physical + HEADER_BYTES, "scanout still addresses the retained image");
+        char diagnostic[240];
+        snprintf(diagnostic, sizeof(diagnostic), "# warm pointer=%08lx saved=%08lx physical=%08lx bytes=%lu scanout_before=%08lx scanout_after=%08lx\n",
+                   state.pointer, (ULONG)saved, state.physical, state.allocation, state.scanout, scanout);
+        tap_puts(diagnostic);
+        AvSetSavedDataAddress(NULL);
+        check(9, AvGetSavedDataAddress() == NULL, "next owner clears the saved address");
+        MmPersistContiguousMemory(record, MmQueryAllocationSize(record), FALSE);
+        MmFreeContiguousMemory(record);
+        PULONG before = (PULONG)state.before, after = (PULONG)state.after;
+        BOOLEAN neighbors = MmQueryAllocationSize(before) == PAGE_SIZE &&
+                MmQueryAllocationSize(after) == PAGE_SIZE;
+        for (ULONG i = 0; i < PAGE_SIZE / 4; ++i)
+            if (before[i] != (0x53555050 ^ i) || after[i] != (0x53555050 ^ i)) neighbors = FALSE;
+        check(10, neighbors, "freeing saved image preserves neighboring persistent owners");
+        PVOID competingBefore = MmAllocateContiguousMemoryEx(PAGE_SIZE,
+                MmGetPhysicalAddress(before), MmGetPhysicalAddress(before) + PAGE_SIZE - 1,
+                PAGE_SIZE, PAGE_READWRITE);
+        PVOID competingAfter = MmAllocateContiguousMemoryEx(PAGE_SIZE,
+                MmGetPhysicalAddress(after), MmGetPhysicalAddress(after) + PAGE_SIZE - 1,
+                PAGE_SIZE, PAGE_READWRITE);
+        check(11, competingBefore == NULL && competingAfter == NULL,
+                "freeing saved image keeps neighboring pages exclusive");
+        if (competingBefore) MmFreeContiguousMemory(competingBefore);
+        if (competingAfter) MmFreeContiguousMemory(competingAfter);
+        ULONG reclaimedBytes = (state.allocation + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1);
+        PVOID reclaimed = MmAllocateContiguousMemoryEx(reclaimedBytes, physical,
+                physical + reclaimedBytes - 1, PAGE_SIZE, PAGE_READWRITE);
+        check(12, reclaimed != NULL, "next owner can reclaim the entire saved allocation");
+        if (reclaimed) MmFreeContiguousMemory(reclaimed);
+        check(13, width == 640 && height == 480 && (cr28 & 3) == 3,
+                "retained image keeps its 640x480 32-bit display geometry");
+        check(14, state.mode_geometry, "AvSetDisplayMode programs the retained image geometry");
+        MmPersistContiguousMemory(before, PAGE_SIZE, FALSE);
+        MmPersistContiguousMemory(after, PAGE_SIZE, FALSE);
+        MmFreeContiguousMemory(before); MmFreeContiguousMemory(after);
+        stop();
+    }
+    tap_version(14); tap_plan(14);
+    if (!XVideoSetMode(640,480,32,REFRESH_DEFAULT)) {
+        tap_not_ok(1,"required video mode is available"); stop();
+    }
+    PULONG record = MmAllocateContiguousMemoryEx(BYTES + HEADER_BYTES, 0x02000000,
+                0x02000000 + ((BYTES + HEADER_BYTES + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1)) - 1,
+                                                PAGE_SIZE, PAGE_READWRITE | PAGE_WRITECOMBINE);
+    if (!record) { tap_not_ok(1,"owned saved image is available"); stop(); }
+    state.pointer = (ULONG)record;
+    state.physical = MmGetPhysicalAddress(record);
+    state.allocation = MmQueryAllocationSize(record);
+    ULONG rounded = (state.allocation + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1);
+    PULONG before = MmAllocateContiguousMemoryEx(PAGE_SIZE, state.physical - PAGE_SIZE,
+            state.physical - 1, PAGE_SIZE, PAGE_READWRITE);
+    PULONG after = MmAllocateContiguousMemoryEx(PAGE_SIZE, state.physical + rounded,
+            state.physical + rounded + PAGE_SIZE - 1, PAGE_SIZE, PAGE_READWRITE);
+    if (!before || !after) { tap_puts("Bail out! exact neighboring pages unavailable\n"); stop(); }
+    state.before = (ULONG)before; state.after = (ULONG)after;
+    for (ULONG i = 0; i < PAGE_SIZE / 4; ++i) before[i] = after[i] = 0x53555050 ^ i;
+    MmPersistContiguousMemory(before, PAGE_SIZE, TRUE);
+    MmPersistContiguousMemory(after, PAGE_SIZE, TRUE);
+    memset(record, 0, HEADER_BYTES);
+    /* Public data observed at the saved-buffer boundary: resource kind,
+     * pixel address, unlocked state, linear format, 640x480 / 2560-byte pitch.
+     * The payload below is independently generated, never a game image. */
+    record[0] = 0x81050001; record[1] = state.physical + HEADER_BYTES;
+    record[3] = 0x00011e29; record[4] = 0x271df27f;
+    PULONG image = (PULONG)((PUCHAR)record + HEADER_BYTES);
+    for (ULONG i = 0; i < BYTES / 4; ++i) image[i] = pixel(i);
+    __asm__ __volatile__("sfence" ::: "memory");
+    ULONG step = 0;
+    do { step = AvSetDisplayMode((PVOID)0xfd000000, step, 0x88070701, 30,
+                                 2560, state.physical + HEADER_BYTES); } while (step);
+    UCHAR cr1 = cr_read(1), cr7 = cr_read(7), cr12 = cr_read(0x12), cr28 = cr_read(0x28);
+    ULONG width = (cr1 + 1) * 8;
+    ULONG height = (cr12 | ((cr7 & 2) << 7) | ((cr7 & 0x40) << 3)) + 1;
+    state.mode_geometry = width == 640 && height == 480 && (cr28 & 3) == 3;
+    char dimensions[160];
+    snprintf(dimensions, sizeof(dimensions), "# geometry_before width=%lu height=%lu depth=%u\n", width, height, cr28 & 3);
+    tap_puts(dimensions);
+    state.scanout = SCANOUT;
+    PVOID other = MmAllocateContiguousMemory(PAGE_SIZE);
+    if (!other) { tap_not_ok(1,"owned saved-slot replacement is available"); stop(); }
+    AvSetSavedDataAddress(record);
+    check(1, AvGetSavedDataAddress() == record, "saved slot returns the owned image address");
+    AvSetSavedDataAddress(other);
+    check(2, AvGetSavedDataAddress() == other, "saved slot replaces the previous address");
+    AvSetSavedDataAddress(NULL);
+    check(3, AvGetSavedDataAddress() == NULL, "saved slot accepts an explicit clear");
+    MmFreeContiguousMemory(other);
+    AvSetSavedDataAddress(record);
+    MmPersistContiguousMemory(record, state.allocation, TRUE);
+    state.magic = MAGIC;
+    if (!LaunchDataPage) LaunchDataPage = MmAllocateContiguousMemory(PAGE_SIZE);
+    if (!LaunchDataPage) { tap_puts("# launch page setup failed\n"); stop(); }
+    memset(LaunchDataPage, 0, PAGE_SIZE);
+    LaunchDataPage->Header.dwLaunchDataType = 0;
+    strcpy(LaunchDataPage->Header.szLaunchPath, "\\Device\\CdRom0\\default.xbe");
+    memcpy(LaunchDataPage->LaunchData, &state, sizeof(state));
+    MmPersistContiguousMemory(LaunchDataPage, PAGE_SIZE, TRUE);
+    tap_puts("# saved_image_stage1_quick_relaunch\n"); tap_drain();
+    HalReturnToFirmware(HalQuickRebootRoutine);
+    tap_puts("# relaunch unexpectedly returned\n"); stop();
+}
