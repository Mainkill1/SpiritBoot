+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Independent display contract carried with the existing launch/RAM handoff.
+ * Addresses refer only to title-owned physical RAM aliases, never kernel state.
+ */
+#ifndef NX_AV_HANDOFF_H
+#define NX_AV_HANDOFF_H
+typedef struct _NX_AV_HANDOFF {
+    unsigned SavedAddress;
+    unsigned AllocationBytes;
+    unsigned DisplayMode;
+    unsigned SourceFormat;
+    unsigned Pitch;
+    unsigned FrameBuffer;
+} NX_AV_HANDOFF;
+#endif
