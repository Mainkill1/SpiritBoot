+/* Callers hold the PFN lock, including translation of buffer VAs, so
+ * relocation cannot race a pin. Overflow latches a permanent pin until reboot:
+ * VOID lock cannot report failure, so discarding an extra lock is unsafe. */
+BOOLEAN NxkPageSupplyCanPin(PFN_NUMBER Page, BOOLEAN Unlock)
+{
+    if (NxpLinks == NULL || Page == 0 || Page > NxpHighestPfn ||
+        (NxpLinks[Page] & NXP_FREE)) return FALSE;
+    return Unlock ? (NxpPins[Page] & (NXP_PIN_LIMIT | NXP_PIN_OVERFLOW)) != 0 :
+                    !(NxpPins[Page] & NXP_RETURN_PENDING);
+}
+BOOLEAN NxkPageSupplyIsPinned(PFN_NUMBER Page)
+{
+    return NxpLinks != NULL && Page > 0 && Page <= NxpHighestPfn &&
+           (NxpPins[Page] & (NXP_PIN_LIMIT | NXP_PIN_OVERFLOW)) != 0;
+}
+VOID NxkPageSupplyPin(PFN_NUMBER Page, BOOLEAN Unlock)
+{
+    MI_ASSERT_PFN_LOCK_HELD();
+    if (!NxkPageSupplyCanPin(Page, Unlock)) return;
+    if (NxpPins[Page] & NXP_PIN_OVERFLOW) return;
+    if (Unlock) {
+        --NxpPins[Page];
+        if (NxpPins[Page] == NXP_RETURN_PENDING) {
+            NxpPins[Page] = 0;
+            NxpPushHead(Page);
+            if (Page < NxpSpillHint) NxpSpillHint = Page;
+        }
+    } else if ((NxpPins[Page] & NXP_PIN_LIMIT) == NXP_PIN_LIMIT)
+        NxpPins[Page] |= NXP_PIN_OVERFLOW;
+    else ++NxpPins[Page];
+}
+
+/* Buffer preflight counts aliases of the same PFN before any mutation.
+ * Overflowed PFNs remain pinned regardless of subsequent locks/unlocks. */
+VOID NxkPageSupplyBeginPinBatch(VOID)
+{
+    MI_ASSERT_PFN_LOCK_HELD();
+    RtlZeroMemory(NxpPinBatch, (NxpHighestPfn + 1) * sizeof(USHORT));
+}
+BOOLEAN NxkPageSupplyRecordPin(PFN_NUMBER Page, BOOLEAN Unlock)
+{
+    MI_ASSERT_PFN_LOCK_HELD();
+    if (!NxkPageSupplyCanPin(Page, Unlock)) return FALSE;
+    if (NxpPinBatch[Page] != MAXUSHORT) ++NxpPinBatch[Page];
+    if (Unlock && !(NxpPins[Page] & NXP_PIN_OVERFLOW) &&
+        NxpPinBatch[Page] > (NxpPins[Page] & NXP_PIN_LIMIT)) return FALSE;
+    return TRUE;
+}
