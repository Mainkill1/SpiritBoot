@@ -68,22 +69,42 @@ MmFreeSystemMemory(_In_ PVOID Base, _In_ SIZE_T Size)
 
 /* LOCK / UNLOCK ************************************************************/
 
-/* No-ops: the kernel never pages out, so locking against the pager has
- * nothing to do. */
-ULONG NTAPI
-MmLockUnlockBufferPages(_In_ PVOID Base, _In_ SIZE_T Size, _In_ BOOLEAN Unlock)
+/* Public ABI uses VOID and byte physical addresses. Invalid requests are
+ * inert. Validate the whole buffer and per-PFN alias multiplicity before
+ * changing counts. Count overflow conservatively pins until reboot. */
+VOID NTAPI
+MmLockUnlockBufferPages(PVOID Base, SIZE_T Size, BOOLEAN Unlock)
 {
-    UNREFERENCED_PARAMETER(Base);
-    UNREFERENCED_PARAMETER(Size);
-    UNREFERENCED_PARAMETER(Unlock);
-    return 0;
+#ifdef NXK_MM_PHYS
+    ULONG_PTR first = (ULONG_PTR)Base & ~(PAGE_SIZE - 1), last, va;
+    KIRQL irql;
+    if (Size == 0 || Size - 1 > MAXULONG_PTR - (ULONG_PTR)Base) return;
+    last = ((ULONG_PTR)Base + Size - 1) & ~(PAGE_SIZE - 1);
+    irql = MiAcquirePfnLock();
+    NxkPageSupplyBeginPinBatch();
+    for (va = first;; va += PAGE_SIZE) {
+        ULONG_PTR pa;
+        if (!NxMmIsAddressValid((PVOID)va)) goto out;
+        pa = NxMmGetPhysicalAddress((PVOID)va);
+        if (!NxkPageSupplyRecordPin(pa >> PAGE_SHIFT, Unlock)) goto out;
+        if (va == last) break;
+    }
+    for (va = first;; va += PAGE_SIZE) {
+        NxkPageSupplyPin(NxMmGetPhysicalAddress((PVOID)va) >> PAGE_SHIFT, Unlock);
+        if (va == last) break;
+    }
+out:
+    MiReleasePfnLock(irql);
+#endif
 }
-ULONG NTAPI
-MmLockUnlockPhysicalPage(_In_ ULONG_PTR Pfn, _In_ BOOLEAN Unlock)
+VOID NTAPI
+MmLockUnlockPhysicalPage(ULONG_PTR PhysicalAddress, BOOLEAN Unlock)
 {
-    UNREFERENCED_PARAMETER(Pfn);
-    UNREFERENCED_PARAMETER(Unlock);
-    return 0;
+#ifdef NXK_MM_PHYS
+    KIRQL irql = MiAcquirePfnLock();
+    NxkPageSupplyPin(PhysicalAddress >> PAGE_SHIFT, Unlock);
+    MiReleasePfnLock(irql);
+#endif
 }
 
