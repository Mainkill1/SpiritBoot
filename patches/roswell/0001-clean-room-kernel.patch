diff --git a/tests/host/clean-room/shutdown.c b/tests/host/clean-room/shutdown.c
new file mode 100644
index 0000000000000000000000000000000000000000..45d176468fb2f136dc6f1eceb7bef129406ee472
--- /dev/null
+++ b/tests/host/clean-room/shutdown.c
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <stdio.h>
+#include "ntoskrnl.h"
+#include "../../../ntoskrnl/xb/shutdown.c"
+static unsigned count, seen[8], checks, failed;
+static NX_SHUTDOWN_REGISTRATION regs[6];
+static BOOLEAN raise_unexpected;
+#define CHECK(c) do { ++checks; if (!(c)) { ++failed; printf("not ok %u - %s\n", checks, #c); } else printf("ok %u - %s\n", checks, #c); } while(0)
+static void callback(NX_SHUTDOWN_REGISTRATION *r)
+{
+    unsigned id = (unsigned)(r - regs);
+    seen[count++] = id;
+    if (raise_unexpected) RtlRaiseStatus((NTSTATUS)0xE0771234);
+    if (id == 0) {
+        HalRegisterShutdownNotification(&regs[4], FALSE); /* detached pending */
+        HalRegisterShutdownNotification(&regs[5], TRUE); /* ignored in drain */
+        NxkShutdownNotifications(); /* nested drain inert */
+    }
+}
+int main(void)
+{
+    for (unsigned i=0; i<6; ++i) { regs[i].NotificationRoutine=callback; regs[i].Priority=i<2 ? 100 : 20-(LONG)i; }
+    HalRegisterShutdownNotification(&regs[5], FALSE); /* uninitialized links */
+    for (unsigned i=0; i<5; ++i) HalRegisterShutdownNotification(&regs[i], TRUE);
+    HalRegisterShutdownNotification(&regs[0], TRUE);
+    HalRegisterShutdownNotification(&regs[1], TRUE);
+    HalRegisterShutdownNotification(&regs[3], FALSE);
+    CHECK(regs[0].ListEntry.Flink == &regs[1].ListEntry);
+    NxkShutdownNotifications();
+    CHECK(count == 3);
+    CHECK(seen[0] == 0 && seen[1] == 1 && seen[2] == 2);
+    CHECK(IsListEmpty(&NxRegistered) && IsListEmpty(&NxPending));
+    CHECK(regs[0].ListEntry.Flink == &regs[0].ListEntry);
+    CHECK(HostCriticalDepth[1]==0&&NxCallbackThread==NULL);
+    NxkShutdownNotifications(); CHECK(count == 3);
+    CHECK(HostCriticalDepth[1]==0&&NxCallbackThread==NULL);
+    /* An unrelated callback exception propagates while finally balances
+     * suppression and clears the owner before any normal APC can resume. */
+    NxShuttingDown=FALSE;raise_unexpected=TRUE;
+    HalRegisterShutdownNotification(&regs[0],TRUE);
+    BOOLEAN caught=FALSE;
+    _SEH2_TRY {
+        NxkShutdownNotifications();
+    } _SEH2_EXCEPT(_SEH2_GetExceptionCode()==(NTSTATUS)0xE0771234 ? 1 : 0) {
+        caught=TRUE;
+    } _SEH2_END;
+    CHECK(caught&&HostCriticalDepth[1]==0&&NxCallbackThread==NULL);
+    printf("shutdown host checks: %u/%u passed\n", checks-failed, checks);
+    return failed ? 1 : 0;
+}
diff --git a/tests/xbe/api-regression/io/scatter.c b/tests/xbe/api-regression/io/scatter.c
index b888307de15a3f985adf9bb6ef1d71614d224cb2..07e149207e09b35f0d952490be3459fcbfb0619e 100644
--- a/tests/xbe/api-regression/io/scatter.c
+++ b/tests/xbe/api-regression/io/scatter.c
@@ -595,6 +595,63 @@ static bool completion_apc_reports_the_whole_transfer(void)
     return true;
 }
 
+/* Both outstanding requests share a file object but own independent IOSBs,
+ * events and segment storage. Different offsets expose crossed completions. */
+static bool concurrent_async_requests_are_independent(void)
+{
+    ANSI_STRING name;
+    OBJECT_ATTRIBUTES oa;
+    IO_STATUS_BLOCK open_status, iosb[2];
+    FILE_SEGMENT_ELEMENT segments[2][3];
+    LARGE_INTEGER offsets[2];
+    HANDLE file, events[2] = {NULL, NULL};
+    PVOID pages = NULL;
+    NTSTATUS status;
+    bool ok = false;
+    if (!setup()) FAIL_SETUP();
+    pages = MmAllocateContiguousMemory(4 * PAGE_SIZE);
+    ASSERT_NOT_NULL(pages);
+    memset(pages, 0xEE, 4 * PAGE_SIZE);
+    name.Buffer = (PCHAR)SCATTER_PATH;
+    name.Length = (USHORT)strlen(SCATTER_PATH); name.MaximumLength = name.Length + 1;
+    oa.RootDirectory = NULL; oa.ObjectName = &name; oa.Attributes = OBJ_CASE_INSENSITIVE;
+    status = NtCreateFile(&file, GENERIC_READ, &oa, &open_status, NULL,
+        FILE_ATTRIBUTE_NORMAL, 0, FILE_OPEN,
+        FILE_NO_INTERMEDIATE_BUFFERING | FILE_NON_DIRECTORY_FILE);
+    if (!NT_SUCCESS(status)) goto free_pages;
+    for (unsigned i = 0; i < 2; ++i) {
+        status = NtCreateEvent(&events[i], NULL, NotificationEvent, FALSE);
+        if (!NT_SUCCESS(status)) goto close;
+        segments[i][0].Buffer = (PUCHAR)pages + i * 2 * PAGE_SIZE;
+        segments[i][1].Buffer = (PUCHAR)pages + (i * 2 + 1) * PAGE_SIZE;
+        segments[i][2].Buffer = NULL;
+        offsets[i].QuadPart = (LONGLONG)i * PAGE_SIZE;
+        iosb[i].Status = STATUS_PENDING; iosb[i].Information = 0;
+    }
+    for (unsigned i = 0; i < 2; ++i) {
+        status = NtReadFileScatter(file, events[i], NULL, NULL, &iosb[i],
+                                   segments[i], 2 * PAGE_SIZE, &offsets[i]);
+        if (status != STATUS_PENDING && !NT_SUCCESS(status)) goto close;
+    }
+    /* Reverse wait order so request one cannot borrow request zero's state. */
+    for (unsigned n = 2; n-- > 0;) {
+        status = NtWaitForSingleObject(events[n], FALSE, NULL);
+        if (!NT_SUCCESS(status) || iosb[n].Status != STATUS_SUCCESS ||
+            iosb[n].Information != 2 * PAGE_SIZE) goto close;
+        for (unsigned p = 0; p < 2; ++p)
+            for (unsigned b = 0; b < PAGE_SIZE; ++b)
+                if (((PUCHAR)segments[n][p].Buffer)[b] != page_tag(n + p)) goto close;
+    }
+    ok = true;
+close:
+    for (unsigned i = 0; i < 2; ++i) if (events[i]) NtClose(events[i]);
+    NtClose(file);
+free_pages:
+    MmFreeContiguousMemory(pages);
+    if (!ok) FAIL_AND_RETURN("concurrent scatter state/data mismatch: %08lx", status);
+    return true;
+}
+
 static bool leaves_no_scratch_file(void)
 {
     IO_STATUS_BLOCK iosb;
@@ -630,6 +687,7 @@ static const test_entry_t io_scatter_entries[] = {
       asynchronous_handle_signals_its_event, NULL },
     { "completion_apc_reports_the_whole_transfer",
       completion_apc_reports_the_whole_transfer, NULL },
+    { "concurrent_async_requests_are_independent", concurrent_async_requests_are_independent, NULL },
     { "leaves_no_scratch_file",       leaves_no_scratch_file,       NULL },
 };
 
