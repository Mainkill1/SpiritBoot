+        NXK_CONTIG_ENTRY *e = &NxContigTable[i];
+        ULONG_PTR start = (ULONG_PTR)e->Alias;
+        if (e->Alias && base >= start && base - start < e->Size &&
+            NumberOfBytes <= e->Size - (base - start)) {
+            NxkMmSetPersistentPages(e->Pa + base - start, NumberOfBytes, Persist);
+            KeReleaseSpinLock(&NxContigLock, irql); return;
+        }
+    }
+    /* Restored run may be marked/unmarked by the next title as well. */
+    if (base >= NXK_KSEG0_BASE && base < NXK_KSEG0_BASE + NXK_KSEG0_RAM_SIZE) {
+        ULONG_PTR start = base & ~(PAGE_SIZE - 1);
+        while (start > NXK_KSEG0_BASE &&
+               NxkMmPersistentPage((start - NXK_KSEG0_BASE) / PAGE_SIZE - 1))
+            start -= PAGE_SIZE;
+        restored = NxkMmQueryRestored((PVOID)start);
+        if (restored && base - start < restored && NumberOfBytes <= restored - (base - start))
+            NxkMmSetPersistentPages(base - NXK_KSEG0_BASE, NumberOfBytes, Persist);
+    }
+    KeReleaseSpinLock(&NxContigLock, irql);
+}
+
+/* Adopt the original launch-data page into ordinary allocation tracking;
+ * this avoids retaining an orphaned old launch page on every warm reboot. */
+BOOLEAN NxkMmAdoptRestored(PVOID Alias, SIZE_T Size)
+{
+    ULONG slot;
+    ULONG_PTR pa = (ULONG_PTR)Alias - NXK_KSEG0_BASE, check;
+    KIRQL irql, pfnIrql;
+    if ((pa & (PAGE_SIZE - 1)) || Size == 0 || (Size & (PAGE_SIZE - 1)) ||
+        pa >= NXK_KSEG0_RAM_SIZE || Size > NXK_KSEG0_RAM_SIZE - pa) return FALSE;
+    if (!NxpContigTakeSlot(&slot, &irql)) return FALSE;
+    pfnIrql = MiAcquirePfnLock();
+    for (check = pa; check < pa + Size; check += PAGE_SIZE)
+        if (!NxkMmPersistentPage(check >> PAGE_SHIFT)) break;
+    if (check != pa + Size) {
+        MiReleasePfnLock(pfnIrql); KeReleaseSpinLock(&NxContigLock, irql); return FALSE;
+    }
+    NxkMmDetachRestored(pa, Size);
+    NxpRecordHeapContigLocked(slot, Alias, pa, Size, Size);
+    MiReleasePfnLock(pfnIrql); KeReleaseSpinLock(&NxContigLock, irql); return TRUE;
 }
 
