diff --git a/tests/host/zero-alias/check.py b/tests/host/zero-alias/check.py
new file mode 100644
index 0000000000000000000000000000000000000000..953488177bac38380be5cb35b2255b77136d739b
--- /dev/null
+++ b/tests/host/zero-alias/check.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Test the live-PDE alias guard and production zero-path dispatch."""
+from pathlib import Path
+import subprocess,importlib.util,sys
+sys.dont_write_bytecode=True
+root=Path(__file__).resolve().parents[3];out=Path(sys.argv[1]).resolve();out.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('extract',root/'tests/host/kernel-performance/check.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
+init=(root/'ntoskrnl/xb/mm/init.c').read_text();supply=(root/'ntoskrnl/xb/mm/pagesupply.c').read_text()
+try: guard=m.function(init,'NxkTryGetVerifiedWbDirectAlias')
+except AssertionError:
+ guard='PVOID NxkTryGetVerifiedWbDirectAlias(PFN_NUMBER p) {(void)p;return NULL;}\n'
+body=guard+m.function(supply,'NxkPageSupplyTakeZero')
+shim=r'''
+#include <stdint.h>
+#include <stddef.h>
+#include <assert.h>
+#include <stdio.h>
+typedef uint32_t ULONG,PFN_NUMBER;
+typedef uintptr_t ULONG_PTR;
+typedef void *PVOID;
+#define NTAPI
+#define NXK_KSEG0_BASE 0x80000000u
+#define NXK_KSEG0_RAM_SIZE 0x04000000u
+#define PAGE_SHIFT 12
+#define PAGE_SIZE 4096u
+#define NXK_PDE_LARGE 0x83u
+static uint32_t pdes[1024];
+#define NXK_PDE_BASE ((uintptr_t)pdes)
+static uintptr_t NxWbDirectMapLimit;
+static unsigned frame,direct,fallback;
+static PFN_NUMBER NxkPageSupplyTakeAny(ULONG color){(void)color;return frame;}
+static void KeZeroPages(void *p,unsigned n){assert((uintptr_t)p==0x80001000&&n==4096);direct++;}
+static void MiZeroPhysicalPage(PFN_NUMBER p){assert(p==frame);fallback++;}
+'''
+main=r'''
+int main(void){
+ frame=1;pdes[512]=0x83;NxWbDirectMapLimit=0;
+ assert(NxkPageSupplyTakeZero(0)==1&&fallback==1&&!direct);
+ NxWbDirectMapLimit=0x82c00000;
+ if(NxkTryGetVerifiedWbDirectAlias(1)!=(void*)0x80001000){fprintf(stderr,"FAIL verified low WB frame has no direct alias\n");return 1;}
+ NxkPageSupplyTakeZero(0);assert(direct==1&&fallback==1);
+ unsigned bad[]={0,0x81,0x3,0x8b,0x93,0x1083,0x2083,0x200083,0x400083};
+ for(unsigned i=0;i<sizeof(bad)/sizeof(*bad);i++){pdes[512]=bad[i];assert(!NxkTryGetVerifiedWbDirectAlias(1));}
+ pdes[512]=0x183;assert(NxkTryGetVerifiedWbDirectAlias(1)==(void*)0x80001000); /* global WB */
+ pdes[522]=0x02800083;assert(NxkTryGetVerifiedWbDirectAlias(0x2bff)==(void*)0x82bff000);
+ assert(!NxkTryGetVerifiedWbDirectAlias(0x2c00));
+ assert(!NxkTryGetVerifiedWbDirectAlias(0x4000));
+ assert(!NxkTryGetVerifiedWbDirectAlias(0x7fff));
+ assert(!NxkTryGetVerifiedWbDirectAlias(0xffffffff));
+ frame=0x7fff;NxkPageSupplyTakeZero(0);assert(fallback==2);
+ frame=0;NxkPageSupplyTakeZero(0);assert(fallback==2&&direct==1);
+ puts("zero alias: live mapping, initialization, writable/WB flags, physical identity, cap and upper RAM PASS");
+}
+'''
+(out/'zero.c').write_text(shim+body+main)
+subprocess.run(['cc','-std=c11','-O2','-Wall','-Wextra','-Werror','-Wno-unused-function',str(out/'zero.c'),'-o',str(out/'zero')],check=True)
+subprocess.run([str(out/'zero')],check=True)
