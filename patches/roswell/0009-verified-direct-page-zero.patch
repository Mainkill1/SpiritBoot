--- a/ntoskrnl/xb/mm/init.c
+++ b/ntoskrnl/xb/mm/init.c
@@ -38,6 +38,7 @@ NxpMapLargePage(ULONG VirtualAddress, ULONG PhysicalAddress, ULONG Flags)
 /* WINDOW SETUP STATE *******************************************************/
 
 static LONG NxWindowsReady = 0;
+static ULONG_PTR NxWbDirectMapLimit;
 static volatile LONG NxMmioWindowReady;
 
 /* Set by Phase1Initialization (ex/init.c) right after it runs the
@@ -662,10 +663,34 @@ NxkMmEnsureMmioWindow(VOID)
  * the end of Phase 1 init, just before XeRunInitialTitle spawns the
  * title.
  */
+PVOID
+NxkTryGetVerifiedWbDirectAlias(PFN_NUMBER Page)
+{
+    ULONG_PTR Va;
+    ULONG Entry;
+
+    if (Page == 0 || Page >= (NXK_KSEG0_RAM_SIZE >> PAGE_SHIFT))
+        return NULL;
+    Va = NXK_KSEG0_BASE + ((ULONG_PTR)Page << PAGE_SHIFT);
+    if (Va >= NxWbDirectMapLimit)
+        return NULL;
+
+    /* Require the live writable, WB identity large page. Reject PAT,
+     * PWT/PCD and extended physical-address bits as well as remappings. */
+    Entry = ((volatile ULONG *)NXK_PDE_BASE)[Va >> 22];
+    if ((Entry & NXK_PDE_LARGE) != NXK_PDE_LARGE ||
+        (Entry & 0x003FF018UL) != 0 ||
+        (Entry & 0xFFC00000UL) + (Va & 0x003FFFFFUL) !=
+            ((ULONG_PTR)Page << PAGE_SHIFT))
+        return NULL;
+    return (PVOID)Va;
+}
+
 VOID
 NxkMmEnsureXboxWindows(VOID)
 {
     ULONG Va;
+    ULONG_PTR DirectMapLimit;
 
     /* WC + UC MMIO -- idempotent, may already have run early for bootvid. */
     NxkMmEnsureMmioWindow();
@@ -695,12 +720,14 @@ NxkMmEnsureXboxWindows(VOID)
         if (Cap == 0 || Cap > NXK_KSEG0_BASE + NXK_KSEG0_RAM_SIZE)
             Cap = NXK_KSEG0_BASE + NXK_KSEG0_RAM_SIZE;
         Cap &= ~(NXK_4MB - 1);  /* round down to PSE boundary */
+        DirectMapLimit = Cap;
         for (Va = NXK_KSEG0_BASE; Va < Cap; Va += NXK_4MB)
             NxpMapLargePage(Va, Va & NXK_PHYS_MASK, NXK_PDE_LARGE);
     }
 
     /* Flush the TLB so the new entries take effect. */
     __writecr3(__readcr3());
+    NxWbDirectMapLimit = DirectMapLimit;
 
 #ifdef NXK_MM_PHYS
     NxkPageSupplyInitializeRelocation();
