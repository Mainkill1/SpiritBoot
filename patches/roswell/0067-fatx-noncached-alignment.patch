From 7fd30e1dcbd0f24b8b2a1bba0f64c7df7d24ce4f Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sat, 10 Oct 2026 17:33:22 -0700
Subject: [PATCH] FATX: enforce noncached buffer alignment

---
 drivers/filesystems/vfatfs/fsctl.c            |   6 +
 drivers/filesystems/vfatfs/rw.c               |  17 ++
 drivers/storage/partmgr/partition.c           |   2 +
 tests/xbe/fatx-noncached-alignment/Makefile   |   6 +
 tests/xbe/fatx-noncached-alignment/cases.h    |  25 +++
 tests/xbe/fatx-noncached-alignment/main.c     | 209 ++++++++++++++++++
 .../xbe/fatx-noncached-alignment/regression.h |  41 ++++
 7 files changed, 306 insertions(+)
 create mode 100644 tests/xbe/fatx-noncached-alignment/Makefile
 create mode 100644 tests/xbe/fatx-noncached-alignment/cases.h
 create mode 100644 tests/xbe/fatx-noncached-alignment/main.c
 create mode 100644 tests/xbe/fatx-noncached-alignment/regression.h

diff --git a/drivers/filesystems/vfatfs/fsctl.c b/drivers/filesystems/vfatfs/fsctl.c
index 579e42fd..aac66309 100644
--- a/drivers/filesystems/vfatfs/fsctl.c
+++ b/drivers/filesystems/vfatfs/fsctl.c
@@ -701,6 +701,12 @@ VfatMount(
     DeviceExt->StorageDevice->Vpb->RealDevice = DeviceExt->StorageDevice;
     DeviceExt->StorageDevice->Vpb->Flags |= VPB_MOUNTED;
     DeviceObject->StackSize = DeviceExt->StorageDevice->StackSize + 1;
+    if (DeviceExt->StorageDevice->AlignmentRequirement >
+        DeviceObject->AlignmentRequirement)
+    {
+        DeviceObject->AlignmentRequirement =
+            DeviceExt->StorageDevice->AlignmentRequirement;
+    }
     DeviceObject->Flags &= ~DO_DEVICE_INITIALIZING;
 
     DPRINT("FsDeviceObject %p\n", DeviceObject);
diff --git a/drivers/filesystems/vfatfs/rw.c b/drivers/filesystems/vfatfs/rw.c
index f039a6b5..de048758 100644
--- a/drivers/filesystems/vfatfs/rw.c
+++ b/drivers/filesystems/vfatfs/rw.c
@@ -727,6 +727,7 @@ VfatRead(
 {
     NTSTATUS Status;
     PVFATFCB Fcb;
+    PVOID UserBuffer;
     ULONG Length = 0;
     PERESOURCE Resource = NULL;
     LARGE_INTEGER ByteOffset;
@@ -824,6 +825,22 @@ VfatRead(
         Status = STATUS_PENDING;
         goto ByeBye;
     }
+
+    /* Xbox user-buffer probing is intentionally smaller than the desktop
+     * I/O manager path, so enforce the mounted device's direct-I/O alignment
+     * here.  Keep this after the asynchronous post decision: Complex returns
+     * STATUS_PENDING to an asynchronous issuer, then completes an unaligned
+     * request with STATUS_INVALID_PARAMETER on the filesystem worker. */
+    UserBuffer = IrpContext->Irp->MdlAddress ?
+        MmGetMdlVirtualAddress(IrpContext->Irp->MdlAddress) :
+        IrpContext->Irp->UserBuffer;
+    if (NoCache && !PagingIo && !IsVolume &&
+        ((ULONG_PTR)UserBuffer &
+         IrpContext->DeviceObject->AlignmentRequirement) != 0)
+    {
+        Status = STATUS_INVALID_PARAMETER;
+        goto ByeBye;
+    }
 #endif
 
     if (IsVolume)
diff --git a/drivers/storage/partmgr/partition.c b/drivers/storage/partmgr/partition.c
index 49ec76cc..e6b769ee 100644
--- a/drivers/storage/partmgr/partition.c
+++ b/drivers/storage/partmgr/partition.c
@@ -69,6 +69,8 @@ PartitionCreateDevice(
     // partitionDevice->DeviceType = /*fdoExtension->LowerDevice*/FDObject->DeviceType;
 
     partitionDevice->StackSize = FDObject->StackSize;
+    partitionDevice->AlignmentRequirement = FDObject->AlignmentRequirement;
+    partitionDevice->SectorSize = FDObject->SectorSize;
     partitionDevice->Flags |= DO_DIRECT_IO;
 
     if (PartitionStyle == PARTITION_STYLE_MBR)
