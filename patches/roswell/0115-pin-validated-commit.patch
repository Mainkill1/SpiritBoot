diff --git a/ntoskrnl/xb/mm/pagesupply.c b/ntoskrnl/xb/mm/pagesupply.c
index 2095c37..e9e32fc 100644
--- a/ntoskrnl/xb/mm/pagesupply.c
+++ b/ntoskrnl/xb/mm/pagesupply.c
@@ -371,6 +371,21 @@ VOID NxkPageSupplyPin(PFN_NUMBER Page, BOOLEAN Unlock)
     else ++NxpPins[Page];
 }
 
+/* Commit a lock only after the complete buffer was validated under the same
+ * PFN-lock hold. Pin increments cannot change page eligibility, including
+ * repeated aliases: only the count and sticky overflow bit can change. */
+VOID NxkPageSupplyCommitPin(PFN_NUMBER Page)
+{
+    MI_ASSERT_PFN_LOCK_HELD();
+    ASSERT(NxpLinks != NULL && Page > 0 && Page <= NxpHighestPfn);
+    ASSERT(!(NxpLinks[Page] & NXP_FREE));
+    ASSERT(!(NxpPins[Page] & NXP_RETURN_PENDING));
+    if (NxpPins[Page] & NXP_PIN_OVERFLOW) return;
+    if ((NxpPins[Page] & NXP_PIN_LIMIT) == NXP_PIN_LIMIT)
+        NxpPins[Page] |= NXP_PIN_OVERFLOW;
+    else ++NxpPins[Page];
+}
+
 /* These count-only transitions run under one PFN-lock hold. A failed
  * buffer request restores every accepted decrement before unlocking. No
  * ownership, mapping or free-list mutation is allowed until commit. */
