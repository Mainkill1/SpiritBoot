diff --git a/tests/host/reset-frame/cases.c b/tests/host/reset-frame/cases.c
new file mode 100644
index 00000000..4213499d
--- /dev/null
+++ b/tests/host/reset-frame/cases.c
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+int main(int argc, char **argv) {
+    assert(argc == 2);
+    int test = atoi(argv[1]);
+    static XBE_FIRMWARE_REENTRY routine = XeFwQuickReboot;
+    static const char *expected = "SFH";
+    static int action = HalRebootRoutine;
+    poison_frame[0] = UINTPTR_MAX;
+    poison_frame[1] = 0;
+    flags = EFLAGS_INTERRUPT_MASK;
+    switch (test) {
+    case 0: break;
+    case 1: routine = XeFwReboot; expected = "FH"; break;
+    case 2: routine = XeFwFatalErrorReboot; expected = "H"; break;
+    case 3: routine = XeFwHalt; expected = "FH"; action = HalHaltRoutine; break;
+    case 4: routine = (XBE_FIRMWARE_REENTRY)99; expected = "FH"; break;
+    case 5: nested = 1; expected = "A"; break;
+    case 6: irql = 2; expected = "H"; break;
+    case 7: flags = 0; expected = "H"; break;
+    default: abort();
+    }
+    if (setjmp(abort_target) == 0) XeHalReturnToFirmware(routine);
+    assert(operation_count == strlen(expected));
+    assert(memcmp(operations, expected, operation_count) == 0);
+    if (!nested) assert(reset_action == action);
+    return 0;
+}
diff --git a/tests/host/reset-frame/check.py b/tests/host/reset-frame/check.py
new file mode 100644
index 00000000..6b2ffaa0
--- /dev/null
+++ b/tests/host/reset-frame/check.py
@@ -0,0 +1,32 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production reboot entry with an invalid caller frame chain."""
+import importlib.util
+import subprocess
+import sys
+from pathlib import Path
+sys.dont_write_bytecode = True
+here = Path(__file__).resolve().parent
+root = here.parents[2]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location('extract', root/'tests/host/kernel-performance/check.py')
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+body = module.function((root/'ntoskrnl/xb/xbe.c').read_text(), 'XeHalReturnToFirmware')
+source = out/'reset.c'
+source.write_text((here/'shim.h').read_text() + body + (here/'cases.c').read_text())
+failures = []
+for debug in (0, 1):
+    binary = out/f'reset-{debug}'
+    subprocess.run(['cc', '-std=c11', '-Os', '-Wall', '-Wextra', '-Werror',
+                    f'-DDBG={debug}', str(source), '-o', str(binary)], check=True)
+    for case in range(8):
+        result = subprocess.run([str(binary), str(case)], capture_output=True, text=True)
+        print(f'DBG={debug} case={case}: {"PASS" if result.returncode == 0 else "FAIL"}', flush=True)
+        if result.returncode:
+            failures.append((debug, case, result.returncode, result.stderr))
+if failures:
+    print(failures)
+    sys.exit(1)
+print('PASS 16 production reboot-entry checks')
diff --git a/tests/host/reset-frame/shim.h b/tests/host/reset-frame/shim.h
new file mode 100644
index 00000000..ef3db4da
--- /dev/null
+++ b/tests/host/reset-frame/shim.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <setjmp.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+typedef void VOID;
+typedef int BOOLEAN, FIRMWARE_REENTRY;
+typedef unsigned long ULONG;
+typedef uintptr_t ULONG_PTR;
+typedef enum { XeFwHalt, XeFwReboot, XeFwQuickReboot, XeFwKdReboot,
+               XeFwFatalErrorReboot } XBE_FIRMWARE_REENTRY;
+#define NTAPI
+#define _In_
+#define DECLSPEC_NORETURN _Noreturn
+#define PASSIVE_LEVEL 0
+#define EFLAGS_INTERRUPT_MASK 0x200
+#define HalHaltRoutine 10
+#define HalRebootRoutine 11
+#define RTL_NUMBER_OF(a) (sizeof(a) / sizeof((a)[0]))
+static int irql, nested, reset_action;
+static unsigned flags;
+static char operations[8];
+static unsigned operation_count;
+static jmp_buf abort_target;
+static ULONG_PTR poison_frame[2];
+#define __builtin_frame_address(n) ((void)(n), (void *)poison_frame)
+static int KeGetCurrentIrql(void) { return irql; }
+static unsigned __readeflags(void) { return flags; }
+static void record(char op) {
+    assert(operation_count < sizeof(operations));
+    operations[operation_count++] = op;
+}
+BOOLEAN NTAPI NxkShutdownInProgress(void) { return nested; }
+_Noreturn VOID NTAPI NxkShutdownAbortPowerRequest(void) {
+    record('A');
+    longjmp(abort_target, 1);
+}
+static void XeStashRebootIntent(void) { record('S'); }
+static void IoShutdownSystem(int phase) { assert(phase == 1); record('F'); }
+static void HalReturnToFirmware(int action) { reset_action = action; record('H'); }
+#if DBG
+static void diagnostic(const char *format, ...) { (void)format; }
+#define XbDbg(...) diagnostic(__VA_ARGS__)
+#else
+#define XbDbg(...) ((void)0)
+#endif
