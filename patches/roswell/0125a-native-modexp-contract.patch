index 00000000..dd677b5d
--- /dev/null
+++ b/tests/xbe/modexp-contract/main.c
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Public nxdk calls only. Expected residues are independently generated by
+ * Python integer pow; the high-base fixture is 2^(32*Words-1)+123.
+ */
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include <string.h>
+#include "regression.h"
+#define CAP 516
+static ULONG arena[4][CAP],before[4][CAP];
+typedef struct Vector {ULONG words,a0,a1,e0,e1,m0,m1,r0,r1,high;} Vector;
+static const Vector vectors[]={
+ {1,0x00000005U,0x00000000U,0x00000001U,0x00000000U,0x00000011U,0x00000000U,0x00000005U,0x00000000U,0},
+ {64,0x00000005U,0x00000000U,0x00000001U,0x00000000U,0x00000011U,0x00000000U,0x00000005U,0x00000000U,0},
+ {512,0x00000005U,0x00000000U,0x00000001U,0x00000000U,0x00000011U,0x00000000U,0x00000005U,0x00000000U,0},
+ {64,0x00000007U,0x00000000U,0x00000005U,0x00000000U,0x00000064U,0x00000000U,0x00000007U,0x00000000U,0},
+ {2,0x00000005U,0x00000000U,0x00000003U,0x00000000U,0x00000012U,0x00000000U,0x00000011U,0x00000000U,0},
+ {2,0x00000005U,0x00000000U,0x00010001U,0x00000000U,0x00000011U,0x00000000U,0x00000005U,0x00000000U,0},
+ {2,0x00000064U,0x00000000U,0x00000003U,0x00000000U,0x0000000dU,0x00000000U,0x00000001U,0x00000000U,0},
+ {2,0x00000005U,0x00000000U,0x00000001U,0x00000001U,0x00000013U,0x00000000U,0x00000009U,0x00000000U,0},
+ {2,0x00000000U,0x00000000U,0x00000005U,0x00000000U,0x00000011U,0x00000000U,0x00000000U,0x00000000U,0},
+ {2,0x00000007U,0x00000000U,0x00000000U,0x00000000U,0x0000000dU,0x00000000U,0x00000001U,0x00000000U,0},
+ {512,0x0000007bU,0x00000000U,0x00000001U,0x00000000U,0x00000011U,0x00000000U,0x0000000dU,0x00000000U,1},
+ {2,0x89abcdefU,0x12345678U,0x00010001U,0x00000000U,0xffffffc5U,0xffffffffU,0x52b28714U,0x1ca85037U,0},
+ {2,0x89abcdefU,0x12345678U,0x00000003U,0x00000000U,0xffffffc4U,0xffffffffU,0xdd4a77bfU,0x7b543d9fU,0},
+};
+int main(void) {
+ regression_begin();
+ for(ULONG v=0;v<sizeof(vectors)/sizeof(vectors[0]);v++) {
+  const Vector *t=&vectors[v];
+  for(ULONG alias=0;alias<7;alias++) {
+   for(ULONG b=0;b<4;b++) {
+    for(ULONG i=0;i<CAP;i++)arena[b][i]=0x1BADC0DE;
+    arena[b][0]=0xA55A1234;
+    memset(&arena[b][1],0,t->words*sizeof(ULONG));
+   }
+   arena[0][1]=t->a0;arena[1][1]=t->e0;arena[2][1]=t->m0;
+   if(t->words>1) {arena[0][2]=t->a1;arena[1][2]=t->e1;arena[2][2]=t->m1;}
+   if(t->high)arena[0][t->words]|=0x80000000;
+   memcpy(before,arena,sizeof(arena));
+   ULONG output=alias?((alias-1)%3):3,offset=alias>=4?2:1;
+   ULONG status=XcModExp(&arena[output][offset],&arena[0][1],&arena[1][1],&arena[2][1],t->words);
+   tap_comment("modexp vector=%lu words=%lu alias=%lu status=%lu result=%08lx:%08lx",v,t->words,alias,status,arena[output][offset+1],arena[output][offset]);
+   regression_check(status==1,"modexp returns success for nonzero modulus");
+   BOOLEAN residue=arena[output][offset]==t->r0;
+   for(ULONG i=1;i<t->words;i++)if(arena[output][offset+i]!=(i==1?t->r1:0))residue=FALSE;
+   regression_check(residue,"modexp matches fixed independent residue across full output width");
+   BOOLEAN guards=TRUE,operands=TRUE;
+   for(ULONG i=0;i<CAP;i++)if((i<offset||i>=offset+t->words)&&arena[output][i]!=before[output][i])guards=FALSE;
+   for(ULONG b=0;b<4;b++)if(b!=output&&memcmp(arena[b],before[b],sizeof(arena[b])))operands=FALSE;
+   regression_check(guards,"modexp preserves output canaries");
+   regression_check(operands,"modexp preserves every non-output operand");
+  }
+ }
+ regression_finish();
+}
diff --git a/tests/xbe/modexp-contract/regression.h b/tests/xbe/modexp-contract/regression.h
new file mode 100644
index 00000000..305b1f1f
--- /dev/null
+++ b/tests/xbe/modexp-contract/regression.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "tap.h"
+#include <xboxkrnl/xboxkrnl.h>
+
+static unsigned regression_checks, regression_failures;
+
+static void regression_begin(void)
+{
+    tap_version(14);
+}
+
+static void regression_check(int passed, const char *description)
+{
+    ++regression_checks;
+    if (passed) {
+        tap_ok(regression_checks, description);
+    } else {
+        ++regression_failures;
+        tap_not_ok(regression_checks, description);
+    }
+}
+
+static void regression_finish(void) __attribute__((noreturn));
+static void regression_finish(void)
+{
+    LARGE_INTEGER delay = { .QuadPart = -5000000 };
+    tap_comment("checks=%u failures=%u", regression_checks, regression_failures);
+    tap_plan(regression_checks);
+    tap_drain();
+    KeDelayExecutionThread(KernelMode, FALSE, &delay);
+    HalWriteSMBusValue(0x20, 0x02, FALSE, 0x80);
+    /* A failed shutdown remains a timeout, never a passing capture. */
+    for (;;) __asm__ __volatile__("hlt");
+}
+
+static inline void regression_require(int passed, const char *description)
+{
+    regression_check(passed, description);
+    if (!passed) regression_finish();
+}
diff --git a/tests/xbe/modexp-contract/tap.c b/tests/xbe/modexp-contract/tap.c
new file mode 100644
index 00000000..009bb8a8
--- /dev/null
+++ b/tests/xbe/modexp-contract/tap.c
@@ -0,0 +1,166 @@
+/*
+ * TAP 14 emitter.  Bytes go out the LPC47M157 SuperIO's COM1 at 115200 8N1
+ * (I/O 0x3F8).  We program the UART ourselves at first call so the suite
+ * works against both nxkrnl (which already programs it for DbgPrint) and
+ * the retail kernel (which doesn't).  isa-debugcon (port 0xE9) was the
+ * historical target but the upstream xemu AppImage builds without it.
+ */
+
+#include "tap.h"
+#include <stdio.h>
+#include <stdarg.h>
+
+#define COM1     0x3F8
+#define COM1_THR (COM1 + 0)
+#define COM1_DLL (COM1 + 0)
+#define COM1_IER (COM1 + 1)
+#define COM1_DLH (COM1 + 1)
+#define COM1_LCR (COM1 + 3)
+#define COM1_MCR (COM1 + 4)
+#define COM1_LSR (COM1 + 5)
+
+#define LSR_THRE 0x20  /* transmit holding register empty */
+#define LSR_TEMT 0x40  /* transmitter empty (shift + holding both drained) */
+#define LCR_DLAB 0x80
+#define LCR_8N1  0x03
+
+static inline void outb(unsigned short port, unsigned char val)
+{
+    __asm__ __volatile__("outb %0, %1" : : "a"(val), "Nd"(port));
+}
+
+static inline unsigned char inb(unsigned short port)
+{
+    unsigned char ret;
+    __asm__ __volatile__("inb %1, %0" : "=a"(ret) : "Nd"(port));
+    return ret;
+}
+
+/* Xbox is single-CPU: prevent a scheduled kernel/debug writer from entering
+ * between bytes. Restore the caller's full flags, including an already-clear
+ * IF. Formatting stays outside this span; no kernel-private lock is borrowed. */
+static inline unsigned int tap_irq_save(void)
+{
+    unsigned int flags;
+    __asm__ __volatile__("pushfl; popl %0; cli" : "=r"(flags) : : "memory");
+    return flags;
+}
+
+static inline void tap_irq_restore(unsigned int flags)
+{
+    __asm__ __volatile__("pushl %0; popfl" : : "r"(flags) : "memory", "cc");
+}
+
+static void com_init(void)
+{
+    static int initialized = 0;
+    if (initialized) return;
+    initialized = 1;
+    outb(COM1_IER, 0x00);             /* disable all interrupts */
+    outb(COM1_LCR, LCR_DLAB);         /* DLAB=1 to set divisor */
+    outb(COM1_DLL, 0x01);             /* 115200 baud (1.8432 MHz / 16 / 1) */
+    outb(COM1_DLH, 0x00);
+    outb(COM1_LCR, LCR_8N1);          /* DLAB=0, 8N1 */
+    /* Retain the existing FIFO mode and queued bytes. THRE polling works
+     * with either the reset/default UART or a kernel-configured FIFO; changing
+     * FIFO enable or clearing it could discard the preceding debug message. */
+    outb(COM1_MCR, 0x0B);             /* DTR + RTS + OUT2 */
+}
+
+static void com_putc(char c)
+{
+    while ((inb(COM1_LSR) & LSR_THRE) == 0) { }
+    outb(COM1_THR, (unsigned char)c);
+}
+
+void tap_drain(void)
+{
+    while ((inb(COM1_LSR) & LSR_TEMT) == 0) { }
+}
+
+static void com_puts(const char *s)
+{
+    unsigned int flags = tap_irq_save();
+    com_init();
+    while (*s) com_putc(*s++);
+    tap_irq_restore(flags);
+}
+
+static void com_vprintf(const char *fmt, va_list ap)
+{
+    char buf[256];
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_puts(buf);
+}
+
+static void com_printf(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    com_vprintf(fmt, ap);
+    va_end(ap);
+}
+
+void tap_puts(const char *s)
+{
+    com_puts(s);
+}
+
+void tap_version(unsigned int v)
+{
+    com_printf("TAP version %u\n", v);
+}
+
+void tap_plan(unsigned int n)
+{
+    com_printf("1..%u\n", n);
+}
+
+void tap_ok(unsigned int n, const char *desc)
+{
+    com_printf("ok %u - %s\n", n, desc);
+}
+
+void tap_not_ok(unsigned int n, const char *desc)
+{
+    com_printf("not ok %u - %s\n", n, desc);
+}
+
+void tap_diag_begin(void)
+{
+    com_puts("  ---\n");
+}
+
+void tap_diag_end(void)
+{
+    com_puts("  ...\n");
+}
+
+void tap_diag_kv(const char *key, const char *fmt, ...)
+{
+    char buf[192];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_printf("  %s: %s\n", key, buf);
+}
+
+void tap_comment(const char *fmt, ...)
+{
+    char buf[192];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_printf("# %s\n", buf);
+}
diff --git a/tests/xbe/modexp-contract/tap.h b/tests/xbe/modexp-contract/tap.h
new file mode 100644
index 00000000..0f39d98a
--- /dev/null
+++ b/tests/xbe/modexp-contract/tap.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <stdarg.h>
+#include <stdbool.h>
+
+void tap_version(unsigned int v);
+void tap_plan(unsigned int n);
+void tap_ok(unsigned int n, const char *desc);
+void tap_not_ok(unsigned int n, const char *desc);
+
+/* Open / close a YAML diagnostic block underneath a `not ok` line. */
+void tap_diag_begin(void);
+void tap_diag_end(void);
+void tap_diag_kv(const char *key, const char *fmt, ...);
+
+void tap_comment(const char *fmt, ...);
+
+/* Drop a raw string verbatim (no formatting / framing).  Used for the
+ * "== api-regression begin ==" / "== ... end ==" markers in main.c so
+ * the runner can slice the TAP block out of the surrounding kernel
+ * debug stream. */
+void tap_puts(const char *s);
+
+/* Block until the UART transmitter is fully drained.  Call before
+ * issuing an SMC shutdown so the final bytes aren't lost. */
+void tap_drain(void);
