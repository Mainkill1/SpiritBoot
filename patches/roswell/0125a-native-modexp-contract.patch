+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Actual-source modexp parity and bounded work for zero-padded operands."""
+import argparse
+import ctypes as C
+import importlib.util
+import json
+from pathlib import Path
+import random
+import subprocess
+
+p=argparse.ArgumentParser();p.add_argument('source');p.add_argument('output');p.add_argument('--optimized',action='store_true');p.add_argument('--sanitized',action='store_true');args=p.parse_args()
+root=Path(args.source).resolve();out=Path(args.output).resolve();out.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('kernel_check',root/'tests/host/kernel-performance/check.py');h=importlib.util.module_from_spec(spec);spec.loader.exec_module(h)
+h.SHIM=h.SHIM.replace('(void)p;(void)t;++counters[5];', '(void)p;(void)t;++counters[5];counters[14]+=n;')
+lib=h.build(root,out)['crypto'];mod=lib.host_XcpModExp;U=C.c_uint32
+checks=0
+work={}
+def check(ok,label):
+ global checks
+ checks+=1
+ assert ok,label
+def run(words,base,exponent,modulus,alias):
+ def arena(value):
+  return (U*(words+4))(0xA55A1234,*((value>>(32*i))&0xffffffff for i in range(words)),0x1BADC0DE,0x1BADC0DE,0x1BADC0DE)
+ a,e,m,r=arena(base),arena(exponent),arena(modulus),arena(0)
+ bufs=[a,e,m,r];old=[bytes(x) for x in bufs]
+ output={'base':a,'exp':e,'mod':m,'base+1':a,'exp+1':e,'mod+1':m}.get(alias,r)
+ offset=2 if alias.endswith('+1') else 1
+ ptr=lambda arr,at=1:C.cast(C.byref(arr,at*4),C.POINTER(U))
+ lib.reset_counters();status=mod(ptr(output,offset),ptr(a),ptr(e),ptr(m),words)
+ check(status==bool(modulus),f'status W={words} M={modulus} alias={alias}')
+ after=bytes(output);start=offset*4;end=start+words*4
+ before=old[next(i for i,x in enumerate(bufs) if x is output)]
+ check(after[:start]==before[:start] and after[end:]==before[end:],f'output canaries W={words} alias={alias}')
+ for i,x in enumerate(bufs):
+  if x is not output:check(bytes(x)==old[i],f'non-output operand unchanged {i} alias={alias}')
+ if modulus:
+  check(int.from_bytes(after[start:end],'little')==pow(base,exponent,modulus),f'pow W={words} alias={alias}')
+ else:check(after==before,'zero modulus output untouched')
+ return list(lib.counters)
+# Python pow is an independent mathematical oracle; complete arena comparisons
+# catch premature writes when Result aliases an operand, including shifted aliases.
+rng=random.Random(0x20261013)
+for words in [1,2,32,64,512]:
+ cases=[(5,1,17),(100,3,13),(7,5,100),(0,0,1),(7,0,2),(0,65537,17),(5,1,0),((1<<(words*32-1))+123,1,17)]
+ if words>1:cases.append((5,(1<<32)+1,19))
+ if words<=32:
+  cases += [(rng.getrandbits(words*32),rng.choice([0,1,3,65537]),rng.getrandbits(words*32)|2) for _ in range(8)]
+ else:cases += [(rng.getrandbits(words*32),e,(1<<(words*32))-k) for e,k in [(1,59),(3,60)]]
+ for base,exp,m in cases:
+  for alias in ['none','base','exp','mod','base+1','exp+1','mod+1']:run(words,base,exp,m,alias)
+ for base,exp,m,name in [(5,1,17,'e1-odd'),(7,5,100,'even')]:work[f'{words}-{name}']=run(words,base,exp,m,'none')
+a=(U*513)(*([0xA5]*513));e=(U*513)(3);m=(U*513)(17)
+for words in [0,513]:check(mod(a,a,e,m,words)==0 and a[0]==0xA5,'word limit output untouched')
+lib.set_oom(1);check(mod(a,a,e,m,1)==0 and a[0]==0xA5,'allocation failure output untouched');lib.set_oom(0)
+(out/'work.json').write_text(json.dumps({'checks':checks,'work':work},indent=2)+'\n')
+if args.optimized:
+ for name in ['e1-odd','even']:
+  # Padding is an input representation choice, not extra arithmetic width.
+  # Removing width normalization or reduction trimming violates this budget.
+  for words in [2,32,64,512]:
+   check(work[f'{words}-{name}'][11]<=work[f'1-{name}'][11],f'zero-padding product budget W={words} {name}')
+   check(work[f'{words}-{name}'][13]<=work[f'1-{name}'][13],f'zero-padding bit reduction budget W={words} {name}')
+   check(work[f'{words}-{name}'][14]<=work[f'1-{name}'][14],f'zero-padding scratch allocation budget W={words} {name}')
+print(f'PASS modexp actual-source checks={checks} optimized={args.optimized}')
+
+if args.sanitized:
+ guest=(root/'tests/xbe/modexp-contract/main.c').read_text()
+ guest='\n'.join(line for line in guest.splitlines() if not line.startswith('#include'))
+ shim=r'''
+#include <stdio.h>
+#define XcModExp host_XcpModExp
+static unsigned sanitized_checks;
+#define tap_comment(...) ((void)0)
+static void regression_begin(void){}
+static void regression_check(int ok,const char *description){sanitized_checks++;if(!ok){fprintf(stderr,"FAIL: %s\n",description);assert(ok);}}
+static void regression_finish(void){printf("PASS 32-bit ASan/UBSan modexp public-vector checks=%u\n",sanitized_checks);}
+'''
+ unit=out/'modexp-sanitized.c';unit.write_text((out/'crypto.c').read_text()+shim+guest)
+ binary=out/'modexp-sanitized'
+ subprocess.run(['cc','-m32','-std=c11','-O1','-g','-Wall','-Wextra','-Wno-multichar','-Wno-unused-function','-fsanitize=address,undefined','-fno-omit-frame-pointer',str(unit),'-o',str(binary)],check=True)
+ subprocess.run([str(binary)],check=True)
