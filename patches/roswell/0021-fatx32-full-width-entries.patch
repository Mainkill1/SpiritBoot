 /* FUNCTIONS ****************************************************************/
 
+/* FATX32 uses all 32 entry bits; only DOS FAT32 reserves the upper nibble. */
+static
+ULONG
+FAT32EntryMask(
+    PDEVICE_EXTENSION DeviceExt)
+{
+    return DeviceExt->FatInfo.FatType == FATX32 ? 0xffffffff : 0x0fffffff;
+}
+
