+#!/usr/bin/env python3
+"""Real PE fixtures distinguish constant data from executable references."""
+from pathlib import Path
+import os
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+output = Path(sys.argv[1]).resolve()
+output.mkdir(parents=True, exist_ok=True)
+compiler = "i686-w64-mingw32-gcc"
+linker_script = root / "sdk/cmake/xbox-kernel.lds"
+allow = output / "empty.allow"
+allow.write_text("")
+
+cases = {
+    "fake-data-branch": (False, False, "PAGECONS", 0),
+    "actual-data-pointer": (True, False, "PAGECONS", 1),
+    "actual-code-branch": (False, True, "PAGECONS", 1),
+    "unknown-span": (False, False, "PAGEUNKNOWN", 1),
+}
+for name, (pointer, code_branch, section, expected) in cases.items():
+    directory = output / name
+    directory.mkdir(exist_ok=True)
+    source = directory / "fixture.S"
+    source.write_text(
+        '.text\n.globl _entry\n_entry: ret\n'
+        '.section PAGE,"x"\n.globl _runtime\n_runtime:\n' +
+        ('call _discarded\n' if code_branch else '') +
+        'ret\n.section INIT,"x"\n.globl _discarded\n_discarded: ret\n' +
+        f'.section {section},"dr"\n.p2align 2\n.globl _table\n_table:\n' +
+        ('.long _discarded\n' if pointer else
+         '.byte 0xe9\n.long _discarded - . - 4\n'))
+    exe = directory / "fixture.exe"
+    subprocess.run([compiler, "-nostdlib", "-Wl,--entry,_entry",
+                    "-Wl,--image-base,0x84000000", "-Wl,-T," + str(linker_script),
+                    str(source), "-o", str(exe)], check=True)
+    result = subprocess.run([sys.executable, str(root / "tools/init-audit.py"),
+                             "--check", str(exe), "--allow", str(allow)],
+                            capture_output=True, text=True)
+    (directory / "audit.log").write_text(result.stdout + result.stderr)
+    assert result.returncode == expected, name + ":\n" + result.stdout + result.stderr
+    if expected:
+        kind = "data" if pointer else "code"
+        assert "[" + kind + "]" in result.stdout + result.stderr, (
+            result.stdout + result.stderr)
+    print(name + ": expected audit outcome")
