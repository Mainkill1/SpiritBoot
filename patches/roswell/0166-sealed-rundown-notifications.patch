+/* Break: normal admission/retirement enters the dispatcher for a rundown
+ * event even though no teardown waiter can exist before sealing. */
+static int unsealed_reads_do_not_signal_rundown(void)
+{
+    PDEVICE_OBJECT device=make_device(2);
+    unsigned signals=__atomic_load_n(&rundown_event_calls,__ATOMIC_RELAXED);
+    for(unsigned delayed=0;delayed<2;++delayed) {
+        parent_fixture read;init_parent(&read,IRP_MJ_READ,512);
+        lower_pending=delayed;lower_calls=0;
+        CHECK(NxNativeDispatchReadWrite(device,&read.irp)==
+              (delayed ? STATUS_PENDING:STATUS_SUCCESS));
+        if(delayed) CHECK(complete_child(STATUS_SUCCESS,512,1)==STATUS_MORE_PROCESSING_REQUIRED);
+        CHECK(read.irp.host_completed&&read.irp.IoStatus.Status==STATUS_SUCCESS&&
+              read.irp.IoStatus.Information==512);
+    }
+    lower_pending=0;
+    CHECK(__atomic_load_n(&rundown_event_calls,__ATOMIC_RELAXED)==signals);
+    /* Completion before sealing needs no remembered signal: removal sees idle. */
+    CHECK(dispatch_pnp(NxNativeDispatchPnp,device,IRP_MN_REMOVE_DEVICE)==STATUS_SUCCESS);
+    CHECK(__atomic_load_n(&rundown_event_calls,__ATOMIC_RELAXED)==signals);
+    return 1;
+}
+static void complete_final_read_at_wait(PKEVENT event)
+{
+    MUST(active_child);
+    MUST(complete_child(STATUS_SUCCESS,512,1)==STATUS_MORE_PROCESSING_REQUIRED);
+    /* Fail promptly rather than hanging if final retirement loses its wake. */
+    MUST(__atomic_load_n(&event->signaled,__ATOMIC_ACQUIRE));
+}
+/* Break: filtering cold notifications also suppresses the final wake after
+ * sealing, including completion between the idle check and the actual wait. */
+static int sealed_final_completion_wakes_removal(void)
+{
+    PDEVICE_OBJECT device=make_device(2);
+    parent_fixture read;init_parent(&read,IRP_MJ_READ,512);
+    lower_pending=1;lower_calls=0;
+    CHECK(NxNativeDispatchReadWrite(device,&read.irp)==STATUS_PENDING);
+    unsigned signals=__atomic_load_n(&rundown_event_calls,__ATOMIC_RELAXED);
+    before_event_wait=complete_final_read_at_wait;
+    CHECK(dispatch_pnp(NxNativeDispatchPnp,device,IRP_MN_REMOVE_DEVICE)==STATUS_SUCCESS);
+    CHECK(!before_event_wait&&read.irp.host_completed&&
+          read.irp.IoStatus.Status==STATUS_SUCCESS&&read.irp.IoStatus.Information==512);
+    CHECK(__atomic_load_n(&rundown_event_calls,__ATOMIC_RELAXED)>signals);
+    lower_pending=0;return 1;
+}
