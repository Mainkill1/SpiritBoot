+NXDK_CFLAGS += -DNATIVE_STATE_OFFSET=$(call asm_value,ThState) -DNATIVE_WAITING=$(call asm_value,Waiting)
+NXDK_CFLAGS += -DNATIVE_PRIORITY_OFFSET=$(call asm_value,ThPriority)
