+} IOP_CALLER_IRP_SIDECAR, *PIOP_CALLER_IRP_SIDECAR;
+
+static LIST_ENTRY IopCallerIrpBuckets[IOP_IRP_SIDECAR_BUCKETS];
+static KSPIN_LOCK IopCallerIrpLock;
+static NPAGED_LOOKASIDE_LIST IopCallerIrpLookaside;
+static BOOLEAN IopCallerIrpRegistryInitialized;
+
+FORCEINLINE PIOP_XBOX_IRP_PRIVATE
+IopOwnedIrpPrivate(IN PIRP Irp)
+{
+    return (PIOP_XBOX_IRP_PRIVATE)((PUCHAR)Irp -
+                                   IOP_XBOX_IRP_PRIVATE_SIZE);
+}
+
+static PIOP_XBOX_IRP_STATE IopLookupIrpState(IN PIRP Irp);
+static PIOP_XBOX_IRP_PRIVATE IopLookupIrpPrivate(IN PIRP Irp);
+static PIOP_XBOX_IRP_PRIVATE
+IopLookupIrpPrivateAllocation(IN PIRP Irp,
+                              OUT PSIZE_T AllocationBytes OPTIONAL);
+static VOID
+IopInitializeIrpState(IN PIOP_XBOX_IRP_STATE State,
+                      IN UCHAR AllocationFlags);
+static VOID
+IopInitializeIrpPrivate(IN PIOP_XBOX_IRP_PRIVATE Private,
+                        IN UCHAR AllocationFlags);
