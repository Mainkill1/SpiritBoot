+static void test_internal_buffered_profile_round_trip(void)
+{
+    reset_counters();
+    DEVICE_OBJECT Device={DO_BUFFERED_IO,1};
+    unsigned char Written[257],Disk[257],Read[257];
+    LARGE_INTEGER Offset={0x2000};
+    IO_STATUS_BLOCK Iosb={0};
+
+    for(unsigned Index=0;Index<sizeof(Written);++Index)
+        Written[Index]=(unsigned char)(Index*37u+11u);
+    memset(Disk,0,sizeof(Disk));
+    memset(Read,0xa5,sizeof(Read));
+
+    PIRP Irp=IopBuildXboxFsdRequest(IRP_MJ_WRITE,&Device,Written,
+                                    sizeof(Written),&Offset,&Iosb);
+    assert(Irp);
+    PIOP_XBOX_IRP_PRIVATE Private=IopLookupIrpPrivate(Irp);
+    assert(Private->AssociatedIrp.SystemBuffer!=Written);
+    assert(Private->InternalFlags==(IOP_IRP_BUFFERED_IO|
+                                    IOP_IRP_DEALLOCATE_BUFFER));
+    memcpy(Disk,Private->AssociatedIrp.SystemBuffer,sizeof(Disk));
+    Irp->IoStatus.Status=STATUS_SUCCESS;
+    Irp->IoStatus.Information=sizeof(Written);
+    complete_and_release(Irp);
+
+    Irp=IopBuildXboxFsdRequest(IRP_MJ_READ,&Device,Read,sizeof(Read),
+                               &Offset,&Iosb);
+    assert(Irp);
+    Private=IopLookupIrpPrivate(Irp);
+    assert(Private->AssociatedIrp.SystemBuffer!=Read);
+    assert(Private->InternalFlags==(IOP_IRP_BUFFERED_IO|
+                                    IOP_IRP_DEALLOCATE_BUFFER|
+                                    IOP_IRP_INPUT_OPERATION));
+    memcpy(Private->AssociatedIrp.SystemBuffer,Disk,sizeof(Disk));
+    Irp->IoStatus.Status=STATUS_SUCCESS;
+    Irp->IoStatus.Information=sizeof(Read);
+    complete_and_release(Irp);
+
+    assert(memcmp(Read,Written,sizeof(Read))==0);
+    assert(PoolAllocations==2 && PoolFrees==2 && CopyCalls==2);
+    assert(IrpFrees==2 && MdlAllocations==0 && MdlFrees==0);
+}
+
+static void test_public_buffered_aliases_and_pins_without_copy(void)
+{
+    reset_counters();
+    DEVICE_OBJECT Device={DO_BUFFERED_IO,1};
