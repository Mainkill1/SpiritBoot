+#!/usr/bin/env python3
+"""Source-level gate for the public Xbox IRP ABI and FSD transport."""
+
+from pathlib import Path
+import re
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+IOTYPES = ROOT / "sdk/include/xdk/iotypes.h"
+IOFUNCS = ROOT / "sdk/include/xdk/iofuncs.h"
+IRP_C = ROOT / "ntoskrnl/io/iomgr/irp.c"
+IOMGR_C = ROOT / "ntoskrnl/io/iomgr/iomgr.c"
+XBE_C = ROOT / "ntoskrnl/xb/xbe.c"
+TARGET_ASSERTS = (
+    ROOT / "drivers/storage/class/nxstorage/geometry_target_assertions.h"
+)
+
+
+def function(source: str, name: str) -> str:
+    marker = re.search(rf"\n{name}\s*\([^;]*?\)\s*\{{", source, re.S)
+    if not marker:
+        raise AssertionError(f"missing function {name}")
+    begin = marker.start() + 1
+    brace = source.find("{", marker.start())
+    depth = 0
+    for pos in range(brace, len(source)):
+        if source[pos] == "{":
+            depth += 1
+        elif source[pos] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[begin : pos + 1]
+    raise AssertionError(f"unterminated function {name}")
+
+
+def xbox_irp_block(source: str) -> str:
+    comment = source.index("/* Titles receive real IRPs")
+    start = source.rfind("#ifdef SARCH_XBOX", 0, comment)
+    if start < 0:
+        raise AssertionError("missing Xbox IRP declaration guard")
+    # The first typedef after this guard is the target packet.
+    typedef = source.index("typedef struct", start)
+    end = source.index("#else", typedef)
+    return source[typedef:end]
+
+
+class XboxIrpContract(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.types = IOTYPES.read_text()
+        cls.funcs = IOFUNCS.read_text()
+        cls.irp = IRP_C.read_text()
+        cls.asserts = TARGET_ASSERTS.read_text()
+
+    def test_target_assertions_require_public_layout(self):
+        for expected in (
+            "sizeof(IRP) == 104",
+            "offsetof(IRP, UserBuffer) == 48",
+            "offsetof(IRP, SegmentArray) == 52",
+            "offsetof(IRP, LockedBufferLength) == 56",
+            "offsetof(IRP, Tail.Overlay.CurrentStackLocation) == 92",
+            "sizeof(IO_STACK_LOCATION) == 36",
+        ):
+            self.assertIn(expected, self.asserts)
+        self.assertNotIn("sizeof(IRP) == 128", self.asserts)
+
+    def test_public_packet_does_not_append_nt_header(self):
+        block = xbox_irp_block(self.types)
+        for forbidden in (
+            "MdlAddress", "AssociatedIrp", "RequestorMode", "CancelIrql",
+            "ApcEnvironment", "AllocationFlags", "CancelRoutine",
+        ):
+            self.assertNotIn(forbidden, block)
+        # OriginalFileObject ends at 0x64; eight-byte alignment supplies the
+        # observed zero padding dword at +0x64.
+        self.assertRegex(block, r"OriginalFileObject;[^}]*}\s*Overlay;", re.S)
+
+    def test_public_flags_use_xbox_values(self):
+        expected = {
+            "IRP_NOCACHE": "0x00000001",
+            "IRP_MOUNT_COMPLETION": "0x00000002",
+            "IRP_SYNCHRONOUS_API": "0x00000004",
+            "IRP_CREATE_OPERATION": "0x00000008",
+            "IRP_READ_OPERATION": "0x00000010",
+            "IRP_WRITE_OPERATION": "0x00000020",
+            "IRP_CLOSE_OPERATION": "0x00000040",
+            "IRP_DEFER_IO_COMPLETION": "0x00000080",
+            "IRP_OB_QUERY_NAME": "0x00000100",
+            "IRP_UNLOCK_USER_BUFFER": "0x00000200",
+            "IRP_SCATTER_GATHER_OPERATION": "0x00000400",
+            "IRP_UNMAP_SEGMENT_ARRAY": "0x00000800",
+            "IRP_NO_CANCELIO": "0x00001000",
+        }
+        match = re.search(
+            r"/\* IRP\.Flags \*/\s*#ifdef SARCH_XBOX(?P<body>.*?)#else",
+            self.types,
+            re.S,
+        )
+        self.assertIsNotNone(match, "Xbox flags need an explicit ABI branch")
+        body = match.group("body") if match else ""
+        for name, value in expected.items():
+            self.assertRegex(body, rf"#define\s+{name}\s+{value}\b")
+        for nt_only in (
+            "IRP_PAGING_IO", "IRP_ASSOCIATED_IRP", "IRP_BUFFERED_IO",
+            "IRP_DEALLOCATE_BUFFER", "IRP_INPUT_OPERATION",
+            "IRP_SYNCHRONOUS_PAGING_IO", "IRP_CLASS_CACHE_OPERATION",
+        ):
+            self.assertNotRegex(body, rf"#define\s+{nt_only}\b")
+
+    def test_initializer_uses_caller_packet_end(self):
+        body = function(self.irp, "IopInitializeIrpPacket")
+        self.assertRegex(
+            body,
+            r"CurrentStackLocation\s*=\s*\(PIO_STACK_LOCATION\)\s*"
+            r"\(\(PUCHAR\)Irp\s*\+\s*PacketSize\)",
+        )
+        self.assertNotIn("(PIO_STACK_LOCATION)(Irp + 1) + StackSize", body)
+
+    def test_xbox_builder_preserves_internal_device_transport(self):
+        body = function(self.irp, "IopBuildXboxFsdRequestCommon")
+        for expected in (
+            "DeviceObject->Flags & DO_BUFFERED_IO",
+            "DeviceObject->Flags & DO_DIRECT_IO",
+            "IopSetIrpSystemBuffer",
+            "IopSetIrpInternalFlags",
+            "IopSetIrpMdlAddress",
+            "IoAllocateMdl",
+            "MmProbeAndLockPages",
+            "Irp->UserBuffer = Buffer",
+        ):
+            self.assertIn(expected, body)
+        internal = function(self.irp, "IopBuildXboxFsdRequest")
+        self.assertIn("IopBuildXboxFsdRequestCommon", internal)
+        self.assertIn("FALSE", internal)
+        self.assertNotIn("MmLockUnlockBufferPages", internal)
+
+        unlock = function(self.irp, "IopUnlockXboxIrpBufferPrivate")
+        self.assertIn("State->LockedBufferBase", unlock)
+        self.assertIn("State->LockedBufferBytes", unlock)
+        self.assertNotIn("MmLockUnlockBufferPages(Irp->UserBuffer", unlock)
+
+    def test_title_export_builder_publishes_native_transfer_shape(self):
+        xbe = XBE_C.read_text()
+        for wrapper in (
+            "XeIoBuildAsynchronousFsdRequest",
+            "XeIoBuildSynchronousFsdRequest",
+            "XeIoSynchronousFsdRequest",
+        ):
+            body = function(xbe, wrapper)
+            self.assertIn("IopBuildXboxPublicFsdRequest", body)
+
+        public = function(self.irp, "IopBuildXboxPublicFsdRequest")
+        internal = function(self.irp, "IopBuildXboxFsdRequest")
+        body = function(self.irp, "IopBuildXboxFsdRequestCommon")
+        self.assertIn("IopBuildXboxFsdRequestCommon", public)
+        self.assertIn("TRUE", public)
+        self.assertIn("IopBuildXboxFsdRequestCommon", internal)
+        self.assertIn("FALSE", internal)
+        for expected in (
+            "Irp->UserBuffer = Buffer",
+            "DeviceObject->Flags & DO_BUFFERED_IO",
+            "MmLockUnlockBufferPages(Buffer, Length, FALSE)",
+            "Irp->LockedBufferLength = Length",
+            "Irp->Flags |= IRP_UNLOCK_USER_BUFFER",
+            "IopSetIrpSystemBuffer(Irp, Buffer)",
+        ):
+            self.assertIn(expected, body)
+        self.assertNotIn("Irp->SegmentArray", body)
+        self.assertNotIn("TitleOwnedDriver", body)
+        public_buffered = body.split(
+            "if (DeviceObject->Flags & DO_BUFFERED_IO)", 1
+        )[1].split("else if (DeviceObject->Flags & DO_DIRECT_IO)", 1)[0]
+        native_arm = public_buffered.split("if (PublicRequest)", 1)[1].split(
+            "else", 1
+        )[0]
+        self.assertNotIn("ExAllocatePoolWithTag", native_arm)
+        self.assertNotIn("RtlCopyMemory", native_arm)
+
+    def test_public_size_macro_uses_target_packet(self):
+        self.assertRegex(
+            self.funcs,
+            r"#define IoSizeOfIrp\(_StackSize\)\s*\\\s*\n\s*"
+            r"\(\(USHORT\) \(sizeof\(IRP\)",
+        )
+
+    def test_private_prefix_preserves_public_allocation_classes(self):
+        for expected in (
+            "IOP_XBOX_IRP_STATE_SIZE         32",
+            "IOP_XBOX_IRP_PRIVATE_SIZE       80",
+        ):
+            self.assertIn(expected, self.types)
+        self.assertIn("C_ASSERT(sizeof(IOP_XBOX_IRP_PRIVATE) ==",
+                      self.irp)
+        self.assertIn("NxpPoolTryResolveTaggedInteriorBlock(Irp,",
+                      self.irp)
+        self.assertIn("IOP_XBOX_IRP_PRIVATE_SIZE", self.irp)
+
+        # Both the previous widened packet and the exact packet plus its
+        # private prefix land in the same nxpool classes for game-sized IRPs.
+        classes = (32, 64, 128, 256, 272, 320, 512, 1024, 2048)
+        def pool_class(size: int) -> int:
+            return next(value for value in classes if value >= size + 8)
+        for stacks in (1, 8, 20):
+            old = 128 + stacks * 36
+            exact_with_prefix = 80 + 104 + stacks * 36
+            self.assertEqual(pool_class(exact_with_prefix), pool_class(old))
+
+    def test_caller_segment_array_is_never_treated_as_mdl(self):
+        get_body = function(self.irp, "IopGetIrpMdlAddress")
+        set_body = function(self.irp, "IopSetIrpMdlAddress")
+        self.assertNotIn("Irp->SegmentArray", get_body)
+        self.assertNotIn("Irp->SegmentArray", set_body)
+        self.assertRegex(get_body, r"State\s*\?\s*State->MdlAddress\s*:\s*NULL")
+
+    def test_cancel_compare_exchange_resolves_private_state_once(self):
+        body = function(self.irp, "IopCompareExchangeIrpCancelRoutine")
+        self.assertEqual(body.count("IopReferenceIrpState"), 1)
+        self.assertEqual(body.count("InterlockedCompareExchangePointer"), 1)
+        self.assertIn("&State->CancelRoutine", body)
+
+    def test_reinitialization_releases_owned_public_pin_before_zero(self):
+        body = function(self.irp, "IoInitializeIrp")
+        unlock = body.index("IopUnlockXboxIrpBuffer")
+        clear = body.index("IopInitializeIrpPacket")
+        self.assertLess(unlock, clear)
+        xbox_body = body.split("#ifdef SARCH_XBOX", 1)[1].split("#else", 1)[0]
+        self.assertNotIn("RtlZeroMemory", xbox_body)
+
+    def test_shape_validation_is_separate_from_private_ownership(self):
+        lookup = function(self.irp, "IopLookupIrpPrivate")
+        self.assertIn("IopLookupIrpPrivateAllocation", lookup)
+        for forbidden in ("Irp->Type", "Irp->Size", "Irp->StackCount"):
+            self.assertNotIn(forbidden, lookup)
+        body = function(self.irp, "IopValidateIrpPrivate")
+        for required in (
+            "Irp->Type != IO_TYPE_IRP",
+            "Irp->Size != IoSizeOfIrp(Irp->StackCount)",
+            "IOP_XBOX_IRP_PRIVATE_SIZE + Irp->Size > AllocationBytes",
+        ):
+            self.assertIn(required, body)
+
+    def test_private_lookup_handles_whole_page_irps(self):
+        pool = (ROOT / "ntoskrnl/xb/mm/pool.c").read_text()
+        body = function(pool, "NxpPoolTryResolveTaggedInteriorBlock")
+        self.assertIn("NxpTryQueryTaggedBigBlock", body)
+        self.assertIn("CandidateBase & (PAGE_SIZE - 1)", body)
+        query = function(pool, "ExQueryPoolBlockSize")
+        self.assertIn("IOP_XBOX_IRP_PRIVATE_SIZE", query)
+        self.assertIn("TAG_IRP", query)
+        self.assertIn("IrpAllocationBytes - IOP_XBOX_IRP_PRIVATE_SIZE", query)
+
+    def test_caller_owned_terminal_completion_uses_sidecar(self):
+        body = function(self.irp, "IofCompleteRequest")
+        self.assertIn("IopQueueIrpCompletionApc", body)
+        self.assertIn("IopQueueIrpCompletionApc(Irp, OwnedPrivate", body)
+        self.assertIn("OwnedPrivate = IopLookupIrpPrivateAllocation", body)
+        self.assertIn("State = OwnedPrivate ?", body)
+        helper = function(self.irp, "IopQueueIrpCompletionApc")
+        self.assertIn("PIOP_XBOX_IRP_PRIVATE Private", helper)
+        self.assertIn("IopCallerIrpCompletionApc", helper)
+        self.assertIn("NonPagedPoolMustSucceed", helper)
+        self.assertNotIn("IopCompleteRequestCore(Irp, FALSE", helper)
+
+        core = function(self.irp, "IopCompleteRequestCore")
+        xbox = core.split("#ifdef SARCH_XBOX", 1)[1].split("#else", 1)[0]
+        self.assertEqual(xbox.count("IopLookupIrpPrivateAllocation(Irp"), 1)
+        self.assertIn("IopDetachCallerIrp(Irp)", xbox)
+        self.assertLess(xbox.index("IopUnQueueIrpFromThread(Irp)"),
+                        xbox.index("if (SignalUserEvent)"))
+
+    def test_free_boundary_checks_private_ownership(self):
+        body = function(self.irp, "IoFreeIrp")
+        self.assertIn("IopLookupIrpPrivate", body)
+        self.assertNotIn("IopOwnedIrpPrivate(Irp)", body)
+        xbox = body.split("#ifdef SARCH_XBOX", 1)[1]
+        self.assertIn("IopIrpLookasideListType(AllocationFlags)", xbox)
+
+    def test_lookaside_class_is_private_allocation_provenance(self):
+        allocate = function(self.irp, "IoAllocateIrp")
+        self.assertIn("Flags |= IOP_IRP_LARGE_LOOKASIDE", allocate)
+        selector = function(self.irp, "IopIrpLookasideListType")
+        self.assertIn("AllocationFlags & IOP_IRP_LARGE_LOOKASIDE", selector)
+
+    def test_per_cpu_mdl_lookaside_uses_mdl_element_size(self):
+        iomgr = IOMGR_C.read_text()
+        body = function(iomgr, "IopInitLookasideLists")
+        marker = body.index("/* Set the MDL Completion List */")
+        mdl_block = body[marker:]
+        self.assertRegex(
+            mdl_block,
+            r"ExInitializeSystemLookasideList\(CurrentList,\s*"
+            r"NonPagedPool,\s*MdlSize,\s*TAG_MDL",
+        )
+        self.assertNotRegex(
+            mdl_block,
+            r"ExInitializeSystemLookasideList\(CurrentList,\s*"
+            r"NonPagedPool,\s*SmallIrpSize,\s*TAG_MDL",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
