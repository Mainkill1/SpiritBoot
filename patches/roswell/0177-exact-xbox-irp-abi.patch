+    PIOP_CALLER_IRP_SIDECAR Sidecar;
+    PLIST_ENTRY Head, Entry;
+    KIRQL OldIrql;
+    ULONG Bucket;
+
+    Private = IopLookupIrpPrivateAllocation(Irp, NULL);
+    if (Private != NULL) return (PIOP_XBOX_IRP_STATE)Private;
+    if (!IopCallerIrpRegistryInitialized) return NULL;
+
+    Bucket = ((ULONG_PTR)Irp >> 4) & (IOP_IRP_SIDECAR_BUCKETS - 1);
+    KeAcquireSpinLock(&IopCallerIrpLock, &OldIrql);
+    Head = &IopCallerIrpBuckets[Bucket];
+    for (Entry = Head->Flink; Entry != Head; Entry = Entry->Flink)
+    {
+        Sidecar = CONTAINING_RECORD(Entry, IOP_CALLER_IRP_SIDECAR, HashLink);
+        if (Sidecar->Irp == Irp)
+        {
+            State = &Sidecar->State;
+            break;
+        }
+    }
+    KeReleaseSpinLock(&IopCallerIrpLock, OldIrql);
+    return State;
+}
+
+static PIOP_XBOX_IRP_PRIVATE
+IopLookupIrpPrivate(IN PIRP Irp)
+{
+    return IopLookupIrpPrivateAllocation(Irp, NULL);
+}
+
+static PIOP_CALLER_IRP_SIDECAR
+IopFindCallerIrpSidecarLocked(IN PIRP Irp)
+{
+    PLIST_ENTRY Head, Entry;
+    PIOP_CALLER_IRP_SIDECAR Sidecar;
+    ULONG Bucket = ((ULONG_PTR)Irp >> 4) & (IOP_IRP_SIDECAR_BUCKETS - 1);
+
+    Head = &IopCallerIrpBuckets[Bucket];
+    for (Entry = Head->Flink; Entry != Head; Entry = Entry->Flink)
+    {
+        Sidecar = CONTAINING_RECORD(Entry, IOP_CALLER_IRP_SIDECAR, HashLink);
+        if (Sidecar->Irp == Irp) return Sidecar;
+    }
+    return NULL;
+}
+
+static PIOP_CALLER_IRP_SIDECAR
+IopEnsureCallerIrpSidecar(IN PIRP Irp)
+{
+    PIOP_CALLER_IRP_SIDECAR Sidecar, Candidate;
+    KIRQL OldIrql;
+    ULONG Bucket;
+
+    ASSERT(IopCallerIrpRegistryInitialized);
+    KeAcquireSpinLock(&IopCallerIrpLock, &OldIrql);
+    Sidecar = IopFindCallerIrpSidecarLocked(Irp);
+    KeReleaseSpinLock(&IopCallerIrpLock, OldIrql);
+    if (Sidecar != NULL) return Sidecar;
+
+    Candidate = ExAllocateFromNPagedLookasideList(&IopCallerIrpLookaside);
+    ASSERT(Candidate != NULL);
+    if (Candidate == NULL) return NULL;
+    RtlZeroMemory(Candidate, sizeof(*Candidate));
+    IopInitializeIrpState(&Candidate->State, 0);
+    Candidate->Irp = Irp;
+    Candidate->References = 1; /* Registry reference. */
+
+    Bucket = ((ULONG_PTR)Irp >> 4) & (IOP_IRP_SIDECAR_BUCKETS - 1);
+    KeAcquireSpinLock(&IopCallerIrpLock, &OldIrql);
+    Sidecar = IopFindCallerIrpSidecarLocked(Irp);
+    if (Sidecar == NULL)
+    {
+        InsertHeadList(&IopCallerIrpBuckets[Bucket], &Candidate->HashLink);
+        Sidecar = Candidate;
+        Candidate = NULL;
+    }
+    KeReleaseSpinLock(&IopCallerIrpLock, OldIrql);
+    if (Candidate != NULL)
+        ExFreeToNPagedLookasideList(&IopCallerIrpLookaside, Candidate);
+    return Sidecar;
+}
+
+static PIOP_CALLER_IRP_SIDECAR
+IopReferenceCallerIrpSidecar(IN PIRP Irp,
+                             IN BOOLEAN Ensure)
+{
+    PIOP_CALLER_IRP_SIDECAR Sidecar;
+    KIRQL OldIrql;
+
+    if (IopLookupIrpPrivateAllocation(Irp, NULL) != NULL) return NULL;
+    if (Ensure && IopEnsureCallerIrpSidecar(Irp) == NULL) return NULL;
+
+    KeAcquireSpinLock(&IopCallerIrpLock, &OldIrql);
+    Sidecar = IopFindCallerIrpSidecarLocked(Irp);
+    if (Sidecar != NULL)
+    {
+        Sidecar->References++;
+    }
+    KeReleaseSpinLock(&IopCallerIrpLock, OldIrql);
+    return Sidecar;
+}
+
+static VOID
+IopDereferenceCallerIrpSidecar(IN PIOP_CALLER_IRP_SIDECAR Sidecar)
+{
+    BOOLEAN FreeSidecar = FALSE;
+    KIRQL OldIrql;
+
+    if (Sidecar == NULL) return;
+    KeAcquireSpinLock(&IopCallerIrpLock, &OldIrql);
+    ASSERT(Sidecar->References > 0);
+    if (--Sidecar->References == 0) FreeSidecar = TRUE;
+    KeReleaseSpinLock(&IopCallerIrpLock, OldIrql);
+    if (FreeSidecar)
+        ExFreeToNPagedLookasideList(&IopCallerIrpLookaside, Sidecar);
+}
+
+static VOID
+IopDetachCallerIrpSidecar(IN PIOP_CALLER_IRP_SIDECAR Sidecar)
+{
+    BOOLEAN DropReference = FALSE;
+    KIRQL OldIrql;
+
+    if (Sidecar == NULL) return;
+    KeAcquireSpinLock(&IopCallerIrpLock, &OldIrql);
+    if (Sidecar->Irp != NULL)
+    {
+        RemoveEntryList(&Sidecar->HashLink);
+        Sidecar->Irp = NULL;
+        DropReference = TRUE;
+    }
+    KeReleaseSpinLock(&IopCallerIrpLock, OldIrql);
+    if (DropReference) IopDereferenceCallerIrpSidecar(Sidecar);
+}
+
+static BOOLEAN
+IopCallerIrpSidecarIsAttached(IN PIOP_CALLER_IRP_SIDECAR Sidecar,
+                              IN PIRP Irp)
+{
+    BOOLEAN Attached;
+    KIRQL OldIrql;
+
+    if (Sidecar == NULL) return FALSE;
+    KeAcquireSpinLock(&IopCallerIrpLock, &OldIrql);
+    Attached = Sidecar->Irp == Irp;
+    KeReleaseSpinLock(&IopCallerIrpLock, OldIrql);
+    return Attached;
+}
+
+static VOID
+IopDetachCallerIrp(IN PIRP Irp)
+{
+    PIOP_CALLER_IRP_SIDECAR Sidecar;
+
+    Sidecar = IopReferenceCallerIrpSidecar(Irp, FALSE);
+    if (Sidecar == NULL) return;
+    IopDetachCallerIrpSidecar(Sidecar);
+    IopDereferenceCallerIrpSidecar(Sidecar);
+}
+
+VOID NTAPI
+IopInitializeCallerIrpRegistry(VOID)
+{
+    ULONG Index;
+
+    KeInitializeSpinLock(&IopCallerIrpLock);
+    for (Index = 0; Index < IOP_IRP_SIDECAR_BUCKETS; ++Index)
+        InitializeListHead(&IopCallerIrpBuckets[Index]);
+    ExInitializeNPagedLookasideList(&IopCallerIrpLookaside,
+                                    NULL,
+                                    NULL,
+                                    NonPagedPoolMustSucceed,
+                                    sizeof(IOP_CALLER_IRP_SIDECAR),
+                                    TAG_IRP_SIDECAR,
+                                    16);
+    IopCallerIrpRegistryInitialized = TRUE;
+}
+
+static PIOP_XBOX_IRP_STATE
+IopReferenceIrpState(IN PIRP Irp,
+                     IN BOOLEAN Ensure,
+                     OUT PIOP_CALLER_IRP_SIDECAR *CallerSidecar)
+{
+    PIOP_XBOX_IRP_PRIVATE Private;
+
+    *CallerSidecar = NULL;
+    Private = IopLookupIrpPrivateAllocation(Irp, NULL);
+    if (Private != NULL) return (PIOP_XBOX_IRP_STATE)Private;
+
+    *CallerSidecar = IopReferenceCallerIrpSidecar(Irp, Ensure);
+    return *CallerSidecar ? &(*CallerSidecar)->State : NULL;
+}
+
+static PIOP_XBOX_IRP_PRIVATE
+IopValidateIrpPrivate(IN PIRP Irp)
+{
+    SIZE_T AllocationBytes;
+    PIOP_XBOX_IRP_PRIVATE Private;
+
+    Private = IopLookupIrpPrivateAllocation(Irp, &AllocationBytes);
+    if (Private == NULL || Irp->Type != IO_TYPE_IRP || Irp->StackCount < 0)
+        return NULL;
+    if (Irp->Size != IoSizeOfIrp(Irp->StackCount)) return NULL;
+    if (IOP_XBOX_IRP_PRIVATE_SIZE + Irp->Size > AllocationBytes) return NULL;
+    return Private;
+}
+
+static VOID
+IopInitializeIrpState(IN PIOP_XBOX_IRP_STATE State,
+                      IN UCHAR AllocationFlags)
+{
+    RtlZeroMemory(State, sizeof(*State));
+    State->AllocationFlags = AllocationFlags;
+    State->RequestorMode = KernelMode;
+    State->CancelIrql = DISPATCH_LEVEL;
+    State->ApcEnvironment = KeGetCurrentThread()->ApcStateIndex;
+}
+
+static VOID
+IopInitializeIrpPrivate(IN PIOP_XBOX_IRP_PRIVATE Private,
+                        IN UCHAR AllocationFlags)
+{
+    RtlZeroMemory(Private, sizeof(*Private));
+    IopInitializeIrpState((PIOP_XBOX_IRP_STATE)Private, AllocationFlags);
+    Private->Signature = IopIrpPrivateSignature(Private);
+}
+
+static VOID
+IopResetIrpPrivateState(IN PIOP_XBOX_IRP_PRIVATE Private)
+{
+    UCHAR AllocationFlags;
+
+    AllocationFlags = Private->AllocationFlags;
+    IopInitializeIrpPrivate(Private, AllocationFlags);
+}
