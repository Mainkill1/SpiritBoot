+#!/usr/bin/env python3
+"""Compile and exercise the production caller-owned Xbox IRP sidecar bodies."""
+
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = (ROOT / "ntoskrnl/io/iomgr/irp.c").read_text()
+
+
+def function(name: str) -> str:
+    match = re.search(rf"\n(?:[A-Za-z_][^\n]*\n)*{name}\s*\([^;]*?\)\s*\{{",
+                      SOURCE, re.S)
+    if not match:
+        raise AssertionError(f"missing production function {name}")
+    begin = match.start() + 1
+    brace = SOURCE.find("{", match.start())
+    depth = 0
+    for pos in range(brace, len(SOURCE)):
+        depth += (SOURCE[pos] == "{") - (SOURCE[pos] == "}")
+        if depth == 0:
+            return SOURCE[begin:pos + 1] + "\n"
+    raise AssertionError(f"unterminated production function {name}")
+
+
+def declaration(begin: str, end: str) -> str:
+    start = SOURCE.index(begin)
+    finish = SOURCE.index(end, start) + len(end)
+    return SOURCE[start:finish] + "\n"
+
+
+state = declaration("typedef union _IOP_IRP_ASSOCIATED_STATE",
+                    "IOP_IRP_ASSOCIATED_STATE, *PIOP_IRP_ASSOCIATED_STATE;")
+state += declaration("typedef struct _IOP_XBOX_IRP_STATE",
+                     "IOP_XBOX_IRP_STATE, *PIOP_XBOX_IRP_STATE;")
+sidecar = declaration("typedef struct _IOP_CALLER_IRP_SIDECAR",
+                      "IOP_CALLER_IRP_SIDECAR, *PIOP_CALLER_IRP_SIDECAR;")
+
+if "IOP_XBOX_IRP_STATE State;" not in sidecar:
+    raise AssertionError("caller sidecar does not contain the 32-byte state")
+if "IOP_XBOX_IRP_PRIVATE" in sidecar or "KAPC" in sidecar:
+    raise AssertionError("caller sidecar embeds owned-prefix/APC storage")
+
+bodies = "\n".join(function(name) for name in (
+    "IopInitializeIrpState",
+    "IopFindCallerIrpSidecarLocked",
+    "IopEnsureCallerIrpSidecar",
+    "IopReferenceCallerIrpSidecar",
+    "IopDereferenceCallerIrpSidecar",
+    "IopDetachCallerIrpSidecar",
+    "IopDetachCallerIrp",
+    "IopInitializeCallerIrpRegistry",
+    "IopLookupIrpState",
+    "IopReferenceIrpState",
+    "IopGetIrpMdlAddress",
+    "IopGetIrpMdlAddressPointer",
+    "IopSetIrpMdlAddress",
+    "IopGetIrpSystemBuffer",
+    "IopGetIrpSystemBufferPointer",
+    "IopSetIrpSystemBuffer",
+    "IopGetIrpMasterIrp",
+    "IopGetIrpMasterIrpPointer",
+    "IopSetIrpMasterIrp",
+    "IopGetIrpCountPointer",
+    "IopGetIrpCancelRoutine",
+    "IopSetIrpCancelRoutine",
+    "IopCompareExchangeIrpCancelRoutine",
+    "IopGetIrpCancelIrql",
+    "IopGetIrpInternalFlags",
+    "IopSetIrpInternalFlags",
+    "IopOrIrpInternalFlags",
+    "IopClearIrpInternalFlags",
+    "IopGetIrpAllocationFlags",
+    "IopSetIrpAllocationFlags",
+    "IopUnlockXboxIrpBufferPrivate",
+    "IopInitializeIrpPacket",
+    "IoInitializeIrp",
+    "IoReuseIrp",
+))
+
+initializer = function("IopInitializeCallerIrpRegistry")
+if "NonPagedPoolMustSucceed" not in initializer:
+    raise AssertionError("pointer-returning raw IRP state can fail allocation")
+
+complete = function("IofCompleteRequest")
+for required in (
+    "IopReferenceCallerIrpSidecar(Irp, FALSE)",
+    "IopDereferenceCallerIrpSidecar(CompletionSidecar)",
+):
+    if required not in complete:
+        raise AssertionError(f"missing completion-resubmission lifetime step: {required}")
+more = complete[complete.index("if (Status == STATUS_MORE_PROCESSING_REQUIRED)"):]
+more = more[:more.index("return;")]
+if "IopDetachCallerIrpSidecar" in more:
+    raise AssertionError("MORE_PROCESSING_REQUIRED discards retained raw state")
+
+# A completion routine may return MORE_PROCESSING_REQUIRED after releasing its
+# caller-owned packet.  Completion must protect state that already exists, but
+# must not manufacture state solely to cross that callback boundary.
+callback_hold = complete[complete.index("CompletionSidecar = NULL;"):]
+callback_hold = callback_hold[:callback_hold.index("/* Call the completion routine */")]
+if "IopReferenceCallerIrpSidecar(Irp, TRUE)" in callback_hold:
+    raise AssertionError("raw completion callback manufactures persistent state")
+
+template = Path(__file__).with_name("fixture.c").read_text()
+source = template.replace("/* PRODUCTION_STATE */", state)
+source = source.replace("/* PRODUCTION_SIDECAR */", sidecar)
+source = source.replace("/* PRODUCTION_BODIES */", bodies)
+
+with tempfile.TemporaryDirectory(prefix="irp-caller-sidecar-") as directory:
+    directory = Path(directory)
+    c_file = directory / "fixture.c"
+    executable = directory / "fixture"
+    c_file.write_text(source)
+    subprocess.run([
+        "cc", "-std=c11", "-O2", "-g", "-Wall", "-Wextra", "-Werror",
+        "-Wno-unused-function", "-fsanitize=address,undefined",
+        "-fno-omit-frame-pointer", "-pthread", str(c_file), "-o", str(executable),
+    ], check=True)
+    subprocess.run([str(executable)], check=True)
