+static void test_direct_read_uses_private_locked_mdl(void)
+{
+    reset_counters();
+    DEVICE_OBJECT Device={DO_DIRECT_IO,1};
+    unsigned char Buffer[8193];
+    LARGE_INTEGER Offset={0x12345678};
+    IO_STATUS_BLOCK Iosb={0};
+
+    PIRP Irp=IopBuildXboxFsdRequest(IRP_MJ_READ,
+                                    &Device,
+                                    Buffer+3,
+                                    8190,
+                                    &Offset,
+                                    &Iosb);
+    assert(Irp);
+    PMDL Mdl=nxstorage_modeled_consumer(Irp);
+    assert(Mdl==IopLookupIrpPrivate(Irp)->MdlAddress);
+    assert(Mdl->Buffer==Buffer+3 && Mdl->Length==8190);
+    assert(MdlAllocationAttempts==1 && MdlAllocations==1);
+    assert(ProbeCalls==1 && ProbeMode==KernelMode);
+    assert(ProbeOperation==IoWriteAccess);
+    assert(LegacyLocks==0 && LegacyUnlocks==0);
+
+    complete_and_release(Irp);
+    assert(MdlUnlocks==1);
+    assert(MdlFrees==1);
+    assert(IrpFrees==1);
+    assert(LegacyUnlocks==0);
