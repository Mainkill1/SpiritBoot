+#!/usr/bin/env python3
+"""Keep legacy Xbox storage consumers off removed public IRP state."""
+
+from pathlib import Path
+import re
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCES = (
+    "drivers/storage/class/classpnp/class.c",
+    "drivers/storage/class/classpnp/autorun.c",
+    "drivers/storage/class/classpnp/xferpkt.c",
+    "drivers/storage/class/disk/disk.c",
+    "drivers/storage/class/nxcdrom/nxcdrom.c",
+)
+REMOVED = (
+    "MdlAddress",
+    "AssociatedIrp",
+    "RequestorMode",
+    "CancelRoutine",
+    "CancelIrql",
+    "ApcEnvironment",
+    "AllocationFlags",
+)
+
+
+def main() -> int:
+    direct = re.compile(r"(?:->|\.)(?:" + "|".join(REMOVED) + r")\b")
+    private_flag = re.compile(
+        r"(?:->|\.)Flags\b[^;\n]*\bIRP_(?:PAGING_IO|SYNCHRONOUS_PAGING_IO|"
+        r"ASSOCIATED_IRP|BUFFERED_IO|DEALLOCATE_BUFFER|INPUT_OPERATION|"
+        r"CLASS_CACHE_OPERATION|XB_SG_COMPLETION)\b"
+    )
+    failures = []
+    for relative in SOURCES:
+        path = ROOT / relative
+        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+            if direct.search(line):
+                failures.append(f"{relative}:{number}: {line.strip()}")
+            if private_flag.search(line):
+                failures.append(f"{relative}:{number}: {line.strip()}")
+
+    if failures:
+        print("removed public IRP state remains in legacy Xbox storage sources:")
+        print("\n".join(failures))
+        return 1
+
+    print(f"IRP storage consumer gate: {len(SOURCES)} sources PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
