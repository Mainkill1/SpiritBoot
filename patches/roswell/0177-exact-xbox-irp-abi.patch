+    rundown_mode(KernelMode);
+    assert(freed==before_freed+1&&mdls_freed==before_mdls+2&&buffers_freed==before_buffers+1);
+    assert(rundown_event.signals==1&&rundown_event.refs==0&&rundown_file.refs==0);
+    case_count++;
