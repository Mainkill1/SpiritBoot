+    irp->Private=calloc(1,sizeof(*irp->Private));assert(irp->Private);
+    irp->Private->Irp=irp;irp->IoStatus.Status=0;
+    irp->Private->InternalFlags=IOP_IRP_BUFFERED_IO|IOP_IRP_DEALLOCATE_BUFFER;
+    irp->Private->AssociatedIrp.SystemBuffer=malloc(8);
+    assert(irp->Private->AssociatedIrp.SystemBuffer);
+    irp->Private->MdlAddress=calloc(1,sizeof(MDL));
+    irp->Private->MdlAddress->Next=calloc(1,sizeof(MDL));
+    assert(irp->Private->MdlAddress&&irp->Private->MdlAddress->Next);
+    FILE_OBJECT rundown_file={.refs=1};KEVENT rundown_event={.refs=1};
+    irp->UserEvent=&rundown_event;referenced_event=&rundown_event;
+    unsigned before_freed=freed,before_mdls=mdls_freed,before_buffers=buffers_freed;
+    IopQueueIrpCompletionApc(irp,irp->Private,&issuer_object,&rundown_file,NULL,0);
