+PVOID NTAPI
+IopGetIrpSystemBuffer(IN PIRP Irp)
+{
+    PIOP_XBOX_IRP_PRIVATE Private;
+    PIOP_CALLER_IRP_SIDECAR Sidecar;
+    PVOID Buffer;
+
+    Private = IopLookupIrpPrivateAllocation(Irp, NULL);
+    if (Private != NULL) return Private->AssociatedIrp.SystemBuffer;
+
+    Sidecar = IopReferenceCallerIrpSidecar(Irp, FALSE);
+    if (Sidecar == NULL) return Irp->UserBuffer;
+    Buffer = Sidecar->AssociatedKind == IOP_IRP_ASSOCIATED_SYSTEM_BUFFER ?
+             Sidecar->State.AssociatedIrp.SystemBuffer : Irp->UserBuffer;
+    IopDereferenceCallerIrpSidecar(Sidecar);
+    return Buffer;
+}
+
+PVOID *NTAPI
+IopGetIrpSystemBufferPointer(IN OUT PIRP Irp)
+{
+    PIOP_XBOX_IRP_PRIVATE Private;
+    PIOP_CALLER_IRP_SIDECAR Sidecar;
+
+    Private = IopLookupIrpPrivateAllocation(Irp, NULL);
+    if (Private != NULL) return &Private->AssociatedIrp.SystemBuffer;
+    Sidecar = IopReferenceCallerIrpSidecar(Irp, TRUE);
+    ASSERT(Sidecar != NULL);
+    if (Sidecar == NULL) return &Irp->UserBuffer;
+    if (Sidecar->AssociatedKind != IOP_IRP_ASSOCIATED_SYSTEM_BUFFER)
+    {
+        Sidecar->State.AssociatedIrp.SystemBuffer = Irp->UserBuffer;
+        Sidecar->AssociatedKind = IOP_IRP_ASSOCIATED_SYSTEM_BUFFER;
+    }
+    {
+        PVOID *SystemBuffer = &Sidecar->State.AssociatedIrp.SystemBuffer;
+        IopDereferenceCallerIrpSidecar(Sidecar);
+        return SystemBuffer;
+    }
+}
+
+VOID NTAPI
+IopSetIrpSystemBuffer(IN OUT PIRP Irp, IN PVOID Buffer)
+{
+    PVOID *SystemBuffer = IopGetIrpSystemBufferPointer(Irp);
+    if (SystemBuffer != NULL) *SystemBuffer = Buffer;
+}
