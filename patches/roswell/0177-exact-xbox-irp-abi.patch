+
+PKAPC NTAPI
+IopGetIrpCompletionApc(IN PIRP Irp)
+{
+    PIOP_XBOX_IRP_PRIVATE Private =
+        IopLookupIrpPrivateAllocation(Irp, NULL);
+    ASSERT(Private != NULL);
+    return Private ? &Private->CompletionApc : NULL;
+}
+
+PIRP NTAPI
+IopGetIrpFromCompletionApc(IN PKAPC Apc)
+{
+    PIOP_XBOX_IRP_PRIVATE Private;
+
+    Private = CONTAINING_RECORD(Apc, IOP_XBOX_IRP_PRIVATE, CompletionApc);
+    ASSERT(Private->Signature == IopIrpPrivateSignature(Private));
+    return (PIRP)(Private + 1);
+}
+
+static PIOP_XBOX_IRP_PRIVATE
+IopLookupIrpPrivateAllocation(IN PIRP Irp,
+                              OUT PSIZE_T AllocationBytes OPTIONAL)
+{
+    PVOID AllocationBase;
+    SIZE_T Bytes;
+    PIOP_XBOX_IRP_PRIVATE Private;
+
+    if (!NxpPoolTryResolveTaggedInteriorBlock(Irp,
+                                              IOP_XBOX_IRP_PRIVATE_SIZE,
+                                              TAG_IRP,
+                                              &AllocationBase,
+                                              &Bytes))
+    {
+        return NULL;
+    }
+
+    if (Bytes < IOP_XBOX_IRP_PRIVATE_SIZE + sizeof(IRP))
+        return NULL;
+
+    Private = (PIOP_XBOX_IRP_PRIVATE)AllocationBase;
+    if (Private->Signature != IopIrpPrivateSignature(Private)) return NULL;
+    if (AllocationBytes != NULL) *AllocationBytes = Bytes;
+    return Private;
+}
