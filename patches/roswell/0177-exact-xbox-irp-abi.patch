+    IopQueueIrpCompletionApc(raw,NULL,&issuer_object,NULL,NULL,0);
+    assert(!IsListEmpty(&issuer.ApcState.ApcListHead[KernelMode]));
+    PKAPC queued=CONTAINING_RECORD(issuer.ApcState.ApcListHead[KernelMode].Flink,KAPC,ApcListEntry);
+    assert(queued->environment==1);
+    rundown_mode(KernelMode);free(raw);case_count++;
+
+    /* A deferred APC holds one exact sidecar generation. Reusing the public
+     * address and attaching a replacement must not let the stale APC consume
+     * or detach the replacement generation. */
+    for(int use_rundown=0;use_rundown<2;use_rundown++) {
+        reset();defer_kernel_apc=1;
+        raw=calloc(1,sizeof(*raw));assert(raw);raw->IoStatus.Status=0;
+        captured=IopReferenceCallerIrpSidecar(raw,TRUE);assert(captured);
+        IopDereferenceCallerIrpSidecar(captured);
+        IopQueueIrpCompletionApc(raw,NULL,&issuer_object,NULL,NULL,0);
+        captured=raw->RawSidecar;assert(captured);
+        IopDetachCallerIrpSidecar(captured);
+        PIOP_CALLER_IRP_SIDECAR replacement=
+            IopReferenceCallerIrpSidecar(raw,TRUE);
+        assert(replacement&&replacement!=captured);
+        replacement->State.InternalFlags=IOP_IRP_BUFFERED_IO|
+                                         IOP_IRP_DEALLOCATE_BUFFER;
+        replacement->State.AssociatedIrp.SystemBuffer=malloc(8);
+        assert(replacement->State.AssociatedIrp.SystemBuffer);
+        raw->Overlay.AsynchronousParameters.UserApcRoutine=
+            (PIO_APC_ROUTINE)(uintptr_t)0x1234;
+        raw->Overlay.AsynchronousParameters.UserApcContext=
+            (PVOID)(uintptr_t)0x5678;
+        unsigned buffers_before=buffers_freed;
+        if(use_rundown) {
+            rundown_mode(KernelMode);
