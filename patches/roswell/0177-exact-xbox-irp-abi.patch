--- a/drivers/filesystems/vfatfs/misc.c
+++ b/drivers/filesystems/vfatfs/misc.c
@@ -458,9 +458,9 @@ VfatGetUserBuffer(
 {
     ASSERT(Irp);
 
-    if (Irp->MdlAddress)
+    if (IopIrpMdlAddress(Irp))
     {
-        return MmGetSystemAddressForMdlSafe(Irp->MdlAddress, (Paging ? HighPagePriority : NormalPagePriority));
+        return MmGetSystemAddressForMdlSafe(IopIrpMdlAddress(Irp), (Paging ? HighPagePriority : NormalPagePriority));
     }
     else
     {
@@ -476,26 +476,26 @@ VfatLockUserBuffer(
 {
     ASSERT(Irp);
 
-    if (Irp->MdlAddress)
+    if (IopIrpMdlAddress(Irp))
     {
         return STATUS_SUCCESS;
     }
 
     IoAllocateMdl(Irp->UserBuffer, Length, FALSE, FALSE, Irp);
 
-    if (!Irp->MdlAddress)
+    if (!IopIrpMdlAddress(Irp))
     {
         return STATUS_INSUFFICIENT_RESOURCES;
     }
 
