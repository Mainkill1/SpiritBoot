+/* Resolve a caller-visible pointer at a fixed offset within a pool allocation.
+ * The page-state byte establishes ownership before any bucket header is read.
+ * Whole-page allocations have no NXP_HEADER; for those, require that removing
+ * the fixed interior offset reaches the exact active run base. */
+BOOLEAN
+NxpPoolTryResolveTaggedInteriorBlock(
+    IN PVOID InteriorAddress,
+    IN SIZE_T InteriorOffset,
+    IN ULONG ExpectedTag,
+    OUT PVOID *AllocationBase,
+    OUT PSIZE_T AllocationBytes OPTIONAL)
+{
+#ifdef NXK_MM_POOLPAGES
+    ULONG_PTR Address;
+    ULONG_PTR WindowOffset;
+    ULONG_PTR PageAddress;
+    ULONG_PTR OffsetInPage;
+    ULONG_PTR InteriorRemainder;
+    ULONG_PTR BlockOffset;
+    ULONG_PTR CandidateBase;
+    ULONG PageIndex;
+    ULONG ClassIndex;
+    ULONG HeaderClassIndex;
+    ULONG BlockSize;
+    UCHAR PageState;
+    SIZE_T RunBytes;
+    NXP_HEADER *PageHeader;
+    NXP_HEADER *Header;
+#endif
+
+    if (AllocationBytes != NULL) *AllocationBytes = 0;
+    if (AllocationBase == NULL) return FALSE;
+    *AllocationBase = NULL;
+
+#ifndef NXK_MM_POOLPAGES
+    UNREFERENCED_PARAMETER(InteriorAddress);
+    UNREFERENCED_PARAMETER(InteriorOffset);
+    UNREFERENCED_PARAMETER(ExpectedTag);
+    return FALSE;
+#else
+    Address = (ULONG_PTR)InteriorAddress;
+    if (Address < NXK_POOL_WINDOW_BASE) return FALSE;
+
+    WindowOffset = Address - NXK_POOL_WINDOW_BASE;
+    if (WindowOffset >= NXK_POOL_WINDOW_PAGES * PAGE_SIZE) return FALSE;
+
+    PageIndex = (ULONG)(WindowOffset >> PAGE_SHIFT);
+    PageState = NxpPageState[PageIndex];
+    if (PageState == NXP_NOT_BUCKET)
+    {
+        if (Address < InteriorOffset) return FALSE;
+        CandidateBase = Address - InteriorOffset;
+        if ((CandidateBase & (PAGE_SIZE - 1)) != 0) return FALSE;
+        if (!NxpTryQueryTaggedBigBlock((PVOID)CandidateBase,
+                                       ExpectedTag,
+                                       &RunBytes) ||
+            RunBytes < InteriorOffset)
+        {
+            return FALSE;
+        }
+        *AllocationBase = (PVOID)CandidateBase;
+        if (AllocationBytes != NULL) *AllocationBytes = RunBytes;
+        return TRUE;
+    }
+    if (PageState == 0) return FALSE;
+
+    PageAddress = NXK_POOL_WINDOW_BASE +
+                  ((ULONG_PTR)PageIndex << PAGE_SHIFT);
+    OffsetInPage = WindowOffset & (PAGE_SIZE - 1);
+    PageHeader = (NXP_HEADER *)PageAddress;
+#ifdef NXK_POOL_CENSUS
+    ClassIndex = NXP_POOL_CENSUS_GET_CLASS(PageHeader->ClassIndex);
+#else
+    ClassIndex = PageHeader->ClassIndex;
+#endif
+    if (ClassIndex >= NXP_BUCKET_LISTS) return FALSE;
+
+    BlockSize = NxpClassSize[NXP_SIZE_CLASS(ClassIndex)];
+    if (InteriorOffset > BlockSize - sizeof(NXP_HEADER)) return FALSE;
+
+    InteriorRemainder = OffsetInPage % BlockSize;
+    if (InteriorRemainder != sizeof(NXP_HEADER) + InteriorOffset) return FALSE;
+
+    BlockOffset = OffsetInPage - InteriorRemainder;
+    if (BlockOffset + BlockSize > PAGE_SIZE) return FALSE;
+    Header = (NXP_HEADER *)(PageAddress + BlockOffset);
+#ifdef NXK_POOL_CENSUS
+    HeaderClassIndex = NXP_POOL_CENSUS_GET_CLASS(Header->ClassIndex);
+#else
+    HeaderClassIndex = Header->ClassIndex;
+#endif
+    if (Header->Magic != NXP_MAGIC_ALLOC ||
+        HeaderClassIndex != ClassIndex ||
+        Header->Tag != ExpectedTag)
+    {
+        return FALSE;
+    }
+
+    *AllocationBase = (PVOID)(Header + 1);
+    if (AllocationBytes != NULL)
+        *AllocationBytes = BlockSize - sizeof(NXP_HEADER);
+    return TRUE;
+#endif
+}
