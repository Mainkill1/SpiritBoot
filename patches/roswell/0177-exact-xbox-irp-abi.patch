+}
+
+static PVOID allocate_backing(SIZE_T bytes,ULONG tag,BOOLEAN quota)
+{
+    if(PoolFailureBudget){PoolFailureBudget--;return NULL;}
+    for(unsigned i=0;i<256;i++)if(!Allocations[i].Active){
+        unsigned char *base=malloc(bytes);assert(base);memset(base,0xa5,bytes);
+        Allocations[i]=(ALLOCATION_RECORD){base,bytes,tag,TRUE,quota};
+        PoolAllocations++;if(quota)QuotaAllocations++;
+        return base;
+    }
+    assert(!"allocation record exhaustion");return NULL;
+}
+
+static PVOID ExAllocatePoolWithTag(ULONG pool,SIZE_T bytes,ULONG tag)
+{ (void)pool;return allocate_backing(bytes,tag,FALSE); }
+static PVOID ExAllocatePoolWithQuotaTag(ULONG pool,SIZE_T bytes,ULONG tag)
+{ (void)pool;return allocate_backing(bytes,tag,TRUE); }
+static void ExFreePoolWithTag(PVOID base,ULONG tag)
+{
+    ALLOCATION_RECORD *record=record_for_base(base);assert(record);assert(record->Tag==tag);
+    record->Active=FALSE;PoolFrees++;free(record->Base);record->Base=NULL;
+}
+static void ExReturnPoolQuota(PVOID base)
+{ assert(record_for_base(base));QuotaReturns++; }
+
+static BOOLEAN NxpPoolTryResolveTaggedInteriorBlock(PVOID address,
+                                                     SIZE_T offset,
+                                                     ULONG tag,
+                                                     PVOID *base,
+                                                     PSIZE_T bytes)
+{
+    assert(offset==IOP_XBOX_IRP_PRIVATE_SIZE);*base=NULL;if(bytes)*bytes=0;
+    ALLOCATION_RECORD *record=record_for_irp((PIRP)address);
+    if(!record || record->Tag!=tag)return FALSE;
+    *base=record->Base;if(bytes)*bytes=record->Bytes;return TRUE;
+}
+
+static void MmLockUnlockBufferPages(PVOID base,SIZE_T bytes,BOOLEAN unlock)
+{
+    assert(unlock==TRUE);Unlocks++;UnlockedBase=base;UnlockedBytes=bytes;
+}
+
+/* PRODUCTION_BODIES */
+
+static void initialize_runtime(void)
+{
+    memset(&TestPrcb,0,sizeof(TestPrcb));memset(Lookasides,0,sizeof(Lookasides));
+    for(unsigned index=0;index<8;index++)for(unsigned level=0;level<2;level++)
+        Lookasides[index][level].L.Depth=16;
+    for(unsigned index=0;index<8;index++){
+        TestPrcb.PPLookasideList[index].P=&Lookasides[index][0];
+        TestPrcb.PPLookasideList[index].L=&Lookasides[index][1];
+    }
+}
+
+static void drain_lookasides(void)
+{
+    for(unsigned index=0;index<8;index++)for(unsigned level=0;level<2;level++){
+        PSLIST_ENTRY entry;
+        while((entry=InterlockedPopEntrySList(&Lookasides[index][level].L.ListHead))!=NULL)
+            ExFreePoolWithTag(entry,TAG_IRP);
+    }
+}
+
+static void assert_no_active_allocations(void)
+{
+    drain_lookasides();
+    for(unsigned i=0;i<256;i++)assert(!Allocations[i].Active);
+}
+
+static SIZE_T physical_bytes_for_stack(CCHAR stacks)
+{
+    CCHAR physical=(stacks<=8 && stacks!=1)?8:stacks;
+    return IOP_XBOX_IRP_PRIVATE_SIZE+IoSizeOfIrp(physical);
+}
+
+static PVOID preload_lookaside(PP_NPAGED_LOOKASIDE_NUMBER type,unsigned level,SIZE_T bytes)
+{
+    PVOID base=allocate_backing(bytes,TAG_IRP,FALSE);assert(base);
+    InterlockedPushEntrySList(&Lookasides[type][level].L.ListHead,(PSLIST_ENTRY)base);
+    return base;
+}
+
+static void test_stack_matrix(void)
+{
+    const CCHAR stacks[]={0,1,2,3,4,8,9};
+    for(unsigned case_index=0;case_index<sizeof(stacks)/sizeof(stacks[0]);case_index++){
+        CCHAR stack_count=stacks[case_index];
+        PIRP irp=IoAllocateIrp(stack_count,FALSE);assert(irp);
+        PIOP_XBOX_IRP_PRIVATE private=IopLookupIrpPrivate(irp);assert(private);
+        ALLOCATION_RECORD *record=record_for_base(private);assert(record);
+        assert(record->Bytes==physical_bytes_for_stack(stack_count));
+        assert(irp->Type==IO_TYPE_IRP && irp->Size==IoSizeOfIrp(stack_count));
+        assert(irp->StackCount==stack_count && irp->CurrentLocation==stack_count+1);
+        assert(irp->Tail.Overlay.CurrentStackLocation==
+               (PIO_STACK_LOCATION)((PUCHAR)irp+irp->Size));
+        if(stack_count<=8){
+            assert(private->AllocationFlags&IRP_ALLOCATED_FIXED_SIZE);
+            assert(!!(private->AllocationFlags&IOP_IRP_LARGE_LOOKASIDE)==(stack_count!=1));
+        }else assert(private->AllocationFlags==0);
+        SIZE_T logical_end=IOP_XBOX_IRP_PRIVATE_SIZE+irp->Size;
+        for(SIZE_T pos=logical_end;pos<record->Bytes;pos++)assert(record->Base[pos]==0xa5);
+        IoFreeIrp(irp);
+        if(stack_count<=8)assert(record->Active);else assert(!record->Active);
+        assert_no_active_allocations();
+    }
+}
+
+static void test_lookaside_hit_miss_and_free_routes(void)
+{
+    SIZE_T large=physical_bytes_for_stack(4);
+    PVOID base=preload_lookaside(LookasideLargeIrpList,0,large);
+    unsigned before_pool=PoolAllocations;
+    ULONG before_large_allocs=Lookasides[LookasideLargeIrpList][0].L.TotalAllocates;
+    ULONG before_large_frees=Lookasides[LookasideLargeIrpList][0].L.TotalFrees;
+    PIRP irp=IoAllocateIrp(4,FALSE);assert(irp);
+    assert((PVOID)IopLookupIrpPrivate(irp)==base && PoolAllocations==before_pool);
+    assert(Lookasides[LookasideLargeIrpList][0].L.TotalAllocates==before_large_allocs+1);
+    IoFreeIrp(irp);
+    assert(Lookasides[LookasideLargeIrpList][0].L.TotalFrees==before_large_frees+1);
+
+    preload_lookaside(LookasideSmallIrpList,1,physical_bytes_for_stack(1));
+    ULONG before_small_misses=Lookasides[LookasideSmallIrpList][0].L.AllocateMisses;
+    ULONG before_system_allocs=Lookasides[LookasideSmallIrpList][1].L.TotalAllocates;
+    irp=IoAllocateIrp(1,FALSE);assert(irp);
+    assert(Lookasides[LookasideSmallIrpList][0].L.AllocateMisses==before_small_misses+1);
+    assert(Lookasides[LookasideSmallIrpList][1].L.TotalAllocates==before_system_allocs+1);
+    IoFreeIrp(irp);
+
+    Lookasides[LookasideLargeIrpList][0].L.Depth=0;
+    Lookasides[LookasideLargeIrpList][1].L.Depth=0;
+    ULONG before_primary_free_misses=Lookasides[LookasideLargeIrpList][0].L.FreeMisses;
+    ULONG before_system_free_misses=Lookasides[LookasideLargeIrpList][1].L.FreeMisses;
+    irp=IoAllocateIrp(3,FALSE);assert(irp);
+    ALLOCATION_RECORD *record=record_for_irp(irp);assert(record);
+    IoFreeIrp(irp);assert(!record->Active);
+    assert(Lookasides[LookasideLargeIrpList][0].L.FreeMisses==before_primary_free_misses+1);
+    assert(Lookasides[LookasideLargeIrpList][1].L.FreeMisses==before_system_free_misses+1);
+    Lookasides[LookasideLargeIrpList][0].L.Depth=16;
+    Lookasides[LookasideLargeIrpList][1].L.Depth=16;
+    assert_no_active_allocations();
+}
+
+static void test_quota_routes(void)
+{
+    TestPrcb.LookasideIrpFloat=0;
+    PIRP irp=IoAllocateIrp(1,TRUE);assert(irp);
+    PIOP_XBOX_IRP_PRIVATE private=IopLookupIrpPrivate(irp);assert(private);
+    ALLOCATION_RECORD *record=record_for_base(private);assert(record&&record->Quota);
+    assert(private->AllocationFlags==IRP_QUOTA_CHARGED);
+    assert(record->Bytes==IOP_XBOX_IRP_PRIVATE_SIZE+IoSizeOfIrp(1));
+    IoFreeIrp(irp);assert(!record->Active);
+
+    TestPrcb.LookasideIrpFloat=1;
+    preload_lookaside(LookasideLargeIrpList,0,physical_bytes_for_stack(4));
+    irp=IoAllocateIrp(4,TRUE);assert(irp);
+    private=IopLookupIrpPrivate(irp);assert(private);
+    assert((private->AllocationFlags&(IRP_ALLOCATED_FIXED_SIZE|
+                                     IRP_LOOKASIDE_ALLOCATION|
+                                     IOP_IRP_LARGE_LOOKASIDE))==
+           (IRP_ALLOCATED_FIXED_SIZE|IRP_LOOKASIDE_ALLOCATION|
+            IOP_IRP_LARGE_LOOKASIDE));
+    assert(!(private->AllocationFlags&IRP_QUOTA_CHARGED));
+    assert(TestPrcb.LookasideIrpFloat==0);
+    IoFreeIrp(irp);assert(TestPrcb.LookasideIrpFloat==1);
+    assert_no_active_allocations();
+}
+
+static void test_mutation_and_reuse(void)
+{
+    PIRP irp=IoAllocateIrp(2,FALSE);assert(irp);
+    PIOP_XBOX_IRP_PRIVATE private=IopLookupIrpPrivate(irp);assert(private);
+    ALLOCATION_RECORD *record=record_for_base(private);assert(record);
+    UCHAR flags=private->AllocationFlags;
+    unsigned char locked[96];
+    private->LockedBufferBase=locked+3;private->LockedBufferBytes=71;
+    irp->Flags=IRP_UNLOCK_USER_BUFFER;irp->LockedBufferLength=7;
+    memset((PUCHAR)irp+sizeof(IRP),0xcc,irp->Size-sizeof(IRP));
+    IoReuseIrp(irp,(NTSTATUS)0xc0000001);
+    assert(Unlocks==1 && UnlockedBase==locked+3 && UnlockedBytes==71);
+    assert(irp->IoStatus.Status==(NTSTATUS)0xc0000001);
+    assert(private->AllocationFlags==flags && private->LockedBufferBytes==0);
+    for(SIZE_T pos=IOP_XBOX_IRP_PRIVATE_SIZE+irp->Size;pos<record->Bytes;pos++)
+        assert(record->Base[pos]==0xa5);
+
+    irp->Size=1;irp->StackCount=-1;irp->CurrentLocation=0;
+    IoFreeIrp(irp);
+    assert(ExQueryDepthSList(&Lookasides[LookasideLargeIrpList][0].L.ListHead)==1);
+    assert_no_active_allocations();
+}
+
+static void test_associated_and_reserve_routes(void)
+{
+    PIRP master=IoAllocateIrp(3,FALSE);assert(master);
+    master->Tail.Overlay.Thread=(PETHREAD)(uintptr_t)0x1234;
+    PIRP associated=IoMakeAssociatedIrp(master,2);assert(associated);
+    PIOP_XBOX_IRP_PRIVATE associated_private=IopLookupIrpPrivate(associated);
+    assert(associated_private);
+    assert(associated_private->InternalFlags&IOP_IRP_ASSOCIATED_IRP);
+    assert(associated_private->AssociatedIrp.MasterIrp==master);
+    assert(associated->Tail.Overlay.Thread==master->Tail.Overlay.Thread);
+    IoFreeIrp(associated);IoFreeIrp(master);assert_no_active_allocations();
+
+    assert(IopInitializeReserveIrp(&IopReserveIrpAllocator));
+    assert(IopReserveIrpAllocator.StackSize==20);
+    PIRP reserve=IopAllocateReserveIrp(8);assert(reserve==IopReserveIrpAllocator.ReserveIrp);
+    assert(reserve->StackCount==8 && reserve->Size==IoSizeOfIrp(8));
+    assert(IopAllocateReserveIrp(21)==NULL);
+    IopFreeReserveIrp(3);
+    assert(IopReserveIrpAllocator.ReserveIrpInUse==0);
+    assert(IopReserveIrpAllocator.WaitEvent.Signals==1);
+    IoFreeIrp(IopReserveIrpAllocator.ReserveIrp);
+    memset(&IopReserveIrpAllocator,0,sizeof(IopReserveIrpAllocator));
+    assert_no_active_allocations();
+}
+
+static void test_pool_failure_and_caller_guard(void)
+{
+    PoolFailureBudget=1;
+    assert(IoAllocateIrp(9,FALSE)==NULL);
+    const CCHAR stacks=8;const USHORT packet=IoSizeOfIrp(stacks);
+    unsigned char *guarded=malloc(packet+32);assert(guarded);memset(guarded,0xa5,packet+32);
+    PIRP caller=(PIRP)(guarded+16);
+    IoInitializeIrp(caller,packet,stacks);
+    for(unsigned i=0;i<16;i++)assert(guarded[i]==0xa5);
+    for(unsigned i=16+packet;i<packet+32;i++)assert(guarded[i]==0xa5);
+    assert(caller->Type==IO_TYPE_IRP && caller->Size==packet);
+    assert(IopLookupIrpPrivate(caller)==NULL);free(guarded);
+}
+
+int main(void)
+{
+    assert(sizeof(IOP_XBOX_IRP_PRIVATE)==IOP_XBOX_IRP_PRIVATE_SIZE);
+    initialize_runtime();
+    test_stack_matrix();
+    test_lookaside_hit_miss_and_free_routes();
+    test_quota_routes();
+    test_mutation_and_reuse();
+    test_associated_and_reserve_routes();
+    test_pool_failure_and_caller_guard();
+    assert_no_active_allocations();
+    printf("Xbox IRP production allocator/free matrix: 0/1/2/3/4/8/9 stacks PASS; "
+           "%u pool allocations, %u quota allocations, %u pool frees, %u quota returns\n",
+           PoolAllocations,QuotaAllocations,PoolFrees,QuotaReturns);
+    return 0;
+}
