+#!/usr/bin/env python3
+"""Compile the production Xbox IRP ownership and reinitialization bodies."""
+
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+SOURCE = (ROOT / "ntoskrnl/io/iomgr/irp.c").read_text()
+
+
+def function(name: str) -> str:
+    match = re.search(rf"\n(?:[A-Za-z_][^\n]*\n)*{name}\s*\([^;]*?\)\s*\{{",
+                      SOURCE, re.S)
+    if not match:
+        raise AssertionError(f"missing production function {name}")
+    begin = match.start() + 1
+    brace = SOURCE.find("{", match.start())
+    depth = 0
+    for pos in range(brace, len(SOURCE)):
+        depth += (SOURCE[pos] == "{") - (SOURCE[pos] == "}")
+        if depth == 0:
+            return SOURCE[begin:pos + 1] + "\n"
+    raise AssertionError(f"unterminated production function {name}")
+
+
+def declaration(begin: str, end: str) -> str:
+    start = SOURCE.index(begin)
+    finish = SOURCE.index(end, start) + len(end)
+    return SOURCE[start:finish] + "\n"
+
+
+types = declaration("typedef union _IOP_IRP_ASSOCIATED_STATE",
+                    "IOP_IRP_ASSOCIATED_STATE, *PIOP_IRP_ASSOCIATED_STATE;")
+types += declaration("typedef struct _IOP_XBOX_IRP_STATE",
+                     "IOP_XBOX_IRP_STATE, *PIOP_XBOX_IRP_STATE;")
+types += declaration("typedef struct DECLSPEC_ALIGN(MEMORY_ALLOCATION_ALIGNMENT) _IOP_XBOX_IRP_PRIVATE",
+                     "IOP_XBOX_IRP_PRIVATE, *PIOP_XBOX_IRP_PRIVATE;")
+bodies = "\n".join(function(name) for name in (
+    "IopOwnedIrpPrivate",
+    "IopIrpLookasideListType",
+    "IopLookupIrpPrivateAllocation",
+    "IopLookupIrpPrivate",
+    "IopValidateIrpPrivate",
+    "IopInitializeIrpState",
+    "IopInitializeIrpPrivate",
+    "IopResetIrpPrivateState",
+    "IopReferenceIrpState",
+    "IopGetIrpCancelRoutine",
+    "IopGetIrpMasterIrpPointer",
+    "IopSetIrpMasterIrp",
+    "IopGetIrpAllocationFlags",
+    "IopSetIrpAllocationFlags",
+    "IopOrIrpInternalFlags",
+    "IopUnlockXboxIrpBufferPrivate",
+    "IopInitializeIrpPacket",
+    "IoInitializeIrp",
+    "IoAllocateIrp",
+    "IoFreeIrp",
+    "IoReuseIrp",
+    "IoMakeAssociatedIrp",
+    "IopInitializeReserveIrp",
+    "IopAllocateReserveIrp",
+    "IopFreeReserveIrp",
+))
+
+template = Path(__file__).with_name("fixture.c").read_text()
+source = template.replace("/* PRODUCTION_TYPES */", types)
+source = source.replace("/* PRODUCTION_BODIES */", bodies)
+
+with tempfile.TemporaryDirectory(prefix="irp-private-lifetime-") as directory:
+    directory = Path(directory)
+    c_file = directory / "fixture.c"
+    executable = directory / "fixture"
+    c_file.write_text(source)
+    subprocess.run([
+        "cc", "-std=c11", "-O2", "-g", "-Wall", "-Wextra", "-Werror",
+        "-Wno-unused-function", "-fsanitize=address,undefined",
+        "-fno-omit-frame-pointer", str(c_file), "-o", str(executable),
+    ], check=True)
+    subprocess.run([str(executable)], check=True)
