+    /* Insertion failure is fatal for an owned embedded APC too. */
+    reset();queue_failures=1;
+    irp=calloc(1,sizeof(*irp));assert(irp);allocated++;
+    irp->Private=calloc(1,sizeof(*irp->Private));assert(irp->Private);
+    irp->Private->Irp=irp;irp->IoStatus.Status=0;
