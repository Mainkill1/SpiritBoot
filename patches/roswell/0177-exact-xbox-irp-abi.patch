+
+static PSLIST_ENTRY InterlockedPopEntrySList(PSLIST_HEADER head)
+{
+    PSLIST_ENTRY entry=head->Head;
+    if(entry){head->Head=entry->Next;assert(head->Depth);head->Depth--;}
+    return entry;
+}
+static PSLIST_ENTRY InterlockedPushEntrySList(PSLIST_HEADER head,PSLIST_ENTRY entry)
+{
+    PSLIST_ENTRY old=head->Head;entry->Next=old;head->Head=entry;head->Depth++;return old;
+}
+static USHORT ExQueryDepthSList(PSLIST_HEADER head){return head->Depth;}
