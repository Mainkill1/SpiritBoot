--- /dev/null
+++ b/tests/host/cold-storage-persistence/check.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[3]
+HERE = Path(__file__).resolve().parent
+GUEST = ROOT / "tests/xbe/cold-storage-persistence"
+
+
+def run(command, **kwargs):
+    return subprocess.run(command, check=True, text=True, **kwargs)
+
+
+def grade(tmp: Path, phase_a: str, phase_b: str, succeeds: bool):
+    a = tmp / "phase-a.log"
+    b = tmp / "phase-b.log"
+    a.write_text(phase_a)
+    b.write_text(phase_b)
+    result = subprocess.run(
+        [sys.executable, str(GUEST / "grade.py"), str(a), str(b)],
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+    )
+    if (result.returncode == 0) != succeeds:
+        raise AssertionError(result.stdout)
+
+
+with tempfile.TemporaryDirectory(prefix="cold-storage-host-") as raw:
+    tmp = Path(raw)
+    binary = tmp / "contract-test"
+    run([
+        "cc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
+        "-I", str(ROOT / "tests/host/cold-storage-persistence"),
+        str(HERE / "contract_test.c"), "-o", str(binary),
+    ])
+    run([str(binary)])
+
+    a = (
+        "kernel noise\n"
+        "COLD_STORAGE_RESULT phase=A status=PASS bytes=2097152 "
+        "digest=238f8a85 writes=50\n"
+    )
+    b = (
+        "COLD_STORAGE_RESULT phase=B status=PASS bytes=2097152 "
+        "digest=238f8a85 sync_reads=50 async_reads=50 pending_reads=50\n"
+    )
+    grade(tmp, a, b, True)
+    grade(tmp, a, b.replace("pending_reads=50", "pending_reads=0"), False)
+    grade(tmp, a, b.replace("digest=238f8a85", "digest=238f8a84"), False)
+    grade(tmp, a.replace("status=PASS", "status=FAIL"), b, False)
+    grade(tmp, a, "kernel stopped before result\n", False)
+    grade(tmp, a.replace("2097152", "1024"),
+          b.replace("2097152", "1024"), False)
+    grade(tmp, a.replace("writes=50", "writes=49"), b, False)
+    grade(tmp, a, b.replace("sync_reads=50", "sync_reads=49"), False)
+    grade(tmp, a, b.replace("pending_reads=50", "pending_reads=51"), False)
+
+print("PASS: cold-storage two-phase host contract and serial grader")
diff --git a/tests/host/cold-storage-persistence/contract_test.c b/tests/host/cold-storage-persistence/contract_test.c
new file mode 100644
index 00000000..63fbb25b
--- /dev/null
+++ b/tests/host/cold-storage-persistence/contract_test.c
@@ -0,0 +1,67 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "../../xbe/cold-storage-persistence/contract.h"
+
+static int fail(const char *message)
+{
+    fprintf(stderr, "FAIL: %s\n", message);
+    return 1;
+}
+
+int main(void)
+{
+    static const struct {
+        uint32_t offset;
+        uint8_t expected;
+    } vectors[] = {
+        {0, 0x77}, {1, 0x87}, {2, 0x5a}, {511, 0xc7},
+        {512, 0x03}, {4095, 0x4c}, {4096, 0x7f}, {65535, 0x16},
+        {1048575, 0xbc}, {2097151, 0x86},
+    };
+    uint32_t digest = COLD_FNV1A_OFFSET;
+    uint32_t remaining = COLD_TOTAL_BYTES;
+    uint32_t offset = 0;
+    uint32_t requests = 0;
+    struct cold_manifest manifest;
+
+    if (sizeof(manifest) != 28)
+        return fail("manifest is not the compact 28-byte disk record");
+    for (unsigned i = 0; i < sizeof(vectors) / sizeof(vectors[0]); ++i)
+        if (cold_pattern_byte(COLD_PATTERN_SEED, vectors[i].offset) !=
+            vectors[i].expected)
+            return fail("pattern changed from the independent known vectors");
+
+    while (remaining) {
+        uint32_t length = cold_chunk_length(requests, remaining);
+        if (!length || length > COLD_MAX_CHUNK || length > remaining ||
+            (length & 511))
+            return fail("chunk schedule is not bounded and sector aligned");
+        for (uint32_t i = 0; i < length; ++i)
+            digest = cold_fnv1a_byte(digest,
+                cold_pattern_byte(COLD_PATTERN_SEED, offset + i));
+        offset += length;
+        remaining -= length;
+        ++requests;
+    }
+    if (requests != 50)
+        return fail("multi-request file no longer uses 50 writes");
+    if (digest != UINT32_C(0x238f8a85))
+        return fail("full payload digest changed from independent fixture");
+
+    cold_manifest_init(&manifest, requests, digest);
+    if (!cold_manifest_valid(&manifest))
+        return fail("fresh manifest does not validate");
+    if (manifest.checksum != UINT32_C(0xa599ded0))
+        return fail("manifest checksum changed from independent fixture");
+    for (unsigned byte = 0; byte < sizeof(manifest); ++byte) {
+        struct cold_manifest corrupt = manifest;
+        ((uint8_t *)&corrupt)[byte] ^= UINT8_C(0x80);
+        if (cold_manifest_valid(&corrupt))
+            return fail("single-byte manifest corruption was accepted");
+    }
+
+    puts("PASS: deterministic multi-request payload and manifest contract");
+    return 0;
+}
