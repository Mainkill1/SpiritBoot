+static void test_async_public_buffered_read_preserves_forwarded_changes(void)
+{
+    reset_counters();
+    DEVICE_OBJECT Device={DO_BUFFERED_IO,1};
+    unsigned char Buffer[257];
+    LARGE_INTEGER Offset={23};
+    IO_STATUS_BLOCK Iosb={0};
+    memset(Buffer,0x31,sizeof(Buffer));
+
+    PIRP Irp=XeIoBuildAsynchronousFsdRequest(IRP_MJ_READ,&Device,Buffer+1,
+                                              256,&Offset,&Iosb);
+    assert(Irp);
+    assert(Irp->UserBuffer==Buffer+1);
+    assert(Irp->UserEvent==NULL && Irp->UserIosb==&Iosb);
+    assert(Irp->SegmentArray==NULL);
+    assert(Irp->LockedBufferLength==256);
+    assert(Irp->Flags==IRP_UNLOCK_USER_BUFFER);
+    assert(QueueCalls==0 && PublishCalls==1);
+    assert(PoolAllocations==0 && CopyCalls==0);
+
+    /* A title can hand the packet to a kernel storage driver. Both sides
+     * address the caller's original buffer, so the dispatch result is visible
+     * immediately and completion has no bounce data to copy over it. */
+    unsigned char *KernelBuffer=kernel_buffered_modeled_consumer(Irp);
+    assert(KernelBuffer==Buffer+1);
+    KernelBuffer[0]=0xA1;
+    KernelBuffer[255]=0xB2;
+    assert(Buffer[1]==0xA1 && Buffer[256]==0xB2);
+
+    complete_and_release(Irp);
+    assert(CopyCalls==0 && PoolFrees==0);
+    assert(LegacyUnlocks==1);
+    assert(LastLegacyUnlockBuffer==Buffer+1);
+    assert(LastLegacyUnlockLength==256);
+}
+
+static void test_synchronous_builder_public_buffered_write_preserves_changes(void)
+{
