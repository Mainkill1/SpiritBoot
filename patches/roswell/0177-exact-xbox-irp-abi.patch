+    assert(Irp->UserBuffer==Buffer+1);
+    assert(Private->AssociatedIrp.SystemBuffer==Buffer+1);
+    assert(Private->InternalFlags==0);
+    assert(Private->LockedBufferBase==Buffer+1);
+    assert(Private->LockedBufferBytes==512);
+    assert(Irp->LockedBufferLength==512);
+    assert(Irp->Flags==IRP_UNLOCK_USER_BUFFER);
+    assert(Irp->SegmentArray==NULL);
+    assert(PoolAllocations==0 && CopyCalls==0);
