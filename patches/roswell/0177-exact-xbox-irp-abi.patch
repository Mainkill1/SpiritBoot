+    assert(Irp->UserEvent==&Event && Irp->UserIosb==&Iosb);
+    assert(Irp->LockedBufferLength==128);
+    assert(Irp->Flags==IRP_UNLOCK_USER_BUFFER);
+    assert(QueueCalls==1 && PublishCalls==1 && EventInitializations==1);
+    assert(PoolAllocations==0 && CopyCalls==0);
