+    PagingIo = BooleanFlagOn(IopGetIrpInternalFlags(IrpContext->Irp), IOP_IRP_PAGING_IO);
     CanWait = BooleanFlagOn(IrpContext->Flags, IRPCONTEXT_CANWAIT);
     NoCache = BooleanFlagOn(IrpContext->Irp->Flags, IRP_NOCACHE);
 
@@ -1278,9 +1282,9 @@ VfatRead(
      * here.  Keep this after the asynchronous post decision: Complex returns
