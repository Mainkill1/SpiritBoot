+++ b/tests/host/irp-direct-builder/check.py
@@ -0,0 +1,226 @@
+#!/usr/bin/env python3
+"""Exercise the production Xbox FSD-request builder's direct-I/O contract."""
+
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+IRP_SOURCE = (ROOT / "ntoskrnl/io/iomgr/irp.c").read_text()
+XBE_SOURCE = (ROOT / "ntoskrnl/xb/xbe.c").read_text()
+IOTYPES_SOURCE = (ROOT / "sdk/include/xdk/iotypes.h").read_text()
+
+
+def function(source: str, name: str) -> str:
+    match = re.search(
+        rf"\n(?:[A-Za-z_][^\n]*\n)*{name}\s*\([^;]*?\)\s*\{{",
+        source,
+        re.S,
+    )
+    if not match:
+        raise AssertionError(f"missing production function {name}")
+    begin = match.start() + 1
+    brace = source.find("{", match.start())
+    depth = 0
+    for pos in range(brace, len(source)):
+        depth += (source[pos] == "{") - (source[pos] == "}")
+        if depth == 0:
+            return source[begin : pos + 1] + "\n"
+    raise AssertionError(f"unterminated production function {name}")
+
+
+def between(begin: str, end: str, *, after: int = 0) -> str:
+    start = IRP_SOURCE.index(begin, after)
+    finish = IRP_SOURCE.index(end, start)
+    return IRP_SOURCE[start:finish]
+
+
+builder_common = function(IRP_SOURCE, "IopBuildXboxFsdRequestCommon")
+builder_wrapper = function(IRP_SOURCE, "IopBuildXboxFsdRequest")
+public_builder = function(IRP_SOURCE, "IopBuildXboxPublicFsdRequest")
+builder = builder_common + "\n" + builder_wrapper + "\n" + public_builder
+direct_branch = "else if (DeviceObject->Flags & DO_DIRECT_IO)"
+if builder_common.count(direct_branch) != 1:
+    raise AssertionError("expected one production Xbox direct-I/O branch")
+mutant_builder = (
+    builder_common.replace(direct_branch, "else if (FALSE)", 1)
+    + "\n"
+    + builder_wrapper
+    + "\n"
+    + public_builder
+)
+zero_length_guard = "if (Length != 0)"
+direct_start = builder_common.index(direct_branch)
+direct_body = builder_common[direct_start:]
+if direct_body.count(zero_length_guard) != 1:
+    raise AssertionError("expected one production direct-I/O zero-length MDL guard")
+zero_length_start = builder_common.index(zero_length_guard, direct_start)
+zero_length_mutant_common = (
+    builder_common[:zero_length_start]
+    + "if (TRUE)"
+    + builder_common[zero_length_start + len(zero_length_guard):]
+)
+zero_length_mutant_builder = (
+    zero_length_mutant_common
+    + "\n"
+    + builder_wrapper
+    + "\n"
+    + public_builder
+)
+await_request = function(XBE_SOURCE, "XbIoAwaitRequest")
+async_wrapper = function(XBE_SOURCE, "XeIoBuildAsynchronousFsdRequest")
+sync_wrapper = function(XBE_SOURCE, "XeIoBuildSynchronousFsdRequest")
+ordinal85_wrapper = function(XBE_SOURCE, "XeIoSynchronousFsdRequest")
+xbe_wrappers = (
+    await_request + "\n" + async_wrapper + "\n" + sync_wrapper + "\n" +
+    ordinal85_wrapper
+)
+
+
+def private_route_mutant(wrapper: str) -> str:
+    call = "IopBuildXboxPublicFsdRequest("
+    if wrapper.count(call) != 1:
+        raise AssertionError("expected one public-builder call in wrapper")
+    return wrapper.replace(call, "IopBuildXboxPrivateFsdRequest(", 1)
+
+
+async_mutant = (
+    await_request + "\n" + private_route_mutant(async_wrapper) + "\n" +
+    sync_wrapper + "\n" + ordinal85_wrapper
+)
+sync_mutant = (
+    await_request + "\n" + async_wrapper + "\n" +
+    private_route_mutant(sync_wrapper) + "\n" + ordinal85_wrapper
+)
+ordinal85_mutant = (
+    await_request + "\n" + async_wrapper + "\n" + sync_wrapper + "\n" +
+    private_route_mutant(ordinal85_wrapper)
+)
+unlock = between(
+    "    /* Unlock MDL Pages, page 167. */",
+    "    /* Check if we should exit because of a Deferred I/O",
+    after=IRP_SOURCE.index("IofCompleteRequest(IN PIRP Irp"),
+)
+core_start = IRP_SOURCE.index("static VOID\nIopCompleteRequestCore(IN PIRP Irp")
+free = between(
+    "    if (InternalFlags & IOP_IRP_BUFFERED_IO)\n",
+    "\n    if ((InternalFlags & IOP_IRP_XB_SG_COMPLETION)",
+    after=core_start,
+)
+private_unlock = function(IRP_SOURCE, "IopUnlockXboxIrpBufferPrivate")
+
+template = Path(__file__).with_name("fixture.c").read_text()
+
+
+def literal_defines(source: str, names: tuple[str, ...]) -> dict[str, int]:
+    values = {}
+    for name in names:
+        matches = re.findall(
+            rf"^#define\s+{re.escape(name)}\s+"
+            rf"(0[xX][0-9a-fA-F]+|[0-9]+)[uUlL]*\s*$",
+            source,
+            re.MULTILINE,
+        )
+        if len(matches) != 1:
+            raise AssertionError(f"expected one literal definition for {name}")
+        values[name] = int(matches[0], 0)
+    return values
+
+
+major_section = IOTYPES_SOURCE[IOTYPES_SOURCE.index("IRP function codes") :]
+major_xbox = major_section[
+    major_section.index("#ifdef SARCH_XBOX") : major_section.index("#else")
+]
+major_names = (
+    "IRP_MJ_READ",
+    "IRP_MJ_WRITE",
+    "IRP_MJ_FLUSH_BUFFERS",
+    "IRP_MJ_SHUTDOWN",
+    "IRP_MJ_POWER",
+    "IRP_MJ_PNP",
+)
+header_majors = literal_defines(major_xbox, major_names)
+fixture_majors = literal_defines(template, major_names)
+if fixture_majors != header_majors:
+    raise AssertionError(
+        f"fixture Xbox major values drifted: {fixture_majors!r} != {header_majors!r}"
+    )
+
+with tempfile.TemporaryDirectory(prefix="irp-direct-builder-") as directory:
+    directory = Path(directory)
+    def build(name: str, selected_builder: str, selected_xbe: str,
+              sanitizers: bool) -> Path:
+        fixture = template.replace("/* PRODUCTION_BUILDER */", selected_builder)
+        fixture = fixture.replace("/* PRODUCTION_XBE_WRAPPERS */", selected_xbe)
+        fixture = fixture.replace("/* PRODUCTION_COMPLETION_UNLOCK */", unlock)
+        fixture = fixture.replace("/* PRODUCTION_COMPLETION_FREE */", free)
+        fixture = fixture.replace("/* PRODUCTION_PRIVATE_UNLOCK */", private_unlock)
+        c_file = directory / f"{name}.c"
+        executable = directory / name
+        c_file.write_text(fixture)
+        command = [
+            "cc",
+            "-std=c11",
+            "-O2",
+            "-g",
+            "-Wall",
+            "-Wextra",
+            "-Werror",
+            "-Wno-clobbered",
+            "-Wno-unused-function",
+        ]
+        if sanitizers:
+            command += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
+        command += [str(c_file), "-o", str(executable)]
+        subprocess.run(command, check=True)
+        return executable
+
+    # Red proof: removing the direct-I/O branch recreates the missing-MDL
+    # behavior and must fail the first consumer assertion.
+    def reject_mutant(name: str, selected_builder: str, selected_xbe: str,
+                      expected_failure: bytes) -> None:
+        mutant = build(name, selected_builder, selected_xbe, False)
+        result = subprocess.run(
+            [str(mutant)], stdout=subprocess.PIPE, stderr=subprocess.PIPE
+        )
+        if result.returncode == 0:
+            raise AssertionError(f"fixture did not reject {name}")
+        if expected_failure not in result.stderr:
+            raise AssertionError(
