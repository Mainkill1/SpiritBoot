new file mode 100644
index 00000000..7275efd4
--- /dev/null
+++ b/tests/xbe/cold-storage-persistence/contract.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define COLD_MANIFEST_MAGIC UINT32_C(0x43505342)
+#define COLD_MANIFEST_VERSION UINT32_C(1)
+#define COLD_TOTAL_BYTES UINT32_C(2097152)
+#define COLD_PATTERN_SEED UINT32_C(0x51f15eed)
+#define COLD_MAX_CHUNK UINT32_C(131072)
+#define COLD_FNV1A_OFFSET UINT32_C(2166136261)
+#define COLD_EXPECTED_WRITES UINT32_C(50)
+#define COLD_EXPECTED_DIGEST UINT32_C(0x238f8a85)
+
+struct cold_manifest {
+    uint32_t magic;
+    uint32_t version;
+    uint32_t total_bytes;
+    uint32_t pattern_seed;
+    uint32_t write_requests;
+    uint32_t content_digest;
+    uint32_t checksum;
+};
+
+static inline uint8_t cold_pattern_byte(uint32_t seed, uint32_t offset)
+{
+    uint32_t value = seed ^ offset;
+    value ^= value >> 16;
+    value *= UINT32_C(0x7feb352d);
+    value ^= value >> 15;
+    value *= UINT32_C(0x846ca68b);
+    value ^= value >> 16;
+    return (uint8_t)value;
+}
+
+static inline uint32_t cold_fnv1a_byte(uint32_t digest, uint8_t byte)
+{
+    return (digest ^ byte) * UINT32_C(16777619);
+}
+
+static inline uint32_t cold_fnv1a(const void *data, size_t length)
+{
+    const uint8_t *bytes = (const uint8_t *)data;
+    uint32_t digest = COLD_FNV1A_OFFSET;
+    while (length--)
+        digest = cold_fnv1a_byte(digest, *bytes++);
+    return digest;
+}
+
+static inline uint32_t cold_chunk_length(uint32_t request,
+                                         uint32_t remaining)
+{
+    static const uint32_t lengths[] = {
+        4096, 65536, 16384, 131072, 8192, 32768,
+    };
+    uint32_t length = lengths[request %
+        (sizeof(lengths) / sizeof(lengths[0]))];
+    return length < remaining ? length : remaining;
+}
+
+static inline void cold_manifest_init(struct cold_manifest *manifest,
+                                      uint32_t requests,
+                                      uint32_t content_digest)
+{
+    manifest->magic = COLD_MANIFEST_MAGIC;
+    manifest->version = COLD_MANIFEST_VERSION;
+    manifest->total_bytes = COLD_TOTAL_BYTES;
+    manifest->pattern_seed = COLD_PATTERN_SEED;
+    manifest->write_requests = requests;
+    manifest->content_digest = content_digest;
+    manifest->checksum = cold_fnv1a(manifest,
+        offsetof(struct cold_manifest, checksum));
+}
+
+static inline int cold_manifest_valid(const struct cold_manifest *manifest)
+{
+    return manifest->magic == COLD_MANIFEST_MAGIC &&
+        manifest->version == COLD_MANIFEST_VERSION &&
+        manifest->total_bytes == COLD_TOTAL_BYTES &&
+        manifest->pattern_seed == COLD_PATTERN_SEED &&
+        manifest->write_requests != 0 &&
+        manifest->checksum == cold_fnv1a(manifest,
+            offsetof(struct cold_manifest, checksum));
+}
diff --git a/tests/xbe/cold-storage-persistence/grade.py b/tests/xbe/cold-storage-persistence/grade.py
new file mode 100644
index 00000000..31cf8fde
--- /dev/null
+++ b/tests/xbe/cold-storage-persistence/grade.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Grade separate cold-storage author and verify serial captures."""
+
+import re
+import sys
+from pathlib import Path
+
+
+PREFIX = "COLD_STORAGE_RESULT "
+EXPECTED_BYTES = 2097152
+EXPECTED_REQUESTS = 50
+EXPECTED_DIGEST = "238f8a85"
+
+
+def result(path: Path, expected_phase: str) -> dict[str, str]:
+    matches = []
+    for line in path.read_text(errors="replace").splitlines():
+        if PREFIX not in line:
+            continue
+        fields = dict(re.findall(r"([a-z_]+)=([^ ]+)", line.split(PREFIX, 1)[1]))
+        matches.append(fields)
+    if len(matches) != 1:
+        raise ValueError(f"{path}: expected one result marker, found {len(matches)}")
+    fields = matches[0]
+    if fields.get("phase") != expected_phase:
+        raise ValueError(f"{path}: expected phase {expected_phase}")
+    if fields.get("status") != "PASS":
+        raise ValueError(f"{path}: phase {expected_phase} did not pass")
+    return fields
+
+
+def positive(fields: dict[str, str], name: str, source: Path) -> int:
+    try:
+        value = int(fields[name], 10)
+    except (KeyError, ValueError) as error:
+        raise ValueError(f"{source}: invalid {name}") from error
+    if value <= 0:
+        raise ValueError(f"{source}: {name} must be positive")
+    return value
+
+
+def main() -> int:
+    if len(sys.argv) != 3:
+        print("usage: grade.py PHASE_A_SERIAL PHASE_B_SERIAL", file=sys.stderr)
+        return 2
+    phase_a_path, phase_b_path = map(Path, sys.argv[1:])
+    try:
+        phase_a = result(phase_a_path, "A")
+        phase_b = result(phase_b_path, "B")
+        a_bytes = positive(phase_a, "bytes", phase_a_path)
+        b_bytes = positive(phase_b, "bytes", phase_b_path)
+        writes = positive(phase_a, "writes", phase_a_path)
+        sync_reads = positive(phase_b, "sync_reads", phase_b_path)
+        async_reads = positive(phase_b, "async_reads", phase_b_path)
+        pending_reads = positive(phase_b, "pending_reads", phase_b_path)
+        if a_bytes != EXPECTED_BYTES or b_bytes != EXPECTED_BYTES:
+            raise ValueError("phase byte counts do not match the fixed contract")
+        if writes != EXPECTED_REQUESTS or sync_reads != EXPECTED_REQUESTS or \
+                async_reads != EXPECTED_REQUESTS:
+            raise ValueError("phase request counts do not match the fixed contract")
+        if pending_reads > async_reads:
+            raise ValueError("pending read count exceeds asynchronous requests")
+        if phase_a.get("digest") != EXPECTED_DIGEST or \
+                phase_b.get("digest") != EXPECTED_DIGEST:
+            raise ValueError("phase content digest does not match the fixed contract")
+    except (OSError, ValueError) as error:
+        print(f"FAIL: {error}", file=sys.stderr)
+        return 1
+    print(
+        "PASS: cold-storage phase A/B persisted "
+        f"{a_bytes} bytes with digest {phase_a['digest']}"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/xbe/cold-storage-persistence/main.c b/tests/xbe/cold-storage-persistence/main.c
new file mode 100644
index 00000000..0c568157
--- /dev/null
+++ b/tests/xbe/cold-storage-persistence/main.c
@@ -0,0 +1,367 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Durable two-cold-boot FATX and public-I/O completion regression. */
+#include <stdio.h>
+#include <string.h>
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+
+#include "../regression.h"
+#include "contract.h"
+
+#ifndef STATUS_NO_SUCH_FILE
+#define STATUS_NO_SUCH_FILE ((NTSTATUS)0xc000000fL)
+#endif
+#ifndef STATUS_DATA_ERROR
+#define STATUS_DATA_ERROR ((NTSTATUS)0xc000003eL)
+#endif
+
+#define VOLUME_PATH "\\Device\\Harddisk0\\Partition1"
+#define PAYLOAD_PATH VOLUME_PATH "\\SpiritBootColdPayload.bin"
+#define SPACER_PATH VOLUME_PATH "\\SpiritBootColdSpacer.bin"
+#define MANIFEST_PATH VOLUME_PATH "\\SpiritBootColdManifest.bin"
+
+static unsigned char io_buffer[COLD_MAX_CHUNK] __attribute__((aligned(4096)));
+static unsigned char spacer_buffer[COLD_MAX_CHUNK] __attribute__((aligned(4096)));
+static char current_phase = '?';
+
+static void phase_fail(const char *reason, NTSTATUS status,
+                       const char *description) __attribute__((noreturn));
+static void phase_fail(const char *reason, NTSTATUS status,
+                       const char *description)
+{
+    char result[256];
+    regression_check(0, description);
+    snprintf(result, sizeof(result),
+        "COLD_STORAGE_RESULT phase=%c status=FAIL reason=%s code=%08lx\n",
+        current_phase, reason, (unsigned long)status);
+    tap_puts(result);
+    regression_finish();
+}
+
+static void phase_require(int passed, const char *reason, NTSTATUS status,
+                          const char *description)
+{
+    if (!passed)
+        phase_fail(reason, status, description);
+}
+
+static NTSTATUS open_file(const char *path, ACCESS_MASK access,
+                          ULONG disposition, ULONG options, int synchronous,
+                          HANDLE *handle)
+{
+    ANSI_STRING name;
+    OBJECT_ATTRIBUTES attributes;
+    IO_STATUS_BLOCK iosb;
+
+    RtlInitAnsiString(&name, path);
+    InitializeObjectAttributes(&attributes, &name, OBJ_CASE_INSENSITIVE,
+                               NULL, NULL);
+    if (synchronous) {
+        access |= SYNCHRONIZE;
+        options |= FILE_SYNCHRONOUS_IO_NONALERT;
+    }
+    return NtCreateFile(handle, access, &attributes, &iosb, NULL,
+        FILE_ATTRIBUTE_NORMAL,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        disposition, options);
+}
+
+static int manifest_exists(NTSTATUS *open_status)
+{
+    HANDLE manifest;
+    *open_status = open_file(MANIFEST_PATH, GENERIC_READ, FILE_OPEN,
+        FILE_NON_DIRECTORY_FILE, 1, &manifest);
+    if (NT_SUCCESS(*open_status)) {
+        NtClose(manifest);
+        return 1;
+    }
+    if (*open_status == (NTSTATUS)STATUS_OBJECT_NAME_NOT_FOUND ||
+        *open_status == (NTSTATUS)STATUS_OBJECT_PATH_NOT_FOUND ||
+        *open_status == STATUS_NO_SUCH_FILE)
+        return 0;
+    current_phase = '?';
+    phase_fail("manifest_probe", *open_status,
+               "manifest probe either opens or reports missing");
+}
+
+static void flush_and_close(HANDLE handle, const char *flush_reason,
+                            const char *close_reason)
+{
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status = NtFlushBuffersFile(handle, &iosb);
+    phase_require(status == STATUS_SUCCESS && iosb.Status == STATUS_SUCCESS,
+        flush_reason, status, "file data and metadata flush successfully");
+    status = NtClose(handle);
+    phase_require(status == STATUS_SUCCESS, close_reason, status,
+                  "flushed file closes successfully");
+}
+
+static void flush_volume(void)
+{
+    HANDLE volume;
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status = open_file(VOLUME_PATH, GENERIC_READ, FILE_OPEN, 0, 1,
+                                &volume);
+    phase_require(status == STATUS_SUCCESS, "volume_open", status,
+                  "data volume opens for final persistence barrier");
+    status = NtFlushBuffersFile(volume, &iosb);
+    phase_require(status == STATUS_SUCCESS && iosb.Status == STATUS_SUCCESS,
+                  "volume_flush", status,
+                  "data volume accepts final persistence barrier");
+    status = NtClose(volume);
+    phase_require(status == STATUS_SUCCESS, "volume_close", status,
+                  "data volume closes after persistence barrier");
+}
+
+static void fill_buffers(uint32_t offset, uint32_t length)
+{
+    for (uint32_t i = 0; i < length; ++i) {
+        unsigned char value = cold_pattern_byte(COLD_PATTERN_SEED, offset + i);
+        io_buffer[i] = value;
+        spacer_buffer[i] = (unsigned char)~value;
+    }
+}
+
+static void author_phase(void)
+{
+    HANDLE payload, spacer, manifest_file;
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status;
+    uint32_t offset = 0;
+    uint32_t request = 0;
+    uint32_t digest = COLD_FNV1A_OFFSET;
+    struct cold_manifest manifest;
+
+    current_phase = 'A';
+    status = open_file(PAYLOAD_PATH, GENERIC_READ | GENERIC_WRITE,
+        FILE_OVERWRITE_IF,
+        FILE_NON_DIRECTORY_FILE | FILE_NO_INTERMEDIATE_BUFFERING, 1,
+        &payload);
+    phase_require(status == STATUS_SUCCESS, "payload_create", status,
+                  "phase A creates or overwrites its payload");
+    status = open_file(SPACER_PATH, GENERIC_READ | GENERIC_WRITE,
+        FILE_OVERWRITE_IF,
+        FILE_NON_DIRECTORY_FILE | FILE_NO_INTERMEDIATE_BUFFERING, 1,
+        &spacer);
+    phase_require(status == STATUS_SUCCESS, "spacer_create", status,
+                  "phase A creates or overwrites its interleaving file");
+
+    while (offset < COLD_TOTAL_BYTES) {
+        uint32_t length = cold_chunk_length(request,
+                                             COLD_TOTAL_BYTES - offset);
+        LARGE_INTEGER position = { .QuadPart = offset };
+        fill_buffers(offset, length);
+        status = NtWriteFile(payload, NULL, NULL, NULL, &iosb, io_buffer,
+                             length, &position);
+        phase_require(status == STATUS_SUCCESS && iosb.Status == STATUS_SUCCESS &&
+                      iosb.Information == length,
+                      "payload_write", status,
+                      "phase A payload request completes exactly");
+        status = NtWriteFile(spacer, NULL, NULL, NULL, &iosb, spacer_buffer,
+                             length, &position);
+        phase_require(status == STATUS_SUCCESS && iosb.Status == STATUS_SUCCESS &&
+                      iosb.Information == length,
+                      "spacer_write", status,
+                      "phase A interleaving request completes exactly");
+        for (uint32_t i = 0; i < length; ++i)
+            digest = cold_fnv1a_byte(digest, io_buffer[i]);
+        offset += length;
+        ++request;
+    }
+    phase_require(request == COLD_EXPECTED_WRITES &&
+                  digest == COLD_EXPECTED_DIGEST,
+                  "author_contract", STATUS_DATA_ERROR,
+                  "phase A generated the fixed request and byte stream");
+
+    /* Alternating direct writes force the two fresh FATX chains to compete
+     * for adjacent clusters, while either chain alone spans many packets. */
+    flush_and_close(payload, "payload_flush", "payload_close");
+    flush_and_close(spacer, "spacer_flush", "spacer_close");
+
+    cold_manifest_init(&manifest, request, digest);
+    status = open_file(MANIFEST_PATH, GENERIC_READ | GENERIC_WRITE,
+        FILE_OVERWRITE_IF, FILE_NON_DIRECTORY_FILE, 1, &manifest_file);
+    phase_require(status == STATUS_SUCCESS, "manifest_create", status,
+                  "phase A opens its commit manifest last");
+    {
+        LARGE_INTEGER position = { .QuadPart = 0 };
+        status = NtWriteFile(manifest_file, NULL, NULL, NULL, &iosb,
+            &manifest, sizeof(manifest), &position);
+    }
+    phase_require(status == STATUS_SUCCESS && iosb.Status == STATUS_SUCCESS &&
+                  iosb.Information == sizeof(manifest),
+                  "manifest_write", status,
+                  "phase A writes the compact commit manifest exactly");
+    flush_and_close(manifest_file, "manifest_flush", "manifest_close");
+    flush_volume();
+
+    regression_check(1, "phase A durable payload and manifest are committed");
+    {
+        char result[256];
+        snprintf(result, sizeof(result),
+            "COLD_STORAGE_RESULT phase=A status=PASS bytes=%lu "
+            "digest=%08lx writes=%lu\n",
+            (unsigned long)COLD_TOTAL_BYTES, (unsigned long)digest,
+            (unsigned long)request);
+        tap_puts(result);
+    }
+    regression_finish();
+}
+
+static void verify_buffer(uint32_t offset, uint32_t length,
+                          uint32_t *digest, const char *reason)
+{
+    for (uint32_t i = 0; i < length; ++i) {
+        unsigned char expected = cold_pattern_byte(COLD_PATTERN_SEED,
+                                                    offset + i);
+        if (io_buffer[i] != expected)
+            phase_fail(reason, STATUS_DATA_ERROR,
+                       "phase B finds every persisted payload byte intact");
+        *digest = cold_fnv1a_byte(*digest, io_buffer[i]);
+    }
+}
+
+static void verify_phase(void)
+{
+    HANDLE manifest_file, reader, event;
+    IO_STATUS_BLOCK iosb;
+    FILE_NETWORK_OPEN_INFORMATION information;
+    struct cold_manifest manifest;
+    NTSTATUS status;
+    LARGE_INTEGER position = { .QuadPart = 0 };
+    uint32_t offset, request, digest;
+    uint32_t synchronous_reads = 0;
+    uint32_t asynchronous_reads = 0;
+    uint32_t pending_reads = 0;
+
+    current_phase = 'B';
+    status = open_file(MANIFEST_PATH, GENERIC_READ, FILE_OPEN,
+        FILE_NON_DIRECTORY_FILE, 1, &manifest_file);
+    phase_require(status == STATUS_SUCCESS, "manifest_reopen", status,
+                  "phase B reopens the prior boot manifest");
+    status = NtQueryInformationFile(manifest_file, &iosb, &information,
+        sizeof(information), FileNetworkOpenInformation);
+    phase_require(status == STATUS_SUCCESS &&
+                  information.EndOfFile.QuadPart == sizeof(manifest),
+                  "manifest_length", status,
+                  "phase B observes one exact compact manifest record");
+    status = NtReadFile(manifest_file, NULL, NULL, NULL, &iosb, &manifest,
+                        sizeof(manifest), &position);
+    phase_require(status == STATUS_SUCCESS && iosb.Status == STATUS_SUCCESS &&
+                  iosb.Information == sizeof(manifest),
+                  "manifest_read", status,
+                  "phase B reads the complete prior boot manifest");
+    status = NtClose(manifest_file);
+    phase_require(status == STATUS_SUCCESS, "manifest_read_close", status,
+                  "phase B closes the manifest reader");
+    phase_require(cold_manifest_valid(&manifest) &&
+                  manifest.write_requests == COLD_EXPECTED_WRITES &&
+                  manifest.content_digest == COLD_EXPECTED_DIGEST,
+                  "manifest_validate", STATUS_DATA_ERROR,
+                  "phase B validates manifest fields and checksum");
+
+    status = open_file(PAYLOAD_PATH, GENERIC_READ, FILE_OPEN,
+        FILE_NON_DIRECTORY_FILE | FILE_NO_INTERMEDIATE_BUFFERING, 1, &reader);
+    phase_require(status == STATUS_SUCCESS, "sync_reopen", status,
+                  "phase B opens a synchronous direct reader");
+    status = NtQueryInformationFile(reader, &iosb, &information,
+        sizeof(information), FileNetworkOpenInformation);
+    phase_require(status == STATUS_SUCCESS &&
+                  information.EndOfFile.QuadPart == manifest.total_bytes,
+                  "payload_length", status,
+                  "phase B persisted payload length matches the manifest");
+    digest = COLD_FNV1A_OFFSET;
+    for (offset = 0, request = 0; offset < manifest.total_bytes; ++request) {
+        uint32_t length = cold_chunk_length(request,
+                                             manifest.total_bytes - offset);
+        LARGE_INTEGER read_offset = { .QuadPart = offset };
+        memset(io_buffer, 0xcc, length);
+        status = NtReadFile(reader, NULL, NULL, NULL, &iosb, io_buffer,
+                            length, &read_offset);
+        phase_require(status == STATUS_SUCCESS && iosb.Status == STATUS_SUCCESS &&
+                      iosb.Information == length,
+                      "sync_read", status,
+                      "synchronous direct read completes immediately and exactly");
+        verify_buffer(offset, length, &digest, "sync_content");
+        offset += length;
+        ++synchronous_reads;
+    }
+    phase_require(digest == manifest.content_digest &&
+                  synchronous_reads == manifest.write_requests,
+                  "sync_digest", STATUS_DATA_ERROR,
+                  "synchronous reads reproduce the committed digest");
+    status = NtClose(reader);
+    phase_require(status == STATUS_SUCCESS, "sync_close", status,
+                  "synchronous reader closes before asynchronous reopen");
+
+    status = NtCreateEvent(&event, NULL, NotificationEvent, FALSE);
+    phase_require(status == STATUS_SUCCESS, "event_create", status,
+                  "phase B creates a public completion event");
+    status = open_file(PAYLOAD_PATH, GENERIC_READ, FILE_OPEN,
+        FILE_NON_DIRECTORY_FILE | FILE_NO_INTERMEDIATE_BUFFERING, 0, &reader);
+    phase_require(status == STATUS_SUCCESS, "async_reopen", status,
+                  "phase B opens an asynchronous direct reader");
+    digest = COLD_FNV1A_OFFSET;
+    for (offset = 0, request = 0; offset < manifest.total_bytes; ++request) {
+        uint32_t length = cold_chunk_length(request,
+                                             manifest.total_bytes - offset);
+        LARGE_INTEGER read_offset = { .QuadPart = offset };
+        LARGE_INTEGER timeout = { .QuadPart = -50000000 };
+        memset(io_buffer, 0xcc, length);
+        NtClearEvent(event);
+        iosb.Status = STATUS_PENDING;
+        iosb.Information = 0;
+        status = NtReadFile(reader, event, NULL, NULL, &iosb, io_buffer,
+                            length, &read_offset);
+        phase_require(status == STATUS_SUCCESS || status == STATUS_PENDING,
+                      "async_submit", status,
+                      "asynchronous direct read is accepted");
+        if (status == STATUS_PENDING) {
+            ++pending_reads;
+            status = NtWaitForSingleObject(event, FALSE, &timeout);
+            phase_require(status == STATUS_SUCCESS, "async_wait", status,
+                          "pending read signals before its buffer is reused");
+        }
+        phase_require(iosb.Status == STATUS_SUCCESS &&
+                      iosb.Information == length,
+                      "async_complete", iosb.Status,
+                      "asynchronous IOSB publishes exact completion");
+        verify_buffer(offset, length, &digest, "async_content");
+        offset += length;
+        ++asynchronous_reads;
+    }
+    phase_require(digest == manifest.content_digest &&
+                  asynchronous_reads == manifest.write_requests,
+                  "async_digest", STATUS_DATA_ERROR,
+                  "asynchronous reads reproduce the committed digest");
+    phase_require(pending_reads != 0, "pending_unobserved", STATUS_UNSUCCESSFUL,
+                  "at least one public request exercises pending completion");
+    status = NtClose(reader);
+    phase_require(status == STATUS_SUCCESS, "async_close", status,
+                  "asynchronous reader closes after all completions");
+    status = NtClose(event);
+    phase_require(status == STATUS_SUCCESS, "event_close", status,
+                  "completion event closes after all requests");
+
+    regression_check(1, "phase B cold-reopened bytes pass both I/O paths");
+    {
+        char result[256];
+        snprintf(result, sizeof(result),
+            "COLD_STORAGE_RESULT phase=B status=PASS bytes=%lu "
+            "digest=%08lx sync_reads=%lu async_reads=%lu pending_reads=%lu\n",
+            (unsigned long)manifest.total_bytes,
+            (unsigned long)digest, (unsigned long)synchronous_reads,
+            (unsigned long)asynchronous_reads, (unsigned long)pending_reads);
+        tap_puts(result);
+    }
+    regression_finish();
+}
+
+int main(void)
+{
+    NTSTATUS status;
+    regression_begin();
+    if (manifest_exists(&status))
+        verify_phase();
+    author_phase();
+}
-- 
