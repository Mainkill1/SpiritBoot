+    ++DriverCalls;
+    DriverUserBuffer=Irp->UserBuffer;
+    DriverSystemBuffer=Private->AssociatedIrp.SystemBuffer;
+    DriverLockedBufferLength=Irp->LockedBufferLength;
+    DriverPublicFlags=Irp->Flags;
+    if (DriverSystemBuffer && DriverReplacementByte)
+        ((unsigned char *)DriverSystemBuffer)[0]=DriverReplacementByte;
+    Irp->IoStatus.Status=CompletionStatus;
+    Irp->IoStatus.Information=1;
+    if (Irp->UserIosb) *Irp->UserIosb=Irp->IoStatus;
+    complete_and_release(Irp);
