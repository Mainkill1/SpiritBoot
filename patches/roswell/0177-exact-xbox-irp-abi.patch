+#define NXP_BUCKET_LISTS (2 * NXP_CLASSES)
+#define NXP_SIZE_CLASS(Index) ((Index) % NXP_CLASSES)
+#else
+#define NXP_BUCKET_LISTS NXP_CLASSES
+#define NXP_SIZE_CLASS(Index) (Index)
+#endif
