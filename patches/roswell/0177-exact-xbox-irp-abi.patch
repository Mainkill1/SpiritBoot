+
+typedef struct _ALLOCATION_RECORD {
+    unsigned char *Base;
+    SIZE_T Bytes;
+    ULONG Tag;
+    BOOLEAN Active;
+    BOOLEAN Quota;
+} ALLOCATION_RECORD;
+
+static ALLOCATION_RECORD Allocations[256];
+static unsigned PoolAllocations,QuotaAllocations,PoolFrees,QuotaReturns;
+static unsigned PoolFailureBudget;
+static unsigned Unlocks;
+static PVOID UnlockedBase;
+static SIZE_T UnlockedBytes;
+
+static ALLOCATION_RECORD *record_for_base(PVOID base)
+{
+    for(unsigned i=0;i<256;i++)
+        if(Allocations[i].Active && Allocations[i].Base==base)return &Allocations[i];
+    return NULL;
+}
+
+static ALLOCATION_RECORD *record_for_irp(PIRP irp)
+{
+    for(unsigned i=0;i<256;i++)
+        if(Allocations[i].Active &&
+           (PVOID)(Allocations[i].Base+IOP_XBOX_IRP_PRIVATE_SIZE)==(PVOID)irp)
+            return &Allocations[i];
