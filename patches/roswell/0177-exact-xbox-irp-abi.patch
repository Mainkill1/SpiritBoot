@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Execute the exact special-terminal block from production IofCompleteRequest."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(sys.argv[2]).resolve() if len(sys.argv) > 2 else Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+
+
+def balanced_if_after(source: str, anchor: str) -> str:
+    anchor_pos = source.index(anchor)
+    start = source.index("if ((", anchor_pos)
+    brace = source.index("{", start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end] + "\n"
+
+
+irp_source = (root / "ntoskrnl/io/iomgr/irp.c").read_text()
+body = balanced_if_after(
+    irp_source,
+    "Mount completion intentionally shares the Xbox public 0x2 flag",
+)
+fixture = Path(__file__).with_name("fixture.c").read_text()
+mutant_body = body.replace(
+    "(IRP_MOUNT_COMPLETION | IRP_CLOSE_OPERATION)",
+    "(IRP_CLOSE_OPERATION)",
+)
+if mutant_body == body:
+    raise AssertionError("mount classification expression was not found")
+
+
+def build(name: str, selected_body: str, sanitizers: bool) -> Path:
+    source_path = out / f"{name}.c"
+    binary_path = out / name
+    source_path.write_text(
+        fixture.replace("/* PRODUCTION_SPECIAL_COMPLETION_BODY */", selected_body)
+    )
+    command = [
+        "cc", "-std=c11", "-O2", "-g", "-DSARCH_XBOX",
+        "-Wall", "-Wextra", "-Werror",
+    ]
+    if sanitizers:
+        command += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
+    command += [str(source_path), "-o", str(binary_path)]
+    subprocess.run(command, check=True)
+    return binary_path
+
+
+# Mutation proof: the fixture must fail if public mount completion is omitted.
+mutant = build("io-special-completion-mutant", mutant_body, False)
+mutant_result = subprocess.run(
+    [str(mutant)], stdout=subprocess.PIPE, stderr=subprocess.PIPE
+)
+if mutant_result.returncode == 0:
+    raise AssertionError("fixture did not reject the pre-fix mount classifier")
+
+plain = build("io-special-completion-plain", body, False)
+subprocess.run([str(plain)], check=True)
+
+sanitized = build("io-special-completion-sanitized", body, True)
+environment = dict(os.environ)
+environment["ASAN_OPTIONS"] = "detect_leaks=1:halt_on_error=1"
+environment["UBSAN_OPTIONS"] = "halt_on_error=1:print_stacktrace=1"
+subprocess.run([str(sanitized)], check=True, env=environment)
