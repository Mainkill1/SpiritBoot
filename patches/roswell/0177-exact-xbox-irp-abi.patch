index 00000000..7dc48274
--- /dev/null
+++ b/tests/host/pool-tagged-interior/check.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile and exercise the exact Xbox pool tagged-interior helper."""
+
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+POOL = ROOT / "ntoskrnl/xb/mm/pool.c"
+HEADER = ROOT / "ntoskrnl/include/internal/mm.h"
+NAME = "NxpPoolTryResolveTaggedInteriorBlock"
+
+
+def function(source: str, name: str) -> str:
+    marker = re.search(rf"\n{name}\s*\([^;]*?\)\s*\{{", source, re.S)
+    if not marker:
+        raise AssertionError(f"missing function {name}")
+    begin = marker.start() + 1
+    brace = source.find("{", marker.start())
+    depth = 0
+    for pos in range(brace, len(source)):
+        if source[pos] == "{":
+            depth += 1
+        elif source[pos] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[begin:pos + 1]
+    raise AssertionError(f"unterminated function {name}")
+
+
+def validate_source(source: str, header: str) -> str:
+    body = function(source, NAME)
+    required = (
+        "NXK_POOL_WINDOW_BASE",
+        "NxpPageState[PageIndex]",
+        "NXP_NOT_BUCKET",
+        "NXP_POOL_CENSUS_GET_CLASS",
+        "NxpClassSize[NXP_SIZE_CLASS(ClassIndex)]",
+        "NXP_MAGIC_ALLOC",
+        "Header->Tag != ExpectedTag",
+    )
+    for token in required:
+        if token not in body:
+            raise AssertionError(f"helper lost required check: {token}")
+    forbidden = ("KeAcquireSpinLock", "for (", "while (")
+    for token in forbidden:
+        if token in body:
+            raise AssertionError(f"hot helper gained forbidden operation: {token}")
+
+    range_check = body.index("NXK_POOL_WINDOW_BASE")
+    page_state = body.index("NxpPageState[PageIndex]")
+    page_header = body.index("PageHeader =")
+    geometry = body.index("InteriorRemainder !=")
+    candidate_header = body.index("\n    Header =")
+    if not range_check < page_state < page_header < geometry < candidate_header:
+        raise AssertionError("ownership checks are not ordered before candidate-header access")
+    if NAME not in header:
+        raise AssertionError("internal declaration is missing")
+    return body
+
+
+class SourceContract(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.source = POOL.read_text()
+        cls.header = HEADER.read_text()
+
+    def test_static_contract(self):
+        validate_source(self.source, self.header)
+
+    def test_production_large_tags_have_one_slot_per_pool_page(self):
+        self.assertIn("NxpLargeTag[NXK_POOL_WINDOW_PAGES]", self.source)
+        allocation = function(self.source, "NxpAllocatePoolWithTag")
+        self.assertIn("NxpLargeTag[NXP_PAGE_INDEX(Va)] = Tag", allocation)
+        self.assertIn("if (!Recorded)", allocation)
+        query = function(self.source, "NxpTryQueryTaggedBigBlock")
+        self.assertIn("NxPoolPagesQueryRunBytes(Base)", query)
+        self.assertIn("NxpLargeTag[PageIndex] == Tag", query)
+
+
+class CompiledContract(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        source = POOL.read_text()
+        cls.body = validate_source(source, HEADER.read_text())
+        cls.template = Path(__file__).with_name("fixture.c").read_text()
+        cls.temporary = tempfile.TemporaryDirectory(prefix="pool-tagged-interior-")
+        cls.directory = Path(cls.temporary.name)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.temporary.cleanup()
+
+    def build_and_run(self, name: str, defines: tuple[str, ...]):
+        source = self.template.replace("@@PRODUCTION_FUNCTION@@",
+                                       "BOOLEAN\n" + self.body)
+        c_path = self.directory / f"{name}.c"
+        exe = self.directory / name
+        c_path.write_text(source)
+        subprocess.run([
+            "cc", "-std=c11", "-O2", "-Wall", "-Wextra", "-Werror",
+            "-fsanitize=address,undefined", "-fno-omit-frame-pointer",
+            *defines, str(c_path), "-o", str(exe),
+        ], check=True)
+        subprocess.run([str(exe)], check=True)
+
+    def test_plain_classes(self):
+        self.build_and_run("plain", ())
+
+    def test_non_poolpages_config_rejects(self):
+        self.build_and_run("no-poolpages", ("-DTEST_NO_POOLPAGES",))
+
+    def test_census_packed_classes(self):
+        self.build_and_run("census", ("-DNXK_POOL_CENSUS",))
+
+    def test_census_packed_title_domain_classes(self):
+        self.build_and_run("census-title", (
+            "-DNXK_POOL_CENSUS", "-DXBOX_RESERVE_UPPER_RAM",
+        ))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
