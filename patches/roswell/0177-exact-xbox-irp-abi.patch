+
+static void test_public_pin_cleanup_ignores_mutated_public_fields(void)
+{
+    reset_counters();
+    DEVICE_OBJECT Device={DO_BUFFERED_IO,1};
+    unsigned char Buffer[97];
+    unsigned char Replacement[8];
+    LARGE_INTEGER Offset={37};
+    IO_STATUS_BLOCK Iosb={0};
+
+    PIRP Irp=IopBuildXboxPublicFsdRequest(IRP_MJ_READ,&Device,Buffer+1,96,
+                                          &Offset,NULL,&Iosb);
+    assert(Irp);
+    assert(LegacyLocks==1);
+
+    /* Public ABI fields are title writable. Terminal cleanup must use the
+     * private original pin and must consume it once even after mutation. */
+    Irp->UserBuffer=Replacement;
+    Irp->LockedBufferLength=7;
+    Irp->Flags=IRP_UNLOCK_USER_BUFFER | 0x8000u;
+    run_production_completion_unlock(Irp);
+    run_production_completion_free(Irp);
+    assert(LegacyUnlocks==1);
+    assert(LastLegacyUnlockBuffer==Buffer+1);
+    assert(LastLegacyUnlockLength==96);
+    assert(Irp->LockedBufferLength==0);
+    assert(Irp->Flags==0x8000u);
+    IoFreeIrp(Irp);
+    assert(LegacyUnlocks==1 && IrpFrees==1);
+    assert(CopyCalls==0 && PoolFrees==0);
+}
+
+static void test_ordinal85_public_buffered_round_trip(void)
+{
+    const NTSTATUS Completed=(NTSTATUS)0x40000042;
+    reset_counters();
+    DEVICE_OBJECT Device={DO_BUFFERED_IO,1};
+    unsigned char Buffer[65];
+    LARGE_INTEGER Offset={41};
+    memset(Buffer,0x22,sizeof(Buffer));
+    DispatchStatus=STATUS_PENDING;
+    CompletionStatus=Completed;
+    DriverReplacementByte=0xE5;
+
+    NTSTATUS Status=XeIoSynchronousFsdRequest(IRP_MJ_READ,&Device,Buffer+1,
+                                               64,&Offset);
+    assert(Status==Completed);
+    assert(DriverCalls==1 && WaitCalls==1);
+    assert(EventInitializations==1 && QueueCalls==1 && PublishCalls==0);
+    assert(DriverUserBuffer==Buffer+1);
+    assert(DriverSystemBuffer==Buffer+1);
+    assert(DriverLockedBufferLength==64);
+    assert(DriverPublicFlags==IRP_UNLOCK_USER_BUFFER);
+    assert(Buffer[1]==0xE5);
+    assert(PoolAllocations==0 && PoolFrees==0 && CopyCalls==0);
+    assert(LegacyLocks==1 && LegacyUnlocks==1);
+    assert(LastLegacyUnlockBuffer==Buffer+1);
+    assert(LastLegacyUnlockLength==64);
+    assert(IrpFrees==1);
+}
+
+int main(void)
+{
+    test_direct_read_uses_private_locked_mdl();
+    test_direct_mdl_allocation_failure_releases_irp();
+    test_direct_probe_failure_releases_mdl_and_irp();
+    test_zero_length_direct_requests_do_not_build_mdls();
+    test_neither_read_exposes_only_user_buffer();
+    test_internal_buffered_profile_round_trip();
+    test_public_buffered_aliases_and_pins_without_copy();
+    test_public_direct_keeps_hidden_mdl_and_public_buffer();
+    test_async_public_buffered_read_preserves_forwarded_changes();
+    test_synchronous_builder_public_buffered_write_preserves_changes();
+    test_synchronous_builder_public_direct_forwards_private_mdl();
+    test_public_pin_cleanup_ignores_mutated_public_fields();
+    test_ordinal85_public_buffered_round_trip();
+    for (unsigned Index=0; Index<16; ++Index) assert(!Packets[Index].Active);
+    puts("Xbox FSD production builder: 13 cases PASS");
+    return 0;
+}
