+#ifdef SARCH_XBOX
+static PIRP
+IopBuildXboxFsdRequestCommon(IN ULONG MajorFunction,
+                             IN PDEVICE_OBJECT DeviceObject,
+                             IN PVOID Buffer,
+                             IN ULONG Length,
+                             IN PLARGE_INTEGER StartingOffset,
+                             IN PIO_STATUS_BLOCK IoStatusBlock,
+                             IN BOOLEAN PublicRequest)
+{
+    PIRP Irp;
+    PIO_STACK_LOCATION StackPtr;
+    PIOP_XBOX_IRP_STATE State;
+    PMDL Mdl;
+    PVOID SystemBuffer;
+
+    Irp = IoAllocateIrp(DeviceObject->StackSize, FALSE);
+    if (!Irp) return NULL;
+
+    StackPtr = IoGetNextIrpStackLocation(Irp);
+    StackPtr->MajorFunction = (UCHAR)MajorFunction;
+
+    if ((MajorFunction != IRP_MJ_FLUSH_BUFFERS) &&
+        (MajorFunction != IRP_MJ_SHUTDOWN) &&
+        (MajorFunction != IRP_MJ_PNP) &&
+        (MajorFunction != IRP_MJ_POWER))
+    {
+        if (DeviceObject->Flags & DO_BUFFERED_IO)
+        {
+            if (PublicRequest)
+            {
+                /* Native title requests publish one pinned caller buffer.
+                 * Kernel drivers use the private accessor to reach the same
+                 * storage, so no bounce allocation or completion copy exists. */
+                Irp->UserBuffer = Buffer;
+                IopSetIrpSystemBuffer(Irp, Buffer);
+                if (Length != 0)
+                {
+                    State = IopLookupIrpState(Irp);
+                    ASSERT(State != NULL);
+                    MmLockUnlockBufferPages(Buffer, Length, FALSE);
+                    State->LockedBufferBase = Buffer;
+                    State->LockedBufferBytes = Length;
+                    Irp->LockedBufferLength = Length;
+                    Irp->Flags |= IRP_UNLOCK_USER_BUFFER;
+                }
+            }
+            else
+            {
+                SystemBuffer = ExAllocatePoolWithTag(NonPagedPool, Length,
+                                                     TAG_IOBUF);
+                if (!SystemBuffer)
+                {
+                    IoFreeIrp(Irp);
+                    return NULL;
+                }
+                IopSetIrpSystemBuffer(Irp, SystemBuffer);
+                IopSetIrpInternalFlags(Irp,
+                                       IOP_IRP_BUFFERED_IO |
+                                       IOP_IRP_DEALLOCATE_BUFFER);
+                if (MajorFunction == IRP_MJ_WRITE)
+                {
+                    RtlCopyMemory(SystemBuffer, Buffer, Length);
+                }
+                else
+                {
+                    IopOrIrpInternalFlags(Irp, IOP_IRP_INPUT_OPERATION);
+                    Irp->UserBuffer = Buffer;
+                }
+            }
+        }
+        else if (DeviceObject->Flags & DO_DIRECT_IO)
+        {
+            Mdl = NULL;
+            if (Length != 0)
+            {
+                Mdl = IoAllocateMdl(Buffer, Length, FALSE, FALSE, NULL);
+                if (!Mdl)
+                {
+                    IoFreeIrp(Irp);
+                    return NULL;
+                }
+                IopSetIrpMdlAddress(Irp, Mdl);
+                _SEH2_TRY
+                {
+                    MmProbeAndLockPages(Mdl,
+                                        KernelMode,
+                                        MajorFunction == IRP_MJ_READ ?
+                                        IoWriteAccess : IoReadAccess);
+                }
+                _SEH2_EXCEPT(EXCEPTION_EXECUTE_HANDLER)
+                {
+                    IopSetIrpMdlAddress(Irp, NULL);
+                    IoFreeMdl(Mdl);
+                    IoFreeIrp(Irp);
+                    _SEH2_YIELD(return NULL);
+                }
+                _SEH2_END;
+            }
+            if (PublicRequest) Irp->UserBuffer = Buffer;
+        }
+        else
+        {
+            Irp->UserBuffer = Buffer;
+        }
+
+        if (MajorFunction == IRP_MJ_READ)
+        {
+            StackPtr->Parameters.Read.Length = Length;
+            if (StartingOffset)
+                StackPtr->Parameters.Read.ByteOffset = *StartingOffset;
+        }
+        else
+        {
+            StackPtr->Parameters.Write.Length = Length;
+            if (StartingOffset)
+                StackPtr->Parameters.Write.ByteOffset = *StartingOffset;
+        }
+    }
+
+    Irp->UserIosb = IoStatusBlock;
+    Irp->Tail.Overlay.Thread = PsGetCurrentThread();
+    return Irp;
+}
+
+PIRP
+NTAPI
+IopBuildXboxFsdRequest(IN ULONG MajorFunction,
+                       IN PDEVICE_OBJECT DeviceObject,
+                       IN PVOID Buffer,
+                       IN ULONG Length,
+                       IN PLARGE_INTEGER StartingOffset,
+                       IN PIO_STATUS_BLOCK IoStatusBlock)
+{
+    return IopBuildXboxFsdRequestCommon(MajorFunction,
+                                        DeviceObject,
+                                        Buffer,
+                                        Length,
+                                        StartingOffset,
+                                        IoStatusBlock,
+                                        FALSE);
+}
+
+PIRP
