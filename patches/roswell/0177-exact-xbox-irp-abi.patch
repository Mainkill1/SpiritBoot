+++ b/tests/host/irp-caller-sidecar/fixture.c
@@ -0,0 +1,287 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SARCH_XBOX 1
+#define IN
+#define OUT
+#define OPTIONAL
+#define NTAPI
+#define VOID void
+#define TRUE 1
+#define FALSE 0
+#define ASSERT assert
+#define IOTRACE(...) ((void)0)
+#define IO_IRP_DEBUG 0
+#define FORCEINLINE static inline
+#define RtlZeroMemory(p,n) memset((p),0,(n))
+#define MEMORY_ALLOCATION_ALIGNMENT 16
+#define IOP_XBOX_IRP_PRIVATE_SIZE 112u
+#define IOP_IRP_SIDECAR_BUCKETS 16u
+#define IOP_IRP_ASSOCIATED_NONE 0
+#define IOP_IRP_ASSOCIATED_SYSTEM_BUFFER 1
+#define IOP_IRP_ASSOCIATED_MASTER_IRP 2
+#define IOP_IRP_ASSOCIATED_COUNT 3
+#define TAG_IRP_SIDECAR 0x73497249u
+#define TAG_IRP 0x20707249u
+#define KernelMode 0
+#define DISPATCH_LEVEL 2
+#define NonPagedPoolMustSucceed 2u
+#define IRP_UNLOCK_USER_BUFFER 0x200u
+#define IO_TYPE_IRP 6
+#define CONTAINING_RECORD(p,t,m) ((t *)((char *)(p)-offsetof(t,m)))
+
+typedef uint8_t UCHAR, *PUCHAR;
+typedef int8_t CCHAR;
+typedef uint16_t USHORT;
+typedef uint32_t ULONG, *PULONG;
+typedef int32_t LONG,NTSTATUS;
+typedef uintptr_t ULONG_PTR;
+typedef size_t SIZE_T, *PSIZE_T;
+typedef int BOOLEAN;
+typedef int KPROCESSOR_MODE;
+typedef UCHAR KIRQL;
+typedef void *PVOID;
+typedef void (*PDRIVER_CANCEL)(void);
+typedef struct _MDL { struct _MDL *Next; } MDL, *PMDL;
+typedef struct _LIST_ENTRY { struct _LIST_ENTRY *Flink, *Blink; } LIST_ENTRY, *PLIST_ENTRY;
+typedef pthread_mutex_t KSPIN_LOCK;
+typedef struct _THREAD { CCHAR ApcStateIndex; } THREAD, *PTHREAD;
+typedef struct _IO_STACK_LOCATION { unsigned char Bytes[36]; } IO_STACK_LOCATION, *PIO_STACK_LOCATION;
+typedef struct _IRP IRP, *PIRP;
+typedef struct _IOP_XBOX_IRP_PRIVATE IOP_XBOX_IRP_PRIVATE, *PIOP_XBOX_IRP_PRIVATE;
+
+/* PRODUCTION_STATE */
+
+typedef struct _NPAGED_LOOKASIDE_LIST {
+    ULONG Type;
+    SIZE_T Size;
+    _Atomic unsigned Allocates;
+    _Atomic unsigned Frees;
+} NPAGED_LOOKASIDE_LIST, *PNPAGED_LOOKASIDE_LIST;
+
+/* PRODUCTION_SIDECAR */
+
+struct _IOP_XBOX_IRP_PRIVATE {
+    ULONG Signature;
+    PMDL MdlAddress;
+    IOP_IRP_ASSOCIATED_STATE AssociatedIrp;
+    volatile PDRIVER_CANCEL CancelRoutine;
+    ULONG InternalFlags;
+    KPROCESSOR_MODE RequestorMode;
+    KIRQL CancelIrql;
+    CCHAR ApcEnvironment;
+    UCHAR AllocationFlags;
+    PVOID LockedBufferBase;
+    ULONG LockedBufferBytes;
+    unsigned char CompletionApc[48];
+};
+
+struct _IRP {
+    int16_t Type;
+    USHORT Size;
+    ULONG Flags;
+    LIST_ENTRY ThreadListEntry;
+    struct { int32_t Status; ULONG_PTR Information; } IoStatus;
+    CCHAR StackCount;
+    CCHAR CurrentLocation;
+    UCHAR PendingReturned;
+    UCHAR Cancel;
+    PVOID UserIosb;
+    PVOID UserEvent;
+    union { struct { ULONG_PTR LowPart; } AllocationSize; } Overlay;
+    PVOID UserBuffer;
+    PVOID SegmentArray;
+    ULONG LockedBufferLength;
+    struct {
+        struct {
+            PVOID DriverContext[5];
+            PVOID Thread;
+            LIST_ENTRY ListEntry;
+            PIO_STACK_LOCATION CurrentStackLocation;
+            PVOID OriginalFileObject;
+        } Overlay;
+    } Tail;
+};
+
+#define IoSizeOfIrp(stacks) ((USHORT)(sizeof(IRP)+(stacks)*sizeof(IO_STACK_LOCATION)))
+
+static LIST_ENTRY IopCallerIrpBuckets[IOP_IRP_SIDECAR_BUCKETS];
+static KSPIN_LOCK IopCallerIrpLock;
+static NPAGED_LOOKASIDE_LIST IopCallerIrpLookaside;
+static BOOLEAN IopCallerIrpRegistryInitialized;
+static THREAD TestThread = { 1 };
+static PIRP OwnedIrp;
+static PIOP_XBOX_IRP_PRIVATE OwnedPrivate;
+static _Atomic unsigned LiveSidecars;
+static unsigned Unlocks;
+
+static PTHREAD KeGetCurrentThread(void) { return &TestThread; }
+static void InitializeListHead(PLIST_ENTRY h) { h->Flink=h->Blink=h; }
+static int IsListEmpty(PLIST_ENTRY h) { return h->Flink==h; }
+static void InsertHeadList(PLIST_ENTRY h,PLIST_ENTRY e) {
+    e->Flink=h->Flink;e->Blink=h;h->Flink->Blink=e;h->Flink=e;
+}
+static void RemoveEntryList(PLIST_ENTRY e) {
+    e->Blink->Flink=e->Flink;e->Flink->Blink=e->Blink;
+}
+static void KeInitializeSpinLock(KSPIN_LOCK *l) { assert(!pthread_mutex_init(l,NULL)); }
+static void KeAcquireSpinLock(KSPIN_LOCK *l,KIRQL *old) { *old=0;assert(!pthread_mutex_lock(l)); }
+static void KeReleaseSpinLock(KSPIN_LOCK *l,KIRQL old) { (void)old;assert(!pthread_mutex_unlock(l)); }
+static void ExInitializeNPagedLookasideList(PNPAGED_LOOKASIDE_LIST l,PVOID a,PVOID f,
+                                             ULONG flags,SIZE_T size,ULONG tag,USHORT depth) {
+    (void)a;(void)f;(void)tag;(void)depth;l->Type=flags;l->Size=size;
+}
+static PVOID ExAllocateFromNPagedLookasideList(PNPAGED_LOOKASIDE_LIST l) {
+    assert(l->Type==NonPagedPoolMustSucceed);
+    PVOID p=calloc(1,l->Size);assert(p);l->Allocates++;LiveSidecars++;return p;
+}
+static void ExFreeToNPagedLookasideList(PNPAGED_LOOKASIDE_LIST l,PVOID p) {
+    assert(p);l->Frees++;assert(LiveSidecars);LiveSidecars--;free(p);
+}
+static PVOID InterlockedExchangePointer(PVOID volatile *p,PVOID x) {
+    return __atomic_exchange_n(p,x,__ATOMIC_SEQ_CST);
+}
+static PVOID InterlockedCompareExchangePointer(PVOID volatile *p,PVOID x,PVOID c) {
+    __atomic_compare_exchange_n(p,&c,x,0,__ATOMIC_SEQ_CST,__ATOMIC_SEQ_CST);return c;
+}
+static PIOP_XBOX_IRP_PRIVATE IopLookupIrpPrivateAllocation(PIRP Irp,PSIZE_T bytes) {
+    if(Irp!=OwnedIrp)return NULL;
+    if(bytes)*bytes=IOP_XBOX_IRP_PRIVATE_SIZE+Irp->Size;
+    return OwnedPrivate;
+}
+static void IopResetIrpPrivateState(PIOP_XBOX_IRP_PRIVATE p) {
+    UCHAR flags=p->AllocationFlags;memset(p,0,sizeof(*p));
+    p->AllocationFlags=flags;p->RequestorMode=KernelMode;
+    p->ApcEnvironment=TestThread.ApcStateIndex;
+}
+static void MmLockUnlockBufferPages(PVOID base,SIZE_T bytes,BOOLEAN unlock) {
+    assert(base&&bytes&&unlock);Unlocks++;
+}
+
+static PIOP_XBOX_IRP_STATE IopLookupIrpState(PIRP Irp);
+static PIOP_CALLER_IRP_SIDECAR IopFindCallerIrpSidecarLocked(PIRP Irp);
+static PIOP_CALLER_IRP_SIDECAR IopEnsureCallerIrpSidecar(PIRP Irp);
+static PIOP_CALLER_IRP_SIDECAR IopReferenceCallerIrpSidecar(PIRP Irp,BOOLEAN Ensure);
+static void IopDereferenceCallerIrpSidecar(PIOP_CALLER_IRP_SIDECAR Sidecar);
+static void IopDetachCallerIrpSidecar(PIOP_CALLER_IRP_SIDECAR Sidecar);
+static void IopInitializeIrpState(PIOP_XBOX_IRP_STATE State,UCHAR Flags);
+
+/* PRODUCTION_BODIES */
+
+static unsigned registry_entries(void) {
+    unsigned count=0;
+    for(unsigned i=0;i<IOP_IRP_SIDECAR_BUCKETS;i++)
+        for(PLIST_ENTRY e=IopCallerIrpBuckets[i].Flink;e!=&IopCallerIrpBuckets[i];e=e->Flink)count++;
+    return count;
+}
+
+typedef struct {
+    unsigned char Before[64];
+    unsigned char Packet[1024];
+    unsigned char After[64];
+} GUARDED_IRP;
+
+static PIRP initialize_raw(GUARDED_IRP *g,CCHAR stacks) {
+    memset(g->Before,0xa7,sizeof(g->Before));memset(g->Packet,0xcc,sizeof(g->Packet));
+    memset(g->After,0x5d,sizeof(g->After));
+    PIRP irp=(PIRP)g->Packet;IoInitializeIrp(irp,IoSizeOfIrp(stacks),stacks);return irp;
+}
+static void assert_canaries(const GUARDED_IRP *g) {
+    for(unsigned i=0;i<sizeof(g->Before);i++)assert(g->Before[i]==0xa7);
+    for(unsigned i=0;i<sizeof(g->After);i++)assert(g->After[i]==0x5d);
+}
+
+static void *ensure_worker(void *context) {
+    PIRP irp=context;assert(IopGetIrpSystemBufferPointer(irp)!=NULL);return NULL;
+}
+
+static void cancel_a(void) {}
+static void cancel_b(void) {}
+
+int main(void) {
+    GUARDED_IRP guarded;
+    PIRP raw;
+    PIOP_CALLER_IRP_SIDECAR hold;
+    pthread_t threads[8];
+
+    IopInitializeCallerIrpRegistry();
+    assert(IopCallerIrpLookaside.Type==NonPagedPoolMustSucceed);
+    raw=initialize_raw(&guarded,2);
+    assert(IopLookupIrpState(raw)==NULL&&registry_entries()==0&&LiveSidecars==0);
+
+    /* IofCompleteRequest's pre-callback reference uses this non-ensuring
+     * lookup.  A MORE_PROCESSING_REQUIRED callback can then release a raw
+     * packet which never needed hidden state without leaving a registry row. */
+    hold=IopReferenceCallerIrpSidecar(raw,FALSE);
+    assert(hold==NULL&&registry_entries()==0&&LiveSidecars==0);
+
+    /* Creating hidden cancel state must not reinterpret or snapshot the
+     * caller-visible UserBuffer through the private associated-state union. */
+    raw->UserBuffer=(PVOID)(uintptr_t)0x11111111u;
+    assert(IopSetIrpCancelRoutine(raw,cancel_a)==NULL);
+    raw->UserBuffer=(PVOID)(uintptr_t)0x22222222u;
+    assert(IopGetIrpSystemBuffer(raw)==raw->UserBuffer);
+    assert(IopGetIrpMasterIrp(raw)==NULL);
+    assert(IopGetIrpCancelIrql(raw)==DISPATCH_LEVEL);
+    assert(*IopGetIrpCountPointer(raw)==0);
+    IopSetIrpCancelRoutine(raw,NULL);
+    IoReuseIrp(raw,0);
+    assert(registry_entries()==0&&LiveSidecars==0);
+
+    for(unsigned i=0;i<8;i++)assert(!pthread_create(&threads[i],NULL,ensure_worker,raw));
+    for(unsigned i=0;i<8;i++)assert(!pthread_join(threads[i],NULL));
+    assert(registry_entries()==1&&LiveSidecars==1);
+    assert(IopGetIrpSystemBuffer(raw)==raw->UserBuffer);
+    IopSetIrpSystemBuffer(raw,(PVOID)(uintptr_t)0x12345678u);
+    assert(IopGetIrpSystemBuffer(raw)==(PVOID)(uintptr_t)0x12345678u);
+    assert(IopSetIrpCancelRoutine(raw,cancel_a)==NULL);
+    assert(IopCompareExchangeIrpCancelRoutine(raw,cancel_b,cancel_a)==cancel_a);
+    assert(IopGetIrpCancelRoutine(raw)==cancel_b);
+
+    hold=IopReferenceCallerIrpSidecar(raw,FALSE);assert(hold);
+    /* STATUS_MORE_PROCESSING_REQUIRED transfers the packet to the completion
+     * routine. Dropping the transient completion reference must retain the
+     * registered state for a later resubmit, completion, or IoReuseIrp. */
+    IopDereferenceCallerIrpSidecar(hold);
+    assert(IopLookupIrpState(raw)!=NULL&&registry_entries()==1&&LiveSidecars==1);
+    hold=IopReferenceCallerIrpSidecar(raw,FALSE);assert(hold);
+    IopDetachCallerIrpSidecar(hold);
+    assert(registry_entries()==0&&LiveSidecars==1);
+    IopDereferenceCallerIrpSidecar(hold);
+    assert(LiveSidecars==0);
+
+    IopSetIrpInternalFlags(raw,0x55aa);
+    hold=IopReferenceCallerIrpSidecar(raw,FALSE);assert(hold);
+    hold->State.LockedBufferBase=guarded.Packet+400;
+    hold->State.LockedBufferBytes=32;
+    IopDereferenceCallerIrpSidecar(hold);
+    raw->Flags|=IRP_UNLOCK_USER_BUFFER;raw->LockedBufferLength=32;
+    IoReuseIrp(raw,(NTSTATUS)0x12345678);
+    assert(Unlocks==1&&registry_entries()==0&&LiveSidecars==0);
+    assert(raw->IoStatus.Status==(NTSTATUS)0x12345678);
+    assert(IopLookupIrpState(raw)==NULL);
+    assert_canaries(&guarded);
+
+    /* Owned packets resolve their prefix directly and never allocate a raw
+     * sidecar for pointer-returning accessors. */
+    unsigned char owned_storage[sizeof(IOP_XBOX_IRP_PRIVATE)+sizeof(IRP)+64];
+    OwnedPrivate=(PIOP_XBOX_IRP_PRIVATE)owned_storage;
+    OwnedIrp=(PIRP)(owned_storage+sizeof(IOP_XBOX_IRP_PRIVATE));
+    memset(OwnedPrivate,0,sizeof(*OwnedPrivate));
+    OwnedPrivate->RequestorMode=KernelMode;
+    OwnedPrivate->ApcEnvironment=TestThread.ApcStateIndex;
+    IoInitializeIrp(OwnedIrp,IoSizeOfIrp(1),1);
+    assert(IopGetIrpMdlAddressPointer(OwnedIrp)==&OwnedPrivate->MdlAddress);
+    assert(registry_entries()==0&&LiveSidecars==0);
+
+    assert_canaries(&guarded);
+    puts("caller IRP sidecar production bodies: PASS");
+    return 0;
+}
