+    expect_reject(public_pointer(header), PRIVATE_BYTES, TAG_IRP);
+    NxpPageState[0] = 0;
+    expect_reject(public_pointer(header), PRIVATE_BYTES, TAG_IRP);
+
+    header = prepare(2, 4);
+    ((NXP_HEADER *)pool_window)->ClassIndex = (USHORT)NXP_BUCKET_LISTS;
+    expect_reject(public_pointer(header), PRIVATE_BYTES, TAG_IRP);
+
+    header = prepare(2, 4);
+    expect_reject(public_pointer(header), PAGE_SIZE, TAG_IRP);
