@@ -0,0 +1,276 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef uint32_t ULONG;
+typedef int32_t NTSTATUS;
+typedef int8_t CCHAR;
+typedef int BOOLEAN;
+
+#define FALSE 0
+#define IRP_MOUNT_COMPLETION 0x00000002u
+#define IRP_CLOSE_OPERATION 0x00000040u
+#define IOP_IRP_PAGING_IO 0x00000002u
+#define IOP_IRP_SYNCHRONOUS_PAGING_IO 0x00000080u
+
+typedef struct _IO_STATUS_BLOCK {
+    NTSTATUS Status;
+    uintptr_t Information;
+} IO_STATUS_BLOCK;
+
+typedef struct _KEVENT {
+    unsigned signals;
+} KEVENT;
+
+typedef struct _IRP {
+    ULONG Flags;
+    unsigned PendingReturned;
+    IO_STATUS_BLOCK IoStatus;
+    IO_STATUS_BLOCK *UserIosb;
+    KEVENT *UserEvent;
+} IRP, *PIRP;
+
+typedef struct _IOP_XBOX_IRP_PRIVATE {
+    ULONG InternalFlags;
+} IOP_XBOX_IRP_PRIVATE, *PIOP_XBOX_IRP_PRIVATE;
+typedef IOP_XBOX_IRP_PRIVATE IOP_XBOX_IRP_STATE,*PIOP_XBOX_IRP_STATE;
+
+static unsigned ordinary_apcs;
+static unsigned pool_frees;
+static unsigned reserve_frees;
+static unsigned unsupported_calls;
+static unsigned raw_detaches;
+
+static struct {
+    PIRP ReserveIrp;
+} IopReserveIrpAllocator;
+
+static void
+KeSetEvent(KEVENT *Event, CCHAR PriorityBoost, BOOLEAN Wait)
+{
+    (void)PriorityBoost;
+    (void)Wait;
+    Event->signals++;
+}
+
+static void
+IoFreeIrp(PIRP Irp)
+{
+    (void)Irp;
+    pool_frees++;
+}
+
+static void
+IopFreeReserveIrp(CCHAR PriorityBoost)
+{
+    (void)PriorityBoost;
+    reserve_frees++;
+}
+
+static void __attribute__((unused))
+IopDetachCallerIrp(PIRP Irp) { (void)Irp; raw_detaches++; }
+
+#define UNIMPLEMENTED_DBGBREAK(...) (unsupported_calls++)
+
+static void
+CompleteTerminalRoute(PIRP Irp,
+                      PIOP_XBOX_IRP_PRIVATE Private,
+                      PIOP_XBOX_IRP_STATE SuppliedState,
+                      CCHAR PriorityBoost)
+{
+    ULONG Flags;
+    PIOP_XBOX_IRP_PRIVATE OwnedPrivate = Private;
+    PIOP_XBOX_IRP_STATE State = SuppliedState;
+
+    /* PRODUCTION_SPECIAL_COMPLETION_BODY */
+
+    /* The rest of IofCompleteRequest queues ordinary terminal completion. */
+    ordinary_apcs++;
+}
+
+static void
+reset_counters(void)
+{
+    ordinary_apcs = 0;
+    pool_frees = 0;
+    reserve_frees = 0;
+    unsupported_calls = 0;
+    raw_detaches = 0;
+    IopReserveIrpAllocator.ReserveIrp = NULL;
+}
+
+static void
+run_synchronous_case(ULONG public_flags,
+                     ULONG internal_flags,
+                     unsigned pending,
+                     int reserve,
+                     unsigned expected_pool_frees,
+                     unsigned expected_reserve_frees)
+{
+    IO_STATUS_BLOCK user_iosb = {0};
+    KEVENT event = {0};
+    IRP irp = {
+        .Flags = public_flags,
+        .PendingReturned = pending,
+        .IoStatus = { .Status = (NTSTATUS)0x12345678, .Information = 0x9876 },
+        .UserIosb = &user_iosb,
+        .UserEvent = &event,
+    };
+    IOP_XBOX_IRP_PRIVATE private_state = { .InternalFlags = internal_flags };
+
+    reset_counters();
+    if (reserve)
+        IopReserveIrpAllocator.ReserveIrp = &irp;
+
+    CompleteTerminalRoute(&irp, &private_state, &private_state, 3);
+
+    assert(user_iosb.Status == irp.IoStatus.Status);
+    assert(user_iosb.Information == irp.IoStatus.Information);
+    assert(event.signals == 1);
+    assert(pool_frees == expected_pool_frees);
+    assert(reserve_frees == expected_reserve_frees);
+    assert(ordinary_apcs == 0);
+    assert(unsupported_calls == 0);
+}
+
+static void
+test_caller_packet_retains_special_state(void)
+{
+    ULONG public_flags[] = {0, IRP_CLOSE_OPERATION};
+    ULONG internal_flags[] = {
+        IOP_IRP_PAGING_IO | IOP_IRP_SYNCHRONOUS_PAGING_IO,
+        0,
+    };
+
+    for (unsigned index = 0; index != 2; ++index)
+    {
+        IO_STATUS_BLOCK user_iosb = {0};
+        KEVENT event = {0};
+        IRP irp = {
+            .Flags = public_flags[index],
+            .IoStatus = { .Status = 7, .Information = 11 },
+            .UserIosb = &user_iosb,
+            .UserEvent = &event,
+        };
+        IOP_XBOX_IRP_STATE raw_state = {
+            .InternalFlags = internal_flags[index],
+        };
+
+        reset_counters();
+        CompleteTerminalRoute(&irp, NULL, &raw_state, 0);
+        assert(event.signals == 1);
+        assert(raw_detaches == 0);
+        assert(pool_frees == 0 && reserve_frees == 0);
+        assert(raw_state.InternalFlags == internal_flags[index]);
+    }
+}
+
+static void
+test_mount_and_verify_inline_and_pending(void)
+{
+    unsigned pending;
+
+    for (pending = 0; pending != 2; ++pending)
+    {
+        /* Mount and verify use the same public/private terminal contract. */
+        run_synchronous_case(IRP_MOUNT_COMPLETION,
+                             IOP_IRP_SYNCHRONOUS_PAGING_IO,
+                             pending,
+                             0,
+                             1,
+                             0);
+        run_synchronous_case(IRP_MOUNT_COMPLETION,
+                             IOP_IRP_SYNCHRONOUS_PAGING_IO,
+                             pending,
+                             0,
+                             1,
+                             0);
+    }
+}
+
+static void
+test_paging_and_close(void)
+{
+    run_synchronous_case(0,
+                         IOP_IRP_PAGING_IO |
+                             IOP_IRP_SYNCHRONOUS_PAGING_IO,
+                         0,
+                         0,
+                         1,
+                         0);
+    run_synchronous_case(0,
+                         IOP_IRP_PAGING_IO |
+                             IOP_IRP_SYNCHRONOUS_PAGING_IO,
+                         1,
+                         1,
+                         0,
+                         1);
+    run_synchronous_case(IRP_CLOSE_OPERATION,
+                         0,
+                         0,
+                         0,
+                         0,
+                         0);
+    run_synchronous_case(IRP_CLOSE_OPERATION,
+                         0,
+                         1,
+                         0,
+                         0,
+                         0);
+}
+
+static void
+test_ordinary_packet_queues_apc(void)
+{
+    IO_STATUS_BLOCK user_iosb = {0};
+    KEVENT event = {0};
+    IRP irp = {
+        .IoStatus = { .Status = 7, .Information = 11 },
+        .UserIosb = &user_iosb,
+        .UserEvent = &event,
+    };
+    IOP_XBOX_IRP_PRIVATE private_state = {0};
+
+    reset_counters();
+    CompleteTerminalRoute(&irp, &private_state, &private_state, 0);
+    assert(ordinary_apcs == 1);
+    assert(event.signals == 0);
+    assert(pool_frees == 0);
+    assert(reserve_frees == 0);
+    assert(unsupported_calls == 0);
+    assert(user_iosb.Status == 0);
+    assert(user_iosb.Information == 0);
+}
+
+static void
+test_async_paging_remains_unsupported(void)
+{
+    IO_STATUS_BLOCK user_iosb = {0};
+    KEVENT event = {0};
+    IRP irp = { .UserIosb = &user_iosb, .UserEvent = &event };
+    IOP_XBOX_IRP_PRIVATE private_state = {
+        .InternalFlags = IOP_IRP_PAGING_IO,
+    };
+
+    reset_counters();
+    CompleteTerminalRoute(&irp, &private_state, &private_state, 0);
+    assert(ordinary_apcs == 0);
+    assert(unsupported_calls == 1);
+    assert(event.signals == 0);
+    assert(pool_frees == 0);
+    assert(reserve_frees == 0);
+}
+
+int
+main(void)
+{
+    test_mount_and_verify_inline_and_pending();
+    test_paging_and_close();
+    test_caller_packet_retains_special_state();
+    test_ordinary_packet_queues_apc();
+    test_async_paging_remains_unsupported();
+    puts("Xbox special IRP completion routes: 12 cases PASS");
+    return 0;
+}
