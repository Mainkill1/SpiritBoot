+#ifdef SARCH_XBOX
+/*
+ * The Xbox title ABI ends at 0x68 and places its stack array immediately
+ * afterward.  Kernel-only compatibility state and the native completion APC
+ * live in the 80 bytes before IoAllocateIrp's public packet.  The pool owns
+ * that prefix, so title-created packets passed to IoInitializeIrp are never
+ * directly dereferenced outside their buffer.
+ */
+typedef union _IOP_IRP_ASSOCIATED_STATE
+{
+    PIRP MasterIrp;
+    volatile LONG IrpCount;
+    PVOID SystemBuffer;
+} IOP_IRP_ASSOCIATED_STATE, *PIOP_IRP_ASSOCIATED_STATE;
+
+typedef struct _IOP_XBOX_IRP_STATE
+{
+    ULONG Signature;
+    PMDL MdlAddress;
+    IOP_IRP_ASSOCIATED_STATE AssociatedIrp;
+    volatile PDRIVER_CANCEL CancelRoutine;
+    ULONG InternalFlags;
+    KPROCESSOR_MODE RequestorMode;
+    KIRQL CancelIrql;
+    CCHAR ApcEnvironment;
+    UCHAR AllocationFlags;
+    PVOID LockedBufferBase;
+    ULONG LockedBufferBytes;
+} IOP_XBOX_IRP_STATE, *PIOP_XBOX_IRP_STATE;
+
+typedef struct DECLSPEC_ALIGN(MEMORY_ALLOCATION_ALIGNMENT) _IOP_XBOX_IRP_PRIVATE
+{
+    ULONG Signature;
+    PMDL MdlAddress;
+    IOP_IRP_ASSOCIATED_STATE AssociatedIrp;
+    volatile PDRIVER_CANCEL CancelRoutine;
+    ULONG InternalFlags;
+    KPROCESSOR_MODE RequestorMode;
+    KIRQL CancelIrql;
+    CCHAR ApcEnvironment;
+    UCHAR AllocationFlags;
+    PVOID LockedBufferBase;
+    ULONG LockedBufferBytes;
+    KAPC CompletionApc;
+} IOP_XBOX_IRP_PRIVATE, *PIOP_XBOX_IRP_PRIVATE;
+
+C_ASSERT(sizeof(IOP_XBOX_IRP_STATE) == IOP_XBOX_IRP_STATE_SIZE);
+C_ASSERT(FIELD_OFFSET(IOP_XBOX_IRP_PRIVATE, CompletionApc) ==
+         sizeof(IOP_XBOX_IRP_STATE));
+C_ASSERT(FIELD_OFFSET(IOP_XBOX_IRP_PRIVATE, CompletionApc) ==
+         IOP_XBOX_IRP_STATE_SIZE);
+C_ASSERT(sizeof(IOP_XBOX_IRP_PRIVATE) == IOP_XBOX_IRP_PRIVATE_SIZE);
+
+#define IOP_XBOX_IRP_PRIVATE_SIGNATURE 0x49525058UL /* "XPRI" */
+#define IOP_IRP_LARGE_LOOKASIDE         0x80
+#define TAG_IRP_SIDECAR                 'sIrI'
+#define IOP_IRP_SIDECAR_BUCKETS         16
+#define IOP_IRP_ASSOCIATED_NONE          0
+#define IOP_IRP_ASSOCIATED_SYSTEM_BUFFER 1
+#define IOP_IRP_ASSOCIATED_MASTER_IRP    2
+#define IOP_IRP_ASSOCIATED_COUNT         3
+#define IopIrpPrivateSignature(Private) \
+    (IOP_XBOX_IRP_PRIVATE_SIGNATURE ^ PtrToUlong(Private))
+
+typedef struct _IOP_CALLER_IRP_SIDECAR
+{
+    LIST_ENTRY HashLink;
+    PIRP Irp;
+    LONG References;
+    UCHAR AssociatedKind;
