+#define NXP_POOL_CENSUS_CLASS_MASK 0x001Fu
+#define NXP_POOL_CENSUS_BIN_SHIFT 5u
+#define NXP_POOL_CENSUS_BIN_MASK 0x1FE0u
+#define NXP_POOL_CENSUS_DOMAIN_MASK 0x2000u
+#define NXP_POOL_CENSUS_SAMPLED_MASK 0x4000u
