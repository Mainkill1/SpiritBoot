+/* Keep timer work bounded and off the allocation/free hot path. A delayed
+ * callback rotates only once, so it cannot expire freshly observed demand.
+ * No live page moves. Detached pages leave the lists before backend release. */
+static VOID
+NTAPI
+NxpTrimIdleDpc(PKDPC Dpc, PVOID Context, PVOID Arg1, PVOID Arg2)
+{
+    ULONGLONG Now = KeQueryInterruptTime();
+    KIRQL OldIrql;
+    PVOID EmptyPage = NULL;
+
+    UNREFERENCED_PARAMETER(Dpc);
+    UNREFERENCED_PARAMETER(Context);
+    UNREFERENCED_PARAMETER(Arg1);
+    UNREFERENCED_PARAMETER(Arg2);
+    KeAcquireSpinLock(&NxpLock, &OldIrql);
+    if (Now - NxpDemandEpoch >= NXP_DEMAND_EPOCH)
+    {
+        for (ULONG Class = 0; Class < NXP_BUCKET_LISTS; Class++)
+        {
+            NxpPriorPeakPages[Class] = NxpPeakPages[Class];
+            NxpPeakPages[Class] = NxpBusyPages[Class];
+        }
+        NxpDemandEpoch = Now;
+    }
+    for (ULONG Scan = 0; Scan < NXP_TRIM_SCAN_PAGES; Scan++)
+    {
+        ULONG Idx = NxpTrimCursor++;
+        ULONG_PTR PageVa;
+        ULONG Class, Peak, Keep;
+
+        if (NxpTrimCursor == NXK_POOL_WINDOW_PAGES) NxpTrimCursor = 0;
+        if (NxpPageState[Idx] != 0) continue;
+        PageVa = NXK_POOL_WINDOW_BASE + ((ULONG_PTR)Idx << PAGE_SHIFT);
+        Class = ((NXP_HEADER *)PageVa)->ClassIndex;
+        Peak = max(NxpPeakPages[Class], NxpPriorPeakPages[Class]);
+        ASSERT(Peak >= NxpBusyPages[Class]);
+        Keep = max(1, Peak - NxpBusyPages[Class]);
+        if (NxpEmptyPages[Class] <= Keep) continue;
+        NxpDetachEmptyBucketPage(PageVa);
+        EmptyPage = (PVOID)PageVa;
+        break;
+    }
+    KeReleaseSpinLock(&NxpLock, OldIrql);
+    if (EmptyPage != NULL) NXP_PAGES_FREE(EmptyPage);
+}
