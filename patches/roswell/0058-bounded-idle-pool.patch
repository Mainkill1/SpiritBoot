diff --git a/tests/host/pool-idle/cases.c b/tests/host/pool-idle/cases.c
new file mode 100644
index 00000000..416c7ae4
--- /dev/null
+++ b/tests/host/pool-idle/cases.c
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+static void reset(void) {
+    assert(!pool_lock_held);
+    memset(used,0,sizeof(used));memset(runs,0,sizeof(runs));
+    memset(NxpFreeLists,0,sizeof(NxpFreeLists));committed=peak=allocations=releases=0;
+    allow_pages=1;page_limit=NXK_POOL_WINDOW_PAGES;InitializePool(NonPagedPool,0);
+}
+static void invariant(void) {
+    unsigned seen[NXK_POOL_WINDOW_PAGES]={0};
+#if HAS_EMPTY
+    unsigned empty[NXP_BUCKET_LISTS]={0};
+#endif
+    for(unsigned c=0;c<NXP_BUCKET_LISTS;c++) {
+        NXP_FREE *prev=NULL;
+        unsigned traversed=0;
+        for(NXP_FREE *f=NxpFreeLists[c];f;f=f->Next) {
+            assert(++traversed<=NXK_POOL_WINDOW_PAGES*128u);
+            unsigned page=NXP_PAGE_INDEX(f);
+            assert(page<NXK_POOL_WINDOW_PAGES&&used[page]);
+            NXP_HEADER *h=((NXP_HEADER*)f)-1;
+            assert(h->Magic==NXP_MAGIC_FREE&&h->ClassIndex==c);
+#if HAS_PREV
+            assert(f->Prev==prev);
+#endif
+            prev=f;seen[page]++;
+        }
+        (void)prev;
+    }
+    for(unsigned i=0;i<NXK_POOL_WINDOW_PAGES;i++) {
+        if(NxpPageState[i]==NXP_NOT_BUCKET)continue;
+        assert(used[i]);NXP_HEADER *h=(NXP_HEADER*)(arena+i*PAGE_SIZE);
+        unsigned total=PAGE_SIZE/NxpClassSize[NXP_SIZE_CLASS(h->ClassIndex)];
+        assert(seen[i]+NxpPageState[i]==total);
+#if HAS_EMPTY
+        if(NxpPageState[i]==0)empty[h->ClassIndex]++;
+#endif
+    }
+#if HAS_EMPTY
+    for(unsigned c=0;c<NXP_BUCKET_LISTS;c++)
+        assert(empty[c]==NxpEmptyPages[c]&&empty[c]<=1);
+#endif
+}
+static void wave(unsigned request, int title, unsigned seed) {
+    void *p[512];unsigned n;
+    void *one=title?NxTitleAllocatePoolWithTag(request,seed):ExAllocatePoolWithTag(NonPagedPool,request,seed);
+    assert(one);size_t capacity=ExQueryPoolBlockSize(one,NULL);
+    assert(capacity>=request);ExFreePoolWithTag(one,seed);
+    n=4*(PAGE_SIZE/(unsigned)(capacity+sizeof(NXP_HEADER)));assert(n<=512);
+    for(unsigned i=0;i<n;i++) {
+        p[i]=title?NxTitleAllocatePoolWithTag(request,seed+i):ExAllocatePoolWithTag(NonPagedPool,request,seed+i);
+        assert(p[i]);memset(p[i],(int)(i%251),request);
+    }
+    invariant();
+    /* Visit every block in a non-page order (n is a power of two). */
+    for(unsigned k=0;k<n;k++) {
+        unsigned i=(k*17+3)%n;
+        for(unsigned b=0;b<request;b++)assert(((unsigned char*)p[i])[b]==i%251);
+        ExFreePoolWithTag(p[i],seed+i);invariant();
+    }
+}
+int main(void) {
+    arena=aligned_alloc(PAGE_SIZE,NXK_POOL_WINDOW_PAGES*PAGE_SIZE);assert(arena);
+    static const unsigned sizes[]={1,32,64,128,256,512,1024,2040};
+    reset();
+    for(unsigned i=0;i<RTL_NUMBER_OF(sizes);i++)wave(sizes[i],0,1000+i*1000);
+    printf("idle after four-page waves: committed=%u peak=%u\n",committed,peak);
+    if(committed>NXP_CLASSES) {
+        fprintf(stderr,"FAIL: unbounded empty-page retention (%u > %lu)\n",committed,(unsigned long)NXP_CLASSES);
+        free(arena);
+        return 1;
+    }
+    assert(committed==NXP_CLASSES);
+    unsigned before=allocations;allow_pages=0;
+    for(unsigned i=0;i<RTL_NUMBER_OF(sizes);i++) {
+        void *p=ExAllocatePoolWithTag(NonPagedPool,sizes[i],42);assert(p);
+        ExFreePoolWithTag(p,42);
+    }
+    assert(allocations==before);invariant();
+    assert(NxpReclaimEmptyBucketPages()==NXP_CLASSES&&committed==0);invariant();
+    puts("PASS all classes: bounded backing, original data/tag/capacity, reserve reuse, pressure release");
+    reset();wave(64,0,1);
+#if XBOX_RESERVE_UPPER_RAM
+    wave(64,1,1001);assert(committed==2);
+    for(unsigned i=0;i<RTL_NUMBER_OF(sizes);i++)wave(sizes[i],1,2000+i*1000);
+    assert(committed==NXP_CLASSES+1);
+#else
+    wave(64,1,1001);assert(committed==1);
+#endif
+    invariant();NxpReclaimEmptyBucketPages();assert(committed==0);
+    reset();
+    void *live=ExAllocatePoolWithTag(NonPagedPool,64,50);assert(live);memset(live,77,64);
+    wave(64,0,1001);invariant();assert(committed<=2);
+    for(unsigned i=0;i<64;i++)assert(((unsigned char*)live)[i]==77);
+    ExFreePoolWithTag(live,50);invariant();assert(committed==1);
+    void *large=ExAllocatePoolWithTag(NonPagedPool,8192,7);assert(large);
+    assert(ExQueryPoolBlockSize(large,NULL)==8192);memset(large,88,8192);
+    assert(NxpReclaimEmptyBucketPages()==1&&committed==2);
+    for(unsigned i=0;i<8192;i++)assert(((unsigned char*)large)[i]==88);
+    ExFreePoolWithTag(large,7);assert(committed==0);
+    reset();wave(64,0,1001);page_limit=2;before=allocations;
+    large=ExAllocatePoolWithTag(NonPagedPool,8192,7);assert(large);
+    assert(allocations==before+2&&committed==2);
+    memset(large,91,8192);invariant();
+    for(unsigned i=0;i<8192;i++)assert(((unsigned char*)large)[i]==91);
+    ExFreePoolWithTag(large,7);assert(committed==0);invariant();
+    reset();wave(64,0,1001);allow_pages=0;
+    assert(ExAllocatePoolWithTag(NonPagedPool,8192,0)==NULL&&committed==0);invariant();
+    puts("PASS domain isolation, live-page exclusion, large allocations and successful/failed pressure retry");
+    free(arena);return 0;
+}
diff --git a/tests/host/pool-idle/check.py b/tests/host/pool-idle/check.py
new file mode 100644
index 00000000..eafa1d36
--- /dev/null
+++ b/tests/host/pool-idle/check.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Execute production pool allocation/free/reclaim with modeled page boundaries."""
+import importlib.util
+from pathlib import Path
+import re
+import subprocess
+import sys
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location("extract", root / "tests/host/kernel-performance/check.py")
+m = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(m)
+pool = (root / "ntoskrnl/xb/mm/pool.c").read_text()
+macros = pool[pool.index("#ifdef NXK_MM_POOLPAGES"):pool.index("/* SIZE CLASSES")]
+definitions = pool[pool.index("static const USHORT NxpClassSize"):pool.index("/* BIG-BLOCK TABLE")]
+names = ("InitializePool", "NxpAllocFailed", "NxpDetachEmptyBucketPage",
+         "NxpAllocatePoolWithTag", "ExAllocatePoolWithTag", "NxTitleAllocatePoolWithTag",
+         "NxTitleAllocatePool", "ExAllocatePool", "ExFreePoolWithTag",
+         "NxpReclaimEmptyBucketPages", "ExQueryPoolBlockSize")
+bodies = "".join(m.function(pool, name) for name in names
+                 if re.search(r"\b" + name + r"\s*\([^;]*?\)\s*\{", pool))
+for reserve in (0, 1):
+    source = out / f"pool-idle-{reserve}.c"
+    source.write_text((root / "tests/host/pool-idle/shim.c").read_text()
+                      + f"\n#define XBOX_RESERVE_UPPER_RAM {reserve}\n"
+                      + macros + definitions
+                      + "\nULONG NxpReclaimEmptyBucketPages(void);\n"
+                      + bodies
+                      + ("\n#define HAS_PREV 1\n" if "struct _NXP_FREE *Prev;" in definitions
+                         else "\n#define HAS_PREV 0\n")
+                      + ("\n#define HAS_EMPTY 1\n" if "NxpEmptyPages[" in definitions
+                         else "\n#define HAS_EMPTY 0\n")
+                      + (root / "tests/host/pool-idle/cases.c").read_text())
+    binary = source.with_suffix("")
+    subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-g",
+                    "-fsanitize=address,undefined", str(source), "-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
