+static VOID
+NxpDetachEmptyBucketPage(ULONG_PTR PageVa)
+{
+    NXP_HEADER *Hdr0 = (NXP_HEADER *)PageVa;
+    ULONG Class = Hdr0->ClassIndex;
+    ULONG Size = NxpClassSize[NXP_SIZE_CLASS(Class)];
+    ULONG Count = PAGE_SIZE / Size;
