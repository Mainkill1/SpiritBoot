+        NXP_FREE *Blk = (NXP_FREE *)(Hdr + 1);
+        ASSERT(Hdr->Magic == NXP_MAGIC_FREE && Hdr->ClassIndex == Class);
+        if (Blk->Prev != NULL)
+            Blk->Prev->Next = Blk->Next;
+        else
+            NxpFreeLists[Class] = Blk->Next;
+        if (Blk->Next != NULL)
+            Blk->Next->Prev = Blk->Prev;
+    }
+    NxpEmptyPages[Class]--;
+    NxpPageState[NXP_PAGE_INDEX(PageVa)] = NXP_NOT_BUCKET;
