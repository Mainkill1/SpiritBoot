Subject: [PATCH] xbox: add pre-title settings menu

---
 hal/halx86/xbox/video/BootVgaInitialization.c |   4 +
 ntoskrnl/CMakeLists.txt                       |   3 +
 ntoskrnl/ex/init.c                            |  12 +-
 ntoskrnl/inbv/bootanim.rc                     |   5 +-
 ntoskrnl/inbv/resources/spiritboot.bmp        | Bin 0 -> 32886 bytes
 ntoskrnl/xb/boot_setup.c                      | 222 +++++
 ntoskrnl/xb/boot_setup.h                      |  80 ++
 ntoskrnl/xb/boot_xid.c                        | 106 +++
 ntoskrnl/xb/boot_xid.h                        |  58 ++
 ntoskrnl/xb/bootsetup_native.c                | 844 ++++++++++++++++++
 10 files changed, 1331 insertions(+), 3 deletions(-)
 create mode 100644 ntoskrnl/inbv/resources/spiritboot.bmp
 create mode 100644 ntoskrnl/xb/boot_setup.c
 create mode 100644 ntoskrnl/xb/boot_setup.h
 create mode 100644 ntoskrnl/xb/boot_xid.c
 create mode 100644 ntoskrnl/xb/boot_xid.h
 create mode 100644 ntoskrnl/xb/bootsetup_native.c

diff --git a/hal/halx86/xbox/video/BootVgaInitialization.c b/hal/halx86/xbox/video/BootVgaInitialization.c
index 81799d4a..d1334264 100644
--- a/hal/halx86/xbox/video/BootVgaInitialization.c
+++ b/hal/halx86/xbox/video/BootVgaInitialization.c
@@ -83,6 +83,10 @@ char *AvCableName(void) {
 	}
 }
 
+/* The calibration tables consumed here already live in INITDATA.  Keep the
+ * only routine that references them in the same boot-only lifetime even when
+ * LTO leaves the function out of the automatic INIT closure. */
+CODE_SEG("INIT")
 void BootVgaInitializationKernelNG(CURRENT_VIDEO_MODE_DETAILS * pvmode) {
 	xbox_tv_encoding tv_encoding;
 	xbox_av_type av_type;
diff --git a/ntoskrnl/CMakeLists.txt b/ntoskrnl/CMakeLists.txt
index 6f622ab0..8bec7c12 100644
--- a/ntoskrnl/CMakeLists.txt
+++ b/ntoskrnl/CMakeLists.txt
@@ -150,6 +150,9 @@ list(APPEND PCH_SKIP_SOURCE
     xb/interrupt.c
     xb/shutdown.c
     xb/debugprompt.c
+    xb/boot_setup.c
+    xb/boot_xid.c
+    xb/bootsetup_native.c
     xb/sizeddata.c
     xb/scattergather.c
     xb/exflist.c
diff --git a/ntoskrnl/ex/init.c b/ntoskrnl/ex/init.c
index cba2d24f..b346d644 100644
--- a/ntoskrnl/ex/init.c
+++ b/ntoskrnl/ex/init.c
@@ -1458,9 +1458,17 @@ Phase1InitializationDiscard(IN PVOID Context)
     /* Check if GUI boot is enabled */
     if (!NoGuiBoot)
     {
-        /* It is, display the boot logo and enable printing strings */
+        /* Hold the actual SpiritBoot splash at the controller gate before
+         * later initialization can replace it. Setup owns and retires its
+         * temporary OHCI/DMA state before normal boot resumes. */
+        InbvEnableDisplayString(TRUE);
+#ifdef SARCH_XBOX
+        {
+            extern VOID NTAPI NxkBootSetupRun(VOID);
+            NxkBootSetupRun();
+        }
+#endif
         InbvEnableDisplayString(SosEnabled);
-        DisplayBootBitmap(SosEnabled);
     }
     else
     {
diff --git a/ntoskrnl/inbv/bootanim.rc b/ntoskrnl/inbv/bootanim.rc
index c38ef017..f6b803ef 100644
--- a/ntoskrnl/inbv/bootanim.rc
+++ b/ntoskrnl/inbv/bootanim.rc
@@ -17,7 +17,10 @@
  * variants, the copyright text, the rotating line (INBV_ROTBAR_IMPLEMENTED
  * is off), and the progress bar -- their code paths are unreachable on
  * Xbox. */
-IDB_LOGO_DEFAULT    BITMAP "inbv/resources/nxlogo.bmp"
+/* SpiritBoot uses a compact 4-bit indexed logo so the splash remains cheap
+ * in ROM and in the bootvid backbuffer. Additional animation frames can use
+ * the same format without changing settings-menu timing or input handling. */
+IDB_LOGO_DEFAULT    BITMAP "inbv/resources/spiritboot.bmp"
 #else
 IDB_HIBERNATE_BAR   BITMAP "inbv/resources/hibernate.bmp"
 IDB_SHUTDOWN_MSG    BITMAP "inbv/resources/shutdown.bmp"
diff --git a/ntoskrnl/inbv/resources/spiritboot.bmp b/ntoskrnl/inbv/resources/spiritboot.bmp
new file mode 100644
