+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise production seek checkpoints against independent fragmented maps."""
+import importlib.util
+from pathlib import Path
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location(
+    "extract", root / "tests/host/kernel-performance/check.py")
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+source = (root / "drivers/filesystems/vfatfs/rw.c").read_text()
+body = "\n".join(extract.function(source, name) for name in (
+    "VfatPrepareSeekCache", "VfatLookupSeekCheckpoint", "VfatRememberSeekCheckpoint",
+    "VfatInvalidateSeekCheckpoints"))
+shim = r'''
+#include <stdint.h>
+#include <string.h>
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+typedef uint32_t ULONG, *PULONG;
+typedef void VOID;
+typedef int BOOLEAN;
+#define TRUE 1
+#define FALSE 0
+#define NonPagedPool 0
+#define TAG_FCB 0
+typedef struct { struct { ULONG Offset, Cluster; } Positions[16]; } VFAT_SEEK_CACHE, *PVFAT_SEEK_CACHE;
+#define VFAT_SEEK_CHECKPOINTS 16
+#define RtlZeroMemory(p,n) memset(p,0,n)
+typedef struct {
+    struct { struct { struct { ULONG LowPart; } u; } AllocationSize; } RFCB;
+    PVFAT_SEEK_CACHE SeekCache;
+    int LastMutex;
+} VFATFCB, *PVFATFCB;
+static int held, allocation_fail;
+static unsigned allocations, frees;
+static void *ExAllocatePoolWithTag(int pool, size_t size, int tag) {
+    (void)pool; (void)tag; assert(!held);
+    if(allocation_fail) return NULL;
+    allocations++; return malloc(size);
+}
+static void ExFreePool(void *p) { assert(!held); frees++; free(p); }
+static void ExAcquireFastMutex(int *m) { (void)m; assert(!held); held=1; }
+static void ExReleaseFastMutex(int *m) { (void)m; assert(held); held=0; }
+'''
+main = r'''
+static unsigned checks;
+static void check(int condition) { ++checks; assert(condition); }
+static ULONG physical(ULONG logical) { return 2 + ((logical * 7919u) % 4096); }
+int main(void) {
+    VFATFCB f = {0};
+    f.RFCB.AllocationSize.u.LowPart = 4096 * 4096;
+    allocation_fail=1; check(!VfatPrepareSeekCache(&f) && !f.SeekCache);
+    allocation_fail=0; check(VfatPrepareSeekCache(&f) && f.SeekCache);
+    check(VfatPrepareSeekCache(&f) && allocations==1);
+    ULONG cluster=2, offset=0;
+    VfatLookupSeekCheckpoint(&f, 123*4096, &cluster, &offset);
+    check(cluster==2 && offset==0);
+    unsigned long work=0;
+    for (ULONG n=0; n<4096; ++n) {
+        ULONG target=(n*751u)%4096;
+        cluster=physical(0); offset=0;
+        VfatLookupSeekCheckpoint(&f,target*4096,&cluster,&offset);
+        check(offset<=target*4096 && offset%4096==0);
+        check(cluster==physical(offset/4096));
+        work+=target-offset/4096;
+        VfatRememberSeekCheckpoint(&f,target*4096,physical(target),target*4096,physical(target));
+    }
+    check(work<4096ul*200); /* Full restarts average 2047.5 links. */
+    for (ULONG target=0; target<4096; ++target) {
+        cluster=physical(0); offset=0;
+        VfatLookupSeekCheckpoint(&f,target*4096,&cluster,&offset);
+        check(offset<=target*4096 && cluster==physical(offset/4096));
+        check(target-offset/4096<=274);
+    }
+    /* A closer existing last-position hint must win over sparse checkpoints. */
+    cluster=physical(1001); offset=1001*4096;
+    VfatLookupSeekCheckpoint(&f,1002*4096,&cluster,&offset);
+    check(cluster==physical(1001) && offset==1001*4096);
+    /* Sequential access retains the previous exact position. */
+    for (ULONG target=0; target<4096; ++target) {
+        cluster=0;offset=0;
+        VfatLookupSeekCheckpoint(&f,target*4096,&cluster,&offset);
+        check(target-offset/4096<=1);
+        VfatRememberSeekCheckpoint(&f,target*4096,physical(target),target*4096,physical(target));
+    }
+    /* A completed multi-cluster run leaves the next seek one link away. */
+    VfatInvalidateSeekCheckpoints(&f);
+    for (ULONG target=0; target<4096; target+=64) {
+        cluster=0;offset=0;
+        VfatLookupSeekCheckpoint(&f,target*4096,&cluster,&offset);
+        check(target-offset/4096<=1);
+        VfatRememberSeekCheckpoint(&f,target*4096,physical(target),(target+63)*4096,physical(target+63));
+    }
+    /* Resize invalidation discards every old physical address. */
+    VfatInvalidateSeekCheckpoints(&f);
+    check(!held);
+    for (ULONG target=0; target<4096; target+=17) {
+        cluster=0;offset=0;
+        VfatLookupSeekCheckpoint(&f,target*4096,&cluster,&offset);
+        check(cluster==0 && offset==0);
+    }
+    /* Empty, out-of-file and EOF/sentinel inputs must never populate it. */
+    VfatRememberSeekCheckpoint(&f,0,0xffffffff,0,0xffffffff);
+    VfatRememberSeekCheckpoint(&f,0,1,0,1);
+    VfatRememberSeekCheckpoint(&f,4096*4096,42,4096*4096,42);
+    f.RFCB.AllocationSize.u.LowPart=0;
+    VfatRememberSeekCheckpoint(&f,0,42,0,42);
+    cluster=0;offset=0;
+    VfatLookupSeekCheckpoint(&f,0xffffffff,&cluster,&offset);
+    check(cluster==0);
+    /* High offsets cannot wrap the band arithmetic. */
+    f.RFCB.AllocationSize.u.LowPart=0xffffffff;
+    VfatRememberSeekCheckpoint(&f,0xfffff000,12345,0xfffff000,12345);
+    cluster=0;offset=0;
+    VfatLookupSeekCheckpoint(&f,0xfffff000,&cluster,&offset);
+    check(cluster==12345 && offset==0xfffff000);
+    ExFreePool(f.SeekCache); check(allocations==frees);
+    printf("seek checkpoints: %u checks, %lu traversed links, 0 failures\n",checks,work);
+}
+'''
+c = out / "check.c"
+c.write_text(shim + body + main)
+subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-O2",
+                str(c), "-o", str(out / "check")], check=True)
+subprocess.run([str(out / "check")], check=True)
