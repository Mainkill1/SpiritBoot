+static NX_NATIVE_ENVELOPE *allocate_dynamic_envelope(NX_NATIVE_ADAPTER *adapter)
+{
+    NX_NATIVE_ENVELOPE *envelope=ExAllocatePool(NonPagedPool,sizeof(*envelope));
+    if(!envelope) return NULL;
+    zero_bytes(envelope,sizeof(*envelope));
+    envelope->adapter=adapter;envelope->dynamic=1;
+    KeInitializeDpc(&envelope->completion_dpc,NxNativeCompletionDpc,envelope);
+    envelope->child=IoAllocateIrp((CCHAR)adapter->lower->StackSize,FALSE);
+    envelope->control_mdl=IoAllocateMdl(envelope->control_data,
+        sizeof(envelope->control_data),FALSE,FALSE,NULL);
+    if(!envelope->child || !envelope->control_mdl) {
+        destroy_dynamic_envelope(envelope);return NULL;
+    }
+    MmBuildMdlForNonPagedPool(envelope->control_mdl);
+    return envelope;
+}
 
