+static void destroy_dynamic_envelope(NX_NATIVE_ENVELOPE *envelope)
+{
+    if(!envelope) return;
+    if(envelope->child) IoFreeIrp(envelope->child);
+    if(envelope->control_mdl) IoFreeMdl(envelope->control_mdl);
+    ExFreePool(envelope);
+}
