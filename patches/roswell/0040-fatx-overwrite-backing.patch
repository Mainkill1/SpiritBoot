diff --git a/drivers/filesystems/vfatfs/finfo.c b/drivers/filesystems/vfatfs/finfo.c
index ad39f68b..f89ca39b 100644
--- a/drivers/filesystems/vfatfs/finfo.c
+++ b/drivers/filesystems/vfatfs/finfo.c
@@ -1257,6 +1257,81 @@ UpdateAllocationSize(
     CcSetFileSizes(FileObject, (PCC_FILE_SIZES)&Fcb->RFCB.AllocationSize);
 }
 
+#ifdef SARCH_XBOX
+/* A zero logical EOF can still own a backing chain after overwrite.  An FCB
+ * reconstructed from its directory entry has lost the in-memory capacity. */
+NTSTATUS
+VfatRestoreRetainedAllocation(PVFATFCB Fcb, PDEVICE_EXTENSION DeviceExt)
+{
+    ULONG Cluster, Next, Count = 0, Last = 0;
+    ULONG ClusterSize = DeviceExt->FatInfo.BytesPerCluster;
+    NTSTATUS Status;
+
+    if (!vfatVolumeIsFatX(DeviceExt) || vfatFCBIsDirectory(Fcb) ||
+        Fcb->RFCB.FileSize.QuadPart != 0 ||
+        Fcb->RFCB.AllocationSize.QuadPart != 0)
+        return STATUS_SUCCESS;
+
+    Cluster = vfatDirEntryGetFirstCluster(DeviceExt, &Fcb->entry);
+    if (Cluster == 0)
+        return STATUS_SUCCESS;
+
+    if (ClusterSize == 0 || Cluster == 0xffffffff)
+        return STATUS_FILE_CORRUPT_ERROR;
+    while (Cluster != 0xffffffff)
+    {
+        if (Cluster < 2 || Cluster - 2 >= DeviceExt->FatInfo.NumberOfClusters ||
+            Count >= DeviceExt->FatInfo.NumberOfClusters ||
+            Count >= MAXULONG / ClusterSize)
+            return STATUS_FILE_CORRUPT_ERROR;
+        Status = GetNextCluster(DeviceExt, Cluster, &Next);
+        if (!NT_SUCCESS(Status))
+            return Status;
+        Last = Cluster;
+        ++Count;
+        Cluster = Next;
+    }
+
+    Fcb->RFCB.AllocationSize.QuadPart = (LONGLONG)Count * ClusterSize;
+    Fcb->LastCluster = Last;
+    Fcb->LastOffset = (Count - 1) * ClusterSize;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS
+VfatResetFileSizeForOverwrite(PFILE_OBJECT FileObject, PVFATFCB Fcb,
+                             PDEVICE_EXTENSION DeviceExt)
+{
+    LARGE_INTEGER Empty = { .QuadPart = 0 };
+    LARGE_INTEGER OldSize = Fcb->RFCB.FileSize;
+    LARGE_INTEGER OldValid = Fcb->RFCB.ValidDataLength;
+    ULONG OldEntrySize = Fcb->entry.FatX.FileSize;
+    ULONG OldFlags = Fcb->Flags;
+    NTSTATUS Status;
+
+    if (!MmCanFileBeTruncated(FileObject->SectionObjectPointer, &Empty))
+        return STATUS_USER_MAPPED_FILE;
+
+    /* The observed Xbox overwrite/reextend sequence resets EOF but keeps
+     * existing bytes.  Preserve allocation, first cluster and seek state. */
+    Fcb->entry.FatX.FileSize = 0;
+    Fcb->RFCB.FileSize.QuadPart = 0;
+    Fcb->RFCB.ValidDataLength.QuadPart = 0;
+    CcSetFileSizes(FileObject, (PCC_FILE_SIZES)&Fcb->RFCB.AllocationSize);
+    Fcb->Flags |= FCB_IS_DIRTY;
+    Status = VfatUpdateEntry(DeviceExt, Fcb);
+    if (!NT_SUCCESS(Status))
+    {
+        Fcb->entry.FatX.FileSize = OldEntrySize;
+        Fcb->RFCB.FileSize = OldSize;
+        Fcb->RFCB.ValidDataLength = OldValid;
+        Fcb->Flags = OldFlags;
+        CcSetFileSizes(FileObject, (PCC_FILE_SIZES)&Fcb->RFCB.AllocationSize);
+    }
+    return Status;
+}
+#endif
+
 NTSTATUS
 VfatSetAllocationSizeInformation(
     PFILE_OBJECT FileObject,
@@ -1287,7 +1362,9 @@ VfatSetAllocationSizeInformation(
         return STATUS_INVALID_PARAMETER;
     }
 
-    if (OldSize == NewSize)
+    if (OldSize == NewSize &&
+        (!AllocationOnly ||
+         ROUND_UP_64(NewSize, ClusterSize) == Fcb->RFCB.AllocationSize.QuadPart))
     {
         return STATUS_SUCCESS;
     }
