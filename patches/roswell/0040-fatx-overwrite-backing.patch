+ assert(f.RFCB.FileSize.QuadPart==0 && f.RFCB.ValidDataLength.QuadPart==0 && f.entry.FatX.FileSize==0);
+ assert(observed.AllocationSize.QuadPart==12288 && sizes==1 && updates==1 && f.Flags==FCB_IS_DIRTY);
+ f.RFCB.FileSize.QuadPart=f.entry.FatX.FileSize=9; allow_truncate=0;
+ assert(VfatResetFileSizeForOverwrite(&file,&f,&d)==STATUS_USER_MAPPED_FILE);
+ assert(f.RFCB.FileSize.QuadPart==9 && f.entry.FatX.FileSize==9 && sizes==1 && updates==1);
+ allow_truncate=1; update_status=STATUS_FILE_CORRUPT_ERROR;
+ f.RFCB.ValidDataLength.QuadPart=7; f.Flags=8;
