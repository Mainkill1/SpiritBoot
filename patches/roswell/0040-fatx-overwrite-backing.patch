+/* Independent synthetic reference observation: overwrite reports EOF zero,
+ * but extending EOF back to the old length exposes the original bytes.
+ * Exercise both the live handle and a close/reopen while EOF is zero. */
+#define RETAIN_BYTES (128u * 1024u)
+static unsigned char retain_buffer[RETAIN_BYTES];
+
+static unsigned char retain_pattern(unsigned offset)
+{
+    return (unsigned char)((offset * 29u) ^ (offset >> 8) ^
+                           (offset >> 16) ^ 0x5au);
+}
+
+static bool overwrite_reextend(ULONG disposition, bool reopen_zero)
+{
+    HANDLE h = NULL;
+    IO_STATUS_BLOCK iosb = { 0 };
+    FILE_NETWORK_OPEN_INFORMATION info;
+    LARGE_INTEGER zero = { .QuadPart = 0 };
+    FILE_END_OF_FILE_INFORMATION eof = { .EndOfFile = { .QuadPart = RETAIN_BYTES } };
+    NTSTATUS s;
+    bool ok = false;
+    const char *step = "initial create";
+
+    unlink_scratch();
+    s = open_scratch(&h, &iosb, GENERIC_READ | GENERIC_WRITE,
+                     FILE_OVERWRITE_IF, 0);
+    if (s != STATUS_SUCCESS) goto failed;
+    for (unsigned i = 0; i < RETAIN_BYTES; ++i)
+        retain_buffer[i] = retain_pattern(i);
+    step = "initial write";
+    s = NtWriteFile(h, NULL, NULL, NULL, &iosb, retain_buffer,
+                    RETAIN_BYTES, &zero);
+    if (s != STATUS_SUCCESS || iosb.Information != RETAIN_BYTES) goto failed;
+    step = "initial close";
+    s = NtClose(h);
+    if (s != STATUS_SUCCESS) goto failed;
+    h = NULL;
+
+    step = "existing open";
+    s = open_scratch(&h, &iosb, GENERIC_READ | GENERIC_WRITE, disposition, 0);
+    if (s != STATUS_SUCCESS) goto failed;
+    if (iosb.Information != (disposition == FILE_OPEN ? FILE_OPENED : FILE_OVERWRITTEN)) {
+        test_record_failure(__FILE__, __LINE__, "disposition %u: create information %u",
+                            (unsigned)disposition, (unsigned)iosb.Information);
+        goto out;
+    }
+    step = "EOF after existing open";
+    s = NtQueryInformationFile(h, &iosb, &info, sizeof(info), FileNetworkOpenInformation);
+    if (s != STATUS_SUCCESS) goto failed;
+    LONGLONG expected_eof = disposition == FILE_OPEN ? RETAIN_BYTES : 0;
+    if (info.EndOfFile.QuadPart != expected_eof) {
+        test_record_failure(__FILE__, __LINE__, "disposition %u: EOF %ld expected %ld",
+                            (unsigned)disposition, (long)info.EndOfFile.QuadPart,
+                            (long)expected_eof);
+        goto out;
+    }
+    if (reopen_zero) {
+        step = "close at EOF zero";
+        s = NtClose(h);
+        if (s != STATUS_SUCCESS) goto failed;
+        h = NULL;
+        step = "reopen at EOF zero";
+        s = open_scratch(&h, &iosb, GENERIC_READ | GENERIC_WRITE, FILE_OPEN, 0);
+        if (s != STATUS_SUCCESS) goto failed;
+        step = "query reopened EOF zero";
+        s = NtQueryInformationFile(h, &iosb, &info, sizeof(info), FileNetworkOpenInformation);
+        if (s != STATUS_SUCCESS) goto failed;
+        if (info.EndOfFile.QuadPart != 0) {
+            test_record_failure(__FILE__, __LINE__, "reopened EOF was %ld, expected zero",
+                                (long)info.EndOfFile.QuadPart);
+            goto out;
+        }
+    }
+    step = "restore EOF";
+    s = NtSetInformationFile(h, &iosb, &eof, sizeof(eof), FileEndOfFileInformation);
+    if (s != STATUS_SUCCESS) goto failed;
+    step = "query restored EOF";
+    s = NtQueryInformationFile(h, &iosb, &info, sizeof(info), FileNetworkOpenInformation);
+    if (s != STATUS_SUCCESS) goto failed;
+    if (info.EndOfFile.QuadPart != RETAIN_BYTES) {
+        test_record_failure(__FILE__, __LINE__, "restored EOF was %ld, expected %u",
+                            (long)info.EndOfFile.QuadPart, RETAIN_BYTES);
+        goto out;
+    }
+    memset(retain_buffer, 0, sizeof(retain_buffer));
+    step = "read restored contents";
+    s = NtReadFile(h, NULL, NULL, NULL, &iosb, retain_buffer, RETAIN_BYTES, &zero);
+    if (s != STATUS_SUCCESS || iosb.Information != RETAIN_BYTES) goto failed;
+    for (unsigned i = 0; i < RETAIN_BYTES; ++i) {
+        if (retain_buffer[i] != retain_pattern(i)) {
+            test_record_failure(__FILE__, __LINE__,
+                                "disposition %u reopen_zero %u: byte %u got %02x expected %02x",
+                                (unsigned)disposition, (unsigned)reopen_zero, i,
+                                retain_buffer[i], retain_pattern(i));
+            goto out;
+        }
+    }
+    ok = true;
+    goto out;
+failed:
+    test_record_failure(__FILE__, __LINE__, "%s: status %08x information %u",
+                        step, (unsigned)s, (unsigned)iosb.Information);
+out:
+    if (h != NULL) {
+        NTSTATUS closed = NtClose(h);
+        if (ok && closed != STATUS_SUCCESS) {
+            test_record_failure(__FILE__, __LINE__, "final close: status %08x",
+                                (unsigned)closed);
+            ok = false;
+        }
+    }
+    unlink_scratch();
+    return ok;
+}
+
+static bool t_overwrite_reextend_same_handle(void)
+{
+    return overwrite_reextend(FILE_OVERWRITE_IF, false);
+}
+
+static bool t_overwrite_reextend_reopened_zero(void)
+{
+    return overwrite_reextend(FILE_OVERWRITE_IF, true);
+}
+
+static bool t_open_same_eof_preserves_contents(void)
+{
+    return overwrite_reextend(FILE_OPEN, false);
+}
+
 /* The disposition reaches the file system unchanged (below), but the
  * console answers it as an overwrite: a supersede of an existing file
  * reports FILE_OVERWRITTEN, never FILE_SUPERSEDED. */
@@ -523,6 +653,9 @@ static const test_entry_t io_createfile_entries[] = {
     { "open_reports_opened", t_open_reports_opened, NULL },
     { "overwrite_if_reports_overwritten",
       t_overwrite_if_reports_overwritten, NULL },
+    { "overwrite_reextend_same_handle", t_overwrite_reextend_same_handle, NULL },
+    { "overwrite_reextend_reopened_zero", t_overwrite_reextend_reopened_zero, NULL },
+    { "open_same_eof_preserves_contents", t_open_same_eof_preserves_contents, NULL },
     { "supersede_reports_overwritten", t_supersede_reports_overwritten,
       NULL },
     { "create_on_existing_collides", t_create_on_existing_collides, NULL },
