+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+source = (root / "drivers/filesystems/vfatfs/finfo.c").read_text()
+body = "\n".join(extract.function(source, name) for name in
+                  ("VfatRestoreRetainedAllocation", "VfatResetFileSizeForOverwrite"))
+body = body.replace("#ifdef SARCH_XBOX\n", "")
+shim = r''' 
+#include <stdint.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint32_t ULONG;
+typedef int64_t LONGLONG;
+typedef int32_t NTSTATUS;
+typedef struct { LONGLONG QuadPart; } LARGE_INTEGER;
+typedef struct { LARGE_INTEGER AllocationSize, FileSize, ValidDataLength; } FILE_SIZES, *PCC_FILE_SIZES;
+typedef struct { FILE_SIZES RFCB; struct { struct { ULONG FileSize, FirstCluster; } FatX; } entry; ULONG Flags, LastCluster, LastOffset; int directory; } FCB, *PVFATFCB;
+typedef struct { struct { ULONG BytesPerCluster, NumberOfClusters; } FatInfo; int fatx; } DEVICE, *PDEVICE_EXTENSION;
+typedef struct { void *SectionObjectPointer; } FILE_OBJECT, *PFILE_OBJECT;
+#define STATUS_SUCCESS 0
+#define STATUS_FILE_CORRUPT_ERROR ((NTSTATUS)0xc0000102)
+#define STATUS_USER_MAPPED_FILE ((NTSTATUS)0xc0000243)
+#define NT_SUCCESS(x) ((x)>=0)
+#define MAXULONG UINT32_MAX
+#define FCB_IS_DIRTY 1
+static ULONG links[10];
+static unsigned reads, updates, sizes;
+static int allow_truncate = 1;
+static NTSTATUS read_status, update_status;
+static FILE_SIZES observed;
+static int vfatVolumeIsFatX(PDEVICE_EXTENSION d) { return d->fatx; }
+static int vfatFCBIsDirectory(PVFATFCB f) { return f->directory; }
+static ULONG vfatDirEntryGetFirstCluster(PDEVICE_EXTENSION d, void *e) { (void)d; return ((FCB *)((char *)e - __builtin_offsetof(FCB, entry)))->entry.FatX.FirstCluster; }
+static NTSTATUS GetNextCluster(PDEVICE_EXTENSION d, ULONG c, ULONG *n) { (void)d; ++reads; if (!NT_SUCCESS(read_status)) return read_status; assert(c<10); *n=links[c]; return 0; }
+static int MmCanFileBeTruncated(void *section, LARGE_INTEGER *size) { (void)section; assert(size->QuadPart==0); return allow_truncate; }
+static void CcSetFileSizes(PFILE_OBJECT f, PCC_FILE_SIZES s) { (void)f; ++sizes; observed=*s; }
+static NTSTATUS VfatUpdateEntry(PDEVICE_EXTENSION d, PVFATFCB f) { (void)d; (void)f; ++updates; return update_status; }
+'''
+cases = r'''
+int main(void) {
+ DEVICE d={{4096,8},1}; FCB f={0}; FILE_OBJECT file={0};
+ f.entry.FatX.FirstCluster=2; links[2]=3; links[3]=4; links[4]=UINT32_MAX;
+ assert(VfatRestoreRetainedAllocation(&f,&d)==0);
+ assert(f.RFCB.AllocationSize.QuadPart==12288 && f.LastCluster==4 && f.LastOffset==8192 && reads==3);
