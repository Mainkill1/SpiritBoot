+ assert(VfatRestoreRetainedAllocation(&f,&d)==STATUS_FILE_CORRUPT_ERROR && reads<=8);
+ assert(f.RFCB.AllocationSize.QuadPart==0 && f.LastCluster==0);
+ links[4]=UINT32_MAX; read_status=STATUS_FILE_CORRUPT_ERROR; reads=0;
