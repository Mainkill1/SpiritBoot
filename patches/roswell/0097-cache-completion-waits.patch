diff --git a/tests/host/cache/check-completion-waits.py b/tests/host/cache/check-completion-waits.py
new file mode 100644
index 0000000000000000000000000000000000000000..d160deb18c001ec8a0866bed66641ac3cc9b8eed
--- /dev/null
+++ b/tests/host/cache/check-completion-waits.py
@@ -0,0 +1,388 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise cache completion waits through the production cache bodies."""
+
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location(
+    "extract", root / "tests/host/kernel-performance/check.py")
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+source = (root / "ntoskrnl/xb/mm/cache.c").read_text()
+assert "NxcShortWait" not in source
+assert "KeDelayExecutionThread" not in source
+assert source.count("Block->Busy = FALSE;") == 1
+
+# These helpers form the synchronization contract.  Keeping this test linked
+# to their production bodies catches descriptor-owned events, wake-one
+# implementations, and callers that stop re-looking up the cache key.
+bodies = ""
+for name in (
+    "NxcWaitOnListLocked",
+    "NxcWakeWaitersLocked",
+    "NxcPublishBlockIdleLocked",
+    "NxcLookupBlock",
+    "NxcPutBlock",
+    "NxcGetBlock",
+):
+    bodies += extract.function(source, name) + "\n"
+
+shim = r'''
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef int32_t NTSTATUS;
+typedef unsigned ULONG;
+typedef int64_t LONGLONG;
+typedef size_t SIZE_T;
+typedef int BOOLEAN;
+typedef void VOID;
+#define IN
+#define OUT
+#define TRUE 1
+#define FALSE 0
+#define STATUS_SUCCESS ((NTSTATUS)0)
+#define NT_SUCCESS(status) ((status) >= 0)
+#define NXC_BLOCK_SIZE 16
+#define NXC_TOTAL_BLOCKS 2
+#define ASSERT assert
+#define NotificationEvent 0
+#define Executive 0
+#define KernelMode 0
+#define IO_NO_INCREMENT 0
+#define CONTAINING_RECORD(p, t, f) ((t *)((char *)(p) - offsetof(t, f)))
+
+typedef struct _LIST_ENTRY {
+    struct _LIST_ENTRY *Flink;
+    struct _LIST_ENTRY *Blink;
+} LIST_ENTRY, *PLIST_ENTRY;
+typedef struct { int Signaled; } KEVENT;
+typedef struct { LONGLONG QuadPart; } LARGE_INTEGER;
+typedef struct {
+    void *FileObject;
+    LARGE_INTEGER FileSize;
+    LARGE_INTEGER ValidDataLength;
+} NXC_MAP;
+typedef struct {
+    NXC_MAP *Map;
+    LONGLONG Offset;
+    unsigned char *Data;
+    LIST_ENTRY LruLink;
+    LIST_ENTRY BusyWaiters;
+    ULONG RefCount;
+    BOOLEAN Valid;
+    BOOLEAN Dirty;
+    BOOLEAN Busy;
+    BOOLEAN Reserved;
+} NXC_BLOCK;
+typedef struct {
+    LIST_ENTRY Link;
+    KEVENT Event;
+#ifdef NXK_CACHE_WAIT_COUNTERS
+    LARGE_INTEGER WokenAt;
+#endif
+} NXC_WAIT_ENTRY;
+#ifdef NXK_CACHE_WAIT_COUNTERS
+typedef struct {
+    uint64_t BusyWaitCount;
+    uint64_t CapacityWaitCount;
+    uint64_t WakeCount;
+    uint64_t SpuriousRetryCount;
+    uint64_t CompletionToResumeTicks;
+    uint64_t MutexReacquireCount;
+} NXC_CACHE_WAIT_COUNTERS;
+static NXC_CACHE_WAIT_COUNTERS NxcCacheWaitCounters;
+#endif
+
+static NXC_BLOCK NxcBlocks[NXC_TOTAL_BLOCKS];
+static LIST_ENTRY NxcLruList;
+static LIST_ENTRY NxcCapacityWaiters;
+static NXC_BLOCK *NxcLookupHint;
+static int NxcMutex;
+static int held;
+static unsigned signals;
+static unsigned waits;
+#ifdef NXK_CACHE_WAIT_COUNTERS
+static int64_t ticks;
+#endif
+static void (*wait_hook)(KEVENT *);
+static unsigned char bytes[NXC_TOTAL_BLOCKS][NXC_BLOCK_SIZE];
+
+static void InitializeListHead(LIST_ENTRY *head)
+{
+    head->Flink = head->Blink = head;
+}
+static int IsListEmpty(const LIST_ENTRY *head)
+{
+    return head->Flink == head;
+}
+static void InsertTailList(LIST_ENTRY *head, LIST_ENTRY *entry)
+{
+    entry->Blink = head->Blink;
+    entry->Flink = head;
+    head->Blink->Flink = entry;
+    head->Blink = entry;
+}
+static LIST_ENTRY *RemoveHeadList(LIST_ENTRY *head)
+{
+    LIST_ENTRY *entry = head->Flink;
+    entry->Flink->Blink = head;
+    head->Flink = entry->Flink;
+    return entry;
+}
+static void RemoveEntryList(LIST_ENTRY *entry)
+{
+    entry->Blink->Flink = entry->Flink;
+    entry->Flink->Blink = entry->Blink;
+    entry->Flink = entry->Blink = entry;
+}
+static void ExReleaseFastMutex(int *mutex)
+{
+    (void)mutex;
+    assert(held);
+    held = 0;
+}
+static void ExAcquireFastMutex(int *mutex)
+{
+    (void)mutex;
+    assert(!held);
+    held = 1;
+}
+static void KeInitializeEvent(KEVENT *event, int type, BOOLEAN state)
+{
+    (void)type;
+    event->Signaled = state;
+}
+static void KeSetEvent(KEVENT *event, int increment, BOOLEAN wait)
+{
+    (void)increment;
+    (void)wait;
+    assert(held);
+    event->Signaled = 1;
+    ++signals;
+}
+#ifdef NXK_CACHE_WAIT_COUNTERS
+static LARGE_INTEGER KeQueryPerformanceCounter(void *frequency)
+{
+    LARGE_INTEGER value;
+    (void)frequency;
+    value.QuadPart = (ticks += 10);
+    return value;
+}
+#endif
+static void KeWaitForSingleObject(KEVENT *event, int reason, int mode,
+                                  BOOLEAN alertable, void *timeout)
+{
+    (void)reason;
+    (void)mode;
+    (void)alertable;
+    (void)timeout;
+    assert(!held);
+    ++waits;
+    assert(wait_hook != NULL);
+    wait_hook(event);
+    assert(event->Signaled);
+}
+static void ExRaiseStatus(NTSTATUS status)
+{
+    (void)status;
+    assert(!"unexpected status raise");
+}
+
+static NXC_BLOCK *NxcClaimSlot(BOOLEAN wait);
+static NTSTATUS NxcReadBlock(NXC_BLOCK *block);
+'''
+
+support = r'''
+static NXC_BLOCK *NxcClaimSlot(BOOLEAN wait)
+{
+    assert(wait && held);
+    assert(NxcBlocks[1].Data != NULL && NxcBlocks[1].Map == NULL);
+    NxcBlocks[1].RefCount = 1;
+    return &NxcBlocks[1];
+}
+
+static NTSTATUS NxcReadBlock(NXC_BLOCK *block)
+{
+    assert(held && block->Busy && block->RefCount == 1);
+    block->Valid = TRUE;
+    NxcPublishBlockIdleLocked(block);
+    return STATUS_SUCCESS;
+}
+'''
+
+cases = r'''
+static NXC_MAP map_a, map_b;
+
+static void initialize_block(NXC_BLOCK *block)
+{
+    memset(block, 0, sizeof(*block));
+    InitializeListHead(&block->LruLink);
+    InitializeListHead(&block->BusyWaiters);
+}
+
+static void reset_state(void)
+{
+    memset(&map_a, 0, sizeof(map_a));
+    memset(&map_b, 0, sizeof(map_b));
+    InitializeListHead(&NxcLruList);
+    InitializeListHead(&NxcCapacityWaiters);
+    for (unsigned i = 0; i < NXC_TOTAL_BLOCKS; ++i) {
+        initialize_block(&NxcBlocks[i]);
+        NxcBlocks[i].Data = bytes[i];
+    }
+    NxcLookupHint = NULL;
+    signals = waits = 0;
+#ifdef NXK_CACHE_WAIT_COUNTERS
+    ticks = 0;
+#endif
+    wait_hook = NULL;
+    held = 1;
+}
+
+static void enqueue_waiter(LIST_ENTRY *head, NXC_WAIT_ENTRY *waiter)
+{
+    InitializeListHead(&waiter->Link);
+    KeInitializeEvent(&waiter->Event, NotificationEvent, FALSE);
+    InsertTailList(head, &waiter->Link);
+}
+
+static void wake_current_list(KEVENT *event)
+{
+    (void)event;
+    held = 1;
+    NxcPublishBlockIdleLocked(&NxcBlocks[0]);
+    held = 0;
+}
+
+static void test_registration_precedes_unlock(void)
+{
+    reset_state();
+    NxcBlocks[0].Busy = TRUE;
+    wait_hook = wake_current_list;
+    NxcWaitOnListLocked(&NxcBlocks[0].BusyWaiters);
+    assert(held && waits == 1 && signals == 1);
+    assert(IsListEmpty(&NxcBlocks[0].BusyWaiters));
+}
+
+static void test_publish_wakes_every_waiter(void)
+{
+    NXC_WAIT_ENTRY first, second, capacity;
+
+    reset_state();
+    NxcBlocks[0].Busy = TRUE;
+    enqueue_waiter(&NxcBlocks[0].BusyWaiters, &first);
+    enqueue_waiter(&NxcBlocks[0].BusyWaiters, &second);
+    enqueue_waiter(&NxcCapacityWaiters, &capacity);
+    NxcPublishBlockIdleLocked(&NxcBlocks[0]);
+    assert(!NxcBlocks[0].Busy && signals == 3);
+    assert(IsListEmpty(&NxcBlocks[0].BusyWaiters));
+    assert(IsListEmpty(&NxcCapacityWaiters));
+    assert(IsListEmpty(&first.Link) && IsListEmpty(&second.Link));
+    assert(first.Event.Signaled && second.Event.Signaled &&
+           capacity.Event.Signaled);
+}
+
+static void reuse_generation_during_wait(KEVENT *event)
+{
+    held = 1;
+    NxcPublishBlockIdleLocked(&NxcBlocks[0]);
+    assert(event->Signaled);
+
+    /* Reuse the descriptor before generation A's waiter resumes.  The event
+     * belongs to that waiter, so generation B cannot clear or steal it. */
+    RemoveEntryList(&NxcBlocks[0].LruLink);
+    NxcBlocks[0].Map = &map_b;
+    NxcBlocks[0].Valid = FALSE;
+    NxcBlocks[0].Busy = TRUE;
+    InsertTailList(&NxcLruList, &NxcBlocks[0].LruLink);
+    held = 0;
+}
+
+static void test_generation_reuse_relooks_up_key(void)
+{
+    NXC_BLOCK *result;
+
+    reset_state();
+    NxcBlocks[0].Map = &map_a;
+    NxcBlocks[0].Busy = TRUE;
+    InsertTailList(&NxcLruList, &NxcBlocks[0].LruLink);
+    wait_hook = reuse_generation_during_wait;
+
+    result = NxcGetBlock(&map_a, 0, TRUE);
+    assert(result == &NxcBlocks[1]);
+    assert(result->Map == &map_a && result->Valid && !result->Busy);
+    assert(NxcBlocks[0].Map == &map_b && NxcBlocks[0].Busy);
+    assert(waits == 1);
+}
+
+static void test_nowait_never_registers(void)
+{
+    reset_state();
+    NxcBlocks[0].Map = &map_a;
+    NxcBlocks[0].Busy = TRUE;
+    InsertTailList(&NxcLruList, &NxcBlocks[0].LruLink);
+    assert(NxcGetBlock(&map_a, 0, FALSE) == NULL);
+    assert(waits == 0 && signals == 0);
+    assert(IsListEmpty(&NxcBlocks[0].BusyWaiters));
+}
+
+static void test_last_put_wakes_capacity_waiters(void)
+{
+    NXC_WAIT_ENTRY first, second;
+
+    reset_state();
+    NxcBlocks[0].RefCount = 2;
+    enqueue_waiter(&NxcCapacityWaiters, &first);
+    enqueue_waiter(&NxcCapacityWaiters, &second);
+    NxcPutBlock(&NxcBlocks[0]);
+    assert(NxcBlocks[0].RefCount == 1 && signals == 0);
+    NxcPutBlock(&NxcBlocks[0]);
+    assert(NxcBlocks[0].RefCount == 0 && signals == 2);
+    assert(IsListEmpty(&NxcCapacityWaiters));
+}
