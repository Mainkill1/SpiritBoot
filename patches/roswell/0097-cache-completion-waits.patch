+/* Two callers enter the same cold cache block together.  The first request
+ * owns the fill; the second must wait for that exact busy generation, then
+ * relookup and receive identical bytes.  This is also a native no-hang check
+ * for the completion-driven cache waiter. */
+#define PARALLEL_READ_BYTES 0x4000u
+
+typedef struct _CACHE_READ_WORKER {
+    HANDLE File;
+    KEVENT Ready;
+    KEVENT Done;
+    NTSTATUS Status;
+    ULONG Information;
+    unsigned char Buffer[PARALLEL_READ_BYTES];
+} CACHE_READ_WORKER;
+
+static KEVENT g_parallel_start;
+static CACHE_READ_WORKER g_parallel_workers[2];
+
+static NTSTATUS open_parallel_read_handle(HANDLE *file,
+                                          PIO_STATUS_BLOCK iosb)
+{
+    ANSI_STRING name;
+    OBJECT_ATTRIBUTES oa;
+
+    name.Length = (USHORT)strlen(CACHE_A);
+    name.MaximumLength = name.Length + 1;
+    name.Buffer = (PCHAR)CACHE_A;
+    oa.RootDirectory = NULL;
+    oa.ObjectName = &name;
+    oa.Attributes = OBJ_CASE_INSENSITIVE;
+
+    return NtCreateFile(file, GENERIC_READ | SYNCHRONIZE, &oa, iosb, NULL,
+                        FILE_ATTRIBUTE_NORMAL, FILE_SHARE_READ, FILE_OPEN,
+                        FILE_SYNCHRONOUS_IO_NONALERT |
+                        FILE_NON_DIRECTORY_FILE);
+}
+
+static NTSTATUS wait_for_cache_test_event(PKEVENT event)
+{
+    LARGE_INTEGER timeout = {
+        .QuadPart = -((LONGLONG)10 * 1000 * 10000),
+    };
+
+    return KeWaitForSingleObject(event, Executive, KernelMode, FALSE,
+                                 &timeout);
+}
+
+static void NTAPI cache_test_system_routine(PKSTART_ROUTINE StartRoutine,
+                                             PVOID StartContext)
+{
+    if (StartRoutine != NULL)
+        StartRoutine(StartContext);
+    PsTerminateSystemThread(STATUS_SUCCESS);
+}
+
+static void NTAPI parallel_cache_reader(PVOID argument)
+{
+    CACHE_READ_WORKER *worker = argument;
+    IO_STATUS_BLOCK iosb;
+    LARGE_INTEGER offset = { .QuadPart = 0 };
+
+    KeSetEvent(&worker->Ready, 0, FALSE);
+    KeWaitForSingleObject(&g_parallel_start, Executive, KernelMode, FALSE,
+                          NULL);
+    worker->Status = NtReadFile(worker->File, NULL, NULL, NULL, &iosb,
+                                worker->Buffer, sizeof(worker->Buffer),
+                                &offset);
+    worker->Information = (ULONG)iosb.Information;
+    KeSetEvent(&worker->Done, 0, FALSE);
+}
+
+static bool t_parallel_cold_read(void)
+{
+    HANDLE file = NULL;
+    HANDLE worker_files[2] = { NULL, NULL };
+    HANDLE threads[2] = { NULL, NULL };
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS s;
+    bool ok = true;
+    unsigned started = 0;
+
+    unlink_path(CACHE_A);
+    s = open_path(CACHE_A, &file, GENERIC_READ | GENERIC_WRITE,
+                  FILE_OVERWRITE_IF, 0, &iosb);
+    ASSERT_NTSTATUS(s, STATUS_SUCCESS);
+    ok = write_at(file, 0, CHUNK, 0x6D);
+    if (ok)
+        ok = NtFlushBuffersFile(file, &iosb) == STATUS_SUCCESS;
+    NtClose(file);
+    if (!ok) {
+        unlink_path(CACHE_A);
+        FAIL_AND_RETURN("prepare parallel-read file");
+    }
+
+    /* Make the first worker perform a fill rather than inherit the writer's
+     * resident block. */
+    FscInvalidateIdleBlocks();
+    for (unsigned i = 0; i < 2; ++i) {
+        s = open_parallel_read_handle(&worker_files[i], &iosb);
+        if (!NT_SUCCESS(s)) {
+            test_record_failure(__FILE__, __LINE__,
+                                "open parallel worker %u -> 0x%08x",
+                                i, (unsigned)s);
+            ok = false;
+            break;
+        }
+        memset(&g_parallel_workers[i], 0, sizeof(g_parallel_workers[i]));
+        g_parallel_workers[i].File = worker_files[i];
+        g_parallel_workers[i].Status = STATUS_UNSUCCESSFUL;
+        KeInitializeEvent(&g_parallel_workers[i].Ready, NotificationEvent,
+                          FALSE);
+        KeInitializeEvent(&g_parallel_workers[i].Done, NotificationEvent,
+                          FALSE);
+    }
+    KeInitializeEvent(&g_parallel_start, NotificationEvent, FALSE);
+
+    for (unsigned i = 0; ok && i < 2; ++i) {
+        s = PsCreateSystemThreadEx(&threads[i], 0, 0, 0, NULL,
+                                   parallel_cache_reader,
+                                   &g_parallel_workers[i], FALSE, FALSE,
+                                   cache_test_system_routine);
+        if (!NT_SUCCESS(s))
+        {
+            test_record_failure(__FILE__, __LINE__,
+                                "create parallel worker %u -> 0x%08x",
+                                i, (unsigned)s);
+            ok = false;
+        }
+        else
+            started++;
+    }
+
+    for (unsigned i = 0; ok && i < started; ++i) {
+        s = wait_for_cache_test_event(&g_parallel_workers[i].Ready);
+        if (s != STATUS_SUCCESS) {
+            test_record_failure(__FILE__, __LINE__,
+                                "parallel worker %u readiness wait -> 0x%08x",
+                                i, (unsigned)s);
+            ok = false;
+        }
+    }
+    KeSetEvent(&g_parallel_start, 0, FALSE);
+    for (unsigned i = 0; i < started; ++i) {
+        s = wait_for_cache_test_event(&g_parallel_workers[i].Done);
+        if (s != STATUS_SUCCESS) {
+            test_record_failure(__FILE__, __LINE__,
+                                "parallel worker %u completion wait -> 0x%08x",
+                                i, (unsigned)s);
+            ok = false;
+        }
+        NtClose(threads[i]);
+    }
+
+    for (unsigned i = 0; i < 2; ++i) {
+        if (worker_files[i] != NULL)
+            NtClose(worker_files[i]);
+        if (!ok)
+            continue;
+        if (g_parallel_workers[i].Status != STATUS_SUCCESS ||
+            g_parallel_workers[i].Information != PARALLEL_READ_BYTES) {
+            test_record_failure(__FILE__, __LINE__,
+                                "parallel worker %u read -> 0x%08x len=%lu",
+                                i, (unsigned)g_parallel_workers[i].Status,
+                                (unsigned long)g_parallel_workers[i].Information);
+            ok = false;
+        } else if (!check_pattern(g_parallel_workers[i].Buffer,
+                                  PARALLEL_READ_BYTES, 0, 0x6D,
+                                  "parallel cold read")) {
+            ok = false;
+        }
+    }
+
+    unlink_path(CACHE_A);
+    return ok;
+}
