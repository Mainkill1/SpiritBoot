diff --git a/tests/host/boot-layout/README.md b/tests/host/boot-layout/README.md
new file mode 100644
index 00000000..ddbace71
--- /dev/null
+++ b/tests/host/boot-layout/README.md
@@ -0,0 +1,52 @@
+# Selected Xbox boot layout
+
+Run `python3 tests/host/boot-layout/check.py OUTPUT_DIRECTORY` from any directory.
+The fixture compiles actual loader paging, PE placement, boot descriptors,
+memory-map shape, HAL capacity/timing and warm handoff code for both
+`XBOX_RAM_MIB=64` and `128`. The scratch selection/size check uses the actual
+decompression control flow with a host decoder stub that writes the selected
+physical scratch alias. Real XZ code is compiled and linked in the loader check
+below. The actual PFN descriptor population and post-paint PT-return block
+verify ownership; the actual user-PDE clear verifies the loader identity map
+does not survive into title mappings. Flash admission checks prove oversized
+PE files/images are refused before invoking compression.
+Only physical pointer accesses use host RAM; paging-enable instructions and
+CPU descriptor setup are not executed. It also compiles and links the real
+release loader using its maintained CMake rules and checks emitted Xcodes,
+code/BSS placement, stack bounds and ROM size. Full debug BIOS builds require
+the normal build environment's 32-bit system headers.
+
+The default remains 128 MiB. These are separate artifacts, with no runtime RAM
+detector. Both retain kernel VA `0x84000000` and System PTE floor `0x84400000`.
+The physical comparison is against the prior open-source 128 MiB layout and
+the existing source's retail-shaped 52..60 MiB kernel zone, not an inspected
+proprietary firmware implementation:
+
+| Boot object | 128 MiB default | 64 MiB artifact |
+| --- | --- | --- |
+| Kernel image | 64 MiB + actual `SizeOfImage` | 52 MiB + actual `SizeOfImage` |
+| Loader/code/BSS/stack | 125..127 MiB | 56..57 MiB, permanently reserved |
+| Decompressed PE scratch | 112..120 MiB | 57..59.75 MiB, permanently reserved |
+| Bootstrap PTs | 127 MiB + 22 pages | 59.75 MiB + 22 pages, all permanently reserved |
+| Initial graphics descriptor | 60..64 MiB | 60..64 MiB |
+
+The existing graphics split later releases memory below the NV2A instance
+tail at `0x03fe0000`; this behavior is unchanged. Memory after the actual
+64 MiB image and before 56 MiB remains free for the normal NT bring-up carve.
+The temporary 56..60 MiB loader identity PSE is cleared by MM's user-PDE clear,
+after the kernel switches to its own stack.
+
+Title pages at 1 MiB and 32 MiB remain ordinary allocatable/persistent RAM;
+the existing warm-reboot guest's 32 MiB data placement is unchanged. Permanent
+bootstrap reservations prevent titles acquiring frames that the next reset
+must overwrite. Collision checks are defense in depth, not an allocation
+policy substitute. Retaining the 20 formerly reclaimed PT pages costs 80 KiB.
+The 2.75 MiB scratch bound accommodates the current release PE (432,128 bytes)
+and debug PE (649,728 bytes), and is enforced both during flash assembly and
+before runtime decompression.
+
+A distinct warm format version prevents cross-capacity restoration despite
+the identical virtual image base. Persistence across different kernel images
+is not guaranteed; actual current image descriptors reject a bitmap that
+collides with image growth. The 128 MiB handoff format and physical bootstrap
+layout remain unchanged.
diff --git a/tests/host/boot-layout/check-image-bounds.py b/tests/host/boot-layout/check-image-bounds.py
new file mode 100644
index 00000000..af141230
--- /dev/null
+++ b/tests/host/boot-layout/check-image-bounds.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise actual flash assembly admission before its compressor is called."""
+from contextlib import redirect_stdout
+import importlib.util
+import io
+from pathlib import Path
+import struct
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+sys.dont_write_bytecode = True
+spec = importlib.util.spec_from_file_location('flash', root/'boot/nxldr/gen-flash-bin.py')
+flash = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(flash)
+loader = out/'loader.bin'
+loader.write_bytes(bytes([255]) * 0x40000)
+(out/'loader.elf').write_bytes(b'fixture symbols supplied below')
+failures = 0
+checks = 0
+for capacity, scratch in ((128, 0x800000), (64, 0x2c0000)):
+    flash.read_linker_symbols = lambda *args: {
+        'KernelPayloadOffset': 0x4000, 'KernelPayloadMaxSize': 0x3be00,
+        'KernelScratchMaxSize': scratch, 'KernelImageMaxSize': 0x400000}
+    def image(file_size=0x1000, image_size=0x77000):
+        b = bytearray(file_size)
+        if file_size >= 0x100:
+            b[:2] = b'MZ'
+            struct.pack_into('<I', b, 0x3c, 0x40)
+            b[0x40:0x44] = b'PE\0\0'
+            struct.pack_into('<H', b, 0x58, 0x10b)
+            struct.pack_into('<I', b, 0x90, image_size)
+        return b
+    for label, raw, reject in (
+        ('current release', image(0x69800), False),
+        ('current debug', image(0x9ea00, 0xb8000), False),
+        ('file exceeds physical scratch', image(scratch + 1), True),
+        ('image exceeds mapped physical placement', image(image_size=0x400001), True),
+        ('zero image span', image(image_size=0), True),
+    ):
+        compressed = []
+        def compress(data):
+            compressed.append(len(data))
+            return b'fixture-compressed-data'
+        flash.xz_compress = compress
+        kernel = out/'kernel.exe'
+        kernel.write_bytes(raw)
+        sys.argv = ['gen-flash-bin.py', '--nxldr', str(loader), '--kernel', str(kernel),
+                    '--out', str(out/'flash.bin')]
+        rejected = False
+        with redirect_stdout(io.StringIO()):
+            try:
+                flash.main()
+            except SystemExit:
+                rejected = True
+        good = rejected == reject and (not compressed if reject else compressed == [len(raw)])
+        checks += 1
+        if not good:
+            failures += 1
+            print(f'FAIL {capacity}MiB: {label}, rejected={rejected}, compressor calls={len(compressed)}')
+print(f'flash admission: {checks-failures}/{checks} checks passed')
+sys.exit(bool(failures))
