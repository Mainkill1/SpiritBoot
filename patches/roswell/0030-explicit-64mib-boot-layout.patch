 #define NXBL_BOOT_LAYOUT_H
 
+#ifndef XBOX_RAM_MIB
+#define XBOX_RAM_MIB 128
+#endif
+#if XBOX_RAM_MIB != 64 && XBOX_RAM_MIB != 128
+#error XBOX_RAM_MIB must be 64 or 128
+#endif
