diff --git a/boot/nxldr/gen-flash-bin.py b/boot/nxldr/gen-flash-bin.py
index b018a613..4a3c777d 100755
--- a/boot/nxldr/gen-flash-bin.py
+++ b/boot/nxldr/gen-flash-bin.py
@@ -68,6 +68,24 @@ def xz_compress(src_bytes: bytes) -> bytes:
     return framed
 
 
+def validate_kernel_bounds(kernel: bytes, scratch_max: int, image_max: int) -> None:
+    """Refuse a PE that cannot fit the loader's physical buffers/maps."""
+    if not kernel or len(kernel) > scratch_max:
+        sys.exit("gen-flash-bin.py: kernel file is %d bytes, physical scratch limit is %d"
+                 % (len(kernel), scratch_max))
+    if len(kernel) < 0x40 or kernel[:2] != b"MZ":
+        sys.exit("gen-flash-bin.py: kernel has no PE DOS header")
+    pe = struct.unpack_from("<I", kernel, 0x3c)[0]
+    if pe > len(kernel) or len(kernel) - pe < 24 + 60 or kernel[pe:pe+4] != b"PE\0\0":
+        sys.exit("gen-flash-bin.py: kernel has no complete PE optional header")
+    if struct.unpack_from("<H", kernel, pe + 24)[0] != 0x10b:
+        sys.exit("gen-flash-bin.py: kernel is not PE32")
+    image_size = struct.unpack_from("<I", kernel, pe + 24 + 56)[0]
+    if not image_size or image_size > image_max:
+        sys.exit("gen-flash-bin.py: PE image span is %d bytes, mapped image limit is %d"
+                 % (image_size, image_max))
+
+
 def main() -> int:
     ap = argparse.ArgumentParser()
     ap.add_argument("--out", default=os.path.join(REPO, "build/flash.bin"))
@@ -106,6 +124,8 @@ def main() -> int:
     syms = read_linker_symbols(args.elf, [
         "KernelPayloadOffset",
         "KernelPayloadMaxSize",
+        "KernelScratchMaxSize",
+        "KernelImageMaxSize",
     ])
     payload_offset = syms["KernelPayloadOffset"]
     payload_max_size = syms["KernelPayloadMaxSize"]
@@ -124,6 +144,8 @@ def main() -> int:
     if args.kernel:
         kernel_raw = open(args.kernel, "rb").read()
         kernel_raw_size = len(kernel_raw)
+        validate_kernel_bounds(kernel_raw, syms["KernelScratchMaxSize"],
+                               syms["KernelImageMaxSize"])
         compressed = xz_compress(kernel_raw)
         blob = struct.pack("<III", NXKRNL_XZ_MAGIC,
                            len(compressed), kernel_raw_size) + compressed
