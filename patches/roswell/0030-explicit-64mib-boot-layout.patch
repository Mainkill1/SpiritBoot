+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile the real loader mappings, descriptor construction and persistence.
+
+Only physical dereferences in PagingInit/PeLoad use a host RAM facade. The
+production control flow, PTE values, PE parser, descriptors and warm handoff
+functions are retained. Privileged paging-enable/CPU descriptor code is not run.
+"""
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+
+
+def function(text, name):
+    start = text.index(name + '(')
+    opening = text.index('{', start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+paging = 'void ' + function((root/'boot/nxldr/paging.c').read_text(), 'PagingInit')
+paging = paging.replace('(ULONG *)PD_PA', 'host_page(PD_PA)')
+paging = paging.replace('(ULONG *)(NXBL_PT_LOW_PA + i * PAGE_SIZE)', 'host_page(NXBL_PT_LOW_PA + i * PAGE_SIZE)')
+paging = paging.replace('(ULONG *)(NXBL_PT_KSEG0_PA + i * PAGE_SIZE)', 'host_page(NXBL_PT_KSEG0_PA + i * PAGE_SIZE)')
+paging = paging.replace('((ULONG)PtId) | PTE_FLAGS', '(NXBL_PT_LOW_PA + i * PAGE_SIZE) | PTE_FLAGS')
+paging = paging.replace('((ULONG)PtKseg0) | PTE_FLAGS', '(NXBL_PT_KSEG0_PA + i * PAGE_SIZE) | PTE_FLAGS')
+paging = paging.replace('(ULONG *)NXBL_PT_PCR_PA', 'host_page(NXBL_PT_PCR_PA)')
+paging = paging.replace('(void *)NXBL_PCR_REGION_PA', 'host_page(NXBL_PCR_REGION_PA)')
+pe = (root/'boot/nxldr/pe.c').read_text()
+pe = '\n'.join(line for line in pe.splitlines() if not line.startswith('#include'))
+pe = pe.replace('memset(', 'physical_zero(').replace('memcpy(', 'physical_copy(')
+entry = (root/'ntoskrnl/xb/nxldr-entry.c').read_text()
+descriptors = entry[entry.index('    KernelPages = (KernelSize'):entry.index('    NxkMmReadPersistence(Lb);')]
+persistence = (root/'ntoskrnl/xb/mm/persistence.c').read_text()
+persistence = '\n'.join(line for line in persistence.splitlines() if not line.startswith('#include'))
+shape = 'BOOLEAN ' + function((root/'ntoskrnl/xb/mm/init.c').read_text(), 'NxkMmRetailShapedMap')
+init_source = (root/'ntoskrnl/xb/mm/init.c').read_text()
+cluster_start = init_source.index('    if (NxkIsRetailBase())', init_source.index('NxkMmEnsureXboxWindows('))
+cluster = init_source[cluster_start:]
+cluster = cluster[:cluster.index('\n    /* The loader backs all 16 pages')]
+population = function((root/'ntoskrnl/mm/ARM3/mminit.c').read_text(), 'MiInitializePfnDatabase')
+population = 'VOID ' + population[:population.index('#else')] + '\n#endif\n}\n'
+machine = (root/'ntoskrnl/mm/ARM3/i386/init.c').read_text()
+user_clear = machine[machine.index('    StartPde = MiAddressToPde(0);'):]
+user_clear = user_clear[:user_clear.index('\n\n')]
+hal = 'VOID ' + function((root/'hal/halx86/xbox/pci.c').read_text(), 'NxConfigurePciDevicesLate')
+video = (root/'hal/halx86/xbox/video/xbox-video-support.c').read_text()
+ram_global = next(line for line in video.splitlines() if line.startswith('unsigned int xbox_ram ='))
+decompress = 'static const void *' + function((root/'boot/nxldr/loader.c').read_text(), 'DecompressKernel')
+loader_types = (root/'boot/nxldr/nxldr.h').read_text()
+loader_types = loader_types[loader_types.index('#define NXKRNL_XZ_MAGIC'):loader_types.index('#endif /* NXLDR_H */')]
+
+shim = r'''
