+#define NXBL_PT_LOW_PA 0x03BC0000UL
+#define NXBL_LOADER_PA 0x03800000UL
+#define NXBL_LOADER_LIMIT_PA 0x03900000UL
+#define NXBL_SCRATCH_PA 0x03900000UL
