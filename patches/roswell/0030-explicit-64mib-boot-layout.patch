-#define NXBL_PT_KSEG0_PA 0x07F04000UL   /* NXBL_PT_KSEG0_COUNT PTs, KSEG0  */
-#define NXBL_PT_KSEG0_COUNT 17          /* PA 0..0x4400000: KSEG0 + image  */
-#define NXBL_PT_PCR_PA 0x07F15000UL     /* 1 PT for the PCR window         */
