+typedef enum {LoaderMemoryData,LoaderFree,LoaderOsloaderHeap,LoaderFirmwarePermanent,LoaderSystemCode,LoaderLoadedProgram,LoaderFirmwareTemporary,LoaderOsloaderStack} TYPE_OF_MEMORY;
