+#define NXBL_IMAGE_BYTES 0x00400000UL   /* One PT maps the kernel window */
+#define NXBL_PT_KSEG0_PA (NXBL_PT_LOW_PA + 0x4000UL)
+#define NXBL_PT_KSEG0_COUNT 17          /* Low 64 MiB alias + kernel VA */
+#define NXBL_PT_PCR_PA (NXBL_PT_LOW_PA + 0x15000UL)
 #define NXBL_PCR_REGION_PA 0x00030000UL /* 16 pages backing 0xFFDF0000..   */
