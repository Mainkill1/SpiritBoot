+typedef struct _XDVD_FORWARD_PLAN
+{
+    ULONGLONG AbsoluteOffset;
+    ULONG Length;
+} XDVD_FORWARD_PLAN, *PXDVD_FORWARD_PLAN;
+
+/* This admission helper is the C transcription of the frozen Rust request
+ * model. It performs no allocation, mapping, I/O, wait, or state mutation. */
+static BOOLEAN
+XdvdPlanForwardRead(_In_ PIRP Irp,
+                    _In_ PXDVD_FCB Fcb,
+                    _In_ PIO_STACK_LOCATION Sp,
+                    _Out_ PXDVD_FORWARD_PLAN Plan)
+{
+    LONGLONG signedOffset = Sp->Parameters.Read.ByteOffset.QuadPart;
+    ULONGLONG fileOffset;
+    ULONGLONG requested = Sp->Parameters.Read.Length;
+    ULONGLONG effective;
+    ULONGLONG fileBase;
+    ULONGLONG absoluteOffset;
+    PMDL mdl;
+    ULONGLONG described;
+    ULONGLONG pages;
+    ULONGLONG requiredSize;
+    ULONG_PTR dataAddress;
+
+    if (signedOffset < 0)
+        return FALSE;
+    fileOffset = (ULONGLONG)signedOffset;
+    if (requested == 0 || fileOffset >= Fcb->DataSize)
+        return FALSE;
+
+    effective = requested;
+    if (effective > (ULONGLONG)Fcb->DataSize - fileOffset)
+        effective = (ULONGLONG)Fcb->DataSize - fileOffset;
+
+    fileBase = (ULONGLONG)Fcb->DataSector << XDVD_SECTOR_SHIFT;
+    absoluteOffset = fileBase + fileOffset;
+    if (absoluteOffset < fileBase ||
+        absoluteOffset + effective < absoluteOffset)
+        return FALSE;
+    if ((absoluteOffset & (XDVD_SECTOR_SIZE - 1)) != 0 ||
+        (effective & (XDVD_SECTOR_SIZE - 1)) != 0)
+        return FALSE;
+    if ((Irp->Flags & (IRP_PAGING_IO | IRP_ASSOCIATED_IRP)) != 0 ||
+        Irp->CurrentLocation <= 1)
+        return FALSE;
+
+    mdl = Irp->MdlAddress;
+    if (mdl == NULL || mdl->Next != NULL)
+        return FALSE;
+    if ((mdl->MdlFlags &
+         (MDL_PAGES_LOCKED | MDL_SOURCE_IS_NONPAGED_POOL)) == 0)
+        return FALSE;
+
+    described = (ULONGLONG)mdl->ByteOffset + mdl->ByteCount;
+    pages = (described + PAGE_SIZE - 1) >> PAGE_SHIFT;
+    requiredSize = sizeof(MDL) + pages * sizeof(PFN_NUMBER);
+    if ((ULONGLONG)(USHORT)mdl->Size < requiredSize ||
+        (ULONGLONG)mdl->ByteCount < effective)
+        return FALSE;
+
+    if ((mdl->MdlFlags &
+         (MDL_MAPPED_TO_SYSTEM_VA | MDL_SOURCE_IS_NONPAGED_POOL)) != 0)
+        dataAddress = (ULONG_PTR)mdl->MappedSystemVa;
+    else
+        dataAddress = (ULONG_PTR)mdl->StartVa + mdl->ByteOffset;
+    if ((ULONGLONG)dataAddress + effective < (ULONGLONG)dataAddress ||
+        (dataAddress & Fcb->Vcb->TargetDevice->AlignmentRequirement) != 0)
+        return FALSE;
+
+    Plan->AbsoluteOffset = absoluteOffset;
+    Plan->Length = (ULONG)effective;
+    return TRUE;
+}
+
+static NTSTATUS NTAPI
+XdvdForwardReadComplete(_In_ PDEVICE_OBJECT DeviceObject,
+                        _Inout_ PIRP Irp,
+                        _In_ PVOID Context)
+{
+    PFILE_OBJECT fo = Context;
+    PIO_STACK_LOCATION sp = IoGetCurrentIrpStackLocation(Irp);
+    ULONG expected = sp->Parameters.Read.Length;
+
+    UNREFERENCED_PARAMETER(DeviceObject);
+    if (Irp->PendingReturned)
+        IoMarkIrpPending(Irp);
+
+    if (Irp->Cancel)
+    {
+        Irp->IoStatus.Status = STATUS_CANCELLED;
+        Irp->IoStatus.Information = 0;
+    }
+    else if (!NT_SUCCESS(Irp->IoStatus.Status))
+    {
+        Irp->IoStatus.Information = 0;
+    }
+    else if (Irp->IoStatus.Information < expected)
+    {
+        Irp->IoStatus.Status = STATUS_END_OF_FILE;
+        Irp->IoStatus.Information = 0;
+    }
+    else if (Irp->IoStatus.Information > expected)
+    {
+        Irp->IoStatus.Status = STATUS_DEVICE_PROTOCOL_ERROR;
+        Irp->IoStatus.Information = 0;
+    }
+    else
+    {
+        fo->CurrentByteOffset.QuadPart =
+            sp->Parameters.Read.ByteOffset.QuadPart + expected;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+XdvdForwardRead(_In_ PIRP Irp,
+                _In_ PXDVD_FCB Fcb,
+                _Inout_ PIO_STACK_LOCATION Sp,
+                _In_ const XDVD_FORWARD_PLAN *Plan)
+{
+    PIO_STACK_LOCATION lower;
+    BOOLEAN asynchronous = !(Sp->FileObject->Flags & FO_SYNCHRONOUS_IO);
+    NTSTATUS status;
+
+    /* Retain the effective length in our stack location for completion. */
+    Sp->Parameters.Read.Length = Plan->Length;
+    IoCopyCurrentIrpStackLocationToNext(Irp);
+    lower = IoGetNextIrpStackLocation(Irp);
+    lower->Parameters.Read.ByteOffset.QuadPart = (LONGLONG)Plan->AbsoluteOffset;
+    lower->Parameters.Read.Length = Plan->Length;
+    lower->FileObject = NULL;
+    IoSetCompletionRoutine(Irp, XdvdForwardReadComplete, Sp->FileObject,
+                           TRUE, TRUE, TRUE);
+
+    if (asynchronous)
+        IoMarkIrpPending(Irp);
+    status = IoCallDriver(Fcb->Vcb->TargetDevice, Irp);
+    return asynchronous ? STATUS_PENDING : status;
+}
 
