@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production direct-forward admission and completion path."""
+from pathlib import Path
+import sys, importlib.util, subprocess
+
+root=Path(sys.argv[2]).resolve(); out=Path(sys.argv[1]); out.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('extract',root/'tests/host/kernel-performance/check.py')
+extract=importlib.util.module_from_spec(spec); spec.loader.exec_module(extract)
+source=(root/'drivers/filesystems/xdvdfs/xdvdfs.c').read_text()
+shim=r'''
+#include <stdint.h>
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+#define _In_
+#define _Inout_
+#define _Out_
+#define NTAPI
+#define UNREFERENCED_PARAMETER(x) (void)(x)
+#define STATUS_SUCCESS 0
+#define STATUS_PENDING 0x103
+#define STATUS_INSUFFICIENT_RESOURCES ((int32_t)0xc000009a)
+#define STATUS_END_OF_FILE ((int32_t)0xc0000011)
+#define STATUS_DEVICE_PROTOCOL_ERROR ((int32_t)0xc0000186)
+#define STATUS_CANCELLED ((int32_t)0xc0000120)
+#define NT_SUCCESS(s) ((s)>=0)
+#define FO_SYNCHRONOUS_IO 2
+#define XDVD_SECTOR_SIZE 2048u
+#define XDVD_SECTOR_SHIFT 11
+#define TRUE 1
+#define FALSE 0
+#define IRP_NOCACHE 1
+#define IRP_PAGING_IO 2
+#define IRP_ASSOCIATED_IRP 8
+#define MDL_MAPPED_TO_SYSTEM_VA 1
+#define MDL_PAGES_LOCKED 2
+#define MDL_SOURCE_IS_NONPAGED_POOL 4
+#define PAGE_SIZE 4096
+#define PAGE_SHIFT 12
+typedef uint8_t BOOLEAN; typedef uint16_t USHORT; typedef int16_t CSHORT;
+typedef uint64_t ULONGLONG; typedef int64_t LONGLONG; typedef uint32_t ULONG;
+typedef uintptr_t ULONG_PTR; typedef int32_t NTSTATUS; typedef void *PVOID;
+typedef struct {int64_t QuadPart;} LARGE_INTEGER;
+typedef struct _DEVICE_OBJECT {ULONG AlignmentRequirement;} DEVICE_OBJECT,*PDEVICE_OBJECT;
+typedef struct _MDL {struct _MDL *Next; CSHORT Size,MdlFlags; void *Process,*MappedSystemVa,*StartVa; ULONG ByteCount,ByteOffset;} MDL,*PMDL;
+typedef ULONG PFN_NUMBER;
+typedef struct {PDEVICE_OBJECT TargetDevice;} VCB;
+typedef struct {VCB *Vcb; ULONG DataSector,DataSize; int IsDirectory;} FCB,*PXDVD_FCB;
+typedef struct _XDVD_FORWARD_PLAN {ULONGLONG AbsoluteOffset;ULONG Length;} XDVD_FORWARD_PLAN,*PXDVD_FORWARD_PLAN;
+typedef struct {void *FsContext; LARGE_INTEGER CurrentByteOffset; ULONG Flags;} FO,*PFILE_OBJECT;
+typedef struct _IRP IRP,*PIRP;
+typedef NTSTATUS (*PIO_COMPLETION_ROUTINE)(PDEVICE_OBJECT,PIRP,PVOID);
+typedef struct {PFILE_OBJECT FileObject; struct {struct {LARGE_INTEGER ByteOffset;ULONG Length;} Read;} Parameters; PIO_COMPLETION_ROUTINE CompletionRoutine; PVOID Context;} STACK,*PIO_STACK_LOCATION;
+struct _IRP {STACK Stacks[2]; PIO_STACK_LOCATION CurrentStackLocation; struct {NTSTATUS Status;ULONG_PTR Information;} IoStatus; PMDL MdlAddress; ULONG Flags; int CurrentLocation,PendingReturned,Cancel;};
+static unsigned pendingCalls,lowerCalls;
+static NTSTATUS lowerStatus;
+static PIO_STACK_LOCATION IoGetCurrentIrpStackLocation(PIRP p){return p->CurrentStackLocation;}
+static PIO_STACK_LOCATION IoGetNextIrpStackLocation(PIRP p){return p->CurrentStackLocation-1;}
+static void IoCopyCurrentIrpStackLocationToNext(PIRP p){*IoGetNextIrpStackLocation(p)=*IoGetCurrentIrpStackLocation(p);IoGetNextIrpStackLocation(p)->CompletionRoutine=0;IoGetNextIrpStackLocation(p)->Context=0;}
+static void IoSetCompletionRoutine(PIRP p,PIO_COMPLETION_ROUTINE f,PVOID c,int a,int b,int d){(void)a;(void)b;(void)d;IoGetNextIrpStackLocation(p)->CompletionRoutine=f;IoGetNextIrpStackLocation(p)->Context=c;}
+static void IoMarkIrpPending(PIRP p){p->PendingReturned=1;pendingCalls++;}
+static NTSTATUS IoCallDriver(PDEVICE_OBJECT d,PIRP p){(void)d;(void)p;lowerCalls++;return lowerStatus;}
+'''
+names=('XdvdPlanForwardRead','XdvdForwardReadComplete','XdvdForwardRead')
+functions=''.join(extract.function(source,name) for name in names)
+tests=r'''
+static unsigned checks,failures;
+#define CHECK(x) do{checks++;if(!(x)){printf("FAIL line %d: %s\n",__LINE__,#x);failures++;}}while(0)
+static void init(PIRP i,PFILE_OBJECT fo,PXDVD_FCB f,VCB *v,PDEVICE_OBJECT d,PMDL m){
+ memset(i,0,sizeof(*i));memset(fo,0,sizeof(*fo));memset(f,0,sizeof(*f));memset(m,0,sizeof(*m));
+ v->TargetDevice=d;f->Vcb=v;f->DataSector=100;f->DataSize=32768;fo->FsContext=f;
+ i->CurrentStackLocation=&i->Stacks[1];i->CurrentLocation=2;i->MdlAddress=m;i->Flags=IRP_NOCACHE;
+ i->Stacks[1].FileObject=fo;i->Stacks[1].Parameters.Read.Length=4096;i->Stacks[1].Parameters.Read.ByteOffset.QuadPart=0;
+ m->MdlFlags=MDL_PAGES_LOCKED|MDL_MAPPED_TO_SYSTEM_VA;m->MappedSystemVa=(void*)0x10000;m->StartVa=(void*)0x10000;m->ByteCount=4096;m->Size=sizeof(*m)+sizeof(PFN_NUMBER);
+}
+static void plan_cases(void){
+ IRP i;FO fo;FCB f;VCB v;DEVICE_OBJECT d={3};MDL m,chain;XDVD_FORWARD_PLAN p;
+ init(&i,&fo,&f,&v,&d,&m);CHECK(XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p)&&p.AbsoluteOffset==((ULONGLONG)100<<11)&&p.Length==4096);
+ i.Stacks[1].Parameters.Read.ByteOffset.QuadPart=-1;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);i.Stacks[1].Parameters.Read.ByteOffset.QuadPart=1;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);i.Stacks[1].Parameters.Read.Length=2049;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);i.Flags|=IRP_PAGING_IO;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);i.Flags|=IRP_ASSOCIATED_IRP;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);i.CurrentLocation=1;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);i.MdlAddress=0;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);m.Next=&chain;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);m.MdlFlags=MDL_MAPPED_TO_SYSTEM_VA;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);m.Size=sizeof(m);CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);m.ByteCount=2048;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);m.MappedSystemVa=(void*)0x10001;CHECK(!XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));
+ init(&i,&fo,&f,&v,&d,&m);f.DataSize=4096;i.Stacks[1].Parameters.Read.Length=8192;m.ByteCount=8192;m.Size=sizeof(m)+2*sizeof(PFN_NUMBER);CHECK(XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p)&&p.Length==4096);
+}
+static void completion_cases(void){
+ IRP i;FO fo;FCB f;VCB v;DEVICE_OBJECT d={3};MDL m;
+ init(&i,&fo,&f,&v,&d,&m);i.Stacks[1].Parameters.Read.ByteOffset.QuadPart=2048;i.IoStatus.Status=0;i.IoStatus.Information=4096;i.PendingReturned=1;pendingCalls=0;CHECK(XdvdForwardReadComplete(0,&i,&fo)==0&&fo.CurrentByteOffset.QuadPart==6144&&i.IoStatus.Information==4096&&pendingCalls==1);
+ init(&i,&fo,&f,&v,&d,&m);i.IoStatus.Status=0;i.IoStatus.Information=2048;CHECK(XdvdForwardReadComplete(0,&i,&fo)==0&&i.IoStatus.Status==STATUS_END_OF_FILE&&i.IoStatus.Information==0&&fo.CurrentByteOffset.QuadPart==0);
+ init(&i,&fo,&f,&v,&d,&m);i.IoStatus.Status=0;i.IoStatus.Information=8192;CHECK(XdvdForwardReadComplete(0,&i,&fo)==0&&i.IoStatus.Status==STATUS_DEVICE_PROTOCOL_ERROR&&i.IoStatus.Information==0);
+ init(&i,&fo,&f,&v,&d,&m);i.IoStatus.Status=STATUS_INSUFFICIENT_RESOURCES;i.IoStatus.Information=9;CHECK(XdvdForwardReadComplete(0,&i,&fo)==0&&i.IoStatus.Information==0);
+ init(&i,&fo,&f,&v,&d,&m);i.IoStatus.Status=0;i.IoStatus.Information=4096;i.Cancel=1;CHECK(XdvdForwardReadComplete(0,&i,&fo)==0&&i.IoStatus.Status==STATUS_CANCELLED&&i.IoStatus.Information==0);
+}
+static void forwarding_cases(void){
+ IRP i;FO fo;FCB f;VCB v;DEVICE_OBJECT d={3};MDL m;XDVD_FORWARD_PLAN p;
+ init(&i,&fo,&f,&v,&d,&m);CHECK(XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));pendingCalls=lowerCalls=0;lowerStatus=STATUS_PENDING;CHECK(XdvdForwardRead(&i,&f,&i.Stacks[1],&p)==STATUS_PENDING);CHECK(lowerCalls==1&&pendingCalls==1);CHECK(i.Stacks[0].Parameters.Read.ByteOffset.QuadPart==((LONGLONG)100<<11)&&i.Stacks[0].Parameters.Read.Length==4096&&i.Stacks[0].FileObject==0&&i.Stacks[0].CompletionRoutine==XdvdForwardReadComplete&&i.Stacks[0].Context==&fo);
+ init(&i,&fo,&f,&v,&d,&m);fo.Flags=FO_SYNCHRONOUS_IO;CHECK(XdvdPlanForwardRead(&i,&f,&i.Stacks[1],&p));pendingCalls=lowerCalls=0;lowerStatus=STATUS_SUCCESS;CHECK(XdvdForwardRead(&i,&f,&i.Stacks[1],&p)==STATUS_SUCCESS&&lowerCalls==1&&pendingCalls==0);
+}
+int main(void){plan_cases();completion_cases();forwarding_cases();printf("%u forwarding checks, %u failures\n",checks,failures);return failures?1:0;}
+'''
+(out/'forward.c').write_text(shim+functions+tests)
+subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-fsanitize=address,undefined',str(out/'forward.c'),'-o',str(out/'forward')],check=True)
+subprocess.run([str(out/'forward')],check=True)
