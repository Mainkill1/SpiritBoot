+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NX_STORAGE_PORT_BINDING_H
+#define NX_STORAGE_PORT_BINDING_H
+#include "request.h"
+
+/* One native implementation, with a separate context for every device.
+ * These are internal class-driver symbols, not kernel exports. */
+void nx_native_port_enter(void *);
+void nx_native_port_leave(void *);
+nx_status nx_native_port_prepare(void *, const nx_command *);
+int nx_native_port_submit(void *, const nx_command *);
+void nx_native_port_retire(void *, const nx_command *);
+void nx_native_port_cancel(void *, const nx_command *);
+void nx_native_port_mark_pending(void *, void *);
+void nx_native_port_complete(void *, void *, nx_status, uint64_t);
+
+#ifdef NX_NATIVE_PORT_BINDING
+#define NX_PORT_CALL(device, member) nx_native_port_##member
+#define NX_PORT_INLINE inline __attribute__((always_inline))
+static inline int nx_native_port_matches(const nx_port *p)
+{
+    return p->enter==nx_native_port_enter && p->leave==nx_native_port_leave &&
+        p->prepare==nx_native_port_prepare && p->submit==nx_native_port_submit &&
+        p->retire==nx_native_port_retire && p->cancel==nx_native_port_cancel &&
+        p->mark_pending==nx_native_port_mark_pending && p->complete==nx_native_port_complete;
+}
+#else
+#define NX_PORT_CALL(device, member) ((device)->port.member)
+#define NX_PORT_INLINE
+#endif
+#endif
