+{ (void)context;(void)parent;(void)status;(void)bytes; }
+static int binding_rejects_foreign_tables_before_mutation(void)
+{
+    nx_config config={512,4096,4096,2,0,256,1u<<20,0,NX_CACHE_ENABLED};
+    unsigned context=17;nx_device device;nx_slot slots[2];
+    nx_port native={&context,nx_native_port_enter,nx_native_port_leave,
