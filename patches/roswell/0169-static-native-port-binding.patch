+        nx_native_port_cancel,nx_native_port_mark_pending,nx_native_port_complete};
+    CHECK(nx_device_init(&device,&config,&native,slots,2,sizeof(slots))==NX_OK);
+    CHECK(device.port.context==&context&&device.slots==slots);
