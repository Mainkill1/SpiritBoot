diff --git a/tests/host/nxstorage/check_port_binding.py b/tests/host/nxstorage/check_port_binding.py
new file mode 100644
index 0000000..d506ebe
--- /dev/null
+++ b/tests/host/nxstorage/check_port_binding.py
@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Require the bound production engine to use direct native port calls."""
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+source = root / 'drivers/storage/class/nxstorage'
+output = Path(sys.argv[1]).resolve()
+output.mkdir(parents=True, exist_ok=True)
+cc = os.environ.get('CC', 'clang')
+target = ['-target', 'i386-none-elf'] if Path(cc).name.startswith('clang') else ['-m32']
+for mode in ('runtime', 'bound'):
+    obj = output / (mode + '.i386.o')
+    flags = ['-DNX_NATIVE_PORT_BINDING=1'] if mode == 'bound' else []
+    subprocess.run([cc] + target + ['-std=c11', '-Os', '-ffreestanding', '-fno-builtin',
+                   '-fno-pic', '-fno-pie', '-fno-stack-protector',
+                   '-fno-optimize-sibling-calls', '-fno-omit-frame-pointer',
+                   '-DNX_NATIVE_TARGET=1', '-I' + str(source)] + flags +
+                   ['-c', str(source / 'request.c'), '-o', str(obj)], check=True)
+    assembly = subprocess.check_output(['objdump', '-dr', str(obj)], text=True)
+    (output / (mode + '.disasm.txt')).write_text(assembly)
+    indirect = len(re.findall(r'\b(?:call|jmp)\s+\*', assembly))
+    print(f'{mode}: {indirect} indirect engine call/jump sites', flush=True)
+    if mode == 'bound' and indirect:
+        raise SystemExit('bound engine still contains runtime port dispatch')
+    if mode == 'runtime' and not indirect:
+        raise SystemExit('runtime control did not exercise callback dispatch')
+    if mode == 'bound':
+        undefined = subprocess.check_output(['nm', '-u', str(obj)], text=True)
+        names = {line.split()[-1].lstrip('_') for line in undefined.splitlines()}
+        expected = {'nx_native_port_' + name for name in
+                    ('enter', 'leave', 'prepare', 'submit', 'retire', 'cancel', 'mark_pending', 'complete')}
+        if names != expected:
+            raise SystemExit('unexpected native binding imports: ' + repr(names))
+        if re.search(r'<_?(?:lock|unlock)>:', assembly):
+            raise SystemExit('bound engine retained lock/unlock forwarding wrappers')
+print('native binding: direct calls, no forwarding wrappers or compiler helpers')
