@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production deferred cache-map finalizer."""
+
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location(
+    "extract", root / "tests/host/kernel-performance/check.py")
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+source = (root / "ntoskrnl/xb/mm/cache.c").read_text()
+body = extract.function(source, "NxcTryFinalizeMapLocked")
+uninitialize = extract.function(source, "CcUninitializeCacheMap")
+assert "FlushStatus = NxcFlushMap" in uninitialize
+assert "Result = FALSE" in uninitialize
+assert "NxcFlushMap(Map, 0, MAXLONGLONG, TRUE" not in uninitialize
+
+shim = r'''
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef unsigned int ULONG;
+typedef int BOOLEAN;
+typedef void VOID;
+#define IN
+#define TRUE 1
+#define FALSE 0
+#define NXC_TOTAL_BLOCKS 2
+#define NXC_TAG 0
+#define IO_NO_INCREMENT 0
+#define ASSERT assert
+
+typedef struct _LIST_ENTRY {
+    struct _LIST_ENTRY *Flink;
+    struct _LIST_ENTRY *Blink;
+} LIST_ENTRY;
+typedef struct { int signaled; } EVENT;
+typedef struct { EVENT Event; } CACHE_UNINITIALIZE_EVENT,
+    *PCACHE_UNINITIALIZE_EVENT;
+typedef struct _SECTION_OBJECT_POINTERS {
+    void *SharedCacheMap;
+} SECTION_OBJECT_POINTERS;
+typedef struct _FILE_OBJECT {
+    SECTION_OBJECT_POINTERS *SectionObjectPointer;
+} FILE_OBJECT, *PFILE_OBJECT;
+typedef struct _NXC_MAP {
+    ULONG OpenCount;
+    BOOLEAN UninitializePending;
+    PCACHE_UNINITIALIZE_EVENT UninitializeCompleteEvent;
+    PFILE_OBJECT FileObject;
+    LIST_ENTRY MapLinks;
+    LIST_ENTRY PrivateList;
+} NXC_MAP;
+typedef struct _NXC_BLOCK {
+    NXC_MAP *Map;
+    unsigned char *Data;
+    ULONG RefCount;
+    BOOLEAN Valid;
+    BOOLEAN Dirty;
+    BOOLEAN Busy;
+    LIST_ENTRY LruLink;
+} NXC_BLOCK;
+
+static NXC_BLOCK NxcBlocks[NXC_TOTAL_BLOCKS];
+static int NxcMutex, held, freed, dereferenced;
+
+static int IsListEmpty(const LIST_ENTRY *head)
+{
+    return head->Flink == head;
+}
+static void RemoveEntryList(LIST_ENTRY *entry)
+{
+    entry->Blink->Flink = entry->Flink;
+    entry->Flink->Blink = entry->Blink;
+}
+static void ExFreePoolWithTag(void *pointer, int tag)
+{
+    (void)pointer;
+    (void)tag;
+    assert(held);
+    ++freed;
+}
+static void ExReleaseFastMutex(int *mutex)
+{
+    (void)mutex;
+    assert(held);
+    held = 0;
+}
+static void ExAcquireFastMutex(int *mutex)
+{
+    (void)mutex;
+    assert(!held);
+    held = 1;
+}
+static void KeSetEvent(EVENT *event, int increment, int wait)
+{
+    (void)increment;
+    (void)wait;
+    assert(!held);
+    event->signaled = 1;
+}
+static void ObDereferenceObject(PFILE_OBJECT file)
+{
+    (void)file;
+    assert(!held);
+    ++dereferenced;
+}
+'''
+
+cases = r'''
+static LIST_ENTRY map_list;
+static SECTION_OBJECT_POINTERS section;
+static FILE_OBJECT file;
+static CACHE_UNINITIALIZE_EVENT complete;
+static NXC_MAP map;
+static unsigned char data[NXC_TOTAL_BLOCKS];
+
+static void link_tail(LIST_ENTRY *head, LIST_ENTRY *entry)
+{
+    entry->Blink = head->Blink;
+    entry->Flink = head;
+    head->Blink->Flink = entry;
+    head->Blink = entry;
+}
+
+static void setup(void)
+{
+    memset(&map, 0, sizeof(map));
+    memset(NxcBlocks, 0, sizeof(NxcBlocks));
+    memset(&complete, 0, sizeof(complete));
+    map_list.Flink = map_list.Blink = &map_list;
+    map.PrivateList.Flink = map.PrivateList.Blink = &map.PrivateList;
+    link_tail(&map_list, &map.MapLinks);
+    section.SharedCacheMap = &map;
+    file.SectionObjectPointer = &section;
+    map.FileObject = &file;
+    map.UninitializePending = TRUE;
+    map.UninitializeCompleteEvent = &complete;
+    for (unsigned i = 0; i < NXC_TOTAL_BLOCKS; ++i) {
+        NxcBlocks[i].Map = &map;
+        NxcBlocks[i].Data = &data[i];
+        NxcBlocks[i].Valid = TRUE;
+        NxcBlocks[i].LruLink.Flink = NxcBlocks[i].LruLink.Blink =
+            &NxcBlocks[i].LruLink;
+    }
+    held = 1;
+    freed = dereferenced = 0;
+}
+
+static void retained(void)
+{
+    assert(section.SharedCacheMap == &map);
+    assert(freed == 0 && dereferenced == 0 && held);
+    assert(!complete.Event.signaled);
+    for (unsigned i = 0; i < NXC_TOTAL_BLOCKS; ++i)
+        assert(NxcBlocks[i].Map == &map && NxcBlocks[i].Valid);
+}
+
+int main(void)
+{
+    setup();
+    map.UninitializePending = FALSE;
+    assert(!NxcTryFinalizeMapLocked(&map));
+    retained();
+
+    setup();
+    map.OpenCount = 1;
+    assert(!NxcTryFinalizeMapLocked(&map));
+    retained();
+
+    setup();
+    NxcBlocks[0].Dirty = TRUE;
+    assert(!NxcTryFinalizeMapLocked(&map));
+    retained();
+
+    setup();
+    NxcBlocks[0].RefCount = 1;
+    assert(!NxcTryFinalizeMapLocked(&map));
+    retained();
+
+    setup();
+    NxcBlocks[0].Busy = TRUE;
+    assert(!NxcTryFinalizeMapLocked(&map));
+    retained();
+
+    setup();
+    assert(NxcTryFinalizeMapLocked(&map));
+    assert(section.SharedCacheMap == NULL);
+    assert(freed == 1 && dereferenced == 1 && held);
+    assert(complete.Event.signaled);
+    assert(map_list.Flink == &map_list && map_list.Blink == &map_list);
+    for (unsigned i = 0; i < NXC_TOTAL_BLOCKS; ++i)
+        assert(NxcBlocks[i].Map == NULL && !NxcBlocks[i].Valid &&
+               !NxcBlocks[i].Dirty);
+
+    puts("cache map lifetime: failed/active maps retained; clean idle map finalized PASS");
+    return 0;
+}
