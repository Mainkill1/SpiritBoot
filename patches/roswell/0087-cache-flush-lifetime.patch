 tests/host/cache/check-flush-lifetime.py | 251 +++++++++++++++++++++++
 tests/host/cache/check-map-lifetime.py   | 218 ++++++++++++++++++++
 tests/host/cache/check-pin-arguments.py  |   1 +
 tests/host/cache/check-pin-reuse.py      |   1 +
 tests/host/metadata/check.py             |   1 +
