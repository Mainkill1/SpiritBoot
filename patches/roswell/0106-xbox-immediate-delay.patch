+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Run actual immediate-delay scheduler code against the public priority oracle.
+The harness models only scheduler queue/locking services, not the policy being
+checked. Firmware probes separately exercise the full wait/APC/IRQL paths.
+"""
+from pathlib import Path
+import subprocess, sys
+root=Path(sys.argv[2]).resolve()
+root.mkdir(parents=True,exist_ok=True)
+source=Path(sys.argv[1]); wait=(source/'ntoskrnl/ke/wait.c').read_text(); sched=(source/'ntoskrnl/ke/thrdschd.c').read_text(); ke=(source/'ntoskrnl/include/internal/ke_x.h').read_text()
+def function(text,name):
+    start=text.index(name+'('); start=text.rfind('\n',0,start)+1; brace=text.index('{',start); depth=1; end=brace+1
+    while depth:
+        depth += (text[end]=='{')-(text[end]=='}');end+=1
+    return text[start:end]
+helper='static void\n'+function(wait,'KiFinishXboxImmediateDelay') if 'KiFinishXboxImmediateDelay(' in wait else ''
+nowait=wait[wait.index('NoWait:',wait.index('KeDelayExecutionThread(')):wait.index('\n}\n',wait.index('NoWait:',wait.index('KeDelayExecutionThread(')))]
+prefix=r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define IN
+#define VOID void
+#define NTAPI
+#define ASSERT assert
+#define TRUE 1
+#define FALSE 0
+#define STATUS_SUCCESS 0
+#define STATUS_NO_YIELD_PERFORMED ((int32_t)0x40000024)
+#define LOW_REALTIME_PRIORITY 16
+#define APC_LEVEL 1
+#define DISPATCH_LEVEL 2
+#define SYNCH_LEVEL 2
+#define Running 2
+#define Standby 3
+#define WrYieldExecution 7
+typedef int NTSTATUS, KIRQL, KPRIORITY, BOOLEAN, SCHAR;
+typedef struct Thread {int Priority,BasePriority,PriorityDecrement,Quantum,QuantumReset,WaitIrql,WaitReason,State,Preempted;} KTHREAD,*PKTHREAD;
+typedef struct Prcb {unsigned ReadySummary;PKTHREAD CurrentThread,NextThread;} KPRCB,*PKPRCB;
+typedef struct {int64_t QuadPart;} LARGE_INTEGER;
+static KTHREAD current,ready,standby;
+static KPRCB prcb;
+static int irql,thread_lock,prcb_lock,dispatcher_lock,swaps,dequeues,minimum,requests;
+static PKPRCB KeGetCurrentPrcb(void){return &prcb;}
+static PKTHREAD KeGetCurrentThread(void){return &current;}
+static unsigned KiGetCurrentReadySummary(void){return prcb.ReadySummary;}
+static KIRQL KeRaiseIrqlToSynchLevel(void){int old=irql;irql=SYNCH_LEVEL;return old;}
+static void KeLowerIrql(KIRQL level){irql=level;}
+static void KiAcquireThreadLock(PKTHREAD t){(void)t;assert(irql==SYNCH_LEVEL && !thread_lock++);}
+static void KiAcquirePrcbLock(PKPRCB p){(void)p;assert(irql==SYNCH_LEVEL && !prcb_lock++);}
+static void KiReleaseThreadLock(PKTHREAD t){(void)t;assert(thread_lock--==1);}
+static void KiReleasePrcbLock(PKPRCB p){(void)p;assert(prcb_lock--==1);}
+static PKTHREAD KiSelectReadyThread(KPRIORITY min,PKPRCB p){
+ assert(thread_lock && prcb_lock);minimum=min;dequeues++;
+ if(p->ReadySummary && ready.Priority>=min){p->ReadySummary=0;return &ready;}return NULL;
+}
+static void KiSetThreadSwapBusy(PKTHREAD t){(void)t;}
+static void KxQueueReadyThread(PKTHREAD t,PKPRCB p){(void)t;KiReleasePrcbLock(p);}
+static void KiSwapContext(KIRQL level,PKTHREAD t){(void)level;(void)t;swaps++;}
+static void KiExitDispatcher(KIRQL old){
+ assert(irql==SYNCH_LEVEL && !dispatcher_lock && !thread_lock && !prcb_lock);
+ if(prcb.NextThread){if(old>=DISPATCH_LEVEL)requests++;else{prcb.CurrentThread=prcb.NextThread;prcb.NextThread=NULL;swaps++;}}
+ irql=old;
+}
+static void KiReleaseDispatcherLockFromSynchLevel(void){assert(dispatcher_lock--==1 && irql==SYNCH_LEVEL);}
+static void KiReleaseDispatcherLock(KIRQL old){KiReleaseDispatcherLockFromSynchLevel();KiExitDispatcher(old);}
+'''
+body='static SCHAR\n'+function(ke,'KiComputeNewPriority')+'\nstatic void\n'+function(sched,'KiAdjustQuantumThread')+'\nstatic NTSTATUS\n'+function(sched,'NtYieldExecution')+'\n'+helper+'\nstatic NTSTATUS immediate(int expired){\n PKTHREAD Thread=&current;LARGE_INTEGER value={expired},*Interval=&value; (void)Interval; goto NoWait;\n'+nowait+'\n}\n'
+suffix=r'''
+static int checks,failures;
+static void check(int pass,const char *label,int pri,int base,int peer,int selected,int expired,int level){
+ checks++;if(!pass){failures++;printf("FAIL %s pri=%d base=%d peer=%d selected=%d expired=%d irql=%d\n",label,pri,base,peer,selected,expired,level);}
+}
+static void run(int pri,int base,int peer,int selected,int expired,int level){
+ memset(&current,0,sizeof(current));memset(&ready,0,sizeof(ready));memset(&standby,0,sizeof(standby));memset(&prcb,0,sizeof(prcb));
+ current.Priority=pri;current.BasePriority=base;current.PriorityDecrement=pri<16?1:0;current.Quantum=17;current.QuantumReset=60;current.WaitIrql=level;current.Preempted=1;
+ ready.Priority=peer;standby.Priority=selected;standby.State=Standby;prcb.CurrentThread=&current;prcb.NextThread=selected?&standby:NULL;prcb.ReadySummary=peer?1u<<peer:0;
+ irql=SYNCH_LEVEL;dispatcher_lock=1;thread_lock=prcb_lock=swaps=dequeues=requests=0;minimum=-1;
+ int priority=pri<16?base:pri,chosen=selected || (peer && peer>=priority);
+ NTSTATUS status=immediate(expired);
+ #define CHECK(v,s) check((v),(s),pri,base,peer,selected,expired,level)
+ CHECK(status==STATUS_SUCCESS,"successful immediate completion");
+ CHECK(current.Priority==priority,"dynamic reset / real-time preserve");
+ CHECK(current.PriorityDecrement==0,"boost bookkeeping cleared");
+ CHECK(current.Quantum==(chosen?60:17),"quantum reset only with handoff");
+ CHECK(swaps==(chosen && level<DISPATCH_LEVEL),"handoff dispatched below DISPATCH");
+ CHECK(requests==(chosen && level>=DISPATCH_LEVEL),"handoff deferred at DISPATCH");
+ CHECK(irql==level && !dispatcher_lock && !thread_lock && !prcb_lock,"lock and IRQL restoration");
+ if(selected){CHECK(!dequeues,"committed standby does not dequeue second thread");CHECK(level>=DISPATCH_LEVEL?prcb.NextThread==&standby:prcb.CurrentThread==&standby,"committed standby pointer preserved");}
+ else CHECK(minimum==priority,"post-adjustment selection threshold");
+ #undef CHECK
+}
+int main(void){
+ const int cases[][2]={{6,8},{8,8},{10,8},{15,8},{8,6},{12,10},{15,15},{16,8},{20,8},{31,8}};
+ const int peers[]={0,5,6,7,8,9,10,14,15,16,20,31};
+ for(unsigned c=0;c<sizeof(cases)/sizeof(cases[0]);c++)for(unsigned p=0;p<sizeof(peers)/sizeof(peers[0]);p++)for(int expired=0;expired<2;expired++)for(int level=0;level<3;level++)run(cases[c][0],cases[c][1],peers[p],0,expired,level);
+ for(int selected=7;selected<=9;selected++)for(int peer=0;peer<=1;peer++)for(int expired=0;expired<2;expired++)for(int level=0;level<3;level++)run(10,8,peer?15:0,selected,expired,level);
+ printf("checks=%d failures=%d\n",checks,failures);return failures!=0;
+}
+'''
+path=root/'delay-host.c';path.write_text(prefix+body+suffix)
+subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-Wno-unused-function','-O2','-DSARCH_XBOX',str(path),'-o',str(root/'delay-host')],check=True)
+p=subprocess.run([str(root/'delay-host')],capture_output=True,text=True)
+print(p.stdout,end='');raise SystemExit(p.returncode)
