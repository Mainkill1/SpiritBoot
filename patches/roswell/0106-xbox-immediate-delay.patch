+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Public API probes isolate dynamic-priority changes from ready selection.
+ * Public fields are authoritative reference evidence only: SpiritBoot's
+ * recorded priority shadow may be stale. Setter return values give an
+ * independent actual-priority observation on both firmware profiles.
+ */
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include "regression.h"
+static volatile LONG stop,started;
+static volatile ULONG loops,sink;
+static volatile LONG callbacks;
+static int active_base=8;
+static void NTAPI apc(PVOID a,PVOID b,PVOID c){(void)a;(void)b;(void)c;++callbacks;}
+static DWORD WINAPI busy(LPVOID unused)
+{
+    (void)unused;ULONG value=1;started=1;
+    while(!stop){for(unsigned i=0;i<256;i++)value=value*1664525+1013904223;sink=value;++loops;}
+    return 0;
+}
+
+static void sample(PVOID peer,int main_priority,int peer_priority,unsigned method,unsigned index)
+{
+    PKTHREAD current=KeGetCurrentThread();
+    KeSetPriorityThread(current,31);
+    if(peer)KeSetPriorityThread(peer,peer_priority);
+    KeSetPriorityThread(current,main_priority);
+    if(method==5) {
+        ULONGLONG begin=KeQueryPerformanceCounter(),hz=KeQueryPerformanceFrequency();
+        while(KeQueryPerformanceCounter()-begin<hz/333) ++sink;
+    }
+    LONG main_before=current->Priority,main_q_before=current->Quantum;
+    LONG peer_before=peer?((PKTHREAD)peer)->Priority:-1;
+    callbacks=0;
+    if(method==4)regression_require(NtQueueApcThread(GetCurrentThread(),apc,NULL,NULL,NULL)==STATUS_SUCCESS,"queue relative-delay owned APC");
+    ULONG before=loops;ULONGLONG frequency=KeQueryPerformanceFrequency(),start=KeQueryPerformanceCounter();
+    LARGE_INTEGER interval={.QuadPart=(method==3 || method==4)?-10000:method==2?1:0};
+    NTSTATUS status=method==1?NtYieldExecution():KeDelayExecutionThread(UserMode,TRUE,&interval);
+    ULONG us=(ULONG)((KeQueryPerformanceCounter()-start)*1000000/frequency),progress=loops-before;
+    LONG main_after=current->Priority,main_q_after=current->Quantum;
+    LONG peer_after=peer?((PKTHREAD)peer)->Priority:-1;
+    LONG main_actual=KeSetPriorityThread(current,31);
+    LONG peer_actual=peer?KeSetPriorityThread(peer,1):-1;
+    KeSetPriorityThread(current,8);
+    tap_comment("prio method=%u sample=%u m=%d p=%d status=%08lx us=%lu loops=%lu field_m=%ld,%ld q=%ld,%ld field_p=%ld,%ld actual_after=%ld,%ld",method,index,main_priority,peer?peer_priority:-1,(ULONG)status,us,progress,main_before,main_after,main_q_before,main_q_after,peer_before,peer_after,main_actual,peer_actual);
+    if(method==0 || method==2 || method==5) {
+        int expected_priority=main_priority<16?active_base:main_priority;
+        regression_check(status==STATUS_SUCCESS,"immediate delay returns success");
+        regression_check(main_actual==expected_priority,"immediate delay resets dynamic priority to base and preserves real-time priority");
+        regression_check((progress>0)==(peer && peer_priority>=expected_priority),"immediate delay selects eligible peer after priority adjustment");
+    } else if(method==1) {
+        regression_check(status==(peer?STATUS_SUCCESS:STATUS_NO_YIELD_PERFORMED),"explicit yield retains existing status semantics");
+        if(!peer)regression_check(main_actual==main_priority,"explicit yield without a ready peer preserves dynamic priority");
+    } else if(method==3) {
+        regression_check(status==STATUS_SUCCESS,"unexpired relative delay succeeds");
+    } else {
+        regression_check(status==STATUS_USER_APC && callbacks==1,"relative alertable delay delivers queued APC exactly once");
+        regression_check(main_actual==main_priority,"APC interruption preserves dynamic priority");
+    }
+}
+
+int main(void)
+{
+    regression_begin();
+    regression_require(SetThreadPriority(GetCurrentThread(),THREAD_PRIORITY_NORMAL),"main base normal");
+    HANDLE thread=CreateThread(NULL,0,busy,NULL,0,NULL);
+    regression_require(thread!=NULL,"create owned peer");
+    while(!started)Sleep(1);
+    regression_require(SetThreadPriority(thread,THREAD_PRIORITY_BELOW_NORMAL),"peer base below normal");
+    PVOID peer=NULL;
+    regression_require(ObReferenceObjectByHandle(thread,&PsThreadObjectType,&peer)==STATUS_SUCCESS,"reference owned peer");
+    regression_check(KeQueryBasePriorityThread(KeGetCurrentThread())==0 && KeQueryBasePriorityThread(peer)==-1,"public APIs confirm bases8 and7");
+    const int cases[][2]={{6,5},{7,6},{8,7},{10,7},{10,8},{10,9},{15,14},{16,15},{20,7},{20,15},{31,15}};
+    for(unsigned method=0;method<6;method++)for(unsigned c=0;c<sizeof(cases)/sizeof(cases[0]);c++)for(unsigned i=0;i<2;i++)sample(peer,cases[c][0],cases[c][1],method,i);
+    SetThreadPriority(GetCurrentThread(),THREAD_PRIORITY_NORMAL);
+    stop=1;
+    regression_require(WaitForSingleObject(thread,5000)==WAIT_OBJECT_0,"peer exits");
+    ObfDereferenceObject(peer);CloseHandle(thread);
+    const int solo[]={6,10,16,20,31};
+    for(unsigned method=0;method<6;method++)for(unsigned m=0;m<5;m++)for(unsigned i=0;i<2;i++)sample(NULL,solo[m],0,method,i);
+    for(int base=6;base<=10;base+=4) {
+        /* Restore dynamic priority before changing its base: a base delta
+         * applied to an artificially lowered dynamic priority is outside
+         * the scheduler state exercised by ordinary wrapper usage. */
+        KeSetPriorityThread(KeGetCurrentThread(),8);
+        regression_require(SetThreadPriority(GetCurrentThread(),THREAD_PRIORITY_NORMAL),"restore normal main base");
+        KeSetPriorityThread(KeGetCurrentThread(),8);
+        regression_require(SetThreadPriority(GetCurrentThread(),base-8),"set supported main base");
+        active_base=base;
+        tap_comment("base-section main_base=%d peer_base=-1 actual_increment=%ld,-1",base,KeQueryBasePriorityThread(KeGetCurrentThread()));
+        for(unsigned method=0;method<6;method++)for(unsigned i=0;i<2;i++)sample(NULL,base+2,0,method,i);
+        KeSetPriorityThread(KeGetCurrentThread(),base);
+    }
+    regression_require(SetThreadPriority(GetCurrentThread(),THREAD_PRIORITY_NORMAL),"restore main base after solo cases");
+    active_base=8;
+    for(unsigned mode=0;mode<4;mode++) {
+        PKTHREAD current=KeGetCurrentThread();
+        KeSetPriorityThread(current,10);
+        LARGE_INTEGER zero={.QuadPart=0};
+        NTSTATUS s=KeDelayExecutionThread(mode&1?UserMode:KernelMode,mode&2?TRUE:FALSE,&zero);
+        LONG actual=KeSetPriorityThread(current,31);
+        KeSetPriorityThread(current,8);
+        tap_comment("mode-reset mode=%u alertable=%u status=%08lx priority_after=%ld",mode&1,!!(mode&2),(ULONG)s,actual);
+        regression_check(s==STATUS_SUCCESS && actual==8,"all wait modes apply immediate-delay priority reset");
+    }
+    LARGE_INTEGER zero={.QuadPart=0};
+    callbacks=0;
+    regression_require(NtQueueApcThread(GetCurrentThread(),apc,NULL,NULL,NULL)==STATUS_SUCCESS,"queue zero-delay owned APC");
+    NTSTATUS deferred=KeDelayExecutionThread(UserMode,FALSE,&zero);
+    regression_check(deferred==STATUS_SUCCESS && callbacks==0,"nonalertable immediate delay defers APC");
+    NTSTATUS delivered=KeDelayExecutionThread(UserMode,TRUE,&zero);
+    regression_check(delivered==STATUS_USER_APC && callbacks==1,"alertable immediate delay returns USER_APC once");
+    KEVENT event;
+    KeInitializeEvent(&event,NotificationEvent,FALSE);
