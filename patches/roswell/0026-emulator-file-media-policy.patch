+#!/usr/bin/env python3
+"""Compile the production certificate policy and title-key call boundary."""
+from pathlib import Path
+import re, subprocess, sys
+root,out=map(Path,sys.argv[1:3]);out.mkdir(parents=True,exist_ok=True)
+s=(root/'ntoskrnl/xb/xbe.c').read_text()
+def function(name):
+ m=re.search(r'(?:static\s+)?NTSTATUS\s+'+name+r'\s*\([^)]*\)\s*\{',s)
+ if not m:return ''
+ i=s.index('{',m.start());depth=1;j=i+1
+ while depth:
+  depth += (s[j]=='{')-(s[j]=='}');j+=1
+ return s[m.start():j]
+helper=function('XePrepareTitleCertificate')
+if helper:
+ declarations=s[s.index('/* Retain the original certificate'):s.index('static NTSTATUS\nXePrepareTitleCertificate')]
+ call=re.search(r'/\* The keys the title.*?\n    \}',s,re.S).group()
+else:
+ declarations='static unsigned char *XepOriginalCertificate; static unsigned long XepOriginalCertificateSize;'
+ call=re.search(r'/\* The keys the title.*?\n    \}',s,re.S).group()
+shim=r'''
+#define _GNU_SOURCE
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+typedef void VOID; typedef uint32_t ULONG; typedef uintptr_t ULONG_PTR;
+typedef unsigned char UCHAR,*PUCHAR; typedef void *PVOID;
+typedef int32_t NTSTATUS;
+typedef struct {ULONG BaseAddr,SizeOfHeaders,CertificateAddr;} XBE_HEADER,*PXBE_HEADER;
+#define STATUS_SUCCESS ((NTSTATUS)0)
+#define STATUS_INVALID_IMAGE_FORMAT ((NTSTATUS)0xc000007b)
+#define STATUS_INSUFFICIENT_RESOURCES ((NTSTATUS)0xc000009a)
+#define NT_SUCCESS(s) ((s)>=0)
+#define NonPagedPool 0
+#define XBE_TAG 0
+#define RtlCopyMemory memcpy
+#define XbDbg(...) ((void)0)
+static int fail_alloc,allocations,frees,key_calls;
+static unsigned char derived[512];static unsigned derived_size;
+static void *ExAllocatePoolWithTag(int pool,size_t size,int tag){
+ (void)pool;(void)tag;if(fail_alloc)return NULL;allocations++;return malloc(size);}
+static void ExFreePoolWithTag(void*p,int tag){(void)tag;frees++;free(p);}
+void NxkDeriveTitleKeys(PVOID cert){key_calls++;if(!cert)return;
+ memcpy(&derived_size,cert,4);if(derived_size>sizeof(derived))abort();memcpy(derived,cert,derived_size);}
+'''
+shim=shim.replace('typedef struct {ULONG BaseAddr,SizeOfHeaders,CertificateAddr;} XBE_HEADER,*PXBE_HEADER;', re.search(r'typedef struct _XBE_HEADER.*?XBE_HEADER, \*PXBE_HEADER;',s,re.S).group())
+shim+=declarations+'\n'+helper+'\nstatic ULONG completed=4096;static PVOID actualBase;\nstatic NTSTATUS load(PXBE_HEADER hdr){NTSTATUS status=STATUS_SUCCESS;PVOID imageBase=actualBase;ULONG headersSize=4096;struct {ULONG Information;} iosb={completed};(void)imageBase;(void)headersSize;(void)iosb;'+call+'\nreturn status;}\n'
+shim+=r'''
+static void put32(unsigned char*p,unsigned v){memcpy(p,&v,4);}
+static unsigned get32(unsigned char*p){unsigned v;memcpy(&v,p,4);return v;}
+static unsigned char *image;
+static XBE_HEADER header;
+static unsigned checks,failed;
+#define CHECK(v) do{checks++;if(!(v)){fprintf(stderr,"FAIL %s:%d %s\n",__FILE__,__LINE__,#v);failed++;}}while(0)
+static void reset(unsigned media,unsigned cert_size){
+ memset(image,0xa5,4096);put32(image+0x200,cert_size);put32(image+0x29c,media);
+ header=(XBE_HEADER){.BaseAddr=(ULONG)(uintptr_t)image,.SizeOfHeaders=4096,.CertificateAddr=(ULONG)(uintptr_t)(image+0x200)};
+ key_calls=0;derived_size=0;fail_alloc=0;completed=4096;actualBase=image;
+}
+int main(void){
+ image=mmap(NULL,4096,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_32BIT,-1,0);
+ if(image==MAP_FAILED){perror("mmap");return 2;}
+ unsigned masks[]={2,3,1,0xffffff,0x80000002,0x80000001,0};
+ for(unsigned i=0;i<sizeof(masks)/sizeof(*masks);i++){
+  reset(masks[i],0x1d0);unsigned char original[0x1d0];memcpy(original,image+0x200,sizeof(original));
+  CHECK(load(&header)==STATUS_SUCCESS);CHECK(key_calls==1);CHECK(derived_size==sizeof(original));
+  CHECK(memcmp(derived,original,sizeof(original))==0);
+#if XB_EMULATOR_FILE_MEDIA
+  unsigned effective=(masks[i]&0xffffff)==2?masks[i]|1:masks[i];
+  CHECK(get32(image+0x29c)==effective);CHECK(XepOriginalCertificateSize==sizeof(original));
+  CHECK(XepOriginalCertificate && memcmp(XepOriginalCertificate,original,sizeof(original))==0);
+#else
+  CHECK(memcmp(image+0x200,original,sizeof(original))==0);CHECK(!XepOriginalCertificate);
+#endif
+  put32(image+0x29c,masks[i]);CHECK(memcmp(image+0x200,original,sizeof(original))==0);
+ }
+#if XB_EMULATOR_FILE_MEDIA
+ reset(2,0x1d0);completed=4095;CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,0x1d0);header.BaseAddr+=16;CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,0x1d0);header.SizeOfHeaders=8192;CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,0x1d0);header.CertificateAddr=header.BaseAddr+64;put32(image+64,0xd0);CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,0x1d0);header.CertificateAddr=header.BaseAddr-1;CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,0x1d0);header.CertificateAddr=header.BaseAddr+4094;CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,0xcf);CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,4096);CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,0x1d0);fail_alloc=1;CHECK(load(&header)==STATUS_INSUFFICIENT_RESOURCES);CHECK(!key_calls);CHECK(get32(image+0x29c)==2);
+ reset(2,0xd0);CHECK(load(&header)==STATUS_SUCCESS);CHECK(derived_size==0xd0);CHECK(get32(image+0x29c)==3);
+ reset(2,0x1d0);header.SizeOfHeaders=3;CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+ reset(2,0x1d0);header.CertificateAddr=0xfffffff0;CHECK(load(&header)==STATUS_INVALID_IMAGE_FORMAT);CHECK(!key_calls);
+#endif
+ if(XepOriginalCertificate){ExFreePoolWithTag(XepOriginalCertificate,0);XepOriginalCertificate=NULL;}
+ CHECK(allocations==frees);munmap(image,4096);
+ printf("policy=%d: %u production certificate checks, %u failures\n",XB_EMULATOR_FILE_MEDIA,checks,failed);
+ return !!failed;
+}
+'''
+for mode in [0,1]:
+ p=out/f'check-{mode}.c';p.write_text(shim)
+ subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-Wno-unused-function','-Wno-unused-variable',f'-DXB_EMULATOR_FILE_MEDIA={mode}','-fsanitize=address,undefined','-fno-omit-frame-pointer',str(p),'-o',str(out/f'check-{mode}')],check=True)
+ subprocess.run([str(out/f'check-{mode}')],check=True)
