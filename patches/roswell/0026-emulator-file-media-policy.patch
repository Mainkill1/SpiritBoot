+/* Retain the original certificate for provenance and title-key derivation.
+ * The file-backed-media policy changes only the loaded compatibility view. */
+#ifndef XB_EMULATOR_FILE_MEDIA
+#define XB_EMULATOR_FILE_MEDIA 0
+#endif
+#define XBE_CERT_MEDIA_OFFSET 0x9cu
+#define XBE_CERT_MIN_SIZE 0xd0u /* Includes both mandatory 16-byte keys. */
+#define XBE_MEDIA_DVD 2u
+#define XBE_MEDIA_HARD_DISK 1u
+#define XBE_MEDIA_TYPE_MASK 0x00ffffffu
+static PUCHAR XepOriginalCertificate;
+static ULONG XepOriginalCertificateSize;
+
+static NTSTATUS
+XePrepareTitleCertificate(PXBE_HEADER Header, PVOID ImageBase,
+                          ULONG HeaderBytes, ULONG CompletedBytes)
+{
+    extern VOID NxkDeriveTitleKeys(PVOID Certificate);
+#if XB_EMULATOR_FILE_MEDIA
+    ULONG Offset, Size, OriginalMedia, EffectiveMedia;
+    PUCHAR Certificate, Original;
+
+    /* Header fields may not enlarge or relocate the bytes actually read. */
+    if (HeaderBytes < sizeof(*Header) || CompletedBytes < HeaderBytes ||
+        Header->BaseAddr != (ULONG_PTR)ImageBase ||
+        Header->SizeOfHeaders != HeaderBytes)
+        return STATUS_INVALID_IMAGE_FORMAT;
+
+    /* Use subtraction: neither a malformed VA nor Size may wrap a range. */
+    if (Header->CertificateAddr < Header->BaseAddr ||
+        Header->SizeOfHeaders < sizeof(Size))
+        return STATUS_INVALID_IMAGE_FORMAT;
+    Offset = Header->CertificateAddr - Header->BaseAddr;
+    if (Offset < sizeof(*Header) ||
+        Offset > Header->SizeOfHeaders - sizeof(Size))
+        return STATUS_INVALID_IMAGE_FORMAT;
+    Certificate = (PUCHAR)(ULONG_PTR)Header->CertificateAddr;
+    RtlCopyMemory(&Size, Certificate, sizeof(Size));
+    if (Size < XBE_CERT_MIN_SIZE || Size > Header->SizeOfHeaders - Offset)
+        return STATUS_INVALID_IMAGE_FORMAT;
+
+    Original = ExAllocatePoolWithTag(NonPagedPool, Size, XBE_TAG);
+    if (Original == NULL)
+        return STATUS_INSUFFICIENT_RESOURCES;
+    RtlCopyMemory(Original, Certificate, Size);
+    if (XepOriginalCertificate != NULL)
+        ExFreePoolWithTag(XepOriginalCertificate, XBE_TAG);
+    XepOriginalCertificate = Original;
+    XepOriginalCertificateSize = Size;
+    NxkDeriveTitleKeys(Original);
+
+    RtlCopyMemory(&OriginalMedia, Original + XBE_CERT_MEDIA_OFFSET,
+                  sizeof(OriginalMedia));
+    EffectiveMedia = OriginalMedia;
+    if ((OriginalMedia & XBE_MEDIA_TYPE_MASK) == XBE_MEDIA_DVD)
+        EffectiveMedia |= XBE_MEDIA_HARD_DISK;
+    RtlCopyMemory(Certificate + XBE_CERT_MEDIA_OFFSET, &EffectiveMedia,
+                  sizeof(EffectiveMedia));
+    XbDbg("file-backed media policy: original=%08lx effective=%08lx\n",
+          OriginalMedia, EffectiveMedia);
+#else
+    (void)ImageBase;
+    (void)HeaderBytes;
+    (void)CompletedBytes;
+    /* Strict builds retain the original loader behavior and certificate. */
+    NxkDeriveTitleKeys((PVOID)(ULONG_PTR)Header->CertificateAddr);
+#endif
+    return STATUS_SUCCESS;
+}
 
