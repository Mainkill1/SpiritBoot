@@ -1106,6 +1114,42 @@ CcZeroData(
 
 /* PIN INTERFACE ************************************************************/
 
+/* Enter with NxcMutex held.  A successful return keeps it held; pool
+ * allocation runs unlocked; a failed allocation leaves it released.
+ * Pool operations must not run under the cache mutex. */
+static NXC_BCB *
+NxcAllocateBcbLocked(VOID)
+{
+    NXC_BCB *Bcb = NxcFreeBcbs;
+
+    if (Bcb != NULL)
+    {
+        NxcFreeBcbs = Bcb->NextFree;
+        --NxcFreeBcbCount;
+        return Bcb;
+    }
+
+    ExReleaseFastMutex(&NxcMutex);
+    Bcb = ExAllocatePoolWithTag(NonPagedPool, sizeof(*Bcb), NXC_TAG);
+    if (Bcb != NULL)
+        ExAcquireFastMutex(&NxcMutex);
+    return Bcb;
+}
+
+/* Only the last reference may transfer a BCB into the idle list.  No map
+ * or block reference is retained.  Overflow is freed after unlocking. */
+static BOOLEAN
+NxcCacheBcbLocked(NXC_BCB *Bcb)
+{
+    if (NxcFreeBcbCount == NXC_FREE_BCB_LIMIT)
+        return FALSE;
+
+    Bcb->NextFree = NxcFreeBcbs;
+    NxcFreeBcbs = Bcb;
+    ++NxcFreeBcbCount;
+    return TRUE;
+}
