diff --git a/ntoskrnl/io/iomgr/irp.c b/ntoskrnl/io/iomgr/irp.c
index c3a4e1747102c4ff34b121f13fe9055fd8bbe664..faec125c1931c5ceea387b11c1c6c34706b7b73a 100644
--- a/ntoskrnl/io/iomgr/irp.c
+++ b/ntoskrnl/io/iomgr/irp.c
@@ -465,6 +465,16 @@ IopCompleteRequest(IN PKAPC Apc,
         /* Now check if a User APC Routine was requested */
         if (Irp->Overlay.AsynchronousParameters.UserApcRoutine)
         {
+            KPROCESSOR_MODE ApcMode = Irp->RequestorMode;
+#ifdef SARCH_XBOX
+            /* The Xbox Win32 trampoline belongs to the user APC queue even
+             * though titles run in ring 0. A kernel APC may invoke it before
+             * NtReadFile returns and before the title records the request.
+             * Preserve raw kernel APCs and RequestorMode's probing semantics. */
+            if (Irp->Overlay.AsynchronousParameters.UserApcRoutine ==
+                (PIO_APC_ROUTINE)NtUserIoApcDispatcher)
+                ApcMode = UserMode;
+#endif
             /* Initialize it */
             KeInitializeApc(&Irp->Tail.Apc,
                             KeGetCurrentThread(),
@@ -473,7 +483,7 @@ IopCompleteRequest(IN PKAPC Apc,
                             IopAbortIrpKernelApc,
                             (PKNORMAL_ROUTINE)Irp->
                             Overlay.AsynchronousParameters.UserApcRoutine,
-                            Irp->RequestorMode,
+                            ApcMode,
                             Irp->
                             Overlay.AsynchronousParameters.UserApcContext);
 
diff --git a/ntoskrnl/xb/xbe.c b/ntoskrnl/xb/xbe.c
index 53eb75226c07787d5cc613135799183b351b6ab4..ffb366ce2f4cfd178ac29348fdc69ffa4aac72cf 100644
--- a/ntoskrnl/xb/xbe.c
+++ b/ntoskrnl/xb/xbe.c
@@ -1049,13 +1049,9 @@ VOID NTAPI IoMarkIrpMustComplete(_In_ PVOID Irp) { UNREFERENCED_PARAMETER(Irp);
  * completion routine and IosbPtr doubles as the title's OVERLAPPED.  Convert
  * NTSTATUS/Information to (dwErrorCode, dwBytesTransferred) and invoke.
  *
- * Titles run ring 0, so RequestorMode = KernelMode and the completion comes
- * as a kernel-mode APC -- it runs but does not set UserApcPending, so an
- * alertable UserMode wait sleeps its full timeout instead of waking with
- * STATUS_USER_APC.  Flag the pending user APC here so KiCheckAlertability
- * returns STATUS_USER_APC from the wait. */
+ * IopCompleteRequest queues title completions as user APCs even though titles
+ * run in ring 0. KiDeliverUserApcs invokes this during an alertable wait. */
 NTKERNELAPI ULONG NTAPI RtlNtStatusToDosError(IN NTSTATUS Status);
-NTKERNELAPI VOID NTAPI KiSetCurrentThreadUserApcPending(VOID);
 VOID NTAPI NtUserIoApcDispatcher(_In_ PVOID ApcContext, _In_ PVOID IosbPtr,
                                      _In_ ULONG Reserved)
 {
@@ -1076,7 +1072,6 @@ VOID NTAPI NtUserIoApcDispatcher(_In_ PVOID ApcContext, _In_ PVOID IosbPtr,
     /* lpOverlapped == the IoStatusBlock the title handed to Nt{Read,Write}File. */
     CompletionRoutine(dwError, dwTransferred, (PVOID)Iosb);
 
-    KiSetCurrentThreadUserApcPending();
 }
 
