+    ULONG ClusterBytes,
+    ULONG FileOffset,
+    ULONG Length,
+    ULONG Cluster)
+{
+    PVFAT_SEEK_CACHE Cache = Fcb->SeekCache;
+    PVFAT_READ_EXTENT Extent;
+    ULONG ClusterCount, ClusterMask, ClusterShift = 0, Delta, Offset, Scale, Span;
+    ULONGLONG NewEnd;
+    BOOLEAN Compatible = FALSE;
+
+    if (!Cache || ClusterBytes == 0 || Length == 0 ||
+        (ClusterBytes & (ClusterBytes - 1)) != 0 ||
+        Cluster < 2 || Cluster == MAXULONG)
+        return;
+    ClusterMask = ClusterBytes - 1;
+    if (Length > MAXULONG - (FileOffset & ClusterMask))
+        return;
