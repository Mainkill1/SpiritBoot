@@ -0,0 +1,193 @@
+#!/usr/bin/env python3
+"""Compile and exercise the exact production FATX read-extent helpers."""
+import importlib.util
+from pathlib import Path
+import subprocess
+import sys
+
+source_root = Path(sys.argv[1]).resolve()
+output = Path(sys.argv[2]).resolve()
+output.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location(
+    "extract", source_root / "tests/host/kernel-performance/check.py")
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+rw = (source_root / "drivers/filesystems/vfatfs/rw.c").read_text()
+body = "\n".join(extract.function(rw, name) for name in (
+    "VfatPrepareSeekCache", "VfatLookupReadExtent",
+    "VfatRememberReadExtent", "VfatInvalidateSeekCheckpoints"))
+
+shim = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint8_t UCHAR;
+typedef uint32_t ULONG, *PULONG;
+typedef uint64_t ULONGLONG;
+typedef int64_t LONGLONG;
+typedef int BOOLEAN;
+typedef void VOID;
+#define TRUE 1
+#define FALSE 0
+#define NonPagedPool 0
+#define TAG_FCB 0
+#define VFAT_SEEK_CHECKPOINTS 16
+#define MAXULONG 0xffffffffu
+#define RtlZeroMemory(p,n) memset((p),0,(n))
+typedef union { struct { ULONG LowPart; int32_t HighPart; } u; LONGLONG QuadPart; } LARGE_INTEGER, *PLARGE_INTEGER;
+typedef struct {
+    ULONG Offset;
+    ULONG Cluster;
+    ULONG ClusterCount;
+    ULONG Generation;
+} VFAT_READ_EXTENT, *PVFAT_READ_EXTENT;
+typedef struct _VFAT_SEEK_CACHE {
+    struct { ULONG Offset, Cluster; } Positions[VFAT_SEEK_CHECKPOINTS];
+    VFAT_READ_EXTENT ReadExtent;
+    ULONG Generation;
+    ULONG ClusterBytes;
+    ULONG ClusterShift;
+} VFAT_SEEK_CACHE, *PVFAT_SEEK_CACHE;
+typedef struct {
+    ULONG BytesPerCluster, BytesPerSector, dataStart;
+} FATINFO;
+typedef struct { FATINFO FatInfo; } DEVICE_EXTENSION, *PDEVICE_EXTENSION;
+typedef struct {
+    struct { LARGE_INTEGER AllocationSize; } RFCB;
+    PVFAT_SEEK_CACHE SeekCache;
+    int LastMutex;
+} VFATFCB, *PVFATFCB;
+static int held, allocation_fail;
+static unsigned allocations, frees;
+static void *ExAllocatePoolWithTag(int pool, size_t size, int tag) {
+    (void)pool; (void)tag; assert(!held);
+    if (allocation_fail) return NULL;
+    ++allocations; return malloc(size);
+}
+static void ExFreePool(void *p) { assert(!held); ++frees; free(p); }
+static void ExAcquireFastMutex(int *m) { (void)m; assert(!held); held=1; }
+static void ExReleaseFastMutex(int *m) { (void)m; assert(held); held=0; }
+static ULONGLONG ClusterToSector(PDEVICE_EXTENSION d, ULONG cluster) {
+    return d->FatInfo.dataStart + (ULONGLONG)(cluster - 2) *
+           (d->FatInfo.BytesPerCluster / d->FatInfo.BytesPerSector);
+}
+'''
+
+tests = r'''
+static unsigned checks;
+static void check(int condition) { ++checks; assert(condition); }
+static int lookup(PVFATFCB f,PDEVICE_EXTENSION d,ULONG off,ULONG len,
+                  ULONGLONG *disk,PULONG cluster) {
+    LARGE_INTEGER at = {.QuadPart=-1}; ULONG found=0;
+    ExAcquireFastMutex(&f->LastMutex);
+    int hit=VfatLookupReadExtent(f,d,off,len,&at,&found);
+    ExReleaseFastMutex(&f->LastMutex);
+    *disk=(ULONGLONG)at.QuadPart;*cluster=found;return hit;
+}
+static void remember(PVFATFCB f,ULONG off,ULONG cluster,ULONG count) {
+    ExAcquireFastMutex(&f->LastMutex);
+    VfatRememberReadExtent(f,16384,off,count*16384,cluster);
+    ExReleaseFastMutex(&f->LastMutex);
+}
+static ULONGLONG disk_at(PDEVICE_EXTENSION d,ULONG cluster,ULONG within) {
+    return ClusterToSector(d,cluster)*d->FatInfo.BytesPerSector+within;
+}
+int main(void) {
+    DEVICE_EXTENSION d={.FatInfo={16384,512,32}};
+    VFATFCB f={0};f.RFCB.AllocationSize.QuadPart=64*1024*1024;
+    allocation_fail=1;check(!VfatPrepareSeekCache(&f)&&!f.SeekCache);
+    allocation_fail=0;check(VfatPrepareSeekCache(&f)&&f.SeekCache);
+    check(VfatPrepareSeekCache(&f)&&allocations==1);
+
+    ULONGLONG disk;ULONG cluster;
+    remember(&f,4*16384,100,4);
+    check(lookup(&f,&d,4*16384,512,&disk,&cluster));
+    check(cluster==100&&disk==disk_at(&d,100,0));
+    check(lookup(&f,&d,5*16384+123,1000,&disk,&cluster));
+    check(cluster==101&&disk==disk_at(&d,101,123));
+    check(lookup(&f,&d,7*16384+16000,384,&disk,&cluster));
+    check(cluster==103&&disk==disk_at(&d,103,16000));
+    check(!lookup(&f,&d,3*16384,512,&disk,&cluster));
+    check(!lookup(&f,&d,7*16384+16000,385,&disk,&cluster));
+    check(!lookup(&f,&d,8*16384,512,&disk,&cluster));
+
+    DEVICE_EXTENSION odd={.FatInfo={12288,512,32}};
+    VfatInvalidateSeekCheckpoints(&f);
+    ExAcquireFastMutex(&f.LastMutex);
+    VfatRememberReadExtent(&f,12288,0,12288,200);
+    ExReleaseFastMutex(&f.LastMutex);
+    check(f.SeekCache->ReadExtent.ClusterCount==0);
+    remember(&f,0,200,2);
+    check(!lookup(&f,&odd,0,512,&disk,&cluster));
+    d.FatInfo.BytesPerCluster=8192;
+    check(!lookup(&f,&d,0,512,&disk,&cluster));
+    d.FatInfo.BytesPerCluster=16384;
+
+    /* Compatible adjacency and overlap become one complete hit. */
+    remember(&f,4*16384,100,4);
+    remember(&f,8*16384,104,2);
+    remember(&f,2*16384,98,2);
+    check(lookup(&f,&d,2*16384,8*16384,&disk,&cluster));
+    check(cluster==98&&disk==disk_at(&d,98,0));
+    /* Logical adjacency with a physical gap must remain a miss. */
+    remember(&f,10*16384,900,2);
+    check(!lookup(&f,&d,9*16384,2*16384,&disk,&cluster));
+
+    /* Invalid publications and overflowing requests never hit. */
+    remember(&f,0,1,4);remember(&f,0,0xffffffffu,4);
+    remember(&f,0,2,0);remember(&f,0xfffff000u,2,2);
+    check(!lookup(&f,&d,0,0,&disk,&cluster));
+    check(!lookup(&f,&d,0xfffff000u,0x2000,&disk,&cluster));
+
+    /* A disjoint publication replaces the former hot range. */
+    VfatInvalidateSeekCheckpoints(&f);
+    remember(&f,0,1000,1);
+    check(lookup(&f,&d,0,512,&disk,&cluster));
+    remember(&f,40*16384,1040,1);
+    check(!lookup(&f,&d,0,512,&disk,&cluster));
+    check(lookup(&f,&d,40*16384,512,&disk,&cluster));
+
+    /* Every stale mapping disappears at the mutation boundary. */
+    ULONG prior_generation=f.SeekCache->Generation;
+    VfatInvalidateSeekCheckpoints(&f);
+    check(!lookup(&f,&d,40*16384,512,&disk,&cluster));
+    check(f.SeekCache->ReadExtent.ClusterCount==0);
+    check(f.SeekCache->Generation!=prior_generation);
+
+    /* Randomized hits must exactly match an independent linear oracle. */
+    uint32_t seed=0x9174a2d3u;
+    for(unsigned round=0;round<2000;round++) {
+        VfatInvalidateSeekCheckpoints(&f);
+        seed=seed*1664525u+1013904223u;
+        ULONG base=(seed%2048u)*16384u;
+        ULONG phys=2u+(seed%12000u), count=1u+((seed>>20)%8u);
+        if((ULONGLONG)base+(ULONGLONG)count*16384u >= (ULONGLONG)f.RFCB.AllocationSize.QuadPart) continue;
+        remember(&f,base,phys,count);
+        seed=seed*1664525u+1013904223u;
+        ULONG delta=(seed%count),within=(seed>>8)%16000u;
+        ULONG len=1u+((seed>>24)%384u);
+        if(within+len>16384u)len=16384u-within;
+        check(lookup(&f,&d,base+delta*16384u+within,len,&disk,&cluster));
+        check(cluster==phys+delta);
+        check(disk==disk_at(&d,phys+delta,within));
+    }
+    check(!held);ExFreePool(f.SeekCache);check(allocations==frees);
+    printf("FATX extent cache: %u checks, 0 failures\n",checks);
+    return 0;
+}
+'''
+
+c_file = output / "extent-cache.c"
+c_file.write_text(shim + body + tests)
+compiler = "clang" if subprocess.run(["sh", "-c", "command -v clang"],
+                                      capture_output=True).returncode == 0 else "cc"
+for name, flags in (
+    ("plain", ["-O3"]),
+    ("sanitized", ["-O1", "-fsanitize=address,undefined"]),
+):
+    binary = output / ("extent-cache-" + name)
+    subprocess.run([compiler, "-std=gnu11", "-Wall", "-Wextra", "-Werror",
+                    *flags, str(c_file), "-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
