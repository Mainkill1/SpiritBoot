index 00000000..61485f9e
--- /dev/null
+++ b/boot/nxldr/warm-handoff.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NX_WARM_HANDOFF_H
+#define NX_WARM_HANDOFF_H
+#include "warm-stage.h"
+#define PM_PAGES 0x4000u
+#define PM_BYTES (PM_PAGES / 8)
+#define PM_MAGIC 0x4D50584EUL
+#if XBOX_RAM_MIB == 64
+#define PM_VERSION 3
+#else
+#define PM_VERSION 2
+#endif
+#define PM_LAUNCH_MAGIC 0x6E78436CUL
+#define PM_LAUNCH_BYTES 3616
+#define PM_MAX_STAGES 505u
+
+typedef struct _PM_HANDOFF {
+    unsigned Magic, Version, BitmapBytes, ImageBase, LaunchHash, Checksum;
+    unsigned char Pages[PM_BYTES];
+    unsigned StageCount;
+    NX_WARM_PAIR Stages[PM_MAX_STAGES];
+} PM_HANDOFF;
+_Static_assert(sizeof(PM_HANDOFF) == 4096, "warm handoff must fit its reserved page");
+
+static unsigned PmHash(const unsigned char *Bytes, unsigned Length)
+{
+    unsigned hash = 2166136261u, i;
+    for (i = 0; i < Length; ++i) hash = (hash ^ Bytes[i]) * 16777619u;
+    return hash;
+}
+static unsigned PmChecksum(const PM_HANDOFF *H)
+{
+    return PmHash((const unsigned char *)&H->Version, 16) ^
+        PmHash(H->Pages, PM_BYTES) ^
+        PmHash((const unsigned char *)&H->StageCount,
+               4 + H->StageCount * sizeof(NX_WARM_PAIR));
+}
+#endif
diff --git a/boot/nxldr/warm-stage.h b/boot/nxldr/warm-stage.h
new file mode 100644
index 00000000..69088c3e
--- /dev/null
+++ b/boot/nxldr/warm-stage.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Plan temporary copies of selected image pages before destructive boot work.
+ * This is a physical ownership plan, not a copy operation or a handoff validator.
+ * Callers must validate the handoff first and reserve every temporary PFN in
+ * loader descriptors before starting MM. No heap, pool or guest API is used.
+ */
+#ifndef NX_WARM_STAGE_H
+#define NX_WARM_STAGE_H
+#include "boot-layout.h"
+
+typedef struct {
+    unsigned short Original;
+    unsigned short Temporary;
+} NX_WARM_PAIR;
+
+static inline int NxWarmSelected(const unsigned char *Bitmap, unsigned Page)
+{
+    return Page < 0x4000 && (Bitmap[Page >> 3] & (1u << (Page & 7)));
+}
+
+static inline int NxWarmTemporaryPage(unsigned Page, unsigned ImageBytes)
+{
+    unsigned image = NXBL_IMAGE_PA >> 12;
+    if (Page < 0x100 || Page >= 0x3c00) return 0;
+    if (Page >= image && Page - image < (ImageBytes >> 12)) return 0;
+    if (Page >= (NXBL_LOADER_PA >> 12) &&
+        Page < (NXBL_LOADER_LIMIT_PA >> 12)) return 0;
+    if (Page >= (NXBL_PT_LOW_PA >> 12) &&
+        Page <= (NXBL_PT_PCR_PA >> 12)) return 0;
+    return 1;
+}
+
+static inline int NxWarmPlan(const unsigned char *Bitmap, unsigned ImageBytes,
+                     NX_WARM_PAIR *Pairs, unsigned Capacity, unsigned *Count)
+{
+    unsigned first = NXBL_IMAGE_PA >> 12;
+    unsigned used = 0, p, count = 0, run = 0, begin = 0;
+    unsigned best = 0, length = 0, i;
+    *Count = 0;
+    if (!ImageBytes || (ImageBytes & 4095) || ImageBytes > NXBL_IMAGE_BYTES)
+        return 0;
+    for (p = first; p < first + (ImageBytes >> 12); ++p) {
+        if (!NxWarmSelected(Bitmap, p)) continue;
+        if (count == Capacity) return 0;
+        Pairs[count++].Original = (unsigned short)p;
+    }
+    /* Early MM carves one high-zone descriptor. Preserve its largest
+     * usable run while any other temporary storage is available. */
+    for (p = 0x3400; p <= 0x3c00; ++p) {
+        if (NxWarmTemporaryPage(p, ImageBytes) && !NxWarmSelected(Bitmap, p)) {
+            if (!run) begin = p;
+            ++run;
+        } else {
+            if (run > length) { best = begin; length = run; }
+            run = 0;
+        }
+    }
+    for (p = 0x100; p < 0x3c00 && used < count; ++p) {
+        if (p >= best && p - best < length) continue;
+        if (NxWarmTemporaryPage(p, ImageBytes) && !NxWarmSelected(Bitmap, p))
+            Pairs[used++].Temporary = (unsigned short)p;
+    }
+    if (count - used > length) return 0;
+    /* If that run is the only remaining storage, consume its tail so the
+     * longest possible contiguous prefix stays available to early MM. */
+    p = best + length - (count - used);
+    while (used < count) Pairs[used++].Temporary = (unsigned short)p++;
+    /* Monotonic pair lists make validation/uniqueness bounded and simple. */
+    for (i = 1; i < count; ++i) {
+        unsigned j = i;
+        unsigned short page = Pairs[i].Temporary;
+        while (j && Pairs[j - 1].Temporary > page) {
+            Pairs[j].Temporary = Pairs[j - 1].Temporary;
+            --j;
+        }
+        Pairs[j].Temporary = page;
+    }
+    *Count = count;
+    return 1;
+}
+/* Match the whole pages freed by MiFindInitializationCode and the Xbox
+ * donor: following discardable sections join the run; a final partial
+ * section is not rounded up. The caller supplies the validated mapped PE. */
+static inline unsigned NxWarmU16(const unsigned char *P)
+{ return P[0] | ((unsigned)P[1] << 8); }
+static inline unsigned NxWarmU32(const unsigned char *P)
+{ return NxWarmU16(P) | (NxWarmU16(P + 2) << 16); }
+static inline int NxWarmDonated(const unsigned char *Image, unsigned Bytes,
+                               unsigned PageOffset)
+{
+    unsigned pe, table, sections, i;
+    if (Bytes < 64 || Image[0] != 'M' || Image[1] != 'Z') return 0;
+    pe = NxWarmU32(Image + 0x3c);
+    if (pe > Bytes - 24 || NxWarmU32(Image + pe) != 0x4550) return 0;
+    sections = NxWarmU16(Image + pe + 6);
+    table = pe + 24 + NxWarmU16(Image + pe + 20);
+    if (table > Bytes || sections > (Bytes - table) / 40) return 0;
+    for (i = 0; i < sections; ++i) {
+        const unsigned char *section = Image + table + i * 40;
+        unsigned start, end, size, last = i;
+        int init = NxWarmU32(section) == 0x54494e49 && section[4] == 0;
+        if (!init && !(NxWarmU32(section + 36) & 0x02000000)) continue;
+        start = NxWarmU32(section + 12);
+        while (last + 1 < sections &&
+               (NxWarmU32(Image + table + (last + 1) * 40 + 36) & 0x02000000))
+            ++last;
+        section = Image + table + last * 40;
+        size = NxWarmU32(section + 8);
+        if (NxWarmU32(section + 16) > size) size = NxWarmU32(section + 16);
+        end = NxWarmU32(section + 12);
+        if (start > Bytes || end > Bytes || size > Bytes - end) return 0;
+        end += size;
+        if (last + 1 < sections) end = (end + 4095) & ~4095u;
+        if ((PageOffset << 12) >= ((start + 4095) & ~4095u) &&
+            (PageOffset << 12) < (end & ~4095u)) return 1;
+        i = last;
+    }
+    return 0;
+}
+#endif
