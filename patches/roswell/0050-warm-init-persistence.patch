+/* Preserve the selected pages before XZ replaces their old INIT bytes.
+ * All planning finishes before any copy. The kernel validates each pair and
+ * reserves its temporary PFN in the boot descriptor list before MM starts. */
+static int PreserveWarmImage(void)
+{
+    PM_HANDOFF *H = (PM_HANDOFF *)0xD000;
+    const NXKRNL_XZ_HEADER *Payload = (const void *)KernelPayloadVa;
+    unsigned launch = *(const unsigned *)0xE000 == PM_LAUNCH_MAGIC ?
+        PmHash((const unsigned char *)0xE000, PM_LAUNCH_BYTES) : 0;
+    unsigned count, i;
+    if (H->Magic != PM_MAGIC || H->Version != PM_VERSION ||
+        H->BitmapBytes != PM_BYTES || H->ImageBase != NXBL_IMAGE_BASE ||
+        H->StageCount > PM_MAX_STAGES || H->LaunchHash != launch ||
+        H->Checksum != PmChecksum(H)) return 1; /* no valid warm handoff */
+    if (H->StageCount || Payload->Magic != NXKRNL_XZ_MAGIC ||
+        !NxWarmPlan(H->Pages, Payload->DecompressedSize,
+                    H->Stages, PM_MAX_STAGES, &count)) return 0;
+    for (i = 0; i < count; ++i)
+        memcpy((void *)((ULONG_PTR)H->Stages[i].Temporary << 12),
+               (const void *)((ULONG_PTR)H->Stages[i].Original << 12), 4096);
+    H->StageCount = count;
+    H->Checksum = PmChecksum(H);
+    return 1;
+}
