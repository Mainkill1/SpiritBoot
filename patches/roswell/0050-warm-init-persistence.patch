index 00000000..6274c456
--- /dev/null
+++ b/tests/host/warm-stage/test.c
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "warm-stage.h"
+
+static unsigned char bitmap[2048];
+static NX_WARM_PAIR pairs[8];
+static void select_page(unsigned p) { bitmap[p / 8] |= 1u << (p % 8); }
+int main(void)
+{
+    unsigned count = 99;
+    unsigned base = NXBL_IMAGE_PA >> 12;
+#if XBOX_RAM_MIB == 128
+    (void)base;
+    select_page(0x100);
+    assert(NxWarmPlan(bitmap, 0x78000, pairs, 8, &count) && count == 0);
+    puts("128 MiB image has no overlap with the low-64-MiB handoff: PASS");
+    return 0;
+#endif
+    memset(bitmap, 0, sizeof(bitmap));
+    select_page(base + 0x66); select_page(base + 0x70);
+    select_page(0x100); /* ordinary selected page must not be staging */
+    assert(NxWarmPlan(bitmap, 0x78000, pairs, 8, &count));
+    assert(count == 2 && pairs[0].Original == base + 0x66);
+    assert(pairs[0].Temporary == 0x101 && pairs[1].Temporary == 0x102);
+    assert(pairs[1].Original == base + 0x70);
+
+    /* A saturated low arena must use legal high storage, not selected RAM. */
+    memset(bitmap, 0xff, sizeof(bitmap));
+    bitmap[0x3821 / 8] &= ~(1u << (0x3821 % 8));
+    bitmap[0x3822 / 8] &= ~(1u << (0x3822 % 8));
+    memset(bitmap + base / 8, 0, 0x78 / 8);
+    select_page(base + 0x66); select_page(base + 0x70);
+    assert(NxWarmPlan(bitmap, 0x78000, pairs, 8, &count));
+    assert(count == 2 && pairs[0].Temporary == 0x3821);
+    assert(pairs[1].Temporary == 0x3822);
+    assert(!NxWarmPlan(bitmap, 0x78000, pairs, 1, &count) && count == 0);
+
+    /* Preserve the one viable boot carve, despite its lower address. */
+    memset(bitmap, 0xff, sizeof(bitmap));
+    memset(bitmap + base / 8, 0, 0x78 / 8);
+    select_page(base + 0x70);
+    for (unsigned p = 0x3820; p <= 0x384d; ++p)
+        bitmap[p / 8] &= ~(1u << (p % 8));
+    bitmap[0x3bbf / 8] &= ~(1u << (0x3bbf % 8));
+    assert(NxWarmPlan(bitmap, 0x78000, pairs, 8, &count));
+    assert(count == 1 && pairs[0].Temporary == 0x3bbf);
+    memset(bitmap, 0xff, sizeof(bitmap));
+    memset(bitmap + base / 8, 0, 0x78 / 8);
+    select_page(base + 0x70);
+
+    /* No stash capacity: explicit failure, no partial valid plan. */
+    select_page(0x3821); select_page(0x3822);
+    assert(!NxWarmPlan(bitmap, 0x78000, pairs, 8, &count) && count == 0);
+    assert(!NxWarmPlan(bitmap, 0, pairs, 8, &count));
+    assert(!NxWarmPlan(bitmap, 4097, pairs, 8, &count));
+    assert(!NxWarmPlan(bitmap, NXBL_IMAGE_BYTES + 4096, pairs, 8, &count));
+
+    /* Fixed loader, page tables, image, low structures and video stay out. */
+    assert(!NxWarmTemporaryPage(0xff, 0x78000));
+    assert(!NxWarmTemporaryPage(base, 0x78000));
+    assert(!NxWarmTemporaryPage(base + 0x77, 0x78000));
+    assert(NxWarmTemporaryPage(base + 0x78, 0x78000));
+    assert(!NxWarmTemporaryPage(NXBL_LOADER_PA >> 12, 0x78000));
+    assert(!NxWarmTemporaryPage((NXBL_LOADER_LIMIT_PA >> 12) - 1, 0x78000));
+    assert(!NxWarmTemporaryPage(NXBL_PT_LOW_PA >> 12, 0x78000));
+    assert(!NxWarmTemporaryPage(NXBL_PT_PCR_PA >> 12, 0x78000));
+    assert(!NxWarmTemporaryPage(0x3c00, 0x78000));
+    memset(bitmap, 0, sizeof(bitmap));
+    assert(NxWarmPlan(bitmap, 0x78000, pairs, 8, &count) && count == 0);
+    puts("warm staging planner: PASS");
+}
