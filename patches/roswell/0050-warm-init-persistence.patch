+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile the actual staging planner with both physical layouts."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[3]
+with tempfile.TemporaryDirectory() as temporary:
+    for memory in (64, 128):
+        executable = Path(temporary) / f"planner-{memory}"
+        subprocess.run(["cc", "-Wall", "-Wextra", "-Werror", "-O2", "-g",
+                        "-fsanitize=address,undefined", f"-DXBOX_RAM_MIB={memory}",
+                        "-I", str(root / "boot/nxldr"),
+                        str(Path(__file__).with_name("test.c")),
+                        "-o", str(executable)], check=True)
+        subprocess.run([str(executable)], check=True)
