+NTSTATUS
+NTAPI
+PciIdeXDispatchPnp(
+    _In_ PDEVICE_OBJECT DeviceObject,
+    _Inout_ PIRP Irp)
+{
+#ifdef SARCH_XBOX
+    KIRQL OldIrql;
+    NTSTATUS Status;
+
+    KeAcquireSpinLock(&PciIdeXBootPnpLock, &OldIrql);
+    if (PciIdeXBootPnpSealed)
+    {
+        KeReleaseSpinLock(&PciIdeXBootPnpLock, OldIrql);
+        Irp->IoStatus.Status = STATUS_INVALID_DEVICE_REQUEST;
+        Irp->IoStatus.Information = 0;
+        IoCompleteRequest(Irp, IO_NO_INCREMENT);
+        return STATUS_INVALID_DEVICE_REQUEST;
+    }
+    if (PciIdeXBootPnpActive++ == 0)
+        KeClearEvent(&PciIdeXBootPnpDrained);
+    KeReleaseSpinLock(&PciIdeXBootPnpLock, OldIrql);
+
+    Status = PciIdeXBootDispatchPnp(DeviceObject, Irp);
+
+    KeAcquireSpinLock(&PciIdeXBootPnpLock, &OldIrql);
+    ASSERT(PciIdeXBootPnpActive > 0);
+    if (--PciIdeXBootPnpActive == 0)
+        KeSetEvent(&PciIdeXBootPnpDrained, IO_NO_INCREMENT, FALSE);
+    KeReleaseSpinLock(&PciIdeXBootPnpLock, OldIrql);
+    return Status;
+#else
+    return PciIdeXBootDispatchPnp(DeviceObject, Irp);
+#endif
+}
