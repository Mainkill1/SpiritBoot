+VOID
+PciIdeXInitializeBootPnp(VOID)
+{
+    ASSERT(!PciIdeXBootPnpInitialized);
+    KeInitializeSpinLock(&PciIdeXBootPnpLock);
+    KeInitializeEvent(&PciIdeXBootPnpDrained, NotificationEvent, TRUE);
+    PciIdeXBootPnpInitialized = TRUE;
