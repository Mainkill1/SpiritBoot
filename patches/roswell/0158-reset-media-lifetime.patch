diff --git a/tests/xbe/clean-room-ordinary-reset/main.c b/tests/xbe/clean-room-ordinary-reset/main.c
new file mode 100644
index 0000000000..0cb4892a5e
--- /dev/null
+++ b/tests/xbe/clean-room-ordinary-reset/main.c
@@ -0,0 +1,150 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Two-boot public-API probe for ordinary-reset allocation cleanup.
+ */
+#include <xboxkrnl/xboxkrnl.h>
+#include "../api-regression/tap.h"
+#include <string.h>
+
+#define TEST_PA 0x02010000UL
+#define TEST_PAGES 8UL
+#define TEST_BYTES (TEST_PAGES * PAGE_SIZE)
+#define TEST_MARKER 0x7c
+#define STAGE_MAGIC 0x4f52534dUL
+#define STAGE_PATH "\\Device\\Harddisk0\\Partition3\\ordinary-reset-stage.tmp"
+
+static VOID stop(VOID)
+{
+    tap_drain();
+    HalWriteSMBusValue(0x20, 0x02, FALSE, 0x80);
+    for (;;) __asm__ __volatile__("hlt");
+}
+
+static NTSTATUS open_stage(ACCESS_MASK Access,
+                           ULONG Disposition,
+                           ULONG Options,
+                           PHANDLE Handle)
+{
+    ANSI_STRING name;
+    OBJECT_ATTRIBUTES attributes;
+    IO_STATUS_BLOCK iosb;
+
+    RtlInitAnsiString(&name, STAGE_PATH);
+    InitializeObjectAttributes(&attributes, &name, OBJ_CASE_INSENSITIVE,
+                               NULL, NULL);
+    return NtCreateFile(Handle, Access | SYNCHRONIZE, &attributes, &iosb,
+                        NULL, FILE_ATTRIBUTE_NORMAL,
+                        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        Disposition,
+                        Options | FILE_NON_DIRECTORY_FILE |
+                            FILE_SYNCHRONOUS_IO_NONALERT);
+}
+
+static BOOLEAN read_stage(VOID)
+{
+    HANDLE handle;
+    IO_STATUS_BLOCK iosb;
+    LARGE_INTEGER offset;
+    ULONG magic = 0;
+    NTSTATUS status;
+
+    offset.QuadPart = 0;
+    status = open_stage(GENERIC_READ | DELETE, FILE_OPEN,
+                        FILE_DELETE_ON_CLOSE, &handle);
+    if (!NT_SUCCESS(status)) return FALSE;
+    status = NtReadFile(handle, NULL, NULL, NULL, &iosb, &magic,
+                        sizeof(magic), &offset);
+    NtClose(handle);
+    return NT_SUCCESS(status) && iosb.Information == sizeof(magic) &&
+           magic == STAGE_MAGIC;
+}
+
+static BOOLEAN write_stage(VOID)
+{
+    HANDLE handle;
+    IO_STATUS_BLOCK iosb;
+    LARGE_INTEGER offset;
+    ULONG magic = STAGE_MAGIC;
+    NTSTATUS status;
+
+    offset.QuadPart = 0;
+    status = open_stage(GENERIC_WRITE, FILE_OVERWRITE_IF, 0, &handle);
+    if (!NT_SUCCESS(status)) return FALSE;
+    status = NtWriteFile(handle, NULL, NULL, NULL, &iosb, &magic,
+                         sizeof(magic), &offset);
+    if (NT_SUCCESS(status) && iosb.Information == sizeof(magic))
+        status = NtFlushBuffersFile(handle, &iosb);
+    NtClose(handle);
+    return NT_SUCCESS(status);
+}
+
+int main(void)
+{
+    PVOID allocation;
+
+    if (read_stage())
+    {
+        PVOID former_alias = (PVOID)(0x80000000UL | TEST_PA);
+        ULONG marker_bytes = 0;
+        ULONG zero_bytes = 0;
+        ULONG index;
+        BOOLEAN ownership_cleared;
+        BOOLEAN range_reused;
+
+        ownership_cleared = MmQueryAllocationSize(former_alias) == 0;
+        allocation = MmAllocateContiguousMemoryEx(
+            TEST_BYTES, TEST_PA, TEST_PA + TEST_BYTES - 1,
+            PAGE_SIZE, PAGE_READWRITE);
+        range_reused = allocation != NULL &&
+            MmGetPhysicalAddress(allocation) == TEST_PA;
+        if (range_reused)
+            for (index = 0; index < TEST_BYTES; ++index)
+            {
+                marker_bytes += ((PUCHAR)allocation)[index] == TEST_MARKER;
+                zero_bytes += ((PUCHAR)allocation)[index] == 0;
+            }
+
+        tap_puts("== clean-room-ordinary-reset stage 2 ==\n");
+        tap_version(14);
+        tap_plan(2);
+        if (ownership_cleared)
+            tap_ok(1, "ordinary reset discards selected allocation ownership");
+        else
+            tap_not_ok(1, "ordinary reset discards selected allocation ownership");
+        if (range_reused)
+            tap_ok(2, "former physical range is available to the next title");
+        else
+            tap_not_ok(2, "former physical range is available to the next title");
+        tap_diag_begin();
+        tap_diag_kv("physical_address", "0x%08lx", TEST_PA);
+        tap_diag_kv("marker_bytes_after_allocation", "%lu", marker_bytes);
+        tap_diag_kv("zero_bytes_after_allocation", "%lu", zero_bytes);
+        tap_diag_end();
+        if (allocation != NULL) MmFreeContiguousMemory(allocation);
+        tap_puts(ownership_cleared && range_reused
+                     ? "== clean-room-ordinary-reset end PASS ==\n"
+                     : "== clean-room-ordinary-reset end FAIL ==\n");
+        stop();
+    }
+
+    allocation = MmAllocateContiguousMemoryEx(
+        TEST_BYTES, TEST_PA, TEST_PA + TEST_BYTES - 1,
+        PAGE_SIZE, PAGE_READWRITE);
+    if (allocation == NULL)
+    {
+        tap_puts("== clean-room-ordinary-reset stage 1 allocation FAIL ==\n");
+        stop();
+    }
+    memset(allocation, TEST_MARKER, TEST_BYTES);
+    MmPersistContiguousMemory(allocation, TEST_BYTES, TRUE);
+    if (!write_stage())
+    {
+        tap_puts("== clean-room-ordinary-reset stage 1 file FAIL ==\n");
+        stop();
+    }
+    tap_puts("== clean-room-ordinary-reset stage 1 rebooting ==\n");
+    tap_drain();
+    HalReturnToFirmware(HalRebootRoutine);
+    tap_puts("== clean-room-ordinary-reset reset returned FAIL ==\n");
+    stop();
+    return 1;
+}
