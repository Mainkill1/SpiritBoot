+/* MmPersistContiguousMemory describes what may cross a title chainload.  It
+ * must not turn every SMC reset into a title-state handoff: ordinary reboot,
+ * crash recovery and media replacement start a new allocation lifetime. */
+static volatile LONG PmPersistenceRequested;
+
+VOID NTAPI NxkMmArmPersistence(VOID)
+{
+    InterlockedExchange(&PmPersistenceRequested, 1);
+}
+
+BOOLEAN NTAPI NxkMmTakePersistenceRequest(VOID)
+{
+    return InterlockedExchange(&PmPersistenceRequested, 0) != 0;
+}
 
