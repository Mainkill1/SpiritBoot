+/* Ask the lower optical stack to refresh its media generation.  The native
+ * adapter completes this from TEST UNIT READY and returns its generation in
+ * the optional ULONG output. */
+static NTSTATUS
+XdvdTargetControl(_In_ PDEVICE_OBJECT Target,
+                  _In_ ULONG Code,
+                  _Out_writes_bytes_(OutputLength) PVOID Output,
+                  _In_ ULONG OutputLength,
+                  _Out_opt_ PULONG BytesReturned)
+{
+    KEVENT event;
+    PIRP irp;
+    PIO_STACK_LOCATION next;
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS status;
+
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+    irp = IoBuildDeviceIoControlRequest(Code, Target, NULL, 0, Output,
+                                        OutputLength, FALSE, &event, &iosb);
+    if (irp == NULL)
+        return STATUS_INSUFFICIENT_RESOURCES;
+    next = IoGetNextIrpStackLocation(irp);
+    next->Flags |= SL_OVERRIDE_VERIFY_VOLUME;
+    status = IoCallDriver(Target, irp);
+    if (status == STATUS_PENDING)
+    {
+        KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+        status = iosb.Status;
+    }
+    if (BytesReturned != NULL)
+        *BytesReturned = (ULONG)iosb.Information;
+    return status;
+}
+
+static ULONGLONG
+XdvdFingerprintDescriptor(_In_ PXDVD_VOLUME_DESCRIPTOR Descriptor)
+{
+    const UCHAR *bytes = (const UCHAR *)Descriptor;
+    ULONGLONG hash = 14695981039346656037ULL;
+    ULONG index;
+
+    for (index = 0; index < XDVD_SECTOR_SIZE; ++index)
+    {
+        hash ^= bytes[index];
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static BOOLEAN
+XdvdDescriptorMatches(_In_ PXDVD_VCB Vcb,
+                      _In_ PXDVD_VOLUME_DESCRIPTOR Descriptor)
+{
+    return RtlCompareMemory(Descriptor->Magic0, XDVD_VOLUME_MAGIC,
+                            XDVD_VOLUME_MAGIC_LEN) == XDVD_VOLUME_MAGIC_LEN &&
+           RtlCompareMemory(Descriptor->Magic1, XDVD_VOLUME_MAGIC,
+                            XDVD_VOLUME_MAGIC_LEN) == XDVD_VOLUME_MAGIC_LEN &&
+           Descriptor->RootTableSector == Vcb->RootSector &&
+           Descriptor->RootTableSize == Vcb->RootSize &&
+           Descriptor->Filetime == Vcb->VolumeFiletime &&
+           XdvdFingerprintDescriptor(Descriptor) == Vcb->DescriptorFingerprint;
+}
+
+static NTSTATUS
+XdvdVerifyVolume(_In_ PDEVICE_OBJECT DeviceObject,
+                 _In_ PIO_STACK_LOCATION IrpSp)
+{
+    PXDVD_VCB vcb = (PXDVD_VCB)DeviceObject->DeviceExtension;
+    PXDVD_VOLUME_DESCRIPTOR descriptor;
+    NTSTATUS status;
+    ULONG mediaChange = 0, returned = 0, got = 0;
+    BOOLEAN same;
+
+    if (vcb == NULL || !vcb->Mounted || vcb->TargetDevice == NULL ||
+        IrpSp->Parameters.VerifyVolume.Vpb != vcb->Vpb)
+        return STATUS_WRONG_VOLUME;
+
+    status = XdvdTargetControl(vcb->TargetDevice, IOCTL_CDROM_CHECK_VERIFY,
+                               &mediaChange, sizeof(mediaChange), &returned);
+    if (!NT_SUCCESS(status) && status != STATUS_VERIFY_REQUIRED)
+    {
+        if (status == STATUS_INSUFFICIENT_RESOURCES)
+            return status;
+        vcb->Mounted = FALSE;
+        return STATUS_WRONG_VOLUME;
+    }
+
+    /* A nonzero unchanged generation proves that the lower stack still owns
+     * the mounted medium; avoid an otherwise unnecessary descriptor read. */
+    if (returned >= sizeof(mediaChange) && mediaChange != 0 &&
+        mediaChange == vcb->MediaChangeCount)
+    {
+        if (vcb->Vpb != NULL && vcb->Vpb->RealDevice != NULL)
+            vcb->Vpb->RealDevice->Flags &= ~DO_VERIFY_VOLUME;
+        return STATUS_SUCCESS;
+    }
+
+    descriptor = ExAllocatePoolWithTag(NonPagedPool, XDVD_SECTOR_SIZE, XDVD_TAG);
+    if (descriptor == NULL)
+        return STATUS_INSUFFICIENT_RESOURCES;
+    status = XdvdTargetRead(vcb->TargetDevice,
+                           (ULONGLONG)XDVD_VOLUME_DESCRIPTOR_LBA << XDVD_SECTOR_SHIFT,
+                           XDVD_SECTOR_SIZE, descriptor, &got);
+    same = NT_SUCCESS(status) && got == XDVD_SECTOR_SIZE &&
+           XdvdDescriptorMatches(vcb, descriptor);
+    ExFreePoolWithTag(descriptor, XDVD_TAG);
+
+    if (!same)
+    {
+        vcb->Mounted = FALSE;
+        return status == STATUS_INSUFFICIENT_RESOURCES ? status : STATUS_WRONG_VOLUME;
+    }
+    if (returned >= sizeof(mediaChange))
+        vcb->MediaChangeCount = mediaChange;
+    if (vcb->Vpb != NULL && vcb->Vpb->RealDevice != NULL)
+        vcb->Vpb->RealDevice->Flags &= ~DO_VERIFY_VOLUME;
+    return STATUS_SUCCESS;
+}
