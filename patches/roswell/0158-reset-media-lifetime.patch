diff --git a/tests/host/xdvdfs/check-verify.py b/tests/host/xdvdfs/check-verify.py
new file mode 100644
index 0000000000..166cb3211f
--- /dev/null
+++ b/tests/host/xdvdfs/check-verify.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Pin XDVDFS media identity and lower verification behavior."""
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+
+def function(text: str, name: str) -> str:
+    match = re.search(r"\n(?:static\s+)?(?:BOOLEAN|NTSTATUS|ULONGLONG)\s*(?:NTAPI\s*)?\n?" +
+                      re.escape(name) + r"\s*\([^;]*?\)\s*\n\{", text, re.S)
+    if not match:
+        raise AssertionError(f"missing production function {name}")
+    start = text.index("{", match.start())
+    end, depth = start + 1, 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[match.start():end]
+
+
+root = Path(sys.argv[1]).resolve()
+out = Path(sys.argv[2]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+source = (root / "drivers/filesystems/xdvdfs/xdvdfs.c").read_text()
+fingerprint = function(source, "XdvdFingerprintDescriptor")
+same = function(source, "XdvdDescriptorMatches")
+verify = function(source, "XdvdVerifyVolume")
+mount = function(source, "XdvdMountVolume")
+assert "IOCTL_CDROM_CHECK_VERIFY" in verify
+assert "XdvdTargetRead" in verify
+assert "Mounted = FALSE" in verify or "Mounted=FALSE" in verify
+assert "XdvdTargetControl" not in mount, "mount must not perturb the cold-load command stream"
+for dispatch in ("XdvdDispatchRead", "XdvdDispatchWrite",
+                 "XdvdDispatchQueryInformation", "XdvdDispatchSetInformation",
+                 "XdvdDispatchDirectoryControl"):
+    assert "Mounted" in function(source, dispatch), f"{dispatch} accepts a stale VCB"
+
+unit = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+typedef uint8_t UCHAR; typedef uint32_t ULONG; typedef uint64_t ULONGLONG;
+typedef int BOOLEAN;
+#define _In_
+#define TRUE 1
+#define FALSE 0
+#define XDVD_VOLUME_MAGIC "MICROSOFT*XBOX*MEDIA"
+#define XDVD_VOLUME_MAGIC_LEN 20u
+#define XDVD_SECTOR_SIZE 2048u
+#define RtlCompareMemory(a,b,n) same_bytes((a),(b),(n))
+static unsigned long same_bytes(const void *a,const void *b,unsigned long n)
+{ unsigned long i=0;while(i<n&&((const unsigned char*)a)[i]==((const unsigned char*)b)[i])++i;return i; }
+typedef struct { UCHAR Magic0[20]; ULONG RootTableSector,RootTableSize; ULONGLONG Filetime; UCHAR Unused[0x7c8]; UCHAR Magic1[20]; } XDVD_VOLUME_DESCRIPTOR,*PXDVD_VOLUME_DESCRIPTOR;
+typedef struct { ULONG RootSector,RootSize; ULONGLONG VolumeFiletime,DescriptorFingerprint; } XDVD_VCB,*PXDVD_VCB;
+''' + fingerprint + same + r'''
+int main(void)
+{
+ XDVD_VCB v={37,8192,0x1122334455667788ULL,0};XDVD_VOLUME_DESCRIPTOR d;
+ memset(&d,0,sizeof(d));memcpy(d.Magic0,XDVD_VOLUME_MAGIC,20);memcpy(d.Magic1,XDVD_VOLUME_MAGIC,20);
+ d.RootTableSector=v.RootSector;d.RootTableSize=v.RootSize;d.Filetime=v.VolumeFiletime;
+ v.DescriptorFingerprint=XdvdFingerprintDescriptor(&d);
+ assert(XdvdDescriptorMatches(&v,&d));
+ d.RootTableSector++;assert(!XdvdDescriptorMatches(&v,&d));d.RootTableSector=v.RootSector;
+ d.RootTableSize++;assert(!XdvdDescriptorMatches(&v,&d));d.RootTableSize=v.RootSize;
+ d.Filetime++;assert(!XdvdDescriptorMatches(&v,&d));d.Filetime=v.VolumeFiletime;
+ d.Magic1[0]^=1;assert(!XdvdDescriptorMatches(&v,&d));d.Magic1[0]^=1;
+ d.Unused[0]^=1;assert(!XdvdDescriptorMatches(&v,&d));
+ return 0;
+}
+'''
+path = out / "verify.c"
+path.write_text(unit)
+binary = out / "verify"
+subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", str(path), "-o", str(binary)], check=True)
+subprocess.run([str(binary)], check=True)
+print("PASS: XDVDFS checks lower media and fingerprints the complete descriptor")
