+++ b/tests/host/cache/check-full-overwrite.py
@@ -0,0 +1,237 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production full-block overwrite claim lifecycle."""
+
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+source = (root / "ntoskrnl/xb/mm/cache.c").read_text()
+spec = importlib.util.spec_from_file_location(
+    "extract", root / "tests/host/kernel-performance/check.py")
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+
+bodies = ""
+for name in (
+    "NxcAcquireFullOverwriteLocked",
+    "NxcPublishFullOverwriteLocked",
+    "NxcRollbackFullOverwriteLocked",
+):
+    body = extract.function(source, name)
+    assert "NxcReadBlock" not in body
+    bodies += body + "\n"
+
+copy_write = extract.function(source, "CcCopyWrite")
+zero_data = extract.function(source, "CcZeroData")
+for body in (copy_write, zero_data):
+    assert "FullOverwrite && Wait" in body
+    assert "NxcAcquireFullOverwriteLocked" in body
+    assert "NxcPublishFullOverwriteLocked" in body
+assert "NxcRollbackFullOverwriteLocked" in copy_write
+assert "NxcRollbackFullOverwriteLocked" not in zero_data
+
+shim = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef int BOOLEAN;
+typedef int64_t LONGLONG;
+typedef uint32_t ULONG;
+typedef uint64_t ULONGLONG;
+typedef void VOID;
+#define IN
+#define OUT
+#define TRUE 1
+#define FALSE 0
+#define ASSERT assert
+#define NXC_BLOCK_SIZE 16384
+#define PAGE_SIZE 4096
+
+typedef struct _LIST_ENTRY {
+    struct _LIST_ENTRY *Flink;
+    struct _LIST_ENTRY *Blink;
+} LIST_ENTRY, *PLIST_ENTRY;
+static void InitializeListHead(PLIST_ENTRY l) { l->Flink=l->Blink=l; }
+static int IsListEmpty(PLIST_ENTRY l) { return l->Flink==l; }
+static void InsertTailList(PLIST_ENTRY h, PLIST_ENTRY e) {
+    e->Blink=h->Blink; e->Flink=h; h->Blink->Flink=e; h->Blink=e;
+}
+static void RemoveEntryList(PLIST_ENTRY e) {
+    e->Blink->Flink=e->Flink; e->Flink->Blink=e->Blink;
+    InitializeListHead(e);
+}
+
+typedef struct _NXC_MAP { int Id; } NXC_MAP;
+typedef struct _NXC_BLOCK {
+    NXC_MAP *Map;
+    LONGLONG Offset;
+    unsigned char *Data;
+    LIST_ENTRY LruLink;
+    LIST_ENTRY BusyWaiters;
+    ULONG RefCount;
+    BOOLEAN Valid;
+    BOOLEAN Dirty;
+    BOOLEAN Busy;
+} NXC_BLOCK;
+typedef struct _NXC_OVERWRITE_CLAIM {
+    NXC_BLOCK *Block;
+    BOOLEAN NewClaim;
+} NXC_OVERWRITE_CLAIM;
+
+typedef struct _NXC_CACHE_WAIT_COUNTERS {
+    ULONGLONG SpuriousRetryCount;
+} NXC_CACHE_WAIT_COUNTERS;
+static NXC_CACHE_WAIT_COUNTERS NxcCacheWaitCounters;
+
+typedef struct _NXC_CACHE_OVERWRITE_COUNTERS {
+    ULONGLONG FullOverwriteAttempts;
+    ULONGLONG FullOverwriteClaims;
+    ULONGLONG ColdReadsSkipped;
+    ULONGLONG BytesReadSkipped;
+    ULONGLONG RollbackCount;
+    ULONGLONG FallbackPartialCount;
+} NXC_CACHE_OVERWRITE_COUNTERS;
+#ifdef NXK_CACHE_OVERWRITE_COUNTERS
+NXC_CACHE_OVERWRITE_COUNTERS NxcCacheOverwriteCounters;
+#define NXC_OVERWRITE_COUNT(Field, Amount) \
+    (NxcCacheOverwriteCounters.Field += (Amount))
+#else
+#define NXC_OVERWRITE_COUNT(Field, Amount) ((VOID)0)
+#endif
+
+static LIST_ENTRY NxcLruList;
+static NXC_BLOCK block;
+static unsigned char data[NXC_BLOCK_SIZE];
+static unsigned capacity_wakes, busy_wakes, waits;
+static NXC_MAP *reuse_map;
+
+static NXC_BLOCK *NxcLookupBlock(NXC_MAP *map, LONGLONG offset) {
+    return block.Data != NULL && block.Map == map && block.Offset == offset
+        ? &block : NULL;
+}
+static NXC_BLOCK *NxcClaimSlot(BOOLEAN wait) {
+    assert(wait && block.Data != NULL && block.RefCount == 0 && !block.Busy);
+    if (block.Map != NULL) {
+        assert(block.Valid && !block.Dirty);
+        RemoveEntryList(&block.LruLink);
+        block.Map=NULL; block.Valid=FALSE;
+    }
+    block.RefCount=1; return &block;
+}
+static void NxcPutBlock(NXC_BLOCK *b) {
+    assert(b->RefCount); b->RefCount--;
+    if (!b->RefCount) capacity_wakes++;
+}
+static void NxcPublishBlockIdleLocked(NXC_BLOCK *b) {
+    assert(b->Busy); b->Busy=FALSE; busy_wakes++; capacity_wakes++;
+}
+static void NxcWaitOnListLocked(PLIST_ENTRY list) {
+    (void)list; waits++;
+    assert(block.Busy && reuse_map != NULL);
+    RemoveEntryList(&block.LruLink);
+    block.Busy=FALSE; block.Map=reuse_map; block.Valid=TRUE;
+    block.RefCount=0; InsertTailList(&NxcLruList,&block.LruLink);
+}
+static void reset(void) {
+    memset(&block,0,sizeof(block)); memset(data,0xcc,sizeof(data));
+    block.Data=data; InitializeListHead(&NxcLruList);
+    InitializeListHead(&block.LruLink); InitializeListHead(&block.BusyWaiters);
+    capacity_wakes=busy_wakes=waits=0; reuse_map=NULL;
+#ifdef NXK_CACHE_OVERWRITE_COUNTERS
+    memset(&NxcCacheOverwriteCounters,0,sizeof(NxcCacheOverwriteCounters));
+#endif
+}
+'''
+
+cases = r'''
+static void test_absent_publish(void) {
+    NXC_MAP map={1}; NXC_OVERWRITE_CLAIM claim={0}; reset();
+    NxcAcquireFullOverwriteLocked(&map,0,&claim);
+    assert(claim.Block==&block && claim.NewClaim);
+    assert(block.Map==&map && block.Busy && !block.Valid && block.RefCount==1);
+    memset(block.Data,0x5a,NXC_BLOCK_SIZE);
+    NxcPublishFullOverwriteLocked(&claim);
+    assert(claim.Block==NULL && block.Valid && block.Dirty && !block.Busy);
+    assert(block.RefCount==0);
+    for (unsigned i=0;i<NXC_BLOCK_SIZE;i++) assert(block.Data[i]==0x5a);
+#ifdef NXK_CACHE_OVERWRITE_COUNTERS
+    assert(NxcCacheOverwriteCounters.FullOverwriteClaims==1);
+    assert(NxcCacheOverwriteCounters.ColdReadsSkipped==1);
+    assert(NxcCacheOverwriteCounters.BytesReadSkipped==NXC_BLOCK_SIZE);
+#endif
+}
+static void test_valid_reuse(void) {
+    NXC_MAP map={1}; NXC_OVERWRITE_CLAIM claim={0}; reset();
+    block.Map=&map; block.Valid=TRUE; InsertTailList(&NxcLruList,&block.LruLink);
+    NxcAcquireFullOverwriteLocked(&map,0,&claim);
+    assert(!claim.NewClaim && !block.Busy && block.RefCount==1);
+    memset(block.Data,0x71,NXC_BLOCK_SIZE);
+    NxcPublishFullOverwriteLocked(&claim);
+    assert(block.Valid && block.Dirty && block.RefCount==0);
+#ifdef NXK_CACHE_OVERWRITE_COUNTERS
+    assert(NxcCacheOverwriteCounters.ColdReadsSkipped==0);
+#endif
+}
+static void test_invalid_recovery(void) {
+    NXC_MAP map={1}; NXC_OVERWRITE_CLAIM claim={0}; reset();
+    block.Map=&map; InsertTailList(&NxcLruList,&block.LruLink);
+    NxcAcquireFullOverwriteLocked(&map,0,&claim);
+    assert(claim.NewClaim && block.Busy);
+    memset(block.Data,0x22,NXC_BLOCK_SIZE);
+    NxcPublishFullOverwriteLocked(&claim);
+    assert(block.Valid && block.Dirty && !block.Busy && block.RefCount==0);
+}
+static void test_fault_rollback(void) {
+    NXC_MAP map={1}; NXC_OVERWRITE_CLAIM claim={0}; reset();
+    NxcAcquireFullOverwriteLocked(&map,0,&claim);
+    memset(block.Data,0x33,NXC_BLOCK_SIZE/2);
+    NxcRollbackFullOverwriteLocked(&claim);
+    assert(claim.Block==NULL && block.Map==NULL && block.Offset==0);
+    assert(!block.Valid && !block.Dirty && !block.Busy && block.RefCount==0);
+    assert(IsListEmpty(&NxcLruList) && busy_wakes==1 && capacity_wakes>=1);
+#ifdef NXK_CACHE_OVERWRITE_COUNTERS
+    assert(NxcCacheOverwriteCounters.RollbackCount==1);
+#endif
+}
+static void test_busy_generation_relookup(void) {
+    NXC_MAP wanted={1}, other={2}; NXC_OVERWRITE_CLAIM claim={0}; reset();
+    block.Map=&wanted; block.Busy=TRUE; block.RefCount=1;
+    InsertTailList(&NxcLruList,&block.LruLink); reuse_map=&other;
+    NxcAcquireFullOverwriteLocked(&wanted,0,&claim);
+    assert(waits==1 && claim.NewClaim && block.Map==&wanted && block.Busy);
+    assert(block.RefCount==1);
+    memset(block.Data,0x44,NXC_BLOCK_SIZE);
+    NxcPublishFullOverwriteLocked(&claim);
+    assert(block.Valid && block.Dirty && !block.Busy);
+}
+int main(void) {
+    test_absent_publish(); test_valid_reuse(); test_invalid_recovery();
+    test_fault_rollback(); test_busy_generation_relookup();
+    puts("cache full overwrite: claim, publish, rollback, reuse PASS");
+    return 0;
+}
+'''
+
+fixture = out / "full-overwrite.c"
+fixture.write_text(shim + bodies + cases)
+for enabled in (False, True):
+    binary = out / ("full-overwrite-counters" if enabled else "full-overwrite")
+    command = [
+        "cc", "-std=c11", "-O1", "-g", "-Wall", "-Wextra", "-Werror",
+        "-fsanitize=address,undefined", "-DNXK_CACHE_WAIT_COUNTERS=1",
+    ]
+    if enabled:
+        command.append("-DNXK_CACHE_OVERWRITE_COUNTERS=1")
+    subprocess.run(command + [str(fixture), "-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True,
+                   env={"ASAN_OPTIONS": "detect_leaks=0"})
+    symbols = subprocess.check_output(["nm", str(binary)], text=True)
+    assert ("NxcCacheOverwriteCounters" in symbols) == enabled
