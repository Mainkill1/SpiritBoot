+/* Exercise the cold full-block write path through the file API, then mix in
+ * a partial update to prove that bytes outside the partial range are still
+ * read and preserved.  The host production-body fixture supplies the direct
+ * lower-read counter oracle. */
+static bool t_full_overwrite_roundtrip(void)
+{
+    HANDLE h = NULL;
+    IO_STATUS_BLOCK iosb;
+    NTSTATUS s;
+    bool ok;
+
+    unlink_path(CACHE_A);
+    s = open_path(CACHE_A, &h, GENERIC_READ | GENERIC_WRITE,
+                  FILE_OVERWRITE_IF, 0, &iosb);
+    ASSERT_NTSTATUS(s, STATUS_SUCCESS);
+    ok = write_at(h, 0, CACHE_BLOCK * 2, 0x19);
+    if (ok)
+        ok = NtFlushBuffersFile(h, &iosb) == STATUS_SUCCESS;
+    NtClose(h);
+    FscInvalidateIdleBlocks();
+    if (!ok) {
+        unlink_path(CACHE_A);
+        FAIL_AND_RETURN("prepare full-overwrite file");
+    }
+
+    s = open_path(CACHE_A, &h, GENERIC_READ | GENERIC_WRITE,
+                  FILE_OPEN, 0, &iosb);
+    ASSERT_NTSTATUS(s, STATUS_SUCCESS);
+    ok = write_at(h, 0, CACHE_BLOCK, 0xD4) &&
+         write_at(h, CACHE_BLOCK + 4096, 4096, 0x77);
+    if (ok)
+        ok = NtFlushBuffersFile(h, &iosb) == STATUS_SUCCESS;
+    NtClose(h);
+    FscInvalidateIdleBlocks();
+
+    if (ok) {
+        s = open_path(CACHE_A, &h, GENERIC_READ, FILE_OPEN, 0, &iosb);
+        if (!NT_SUCCESS(s)) {
+            unlink_path(CACHE_A);
+            FAIL_AND_RETURN("reopen full-overwrite file -> 0x%08x",
+                            (unsigned)s);
+        }
+        ok = read_check_at(h, 0, CACHE_BLOCK, 0xD4,
+                           "full-block overwrite") &&
+             read_check_at(h, CACHE_BLOCK, 4096, 0x19,
+                           "partial prefix preserved") &&
+             read_check_at(h, CACHE_BLOCK + 4096, 4096, 0x77,
+                           "partial replacement") &&
+             read_check_at(h, CACHE_BLOCK + 8192, 8192, 0x19,
+                           "partial suffix preserved");
+        NtClose(h);
+    }
+
+    unlink_path(CACHE_A);
+    return ok;
+}
+
 /* Two callers enter the same cold cache block together.  The first request
  * owns the fill; the second must wait for that exact busy generation, then
