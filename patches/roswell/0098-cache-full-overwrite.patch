+/* Claim a complete block without reading its old contents.  The caller holds
+ * NxcMutex and promises to initialize every byte before publishing a new
+ * claim.  Existing valid blocks keep the ordinary referenced-block contract.
+ * Busy and capacity waits always relookup after #210's completion wake. */
+static VOID
+NxcAcquireFullOverwriteLocked(
+    IN NXC_MAP *Map,
+    IN LONGLONG Offset,
+    OUT NXC_OVERWRITE_CLAIM *Claim)
+{
+    NXC_BLOCK *Block;
+
+    ASSERT((Offset & (NXC_BLOCK_SIZE - 1)) == 0);
+
+    for (;;)
+    {
+        Block = NxcLookupBlock(Map, Offset);
+        if (Block != NULL)
+        {
+            if (Block->Busy)
+            {
+                NxcWaitOnListLocked(&Block->BusyWaiters);
+#ifdef NXK_CACHE_WAIT_COUNTERS
+                Block = NxcLookupBlock(Map, Offset);
+                if (Block != NULL && Block->Busy)
+                    NxcCacheWaitCounters.SpuriousRetryCount++;
+#endif
+                continue;
+            }
+
+            Block->RefCount++;
+            RemoveEntryList(&Block->LruLink);
+            InsertTailList(&NxcLruList, &Block->LruLink);
+            Claim->Block = Block;
+            Claim->NewClaim = !Block->Valid;
+            if (Claim->NewClaim)
+            {
+                ASSERT(!Block->Dirty);
+                Block->Busy = TRUE;
+            }
+            return;
+        }
+
+        Block = NxcClaimSlot(TRUE);
+        ASSERT(Block != NULL);
+
+        /* Claiming a dirty victim can drop the mutex for writeback. */
+        if (NxcLookupBlock(Map, Offset) != NULL)
+        {
+            Block->Map = NULL;
+            NxcPutBlock(Block);
+            continue;
+        }
+
+        Block->Map = Map;
+        Block->Offset = Offset;
+        Block->Valid = FALSE;
+        Block->Dirty = FALSE;
+        Block->Busy = TRUE;
+        InsertTailList(&NxcLruList, &Block->LruLink);
+        Claim->Block = Block;
+        Claim->NewClaim = TRUE;
+        return;
+    }
+}
+
+static VOID
+NxcPublishFullOverwriteLocked(
+    IN OUT NXC_OVERWRITE_CLAIM *Claim)
+{
+    NXC_BLOCK *Block = Claim->Block;
+
+    ASSERT(Block != NULL && Block->RefCount > 0);
+    Block->Dirty = TRUE;
+    if (Claim->NewClaim)
+    {
+        ASSERT(Block->Busy && !Block->Valid);
+        Block->Valid = TRUE;
+        NXC_OVERWRITE_COUNT(FullOverwriteClaims, 1);
+        NXC_OVERWRITE_COUNT(ColdReadsSkipped, 1);
+        NXC_OVERWRITE_COUNT(BytesReadSkipped, NXC_BLOCK_SIZE);
+        NxcPublishBlockIdleLocked(Block);
+    }
+    NxcPutBlock(Block);
+    Claim->Block = NULL;
+}
+
+static VOID
+NxcRollbackFullOverwriteLocked(
+    IN OUT NXC_OVERWRITE_CLAIM *Claim)
+{
+    NXC_BLOCK *Block = Claim->Block;
+
+    ASSERT(Claim->NewClaim && Block != NULL);
+    ASSERT(Block->Busy && !Block->Valid && Block->RefCount > 0);
+    RemoveEntryList(&Block->LruLink);
+    Block->Map = NULL;
+    Block->Offset = 0;
+    Block->Dirty = FALSE;
+    NXC_OVERWRITE_COUNT(RollbackCount, 1);
+    NxcPublishBlockIdleLocked(Block);
+    NxcPutBlock(Block);
+    Claim->Block = NULL;
+}
+
