diff --git a/drivers/storage/class/nxstorage/cache_query.c b/drivers/storage/class/nxstorage/cache_query.c
new file mode 100644
index 00000000..3a4fcd3b
--- /dev/null
+++ b/drivers/storage/class/nxstorage/cache_query.c
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cache_query.h"
+
+static uint32_t read_u32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static void write_u32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)v;
+    p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16);
+    p[3] = (uint8_t)(v >> 24);
+}
+
+nx_cache_reply nx_cache_query_encode(nx_cache_snapshot snapshot,
+                                    const void *input, size_t input_bytes,
+                                    void *output, size_t output_bytes)
+{
+    nx_cache_reply r = {NX_CACHE_REPLY_INPUT_SHORT, 0};
+    const uint8_t *in = input;
+    uint8_t *out = output;
+    uint32_t property, query_type, cache_state = 0;
+    int flush_proved = 0;
+
+    if (input_bytes < NX_CACHE_QUERY_BYTES) return r;
+    r.status = NX_CACHE_REPLY_INVALID;
+    if (!in) return r;
+    /* Read both fields before any aliased output byte is changed. */
+    property = read_u32(in + NX_CACHE_OFF_PROPERTY);
+    query_type = read_u32(in + NX_CACHE_OFF_QUERY_TYPE);
+    r.status = NX_CACHE_REPLY_UNSUPPORTED;
+    if (property != NX_CACHE_PROPERTY_ID ||
+        (query_type != NX_CACHE_STANDARD_QUERY && query_type != NX_CACHE_EXISTS_QUERY))
+        return r;
+
+    r.status = NX_CACHE_REPLY_INVALID;
+    if (snapshot.profile > NX_CACHE_PROFILE_OPTICAL ||
+        snapshot.command_sets_known > 1 || snapshot.cache_supported > 1 ||
+        snapshot.cache_active > 1 || snapshot.flush_selection_known > 1 ||
+        (snapshot.selected_flush != NX_CACHE_FLUSH_NONE &&
+         snapshot.selected_flush != NX_CACHE_FLUSH_REGULAR &&
+         snapshot.selected_flush != NX_CACHE_FLUSH_EXTENDED)) return r;
+    r.status = NX_CACHE_REPLY_UNSUPPORTED;
+    if (snapshot.profile != NX_CACHE_PROFILE_ATA) return r;
+    r.status = NX_CACHE_REPLY_OK;
+    if (query_type == NX_CACHE_EXISTS_QUERY) return r;
+
+    r.status = NX_CACHE_REPLY_OUTPUT_SHORT;
+    if (output_bytes < NX_CACHE_HEADER_BYTES) return r;
+    r.status = NX_CACHE_REPLY_INVALID;
+    if (!out) return r;
+
+    /* Supported/active contradictions and absent recognition retain Unknown.
+     * No-command success is never an input to capability qualification. */
+    if (snapshot.command_sets_known && snapshot.cache_supported) {
+        cache_state = snapshot.cache_active ? 2u : 1u;
+        flush_proved = snapshot.flush_selection_known &&
+            snapshot.selected_flush != NX_CACHE_FLUSH_NONE;
+    }
+    r.status = NX_CACHE_REPLY_OK;
+    r.information = output_bytes < NX_CACHE_DESCRIPTOR_BYTES ?
+        NX_CACHE_HEADER_BYTES : NX_CACHE_DESCRIPTOR_BYTES;
+    for (size_t i = 0; i < r.information; ++i) out[i] = 0;
+    /* Version is this structure's byte size; Size includes any appended data.
+     * This fixed profile appends none. Unknown enums and all padding stay zero. */
+    write_u32(out + NX_CACHE_OFF_VERSION, NX_CACHE_DESCRIPTOR_BYTES);
+    write_u32(out + NX_CACHE_OFF_SIZE, NX_CACHE_DESCRIPTOR_BYTES);
+    if (r.information == NX_CACHE_DESCRIPTOR_BYTES) {
+        write_u32(out + NX_CACHE_OFF_ENABLED, cache_state);
+        out[NX_CACHE_OFF_FLUSH] = (uint8_t)flush_proved;
+    }
+    return r;
+}
diff --git a/drivers/storage/class/nxstorage/cache_query.h b/drivers/storage/class/nxstorage/cache_query.h
new file mode 100644
index 00000000..551e418d
--- /dev/null
+++ b/drivers/storage/class/nxstorage/cache_query.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NX_CACHE_QUERY_H
+#define NX_CACHE_QUERY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Approved Xbox x86 public interface facts; these are byte extents, not structs. */
+enum {
+    NX_CACHE_QUERY_BYTES = 12,
+    NX_CACHE_HEADER_BYTES = 8,
+    NX_CACHE_DESCRIPTOR_BYTES = 28,
+    NX_CACHE_PROPERTY_ID = 4,
+    NX_CACHE_STANDARD_QUERY = 0,
+    NX_CACHE_EXISTS_QUERY = 1,
+    NX_CACHE_OFF_VERSION = 0,
+    NX_CACHE_OFF_SIZE = 4,
+    NX_CACHE_OFF_TYPE = 8,
+    NX_CACHE_OFF_ENABLED = 12,
+    NX_CACHE_OFF_CHANGEABLE = 16,
+    NX_CACHE_OFF_WRITE_THROUGH = 20,
+    NX_CACHE_OFF_FLUSH = 24,
+    NX_CACHE_OFF_POWER = 25,
+    NX_CACHE_OFF_NV = 26,
+    NX_CACHE_OFF_PADDING = 27,
+    NX_CACHE_OFF_PROPERTY = 0,
+    NX_CACHE_OFF_QUERY_TYPE = 4
+};
+
+enum nx_cache_profile {
+    NX_CACHE_PROFILE_UNKNOWN = 0,
+    NX_CACHE_PROFILE_ATA = 1,
+    NX_CACHE_PROFILE_OPTICAL = 2
+};
+
+enum nx_cache_flush {
+    NX_CACHE_FLUSH_NONE = 0,
+    NX_CACHE_FLUSH_REGULAR = 0xe7,
+    NX_CACHE_FLUSH_EXTENDED = 0xea
+};
+
+/* All flags must be exactly zero/one. The future lower glue captures coherent
+ * facts before calling. A selected opcode is the actual retained selector's
+ * result, including its LBA48 requirements, never a guessed support bit. */
+typedef struct nx_cache_snapshot {
+    uint32_t profile;
+    uint32_t command_sets_known;
+    uint32_t cache_supported;
+    uint32_t cache_active;
+    uint32_t flush_selection_known;
+    uint32_t selected_flush;
+} nx_cache_snapshot;
+
+/* Native adapter mapping, in this order: SUCCESS, BUFFER_TOO_SMALL,
+ * NOT_SUPPORTED, INFO_LENGTH_MISMATCH, INVALID_PARAMETER. */
+enum nx_cache_reply_status {
+    NX_CACHE_REPLY_OK = 0,
+    NX_CACHE_REPLY_INPUT_SHORT,
+    NX_CACHE_REPLY_UNSUPPORTED,
+    NX_CACHE_REPLY_OUTPUT_SHORT,
+    NX_CACHE_REPLY_INVALID
+};
+
+typedef struct nx_cache_reply {
+    enum nx_cache_reply_status status;
+    size_t information;
+} nx_cache_reply;
+
+/* Pure bounded encoder. Input/output may alias and may be unaligned. Caller
+ * supplies actual resident readable/writable extents and a coherent snapshot.
+ * No error writes output. Exists returns no bytes; standard returns 8 or 28.
+ * Snapshot/output validity does not certify hardware persistence or FUA. */
+nx_cache_reply nx_cache_query_encode(nx_cache_snapshot snapshot,
+                                    const void *input, size_t input_bytes,
+                                    void *output, size_t output_bytes);
+
+#endif
