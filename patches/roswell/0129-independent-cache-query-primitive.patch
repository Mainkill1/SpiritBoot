+
+/* The approved input is a numeric declaration packet, with no helper bodies.
+ * This verifies convergence with that packet; native declaration assertions
+ * remain mandatory in any future glue's actual compiler/build environment. */
+#define ABI(a, b) _Static_assert((a) == (b), #a " differs from approved target ABI")
+ABI(NX_CACHE_QUERY_BYTES, NX_CACHE_ABI_STORAGE_PROPERTY_QUERY_SIZE);
+ABI(NX_CACHE_HEADER_BYTES, NX_CACHE_ABI_STORAGE_DESCRIPTOR_HEADER_SIZE);
+ABI(NX_CACHE_DESCRIPTOR_BYTES, NX_CACHE_ABI_STORAGE_WRITE_CACHE_PROPERTY_SIZE);
