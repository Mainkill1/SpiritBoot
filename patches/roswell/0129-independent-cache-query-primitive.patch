+ABI(NX_CACHE_OFF_FLUSH, NX_CACHE_ABI_STORAGE_WRITE_CACHE_PROPERTY_FLUSHCACHESUPPORTED_OFFSET);
+ABI(NX_CACHE_OFF_POWER, NX_CACHE_ABI_STORAGE_WRITE_CACHE_PROPERTY_USERDEFINEDPOWERPROTECTION_OFFSET);
+ABI(NX_CACHE_OFF_NV, NX_CACHE_ABI_STORAGE_WRITE_CACHE_PROPERTY_NVCACHEENABLED_OFFSET);
+ABI(NX_CACHE_OFF_PADDING + 1, NX_CACHE_ABI_STORAGE_WRITE_CACHE_PROPERTY_SIZE);
