+ABI(NX_CACHE_STANDARD_QUERY, NX_CACHE_ABI_PROPERTYSTANDARDQUERY);
+ABI(NX_CACHE_EXISTS_QUERY, NX_CACHE_ABI_PROPERTYEXISTSQUERY);
+ABI(NX_CACHE_OFF_PROPERTY, NX_CACHE_ABI_STORAGE_PROPERTY_QUERY_PROPERTYID_OFFSET);
+ABI(NX_CACHE_OFF_QUERY_TYPE, NX_CACHE_ABI_STORAGE_PROPERTY_QUERY_QUERYTYPE_OFFSET);
+ABI(NX_CACHE_OFF_VERSION, NX_CACHE_ABI_STORAGE_WRITE_CACHE_PROPERTY_VERSION_OFFSET);
