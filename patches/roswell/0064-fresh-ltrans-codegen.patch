@@ -77,6 +77,15 @@ ar = os.environ.get("AR", "i686-w64-mingw32-ar")
 # -save-temps leaves `<output base>.ltrans<N>.ltrans.o` in the link directory.
 # GCC deletes them otherwise, and only GCC 16's -flto-incremental cache keeps
 # them anywhere else -- CI's GCC 13 has no cache, so ask for them explicitly.
+# GCC's generated LTRANS makefile can reuse a previous saved object despite
+# regenerated partition IR. Remove only this output's numbered saved codegen
+# files so a repeated link cannot silently retain old function bodies.
+output_base = os.path.splitext(os.path.abspath(out))[0]
+saved_codegen = re.compile(re.escape(os.path.basename(output_base)) +
+                           r"\.ltrans[0-9]+\.ltrans\.(?:o|s)\Z")
+for path in glob.glob(output_base + ".ltrans*.ltrans.*"):
+    if saved_codegen.fullmatch(os.path.basename(path)):
+        os.unlink(path)
 rc = run(LINK + ["-save-temps"])
 if rc != 0:
     sys.exit(rc)
