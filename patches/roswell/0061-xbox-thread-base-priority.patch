diff --git a/ntoskrnl/xb/xbe.c b/ntoskrnl/xb/xbe.c
index 0f442f1c..bbb6f87c 100644
--- a/ntoskrnl/xb/xbe.c
+++ b/ntoskrnl/xb/xbe.c
@@ -3001,6 +3001,33 @@ XeResolveThread(_In_opt_ PVOID Thread)
     return Resolved;
 }
 
+/* The Xbox public thread pointer is a shadow, not an NT KTHREAD.  Keep
+ * object-manager pointers valid too, as for the APC entry points. */
+LONG NTAPI
+XeKeSetBasePriorityThread(PVOID Thread, LONG Increment)
+{
+    PKTHREAD Native = XeResolveThread(Thread);
+    LONG Previous;
+
+    if (Native == NULL)
+        return 0;
+
+    Previous = KeSetBasePriorityThread(Native, Increment);
+    if (Native->XeXboxFs4)
+    {
+        /* On the single-CPU Xbox, prevent a concurrent setter or DPC from
+         * changing a field between its load and public-shadow store. Keep
+         * the native setter's own scheduling boundary unchanged. */
+        KIRQL OldIrql = KeRaiseIrqlToDpcLevel();
+        /* Public Xbox offsets also used by NxkPublishThreadProcess.  Do not
+         * republish the whole shadow: its APC queues may already be live. */
+        Native->XeXboxShadow[0x32] = (UCHAR)Native->Priority;
+        Native->XeXboxShadow[0x70] = (UCHAR)Native->BasePriority;
+        KeLowerIrql(OldIrql);
+    }
+    return Previous;
+}
+
 static VOID NTAPI
 XeApcKernelTrampoline(PKAPC Apc,
                         PKNORMAL_ROUTINE *NormalRoutine,
