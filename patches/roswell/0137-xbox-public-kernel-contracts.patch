+static BOOLEAN
+PciCfgAccessBlocked(UCHAR BusNumber, PCI_SLOT_NUMBER Slot)
+{
+    return (BusNumber == 0 && Slot.u.bits.DeviceNumber == 0 &&
+            (Slot.u.bits.FunctionNumber == 1 ||
+             Slot.u.bits.FunctionNumber == 2)) ||
+           (BusNumber == 1 && Slot.u.bits.DeviceNumber != 0);
+}
+
+static ULONG
+PciCfgTransferWidth(ULONG RegisterNumber, ULONG Length)
+{
+    ULONG Remainder = Length & 3;
+
+    switch (RegisterNumber & 3)
+    {
+        case 0:
+            return Remainder == 0 ? 4 : Remainder == 1 ? 1 : 2;
+        case 2:
+            return Remainder == 1 ? 1 : 2;
+        default:
+            return 1;
+    }
+}
+
+VOID
+PciCfgReadWriteBuffer(ULONG BusNumber, ULONG SlotNumber,
+                      ULONG RegisterNumber, PVOID Buffer,
+                      ULONG Length, BOOLEAN WritePCISpace)
+{
+    PCI_SLOT_NUMBER Slot;
+    UCHAR Bus = (UCHAR)BusNumber;
+    PUCHAR Bytes = Buffer;
+    KIRQL OldIrql;
+
+    if (!Buffer || !Length)
+        return;
+
+    Slot.u.AsULONG = SlotNumber;
+    if (PciCfgAccessBlocked(Bus, Slot))
+    {
+        if (!WritePCISpace)
+            RtlFillMemory(Buffer, Length, 0xff);
+        return;
+    }
+
+    KeRaiseIrql(HIGH_LEVEL, &OldIrql);
+    KeAcquireSpinLockAtDpcLevel(&HalpPCIConfigLock);
+
+    while (Length)
+    {
+        ULONG Width = PciCfgTransferWidth(RegisterNumber, Length);
+        ULONG Value = 0;
+
+        WRITE_PORT_ULONG((PULONG)PCI_CFG_ADDR,
+                         PciCfgAddress(Bus,
+                                       (UCHAR)Slot.u.bits.DeviceNumber,
+                                       (UCHAR)Slot.u.bits.FunctionNumber,
+                                       (UCHAR)RegisterNumber));
+
+        if (WritePCISpace)
+        {
+            RtlCopyMemory(&Value, Bytes, Width);
+            if (Width == 4)
+                WRITE_PORT_ULONG((PULONG)PCI_CFG_DATA, Value);
+            else if (Width == 2)
+                WRITE_PORT_USHORT((PUSHORT)(PCI_CFG_DATA +
+                                  (RegisterNumber & 3)), (USHORT)Value);
+            else
+                WRITE_PORT_UCHAR((PUCHAR)(PCI_CFG_DATA +
+                                 (RegisterNumber & 3)), (UCHAR)Value);
+        }
+        else
+        {
+            if (Width == 4)
+                Value = READ_PORT_ULONG((PULONG)PCI_CFG_DATA);
+            else if (Width == 2)
+                Value = READ_PORT_USHORT((PUSHORT)(PCI_CFG_DATA +
+                                   (RegisterNumber & 3)));
+            else
+                Value = READ_PORT_UCHAR((PUCHAR)(PCI_CFG_DATA +
+                                  (RegisterNumber & 3)));
+            RtlCopyMemory(Bytes, &Value, Width);
+        }
+
+        RegisterNumber += Width;
+        Bytes += Width;
+        Length -= Width;
+    }
+
+    WRITE_PORT_ULONG((PULONG)PCI_CFG_ADDR, 0);
+    KeReleaseSpinLock(&HalpPCIConfigLock, OldIrql);
+}
