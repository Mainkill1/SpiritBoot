+++ b/tests/host/boot-image/decode.c
@@ -0,0 +1,43 @@
+/* Link the real loader/XZ implementation; only paging/entry transfer are unused. */
+#define _GNU_SOURCE
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include "boot-layout.h"
+unsigned char KernelPayloadVa[262144];
+extern uint32_t LoaderFailCode;
+const void *TestDecode(void);
+void PagingInit(void) {}
+void PagingEnable(void) {}
+
+int main(int argc, char **argv)
+{
+    if (argc != 4) return 2;
+    FILE *f = fopen(argv[1], "rb");
+    if (!f) return 2;
+    size_t size = fread(KernelPayloadVa, 1, sizeof(KernelPayloadVa), f);
+    fclose(f);
+    if (size < 12) return 2;
+    unsigned char *dest = mmap((void *)(uintptr_t)NXBL_IMAGE_PA, NXBL_IMAGE_BYTES,
+                              PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS|
+                              MAP_FIXED_NOREPLACE, -1, 0);
+    if (dest == MAP_FAILED) { perror("map final kernel image"); return 2; }
+    memset(dest, 0xa5, NXBL_IMAGE_BYTES);
+    const void *result = TestDecode();
+    int expect = atoi(argv[3]);
+    if (!expect) return result != NULL || LoaderFailCode == 0;
+    if (result != dest || LoaderFailCode) return 1;
+    f = fopen(argv[2], "rb");
+    if (!f) return 2;
+    unsigned i = 0;
+    int c;
+    while ((c = fgetc(f)) != EOF) {
+        if (i >= NXBL_IMAGE_BYTES || dest[i++] != c) return 1;
+    }
+    fclose(f);
+    for (; i < NXBL_IMAGE_BYTES; ++i) if (dest[i] != 0xa5) return 1;
+    puts("real XZ decode into final kernel allocation: PASS");
+    return 0;
+}
diff --git a/tests/host/boot-image/runtime.c b/tests/host/boot-image/runtime.c
new file mode 100644
index 00000000..e7d98766
--- /dev/null
+++ b/tests/host/boot-image/runtime.c
@@ -0,0 +1,39 @@
+/* Actual mapped-image validator: valid entry, bounded parsing, no writes. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+uint32_t LoaderPhase, LoaderFailCode, LoaderKernelSize, LoaderKernelEntry;
+uint32_t PeLoad(const void *, uint32_t);
+
+int main(int argc, char **argv)
+{
+    if (argc != 2) return 2;
+    FILE *f = fopen(argv[1], "rb");
+    if (!f) return 2;
+    unsigned char *image = malloc(0x5000), *copy = malloc(0x5000);
+    if (!image || !copy || fread(image, 1, 0x5000, f) != 0x5000) return 2;
+    fclose(f);
+    memcpy(copy, image, 0x5000);
+    if (PeLoad(image, 0x5000) != 0x84001001 || LoaderFailCode ||
+        LoaderKernelSize != 0x5000 || memcmp(image, copy, 0x5000)) return 1;
+    const unsigned sizes[] = {0, 63, 0x98, 0x1ef, 0x4fff, 0x5001, 0xffffffff};
+    for (unsigned i = 0; i < sizeof(sizes)/sizeof(*sizes); ++i) {
+        LoaderFailCode = 0;
+        if (PeLoad(image, sizes[i]) || !LoaderFailCode) return 1;
+    }
+    const struct { unsigned off, value; } bad[] = {
+        {0x3c, 0xfffffff0}, {0xa8, 0x5000}, {0xa8, 0x2000},
+        {0xb4, 0x80010000}, {0xd0, 0x400000}, {0xd4, 0x6000},
+        {0x184, 0x1001}, {0x180, 0xffffffff}, {0x1ac, 0x1000}
+    };
+    for (unsigned i = 0; i < sizeof(bad)/sizeof(*bad); ++i) {
+        memcpy(image, copy, 0x5000);
+        memcpy(image + bad[i].off, &bad[i].value, 4);
+        LoaderFailCode = 0;
+        if (PeLoad(image, 0x5000) || !LoaderFailCode) return 1;
+    }
+    free(copy); free(image);
+    puts("mapped kernel validation: PASS");
+    return 0;
+}
