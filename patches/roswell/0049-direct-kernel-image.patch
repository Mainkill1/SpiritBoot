-NXKRNL_XZ_MAGIC = 0x5a4b584e  # 'NXKZ' (little-endian on disk)
+NXKRNL_XZ_MAGIC = 0x494b584e  # 'NXKI': prepared image, incompatible with file-layout NXKZ (little-endian on disk)
 NM = os.environ.get("NM", "nm")
 
 
+def prepare_kernel_image(kernel: bytes, image_max: int) -> bytes:
+    """Place owned PE32 sections at their RVAs before compression.
+
+    The result has the same headers, section bytes and zero-filled section
+    tails as a loaded image. No relocations are needed at the fixed kernel VA.
+    Validate the complete file before allocating or publishing the result.
+    """
+    def require(condition, message):
+        if not condition:
+            raise ValueError(message)
+
+    require(len(kernel) >= 64 and kernel[:2] == b'MZ', 'missing DOS header')
+    pe = struct.unpack_from('<I', kernel, 0x3c)[0]
+    require(pe <= len(kernel) - 24 and kernel[pe:pe+4] == b'PE\0\0',
+            'missing PE header')
+    machine, sections = struct.unpack_from('<HH', kernel, pe + 4)
+    optional_size = struct.unpack_from('<H', kernel, pe + 20)[0]
+    opt = pe + 24
+    require(machine == 0x14c and optional_size >= 64 and
+            opt + optional_size <= len(kernel), 'invalid i386 optional header')
+    require(struct.unpack_from('<H', kernel, opt)[0] == 0x10b, 'not PE32')
+    entry = struct.unpack_from('<I', kernel, opt + 16)[0]
+    base, alignment = struct.unpack_from('<II', kernel, opt + 28)
+    image_size, headers = struct.unpack_from('<II', kernel, opt + 56)
+    require(base == 0x84000000 and alignment == 4096, 'unsupported kernel layout')
+    require(0 < image_size <= image_max and not image_size & 4095,
+            'invalid mapped image size')
+    table = opt + optional_size
+    require(sections > 0 and table + sections * 40 <= headers <= len(kernel),
+            'incomplete section table or headers')
+    require(headers <= image_size and entry < image_size, 'header/entry outside image')
+    previous_end = (headers + 4095) & ~4095
+    copies = []
+    executable_entry = False
+    for index in range(sections):
+        sh = table + index * 40
+        size, rva, raw_size, raw_off = struct.unpack_from('<IIII', kernel, sh + 8)
+        flags = struct.unpack_from('<I', kernel, sh + 36)[0]
+        end = rva + ((size + 4095) & ~4095)
+        require(not rva & 4095 and rva <= image_size and end <= image_size,
+                'section outside mapped image or unaligned')
+        require(rva >= previous_end, 'overlapping or unordered section spans')
+        previous_end = end
+        if raw_size:
+            require(raw_off >= headers and raw_off + raw_size <= len(kernel),
+                    'section source outside file')
+            copies.append((rva, raw_off, min(size, raw_size)))
+        if flags & 0x20000000 and rva <= entry < rva + size:
+            executable_entry = True
+    require(executable_entry, 'entry is not in an executable section')
+    result = bytearray(image_size)
+    result[:headers] = kernel[:headers]
+    for rva, offset, size in copies:
+        result[rva:rva+size] = kernel[offset:offset+size]
+    return bytes(result)
+
