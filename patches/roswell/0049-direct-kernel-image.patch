+++ b/tests/host/boot-image/check.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Prepared-image packing tests: misplaced sections, stale padding and invalid spans."""
+import importlib.util
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[3]
+spec = importlib.util.spec_from_file_location('flash', ROOT / 'boot/nxldr/gen-flash-bin.py')
+flash = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(flash)
+
+def fixture():
+    raw = bytearray(0x605)
+    raw[:2] = b'MZ'
+    struct.pack_into('<I', raw, 0x3c, 0x80)
+    raw[0x80:0x84] = b'PE\0\0'
+    struct.pack_into('<HH', raw, 0x84, 0x14c, 3)
+    struct.pack_into('<H', raw, 0x94, 0xe0)
+    struct.pack_into('<H', raw, 0x98, 0x10b)
+    struct.pack_into('<I', raw, 0xa8, 0x1001)
+    struct.pack_into('<III', raw, 0xb4, 0x84000000, 0x1000, 0x200)
+    struct.pack_into('<II', raw, 0xd0, 0x5000, 0x200)
+    for i, (name, size, rva, rawsize, offset, flags) in enumerate([
+            (b'.text', 9, 0x1000, 0x200, 0x400, 0x60000020),
+            (b'.data', 5, 0x2000, 5, 0x600, 0xc0000040),
+            (b'.bss', 0x1001, 0x3000, 0, 0, 0xc0000080)]):
+        off = 0x178 + 40 * i
+        raw[off:off+len(name)] = name
+        struct.pack_into('<IIII', raw, off+8, size, rva, rawsize, offset)
+        struct.pack_into('<I', raw, off+36, flags)
+    raw[0x400:0x600] = b'\xcc' * 0x200
+    raw[0x400:0x409] = b'codebytes'
+    raw[0x600:] = b'data!'
+    return raw
+
+class PreparedImage(unittest.TestCase):
+    def pack(self, raw):
+        self.assertTrue(callable(getattr(flash, 'prepare_kernel_image', None)),
+                        'firmware builder must prepare final kernel layout before compression')
+        return flash.prepare_kernel_image(bytes(raw), 0x400000)
+
+    def test_final_layout_and_zero_padding(self):
+        raw = fixture()
+        expected = bytearray(0x5000)
+        expected[:0x200] = raw[:0x200]
+        expected[0x1000:0x1009] = b'codebytes'
+        expected[0x2000:0x2005] = b'data!'
+        self.assertEqual(self.pack(raw), expected)
+
+    def test_reject_invalid_images_before_output(self):
+        cases = [('machine', 0x84, '<H', 0x8664),
+                 ('base', 0xb4, '<I', 0x80010000),
+                 ('zero span', 0xd0, '<I', 0),
+                 ('oversized', 0xd0, '<I', 0x401000),
+                 ('unaligned span', 0xd0, '<I', 0x4fff),
+                 ('entry outside', 0xa8, '<I', 0x5000),
+                 ('entry in data', 0xa8, '<I', 0x2000),
+                 ('missing table', 0x94, '<H', 0xffff),
+                 ('headers overlap section', 0xd4, '<I', 0x2000),
+                 ('unaligned section', 0x184, '<I', 0x1001),
+                 ('overlapping sections', 0x1ac, '<I', 0x1000),
+                 ('truncated source', 0x18c, '<I', 0x600),
+                 ('wrapping destination', 0x180, '<I', 0xffffffff)]
+        for name, off, fmt, value in cases:
+            with self.subTest(name=name):
+                raw = fixture()
+                struct.pack_into(fmt, raw, off, value)
+                with self.assertRaises(ValueError):
+                    self.pack(raw)
+        for size in [0, 63, 0x80, 0x98, 0x1ef, 0x604]:
+            with self.subTest(truncated=size):
+                with self.assertRaises(ValueError):
+                    self.pack(fixture()[:size])
+
+    def test_actual_runtime_validator_does_not_remap(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            tmp = Path(tmp)
+            image = self.pack(fixture())
+            (tmp / 'mapped.bin').write_bytes(image)
+            subprocess.run(['cc', '-std=c11', '-O2', '-fno-builtin',
+                            '-fsanitize=address,undefined', '-g',
+                            str(ROOT / 'boot/nxldr/pe.c'),
+                            str(Path(__file__).with_name('runtime.c')),
+                            '-o', str(tmp / 'runtime')], check=True)
+            subprocess.run([str(tmp / 'runtime'), str(tmp / 'mapped.bin')], check=True)
+
+    def test_real_decoder_and_payload_rejection(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            tmp = Path(tmp)
+            image = self.pack(fixture())
+            compressed = flash.xz_compress(image)
+            blob = struct.pack('<III', flash.NXKRNL_XZ_MAGIC, len(compressed), len(image)) + compressed
+            (tmp / 'mapped.bin').write_bytes(image)
+            (tmp / 'entry.c').write_text('#include "loader.c"\nconst void *TestDecode(void) { return DecompressKernel(); }\n')
+            loader = ROOT / 'boot/nxldr'
+            sources = [tmp / 'entry.c', loader / 'pe.c',
+                       *[loader / 'xz' / name for name in ('xz_crc32.c', 'xz_dec_stream.c',
+                                                          'xz_dec_lzma2.c', 'xz_dec_bcj.c')],
+                       Path(__file__).with_name('decode.c')]
+            for capacity in (64, 128):
+                exe = tmp / f'decode-{capacity}'
+                subprocess.run(['cc', '-O2', '-fno-builtin', '-no-pie',
+                                '-Wl,-Ttext-segment=0x10000000',
+                                f'-DXBOX_RAM_MIB={capacity}', '-I'+str(loader),
+                                *map(str, sources), '-Wl,--defsym,KernelPayloadMaxSize=262144',
+                                '-o', str(exe)], check=True)
+                cases = [('valid', blob, True),
+                         ('old-format', struct.pack('<I', 0x5a4b584e) + blob[4:], False),
+                         ('oversized-input', blob[:4] + struct.pack('<I', 262144) + blob[8:], False),
+                         ('oversized-output', blob[:8] + struct.pack('<I', 0x401000) + blob[12:], False),
+                         ('zero-output', blob[:8] + bytes(4) + blob[12:], False),
+                         ('trailing-input', blob[:4] + struct.pack('<I', len(compressed)+1) + blob[8:] + b'x', False),
+                         ('damaged-stream', blob[:20] + bytes([blob[20] ^ 0xff]) + blob[21:], False)]
+                for label, payload, valid in cases:
+                    with self.subTest(capacity=capacity, payload=label):
+                        (tmp / 'payload.bin').write_bytes(payload)
+                        subprocess.run([str(exe), str(tmp / 'payload.bin'),
+                                        str(tmp / 'mapped.bin'), str(int(valid))], check=True)
+
+if __name__ == '__main__':
+    unittest.main()
