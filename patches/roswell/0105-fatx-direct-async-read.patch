+  CONTEXT c={&irp,&file,&stack,&de,&dev,IRPCONTEXT_COMPLETE,0};
+  submitted=queued=freed=allocated=completed=lock_calls=stats_calls=stats_sum=0;active=NULL;current=0x1000;
+  immediate=allocation_fail=lock_fail=mapping_fail=0;checkpoint=scenario==19;backend=0;stack_size=0x4000;
+  int eligible=scenario<6 || scenario==19;
+  if(scenario==1)immediate=1;
+  if(scenario==2){immediate=1;backend=STATUS_INVALID_PARAMETER;}
+  if(scenario==3)backend=STATUS_CANCELLED;
+  if(scenario==4)backend=STATUS_INVALID_PARAMETER;
