+int main(void){
+ for(unsigned scenario=0;scenario<20;scenario++){
+  FCB f={.RFCB.FileSize.QuadPart=8192,.RFCB.AllocationSize.QuadPart=8192,.RFCB.ValidDataLength.QuadPart=8192,.entry=42};
