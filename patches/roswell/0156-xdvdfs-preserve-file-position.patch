index 4157c57..94da5e7 100644
--- a/drivers/filesystems/xdvdfs/xdvdfs.c
+++ b/drivers/filesystems/xdvdfs/xdvdfs.c
@@ -194,6 +194,13 @@ XdvdPlanForwardRead(_In_ PIRP Irp,
         Irp->CurrentLocation <= 1)
         return FALSE;
 
+    /* The legacy XDVDFS path completes non-synchronous reads before it
+     * returns STATUS_PENDING and therefore publishes CurrentByteOffset in
+     * issue order.  Directly forwarding them would publish in lower-driver
+     * completion order and can redirect a later file-position read. */
+    if ((Sp->FileObject->Flags & FO_SYNCHRONOUS_IO) == 0)
+        return FALSE;
+
     mdl = Irp->MdlAddress;
     if (mdl == NULL || mdl->Next != NULL)
         return FALSE;
@@ -269,7 +276,6 @@ XdvdForwardRead(_In_ PIRP Irp,
                 _In_ const XDVD_FORWARD_PLAN *Plan)
 {
     PIO_STACK_LOCATION lower;
-    BOOLEAN asynchronous = !(Sp->FileObject->Flags & FO_SYNCHRONOUS_IO);
     NTSTATUS status;
 
     /* Retain the effective length in our stack location for completion. */
@@ -282,10 +288,8 @@ XdvdForwardRead(_In_ PIRP Irp,
     IoSetCompletionRoutine(Irp, XdvdForwardReadComplete, Sp->FileObject,
                            TRUE, TRUE, TRUE);
 
-    if (asynchronous)
-        IoMarkIrpPending(Irp);
     status = IoCallDriver(Fcb->Vcb->TargetDevice, Irp);
-    return asynchronous ? STATUS_PENDING : status;
+    return status;
 }
 
