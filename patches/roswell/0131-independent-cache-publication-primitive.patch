+}
+typedef struct {
+    ATAPORT_DEVICE_EXTENSION *device;
+    pthread_mutex_t source_guard,events;
+    pthread_cond_t condition;
+    int poisoned,release,published;
+} source_context;
+static void *source_writer(void *arg)
+{
+    source_context *ctx=arg; ATA_DEVICE_REQUEST request={0};
+    pthread_mutex_lock(&ctx->source_guard);
+    request.TaskFile.Command=0xec; request.DataTransferLength=512;
+    request.DataBuffer=&ctx->device->IdentifyDeviceData;
+    NxAtapiCacheTrack(ctx->device,&request); NxAtapiCacheStart(ctx->device,&request);
+    ctx->device->IdentifyDeviceData[164]=0; /* partially replaced source */
+    __asan_poison_memory_region(ctx->device->IdentifyDeviceData,512);
+    pthread_mutex_lock(&ctx->events); ctx->poisoned=1;
+    pthread_cond_broadcast(&ctx->condition);
+    while(!ctx->release) pthread_cond_wait(&ctx->condition,&ctx->events);
+    pthread_mutex_unlock(&ctx->events);
+    __asan_unpoison_memory_region(ctx->device->IdentifyDeviceData,512);
+    populate_identity(ctx->device); ctx->device->IdentifyDeviceData[170]=0;
+    ctx->device->IdentifyDeviceData[167]=0x40;
+    request.SrbStatus=1; nx_lcq_result result=NxAtapiCacheRawResult(&request);
+    ctx->published=NxAtapiCachePublish(ctx->device,result);
+    pthread_mutex_unlock(&ctx->source_guard);
+    return NULL;
+}
+static int native_query_never_reads_inflight_raw_source(void)
+{
+    ATAPORT_DEVICE_EXTENSION device={0}; pthread_t thread;
+    source_context ctx={.device=&device};
+    CHECK(pthread_mutex_init(&ctx.source_guard,NULL)==0);
+    CHECK(pthread_mutex_init(&ctx.events,NULL)==0);
+    CHECK(pthread_cond_init(&ctx.condition,NULL)==0);
+    NxAtapiCacheInitialize(&device); populate_identity(&device);
+    CHECK(publish_full(&device.NxCacheQueryState,raw_enabled()));
+    CHECK(pthread_create(&thread,NULL,source_writer,&ctx)==0);
+    pthread_mutex_lock(&ctx.events);
+    while(!ctx.poisoned) pthread_cond_wait(&ctx.condition,&ctx.events);
+    pthread_mutex_unlock(&ctx.events);
+    uint8_t b[28]; memcpy(b,query,12); IRP irp={{b},{123,999}};
+    IO_STACK_LOCATION stack={{{12,28}}};
+    NTSTATUS status=NxAtapiQueryWriteCache(&device,&irp,&stack);
+    int ok=status==STATUS_SUCCESS && irp.IoStatus.Information==28 && memcmp(b,unknown,28)==0;
+    pthread_mutex_lock(&ctx.events); ctx.release=1; pthread_cond_broadcast(&ctx.condition);
+    pthread_mutex_unlock(&ctx.events); CHECK(pthread_join(thread,NULL)==0);
+    CHECK(pthread_cond_destroy(&ctx.condition)==0);
+    CHECK(pthread_mutex_destroy(&ctx.events)==0); CHECK(pthread_mutex_destroy(&ctx.source_guard)==0);
+    CHECK(ok && ctx.published);
+    memcpy(b,query,12); CHECK(NxAtapiQueryWriteCache(&device,&irp,&stack)==STATUS_SUCCESS);
+    CHECK(memcmp(b,disabled_no_flush,28)==0);
+    return 1;
+}
+static int queued_successor_is_unknown_before_old_parent_completes(void)
+{
+    nx_lcq_state state; nx_lcq_raw first=raw_enabled(),queued=first;
+    uint8_t b[28]; nx_cache_reply result;
+    queued.active85=0; queued.support83=0x4000;
+    nx_lcq_init(&state,NX_CACHE_PROFILE_ATA);
+    /* Both commands may already be built; invalidation follows actual start. */
+    nx_lcq_invalidate(&state);
+    (void)publish_full(&state,first); /* full successful translation terminal */
+    nx_lcq_invalidate(&state); /* successor now starts, before first parent completes */
+    memcpy(b,query,12); result=nx_lcq_query(&state,b,12,28);
+    CHECK(result.status==NX_CACHE_REPLY_OK && memcmp(b,unknown,28)==0);
+    /* No publication is allowed from a partial in-flight successor view. */
+    (void)publish_full(&state,queued); /* full successful successor terminal */
+    memcpy(b,query,12); result=nx_lcq_query(&state,b,12,28);
+    CHECK(result.status==NX_CACHE_REPLY_OK && memcmp(b,disabled_no_flush,28)==0);
+    return 1;
+}
+static int optical_profile(void)
+{
+    nx_lcq_state state; nx_lcq_raw raw=raw_enabled(); uint8_t b[28],before[28]; nx_cache_reply result;
+    nx_lcq_init(&state,NX_CACHE_PROFILE_OPTICAL); raw.transport_flags=0x10;
+    (void)publish_full(&state,raw); memset(b,0xa5,sizeof(b)); memcpy(b,query,12); memcpy(before,b,28);
+    result=nx_lcq_query(&state,b,12,28);
+    CHECK(result.status==NX_CACHE_REPLY_UNSUPPORTED && result.information==0 && memcmp(b,before,28)==0);
+    b[4]=1; result=nx_lcq_query(&state,b,12,0);
+    CHECK(result.status==NX_CACHE_REPLY_UNSUPPORTED && result.information==0);
+    return 1;
+}
+static int native_negotiation_and_error_information(void)
+{
+    ATAPORT_DEVICE_EXTENSION device; nx_lcq_init(&device.NxCacheQueryState,NX_CACHE_PROFILE_ATA);
+    (void)publish_full(&device.NxCacheQueryState,raw_enabled());
+    for(size_t input=0;input<12;++input) {
+        uint8_t b[28]; memcpy(b,query,12); IRP irp={{b},{123,999}};
+        IO_STACK_LOCATION stack={{{input,28}}};
+        CHECK(NxAtapiQueryWriteCache(&device,&irp,&stack)==STATUS_BUFFER_TOO_SMALL);
+        CHECK(irp.IoStatus.Information==0 && memcmp(b,query,12)==0);
+    }
+    for(size_t output=0;output<=36;++output) {
+        uint8_t b[40],before[40]; memset(b,0xa5,sizeof(b)); memcpy(b,query,12); memcpy(before,b,40);
+        IRP irp={{b},{123,999}}; IO_STACK_LOCATION stack={{{12,output}}};
+        NTSTATUS status=NxAtapiQueryWriteCache(&device,&irp,&stack);
+        if(output<8) {
+            CHECK(status==STATUS_INFO_LENGTH_MISMATCH && irp.IoStatus.Information==0);
+            CHECK(memcmp(b,before,40)==0);
+        } else {
+            size_t bytes=output<28?8:28;
+            CHECK(status==STATUS_SUCCESS && irp.IoStatus.Information==bytes);
+            CHECK(memcmp(b,enabled_flush,bytes)==0);
+            CHECK(memcmp(b+bytes,before+bytes,40-bytes)==0);
+        }
+    }
+    return 1;
+}
+static int exists_unsupported_type_and_null(void)
+{
+    ATAPORT_DEVICE_EXTENSION device; uint8_t b[28]; IRP irp={{b},{123,999}};
+    IO_STACK_LOCATION stack={{{12,0}}};
+    nx_lcq_init(&device.NxCacheQueryState,NX_CACHE_PROFILE_ATA);
+    memcpy(b,query,12); b[4]=1;
+    CHECK(NxAtapiQueryWriteCache(&device,&irp,&stack)==STATUS_SUCCESS && irp.IoStatus.Information==0);
+    CHECK(b[0]==4 && b[4]==1);
+    b[4]=2;
+    CHECK(NxAtapiQueryWriteCache(&device,&irp,&stack)==STATUS_NOT_SUPPORTED && irp.IoStatus.Information==0);
+    irp.AssociatedIrp.SystemBuffer=NULL; stack.Parameters.DeviceIoControl.OutputBufferLength=28;
+    CHECK(NxAtapiQueryWriteCache(&device,&irp,&stack)==STATUS_INVALID_PARAMETER && irp.IoStatus.Information==0);
+    return 1;
+}
