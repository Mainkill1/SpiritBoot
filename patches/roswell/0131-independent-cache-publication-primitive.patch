diff --git a/drivers/storage/class/nxstorage/cache_property.c b/drivers/storage/class/nxstorage/cache_property.c
new file mode 100644
index 00000000..dea5a2d5
--- /dev/null
+++ b/drivers/storage/class/nxstorage/cache_property.c
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "cache_property.h"
+
+/* One independently packed scalar: nine payload bits, twenty-three epoch bits.
+ * The final epoch is poison; it is never issued as a writer ticket. */
+#define EPOCH_SHIFT 9u
+#define EPOCH_MASK 0xfffffe00u
+#define PROFILE_MASK 3u
+#define KNOWN_BIT 4u
+#define SUPPORT_BIT 8u
+#define ACTIVE_BIT 16u
+#define SELECT_SHIFT 5u
+#define PROOF_SHIFT 7u
+
+_Static_assert(sizeof(nx_lcq_state) == 4 && _Alignof(nx_lcq_state) >= 4,
+               "publication requires aligned four-byte storage");
+_Static_assert(__atomic_always_lock_free(4, 0), "no kernel libatomic fallback");
+
+static uint32_t next_ticket(nx_lcq_state *state, int forget_profile)
+{
+    uint32_t seen = __atomic_load_n(&state->published, __ATOMIC_ACQUIRE);
+    for (unsigned attempt = 0; attempt < 16; ++attempt) {
+        uint32_t epoch = seen >> EPOCH_SHIFT;
+        uint32_t next;
+        if (epoch >= NX_LCQ_MAX_WRITERS) break;
+        next = ((epoch + 1u) << EPOCH_SHIFT) | (forget_profile ? 0u : seen & PROFILE_MASK);
+        if (__atomic_compare_exchange_n(&state->published, &seen, next, 0,
+                                         __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return next;
+    }
+    /* Closing the record also revokes all previously issued tickets. Profile
+     * becomes Unknown, avoiding a stale profile on contention exhaustion. */
+    (void)__atomic_exchange_n(&state->published, EPOCH_MASK, __ATOMIC_ACQ_REL);
+    return 0;
+}
+
+void nx_lcq_init(nx_lcq_state *state, enum nx_cache_profile profile)
+{
+    uint32_t p = profile == NX_CACHE_PROFILE_ATA ? 1u :
+                 profile == NX_CACHE_PROFILE_OPTICAL ? 2u : 0u;
+    __atomic_store_n(&state->published, p, __ATOMIC_RELEASE);
+}
+
+void nx_lcq_invalidate(nx_lcq_state *state) { (void)next_ticket(state, 0); }
+/* Reset/removal/reclassification can revoke the profile as well as cache facts. */
+void nx_lcq_revoke(nx_lcq_state *state) { (void)next_ticket(state, 1); }
+
+void nx_lcq_define(nx_lcq_writer *writer, enum nx_lcq_destination destination,
+                   uint32_t command, size_t requested_bytes)
+{
+    *writer = (nx_lcq_writer){0};
+    if ((destination != NX_LCQ_CACHED && destination != NX_LCQ_LOCAL) ||
+        (command != 0xec && command != 0xa1)) return;
+    writer->destination = (uint8_t)destination;
+    writer->command = (uint8_t)command;
+    /* Zero means unqualified, not a narrowed or measured transfer length. */
+    writer->requested_bytes = requested_bytes == NX_LCQ_IDENTITY_BYTES ?
+        NX_LCQ_IDENTITY_BYTES : 0u;
+}
+
+int nx_lcq_start(nx_lcq_state *state, nx_lcq_writer *writer,
+                  uint32_t final_command, size_t final_bytes, enum nx_lcq_proof proof)
+{
+    writer->stamp = 0; writer->started = 0; writer->proof = 0;
+    if ((writer->destination != NX_LCQ_CACHED && writer->destination != NX_LCQ_LOCAL) ||
+        (writer->command != 0xec && writer->command != 0xa1) ||
+        final_command != writer->command) return 0;
+    /* Invalidate every tracked writer, including an unqualified/changed extent. */
+    writer->stamp = next_ticket(state, 0);
+    if (!writer->stamp) return 0;
+    writer->started = 1;
+    if (writer->requested_bytes == NX_LCQ_IDENTITY_BYTES &&
+        final_bytes == NX_LCQ_IDENTITY_BYTES &&
+        (proof == NX_LCQ_PIO_COUNTED || proof == NX_LCQ_DMA_CONTROLLER))
+        writer->proof = (uint8_t)proof;
+    return 1;
+}
+
+nx_lcq_result nx_lcq_result_copy(const nx_lcq_writer *writer,
+                                uint8_t raw_status, uint32_t raw_bytes)
+{
+    nx_lcq_result r = {*writer, raw_bytes, raw_status};
+    return r;
+}
+
+static int qualifying_result(nx_lcq_result result)
+{
+    return result.writer.started == 1 && result.writer.stamp != 0 &&
+        (result.writer.destination == NX_LCQ_CACHED || result.writer.destination == NX_LCQ_LOCAL) &&
+        (result.writer.command == 0xec || result.writer.command == 0xa1) &&
+        result.writer.requested_bytes == NX_LCQ_IDENTITY_BYTES &&
+        (result.writer.proof == NX_LCQ_PIO_COUNTED || result.writer.proof == NX_LCQ_DMA_CONTROLLER) &&
+        result.raw_status == 1 && result.raw_bytes == NX_LCQ_IDENTITY_BYTES;
+}
+
+int nx_lcq_current(const nx_lcq_state *state, nx_lcq_result result)
+{
+    return qualifying_result(result) &&
+        __atomic_load_n(&state->published, __ATOMIC_ACQUIRE) == result.writer.stamp;
+}
+
+int nx_lcq_publish(nx_lcq_state *state, nx_lcq_result result, nx_lcq_raw raw)
+{
+    uint32_t expected = result.writer.stamp;
+    uint32_t payload = (raw.transport_flags & NX_LCQ_ATAPI_FLAG) ? 2u : 1u;
+    uint32_t select = 0;
+    if (!qualifying_result(result)) return 0;
+    if (payload == 1u && (raw.support84 & NX_LCQ_VALID_MASK) == NX_LCQ_VALID_ONE) {
+        payload |= KNOWN_BIT;
+        if (raw.support82 & NX_LCQ_CACHE_BIT) payload |= SUPPORT_BIT;
+        if (raw.active85 & NX_LCQ_CACHE_BIT) payload |= ACTIVE_BIT;
+        if ((raw.device_flags & NX_LCQ_LBA48_FLAG) && (raw.support83 & NX_LCQ_FLUSH_EXT_BIT)) select = 2;
+        else if (raw.support83 & NX_LCQ_FLUSH_BIT) select = 1;
+    }
+    payload |= select << SELECT_SHIFT;
+    payload |= (uint32_t)result.writer.proof << PROOF_SHIFT;
+    return __atomic_compare_exchange_n(&state->published, &expected,
+        (result.writer.stamp & EPOCH_MASK) | payload, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+}
+
+static uint16_t read_word(const uint8_t *p)
+{
+    return (uint16_t)((uint16_t)p[0] | ((uint16_t)p[1] << 8));
+}
+
+int nx_lcq_read_raw(nx_lcq_raw *raw, const void *identity, size_t identity_bytes,
+                    uint32_t transport_flags, uint32_t device_flags)
+{
+    const uint8_t *bytes = identity;
+    nx_lcq_raw copy;
+    if (!raw || !bytes || identity_bytes < NX_LCQ_IDENTITY_BYTES) return 0;
+    copy.support82 = read_word(bytes + NX_LCQ_WORD82_OFFSET);
+    copy.support83 = read_word(bytes + NX_LCQ_WORD83_OFFSET);
+    copy.support84 = read_word(bytes + NX_LCQ_WORD84_OFFSET);
+    copy.active85 = read_word(bytes + NX_LCQ_WORD85_OFFSET);
+    copy.transport_flags = transport_flags; copy.device_flags = device_flags;
+    *raw = copy;
+    return 1;
+}
+
+nx_cache_snapshot nx_lcq_snapshot(const nx_lcq_state *state)
+{
+    uint32_t value = __atomic_load_n(&state->published, __ATOMIC_ACQUIRE);
+    uint32_t select = (value >> SELECT_SHIFT) & 3u;
+    nx_cache_snapshot s;
+    s.profile = value & PROFILE_MASK;
+    s.command_sets_known = (value & KNOWN_BIT) != 0;
+    s.cache_supported = (value & SUPPORT_BIT) != 0;
+    s.cache_active = (value & ACTIVE_BIT) != 0;
+    s.flush_selection_known = s.command_sets_known;
+    s.selected_flush = select == 1u ? 0xe7u : select == 2u ? 0xeau : 0u;
+    return s;
+}
+
+enum nx_lcq_proof nx_lcq_snapshot_proof(const nx_lcq_state *state)
+{
+    uint32_t value = __atomic_load_n(&state->published, __ATOMIC_ACQUIRE);
+    uint32_t proof = (value >> PROOF_SHIFT) & 3u;
+    return proof == 1 ? NX_LCQ_PIO_COUNTED : proof == 2 ? NX_LCQ_DMA_CONTROLLER : NX_LCQ_UNPROVED;
+}
+
+nx_cache_reply nx_lcq_query(const nx_lcq_state *state, void *system_buffer,
+                            size_t input_bytes, size_t output_bytes)
+{
+    nx_cache_snapshot snapshot = nx_lcq_snapshot(state);
+    return nx_cache_query_encode(snapshot, system_buffer, input_bytes, system_buffer, output_bytes);
+}
diff --git a/drivers/storage/class/nxstorage/cache_property.h b/drivers/storage/class/nxstorage/cache_property.h
new file mode 100644
index 00000000..d05faaa0
--- /dev/null
+++ b/drivers/storage/class/nxstorage/cache_property.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NX_LOWER_CACHE_PROPERTY_H
+#define NX_LOWER_CACHE_PROPERTY_H
+
+#include "cache_query.h"
+/* Newly owned publication record, not a retained lower/private type overlay. */
+typedef struct nx_lcq_state { uint32_t published; } nx_lcq_state;
+
+enum nx_lcq_destination { NX_LCQ_OTHER = 0, NX_LCQ_CACHED = 1, NX_LCQ_LOCAL = 2 };
+enum nx_lcq_proof { NX_LCQ_UNPROVED = 0, NX_LCQ_PIO_COUNTED = 1, NX_LCQ_DMA_CONTROLLER = 2 };
+enum {
+    NX_LCQ_IDENTITY_BYTES = 512, NX_LCQ_MAX_WRITERS = 8388606,
+    NX_LCQ_WORD82_OFFSET = 164, NX_LCQ_WORD83_OFFSET = 166,
+    NX_LCQ_WORD84_OFFSET = 168, NX_LCQ_WORD85_OFFSET = 170,
+    NX_LCQ_VALID_MASK = 0xc000, NX_LCQ_VALID_ONE = 0x4000,
+    NX_LCQ_CACHE_BIT = 0x20, NX_LCQ_FLUSH_BIT = 0x1000,
+    NX_LCQ_FLUSH_EXT_BIT = 0x2000, NX_LCQ_ATAPI_FLAG = 0x10,
+    NX_LCQ_LBA48_FLAG = 4, NX_LCQ_LOCAL_FLAG = 0x8000,
+    NX_LCQ_PROGRAM_DMA_FLAG = 0x00200000
+};
+
+/* New fixed request-owned metadata, copied before mapping/translation/reuse. */
+typedef struct nx_lcq_writer {
+    uint32_t stamp;
+    uint32_t requested_bytes;
+    uint8_t destination, command, proof, started;
+} nx_lcq_writer;
+
+typedef struct nx_lcq_result {
+    nx_lcq_writer writer;
+    uint32_t raw_bytes;
+    uint8_t raw_status;
+} nx_lcq_result;
+
+/* Copied coherent words from completed retained IDENTIFY plus negotiated flags.
+ * The producer establishes coherence; never pass a live DMA destination. */
+typedef struct nx_lcq_raw {
+    uint16_t support82;
+    uint16_t support83;
+    uint16_t support84;
+    uint16_t active85;
+    uint32_t transport_flags;
+    uint32_t device_flags;
+} nx_lcq_raw;
+
+void nx_lcq_init(nx_lcq_state *state, enum nx_cache_profile profile);
+void nx_lcq_invalidate(nx_lcq_state *state);
+void nx_lcq_revoke(nx_lcq_state *state);
+void nx_lcq_define(nx_lcq_writer *writer, enum nx_lcq_destination destination,
+                   uint32_t command, size_t requested_bytes);
+int nx_lcq_start(nx_lcq_state *state, nx_lcq_writer *writer,
+                  uint32_t final_command, size_t final_bytes, enum nx_lcq_proof proof);
+nx_lcq_result nx_lcq_result_copy(const nx_lcq_writer *writer,
+                                uint8_t raw_status, uint32_t raw_bytes);
+int nx_lcq_current(const nx_lcq_state *state, nx_lcq_result result);
+int nx_lcq_publish(nx_lcq_state *state, nx_lcq_result result, nx_lcq_raw raw);
+int nx_lcq_read_raw(nx_lcq_raw *raw, const void *identity, size_t identity_bytes,
+                    uint32_t transport_flags, uint32_t device_flags);
+nx_cache_snapshot nx_lcq_snapshot(const nx_lcq_state *state);
+enum nx_lcq_proof nx_lcq_snapshot_proof(const nx_lcq_state *state);
+nx_cache_reply nx_lcq_query(const nx_lcq_state *state, void *system_buffer,
+                            size_t input_bytes, size_t output_bytes);
+
+/* One serialized publisher; invalidate at actual cached-write start before DMA,
+ * and before other source/negotiation mutation. Publish a successful stable
+ * terminal view before any successor writer starts. Failure leaves Unknown.
+ * Raw status/count are captured before translation; PIO_COUNTED means the
+ * retained raw success contract proved all requested bytes, DMA_CONTROLLER
+ * means programmed descriptors + controller success (no actual-byte counter).
+ * Each real start/revocation advances a bounded generation. Exhaustion or
+ * contention failure permanently closes qualification until object recreation.
+ * init is constructor-only with no live tickets. All operations need residency,
+ * a single serialized producer and external rundown. current is not a raw-read
+ * synchronization lock; caller still prevents later writers while copying. */
+#endif
diff --git a/drivers/storage/class/nxstorage/native_capture.inc b/drivers/storage/class/nxstorage/native_capture.inc
new file mode 100644
index 00000000..49cc6883
--- /dev/null
+++ b/drivers/storage/class/nxstorage/native_capture.inc
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Independently authored producer adapters, candidate-only. Caller holds the
+ * source-proved producer serialization/rundown boundaries in INTEGRATION.md.
+ * These functions never start I/O, change cache settings, queue, IRQ or timing.
+ */
+static inline void
+NxAtapiCacheInitialize(PATAPORT_DEVICE_EXTENSION device)
+{
+    nx_lcq_init(&device->NxCacheQueryState, NX_CACHE_PROFILE_UNKNOWN);
+}
+
+static inline void
+NxAtapiCacheUnavailable(PATAPORT_DEVICE_EXTENSION device)
+{
+    nx_lcq_revoke(&device->NxCacheQueryState);
+}
+
+static inline void
+NxAtapiCacheWriterReset(PATA_DEVICE_REQUEST request)
+{
+    nx_lcq_define(&request->NxCacheWriter, NX_LCQ_OTHER, 0, 0);
+}
+
+/* Invoke once on constructed identity, before any DataBuffer mapping. Keep
+ * this marker across mappings/requeues; reset it before request storage reuse. */
+static inline void
+NxAtapiCacheTrack(PATAPORT_DEVICE_EXTENSION device, PATA_DEVICE_REQUEST request)
+{
+    enum nx_lcq_destination destination = NX_LCQ_OTHER;
+    if (request->Flags & NX_LCQ_LOCAL_FLAG) destination = NX_LCQ_LOCAL;
+    else if (request->DataBuffer == (void *)&device->IdentifyDeviceData)
+        destination = NX_LCQ_CACHED;
+    nx_lcq_define(&request->NxCacheWriter, destination,
+                  request->TaskFile.Command, request->DataTransferLength);
+}
+
+/* Invoke after mappings/PrepareIo, immediately before external real start.
+ * PROGRAM_DMA is the actual transfer engine, including PIO-via-DMA and the
+ * completed fallback decision; ATA DMA opcode flags alone are insufficient. */
+static inline void
+NxAtapiCacheStart(PATAPORT_DEVICE_EXTENSION device, PATA_DEVICE_REQUEST request)
+{
+    enum nx_lcq_proof proof = (request->Flags & NX_LCQ_PROGRAM_DMA_FLAG) ?
+        NX_LCQ_DMA_CONTROLLER : NX_LCQ_PIO_COUNTED;
+    (void)nx_lcq_start(&device->NxCacheQueryState, &request->NxCacheWriter,
+                      request->TaskFile.Command, request->DataTransferLength, proof);
+}
+
+/* Invoke before translation rewrites status/count/pointers and before request
+ * recycle. Local-buffer owners retain this result by value until cache copy. */
+static inline nx_lcq_result
+NxAtapiCacheRawResult(PATA_DEVICE_REQUEST request)
+{
+    return nx_lcq_result_copy(&request->NxCacheWriter,
+                              request->SrbStatus, request->DataTransferLength);
+}
+
+/* Caller excludes every source writer/flag mutation throughout this function.
+ * Runtime: after translation/addressing, before successor start. Worker:
+ * after successful full local identity copy plus profile/flag consistency.
+ * current is an epoch/result check, not a substitute for that read guard. */
+static inline int
+NxAtapiCachePublish(PATAPORT_DEVICE_EXTENSION device, nx_lcq_result result)
+{
+    nx_lcq_raw raw;
+    if (!nx_lcq_current(&device->NxCacheQueryState, result)) return 0;
+    if (!nx_lcq_read_raw(&raw, &device->IdentifyDeviceData,
+        sizeof(device->IdentifyDeviceData), device->Device.TransportFlags,
+        device->Device.DeviceFlags)) return 0;
+    return nx_lcq_publish(&device->NxCacheQueryState, result, raw);
+}
diff --git a/drivers/storage/class/nxstorage/native_hook.inc b/drivers/storage/class/nxstorage/native_hook.inc
new file mode 100644
index 00000000..26c8c700
--- /dev/null
+++ b/drivers/storage/class/nxstorage/native_hook.inc
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Candidate-only: include after approved native declarations and cache_property.h.
+ * The existing PDO dispatch owns sole completion and its remove-lock epilogue.
+ */
+static NTSTATUS
+NxAtapiQueryWriteCache(PATAPORT_DEVICE_EXTENSION device, PIRP irp,
+                      PIO_STACK_LOCATION stack)
+{
+    nx_cache_reply reply = nx_lcq_query(&device->NxCacheQueryState,
+        irp->AssociatedIrp.SystemBuffer,
+        stack->Parameters.DeviceIoControl.InputBufferLength,
+        stack->Parameters.DeviceIoControl.OutputBufferLength);
+    /* The caller still owns parent/buffer. No device access follows encoding. */
+    irp->IoStatus.Information = reply.information;
+    switch (reply.status) {
+        case NX_CACHE_REPLY_OK: return STATUS_SUCCESS;
+        case NX_CACHE_REPLY_INPUT_SHORT: return STATUS_BUFFER_TOO_SMALL;
+        case NX_CACHE_REPLY_UNSUPPORTED: return STATUS_NOT_SUPPORTED;
+        case NX_CACHE_REPLY_OUTPUT_SHORT: return STATUS_INFO_LENGTH_MISMATCH;
+        case NX_CACHE_REPLY_INVALID: return STATUS_INVALID_PARAMETER;
+    }
+    return STATUS_INVALID_PARAMETER;
+}
