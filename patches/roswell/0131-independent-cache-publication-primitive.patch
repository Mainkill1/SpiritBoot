+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NX_LCQ_NATIVE_DOUBLES_H
+#define NX_LCQ_NATIVE_DOUBLES_H
+#include "cache_property.h"
+#include "status-facts.h"
+#include "ata-cache-abi-facts.h"
+/* Logical host public/owner doubles; no native byte layout is asserted here.
+ * Status bits now use the explicitly approved compiled scalar packets. */
+typedef uint32_t NTSTATUS;
+#define STATUS_SUCCESS PR248_STATUS_SUCCESS
+#define STATUS_BUFFER_TOO_SMALL PR248_STATUS_BUFFER_TOO_SMALL
+#define STATUS_NOT_SUPPORTED PR248_ATACACHE_STATUS_NOT_SUPPORTED
+#define STATUS_INFO_LENGTH_MISMATCH PR248_STATUS_INFO_LENGTH_MISMATCH
+#define STATUS_INVALID_PARAMETER PR248_STATUS_INVALID_PARAMETER
+typedef struct {
+    nx_lcq_state NxCacheQueryState;
+    _Alignas(8) uint8_t IdentifyDeviceData[512];
+    struct { uint32_t TransportFlags, DeviceFlags; } Device;
+    unsigned hardware_commands, cache_changes, queue_changes, irq_changes;
+} ATAPORT_DEVICE_EXTENSION, *PATAPORT_DEVICE_EXTENSION;
+typedef struct {
+    nx_lcq_writer NxCacheWriter;
+    struct { uint8_t Command; } TaskFile;
+    void *DataBuffer;
+    uint32_t Flags,DataTransferLength;
+    uint8_t SrbStatus;
+} ATA_DEVICE_REQUEST,*PATA_DEVICE_REQUEST;
+typedef struct {
+    struct { void *SystemBuffer; } AssociatedIrp;
+    struct { NTSTATUS Status; size_t Information; } IoStatus;
+} IRP, *PIRP;
+typedef struct {
+    struct { struct { size_t InputBufferLength, OutputBufferLength; } DeviceIoControl; } Parameters;
+} IO_STACK_LOCATION, *PIO_STACK_LOCATION;
