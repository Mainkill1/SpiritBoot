+typedef struct { nx_lcq_state *state; _Atomic int go; } concurrent_context;
+static void *publisher(void *arg)
+{
+    concurrent_context *ctx=arg; nx_lcq_raw a=raw_enabled(),b=a;
+    b.active85=0; b.support83=0x4000;
+    while(!atomic_load_explicit(&ctx->go,memory_order_acquire)) { }
+    for(unsigned i=0;i<20000;++i) {
+        nx_lcq_invalidate(ctx->state); (void)publish_full(ctx->state,a);
+        nx_lcq_invalidate(ctx->state); (void)publish_full(ctx->state,b);
+    }
+    return NULL;
+}
+static int coherent_concurrent_publication(void)
+{
+    nx_lcq_state state; pthread_t thread; concurrent_context ctx={&state,0}; unsigned bad=0;
+    nx_lcq_init(&state,NX_CACHE_PROFILE_ATA);
+    CHECK(pthread_create(&thread,NULL,publisher,&ctx)==0);
+    atomic_store_explicit(&ctx.go,1,memory_order_release);
+    for(unsigned i=0;i<40000;++i) {
+        uint8_t b[28]; memcpy(b,query,12); nx_cache_reply r=nx_lcq_query(&state,b,12,28);
+        if(r.status!=NX_CACHE_REPLY_OK || r.information!=28 ||
+           (memcmp(b,unknown,28)!=0 && memcmp(b,enabled_flush,28)!=0 && memcmp(b,disabled_no_flush,28)!=0)) ++bad;
+    }
+    CHECK(pthread_join(thread,NULL)==0);
+    CHECK(bad==0);
+    return 1;
+}
+
+static void owner_complete(IRP *irp, ATAPORT_DEVICE_EXTENSION *device, uint8_t *buffer,
+                           unsigned *completions, NTSTATUS *seen, size_t *information)
+{
+    ++*completions; *seen=irp->IoStatus.Status; *information=irp->IoStatus.Information;
+    free(buffer); free(irp); free(device);
+}
+static NTSTATUS owner_dispatch(IRP *irp, ATAPORT_DEVICE_EXTENSION *device, IO_STACK_LOCATION *stack,
+                               uint8_t *buffer,unsigned *completions,NTSTATUS *seen,size_t *information)
+{
+    NTSTATUS status=NxAtapiQueryWriteCache(device,irp,stack);
+    irp->IoStatus.Status=status;
+    owner_complete(irp,device,buffer,completions,seen,information);
+    /* Borrowed parent/device/buffer are now freed. Only captured scalar returns. */
+    return status;
+}
+static int sole_owner_completion_and_reclamation(void)
+{
+    const size_t lengths[]={0,8,28};
+    for(size_t i=0;i<3;++i) {
+        IRP *irp=malloc(sizeof(*irp)); ATAPORT_DEVICE_EXTENSION *device=malloc(sizeof(*device));
+        uint8_t *buffer=malloc(28); IO_STACK_LOCATION stack={{{12,lengths[i]}}};
+        unsigned completions=0; NTSTATUS seen=123; size_t information=999;
+        CHECK(irp && device && buffer);
+        memcpy(buffer,query,12); irp->AssociatedIrp.SystemBuffer=buffer; irp->IoStatus.Information=999;
+        nx_lcq_init(&device->NxCacheQueryState,NX_CACHE_PROFILE_ATA);
+        (void)publish_full(&device->NxCacheQueryState,raw_enabled());
+        NTSTATUS returned=owner_dispatch(irp,device,&stack,buffer,&completions,&seen,&information);
+        CHECK(completions==1 && returned==seen);
+        CHECK(seen==(lengths[i]?STATUS_SUCCESS:STATUS_INFO_LENGTH_MISMATCH));
+        CHECK(information==lengths[i]);
+    }
+    return 1;
+}
