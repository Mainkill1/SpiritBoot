+static void run(const char *name,int(*test)(void))
+{ if(test()){++passed;printf("PASS %s\n",name);}else{++failed;printf("FAIL %s\n",name);} }
+#define RUN(t) run(#t,t)
+int main(void)
+{
+    RUN(regular_flush); RUN(extended_preferred); RUN(extended_without_regular);
+    RUN(extended_only_no_lba48); RUN(regular_fallback_without_lba48); RUN(no_opcode);
+    RUN(actual_selector_fact);
+    RUN(disabled_is_independent_of_selector); RUN(invalid_markers);
+    RUN(retained_word84_validity_is_distinct_from_word83);
+    RUN(contradictory_or_absent_cache); RUN(no_fua_or_unrelated_flag_credit);
+    RUN(initialization_and_refresh_failure); RUN(publication_uses_copied_facts);
+    RUN(raw_declaration_capture_bounds_and_unaligned); RUN(writer_survives_mapping_and_translation);
+    RUN(failed_partial_pending_unproved_never_publish);
+    RUN(duplicate_reset_and_new_writer_revoke_old_terminal);
+    RUN(local_copy_publication_and_dma_proof_are_explicit);
+    RUN(classification_mismatch_cannot_invalidate_healthy_data);
+    RUN(unproved_or_changed_extent_start_invalidates_prior_known);
+    RUN(writer_generation_exhaustion_never_wraps_to_old_ticket);
+    RUN(native_capture_mapping_translation_and_reuse);
+    RUN(native_local_dma_engine_and_reclassification);
+    RUN(native_failed_raw_result_cannot_use_formatter_success);
+    RUN(native_query_never_reads_inflight_raw_source);
+    RUN(queued_successor_is_unknown_before_old_parent_completes);
+    RUN(optical_profile); RUN(native_negotiation_and_error_information);
+    RUN(exists_unsupported_type_and_null); RUN(coherent_concurrent_publication);
+    RUN(sole_owner_completion_and_reclamation);
+    printf("%u passed; %u failed\n",passed,failed);
+    return failed?EXIT_FAILURE:EXIT_SUCCESS;
+}
