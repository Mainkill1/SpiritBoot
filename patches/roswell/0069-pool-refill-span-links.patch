diff --git a/ntoskrnl/xb/mm/pool.c b/ntoskrnl/xb/mm/pool.c
--- a/ntoskrnl/xb/mm/pool.c
+++ b/ntoskrnl/xb/mm/pool.c
@@ -240,6 +240,24 @@
     ASSERT(NxpPageState[Index] == 0 && Class < NXP_BUCKET_LISTS);
     Size = NxpClassSize[NXP_SIZE_CLASS(Class)];
     Count = PAGE_SIZE / Size;
+    /* Batch frees commonly leave the whole page at the list head. Verify
+     * the complete span before splicing it; interleaved frees use the
+     * individual unlink path below. No partial splice is published. */
+    NXP_FREE *After = NxpFreeLists[Class];
+    for (i = 0; i < Count; ++i)
+    {
+        if (After == NULL || PAGE_ALIGN(After) != Page) break;
+        ASSERT((((NXP_HEADER *)After) - 1)->Magic == NXP_MAGIC_FREE &&
+               (((NXP_HEADER *)After) - 1)->ClassIndex == Class);
+        After = After->Next;
+    }
+    if (i == Count)
+    {
+        NxpFreeLists[Class] = After;
+        if (After) After->Prev = NULL;
+        NxpPageState[Index] = NXP_NOT_BUCKET;
+        return Page;
+    }
     for (i = 0; i < Count; ++i)
     {
         NXP_HEADER *Header = (NXP_HEADER *)(Page + i * Size);
@@ -259,6 +277,23 @@
 NxpReuseEmptyBucketPage(ULONG Class)
 {
     ULONG i;
+    ULONG FirstClass = 0;
+#if XBOX_RESERVE_UPPER_RAM
+    FirstClass = Class - NXP_SIZE_CLASS(Class);
+#else
+    UNREFERENCED_PARAMETER(Class);
+#endif
+    /* Prefer an empty page already at a compatible list head. Its free
+     * blocks commonly form a single span, avoiding individual unlinks. */
+    for (i = FirstClass; i < FirstClass + NXP_CLASSES; ++i)
+    {
+        NXP_FREE *Head = NxpFreeLists[i];
+        ULONG Index;
+        if (Head == NULL) continue;
+        Index = NXP_PAGE_INDEX(Head);
+        if (NxpPageState[Index] == 0)
+            return NxpDetachEmptyBucketPage(Index);
+    }
     for (i = 0; i < NXK_POOL_WINDOW_PAGES; ++i)
     {
 #if XBOX_RESERVE_UPPER_RAM
@@ -269,8 +304,6 @@
         OldClass = ((NXP_HEADER *)(NXK_POOL_WINDOW_BASE +
                    ((ULONG_PTR)i << PAGE_SHIFT)))->ClassIndex;
         if (OldClass / NXP_CLASSES != Class / NXP_CLASSES) continue;
-#else
-        UNREFERENCED_PARAMETER(Class);
 #endif
         return NxpDetachEmptyBucketPage(i);
     }
@@ -383,6 +416,9 @@
         /* Block 0 satisfies this request; chain the rest. */
         /* Mark as a bucket page with one live block in a single write. */
         NxpPageState[NXP_PAGE_INDEX(Page)] = 1;
+        NXP_FREE *Head = NxpFreeLists[Class];
+        if (Head)
+            Head->Prev = (NXP_FREE *)(Page + Size + sizeof(NXP_HEADER));
         for (ULONG i = 1; i < Count; i++)
         {
             NXP_HEADER *H = (NXP_HEADER *)(Page + i * Size);
@@ -390,11 +426,12 @@
             H->Tag = 0;
             H->ClassIndex = (USHORT)Class;
             H->Magic = NXP_MAGIC_FREE;
-            F->Next = NxpFreeLists[Class];
-            F->Prev = NULL;
-            if (F->Next) F->Next->Prev = F;
-            NxpFreeLists[Class] = F;
-        }
+            F->Next = Head;
+            F->Prev = (NXP_FREE *)((PUCHAR)F + Size);
+            Head = F;
+        }
+        Head->Prev = NULL;
+        NxpFreeLists[Class] = Head;
         KeReleaseSpinLock(&NxpLock, OldIrql);
         Blk = (NXP_FREE *)(Page + sizeof(NXP_HEADER));
     }
