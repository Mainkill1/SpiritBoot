+static int zero_domain_write_through(void)
+{
+    fixture f; nx_config cfg=config(); cfg.max_bytes=4096; cfg.max_pages=1;
+    CHECK(init(&f,&cfg)); f.delayed=1;
+    struct { uintptr_t base; uint64_t bytes; } mdl={0,8192};
+    parent p=fresh(), later=fresh(); nx_handle h, next;
+    nx_request r=request(&f,&p,NX_WRITE,0,8192);
+    r.mdl_virtual=mdl.base; r.mdl_bytes=mdl.bytes; r.flags=NX_WRITE_THROUGH;
+    CHECK(nx_start(&f.dev,&r,&h)==NX_PENDING);
+    CHECK(!p.completions && p.pending==1 && f.commands==1);
+    CHECK(f.held[h.slot].mdl_virtual==0 && f.held[h.slot].data_virtual==0);
+    CHECK(f.held[h.slot].bytes==4096);
+    nx_request tail=request(&f,&later,NX_WRITE,8192,512);
+    CHECK(nx_start(&f.dev,&tail,&next)==NX_PENDING && f.commands==1);
+    finish_held(&f,h.slot,NX_OK,4096,0);
+    CHECK(f.commands==2 && !p.completions);
+    CHECK(f.held[h.slot].mdl_virtual==0 && f.held[h.slot].data_virtual==4096);
+    CHECK(f.held[h.slot].disk_byte==4096 && f.held[h.slot].bytes==4096);
+    finish_held(&f,h.slot,NX_OK,4096,0);
+    CHECK(f.commands==3 && f.held[h.slot].cdb[0]==0x35 && !p.completions);
+    finish_held(&f,h.slot,NX_OK,0,0);
+    CHECK(p.completions==1 && p.status==NX_OK && p.bytes==8192);
+    CHECK(f.commands==4 && !later.completions);
+    finish_held(&f,next.slot,NX_OK,512,0);
+    CHECK(later.completions==1 && later.bytes==512 && f.retires==4);
+    cleanup(&f); return 1;
+}
