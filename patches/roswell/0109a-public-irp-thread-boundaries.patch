+/* An Xbox IRP is one shared packet. Its thread can be a title's public
+ * identity; resolve the consumer-local value without rewriting the packet.
+ * Ordinary native addresses take the residue-negative path without lookup. */
+FORCEINLINE
+PETHREAD
+IopNativeIrpThread(IN PETHREAD Thread)
+{
+#ifdef SARCH_XBOX
+    if (NxkThreadViewLowBits & (1UL << ((ULONG_PTR)Thread & 31)))
+        return (PETHREAD)NxkThreadNativeObject(Thread);
+#endif
+    return Thread;
+}
+
+FORCEINLINE
+PETHREAD
+IopGetIrpThread(IN PIRP Irp)
+{
+    return IopNativeIrpThread(Irp->Tail.Overlay.Thread);
+}
