+/* The shared IRP may outlive this callback. Publish once before exposing it
+ * to title code; never restore after code that can complete/free the packet. */
+VOID NxkPublishIrpThread(PIRP Irp)
+{
+    PKTHREAD Thread = (PKTHREAD)NxkThreadNativeObject(Irp->Tail.Overlay.Thread);
+    Irp->Tail.Overlay.Thread = (PETHREAD)NxkThreadPublicPointer(Thread);
+}
