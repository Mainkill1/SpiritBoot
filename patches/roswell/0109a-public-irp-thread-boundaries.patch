@@ -0,0 +1,52 @@
+"""Compile actual IRP ownership/completion consumers with a minimal OS model."""
+from pathlib import Path
+import subprocess, sys
+here=Path(__file__).resolve().parent
+root=Path(sys.argv[2]).resolve() if len(sys.argv)>2 else here.parents[2]
+outdir=Path(sys.argv[1]).resolve();outdir.mkdir(parents=True,exist_ok=True)
+def function(path,signature):
+    s=(root/path).read_text();a=s.index(signature);b=s.index('{',a);n=1;e=b+1
+    while n:
+        n+=(s[e]=='{')-(s[e]=='}');e+=1
+    return s[a:e]+'\n'
+io='ntoskrnl/io/iomgr/irp.c';ih='ntoskrnl/include/internal/io_x.h'
+helpers=''
+for name in ['IopNativeIrpThread','IopGetIrpThread']:
+    if name+'(' in (root/ih).read_text():
+        helpers+=function(ih,'FORCEINLINE\nPETHREAD\n'+name+'(')
+# Pin every checked public callback entry site and every active raw dereference.
+import re
+device=(root/'ntoskrnl/io/iomgr/device.c').read_text()
+assert len(re.findall(r'if \(DeviceObject->TitleOwnedDriver\) NxkPublishIrpThread\(Irp\);\s*#endif\s*DeviceObject->DriverObject->DriverStartIo\(DeviceObject, Irp\);',device))==3
+irp=(root/io).read_text()
+assert 'if (DeviceObject->TitleOwnedDriver) NxkPublishIrpThread(Irp);' in irp
+assert 'AssocIrp->Tail.Overlay.Thread = Irp->Tail.Overlay.Thread;' in irp
+for path in ['ntoskrnl/io/iomgr/error.c','ntoskrnl/io/iomgr/util.c','ntoskrnl/fsrtl/notify.c','ntoskrnl/fsrtl/filelock.c']:
+    assert 'Tail.Overlay.Thread->' not in (root/path).read_text(),path
+text=(here/'irp-fixture.c').read_text()
+bodies=helpers+function('ntoskrnl/xb/threadview.c','VOID NxkPublishIrpThread(')+''.join([
+    function(ih,'FORCEINLINE\nVOID\nIopQueueIrpToThread('),
+    function(ih,'FORCEINLINE\nVOID\nIopUnQueueIrpFromThread('),
+    function(io,'VOID\nNTAPI\nIoQueueThreadIrp('),
+    *[function('ntoskrnl/xb/xbe.c','PIRP NTAPI\nXe'+name+'(') for name in ['IoBuildAsynchronousFsdRequest','IoBuildSynchronousFsdRequest','IoBuildDeviceIoControlRequest']],
+    function(io,'FORCEINLINE\nVOID\nIopClearStackLocation('),
+    function(io,'VOID\nFASTCALL\nIofCompleteRequest('),
+    function(io,'NTSTATUS\nFASTCALL\nIofCallDriver('),
+    function(io,'VOID\nNTAPI\nIoInitializeIrp('),
+    function(io,'VOID\nNTAPI\nIoReuseIrp('),
+    function(io,'VOID\nNTAPI\nIopDisassociateThreadIrp('),
+    function('ntoskrnl/io/iomgr/device.c','VOID\nNTAPI\nIoStartPacket('),
+    function('ntoskrnl/io/iomgr/device.c','VOID\nNTAPI\nIopStartNextPacket('),
+    function('ntoskrnl/io/iomgr/device.c','VOID\nNTAPI\nIopStartNextPacketByKey('),
+    function(io,'BOOLEAN\nNTAPI\nIoCancelIrp('),
+    function(io,'PEPROCESS\nNTAPI\nIoGetRequestorProcess('),
+    function(io,'NTSTATUS\nNTAPI\nIoGetRequestorSessionId('),
+    function('ntoskrnl/io/iomgr/util.c','VOID\nNTAPI\nIoSetDeviceToVerify('),
+    function('ntoskrnl/io/iomgr/util.c','PDEVICE_OBJECT\nNTAPI\nIoGetDeviceToVerify('),
+    function('ntoskrnl/io/iomgr/util.c','VOID\nNTAPI\nIoSetHardErrorOrVerifyDevice('),
+])
+out=outdir/'irp-thread-host-generated.c';out.write_text(text.replace('/* PRODUCTION_BODIES */',bodies))
+subprocess.run(['cc','-std=gnu11','-O1','-g','-fsanitize=address,undefined','-fno-omit-frame-pointer',
+                '-Wall','-Wextra','-Werror','-Wno-unused-parameter','-Wno-unused-function',
+                str(out),'-o',str(outdir/'irp-thread-host')],check=True)
+subprocess.run([str(outdir/'irp-thread-host')],check=True)
