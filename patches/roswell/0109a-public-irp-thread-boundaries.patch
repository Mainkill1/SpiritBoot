+enum {KernelMode,OriginalApcEnvironment=0,AttachedApcEnvironment=1};
+/* PRODUCTION_BODIES */
+static NTSTATUS completed(PDEVICE_OBJECT d,PIRP i,PVOID c){assert(i==callback_irp&&i->Tail.Overlay.Thread==expected_public);callbacks++;return STATUS_SUCCESS;}
+static void cancelled(PDEVICE_OBJECT d,PIRP i){assert(i->Cancel&&i->Tail.Overlay.Thread==expected_public);cancel_calls++;IoReleaseCancelSpinLock(i->CancelIrql);}
+static void init(PIRP i,PETHREAD t){memset(i,0,sizeof(*i)+2*sizeof(STACK));i->Type=IO_TYPE_IRP;i->Size=sizeof(*i)+2*sizeof(STACK);i->StackCount=i->CurrentLocation=1;i->Tail.Overlay.Thread=t;i->Tail.Overlay.CurrentStackLocation=(STACK *)(i+1);i->IoStatus.Status=0;InitializeListHead(&i->ThreadListEntry);}
+static DEVICE layered[3];
+static unsigned layer_calls,start_calls,retained;
+static NTSTATUS layer_dispatch(PDEVICE_OBJECT d,PIRP i){
+    unsigned n=(unsigned)(d-layered);layer_calls++;
+    assert(i->Tail.Overlay.Thread==(n==0?&native_thread:&public_thread));checks++;
+    assert(IoGetRequestorProcess(i)==&process);checks++;
+    if(n<2)return IofCallDriver(d+1,i);
