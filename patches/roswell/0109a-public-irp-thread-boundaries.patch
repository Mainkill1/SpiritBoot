+}
+static NTSTATUS free_dispatch(PDEVICE_OBJECT d,PIRP i){assert(i->Tail.Overlay.Thread==&public_thread);free(i);checks++;return STATUS_SUCCESS;}
+static void start_io(PDEVICE_OBJECT d,PIRP i){assert(i->Tail.Overlay.Thread==&public_thread&&d->CurrentIrp==i);start_calls++;checks++;}
+static void free_start_io(PDEVICE_OBJECT d,PIRP i){assert(i->Tail.Overlay.Thread==&public_thread);free(i);checks++;}
+static NTSTATUS retain_complete(PDEVICE_OBJECT d,PIRP i,PVOID c){assert(i->Tail.Overlay.Thread==&public_thread);retained++;checks++;return STATUS_MORE_PROCESSING_REQUIRED;}
+static NTSTATUS free_complete(PDEVICE_OBJECT d,PIRP i,PVOID c){assert(i->Tail.Overlay.Thread==&public_thread);free(i);checks++;return STATUS_MORE_PROCESSING_REQUIRED;}
+static void boundary_cases(void){
+    DRIVER drivers[3]={0};
+    for(unsigned n=0;n<3;n++){drivers[n].MajorFunction[0]=layer_dispatch;layered[n].DriverObject=&drivers[n];layered[n].TitleOwnedDriver=(n==1);}
+    PIRP i=calloc(1,sizeof(*i)+4*sizeof(STACK));assert(i);init(i,&native_thread);
+    i->StackCount=3;i->CurrentLocation=4;i->Tail.Overlay.CurrentStackLocation=(STACK *)(i+1)+3;
+    unsigned before=apcs;assert(IofCallDriver(&layered[0],i)==0&&layer_calls==3&&apcs==before+1);checks++;free(i);
+    DEVICE d={.DriverObject=&drivers[0],.TitleOwnedDriver=1};drivers[0].MajorFunction[0]=free_dispatch;
+    i=calloc(1,sizeof(*i)+2*sizeof(STACK));assert(i);init(i,&native_thread);i->CurrentLocation=2;i->Tail.Overlay.CurrentStackLocation++;
+    assert(IofCallDriver(&d,i)==0);checks++; /* callback frees: ASan catches any post-call access */
+    drivers[0].DriverStartIo=start_io;
+    PIRP queued[3];
+    for(unsigned n=0;n<3;n++){queued[n]=calloc(1,sizeof(*i)+2*sizeof(STACK));assert(queued[n]);init(queued[n],&native_thread);ULONG key=n;IoStartPacket(&d,queued[n],n?&key:NULL,NULL);}
+    assert(start_calls==1&&queued[1]->Tail.Overlay.Thread==&native_thread);checks++;
+    IopStartNextPacket(&d,FALSE);IopStartNextPacketByKey(&d,FALSE,2);IopStartNextPacket(&d,FALSE);
+    assert(start_calls==3&&d.CurrentIrp==NULL&&current_irql==0);checks++;
+    for(unsigned n=0;n<3;n++)free(queued[n]);
+    drivers[0].DriverStartIo=free_start_io;
+    i=calloc(1,sizeof(*i)+2*sizeof(STACK));assert(i);init(i,&native_thread);IoStartPacket(&d,i,NULL,NULL);
+    assert(current_irql==0);checks++;
+    i=calloc(1,sizeof(*i)+2*sizeof(STACK));assert(i);init(i,&public_thread);
+    i->Tail.Overlay.CurrentStackLocation->Control=SL_INVOKE_ON_SUCCESS;
+    i->Tail.Overlay.CurrentStackLocation->CompletionRoutine=retain_complete;
+    before=apcs;IofCompleteRequest(i,0);
+    assert(retained==1&&apcs==before&&i->Tail.Overlay.Thread==&public_thread);checks++;
+    IoReuseIrp(i,STATUS_PENDING);assert(i->Tail.Overlay.Thread==NULL);checks++;
+    init(i,&public_thread);i->Tail.Overlay.CurrentStackLocation->Control=SL_INVOKE_ON_SUCCESS;
+    i->Tail.Overlay.CurrentStackLocation->CompletionRoutine=free_complete;IofCompleteRequest(i,0);
+    assert(apcs==before);checks++;
+}
+int main(int argc,char **argv){
+    unsigned mode=argc>1?(unsigned)strtoul(argv[1],NULL,10):0;
+    NxkThreadViewLowBits=1u<<((uintptr_t)&public_thread&31);
+    native_thread.ThreadsProcess=native_thread.Tcb.ApcState.Process=&process;
+    InitializeListHead(&native_thread.IrpList);InitializeListHead(&public_thread.IrpList);
+    unsigned char memory[sizeof(IRP)+2*sizeof(STACK)] __attribute__((aligned(16)));
+    PIRP i=(PIRP)memory;
+    for(unsigned pub=0;pub<2;pub++)for(unsigned cancel=0;cancel<2;cancel++)for(unsigned other=0;other<2;other++){
+        PETHREAD t=pub?&public_thread:&native_thread;init(i,t);expected_public=t;
+        current=&native_thread;
+        if(mode!=1){IoQueueThreadIrp(i);assert(i->Tail.Overlay.Thread==t&&native_thread.IrpList.Flink==&i->ThreadListEntry&&guarded==0);checks++;}
+        if(mode==2){guarded++;IopUnQueueIrpFromThread(i);guarded--;continue;}
+        i->Tail.Overlay.CurrentStackLocation->Control=SL_INVOKE_ON_SUCCESS;
+        i->Tail.Overlay.CurrentStackLocation->CompletionRoutine=completed;callback_irp=i;
+        if(cancel){i->CancelRoutine=cancelled;assert(IoCancelIrp(i));checks++;}
+        current=other?&other_thread:&native_thread;unsigned before=apcs;
+        IofCompleteRequest(i,0);assert(apcs==before+1);checks++;
+        current=&native_thread;guarded++;IopUnQueueIrpFromThread(i);guarded--;
+        assert(IsListEmpty(&native_thread.IrpList)&&IsListEmpty(&i->ThreadListEntry));checks++;
+    }
+    if(mode==2){puts("queue-only passed");return 0;}
+    for(unsigned pub=0;pub<2;pub++){
+        PETHREAD t=pub?&public_thread:&native_thread;init(i,t);unsigned session=0;DEVICE d;
+        assert(IoGetRequestorProcess(i)==&process);checks++;
+        assert(IoGetRequestorSessionId(i,&session)==0&&session==77);checks++;
+        IoSetDeviceToVerify(t,&d);assert(IoGetDeviceToVerify(&native_thread)==&d);checks++;
+        IoSetHardErrorOrVerifyDevice(i,NULL);assert(IoGetDeviceToVerify(t)==NULL);checks++;
+    }
+    init(i,NULL);i->Cancel=1;unsigned before=cleanups;IofCompleteRequest(i,0);assert(cleanups==before+1);checks++;
+    init(i,NULL);assert(IoGetRequestorProcess(i)==NULL);checks++;
+    assert(callbacks==8&&cancel_calls==4);checks++;
+    /* Exit disassociation clears the shared field before later cancellation completion. */
+    init(i,&public_thread);IoQueueThreadIrp(i);IopDisassociateThreadIrp();
+    assert(i->Tail.Overlay.Thread==NULL&&IsListEmpty(&native_thread.IrpList)&&IsListEmpty(&i->ThreadListEntry));checks++;
+    i->Cancel=TRUE;before=cleanups;IofCompleteRequest(i,0);assert(cleanups==before+1);checks++;
+    for(unsigned success=0;success<2;success++)for(unsigned builder=0;builder<3;builder++){
+        init(i,&native_thread);built=success?i:NULL;PIRP got;
+        if(builder==0)got=XeIoBuildAsynchronousFsdRequest(0,NULL,NULL,0,NULL,NULL);
+        else if(builder==1)got=XeIoBuildSynchronousFsdRequest(0,NULL,NULL,0,NULL,NULL,NULL);
+        else got=XeIoBuildDeviceIoControlRequest(0,NULL,NULL,0,NULL,0,0,NULL,NULL);
+        assert(got==built&&(!got||got->Tail.Overlay.Thread==&public_thread));checks++;
+    }
+    boundary_cases();
+    /* A completion owner can retain and reuse a public packet. */
+    init(i,&public_thread);i->AllocationFlags=7;IoReuseIrp(i,STATUS_PENDING);
+    assert(i->Tail.Overlay.Thread==NULL&&i->IoStatus.Status==STATUS_PENDING&&i->AllocationFlags==7);checks++;
+    printf("irp_thread_checks=%u passed; completion_callbacks=%u cancel_callbacks=%u\n",checks,callbacks,cancel_calls);
+}
