+/* Bound transport concurrency, not guest request admission. One owner assigns
+ * core slots in FIFO order; queued parents retain their envelopes and MDLs. */
+static void admit_waiting_requests(NX_NATIVE_ADAPTER *adapter)
+{
+    port_enter(adapter);
+    if(adapter->admission_active) { port_leave(adapter);return; }
+    adapter->admission_active=1;
+    for(;;) {
+        NX_NATIVE_ENVELOPE *envelope;
+        nx_handle handle={UINT32_MAX,0};
+        unsigned cancel_after=0,quarantined;
+        envelope=adapter->waiting_head;
+        if(!envelope || (adapter->data_active==adapter->data_limit &&
+                         !adapter->quarantined)) {
+            adapter->admission_active=0;
+            (void)KeSetEvent(&adapter->drain_event,IO_NO_INCREMENT,FALSE);
+            port_leave(adapter);return;
+        }
+        adapter->waiting_head=envelope->next_waiting;
+        if(!adapter->waiting_head) adapter->waiting_tail=NULL;
+        envelope->next_waiting=NULL;envelope->queued=0;envelope->start_active=1;
+        envelope->waiting_request.cancelled=envelope->cancel_latched;
+        quarantined=adapter->quarantined;
+        if(!quarantined) { ++adapter->data_active;envelope->admitted=1; }
+        port_leave(adapter);
+        if(quarantined) port_complete(adapter,envelope->parent,NX_IO_ERROR,0);
+        else (void)nx_start(&adapter->core,&envelope->waiting_request,&handle);
+        port_enter(adapter);
+        if(envelope->active && !envelope->completed) {
+            envelope->handle=handle;envelope->handle_valid=handle.slot!=UINT32_MAX;
+            cancel_after=envelope->cancel_latched && envelope->handle_valid;
+        }
+        /* Hold the envelope through a possible synchronous cancellation. */
+        port_leave(adapter);
+        if(cancel_after) nx_cancel(&adapter->core,handle);
+        port_enter(adapter);
+        envelope->start_active=0;release_envelope_locked(envelope);
+    }
+}
+
+static VOID NTAPI NxNativeAdmissionDpc(PKDPC dpc,PVOID context,PVOID argument1,PVOID argument2)
+{
+    (void)dpc;(void)argument1;(void)argument2;
+    admit_waiting_requests(context);
+}
