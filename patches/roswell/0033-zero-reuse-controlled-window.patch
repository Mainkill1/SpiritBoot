+/* The test uses SpiritBoot's system-VA aperture, not the pool fallback.
+ * Partial frees of an ordinary pool allocation are not valid. */
+static int system_pages(const void *base, unsigned bytes)
+{
+    uintptr_t address = (uintptr_t)base;
+    return address >= 0xd0000000u && address < 0xd4000000u &&
+           !(address & (PAGE - 1)) && bytes <= 0xd4000000u - address;
+}
+
+typedef struct ZeroResult {
+    int allocated, new_zero[3], exact, recycled_zero, left, right;
+    unsigned middle_freed, left_freed, recycled_freed, right_freed;
+    unsigned original_physical, recycled_physical;
+    int recycled;
+} ZeroResult;
+
+static ZeroResult exercise_reuse(void)
+{
+    ZeroResult result = { 0 };
+    unsigned char *pages, *reused;
+    unsigned physical;
+    unsigned char old_irql = KeRaiseIrqlToDpcLevel();
+
+    /* UP kernel: exclude thread teardown and DPC page returns for one
+     * bounded iteration. The warmed system-VA/PFN path uses spinlocks,
+     * not pageable or waiting services. Record only; never emit TAP here. */
+    pages = MmAllocateSystemMemory(3 * PAGE, PAGE_READWRITE);
+    if (!pages) goto done;
+    if (!system_pages(pages, 3 * PAGE)) {
+        MmFreeSystemMemory(pages, 3 * PAGE);
+        goto done;
+    }
+    result.allocated = 1;
+    for (unsigned i = 0; i < 3; ++i)
+        result.new_zero[i] = filled(pages + i * PAGE, 0);
+    physical = MmGetPhysicalAddress(pages + PAGE);
+    result.original_physical = physical;
+    memset(pages, 0x31, PAGE);
+    memset(pages + PAGE, 0xa7, PAGE);
+    memset(pages + 2 * PAGE, 0x73, PAGE);
+    result.middle_freed = MmFreeSystemMemory(pages + PAGE, PAGE);
+    if (result.middle_freed != 1) {
+        MmFreeSystemMemory(pages, 3 * PAGE);
+        goto done;
+    }
+    reused = MmAllocateSystemMemory(PAGE, PAGE_READWRITE);
+    if (reused && system_pages(reused, PAGE)) {
+        result.recycled = 1;
+        result.recycled_physical = MmGetPhysicalAddress(reused);
+        result.exact = result.recycled_physical == physical;
+        result.recycled_zero = filled(reused, 0);
+        result.left = filled(pages, 0x31);
+        result.right = filled(pages + 2 * PAGE, 0x73);
+    }
+    /* Even failure/fallback paths leave the guard before fatal reporting.
+     * Free a fallback only at its original base and complete object size. */
+    result.left_freed = MmFreeSystemMemory(pages, PAGE);
+    if (reused) result.recycled_freed = MmFreeSystemMemory(reused, PAGE);
+    result.right_freed = MmFreeSystemMemory(pages + 2 * PAGE, PAGE);
+done:
+    KfLowerIrql(old_irql);
+    return result;
+}
+
 int main(void)
 {
     regression_begin();
