+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile the real zero-reuse guest against deterministic kernel/TAP adapters.
+
+The adapter injects a thread-return PFN between unguarded free/reallocate calls.
+It validates the guest's IRQL/report ordering, not a copied guest algorithm.
+"""
+import argparse
+from pathlib import Path
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[3]
+p = argparse.ArgumentParser()
+p.add_argument('output', type=Path)
+p.add_argument('--guest', type=Path, default=ROOT / 'tests/xbe/zero-reuse/main.c')
+p.add_argument('--expect-old', action='store_true')
+a = p.parse_args()
+a.output.mkdir(parents=True, exist_ok=True)
+guest = a.guest.read_text().replace('#include "../regression.h"', '').replace('int main(void)', 'static int guest_main(void)')
+head = r'''
+#define _GNU_SOURCE
+#include <assert.h>
+#include <setjmp.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#define PAGE_READWRITE 4
+static unsigned irql, original, checks, failures, allocations, raises, lowers;
+static unsigned scenario, frees, deferred, thread_returns, pool_frees;
+static unsigned fault, fault_seen, active[4], physical[4], next_pfn, old_test;
+static unsigned guarded_allocations, guarded_phys, guarded_frees, iteration_phys;
+static unsigned char *arena;
+static jmp_buf done;
+static unsigned char *page_at(unsigned i) { return arena + i * 4096; }
+static unsigned index_of(void *p) {
+    assert((uintptr_t)p >= (uintptr_t)arena && (uintptr_t)p < (uintptr_t)arena + 16384);
+    assert(((uintptr_t)p & 4095) == 0);
+    return ((unsigned char *)p - arena) / 4096;
+}
+static unsigned char *pool;
+static void thread_return(void) { ++thread_returns; next_pfn = 777; }
+static unsigned char KeRaiseIrqlToDpcLevel(void) {
+    unsigned char old = irql; assert(irql <= 2); irql = 2; ++raises; return old;
+}
+static void KfLowerIrql(unsigned char old) {
+    assert(irql == 2 && old == original); irql = old; ++lowers;
+    if (deferred) { deferred = 0; thread_return(); }
+}
+static void *MmAllocateSystemMemory(unsigned size, unsigned prot) {
+    assert(prot == PAGE_READWRITE); ++allocations;
+    if (size == 12288) {
+        assert(!active[0] && !active[1] && !active[2]);
+        if (allocations != 1) {
+            ++scenario; frees = iteration_phys = 0;
+            if (!old_test) assert(irql == 2);
+            if (irql == 2) ++guarded_allocations;
+            if (fault == 1 && !fault_seen) { ++fault_seen; return NULL; }
+            if (fault == 4 && !fault_seen) { ++fault_seen; return pool; }
+        }
+        for(unsigned i=0;i<3;++i) { active[i]=1; physical[i]=100+i; }
+        memset(arena,0,12288); return arena;
+    }
+    assert(size == 4096 && !active[1] && frees == 1);
+    if (!old_test) assert(irql == 2);
+    if (irql == 2) ++guarded_allocations;
+    if (fault == 5 && !fault_seen) { ++fault_seen; return pool; }
+    if (fault == 3 && !fault_seen) { ++fault_seen; return NULL; }
+    active[1]=1; physical[1]=next_pfn;
+    memset(page_at(1),0,4096); return page_at(1);
+}
+static unsigned MmFreeSystemMemory(void *p,unsigned size) {
+    if (p == pool) { assert(size == (fault == 5 ? 4096u : 12288u));
+        assert(irql == 2); ++pool_frees; return size / 4096; }
+    unsigned idx=index_of(p), count=size/4096;
+    if (scenario && !old_test) assert(irql == 2);
+    if (scenario && irql == 2) ++guarded_frees;
+    assert(size==count*4096 && idx+count<=3);
+    for(unsigned i=idx;i<idx+count;++i) assert(active[i]);
+    if (scenario && size==4096 && idx==1 && frees==0) {
+        assert(iteration_phys == 1);
+        for (unsigned i=0;i<4096;++i) {
+            assert(page_at(0)[i]==0x31 && page_at(1)[i]==0xa7 && page_at(2)[i]==0x73);
+        }
+        if (fault==2 && !fault_seen) { ++fault_seen; return 0; }
+        next_pfn=physical[1];
+        if (irql < 2) thread_return(); else deferred=1;
+    }
+    for(unsigned i=idx;i<idx+count;++i) active[i]=0;
+    ++frees; return count;
+}
+static unsigned MmGetPhysicalAddress(void *p) {
+    unsigned i=index_of(p); assert(active[i]);
+    if (!old_test) assert(irql == 2);
+    ++iteration_phys;
+    assert(i == 1 && iteration_phys <= 2);
+    if (irql == 2) ++guarded_phys;
+    return physical[i]*4096;
+}
+static void tap_comment(const char *fmt, ...) { assert(irql==original); (void)fmt; }
+static void regression_begin(void) { assert(irql==original); }
+static void regression_check(int pass,const char *desc) {
+    assert(irql==original); ++checks; if (!pass) { ++failures; fprintf(stderr,"not ok %u %s\n",checks,desc); }
+}
+static void regression_finish(void) __attribute__((noreturn));
+static void regression_finish(void) { assert(irql==original); longjmp(done,1); }
+static void regression_require(int pass,const char *desc) {
+    regression_check(pass,desc); if(!pass) regression_finish();
+}
+'''
+tail = r'''
+int main(int argc,char **argv) {
+    assert(argc==4); fault=strtoul(argv[1],NULL,0); original=irql=strtoul(argv[2],NULL,0);
+    unsigned old=old_test=strtoul(argv[3],NULL,0);
+    arena=mmap((void *)0xd0000000,16384,PROT_READ|PROT_WRITE,
+               MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+    assert(arena==(void *)0xd0000000);
+    pool=aligned_alloc(4096,12288); assert(pool); memset(pool,0,12288);
+    if(!setjmp(done)) guest_main();
+    assert(irql==original && raises==lowers);
+    if(!fault) {
+        assert(checks==54);
+        assert(failures==(old ? 4 : 0));
+        assert(raises==(old ? 0 : 4));
+        assert(thread_returns==4);
+        assert(guarded_allocations==(old ? 0 : 8));
+        assert(guarded_phys==(old ? 0 : 8));
+        assert(guarded_frees==(old ? 0 : 16));
+    } else {
+        assert(fault_seen==1 && failures==1 && raises==1 && lowers==1);
+        assert(!active[0] && !active[1] && !active[2]);
+        if(fault==4 || fault==5) assert(pool_frees==1);
+    }
+    printf("PASS fault=%u original_irql=%u checks=%u failures=%u raises=%u lowers=%u returns=%u\n",
+           fault,original,checks,failures,raises,lowers,thread_returns);
+    free(pool); munmap(arena,16384); return 0;
+}
+'''
+source=a.output/'fixture.c'
+source.write_text(head+'\n'+guest+'\n'+tail)
+binary=a.output/'fixture'
+subprocess.run(['cc','-std=gnu11','-O2','-Wall','-Wextra','-Werror','-Wno-unused-function',str(source),'-o',str(binary)],check=True)
+for level in [0,1]:
+    for fault in ([0] if a.expect_old else range(6)):
+        subprocess.run([str(binary),str(fault),str(level),str(int(a.expect_old))],check=True)
