+#!/usr/bin/env python3
+"""Actual boot-thread creation tail and actual reaper, with object service ledger.
+
+The regression is a boot-only reference surviving completed thread reaping.
+Object-manager and scheduler primitives are replaced at their service boundary;
+reference increments, decrements, handle ownership, stack release and final
+object deletion stay observable. Native execution remains a separate check.
+"""
+from pathlib import Path
+import re, subprocess, sys, json
+root=Path(sys.argv[2]).resolve() if len(sys.argv)>2 else Path(__file__).resolve().parents[3]
+out=Path(sys.argv[1]).resolve();out.mkdir(parents=True,exist_ok=True)
+manager=(root/'ntoskrnl/ps/psmgr.c').read_text()
+start=manager.index('    /* Setup the system initialization thread */')
+end=manager.index('\n}',start)
+boot=manager[start:end]
+kill=(root/'ntoskrnl/ps/kill.c').read_text()
+start=kill.index('PspReapRoutine(IN PVOID Context)');start=kill.index('{',start)
+end=start+1;depth=1
+while depth:
+ depth+=(kill[end]=='{')-(kill[end]=='}');end+=1
+reaper='static void PspReapRoutine(void *Context)\n'+kill[start:end]
+fixture=Path(__file__).with_name('fixture.c').read_text()
+source=out/'actual.c';source.write_text(fixture.replace('/* ACTUAL BOOT TAIL */',boot).replace('/* ACTUAL REAPER */',reaper))
+rows=[]
+for xbox,nxk in [(1,1),(1,0),(0,1),(0,0)]:
+ name=f'xbox{xbox}-nxk{nxk}';exe=out/name
+ cmd=['cc','-std=c11','-Wall','-Wextra','-Werror','-Wno-unused-parameter','-fsanitize=address,undefined','-fno-omit-frame-pointer','-fno-pie','-no-pie',f'-DTEST_XBOX={xbox}',f'-DTEST_NXK={nxk}',str(source),'-o',str(exe)]
+ if xbox:cmd.insert(1,'-DSARCH_XBOX')
+ if nxk:cmd.insert(1,'-DNXK_MM_PHYS')
+ subprocess.run(cmd,check=True)
+ r=subprocess.run([str(exe)],text=True,capture_output=True)
+ print(name,r.stdout+r.stderr,end='')
+ rows.append({'variant':name,'exit_code':r.returncode,'stdout':r.stdout,'stderr':r.stderr})
+(out/'results.json').write_text(json.dumps(rows,indent=2)+'\n')
+sys.exit(any(row['exit_code'] for row in rows))
