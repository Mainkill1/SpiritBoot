+++ b/tests/host/pool-classes/check.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Production pool mapping, carving, retyping, capacity and measured-distribution bounds."""
+import importlib.util,re,subprocess,sys
+from pathlib import Path
+sys.dont_write_bytecode=True
+root=Path(__file__).resolve().parents[3];out=Path(sys.argv[1]).resolve();out.mkdir(parents=True,exist_ok=True)
+spec=importlib.util.spec_from_file_location('extract',root/'tests/host/kernel-performance/check.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
+pool=(root/'ntoskrnl/xb/mm/pool.c').read_text()
+macros=pool[pool.index('#ifdef NXK_MM_POOLPAGES'):pool.index('/* SIZE CLASSES')]
+definitions=pool[pool.index('static const USHORT NxpClassSize'):pool.index('/* BIG-BLOCK TABLE')]
+names=['InitializePool','NxpAllocFailed','NxpDetachEmptyBucketPage','NxpReuseEmptyBucketPage','NxpAllocatePoolWithTag','ExAllocatePoolWithTag','NxTitleAllocatePoolWithTag','NxTitleAllocatePool','ExFreePoolWithTag','NxpReclaimEmptyBucketPages','ExQueryPoolBlockSize']
+bodies=''.join(m.function(pool,n) for n in names if re.search(r'\b'+n+r'\s*\([^;]*?\)\s*\{',pool))
+# Count actual production back-link stores; the fixture still executes the
+# allocation bodies and maintains their real list contents.
+bodies=re.sub(r'(\b[A-Za-z_]\w*(?:->\w+)*)->Prev = ([^;]+);',
+              r'CountPrevWrite(&\1->Prev, \2);',bodies)
+counts='\nstatic unsigned prev_writes; static void CountPrevWrite(NXP_FREE **p, NXP_FREE *v) {prev_writes++;*p=v;}\n'
+for reserve in [0,1]:
+ src=out/f'refill-{reserve}.c';src.write_text((root/'tests/host/pool-refill/shim.c').read_text()+f'\n#define XBOX_RESERVE_UPPER_RAM {reserve}\n'+macros+definitions+counts+'\nULONG NxpReclaimEmptyBucketPages(void);\n'+bodies+(root/'tests/host/pool-classes/cases.c').read_text())
+ exe=src.with_suffix('');subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-g','-fsanitize=address,undefined',str(src),'-o',str(exe)],check=True);subprocess.run([str(exe)],check=True)
