+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise actual destination selection with a returned low pin-only frame."""
+from pathlib import Path
+import subprocess
+import sys
+root=Path(__file__).resolve().parents[3];out=Path(sys.argv[1]).resolve();out.mkdir(parents=True,exist_ok=True)
+s=(root/'ntoskrnl/xb/mm/pagesupply.c').read_text();s=s[s.index('PFN_NUMBER\nNxkPageSupplyTakeAnyOutside('):];s=s[:s.index('\n}\n')+3]
+shim=r'''
+#include <stdint.h>
+#include <assert.h>
+#include <stdio.h>
+typedef uint32_t PFN_NUMBER;
+#define IN
+#define NXP_FREE 0x80000000u
+#define NXP_GENERIC_FLOOR_PFN 16u
+#define NXP_NEXT(e) ((e)&0x7fffu)
+#define MI_ASSERT_PFN_LOCK_HELD() ((void)0)
+static uint32_t NxpLinks[256];
+static uint32_t NxpFreeHeadKernel,NxpFreeHeadTitle,NxpSpillHint,NxpHighestPfn=255;
+static void NxpUnlink(unsigned p) {assert(NxpLinks[p]&NXP_FREE);NxpLinks[p]=0;}
+'''
+main=r'''
+int main(void){
+ NxpSpillHint=1;NxpFreeHeadTitle=1;
+ NxpLinks[1]=NXP_FREE|128;NxpLinks[128]=NXP_FREE;
+ unsigned chosen=NxkPageSupplyTakeAnyOutside(20,30);
+ if(chosen!=128 || !(NxpLinks[1]&NXP_FREE)){
+  fprintf(stderr,"FAIL selected PFN %u; pin-only PFN 1 must remain free\n",chosen);return 1;
+ }
+ puts("generic destination selection PASS");
+}
+'''
+(out/'destinations.c').write_text(shim+s+main)
+subprocess.run(['cc','-std=c11','-O2','-Wall','-Wextra','-Werror',str(out/'destinations.c'),'-o',str(out/'destinations')],check=True)
+subprocess.run([str(out/'destinations')],check=True)
