+static
+CODE_SEG("PAGE")
+VOID
+AtaFdoAllocateRetainedSgBuffer(
+    _In_ PATAPORT_PORT_DATA PortData)
+{
+    PDMA_OPERATIONS DmaOperations;
+    ULONG BufferLength;
+    NTSTATUS Status;
+
+    PAGED_CODE();
+
+    if (PortData->RetainedSgBuffer || PortData->QueueDepth != 1)
+        return;
+
+    DmaOperations = PortData->DmaAdapter->DmaOperations;
+    if (!DmaOperations->CalculateScatterGatherList ||
+        !DmaOperations->BuildScatterGatherList)
+    {
+        return;
+    }
+
+    Status = DmaOperations->CalculateScatterGatherList(
+        PortData->DmaAdapter,
+        NULL,
+        NULL,
+        PortData->MaximumTransferLength,
+        &BufferLength,
+        NULL);
+    if (!NT_SUCCESS(Status) || BufferLength == 0)
+        return;
+
+    PortData->RetainedSgBuffer = ExAllocatePoolWithTag(NonPagedPool,
+                                                       BufferLength,
+                                                       ATAPORT_TAG);
+    if (PortData->RetainedSgBuffer)
+        PortData->RetainedSgBufferLength = BufferLength;
+}
