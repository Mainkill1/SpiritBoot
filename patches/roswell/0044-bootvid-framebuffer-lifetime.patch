@@ -0,0 +1,138 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+typedef uint32_t PFN_NUMBER; typedef int KIRQL; typedef uint16_t USHORT; typedef int32_t LONG; typedef void VOID; typedef int BOOLEAN; typedef uint32_t ULONG; typedef uintptr_t ULONG_PTR; typedef uint8_t UCHAR; typedef UCHAR *PUCHAR; typedef ULONG *PULONG; typedef USHORT *PUSHORT; typedef void *PVOID;
+#define TRUE 1
+#define FALSE 0
+#define NTAPI
+#define SARCH_XBOX
+#define NXK_MM_PHYS
+#define PAGE_SHIFT 12
+#define NXK_NV2A_INSTANCE_BASE 0x03fe0000u
+#define NXK_NV2A_INSTANCE_BYTES 0x10000u
+#define NXK_KSEG0_RAM_SIZE 0x4000000u
+#define NXK_MAX_EXTRA_DESCRIPTORS 2
+#define NV2A_VIDEO_MEMORY_SIZE 4096
+#define SCREEN_WIDTH 4
+#define SCREEN_HEIGHT 3
+#define BOOTCHAR_HEIGHT 1
+#define BV_COLOR_BLACK 0
+#define PAGE_SIZE 4096
+#define ASSERT(x) do { if(!(x))abort(); } while(0)
+#define NV2A_CRTC_FRAMEBUFFER_START 0
+#define NV2A_RAMDAC_FP_HVALID_END 4
+#define NV2A_RAMDAC_FP_VVALID_END 8
+#define MmNonCached 0
+#define DPRINT1(...) ((void)0)
