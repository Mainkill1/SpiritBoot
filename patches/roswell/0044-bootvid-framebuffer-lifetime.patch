diff --git a/tests/host/bootvid-lifetime/README.md b/tests/host/bootvid-lifetime/README.md
new file mode 100644
index 00000000..e5c2f65d
--- /dev/null
+++ b/tests/host/bootvid-lifetime/README.md
@@ -0,0 +1,23 @@
+# Xbox boot framebuffer lifetime fixture
+
+Run `python3 tests/host/bootvid-lifetime/check.py <output-directory>`.
+
+The harness extracts actual Xbox bootvid initialization, palette/reset/pixel/fill
+bodies and production offset macros; Inbv reset/bitmap/buffer dispatch and ownership
+bodies; and the NV2A descriptor split and deferred donation bodies. Hardware mapping,
+page donation, and the spin lock are host shims. A deterministic lock acquisition
+hook retires the driver between a caller's initial check and dispatch. Drawing
+uses a small synthetic framebuffer and verifies that reused bytes remain unchanged.
+
+The fifteen checks cover the initial reservation, retained hardware padding, boot
+writes, one-time deferred donation, terminal initialization/ownership, retired
+primitive writes, and queued bitmap/buffer/reset dispatch, enable, and ownership-loss notification.
+The donation harness runs the production PHYS page-return loop, page supply
+initialization/return/list insertion, and `MiGetPfnEntry` lookup. It verifies full
+64/128 MiB links/pin metadata initialization, then observes PFN visibility at each
+return before the page becomes available, including exclusion of hardware padding.
+Bitmap operations, PFN locking, and persistence policy remain host shims. The reserved range and retained padding are the same for the
+64 MiB and 128 MiB build layouts. This is a source lifetime
+regression, not native display or title qualification. A legacy source baseline can
+be supplied as the optional second argument; missing new lifecycle functions use
+explicit no-op compatibility hooks so baseline behavior remains observable.
diff --git a/tests/host/bootvid-lifetime/check.py b/tests/host/bootvid-lifetime/check.py
new file mode 100644
index 00000000..0c2ecac7
--- /dev/null
+++ b/tests/host/bootvid-lifetime/check.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""Compile actual Xbox bootvid, Inbv dispatch and reservation bodies."""
+import pathlib, re, subprocess, sys
+root = pathlib.Path(sys.argv[2]).resolve() if len(sys.argv) > 2 else pathlib.Path(__file__).resolve().parents[3]
+out = pathlib.Path(sys.argv[1]).resolve(); out.mkdir(parents=True, exist_ok=True)
+def body(path, name):
+    text = (root / path).read_text()
+    m = re.search(r'\n' + name + r'\s*\(', text)
+    if m is None: return None
+    start = text.index('{', m.end()); end = start + 1; depth = 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}'); end += 1
+    return text[start:end]
+def extract(path, signatures):
+    return '\n'.join(sig + '\n' + body(path, sig.split('(')[0].split()[-1]) for sig in signatures)
+vid = 'drivers/base/bootvid/i386/xbox/bootvid.c'
+inbv = 'ntoskrnl/inbv/inbv.c'
+mm = 'ntoskrnl/xb/mm/init.c'
+bodies = extract(vid, ['BOOLEAN VidInitialize(BOOLEAN SetMode)', 'VOID ApplyPalette(VOID)', 'VOID InitPaletteWithTable(const ULONG* Table, ULONG Count)', 'VOID SetPixel(ULONG Left, ULONG Top, UCHAR Color)', 'VOID VidSolidColorFill(ULONG Left, ULONG Top, ULONG Right, ULONG Bottom, UCHAR Color)', 'VOID ResetDisplay(BOOLEAN SetMode)', 'VOID PreserveRow(ULONG CurrentTop, ULONG Height, BOOLEAN Restore)', 'VOID DoScroll(ULONG Scroll)', 'VOID VidScreenToBufferBlt(PUCHAR Buffer, ULONG Left, ULONG Top, ULONG Width, ULONG Height, ULONG Stride)'])
+for path, sig, fallback in [(vid, 'VOID VidReleaseFramebuffer(VOID)', '{ FrameBufferRetired = TRUE; }'), (inbv, 'VOID InbvRetireBootDriver(VOID)', '{ InbvBootDriverInstalled = FALSE; }'), (mm, 'VOID NxkMmReleaseBootFramebuffer(VOID)', '{}')]:
+    bodies += '\n' + sig + '\n' + (body(path, sig.split('(')[0].split()[-1]) or fallback)
+bodies += '\n' + extract(inbv, ['BOOLEAN InbvResetDisplay(VOID)', 'VOID InbvBitBlt(PUCHAR Buffer, ULONG X, ULONG Y)', 'VOID InbvBufferToScreenBlt(PUCHAR Buffer, ULONG X, ULONG Y, ULONG Width, ULONG Height, ULONG Stride)', 'VOID InbvAcquireDisplayOwnership(VOID)', 'VOID InbvEnableBootDriver(BOOLEAN Enable)', 'VOID InbvNotifyDisplayOwnershipLost(INBV_RESET_DISPLAY_PARAMETERS Callback)'])
+bodies += '\n' + extract('ntoskrnl/include/internal/mm.h', ['PMMPFN MiGetPfnEntry(PFN_NUMBER Pfn)'])
+bodies += '\n' + extract('ntoskrnl/xb/mm/pagesupply.c', ['PULONG NxpHeadFor(PFN_NUMBER Page)', 'VOID NxpPushHead(PFN_NUMBER Page)', 'VOID NxkPageSupplyInitialize(PFN_NUMBER HighestPfn, PVOID LinksArray)', 'VOID NxkPageSupplyReturn(PFN_NUMBER Page)'])
+bodies += '\n' + extract('ntoskrnl/xb/mm/contig.c', ['VOID NxkMmDonateHeapPages(ULONG_PTR Pa, ULONG Pages)'])
+bodies += '\n' + extract(mm, ['VOID NxpSplitNv2aReserve(VOID)'])
+fixture = pathlib.Path(__file__).with_name('fixture.c').read_text()
+macros = '\n'.join(line for line in (root / vid).read_text().splitlines() if line.startswith(('#define BB_OFFSET', '#define FB_OFFSET')))
+macros += '\n' + '\n'.join(line for line in (root / 'ntoskrnl/xb/mm/pagesupply.c').read_text().splitlines() if line.startswith(('#define NXP_FREE ', '#define NXP_PFN_MASK ', '#define NXP_PREV_SHIFT ', '#define NXP_NEXT(', '#define NXP_GENERIC_FLOOR_PFN ', '#define NXP_PIN_LIMIT ', '#define NXP_PIN_OVERFLOW ', '#define NXP_RETURN_PENDING ')))
+fixture = fixture.replace('/* PRODUCTION MACROS */', macros)
+source = out / 'check.c'; source.write_text(fixture.replace('/* PRODUCTION BODIES */', bodies))
+subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', str(source), '-o', str(out/'check')], check=True)
+raise SystemExit(subprocess.run([str(out/'check')]).returncode)
