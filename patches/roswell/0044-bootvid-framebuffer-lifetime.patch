@@ -277,6 +300,8 @@ PreserveRow(
     _In_ ULONG Height,
     _In_ BOOLEAN Restore)
 {
+    if (!FrameBufferStart) return;
+
     PUCHAR NewPosition, OldPosition;
 
     /* Calculate the position in memory for the row */
@@ -320,6 +345,8 @@ VOID
 DoScroll(
     _In_ ULONG Scroll)
 {
+    if (!FrameBufferStart) return;
+
     ULONG RowSize = VidpScrollRegion.Right - VidpScrollRegion.Left + 1;
 
     /* Calculate the position in memory for the row */
@@ -390,6 +417,8 @@ VidSolidColorFill(
     _In_ ULONG Bottom,
     _In_ UCHAR Color)
 {
+    if (!FrameBufferStart) return;
+
     while (Top <= Bottom)
     {
         PUCHAR Back = BackBuffer + BB_OFFSET(Left, Top);
@@ -415,6 +444,8 @@ VidScreenToBufferBlt(
     _In_ ULONG Height,
