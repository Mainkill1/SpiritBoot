diff --git a/ntoskrnl/inbv/inbv.c b/ntoskrnl/inbv/inbv.c
index 8fe76578..1b900f3e 100644
--- a/ntoskrnl/inbv/inbv.c
+++ b/ntoskrnl/inbv/inbv.c
@@ -37,6 +37,9 @@ static KSPIN_LOCK BootDriverLock;
 static KIRQL InbvOldIrql;
 static INBV_DISPLAY_STATE InbvDisplayState = INBV_DISPLAY_STATE_DISABLED;
 BOOLEAN InbvBootDriverInstalled = FALSE;
+#ifdef SARCH_XBOX
+static BOOLEAN InbvBootDriverRetired;
+#endif
 static INBV_RESET_DISPLAY_PARAMETERS InbvResetDisplayParameters = NULL;
 
 static BOOLEAN InbvDisplayDebugStrings = FALSE;
@@ -197,6 +200,10 @@ InbvDriverInitialize(
     BOOLEAN ResetMode = FALSE; // By default do not reset the video mode
     ULONG i;
 
+#ifdef SARCH_XBOX
+    if (InbvBootDriverRetired) return FALSE;
+#endif
+
     /* Quit if we're already installed */
     if (InbvBootDriverInstalled) return TRUE;
 
@@ -269,11 +276,38 @@ InbvReleaseLock(VOID)
     if (InbvOldIrql <= DISPATCH_LEVEL) KeLowerIrql(OldIrql);
 }
 
+#ifdef SARCH_XBOX
+/* Serialize with every framebuffer writer before the pages are donated. */
+VOID
+NTAPI
+InbvRetireBootDriver(VOID)
+{
+    InbvAcquireLock();
+    InbvBootDriverRetired = TRUE;
+    InbvBootDriverInstalled = FALSE;
+    InbvDisplayState = INBV_DISPLAY_STATE_LOST;
+    InbvResetDisplayParameters = NULL;
+    VidReleaseFramebuffer();
+    InbvReleaseLock();
+}
+#endif
+
 VOID
 NTAPI
 InbvEnableBootDriver(
     _In_ BOOLEAN Enable)
 {
+#ifdef SARCH_XBOX
+    InbvAcquireLock();
+    if (!InbvBootDriverRetired)
+    {
+        if (InbvBootDriverInstalled &&
+            InbvDisplayState == INBV_DISPLAY_STATE_OWNED) VidCleanUp();
+        InbvDisplayState = Enable ? INBV_DISPLAY_STATE_OWNED :
+                                   INBV_DISPLAY_STATE_DISABLED;
+    }
+    InbvReleaseLock();
+#else
     /* Check if we're installed */
     if (InbvBootDriverInstalled)
     {
@@ -299,12 +333,17 @@ InbvEnableBootDriver(
         InbvDisplayState = Enable ? INBV_DISPLAY_STATE_OWNED :
                                     INBV_DISPLAY_STATE_DISABLED;
     }
+#endif
 }
 
 VOID
 NTAPI
 InbvAcquireDisplayOwnership(VOID)
 {
+#ifdef SARCH_XBOX
+    if (InbvBootDriverRetired) return;
+#endif
+
     /* Check if we have a callback and we're just acquiring it now */
     if ((InbvResetDisplayParameters) &&
         (InbvDisplayState == INBV_DISPLAY_STATE_LOST))
@@ -314,7 +353,13 @@ InbvAcquireDisplayOwnership(VOID)
     }
 
     /* Acquire the display */
+#ifdef SARCH_XBOX
+    InbvAcquireLock();
+    if (!InbvBootDriverRetired) InbvDisplayState = INBV_DISPLAY_STATE_OWNED;
+    InbvReleaseLock();
+#else
     InbvDisplayState = INBV_DISPLAY_STATE_OWNED;
+#endif
 }
 
 VOID
@@ -322,9 +367,20 @@ NTAPI
 InbvSetDisplayOwnership(
     _In_ BOOLEAN DisplayOwned)
 {
+#ifdef SARCH_XBOX
+    if (InbvBootDriverRetired) return;
+#endif
+
     /* Set the new display state */
+#ifdef SARCH_XBOX
+    InbvAcquireLock();
+    if (!InbvBootDriverRetired)
+#endif
     InbvDisplayState = DisplayOwned ? INBV_DISPLAY_STATE_OWNED :
                                       INBV_DISPLAY_STATE_LOST;
+#ifdef SARCH_XBOX
+    InbvReleaseLock();
+#endif
 }
 
 BOOLEAN
@@ -423,6 +479,17 @@ NTAPI
 InbvNotifyDisplayOwnershipLost(
     _In_ INBV_RESET_DISPLAY_PARAMETERS Callback)
 {
+#ifdef SARCH_XBOX
+    InbvAcquireLock();
+    if (!InbvBootDriverRetired)
+    {
+        if (InbvBootDriverInstalled &&
+            InbvDisplayState != INBV_DISPLAY_STATE_LOST) VidCleanUp();
+        InbvResetDisplayParameters = Callback;
+        InbvDisplayState = INBV_DISPLAY_STATE_LOST;
+    }
+    InbvReleaseLock();
+#else
     /* Check if we're installed */
     if (InbvBootDriverInstalled)
     {
@@ -443,23 +510,27 @@ InbvNotifyDisplayOwnershipLost(
         InbvResetDisplayParameters = Callback;
         InbvDisplayState = INBV_DISPLAY_STATE_LOST;
     }
+#endif
 }
 
 BOOLEAN
 NTAPI
 InbvResetDisplay(VOID)
 {
-    /* Check if we're installed and we own it */
+    BOOLEAN Reset = FALSE;
+#ifdef SARCH_XBOX
+    InbvAcquireLock();
+#endif
     if (InbvBootDriverInstalled &&
         (InbvDisplayState == INBV_DISPLAY_STATE_OWNED))
     {
-        /* Do the reset */
         VidResetDisplay(TRUE);
-        return TRUE;
+        Reset = TRUE;
     }
-
-    /* Nothing to reset */
-    return FALSE;
+#ifdef SARCH_XBOX
+    InbvReleaseLock();
+#endif
+    return Reset;
 }
 
 VOID
@@ -560,7 +631,11 @@ InbvBitBlt(
         InbvAcquireLock();
 
         /* Do the blit */
-        VidBitBlt(Buffer, X, Y);
+#ifdef SARCH_XBOX
+        if (InbvBootDriverInstalled &&
+            (InbvDisplayState == INBV_DISPLAY_STATE_OWNED))
+#endif
+            VidBitBlt(Buffer, X, Y);
 
         /* Release the lock */
         InbvReleaseLock();
@@ -577,6 +652,9 @@ InbvBufferToScreenBlt(
     _In_ ULONG Height,
     _In_ ULONG Stride)
 {
+#ifdef SARCH_XBOX
+    InbvAcquireLock();
+#endif
     /* Check if we're installed and we own it */
     if (InbvBootDriverInstalled &&
         (InbvDisplayState == INBV_DISPLAY_STATE_OWNED))
@@ -584,6 +662,10 @@ InbvBufferToScreenBlt(
         /* Do the blit */
         VidBufferToScreenBlt(Buffer, X, Y, Width, Height, Stride);
     }
+#ifdef SARCH_XBOX
+    InbvReleaseLock();
+#endif
+
 }
 
 VOID
@@ -596,6 +678,9 @@ InbvScreenToBufferBlt(
     _In_ ULONG Height,
     _In_ ULONG Stride)
 {
+#ifdef SARCH_XBOX
+    InbvAcquireLock();
+#endif
     /* Check if we're installed and we own it */
     if (InbvBootDriverInstalled &&
         (InbvDisplayState == INBV_DISPLAY_STATE_OWNED))
@@ -603,6 +688,10 @@ InbvScreenToBufferBlt(
         /* Do the blit */
         VidScreenToBufferBlt(Buffer, X, Y, Width, Height, Stride);
     }
+#ifdef SARCH_XBOX
+    InbvReleaseLock();
+#endif
+
 }
 
