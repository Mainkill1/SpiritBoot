diff --git a/ntoskrnl/ex/init.c b/ntoskrnl/ex/init.c
index b8e2b90b..28f577a1 100644
--- a/ntoskrnl/ex/init.c
+++ b/ntoskrnl/ex/init.c
@@ -2093,6 +2093,14 @@ Phase1InitializationDiscard(IN PVOID Context)
 
     /* Clear the screen */
     if (InbvBootDriverInstalled) FinalizeBootLogo();
+#ifdef SARCH_XBOX
+    /* Retire the cached boot framebuffer before its reservation rejoins RAM. */
+    {
+        extern VOID NTAPI NxkMmReleaseBootFramebuffer(VOID);
