     ULONG x, y;
 
@@ -116,6 +119,8 @@ NTAPI
 VidInitialize(
     _In_ BOOLEAN SetMode)
 {
+    if (FrameBufferRetired) return FALSE;
+
     BOOLEAN Result = FALSE;
 
     /* FIXME: Add platform check */
@@ -222,6 +227,18 @@ cleanup:
     return Result;
 }
 
+/* The Inbv writer lock must be held. Retirement is terminal for this boot. */
+VOID
+NTAPI
+VidReleaseFramebuffer(VOID)
+{
+    FrameBufferRetired = TRUE;
+    if (FrameBufferStart)
+        MmUnmapIoSpace((PVOID)FrameBufferStart, NV2A_VIDEO_MEMORY_SIZE);
+    FrameBufferStart = 0;
+    BackBuffer = NULL;
+}
