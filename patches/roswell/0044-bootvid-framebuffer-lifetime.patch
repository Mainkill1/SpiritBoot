diff --git a/ntoskrnl/xb/mm/init.c b/ntoskrnl/xb/mm/init.c
index e5d08082..27b5898b 100644
--- a/ntoskrnl/xb/mm/init.c
+++ b/ntoskrnl/xb/mm/init.c
@@ -132,6 +132,8 @@ NxpIsLoaderTypeTransientReclaimable(TYPE_OF_MEMORY Type)
 #define NXK_MAX_EXTRA_DESCRIPTORS  2
 static MEMORY_ALLOCATION_DESCRIPTOR NxkExtraDescriptors[NXK_MAX_EXTRA_DESCRIPTORS];
 static ULONG                       NxkExtraDescriptorCount;
+static ULONG_PTR NxkBootFramebufferPa;
+static ULONG NxkBootFramebufferPages;
 
 /*
  * Split the LoaderFirmwarePermanent descriptor that freeldr leaves over the
@@ -140,8 +142,8 @@ static ULONG                       NxkExtraDescriptorCount;
  * (PA 0x03FE0000-0x04000000) actually needs to stay permanent -- the NV2A
  * places RAMHT/RAMFC/graphics-contexts there and the GPU MMU finds them at
  * a fixed PA, so NT must not hand those pages out.  The lower ~3.875 MB has
- * no consumer in our build; retype it to LoaderFirmwareTemporary so the
- * heap-claim loop below puts it back in the title's contig arena.
+ * a bootvid consumer until Phase 1 display retirement; retain the reservation
+ * until then and donate the lower range to the title page supply afterward.
  */
 static
 VOID
@@ -187,21 +189,13 @@ NxpSplitNv2aReserve(VOID)
         InsertHeadList(&Desc->ListEntry, &Tail->ListEntry);
 
         Desc->PageCount  = SplitPfn - Desc->BasePage;
-#ifdef NXK_MM_PHYS
-        /* One pool: retype the lower part so the PFN-database walk frees
-         * it straight into the page supply. */
-        Desc->MemoryType = LoaderFirmwareTemporary;
-#else
-        /* Retype the lower part to LoaderSpecialMemory.  NT's PFN init
-         * excludes that type just like LoaderFirmwarePermanent -- no PFN
-         * entries are created and the pages don't enter any free list --
-         * but it's distinguishable from the kept-reserved upper part,
-         * so NxpIsLoaderTypeTransientReclaimable can pick it up below
-         * and the heap-claim loop folds it into the title heap. */
-        Desc->MemoryType = LoaderSpecialMemory;
-#endif
+        /* Bootvid still draws through this reservation during Phase 1.
+         * Keep it permanent until the display writer barrier has retired
+         * the mapping; the loader descriptors themselves are freed earlier. */
+        NxkBootFramebufferPa = Desc->BasePage << PAGE_SHIFT;
+        NxkBootFramebufferPages = (ULONG)Desc->PageCount;
 
-        DPRINT1("nv2a split: reclaim PA %08lx-%08lx (%lu KB) for title heap; "
+        DPRINT1("nv2a split: defer PA %08lx-%08lx (%lu KB) for title heap; "
                 "keep PA %08lx-%08lx (%lu KB) reserved for GPU\n",
                 (ULONG)(Desc->BasePage << PAGE_SHIFT),
                 (ULONG)((Desc->BasePage + Desc->PageCount) << PAGE_SHIFT),
@@ -218,6 +212,34 @@ NxpSplitNv2aReserve(VOID)
             (ULONG)NXK_KSEG0_RAM_SIZE);
 }
 
+/* Called once after InbvRetireBootDriver has drained all framebuffer writers. */
+VOID
+NTAPI
+NxkMmReleaseBootFramebuffer(VOID)
+{
+    ULONG Pages = NxkBootFramebufferPages;
+
+    NxkBootFramebufferPages = 0;
+#ifdef NXK_MM_PHYS
+    if (Pages)
+    {
+        extern RTL_BITMAP MiPfnBitMap;
+        KIRQL OldIrql = MiAcquirePfnLock();
+
+        /* Phase 1 excluded the still-permanent reservation from the RAM
+         * bitmap. Publish it before the supply can hand a page to an MDL
+         * probe. PHYS already initialized links/pins for every PFN and
+         * maps all MMPFN slots to its shared zero frame; no per-page ARM3
+         * state is built or consumed on this path. */
+        ASSERT(MiPfnBitMap.Buffer != NULL);
+        RtlSetBits(&MiPfnBitMap,
+                   (ULONG)(NxkBootFramebufferPa >> PAGE_SHIFT), Pages);
+        MiReleasePfnLock(OldIrql);
+    }
+#endif
+    if (Pages) NxkMmDonateHeapPages(NxkBootFramebufferPa, Pages);
+}
+
 VOID
 NTAPI
 NxkMmReserveXboxWindows(VOID)
