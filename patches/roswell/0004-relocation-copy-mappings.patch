diff --git a/ntoskrnl/xb/mm/pagesupply.c b/ntoskrnl/xb/mm/pagesupply.c
index 6efa43927280dc16d4f8f78ccee17677c061b0f9..42cff1dd14ee87c4c60d3223c59cebe622ccb0b6 100644
--- a/ntoskrnl/xb/mm/pagesupply.c
+++ b/ntoskrnl/xb/mm/pagesupply.c
@@ -478,6 +478,51 @@ NxkPageSupplyTakeRun(
     return 0;
 }
 
+/* Two boot-reserved system PTEs provide copy aliases even when a frame has
+ * no KSEG0 identity mapping (system-PTE overlap or upper devkit RAM).
+ * The system-PTE backing tables are ARM3-owned, not relocatable supply
+ * pages. The PFN lock serializes use; mappings live only at HIGH_LEVEL. */
+static PMMPTE NxpRelocationPtes;
+static ULONG_PTR NxpRelocationSourceVa, NxpRelocationTargetVa;
+
+VOID
+NxkPageSupplyInitializeRelocation(VOID)
+{
+    ASSERT(NxpRelocationPtes == NULL);
+    NxpRelocationPtes = MiReserveSystemPtes(2, SystemPteSpace);
+    if (NxpRelocationPtes == NULL)
+    {
+        DPRINT1("Unable to reserve relocation copy mappings\n");
+        return;
+    }
+    NxpRelocationSourceVa = (ULONG_PTR)MiPteToAddress(NxpRelocationPtes);
+    NxpRelocationTargetVa = NxpRelocationSourceVa + PAGE_SIZE;
+    NxpRelocationPtes[0].u.Long = 0;
+    NxpRelocationPtes[1].u.Long = 0;
+}
+
+static VOID
+NxpMapRelocationPages(PFN_NUMBER Source, PFN_NUMBER Target)
+{
+    MI_ASSERT_PFN_LOCK_HELD();
+    ASSERT(KeGetCurrentIrql() == HIGH_LEVEL);
+    ASSERT(Source != 0 && Source <= NxpHighestPfn);
+    ASSERT(Target != 0 && Target <= NxpHighestPfn);
+    NxpRelocationPtes[0].u.Long = ((ULONG)Source << PAGE_SHIFT) | NXK_PTE_VALID;
+    NxpRelocationPtes[1].u.Long = ((ULONG)Target << PAGE_SHIFT) | NXK_PTE_VALID;
+    __invlpg((PVOID)NxpRelocationSourceVa);
+    __invlpg((PVOID)NxpRelocationTargetVa);
+}
+
+static VOID
+NxpUnmapRelocationPages(VOID)
+{
+    NxpRelocationPtes[0].u.Long = 0;
+    NxpRelocationPtes[1].u.Long = 0;
+    __invlpg((PVOID)NxpRelocationSourceVa);
+    __invlpg((PVOID)NxpRelocationTargetVa);
+}
+
 /*
  * Run-take with relocation, the retail-probed semantic: an exact-window
  * contiguous request succeeds even when live VM pages sit inside the
@@ -538,7 +583,8 @@ NxkPageSupplyTakeRunRelocate(
