diff --git a/tests/xbe/relocation-alias/main.c b/tests/xbe/relocation-alias/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..2fd2040d99c880a08e3923c07ecbf147a288d335
--- /dev/null
+++ b/tests/xbe/relocation-alias/main.c
@@ -0,0 +1,37 @@
+#include <stdio.h>
+#include <stdint.h>
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include <hal/video.h>
+#include <nxdk/mount.h>
+static PVOID regions[112];
+int main(void) {
+ XVideoSetMode(640,480,32,REFRESH_DEFAULT);
+ if(!nxIsDriveMounted('E'))nxMountDrive('E',"\\Device\\Harddisk0\\Partition1");
+ FILE *out=fopen("E:\\relocation-result.txt","wb");if(!out)for(;;)Sleep(1000);
+ PVOID victim=NULL, high=NULL;ULONG before=0;unsigned blocks=0;
+ for(;blocks<112&&!victim;blocks++){
+  SIZE_T n=1024*1024;NTSTATUS s=NtAllocateVirtualMemory(&regions[blocks],0,&n,MEM_RESERVE|MEM_COMMIT,PAGE_READWRITE);
+  if(!NT_SUCCESS(s)){fprintf(out,"FAIL allocation block=%u status=%08lx\n",blocks,s);break;}
+  for(unsigned off=0;off<n;off+=4096){
+   PVOID va=(char*)regions[blocks]+off;ULONG pa=MmGetPhysicalAddress(va);
+   if(pa>=0x04000000&&!high)high=va;
+   if(pa&&pa<0x04000000&&!victim){victim=va;before=pa;}
+  }
+ }
+ fprintf(out,"SETUP blocks=%u victim=%p physical=%08lx high=%p\n",blocks,victim,before,high);fflush(out);
+ if(!victim||!high){fprintf(out,"FAIL required memory domains unavailable\n");goto done;}
+ for(unsigned i=0;i<1024;i++)((volatile uint32_t*)victim)[i]=0x13570000u+i;
+ ULONG freed=MmGetPhysicalAddress(high);SIZE_T n=4096;PVOID release=high;
+ NTSTATUS s=NtFreeVirtualMemory(&release,&n,MEM_DECOMMIT);
+ fprintf(out,"DEST freed=%08lx status=%08lx\n",freed,s);fflush(out);
+ if(!NT_SUCCESS(s))goto done;
+ PVOID pin=MmAllocateContiguousMemoryEx(4096,before,before+4095,4096,PAGE_READWRITE);
+ ULONG after=MmGetPhysicalAddress(victim);unsigned bad=0;
+ for(unsigned i=0;i<1024;i++)if(((volatile uint32_t*)victim)[i]!=0x13570000u+i)bad++;
+ fprintf(out,"RESULT pin=%p before=%08lx after=%08lx mismatch=%u\n",pin,before,after,bad);
+ fprintf(out,"%s relocation to upper RAM\n",pin&&after>=0x04000000&&after!=before&&!bad?"PASS":"FAIL");
+ if(pin)MmFreeContiguousMemory(pin);
+done:
+ fclose(out);for(;;)Sleep(1000);
+}
