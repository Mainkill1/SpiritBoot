diff --git a/tests/host/critical-section/check.py b/tests/host/critical-section/check.py
new file mode 100644
index 0000000000000000000000000000000000000000..067216d3c5c1349248d1b8fc9fab981c8689d784
--- /dev/null
+++ b/tests/host/critical-section/check.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production critical-section adapter and wake handoff."""
+from pathlib import Path
+import importlib.util,subprocess,sys
+sys.dont_write_bytecode=True
+root=Path(__file__).resolve().parents[3];out=Path(sys.argv[1]).resolve();out.mkdir(parents=True,exist_ok=True)
+s=(root/'ntoskrnl/xb/xbe.c').read_text();a=s.index('typedef struct _XBE_CS');b=s.index('/* The AndRegion variants',a);body=s[a:b]
+shim=r'''
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <assert.h>
+#include <stdio.h>
+typedef uint8_t UCHAR;typedef int32_t LONG;typedef uint32_t ULONG;typedef void *PVOID;typedef void VOID;
+typedef struct _LIST_ENTRY {struct _LIST_ENTRY *Flink,*Blink;} LIST_ENTRY;
+typedef struct {UCHAR Type,Absolute,Size,Inserted;LONG SignalState;LIST_ENTRY WaitListHead;} KEVENT,*PKEVENT;
+#define _Inout_
+#define _Out_
+#define NTAPI
+#define TRUE 1
+#define FALSE 0
+#define SynchronizationEvent 1
+#define Executive 0
+#define KernelMode 0
+static PVOID me=(void*)1;static unsigned waits,signals;static void *current_cs;
+static int release_on_increment;static void XeRtlLeaveCriticalSection(void*);
+static PVOID KeGetCurrentThread(void){return me;}
+static LONG InterlockedIncrement(LONG*p){
+ LONG result=++*p;
+ if(release_on_increment){release_on_increment=0;PVOID saved=me;me=(void*)1;XeRtlLeaveCriticalSection(current_cs);me=saved;}
+ return result;
+}
+static LONG InterlockedDecrement(LONG*p){return --*p;}
+static LONG InterlockedCompareExchange(LONG*p,LONG n,LONG old){LONG v=*p;if(v==old)*p=n;return v;}
+static PVOID InterlockedCompareExchangePointer(PVOID*p,PVOID n,PVOID old){PVOID v=*p;if(v==old)*p=n;return v;}
+static PVOID InterlockedExchangePointer(PVOID*p,PVOID n){PVOID v=*p;*p=n;return v;}
+#define RtlZeroMemory(p,n) memset(p,0,n)
+static void KeInitializeEvent(PKEVENT e,int type,int signal){memset(e,0,sizeof(*e));e->Type=type;e->SignalState=signal;e->WaitListHead.Flink=e->WaitListHead.Blink=&e->WaitListHead;}
+static void KeSetEvent(PKEVENT e,int boost,int wait){(void)boost;(void)wait;e->SignalState=1;signals++;}
+static void XeRtlLeaveCriticalSection(void*);
+static void KeWaitForSingleObject(PKEVENT e,int reason,int mode,int alert,void*timeout){
+ (void)reason;(void)mode;(void)alert;(void)timeout;waits++;assert(e->Type==1);
+ if(!e->SignalState){PVOID saved=me;me=(void*)1;XeRtlLeaveCriticalSection(current_cs);me=saved;}
+ assert(e->SignalState==1);e->SignalState=0;
+}
+'''
+main=r'''
+int main(void){
+ XBE_CS cs;current_cs=&cs;XeRtlInitializeCriticalSection(&cs);assert(cs.LockCount==-1&&!cs.RecursionCount&&!cs.OwningThread&&cs.Type==1);
+ XeRtlEnterCriticalSection(&cs);XeRtlEnterCriticalSection(&cs);assert(cs.LockCount==1&&cs.RecursionCount==2);
+ assert(XeRtlTryEnterCriticalSection(&cs));assert(cs.LockCount==2&&cs.RecursionCount==3);
+ XeRtlLeaveCriticalSection(&cs);XeRtlLeaveCriticalSection(&cs);assert(cs.LockCount==0&&cs.RecursionCount==1);
+ me=(void*)2;assert(!XeRtlTryEnterCriticalSection(&cs));assert(cs.LockCount==0&&!waits);
+ XeRtlEnterCriticalSection(&cs);assert(waits==1&&signals==1&&cs.OwningThread==me&&cs.LockCount==0&&cs.RecursionCount==1);
+ XeRtlLeaveCriticalSection(&cs);assert(cs.LockCount==-1&&!cs.OwningThread&&!cs.RecursionCount);
+ assert(XeRtlTryEnterCriticalSection(&cs));XeRtlLeaveCriticalSection(&cs);
+ me=(void*)1;XeRtlInitializeCriticalSection(&cs);cs.Type=0;XeRtlEnterCriticalSection(&cs);
+ me=(void*)2;XeRtlEnterCriticalSection(&cs);assert(cs.Type==1&&waits==2);XeRtlLeaveCriticalSection(&cs);
+ me=(void*)1;XeRtlInitializeCriticalSection(&cs);cs.Type=0;XeRtlEnterCriticalSection(&cs);
+ me=(void*)2;release_on_increment=1;XeRtlEnterCriticalSection(&cs);
+ assert(waits==3&&cs.OwningThread==me&&cs.LockCount==0&&cs.Type==1);XeRtlLeaveCriticalSection(&cs);
+ /* Two already-queued contenders: each release hands off one count. */
+ me=(void*)1;XeRtlInitializeCriticalSection(&cs);XeRtlEnterCriticalSection(&cs);
+ InterlockedIncrement(&cs.LockCount);InterlockedIncrement(&cs.LockCount);
+ XeRtlLeaveCriticalSection(&cs);assert(cs.SignalState==1&&cs.LockCount==1);
+ KeWaitForSingleObject((PKEVENT)&cs,0,0,0,NULL);me=(void*)2;cs.OwningThread=me;cs.RecursionCount=1;
+ XeRtlLeaveCriticalSection(&cs);assert(cs.SignalState==1&&cs.LockCount==0);
+ KeWaitForSingleObject((PKEVENT)&cs,0,0,0,NULL);me=(void*)3;cs.OwningThread=me;cs.RecursionCount=1;
+ XeRtlLeaveCriticalSection(&cs);assert(!cs.SignalState&&cs.LockCount==-1&&!cs.OwningThread);
+ puts("critical section: recursive counts, try-enter, blocking handoff, static header and final release PASS");
+}
+'''
+(out/'critical.c').write_text(shim+body+main)
+subprocess.run(['cc','-std=c11','-O2','-fno-strict-aliasing','-Wall','-Wextra','-Werror','-Wno-unused-function',str(out/'critical.c'),'-o',str(out/'critical')],check=True)
+subprocess.run([str(out/'critical')],check=True)
