diff --git a/tests/xbe/critical-section-contention/main.c b/tests/xbe/critical-section-contention/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..fbd0dae53b5262dcac93e6123f66a83e85fddc6c
--- /dev/null
+++ b/tests/xbe/critical-section-contention/main.c
@@ -0,0 +1,43 @@
+#include <stdio.h>
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include <hal/debug.h>
+#include <hal/video.h>
+#include <nxdk/mount.h>
+static RTL_CRITICAL_SECTION cs;
+static HANDLE ready, done;
+static volatile LONG entries;
+static DWORD WINAPI contender(void *unused) {
+ (void)unused;
+ SetEvent(ready);
+ RtlEnterCriticalSection(&cs);
+ InterlockedIncrement(&entries);
+ RtlLeaveCriticalSection(&cs);
+ SetEvent(done);
+ return 0;
+}
+int main(void) {
+ XVideoSetMode(640,480,32,REFRESH_DEFAULT);
+ if(!nxIsDriveMounted('E'))nxMountDrive('E',"\\Device\\Harddisk0\\Partition1");
+ FILE *out=fopen("E:\\critical-result.txt","wb");
+ if(!out){debugPrint("FAIL output\n");for(;;)Sleep(1000);}
+ ready=CreateEvent(NULL,FALSE,FALSE,NULL);done=CreateEvent(NULL,FALSE,FALSE,NULL);
+ fprintf(out,"BEGIN higher-priority contention\n");fflush(out);
+ RtlInitializeCriticalSection(&cs);
+ RtlEnterCriticalSection(&cs);RtlEnterCriticalSection(&cs);
+ HANDLE thread=CreateThread(NULL,0,contender,NULL,CREATE_SUSPENDED,NULL);
+ SetThreadPriority(thread,THREAD_PRIORITY_ABOVE_NORMAL);
+ ResumeThread(thread);
+ /* Worker announces entry, then must block so the owner can resume. */
+ WaitForSingleObject(ready,INFINITE);
+ RtlLeaveCriticalSection(&cs);
+ unsigned failures=cs.RecursionCount!=1||entries!=0;
+ RtlLeaveCriticalSection(&cs);
+ failures+=WaitForSingleObject(done,2000)!=WAIT_OBJECT_0;
+ failures+=WaitForSingleObject(thread,2000)!=WAIT_OBJECT_0;
+ failures+=entries!=1||cs.RecursionCount!=0||cs.OwningThread!=NULL||cs.LockCount!=-1;
+ CloseHandle(thread);
+ fprintf(out,"COMPLETE entries=%ld failures=%u\n",entries,failures);fclose(out);
+ debugPrint("CRITICAL COMPLETE entries=%ld failures=%u\n",entries,failures);
+ for(;;)Sleep(1000);
+}
