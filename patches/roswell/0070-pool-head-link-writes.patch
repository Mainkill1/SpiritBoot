diff --git a/ntoskrnl/xb/mm/pool.c b/ntoskrnl/xb/mm/pool.c
--- a/ntoskrnl/xb/mm/pool.c
+++ b/ntoskrnl/xb/mm/pool.c
@@ -264,9 +264,16 @@
         NXP_FREE *Block = (NXP_FREE *)(Header + 1);
         ASSERT(Header->Magic == NXP_MAGIC_FREE &&
                Header->ClassIndex == Class);
-        if (Block->Prev) Block->Prev->Next = Block->Next;
-        else NxpFreeLists[Class] = Block->Next;
-        if (Block->Next) Block->Next->Prev = Block->Prev;
+        if (Block == NxpFreeLists[Class])
+        {
+            NxpFreeLists[Class] = Block->Next;
+            if (Block->Next) Block->Next->Prev = NULL;
+        }
+        else
+        {
+            Block->Prev->Next = Block->Next;
+            if (Block->Next) Block->Next->Prev = Block->Prev;
+        }
     }
     NxpPageState[Index] = NXP_NOT_BUCKET;
     return Page;
@@ -385,7 +392,8 @@
     if (Blk != NULL)
     {
         NxpFreeLists[Class] = Blk->Next;
-        if (Blk->Next) Blk->Next->Prev = NULL;
+        /* The head has no predecessor; its Prev is never consulted.
+         * Leave it untouched here and use head identity when detaching. */
         NxpPageState[NXP_PAGE_INDEX(Blk)]++;
         KeReleaseSpinLock(&NxpLock, OldIrql);
         ASSERT((((NXP_HEADER *)Blk) - 1)->Magic == NXP_MAGIC_FREE);
