+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Production bodies with 32-bit layouts. OS scheduling/APC/pool/deletion
+ * boundaries are fixtures; native table selection, walk, entry locking,
+ * type/access checks, reference acquisition and shim ownership are real.
+ */
+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+typedef void VOID, *PVOID, *HANDLE;
+typedef uint32_t ULONG, ULONG_PTR, ACCESS_MASK;
+typedef int32_t LONG, LONG_PTR, NTSTATUS, *PLONG;
+typedef size_t SIZE_T;
+typedef uint8_t UCHAR, BOOLEAN, KIRQL;
+typedef int KPROCESSOR_MODE;
+typedef pthread_mutex_t KSPIN_LOCK;
+#define NTAPI
+#define FASTCALL
+#define IN
+#define OUT
+#define OPTIONAL
+#define TRUE 1
+#define FALSE 0
+#define KernelMode 0
+#define UserMode 1
+#define APC_LEVEL 1
+#define NonPagedPool 0
+#define NT_SUCCESS(s) ((s) >= 0)
+#define STATUS_SUCCESS ((NTSTATUS)0)
+#define STATUS_INVALID_HANDLE ((NTSTATUS)0xc0000008)
+#define STATUS_OBJECT_TYPE_MISMATCH ((NTSTATUS)0xc0000024)
+#define STATUS_ACCESS_DENIED ((NTSTATUS)0xc0000022)
+#define ASSERT assert
+#define PAGED_CODE() ((void)0)
+#define DPRINT(...) ((void)0)
+#define DPRINT1(...) ((void)0)
+#define UNREFERENCED_PARAMETER(x) (void)(x)
+#define HandleToLong(h) ((LONG)(uintptr_t)(h))
+#define NtCurrentProcess() ((HANDLE)(uintptr_t)0xffffffff)
+#define NtCurrentThread() ((HANDLE)(uintptr_t)0xfffffffe)
+#define KERNEL_HANDLE_FLAG 0x80000000u
+#define ObKernelHandleToHandle(h) ((HANDLE)((ULONG_PTR)(h) & ~KERNEL_HANDLE_FLAG))
+#define OBJ_HANDLE_ATTRIBUTES 7u
+#define ObpGetHandleObject(e) ((POBJECT_HEADER)((ULONG_PTR)(e)->Object & ~OBJ_HANDLE_ATTRIBUTES))
+#define CONTAINING_RECORD(p,t,f) ((t *)((char *)(p) - offsetof(t,f)))
+typedef struct _LIST_ENTRY { struct _LIST_ENTRY *Flink, *Blink; } LIST_ENTRY, *PLIST_ENTRY;
+typedef struct { uint16_t Length, MaximumLength; char *Buffer; } ANSI_STRING;
+typedef struct _OBJECT_TYPE { ULONG Id; } OBJECT_TYPE, *POBJECT_TYPE;
+typedef struct _OBJECT_HEADER {
+    LONG_PTR PointerCount;
+    union { LONG_PTR HandleCount; volatile PVOID NextToFree; };
+    POBJECT_TYPE Type;
+    UCHAR NameInfoOffset, HandleInfoOffset, QuotaInfoOffset, Flags;
+    union { PVOID ObjectCreateInfo, QuotaBlockCharged; };
+    PVOID SecurityDescriptor;
+    uint64_t Body;
+} OBJECT_HEADER, *POBJECT_HEADER;
+#define OBJECT_TO_OBJECT_HEADER(o) CONTAINING_RECORD(o, OBJECT_HEADER, Body)
+typedef struct _HANDLE_TABLE_ENTRY {
+    union { PVOID Object; ULONG_PTR ObAttributes, Value; };
+    union { ULONG GrantedAccess; LONG NextFreeTableEntry; };
+} HANDLE_TABLE_ENTRY, *PHANDLE_TABLE_ENTRY;
+typedef struct _HANDLE_TABLE {
+    ULONG_PTR TableCode, NextHandleNeedingPool;
+    ULONG HandleContentionEvent;
+} HANDLE_TABLE, *PHANDLE_TABLE;
+typedef union _EXHANDLE {
+    struct { ULONG_PTR TagBits:2, Index:29, KernelFlag:1; };
+    struct { ULONG_PTR TagBits2:2, LowIndex:9, MidIndex:10, HighIndex:10, KernelFlag2:1; };
+    HANDLE GenericHandleOverlay;
+    ULONG_PTR Value;
+} EXHANDLE;
+#define LOW_LEVEL_ENTRIES 512
+#define EXHANDLE_TABLE_ENTRY_LOCK_BIT 1
+typedef struct { ULONG HandleAttributes, GrantedAccess; } OBJECT_HANDLE_INFORMATION, *POBJECT_HANDLE_INFORMATION;
+typedef struct _PAYLOAD { PVOID Object; PHANDLE_TABLE ObjectTable; ULONG GrantedAccess; LONG CombinedApcDisable; ULONG Cookie; } PAYLOAD, *PEPROCESS, *PETHREAD;
+_Static_assert(sizeof(void *) == 4, "exercise native i386 pointer/tag layouts");
+_Static_assert(sizeof(HANDLE_TABLE_ENTRY) == 8, "native low-level entry layout");
+_Static_assert(offsetof(OBJECT_HEADER, Body) == 24, "native header body offset");
+#include "object-types.inc"
+XBOX_OBJECT_TYPE XePsThreadObjectType, XeExEventObjectType, XeExSemaphoreObjectType,
+    XeExMutantObjectType, XeExTimerObjectType, XeIoFileObjectType, XeIoDeviceObjectType,
+    XeIoCompletionObjectType, XeObDirectoryObjectType, XeObSymbolicLinkObjectType;
+static OBJECT_TYPE types[12];
+static POBJECT_TYPE PsThreadType=&types[0], ExEventObjectType=&types[1],
+    ExSemaphoreObjectType=&types[2], ExMutantObjectType=&types[3], ExTimerType=&types[4],
+    IoFileObjectType=&types[5], IoDeviceObjectType=&types[6], IoCompletionType=&types[7],
+    ObpDirectoryObjectType=&types[8], ObpSymbolicLinkObjectType=&types[9],
+    PsProcessType=&types[10];
+static PHANDLE_TABLE ObpKernelHandleTable;
+static PEPROCESS current_process;
+static PETHREAD current_thread;
+static _Thread_local LONG apc_disable;
+static _Thread_local struct { unsigned native_calls, table_maps, table_walks, native_references, native_dereferences; } counters;
+#ifdef COUNTERS
+#define COUNT(n) (++counters.n)
+#else
+#define COUNT(n) ((void)0)
+#endif
+static void KeEnterCriticalRegion(void) { --apc_disable; }
+static void KeLeaveCriticalRegion(void) { ++apc_disable; }
+static PEPROCESS PsGetCurrentProcess(void) { return current_process; }
+static PETHREAD PsGetCurrentThread(void) { return current_thread; }
+static PETHREAD KeGetCurrentThread(void) { static _Thread_local PAYLOAD t; t.CombinedApcDisable=apc_disable; return &t; }
+static KIRQL KeGetCurrentIrql(void) { return 0; }
+static BOOLEAN KeAreAllApcsDisabled(void) { return FALSE; }
+static LONG InterlockedIncrement(PLONG p) { return __atomic_add_fetch(p,1,__ATOMIC_SEQ_CST); }
+static LONG InterlockedDecrement(PLONG p) { return __atomic_sub_fetch(p,1,__ATOMIC_SEQ_CST); }
+static LONG_PTR InterlockedIncrementSizeT(LONG_PTR *p) { COUNT(native_references); return InterlockedIncrement(p); }
+static LONG_PTR InterlockedDecrementSizeT(LONG_PTR *p) { return InterlockedDecrement(p); }
+static LONG_PTR InterlockedExchangeAddSizeT(LONG_PTR *p, LONG n) { COUNT(native_references); return __atomic_fetch_add(p,n,__ATOMIC_SEQ_CST); }
+static PVOID InterlockedCompareExchangePointer(PVOID *p, PVOID n, PVOID old) { __atomic_compare_exchange_n(p,&old,n,0,__ATOMIC_SEQ_CST,__ATOMIC_SEQ_CST); return old; }
+static LONG InterlockedOr(PLONG p, LONG n) { return __atomic_fetch_or(p,n,__ATOMIC_SEQ_CST); }
+static void ExfUnblockPushLock(ULONG *p, void *w) { (void)p;(void)w; }
+static void ExpBlockOnLockedHandleEntry(PHANDLE_TABLE t, PHANDLE_TABLE_ENTRY e) { (void)t;(void)e; sched_yield(); }
+static void KeAcquireSpinLock(KSPIN_LOCK *l, KIRQL *i) { *i=0; assert(pthread_mutex_lock(l)==0); }
+static void KeReleaseSpinLock(KSPIN_LOCK *l, KIRQL i) { (void)i; assert(pthread_mutex_unlock(l)==0); }
+static void InitializeListHead(PLIST_ENTRY h) { h->Flink=h->Blink=h; }
+static void InsertTailList(PLIST_ENTRY h, PLIST_ENTRY e) { e->Flink=h;e->Blink=h->Blink;h->Blink->Flink=e;h->Blink=e; }
+static PVOID ExAllocatePoolWithTag(ULONG pool, SIZE_T size, ULONG tag) { (void)pool;(void)tag; return calloc(1,size); }
+static void ExFreePool(PVOID p) { free(p); }
+static LONG native_deletes, shim_deletes, title_deletes, title_frees;
+static void ObpDeleteObject(PVOID Object, BOOLEAN b);
+static void ObpDeferObjectDeletion(POBJECT_HEADER h) { (void)h; abort(); }
+static LONG_PTR ObfDereferenceObject(PVOID Object);
+#include "production.inc"
+
+static void ObpDeleteObject(PVOID Object, BOOLEAN b) {
+    (void)b;
+    if (OBJECT_TO_OBJECT_HEADER(Object)->Type == XobShimType) {
+        InterlockedIncrement(&shim_deletes);
+        XobShimDelete(Object);
+    } else InterlockedIncrement(&native_deletes);
+    free(OBJECT_TO_OBJECT_HEADER(Object));
+}
+static void title_delete(PVOID p) { (void)p; InterlockedIncrement(&title_deletes); }
+static void title_free(PVOID p) { InterlockedIncrement(&title_frees); free(p); }
+static XBOX_OBJECT_TYPE title_types[2];
+static HANDLE_TABLE normal_table, kernel_table;
+static HANDLE_TABLE_ENTRY normal_entries[512], kernel_entries[512];
+static PAYLOAD *new_native(POBJECT_TYPE type, LONG refs, LONG handles, ULONG cookie) {
+    OBJECT_HEADER *h=calloc(1,offsetof(OBJECT_HEADER,Body)+sizeof(PAYLOAD)); assert(h);
+    h->PointerCount=refs;h->HandleCount=handles;h->Type=type;
+    PAYLOAD *p=(PAYLOAD *)&h->Body; p->GrantedAccess=0xffffffff;p->Cookie=cookie;return p;
+}
+static PVOID new_title(unsigned index, LONG refs, LONG handles) {
+    PXB_OBJECT_HEADER h=calloc(1,sizeof(*h)+sizeof(ULONG));assert(h);
+    h->PointerCount=refs;h->HandleCount=handles;h->Type=&title_types[index];
+    *(ULONG *)(h+1)=0xabc000u+index;return h+1;
+}
+static void put_entry(HANDLE_TABLE_ENTRY *entry, PVOID p) {
+    entry->GrantedAccess=0xffffffff;
+    __atomic_store_n(&entry->Value,(ULONG_PTR)OBJECT_TO_OBJECT_HEADER(p)|1,__ATOMIC_SEQ_CST);
+}
+static void setup(BOOLEAN titles, BOOLEAN ready) {
+    memset(normal_entries,0,sizeof(normal_entries));memset(kernel_entries,0,sizeof(kernel_entries));
+    normal_table.TableCode=(ULONG_PTR)normal_entries;normal_table.NextHandleNeedingPool=512*4;
+    kernel_table.TableCode=(ULONG_PTR)kernel_entries;kernel_table.NextHandleNeedingPool=512*4;
+    ObpKernelHandleTable=&kernel_table;
+    current_process=new_native(PsProcessType,1,0,90);current_process->ObjectTable=&normal_table;
+    current_thread=new_native(PsThreadType,1,0,91);
+    for(unsigned i=0;i<10;i++) put_entry(&normal_entries[i+1],new_native(&types[i],1,1,i+1));
+    put_entry(&kernel_entries[1],new_native(IoFileObjectType,1,1,80));
+    for(unsigned i=0;i<2;i++) { title_types[i].DeleteProcedure=title_delete;title_types[i].FreeProcedure=title_free; }
+    if(titles) {
+        XobRememberType(&title_types[0]);XobRememberType(&title_types[1]);
+        if(ready) {
+            XobShimType=&types[11];XobShimTypeState=2;
+            PAYLOAD *shim=new_native(XobShimType,1,1,70);shim->Object=new_title(0,1,1);
+            put_entry(&normal_entries[20],shim);
+        }
+    }
+}
+static void release_result(PVOID p, BOOLEAN title) { if(title)XobDereferenceObject(p);else ObfDereferenceObject(p); }
+static int expect_case(const char *label, HANDLE handle, PVOID requested,
+                       NTSTATUS want, PVOID body, BOOLEAN title, unsigned calls, unsigned maps) {
+    PVOID out=(PVOID)0xfeedfaceu;
+    LONG native_before=body && !title?OBJECT_TO_OBJECT_HEADER(body)->PointerCount:0;
+    LONG title_before=body && title?XbHeader(body)->PointerCount:0;
+    memset(&counters,0,sizeof(counters));
+    NTSTATUS s=XeObReferenceObjectByHandle(handle,requested,&out);
+    if(s!=want||out!=(want==STATUS_SUCCESS?body:NULL)) {
+        fprintf(stderr,"FAIL %s status=%08x expected=%08x output=%p expected=%p\n",label,(unsigned)s,(unsigned)want,out,want==STATUS_SUCCESS?body:NULL);return 1;
+    }
+    if(want==STATUS_SUCCESS) {
+        assert((title?XbHeader(out)->PointerCount:OBJECT_TO_OBJECT_HEADER(out)->PointerCount)==(title?title_before:native_before)+1);
+        release_result(out,title);
+        assert((title?XbHeader(body)->PointerCount:OBJECT_TO_OBJECT_HEADER(body)->PointerCount)==(title?title_before:native_before));
+    } else if(body) assert((title?XbHeader(body)->PointerCount:OBJECT_TO_OBJECT_HEADER(body)->PointerCount)==(title?title_before:native_before));
+    assert(apc_disable==0);
+    printf("{\"case\":\"%s\",\"status\":%u,\"output\":%u,\"ownership\":\"balanced\",\"calls\":%u,\"maps\":%u,\"walks\":%u,\"references\":%u,\"dereferences\":%u}\n",label,(unsigned)s,s==STATUS_SUCCESS?(title?70:((PAYLOAD *)out)->Cookie):0,counters.native_calls,counters.table_maps,counters.table_walks,counters.native_references,counters.native_dereferences);
+#ifdef COUNTERS
+    if(counters.native_calls!=calls||counters.table_maps!=maps) {
+        fprintf(stderr,"FAIL %s calls/maps=%u/%u expected=%u/%u\n",label,counters.native_calls,counters.table_maps,calls,maps);return 1;
+    }
+#else
+    (void)calls;(void)maps;
+#endif
+    return 0;
+}
+static void close_entry(HANDLE_TABLE *t, HANDLE handle) {
+    KeEnterCriticalRegion();
+    HANDLE_TABLE_ENTRY *entry=ExMapHandleToPointer(t,handle);assert(entry);
+    OBJECT_HEADER *h=ObpGetHandleObject(entry);
+    __atomic_store_n(&entry->Value,0,__ATOMIC_SEQ_CST);
+    InterlockedDecrement(&h->HandleCount);
+    if(h->Type==XobShimType) XobShimClose(current_process,&h->Body,0,1,1);
+    KeLeaveCriticalRegion();ObfDereferenceObject(&h->Body);
+}
+static int table_levels(BOOLEAN optimized);
+static int matrix(BOOLEAN optimized) {
+    PVOID decoys[]={&XePsThreadObjectType,&XeExEventObjectType,&XeExSemaphoreObjectType,&XeExMutantObjectType,&XeExTimerObjectType,&XeIoFileObjectType,&XeIoDeviceObjectType,&XeIoCompletionObjectType,&XeObDirectoryObjectType,&XeObSymbolicLinkObjectType};
+    for(unsigned titles=0;titles<2;titles++) {
+        setup(titles,TRUE);
+        unsigned calls=titles&&!optimized?2:1;
+        for(unsigned i=0;i<10;i++) {
+            HANDLE h=(HANDLE)(uintptr_t)((i+1)*4); PVOID body=&ObpGetHandleObject(&normal_entries[i+1])->Body;
+            PVOID requests[]={NULL,&types[i],decoys[i],&types[(i+1)%10],&title_types[0],&title_types[1]};
+            NTSTATUS wants[]={STATUS_SUCCESS,STATUS_SUCCESS,STATUS_SUCCESS,STATUS_OBJECT_TYPE_MISMATCH,STATUS_OBJECT_TYPE_MISMATCH,STATUS_OBJECT_TYPE_MISMATCH};
+            for(unsigned tag=0;tag<4;tag++)for(unsigned r=0;r<6;r++) {
+                char label[80];snprintf(label,sizeof(label),"titles%u-native%u-tag%u-request%u",titles,i,tag,r);
+                if(expect_case(label,(HANDLE)((ULONG_PTR)h+tag),requests[r],wants[r],body,FALSE,titles&&r>=4?1:calls,titles&&r>=4?1:calls))return 1;
+            }
+        }
+        for(unsigned which=0;which<2;which++) {
+            HANDLE h=which?NtCurrentThread():NtCurrentProcess();PVOID body=which?(PVOID)current_thread:(PVOID)current_process;
+            PVOID requests[]={NULL,which?PsThreadType:PsProcessType,&XePsThreadObjectType,ExEventObjectType,&title_types[0]};
+            for(unsigned r=0;r<5;r++) {
+                NTSTATUS want=r<2||(which&&r==2)?STATUS_SUCCESS:STATUS_OBJECT_TYPE_MISMATCH;
+                char label[80];snprintf(label,sizeof(label),"titles%u-pseudo%u-request%u",titles,which,r);
+                if(expect_case(label,h,requests[r],want,body,FALSE,titles&&r==4?1:calls,0))return 1;
+            }
+        }
+        for(unsigned r=0;r<4;r++) {
+            PVOID requests[]={NULL,&XeIoFileObjectType,ExEventObjectType,&title_types[0]};
+            PVOID body=&ObpGetHandleObject(&kernel_entries[1])->Body;
+            char label[80];snprintf(label,sizeof(label),"titles%u-kernel-request%u",titles,r);
+            if(expect_case(label,(HANDLE)0x80000004u,requests[r],r<2?STATUS_SUCCESS:STATUS_OBJECT_TYPE_MISMATCH,body,FALSE,titles&&r==3?1:calls,titles&&r==3?1:calls))return 1;
+        }
+        HANDLE invalid[]={NULL,(HANDLE)2,(HANDLE)0x7ffffffcu,(HANDLE)0x80000000u,(HANDLE)0xfffffffcu,(HANDLE)2048,(HANDLE)200};
+        for(unsigned i=0;i<sizeof(invalid)/sizeof(*invalid);i++)for(unsigned r=0;r<3;r++) {
+            PVOID requests[]={NULL,&XeExEventObjectType,&title_types[0]};
+            char label[80];snprintf(label,sizeof(label),"titles%u-invalid%u-request%u",titles,i,r);
+            if(expect_case(label,invalid[i],requests[r],titles&&r==2?STATUS_OBJECT_TYPE_MISMATCH:STATUS_INVALID_HANDLE,NULL,FALSE,titles&&r==2?1:calls,titles&&r==2?1:calls))return 1;
+        }
+        if(titles) {
+            PAYLOAD *shim=(PAYLOAD *)&ObpGetHandleObject(&normal_entries[20])->Body;
+            PVOID requests[]={NULL,&title_types[0],&title_types[1],&XeExEventObjectType,ExEventObjectType};
+            for(unsigned r=0;r<5;r++) {
+                char label[80];snprintf(label,sizeof(label),"shim-request%u",r);
+                if(expect_case(label,(HANDLE)80,requests[r],r<2?STATUS_SUCCESS:STATUS_OBJECT_TYPE_MISMATCH,shim->Object,TRUE,1,1))return 1;
+                assert(OBJECT_TO_OBJECT_HEADER(shim)->PointerCount==1);
+            }
+            PVOID held=NULL;assert(XeObReferenceObjectByHandle((HANDLE)80,(POBJECT_TYPE)&title_types[0],&held)==0);
+            close_entry(&normal_table,(HANDLE)80);
+            assert(shim_deletes==1&&title_deletes==0&&title_frees==0&&XbHeader(held)->HandleCount==0&&XbHeader(held)->PointerCount==1);
+            XobDereferenceObject(held);assert(title_deletes==1&&title_frees==1);
+            puts("{\"case\":\"shim-close-while-referenced\",\"delete\":1,\"free\":1}");
+        }
+        PVOID held=NULL;assert(XeObReferenceObjectByHandle((HANDLE)8,(POBJECT_TYPE)&XeExEventObjectType,&held)==0);
+        LONG deleted=native_deletes;close_entry(&normal_table,(HANDLE)8);
+        assert(native_deletes==deleted&&OBJECT_TO_OBJECT_HEADER(held)->PointerCount==1);
+        ObfDereferenceObject(held);assert(native_deletes==deleted+1);
+        char label[80];snprintf(label,sizeof(label),"titles%u-closed",titles);
+        if(expect_case(label,(HANDLE)8,&XeExEventObjectType,STATUS_INVALID_HANDLE,NULL,FALSE,calls,calls))return 1;
+    }
+    return table_levels(optimized);
+}
+static int lazy(void) {
+    setup(TRUE,FALSE);PVOID body=&ObpGetHandleObject(&normal_entries[2])->Body;
+    assert(XobHasTitleObjects()&&XobShimObjectType()==NULL);
+    return expect_case("title-created-shim-not-initialized",(HANDLE)8,&XeExEventObjectType,STATUS_SUCCESS,body,FALSE,1,1);
+}
+static int table_levels(BOOLEAN optimized) {
+    HANDLE_TABLE saved=normal_table;
+    HANDLE_TABLE_ENTRY *leaf=calloc(512,sizeof(*leaf));
+    PVOID *middle=calloc(1024,sizeof(PVOID)),*top=calloc(1024,sizeof(PVOID));
+    assert(leaf&&middle&&top);
+    PVOID object=new_native(ExEventObjectType,1,1,201);put_entry(&leaf[1],object);
+    middle[1]=leaf;top[1]=middle;
+    for(unsigned level=1;level<3;level++) {
+        unsigned index=level==1?513:524801;
+        normal_table.TableCode=(ULONG_PTR)(level==1?middle:top)|level;
+        normal_table.NextHandleNeedingPool=(index+1)*4;
+        if(expect_case(level==1?"level1-grown-table":"level2-grown-table",(HANDLE)(uintptr_t)(index*4),&XeExEventObjectType,STATUS_SUCCESS,object,FALSE,optimized?1:2,optimized?1:2))return 1;
+    }
+    normal_table=saved;OBJECT_TO_OBJECT_HEADER(object)->HandleCount=0;ObfDereferenceObject(object);
+    free(leaf);free(middle);free(top);return 0;
+}
+static LONG stop_readers, reader_calls;
+static void *reader(void *ignored) {
+    (void)ignored;
+    while(!__atomic_load_n(&stop_readers,__ATOMIC_SEQ_CST)) {
+        PVOID out=(PVOID)0xfeedface;NTSTATUS s=XeObReferenceObjectByHandle((HANDLE)120,(POBJECT_TYPE)&XeExEventObjectType,&out);
+        if(s==STATUS_SUCCESS) { assert(out&&((PAYLOAD *)out)->Cookie==200);ObfDereferenceObject(out); }
+        else assert(s==STATUS_INVALID_HANDLE&&out==NULL);
+        InterlockedIncrement(&reader_calls);
+    }
+    return NULL;
+}
+static pthread_barrier_t final_close_barrier;
+static void *hold_until_closed(void *ignored) {
+    (void)ignored;
+    PVOID object=NULL;assert(XeObReferenceObjectByHandle((HANDLE)120,(POBJECT_TYPE)&XeExEventObjectType,&object)==STATUS_SUCCESS);
+    pthread_barrier_wait(&final_close_barrier);
+    pthread_barrier_wait(&final_close_barrier);
+    assert(((PAYLOAD *)object)->Cookie==200);
+    ObfDereferenceObject(object);return NULL;
+}
+static int races(void) {
+    setup(TRUE,TRUE);PVOID object=new_native(ExEventObjectType,1,0,200);
+    pthread_t threads[2];assert(pthread_create(&threads[0],NULL,reader,NULL)==0);assert(pthread_create(&threads[1],NULL,reader,NULL)==0);
+    for(unsigned i=0;i<10000;i++) {
+        InterlockedIncrement(&OBJECT_TO_OBJECT_HEADER(object)->HandleCount);
+        InterlockedIncrementSizeT(&OBJECT_TO_OBJECT_HEADER(object)->PointerCount);
+        put_entry(&normal_entries[30],object);sched_yield();close_entry(&normal_table,(HANDLE)120);
+    }
+    __atomic_store_n(&stop_readers,1,__ATOMIC_SEQ_CST);
+    assert(pthread_join(threads[0],NULL)==0&&pthread_join(threads[1],NULL)==0);
+    assert(reader_calls>0&&OBJECT_TO_OBJECT_HEADER(object)->PointerCount==1&&OBJECT_TO_OBJECT_HEADER(object)->HandleCount==0);
+    LONG deleted=native_deletes;ObfDereferenceObject(object);assert(native_deletes==deleted+1);
+    printf("{\"case\":\"two-readers-close-reuse\",\"cycles\":10000,\"reader_calls\":%d,\"delete\":1,\"ownership\":\"balanced\"}\n",reader_calls);
+    assert(pthread_barrier_init(&final_close_barrier,NULL,3)==0);
+    for(unsigned i=0;i<100;i++) {
+        object=new_native(ExEventObjectType,1,1,200);put_entry(&normal_entries[30],object);
+        deleted=native_deletes;
+        assert(pthread_create(&threads[0],NULL,hold_until_closed,NULL)==0&&pthread_create(&threads[1],NULL,hold_until_closed,NULL)==0);
+        pthread_barrier_wait(&final_close_barrier);close_entry(&normal_table,(HANDLE)120);
+        assert(native_deletes==deleted&&OBJECT_TO_OBJECT_HEADER(object)->PointerCount==2&&OBJECT_TO_OBJECT_HEADER(object)->HandleCount==0);
+        pthread_barrier_wait(&final_close_barrier);
+        assert(pthread_join(threads[0],NULL)==0&&pthread_join(threads[1],NULL)==0&&native_deletes==deleted+1);
+    }
+    assert(pthread_barrier_destroy(&final_close_barrier)==0);
+    puts("{\"case\":\"two-held-references-final-close\",\"cycles\":100,\"delete_per_cycle\":1,\"ownership\":\"balanced\"}");return 0;
+}
+static int timing(const char *workload) {
+    BOOLEAN titles=strcmp(workload,"no-title")!=0;setup(titles,TRUE);
+    const unsigned iterations=1000000;uint64_t checksum=0;struct timespec start,end;
+    for(unsigned warm=0;warm<10000;warm++) { PVOID out;assert(XeObReferenceObjectByHandle((HANDLE)8,(POBJECT_TYPE)&XeExEventObjectType,&out)==0);ObfDereferenceObject(out); }
+    clock_gettime(CLOCK_MONOTONIC,&start);
+    for(unsigned i=0;i<iterations;i++) {
+        BOOLEAN shim=!strcmp(workload,"shim")||(!strcmp(workload,"mixed")&&i%4==0);
+        BOOLEAN wrong=!strcmp(workload,"wrong-native");PVOID out=NULL;
+        NTSTATUS s=XeObReferenceObjectByHandle((HANDLE)(uintptr_t)(shim?80:8),shim?(PVOID)&title_types[0]:wrong?(PVOID)&XeIoFileObjectType:(PVOID)&XeExEventObjectType,&out);
+        checksum+=(uint32_t)s;
+        if(NT_SUCCESS(s)) { checksum+=shim?*(ULONG *)out:((PAYLOAD *)out)->Cookie; release_result(out,shim); }
+        else assert(wrong&&s==STATUS_OBJECT_TYPE_MISMATCH&&out==NULL);
+    }
+    clock_gettime(CLOCK_MONOTONIC,&end);
+    uint64_t ns=(uint64_t)(end.tv_sec-start.tv_sec)*1000000000u+end.tv_nsec-start.tv_nsec;
+    printf("{\"workload\":\"%s\",\"iterations\":%u,\"ns\":%llu,\"checksum\":%llu}\n",workload,iterations,(unsigned long long)ns,(unsigned long long)checksum);return 0;
+}
+int main(int argc,char **argv) {
+    assert(argc>=2);
+    if(!strcmp(argv[1],"matrix"))return matrix(argc<3||strcmp(argv[2],"baseline"));
+    if(!strcmp(argv[1],"lazy"))return lazy();
+    if(!strcmp(argv[1],"races"))return races();
+    if(!strcmp(argv[1],"timing"))return timing(argv[2]);
+    return 2;
+}
