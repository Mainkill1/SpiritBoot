--- /dev/null
+++ b/tests/xbe/object-handle-fastpath/main.c
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "../api-regression/harness.h"
+#include <stdio.h>
+#include <string.h>
+#include <stdarg.h>
+#ifndef STATUS_OBJECT_TYPE_MISMATCH
+#define STATUS_OBJECT_TYPE_MISMATCH ((NTSTATUS)0xc0000024)
+#endif
+#ifndef STATUS_INVALID_HANDLE
+#define STATUS_INVALID_HANDLE ((NTSTATUS)0xc0000008)
+#endif
+const char *g_fail_file;
+int g_fail_line;
+char g_fail_what[160];
+void test_record_failure(const char *file,int line,const char *format,...) {
+    va_list args;g_fail_file=file;g_fail_line=line;va_start(args,format);
+    vsnprintf(g_fail_what,sizeof(g_fail_what),format,args);va_end(args);
+}
+static ULONG allocations,deletes,frees;
+static PVOID title;
+static HANDLE title_handle;
+static PVOID NTAPI allocate(SIZE_T size,ULONG tag) { allocations++;return ExAllocatePoolWithTag(size,tag); }
+static VOID NTAPI free_title(PVOID base) { frees++;ExFreePool(base); }
+static VOID NTAPI delete_title(PVOID object) { if(object==title)deletes++; }
+static OBJECT_TYPE title_type={allocate,free_title,NULL,delete_title,NULL,NULL,'hSbO'};
+static OBJECT_TYPE other_type={allocate,free_title,NULL,delete_title,NULL,NULL,'xSbO'};
+static bool expect(HANDLE handle,POBJECT_TYPE type,NTSTATUS want,PVOID want_object) {
+    PVOID out=(PVOID)0xfeedface;
+    NTSTATUS status=ObReferenceObjectByHandle(handle,type,&out);
+    if(status!=want||(!NT_SUCCESS(status)&&out!=NULL)||(NT_SUCCESS(status)&&(!out||(want_object&&out!=want_object)))) {
+        if(NT_SUCCESS(status)&&out)ObfDereferenceObject(out);
+        FAIL_AND_RETURN("handle=%p type=%p status=%08x want=%08x out=%p want-out=%p",handle,type,(unsigned)status,(unsigned)want,out,want_object);
+    }
+    if(NT_SUCCESS(status))ObfDereferenceObject(out);
+    return true;
+}
+static bool measure(const char *name,HANDLE handle,POBJECT_TYPE type,PVOID expected) {
+    const ULONG iterations=50000;
+    for(ULONG i=0;i<1000;i++)if(!expect(handle,type,STATUS_SUCCESS,expected))return false;
+    for(ULONG sample=0;sample<7;sample++) {
+        ULONGLONG checksum=0,start=KeQueryPerformanceCounter();
+        for(ULONG i=0;i<iterations;i++) {
+            PVOID out=NULL;NTSTATUS status=ObReferenceObjectByHandle(handle,type,&out);
+            checksum+=(ULONG)status+(out==expected);
+            if(NT_SUCCESS(status)&&out)ObfDereferenceObject(out);
+        }
+        ULONGLONG ticks=KeQueryPerformanceCounter()-start;
+        ASSERT_EQ_U32(checksum,iterations);
+        tap_comment("HANDLE-PERF name=%s sample=%u iterations=%u ticks=%llu frequency=%llu checksum=%llu",name,(unsigned)sample,(unsigned)iterations,ticks,KeQueryPerformanceFrequency(),checksum);
+    }
+    return true;
+}
+static bool builtins(const char *timing_name) {
+    HANDLE event=NULL;PVOID body=NULL;
+    ASSERT_NTSTATUS(NtCreateEvent(&event,NULL,NotificationEvent,FALSE),STATUS_SUCCESS);
+    NTSTATUS s=ObReferenceObjectByHandle(event,&ExEventObjectType,&body);
+    bool ok=s==STATUS_SUCCESS&&body&&expect(event,NULL,STATUS_SUCCESS,body)&&
+        expect(event,&ExEventObjectType,STATUS_SUCCESS,body)&&
+        expect(event,&IoFileObjectType,STATUS_OBJECT_TYPE_MISMATCH,NULL)&&
+        expect((HANDLE)(LONG_PTR)-2,NULL,STATUS_SUCCESS,NULL)&&
+        expect((HANDLE)(LONG_PTR)-2,&PsThreadObjectType,STATUS_SUCCESS,NULL)&&
+        expect((HANDLE)(LONG_PTR)-2,&ExEventObjectType,STATUS_OBJECT_TYPE_MISMATCH,NULL)&&
+        expect((HANDLE)(LONG_PTR)-1,NULL,STATUS_SUCCESS,NULL)&&
+        expect((HANDLE)(LONG_PTR)-1,&PsThreadObjectType,STATUS_OBJECT_TYPE_MISMATCH,NULL)&&
+        expect((HANDLE)0x7ffffffc,&ExEventObjectType,STATUS_INVALID_HANDLE,NULL);
+    if(ok&&timing_name)ok=measure(timing_name,event,&ExEventObjectType,body);
+    NTSTATUS close=NtClose(event);
+    if(body)ObfDereferenceObject(body);
+    if(!ok)return false;
+    ASSERT_NTSTATUS(close,STATUS_SUCCESS);
+    return expect(event,&ExEventObjectType,STATUS_INVALID_HANDLE,NULL);
+}
+static bool builtins_before_title(void){return builtins("no-title");}
+static bool builtins_created(void){return builtins(NULL);}
+static bool builtins_inserted(void){return builtins("ordinary");}
+static bool create_first_title(void) {
+    ASSERT_NTSTATUS(ObCreateObject(&title_type,NULL,32,&title),STATUS_SUCCESS);
+    ASSERT_NOT_NULL(title);memset(title,0x5a,32);
+    ASSERT_EQ_U32(allocations,1);
+    ASSERT_EQ_U32(OBJECT_TO_OBJECT_HEADER(title)->PointerCount,1);
+    ASSERT_EQ_U32(OBJECT_TO_OBJECT_HEADER(title)->HandleCount,0);
+    return true;
+}
+static bool insert_title(void) {
+    ASSERT_NOT_NULL(title);
+    ASSERT_NTSTATUS(ObInsertObject(title,NULL,1,&title_handle),STATUS_SUCCESS);
+    ASSERT_NOT_NULL(title_handle);
+    ASSERT_EQ_U32(OBJECT_TO_OBJECT_HEADER(title)->PointerCount,2);
+    ASSERT_EQ_U32(OBJECT_TO_OBJECT_HEADER(title)->HandleCount,1);
+    return expect(title_handle,&title_type,STATUS_SUCCESS,title);
+}
+static bool title_matrix(void) {
+    PVOID second=NULL;
+    ASSERT_NTSTATUS(ObCreateObject(&other_type,NULL,4,&second),STATUS_SUCCESS);
+    ObfDereferenceObject(second); /* make another registered title type */
+    ULONG count=OBJECT_TO_OBJECT_HEADER(title)->PointerCount;
+    bool ok=expect(title_handle,NULL,STATUS_SUCCESS,title)&&
+        expect(title_handle,&title_type,STATUS_SUCCESS,title)&&
+        expect(title_handle,&other_type,STATUS_OBJECT_TYPE_MISMATCH,NULL)&&
+        expect(title_handle,&ExEventObjectType,STATUS_OBJECT_TYPE_MISMATCH,NULL);
+    if(!ok)return false;
+    ASSERT_EQ_U32(OBJECT_TO_OBJECT_HEADER(title)->PointerCount,count);
+    ASSERT_EQ_U32(deletes,0);return measure("shim",title_handle,&title_type,title);
+}
+static bool mismatch_precedence(void) {
+    HANDLE event=NULL;
+    ASSERT_NTSTATUS(NtCreateEvent(&event,NULL,NotificationEvent,FALSE),STATUS_SUCCESS);
+    bool ok=expect(event,&title_type,STATUS_OBJECT_TYPE_MISMATCH,NULL)&&
+        expect((HANDLE)0x7ffffffc,&title_type,STATUS_OBJECT_TYPE_MISMATCH,NULL);
+    NtClose(event);
+    return ok&&expect(event,&title_type,STATUS_OBJECT_TYPE_MISMATCH,NULL);
+}
+static bool title_reference_survives_close(void) {
+    PVOID held=NULL;ULONG before=frees;
+    ASSERT_NTSTATUS(ObReferenceObjectByHandle(title_handle,NULL,&held),STATUS_SUCCESS);
+    ASSERT_EQ_PTR(held,title);
+    ASSERT_NTSTATUS(NtClose(title_handle),STATUS_SUCCESS);
+    ASSERT_EQ_U32(OBJECT_TO_OBJECT_HEADER(title)->HandleCount,0);
+    ASSERT_EQ_U32(OBJECT_TO_OBJECT_HEADER(title)->PointerCount,2);
+    ASSERT_EQ_U32(deletes,0);ASSERT_EQ_U32(frees,before);
+    ASSERT_TRUE(expect(title_handle,&title_type,STATUS_OBJECT_TYPE_MISMATCH,NULL));
+    ObfDereferenceObject(held);
+    ASSERT_EQ_U32(OBJECT_TO_OBJECT_HEADER(title)->PointerCount,1);
+    ObfDereferenceObject(title);
+    ASSERT_EQ_U32(deletes,1);ASSERT_EQ_U32(frees,before+1);title=NULL;return true;
+}
+static bool native_close_reuse(void) {
+    for(unsigned i=0;i<1000;i++) {
+        HANDLE h=NULL;PVOID held=NULL;
+        ASSERT_NTSTATUS(NtCreateEvent(&h,NULL,NotificationEvent,FALSE),STATUS_SUCCESS);
+        ASSERT_NTSTATUS(ObReferenceObjectByHandle(h,&ExEventObjectType,&held),STATUS_SUCCESS);
+        ASSERT_NOT_NULL(held);ASSERT_NTSTATUS(NtClose(h),STATUS_SUCCESS);
+        ASSERT_TRUE(expect(h,&ExEventObjectType,STATUS_INVALID_HANDLE,NULL));
+        ObfDereferenceObject(held);
+    }
+    return true;
+}
+static bool native_kernel_handle(void) {
+    OBJECT_ATTRIBUTES oa={NULL,NULL,0x200 /* OBJ_KERNEL_HANDLE */};HANDLE h=NULL;
+    ASSERT_NTSTATUS(NtCreateEvent(&h,&oa,NotificationEvent,FALSE),STATUS_SUCCESS);
+    bool ok=((ULONG_PTR)h&0x80000000)!=0&&expect(h,NULL,STATUS_SUCCESS,NULL)&&
+        expect(h,&ExEventObjectType,STATUS_SUCCESS,NULL)&&
+        expect(h,&IoFileObjectType,STATUS_OBJECT_TYPE_MISMATCH,NULL)&&
+        expect(h,&title_type,STATUS_OBJECT_TYPE_MISMATCH,NULL);
+    NtClose(h);ASSERT_TRUE(ok);return true;
+}
+static bool native_table_growth(void) {
+    static HANDLE handles[1500];ULONG made=0;bool ok=true;
+    for(;made<1500;made++)if(NtCreateEvent(&handles[made],NULL,NotificationEvent,FALSE)!=STATUS_SUCCESS){ok=false;break;}
+    if(ok)for(unsigned i=0;i<1500;i+=499)if(!expect(handles[i],&ExEventObjectType,STATUS_SUCCESS,NULL)){ok=false;break;}
+    for(ULONG i=0;i<made;i++)NtClose(handles[i]);ASSERT_TRUE(ok);return true;
+}
+static HANDLE race_handle;
+static volatile LONG race_stop,race_calls,race_bad;
+static void NTAPI reader(PVOID context) {
+    (void)context;
+    while(!InterlockedCompareExchange(&race_stop,0,0)) {
+        PVOID out=(PVOID)0xfeedface;NTSTATUS s=ObReferenceObjectByHandle(race_handle,&ExEventObjectType,&out);
+        if(NT_SUCCESS(s)&&out)ObfDereferenceObject(out);
+        else if(s!=STATUS_INVALID_HANDLE||out!=NULL)InterlockedIncrement(&race_bad);
+        InterlockedIncrement(&race_calls);
+    }
+}
+static void NTAPI system_routine(PKSTART_ROUTINE start,PVOID context) { if(start)start(context);PsTerminateSystemThread(STATUS_SUCCESS); }
+static bool concurrent_close(void) {
+    HANDLE threads[2]={NULL,NULL};LARGE_INTEGER delay={.QuadPart=-100000},timeout={.QuadPart=-20000000};
+    ASSERT_NTSTATUS(NtCreateEvent(&race_handle,NULL,NotificationEvent,FALSE),STATUS_SUCCESS);
+    for(unsigned i=0;i<2;i++)ASSERT_NTSTATUS(PsCreateSystemThreadEx(&threads[i],0,0,0,NULL,reader,NULL,FALSE,FALSE,system_routine),STATUS_SUCCESS);
+    KeDelayExecutionThread(KernelMode,FALSE,&delay);NtClose(race_handle);
+    KeDelayExecutionThread(KernelMode,FALSE,&delay);InterlockedExchange(&race_stop,1);
+    for(unsigned i=0;i<2;i++){ASSERT_NTSTATUS(NtWaitForSingleObject(threads[i],FALSE,&timeout),STATUS_SUCCESS);NtClose(threads[i]);}
+    ASSERT_TRUE(race_calls>0);ASSERT_EQ_U32(race_bad,0);return true;
+}
+static const test_entry_t cases[]={
+    {"builtins-before-title",builtins_before_title,NULL},
+    {"create-first-title",create_first_title,NULL},
+#ifndef LEGACY_CONTROL
+    {"builtins-after-create-before-shim",builtins_created,NULL},
+#endif
+    {"insert-title",insert_title,NULL},
+    {"builtins-after-shim",builtins_inserted,NULL},
+    {"title-type-null-wrong-and-reference-count",title_matrix,NULL},
+    {"registered-title-mismatch-precedence",mismatch_precedence,NULL},
