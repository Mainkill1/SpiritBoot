diff --git a/tests/host/object-handle-fastpath/check.py b/tests/host/object-handle-fastpath/check.py
new file mode 100644
index 00000000..5bf39f83
--- /dev/null
+++ b/tests/host/object-handle-fastpath/check.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile the actual adapter, shim ownership, native reference and table bodies.
+
+Usage: check.py OUTPUT [--baseline] [--compare SOURCE] [--benchmark]
+Requires a compiler with 32-bit libc and pthread support. No production counters.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import resource
+import statistics
+import subprocess
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+
+
+def function(text, name):
+    hit = re.search(r'\b' + name + r'\s*\([^;]*?\)\s*\{', text)
+    if not hit:
+        raise ValueError(f'missing production function {name}')
+    start = text.rfind('\n', 0, hit.start()) + 1
+    declaration = re.compile(r'(?:static\s+)?(?:NTSTATUS|POBJECT_TYPE|PHANDLE_TABLE_ENTRY|VOID|BOOLEAN|LONG_PTR)(?:\s+(?:NTAPI|FASTCALL))?|NTAPI|FASTCALL')
+    while start:
+        previous = text.rfind('\n', 0, start - 1) + 1
+        if not declaration.fullmatch(text[previous:start].strip()):
+            break
+        start = previous
+    brace = text.index('{', hit.start())
+    depth, end = 1, brace + 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end] + '\n'
+
+
+def build(root, output, counted):
+    output.mkdir(parents=True, exist_ok=True)
+    paths = ['ntoskrnl/xb/xbe.c', 'ntoskrnl/xb/obcreate.c',
+             'ntoskrnl/ob/obref.c', 'ntoskrnl/ex/handle.c',
+             'ntoskrnl/xb/object-types.h']
+    source = {p: (root / p).read_text() for p in paths}
+    ob = source[paths[1]]
+    prefix = ob[ob.index('typedef struct _XB_OBJECT_HEADER'):ob.index('/*\n * Reference counting')]
+    names = ['XobReferenceObject', 'XobDereferenceObject', 'XobIsTitleType',
+             'XobRememberType', 'XobHasTitleObjects', 'XobShimDelete',
+             'XobShimClose', 'XobIsShim', 'XobShimObjectType', 'XobUnwrapShim']
+    bodies = prefix + ''.join(function(ob, n) for n in names)
+    for name in ['ExpLookupHandleTableEntry', 'ExpLockHandleTableEntry',
+                 'ExUnlockHandleTableEntry', 'ExMapHandleToPointer']:
+        body = function(source[paths[3]], name)
+        counter = {'ExpLookupHandleTableEntry': 'table_walks',
+                   'ExMapHandleToPointer': 'table_maps'}.get(name)
+        if counter:
+            body = body.replace('{', '{\n    COUNT(' + counter + ');', 1)
+        bodies += body
+    for name in ['ObfDereferenceObject', 'ObReferenceObjectByHandle']:
+        body = function(source[paths[2]], name)
+        body = body.replace('{', '{\n    COUNT(' + ('native_dereferences' if name == 'ObfDereferenceObject' else 'native_calls') + ');', 1)
+        bodies += body
+    bodies += function(source[paths[0]], 'XeObjectTypeToInternal')
+    bodies += function(source[paths[0]], 'XeObReferenceObjectByHandle')
+    (output / 'production.inc').write_text(bodies)
+    header = source[paths[4]].replace('#pragma once', '')
+    (output / 'object-types.inc').write_text(header)
+    executable = output / ('handle-counted' if counted else 'handle-timing')
+    command = ['cc', '-m32', '-std=c11', '-O2', '-g', '-pthread', '-fno-strict-aliasing', '-Wall', '-Wextra',
+               '-Werror', '-Wno-multichar', '-Wno-unused-function', '-Wno-sign-compare', '-I', str(output),
+               *(['-DCOUNTERS'] if counted else []), str(HERE / 'fixture.c'), '-o', str(executable)]
+    subprocess.run(command, check=True)
+    return executable, {'compiler': subprocess.check_output(['cc', '--version'], text=True).splitlines()[0],
+                        'command': command, 'sha256': {p: hashlib.sha256((root / p).read_bytes()).hexdigest() for p in paths}}
+
+
+def run(exe, *arguments):
+    result = subprocess.run([str(exe), *arguments], capture_output=True, text=True)
+    if result.returncode:
+        raise AssertionError(f'{exe.name} {arguments}: returncode={result.returncode}\n{result.stdout}\n{result.stderr}')
+    return [json.loads(line) for line in result.stdout.splitlines()]
+
+
+def main():
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('output', type=Path)
+    p.add_argument('--baseline', action='store_true', help='characterize the legacy two-call wrapper; skip corrected lazy-shim test')
+    p.add_argument('--compare', type=Path, help='compile and compare a second source tree, normally the baseline')
+    p.add_argument('--benchmark', action='store_true')
+    a = p.parse_args()
+    out = a.output.resolve()
+    exe, provenance = build(ROOT, out / 'candidate', True)
+    matrix = run(exe, 'matrix', 'baseline' if a.baseline else 'optimized')
+    races = run(exe, 'races')
+    lazy = [] if a.baseline else run(exe, 'lazy')
+    result = dict(provenance=provenance, matrix=matrix, races=races, lazy_shim=lazy)
+    if a.compare:
+        before, old_provenance = build(a.compare.resolve(), out / 'baseline', True)
+        old_matrix = run(before, 'matrix', 'baseline')
+        behavior = lambda rows: [{k: v for k, v in row.items() if k not in ('calls', 'maps', 'walks', 'references', 'dereferences')} for row in rows]
+        assert behavior(matrix) == behavior(old_matrix), 'status/output/end-ownership differs from legacy matrix'
+        result['baseline'] = dict(provenance=old_provenance, matrix=old_matrix, races=run(before, 'races'))
+        lazy_red = subprocess.run([str(before), 'lazy'], capture_output=True, text=True)
+        assert lazy_red.returncode != 0, 'legacy create-before-insert defect unexpectedly passes'
+        result['baseline_lazy_failure'] = dict(returncode=lazy_red.returncode, stdout=lazy_red.stdout, stderr=lazy_red.stderr)
+        if a.benchmark:
+            cpu = min(os.sched_getaffinity(0))
+            os.sched_setaffinity(0, {cpu})
+            timings = {}
+            old_time, _ = build(a.compare.resolve(), out / 'baseline-timing', False)
+            new_time, _ = build(ROOT, out / 'candidate-timing', False)
+            for workload in ['no-title', 'ordinary', 'shim', 'wrong-native', 'mixed']:
+                samples = {'baseline': [], 'candidate': []}
+                for pair in range(15):
+                    for name, binary in ([('baseline', old_time), ('candidate', new_time)] if pair % 2 == 0 else [('candidate', new_time), ('baseline', old_time)]):
+                        record = run(binary, 'timing', workload)[0]
+                        samples[name].append(record)
+                assert all(s['checksum'] == samples['baseline'][0]['checksum'] for rows in samples.values() for s in rows), workload
+                timings[workload] = {'samples': samples, 'median_ns_per_call': {name: statistics.median(s['ns'] / s['iterations'] for s in rows) for name, rows in samples.items()}}
+            result['host_timing'] = {'pairs': 15, 'iterations_per_sample': 1000000,
+                                     'cpu_affinity': cpu,
+                                     'order': 'alternating baseline/candidate',
+                                     'meaning': '32-bit Linux production-body host timing, not xemu throughput or a title speedup',
+                                     'workloads': timings}
+    (out / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
+    print(json.dumps({'status': 'passed', 'matrix_cases': len(matrix), 'race_checks': races,
+                      'lazy_checks': lazy, 'result': str(out / 'result.json')}))
+
+
+if __name__ == '__main__':
+    main()
