+/* Open / close a YAML diagnostic block underneath a `not ok` line. */
+void tap_diag_begin(void);
+void tap_diag_end(void);
+void tap_diag_kv(const char *key, const char *fmt, ...);
+
+void tap_comment(const char *fmt, ...);
