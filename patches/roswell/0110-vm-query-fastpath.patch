diff --git a/tests/xbe/vm-query-fastpath/main.c b/tests/xbe/vm-query-fastpath/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..63dca667ca38b6f1371521df3e007d45c795d03a
--- /dev/null
+++ b/tests/xbe/vm-query-fastpath/main.c
@@ -0,0 +1,89 @@
+/* Public query boundary oracle. All reservations/commits are owned; no private
+ * structures or arbitrary output pointers. Full MBI bytes recorded for diff. */
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include <string.h>
+#include "regression.h"
+#include "expected.h"
+_Static_assert(sizeof(MEMORY_BASIC_INFORMATION)==28,"Xbox MBI ABI size");
+#define BASE 0x20000000UL
+#define SPAN 0x00c03000UL
+#define FRAG 0x30000000UL
+static volatile ULONG sink;
+static unsigned query_index;
+static void query(unsigned stage,ULONG address) {
+ struct {ULONG before;MEMORY_BASIC_INFORMATION m;ULONG after;} output;
+ memset(&output,0xa5,sizeof(output));output.before=0x12345678;output.after=0xfedcba98;
+ NTSTATUS status=NtQueryVirtualMemory((PVOID)address,&output.m);
+ MEMORY_BASIC_INFORMATION *m=&output.m;
+ if(query_index>=sizeof(query_expected)/sizeof(query_expected[0]))regression_require(0,"query expectation table is bounded");
+ const struct query_expected *expected=&query_expected[query_index++];
+ regression_check(expected->stage==stage && expected->address==address && expected->status==(ULONG)status && !memcmp(expected->mbi,m,sizeof(*m)),"all 28 public MBI bytes and status match the captured reference");
+ tap_comment("query stage=%u input=%08lx status=%08lx mbi=%08lx,%08lx,%08lx,%08lx,%08lx,%08lx,%08lx",stage,address,(ULONG)status,(ULONG)m->BaseAddress,(ULONG)m->AllocationBase,m->AllocationProtect,m->RegionSize,m->State,m->Protect,m->Type);
+ regression_check(output.before==0x12345678 && output.after==0xfedcba98,"query preserves output structure guards");
+ if(address>=0x7ffe0000){int untouched=1;for(unsigned i=0;i<sizeof(*m);i++)if(((UCHAR*)m)[i]!=0xa5)untouched=0;regression_check(status==(NTSTATUS)STATUS_INVALID_PARAMETER && untouched,"invalid top address leaves all output bytes untouched");}
+ if(address<0x7ffe0000)regression_check(status==0 && (ULONG)m->BaseAddress==(address&~4095UL) && m->RegionSize && address-(ULONG)m->BaseAddress<m->RegionSize,"query describes a page-aligned run containing its valid input");
+}
+static void boundaries(unsigned stage) {
+ static const ULONG offsets[]={0,1,4095,4096,8192,0x3fe000,0x3ff000,0x400000,0x401000,0x7ff000,0x800000,0x801000,0xbff000,0xc00000,0xc01000,0xc02000,0xc02fff,0xc03000};
+ for(unsigned i=0;i<sizeof(offsets)/sizeof(offsets[0]);i++)query(stage,BASE+offsets[i]);
+}
+static void commit(ULONG offset,ULONG size,ULONG protect) {
+ PVOID at=(PVOID)(BASE+offset);SIZE_T bytes=size;
+ NTSTATUS status=NtAllocateVirtualMemory(&at,0,&bytes,MEM_COMMIT,protect);
+ tap_comment("commit offset=%08lx size=%08lx protect=%08lx status=%08lx",offset,size,protect,(ULONG)status);
+ regression_require(status==0 && (ULONG)at==BASE+offset && bytes==size,"commit exact owned boundary range");
+}
+static void cost(unsigned mode,unsigned count) {
+ ULONGLONG frequency=KeQueryPerformanceFrequency();
+ for(unsigned sample=0;sample<5;sample++) {
+  ULONG ok=0;MEMORY_BASIC_INFORMATION m;ULONGLONG start=KeQueryPerformanceCounter();
+  for(unsigned i=0;i<count;i++) {
+   ULONG address=mode==0?BASE+4096:(mode==1 || mode==5)?0x50000000UL:mode==2?FRAG+(i%256)*0x20000+0x10000:(mode==3 || mode==6)?(i%16384)*0x20000:BASE+0x400000;
+   NTSTATUS status=NtQueryVirtualMemory((PVOID)address,&m);
+   ok+=status==0;sink^=m.RegionSize;
+  }
+  ULONGLONG ticks=KeQueryPerformanceCounter()-start;
+  tap_comment("query_cost mode=%u count=%u sample=%u frequency=%llu ticks=%llu successful=%lu",mode,count,sample,frequency,ticks,ok);
+  regression_check(ok==count || ((mode==3 || mode==6) && ok==count-1),"all timed query statuses match the valid range");
+ }
+}
+/* Preserve main's current reserve-only overflow behavior. This compatibility
+ * case is separate from the captured reference table. Never commit or release
+ * the wrapped high reservation; this isolated fixture shuts down afterward. */
+static void wrapped_tail(void) {
+ PVOID low=(PVOID)BASE;SIZE_T size=65536;
+ regression_require(NtAllocateVirtualMemory(&low,0,&size,MEM_RESERVE,PAGE_READWRITE)==0 && (ULONG)low==BASE && size==65536,"reserve valid low range before wrapped-tail regression");
+ MEMORY_BASIC_INFORMATION before;
+ regression_require(NtQueryVirtualMemory(low,&before)==0 && before.State==MEM_RESERVE && before.RegionSize==65536,"capture valid reserved MBI before overflowing tail");
+ PVOID high=(PVOID)0x70000000UL;size=0xa0000000UL;
+ regression_require(NtAllocateVirtualMemory(&high,0,&size,MEM_RESERVE,PAGE_READWRITE)==0 && (ULONG)high==0x70000000UL && size==0xa0000000UL,"preserve main reserve-only overflow allocation behavior");
+ struct {ULONG before;MEMORY_BASIC_INFORMATION m;ULONG after;} output;
+ memset(&output,0xa5,sizeof(output));output.before=0x12345678;output.after=0xfedcba98;
+ regression_check(NtQueryVirtualMemory(low,&output.m)==0 && !memcmp(&before,&output.m,sizeof(before)) && output.before==0x12345678 && output.after==0xfedcba98,"wrapped high tail preserves low query status, full MBI and guards");
+ size=0;regression_require(NtFreeVirtualMemory(&low,&size,MEM_RELEASE)==0,"release valid low range after wrapped-tail query");
+}
+int main(void) {
+ regression_begin();
+ PVOID base=(PVOID)BASE;SIZE_T size=SPAN;
+ regression_require(NtAllocateVirtualMemory(&base,0,&size,MEM_RESERVE,PAGE_READWRITE)==0 && (ULONG)base==BASE && size==SPAN,"reserve exact sparse range crossing three PDE boundaries");
+ boundaries(0);cost(0,128);
+ commit(0,8192,PAGE_READWRITE);commit(0x3ff000,8192,PAGE_READONLY);commit(0x800000,4096,PAGE_NOACCESS);commit(0xc00000,8192,PAGE_READWRITE);
+ boundaries(1);cost(4,4096);
+ MmSetAddressProtect((PVOID)BASE,4096,PAGE_READONLY);boundaries(2);
+ base=(PVOID)(BASE+0x3ff000);size=8192;
+ regression_require(NtFreeVirtualMemory(&base,&size,MEM_DECOMMIT)==0,"decommit owned pages spanning a PDE boundary");
+ boundaries(3);
+ base=(PVOID)BASE;size=0;regression_require(NtFreeVirtualMemory(&base,&size,MEM_RELEASE)==0,"release sparse reservation");
+ boundaries(4);cost(5,4096);cost(6,16384);
+ for(unsigned i=0;i<256;i++) {
+  base=(PVOID)(FRAG+i*0x20000);size=65536;
+  regression_require(NtAllocateVirtualMemory(&base,0,&size,MEM_RESERVE,PAGE_READWRITE)==0 && (ULONG)base==FRAG+i*0x20000 && size==65536,"reserve sorted fragments with exact free gaps");
+ }
+ for(unsigned i=0;i<256;i+=17){query(5,FRAG+i*0x20000);query(5,FRAG+i*0x20000+0x10000);query(5,FRAG+i*0x20000+0x11abc);}
+ query(5,FRAG-4096);query(5,FRAG+256*0x20000);cost(1,4096);cost(2,4096);cost(3,16384);
+ for(unsigned i=0;i<256;i++){base=(PVOID)(FRAG+i*0x20000);size=0;regression_require(NtFreeVirtualMemory(&base,&size,MEM_RELEASE)==0,"release owned fragment");}
+ query(6,0);query(6,0x7ffdffff);query(6,0x7ffe0000);query(6,0x7fffffff);query(6,0xffffffff);
+ wrapped_tail();
+ regression_finish();
+}
diff --git a/tests/xbe/vm-query-fastpath/regression.h b/tests/xbe/vm-query-fastpath/regression.h
new file mode 100644
index 0000000000000000000000000000000000000000..305b1f1f784d9d30bea5eaa6655a9cc5c27365ab
--- /dev/null
+++ b/tests/xbe/vm-query-fastpath/regression.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "tap.h"
+#include <xboxkrnl/xboxkrnl.h>
+
+static unsigned regression_checks, regression_failures;
+
+static void regression_begin(void)
+{
+    tap_version(14);
+}
+
+static void regression_check(int passed, const char *description)
+{
+    ++regression_checks;
+    if (passed) {
+        tap_ok(regression_checks, description);
+    } else {
+        ++regression_failures;
+        tap_not_ok(regression_checks, description);
+    }
+}
+
+static void regression_finish(void) __attribute__((noreturn));
+static void regression_finish(void)
+{
+    LARGE_INTEGER delay = { .QuadPart = -5000000 };
+    tap_comment("checks=%u failures=%u", regression_checks, regression_failures);
+    tap_plan(regression_checks);
+    tap_drain();
+    KeDelayExecutionThread(KernelMode, FALSE, &delay);
+    HalWriteSMBusValue(0x20, 0x02, FALSE, 0x80);
+    /* A failed shutdown remains a timeout, never a passing capture. */
+    for (;;) __asm__ __volatile__("hlt");
+}
+
+static inline void regression_require(int passed, const char *description)
+{
+    regression_check(passed, description);
+    if (!passed) regression_finish();
+}
diff --git a/tests/xbe/vm-query-fastpath/tap.c b/tests/xbe/vm-query-fastpath/tap.c
new file mode 100644
index 0000000000000000000000000000000000000000..009bb8a8830628d841948a31ee334b71be3c981e
--- /dev/null
+++ b/tests/xbe/vm-query-fastpath/tap.c
@@ -0,0 +1,166 @@
+/*
+ * TAP 14 emitter.  Bytes go out the LPC47M157 SuperIO's COM1 at 115200 8N1
+ * (I/O 0x3F8).  We program the UART ourselves at first call so the suite
+ * works against both nxkrnl (which already programs it for DbgPrint) and
+ * the retail kernel (which doesn't).  isa-debugcon (port 0xE9) was the
+ * historical target but the upstream xemu AppImage builds without it.
+ */
+
+#include "tap.h"
+#include <stdio.h>
+#include <stdarg.h>
+
+#define COM1     0x3F8
+#define COM1_THR (COM1 + 0)
+#define COM1_DLL (COM1 + 0)
+#define COM1_IER (COM1 + 1)
+#define COM1_DLH (COM1 + 1)
+#define COM1_LCR (COM1 + 3)
+#define COM1_MCR (COM1 + 4)
+#define COM1_LSR (COM1 + 5)
+
+#define LSR_THRE 0x20  /* transmit holding register empty */
+#define LSR_TEMT 0x40  /* transmitter empty (shift + holding both drained) */
+#define LCR_DLAB 0x80
+#define LCR_8N1  0x03
+
+static inline void outb(unsigned short port, unsigned char val)
+{
+    __asm__ __volatile__("outb %0, %1" : : "a"(val), "Nd"(port));
+}
+
+static inline unsigned char inb(unsigned short port)
+{
+    unsigned char ret;
+    __asm__ __volatile__("inb %1, %0" : "=a"(ret) : "Nd"(port));
+    return ret;
+}
+
+/* Xbox is single-CPU: prevent a scheduled kernel/debug writer from entering
+ * between bytes. Restore the caller's full flags, including an already-clear
+ * IF. Formatting stays outside this span; no kernel-private lock is borrowed. */
+static inline unsigned int tap_irq_save(void)
+{
+    unsigned int flags;
+    __asm__ __volatile__("pushfl; popl %0; cli" : "=r"(flags) : : "memory");
+    return flags;
+}
+
+static inline void tap_irq_restore(unsigned int flags)
+{
+    __asm__ __volatile__("pushl %0; popfl" : : "r"(flags) : "memory", "cc");
+}
+
+static void com_init(void)
+{
+    static int initialized = 0;
+    if (initialized) return;
+    initialized = 1;
+    outb(COM1_IER, 0x00);             /* disable all interrupts */
+    outb(COM1_LCR, LCR_DLAB);         /* DLAB=1 to set divisor */
+    outb(COM1_DLL, 0x01);             /* 115200 baud (1.8432 MHz / 16 / 1) */
+    outb(COM1_DLH, 0x00);
+    outb(COM1_LCR, LCR_8N1);          /* DLAB=0, 8N1 */
+    /* Retain the existing FIFO mode and queued bytes. THRE polling works
+     * with either the reset/default UART or a kernel-configured FIFO; changing
+     * FIFO enable or clearing it could discard the preceding debug message. */
+    outb(COM1_MCR, 0x0B);             /* DTR + RTS + OUT2 */
+}
+
+static void com_putc(char c)
+{
+    while ((inb(COM1_LSR) & LSR_THRE) == 0) { }
+    outb(COM1_THR, (unsigned char)c);
+}
+
+void tap_drain(void)
+{
+    while ((inb(COM1_LSR) & LSR_TEMT) == 0) { }
+}
+
+static void com_puts(const char *s)
+{
+    unsigned int flags = tap_irq_save();
+    com_init();
+    while (*s) com_putc(*s++);
+    tap_irq_restore(flags);
+}
+
+static void com_vprintf(const char *fmt, va_list ap)
+{
+    char buf[256];
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_puts(buf);
+}
+
+static void com_printf(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    com_vprintf(fmt, ap);
+    va_end(ap);
+}
+
+void tap_puts(const char *s)
+{
+    com_puts(s);
+}
+
+void tap_version(unsigned int v)
+{
+    com_printf("TAP version %u\n", v);
+}
+
+void tap_plan(unsigned int n)
+{
+    com_printf("1..%u\n", n);
+}
+
+void tap_ok(unsigned int n, const char *desc)
+{
+    com_printf("ok %u - %s\n", n, desc);
+}
+
+void tap_not_ok(unsigned int n, const char *desc)
+{
+    com_printf("not ok %u - %s\n", n, desc);
+}
+
+void tap_diag_begin(void)
+{
+    com_puts("  ---\n");
+}
+
+void tap_diag_end(void)
+{
+    com_puts("  ...\n");
+}
+
+void tap_diag_kv(const char *key, const char *fmt, ...)
+{
+    char buf[192];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_printf("  %s: %s\n", key, buf);
+}
+
+void tap_comment(const char *fmt, ...)
+{
+    char buf[192];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n < 0) return;
+    if (n > (int)sizeof(buf) - 1) n = sizeof(buf) - 1;
+    buf[n] = 0;
+    com_printf("# %s\n", buf);
+}
