+#!/usr/bin/env python3
+"""Run actual production query against the frozen prior production behavior."""
+from pathlib import Path
+import argparse
+import re
+import subprocess
+
+
+def function(text, signature):
+    start = text.index(signature)
+    end = text.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end] + "\n"
+
+
+def extract(path, prefix):
+    source = path.read_text()
+    body = "\n".join(function(source, signature) for signature in (
+        "static ULONG\nNxvPteToProtect(",
+        "static NXV_REGION *\nNxvFindRegion(",
+        "NTSTATUS\nNTAPI\nNxVmQueryVirtualMemory(",
+    ))
+    body = body.replace(
+        "NXV_REGION *R = CONTAINING_RECORD(Entry, NXV_REGION, Link);",
+        "NXV_REGION *R = CONTAINING_RECORD(Entry, NXV_REGION, Link); "
+        "++nodes; CHECK(lock_depth == 1);",
+    )
+    body = re.sub(
+        r"NXV_REGION \*Last = CONTAINING_RECORD\(NxvRegionList.Blink,\s*NXV_REGION, Link\);",
+        lambda match: match[0] + " ++tail_probes; CHECK(lock_depth == 1);", body,
+    )
+    for name in ("NxvPteToProtect", "NxvFindRegion", "NxVmQueryVirtualMemory"):
+        body = re.sub(r"\b" + name + r"\b", prefix + name, body)
+    return body
+
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("source", type=Path)
+parser.add_argument("output", type=Path)
+parser.add_argument("--allow-baseline", action="store_true",
+                    help="qualify the pre-patch semantic baseline without work limits")
+args = parser.parse_args()
+args.output.mkdir(parents=True, exist_ok=True)
+here = Path(__file__).resolve().parent
+(args.output / "actual.inc").write_text(
+    extract(here / "baseline-query.c", "Base") + "\n" +
+    extract(args.source / "ntoskrnl/xb/mm/vm.c", "Candidate")
+)
+subprocess.run([
+    "cc", "-std=c11", "-O2", "-g", "-Wall", "-Wextra", "-Werror",
+    "-Wno-unused-function", "-fsanitize=address,undefined",
+    "-fno-omit-frame-pointer", "-I" + str(args.output),
+    str(here / "harness.c"), "-o", str(args.output / "query-test"),
+], check=True)
+subprocess.run([str(args.output / "query-test")] +
+               ([] if args.allow_baseline else ["fast"]), check=True)
