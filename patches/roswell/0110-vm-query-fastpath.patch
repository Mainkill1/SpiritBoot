+/* Public query boundary oracle. All reservations/commits are owned; no private
+ * structures or arbitrary output pointers. Full MBI bytes recorded for diff. */
+#include <windows.h>
+#include <xboxkrnl/xboxkrnl.h>
+#include <string.h>
+#include "regression.h"
+#include "expected.h"
+_Static_assert(sizeof(MEMORY_BASIC_INFORMATION)==28,"Xbox MBI ABI size");
+#define BASE 0x20000000UL
+#define SPAN 0x00c03000UL
+#define FRAG 0x30000000UL
+static volatile ULONG sink;
+static unsigned query_index;
+static void query(unsigned stage,ULONG address) {
+ struct {ULONG before;MEMORY_BASIC_INFORMATION m;ULONG after;} output;
+ memset(&output,0xa5,sizeof(output));output.before=0x12345678;output.after=0xfedcba98;
+ NTSTATUS status=NtQueryVirtualMemory((PVOID)address,&output.m);
+ MEMORY_BASIC_INFORMATION *m=&output.m;
+ if(query_index>=sizeof(query_expected)/sizeof(query_expected[0]))regression_require(0,"query expectation table is bounded");
+ const struct query_expected *expected=&query_expected[query_index++];
+ regression_check(expected->stage==stage && expected->address==address && expected->status==(ULONG)status && !memcmp(expected->mbi,m,sizeof(*m)),"all 28 public MBI bytes and status match the captured reference");
+ tap_comment("query stage=%u input=%08lx status=%08lx mbi=%08lx,%08lx,%08lx,%08lx,%08lx,%08lx,%08lx",stage,address,(ULONG)status,(ULONG)m->BaseAddress,(ULONG)m->AllocationBase,m->AllocationProtect,m->RegionSize,m->State,m->Protect,m->Type);
+ regression_check(output.before==0x12345678 && output.after==0xfedcba98,"query preserves output structure guards");
+ if(address>=0x7ffe0000){int untouched=1;for(unsigned i=0;i<sizeof(*m);i++)if(((UCHAR*)m)[i]!=0xa5)untouched=0;regression_check(status==(NTSTATUS)STATUS_INVALID_PARAMETER && untouched,"invalid top address leaves all output bytes untouched");}
+ if(address<0x7ffe0000)regression_check(status==0 && (ULONG)m->BaseAddress==(address&~4095UL) && m->RegionSize && address-(ULONG)m->BaseAddress<m->RegionSize,"query describes a page-aligned run containing its valid input");
+}
+static void boundaries(unsigned stage) {
+ static const ULONG offsets[]={0,1,4095,4096,8192,0x3fe000,0x3ff000,0x400000,0x401000,0x7ff000,0x800000,0x801000,0xbff000,0xc00000,0xc01000,0xc02000,0xc02fff,0xc03000};
+ for(unsigned i=0;i<sizeof(offsets)/sizeof(offsets[0]);i++)query(stage,BASE+offsets[i]);
+}
+static void commit(ULONG offset,ULONG size,ULONG protect) {
+ PVOID at=(PVOID)(BASE+offset);SIZE_T bytes=size;
+ NTSTATUS status=NtAllocateVirtualMemory(&at,0,&bytes,MEM_COMMIT,protect);
+ tap_comment("commit offset=%08lx size=%08lx protect=%08lx status=%08lx",offset,size,protect,(ULONG)status);
+ regression_require(status==0 && (ULONG)at==BASE+offset && bytes==size,"commit exact owned boundary range");
+}
+static void cost(unsigned mode,unsigned count) {
+ ULONGLONG frequency=KeQueryPerformanceFrequency();
+ for(unsigned sample=0;sample<5;sample++) {
+  ULONG ok=0;MEMORY_BASIC_INFORMATION m;ULONGLONG start=KeQueryPerformanceCounter();
+  for(unsigned i=0;i<count;i++) {
+   ULONG address=mode==0?BASE+4096:(mode==1 || mode==5)?0x50000000UL:mode==2?FRAG+(i%256)*0x20000+0x10000:(mode==3 || mode==6)?(i%16384)*0x20000:BASE+0x400000;
+   NTSTATUS status=NtQueryVirtualMemory((PVOID)address,&m);
+   ok+=status==0;sink^=m.RegionSize;
+  }
+  ULONGLONG ticks=KeQueryPerformanceCounter()-start;
+  tap_comment("query_cost mode=%u count=%u sample=%u frequency=%llu ticks=%llu successful=%lu",mode,count,sample,frequency,ticks,ok);
+  regression_check(ok==count || ((mode==3 || mode==6) && ok==count-1),"all timed query statuses match the valid range");
+ }
+}
+int main(void) {
+ regression_begin();
+ PVOID base=(PVOID)BASE;SIZE_T size=SPAN;
+ regression_require(NtAllocateVirtualMemory(&base,0,&size,MEM_RESERVE,PAGE_READWRITE)==0 && (ULONG)base==BASE && size==SPAN,"reserve exact sparse range crossing three PDE boundaries");
+ boundaries(0);cost(0,128);
+ commit(0,8192,PAGE_READWRITE);commit(0x3ff000,8192,PAGE_READONLY);commit(0x800000,4096,PAGE_NOACCESS);commit(0xc00000,8192,PAGE_READWRITE);
+ boundaries(1);cost(4,4096);
+ MmSetAddressProtect((PVOID)BASE,4096,PAGE_READONLY);boundaries(2);
+ base=(PVOID)(BASE+0x3ff000);size=8192;
+ regression_require(NtFreeVirtualMemory(&base,&size,MEM_DECOMMIT)==0,"decommit owned pages spanning a PDE boundary");
+ boundaries(3);
+ base=(PVOID)BASE;size=0;regression_require(NtFreeVirtualMemory(&base,&size,MEM_RELEASE)==0,"release sparse reservation");
+ boundaries(4);cost(5,4096);cost(6,16384);
