index 0000000000000000000000000000000000000000..7339249ab9c98c7b2705e4ccd44301787ede7673
--- /dev/null
+++ b/tests/host/vm-query-fastpath/harness.c
@@ -0,0 +1,207 @@
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint32_t ULONG,NTSTATUS,SIZE_T;typedef uintptr_t ULONG_PTR;typedef void *PVOID;typedef void VOID;
+_Static_assert(sizeof(ULONG_PTR)*8==QUERY_ABI_BITS,"requested query ABI");
+#define NTAPI
+#define IN
+#define OUT
+#define PAGE_SIZE 4096u
+#define PAGE_NOACCESS 1u
+#define PAGE_READONLY 2u
+#define PAGE_READWRITE 4u
+#define PAGE_NOCACHE 0x200u
+#define PAGE_WRITECOMBINE 0x400u
+#define MEM_COMMIT 0x1000u
+#define MEM_RESERVE 0x2000u
+#define MEM_FREE 0x10000u
+#define MEM_PRIVATE 0x20000u
+#define STATUS_SUCCESS 0u
+#define STATUS_INVALID_PARAMETER 0xc000000du
+#define NXV_HIGHEST 0x7ffe0000u
+#define NXV_PTE_P 1u
+#define NXV_PTE_RW 2u
+#define NXV_PTE_PWT 8u
+#define NXV_PTE_PCD 16u
+#define ROUND_DOWN(v,n) ((v)&~((ULONG_PTR)(n)-1))
+#define ROUND_UP(v,n) ROUND_DOWN((v)+(n)-1,n)
+#define min(a,b) ((a)<(b)?(a):(b))
+#define RtlZeroMemory(p,n) memset(p,0,n)
+static unsigned checks,cases,nodes,pde_probes,pte_probes,tail_probes,lock_depth;
+static unsigned acquires,releases,pde_budget=1u<<20,candidate_pde_budget=1u<<20;
+static const char *scenario="main";
+#define CHECK(x) do{checks++;if(!(x)){fprintf(stderr,"failed abi=%u scenario=%s line %u: %s\n",QUERY_ABI_BITS,scenario,__LINE__,#x);exit(1);}}while(0)
+typedef struct _LIST_ENTRY{struct _LIST_ENTRY *Flink,*Blink;}LIST_ENTRY,*PLIST_ENTRY;
+#define IsListEmpty(p) ((p)->Flink==(p))
+#define CONTAINING_RECORD(p,t,m) ((t*)((char*)(p)-offsetof(t,m)))
+typedef struct _NXV_REGION{LIST_ENTRY Link;ULONG_PTR Base;SIZE_T Size;ULONG AllocProtect;}NXV_REGION;
+typedef struct _MEMORY_BASIC_INFORMATION{PVOID BaseAddress,AllocationBase;ULONG AllocationProtect;SIZE_T RegionSize;ULONG State,Protect,Type;}MEMORY_BASIC_INFORMATION,*PMEMORY_BASIC_INFORMATION;
+_Static_assert(QUERY_ABI_BITS!=32 || sizeof(MEMORY_BASIC_INFORMATION)==28,"i386 MBI layout");
+static LIST_ENTRY NxvRegionList;static int NxvMutex;
+static ULONG pdes[1024],ptes[1<<20];static NXV_REGION regions[256];
+static void NxvEnsureInit(void){}
+static void ExAcquireFastMutex(int *p){CHECK(p==&NxvMutex && lock_depth==0);lock_depth=1;acquires++;}
+static void ExReleaseFastMutex(int *p){CHECK(p==&NxvMutex && lock_depth==1);lock_depth=0;releases++;}
+static ULONG read_pde(ULONG_PTR va){CHECK(lock_depth==1 && (va>>22)<1024);CHECK(pde_probes<pde_budget);pde_probes++;return pdes[va>>22];}
+static ULONG read_pte(ULONG_PTR va){CHECK(lock_depth==1 && (va>>12)<(1<<20));pte_probes++;return ptes[va>>12];}
+#define NXV_PDE(v) read_pde(v)
+#define NXV_PTE(v) read_pte(v)
+#include "actual.inc"
+struct work{unsigned nodes,pde,pte,tail,acquires,releases;};
+static struct work base_work,candidate_work;
+static void reset(unsigned count,ULONG_PTR start,ULONG size,ULONG stride){
+ CHECK(lock_depth==0);memset(pdes,0,sizeof(pdes));memset(ptes,0,sizeof(ptes));memset(regions,0,sizeof(regions));
+ NxvRegionList.Flink=NxvRegionList.Blink=&NxvRegionList;
+ for(unsigned i=0;i<count;i++){
+  NXV_REGION *r=&regions[i];r->Base=start+i*stride;r->Size=size;r->AllocProtect=PAGE_READWRITE;
+  r->Link.Flink=&NxvRegionList;r->Link.Blink=NxvRegionList.Blink;NxvRegionList.Blink->Flink=&r->Link;NxvRegionList.Blink=&r->Link;
+ }
+}
+static MEMORY_BASIC_INFORMATION compare(ULONG_PTR va,int null_output){
+ struct guarded{uint64_t before;MEMORY_BASIC_INFORMATION m;uint64_t after;}b,c;
+ memset(&b,0xa5,sizeof(b));memcpy(&c,&b,sizeof(c));nodes=pde_probes=pte_probes=tail_probes=acquires=releases=0;pde_budget=1u<<20;
+ NTSTATUS bs=BaseNxVmQueryVirtualMemory((PVOID)va,null_output?NULL:&b.m);base_work=(struct work){nodes,pde_probes,pte_probes,tail_probes,acquires,releases};CHECK(!lock_depth);
+ nodes=pde_probes=pte_probes=tail_probes=acquires=releases=0;pde_budget=candidate_pde_budget;
+ NTSTATUS cs=CandidateNxVmQueryVirtualMemory((PVOID)va,null_output?NULL:&c.m);candidate_work=(struct work){nodes,pde_probes,pte_probes,tail_probes,acquires,releases};CHECK(!lock_depth);
+ if(bs!=cs || memcmp(&b,&c,sizeof(b)))fprintf(stderr,"differential abi=%u scenario=%s va=%08lx baseline_status=%08x candidate_status=%08x baseline_state=%08x candidate_state=%08x baseline_size=%08x candidate_size=%08x\n",QUERY_ABI_BITS,scenario,(unsigned long)va,bs,cs,b.m.State,c.m.State,b.m.RegionSize,c.m.RegionSize);
+ CHECK(bs==cs);CHECK(!memcmp(&b,&c,sizeof(b)));CHECK(b.before==UINT64_C(0xa5a5a5a5a5a5a5a5) && b.after==b.before);
+ CHECK(base_work.acquires==candidate_work.acquires && base_work.releases==candidate_work.releases);
+ CHECK(base_work.acquires==base_work.releases && base_work.acquires==(unsigned)(!null_output && va<NXV_HIGHEST));
+ if(null_output || va>=NXV_HIGHEST){CHECK(bs==STATUS_INVALID_PARAMETER);for(unsigned i=0;i<sizeof(b.m);i++)CHECK(((unsigned char*)&b.m)[i]==0xa5);}else CHECK(bs==STATUS_SUCCESS);
+ cases++;return c.m;
+}
+static void set_page(ULONG_PTR va,ULONG flags){pdes[va>>22]=1;ptes[va>>12]=flags;}
+static void tail_wrap(void){
+ scenario="tail-wrap";
+ /* The main reserve-only mutator accepts this sorted list. On i386 the
+  * tail ends at 0x10000000, before the earlier valid reservation. */
+ reset(2,0x20000000,0x10000,0x50000000);regions[1].Size=0xa0000000;
+ const struct{ULONG va,state,size;}queries[]={
+  {0x20000000,MEM_RESERVE,0x10000},
+  {0x0fffffff,MEM_FREE,0x10001000},{0x10000000,MEM_FREE,0x10000000},
+  {0x10000001,MEM_FREE,0x10000000},{0x1fffffff,MEM_FREE,0x1000},
+  {0x20000001,MEM_RESERVE,0x10000},
+  {0x20000fff,MEM_RESERVE,0x10000},{0x20001000,MEM_RESERVE,0xf000},
+  {0x2000ffff,MEM_RESERVE,0x1000},{0x20010000,MEM_FREE,0x4fff0000},
+  {0x20010001,MEM_FREE,0x4fff0000},{0x6fffffff,MEM_FREE,0x1000},
+ };
+ printf("regression tail-wrap abi=%u base=20000000 tail=70000000 tail_size=a0000000\n",QUERY_ABI_BITS);fflush(stdout);
+ for(unsigned i=0;i<sizeof(queries)/sizeof(*queries);i++){
+  MEMORY_BASIC_INFORMATION m=compare(queries[i].va,0);CHECK(m.State==queries[i].state && m.RegionSize==queries[i].size);
+  CHECK(m.BaseAddress==(PVOID)ROUND_DOWN((ULONG_PTR)queries[i].va,PAGE_SIZE));
+  if(m.State==MEM_RESERVE){CHECK(m.AllocationBase==(PVOID)0x20000000 && m.AllocationProtect==PAGE_READWRITE && m.Protect==0 && m.Type==MEM_PRIVATE);}
+  else CHECK(m.AllocationBase==NULL && m.AllocationProtect==0 && m.Protect==PAGE_NOACCESS && m.Type==0);
+ }
+ compare(NXV_HIGHEST,0);compare(NXV_HIGHEST+1,0);compare(UINT32_MAX,0);compare(0x20000000,1);
+ /* Terminate the wider host model's oversized reservation at the valid
+  * address bound; i386 still treats the wrapped tail as free. */
+ set_page(NXV_HIGHEST-PAGE_SIZE,3);
+ MEMORY_BASIC_INFORMATION m=compare(NXV_HIGHEST-1,0);CHECK(m.RegionSize==PAGE_SIZE);
+ CHECK(m.State==(QUERY_ABI_BITS==32?MEM_FREE:MEM_COMMIT));
+ printf("regression tail-wrap abi=%u passed\n",QUERY_ABI_BITS);
+}
+static void pde_wrap(int fast){
+ scenario="pde-wrap";
+ /* All PDEs are absent. The first end reproduces the wrapped PDE skip;
+  * the remaining ends straddle the last PDE and last address-space page. */
+ const ULONG lengths[]={0xefff0000,0xefbff000,0xefc00000,0xefc01000,0xeffff000};
+ /* At most 1024 PDE skips plus 1024 final-PDE page steps. A cycle fails
+  * before it can run indefinitely; the frozen page scan keeps its budget. */
+ candidate_pde_budget=fast?2048:1u<<20;
+ for(unsigned i=0;i<sizeof(lengths)/sizeof(*lengths);i++){
+  ULONG length=lengths[i];reset(1,0x10000000,length,0);
+  printf("regression pde-wrap abi=%u base=10000000 size=%08x\n",QUERY_ABI_BITS,length);fflush(stdout);
+  MEMORY_BASIC_INFORMATION m=compare(0x10000000,0);
+  CHECK(m.BaseAddress==(PVOID)0x10000000 && m.AllocationBase==(PVOID)0x10000000 && m.AllocationProtect==PAGE_READWRITE);
+  CHECK(m.State==MEM_RESERVE && m.Protect==0 && m.Type==MEM_PRIVATE && m.RegionSize==length);
+  printf("work pde-wrap abi=%u size=%08x baseline_pde=%u candidate_pde=%u\n",QUERY_ABI_BITS,length,base_work.pde,candidate_work.pde);
+  compare(0x0fffffff,0);compare(0x10000001,0);compare(0x10000fff,0);
+  m=compare(0x10001000,0);CHECK(m.State==MEM_RESERVE && m.RegionSize==length-PAGE_SIZE);
+  m=compare(NXV_HIGHEST-1,0);CHECK(m.State==MEM_RESERVE && m.RegionSize==length-0x6ffdf000);
+  compare(NXV_HIGHEST,0);compare(NXV_HIGHEST+1,0);compare(UINT32_MAX,0);compare(0x10000000,1);
+  ULONG_PTR end=(ULONG_PTR)0x10000000+length;compare(end-1,0);compare(end,0);compare(end+1,0);
+ }
+ candidate_pde_budget=1u<<20;
+ printf("regression pde-wrap abi=%u passed\n",QUERY_ABI_BITS);
+}
+static void release_wrap(void){
+ scenario="release-wrap";
+ /* Main accepts reserve 0x20000000/0x10000 followed by MEM_RELEASE at
+  * 0x20001000 with size 0xe0000000. On i386 End wraps to 0x1000, leaving
+  * this sorted overlapping list: its tail no longer has the greatest end. */
+ reset(2,0x1000,0x2000f000,0x1ffff000);regions[1].Size=0x1000;
+ const struct{ULONG va,state,size;}queries[]={
+  {0x20002000,MEM_RESERVE,0xe000},{0,MEM_FREE,0x1000},
+  {0xfff,MEM_FREE,0x1000},{0x1000,MEM_RESERVE,0x2000f000},
+  {0x1001,MEM_RESERVE,0x2000f000},{0x20000000,MEM_RESERVE,0x10000},
+  {0x20000fff,MEM_RESERVE,0x10000},{0x20001000,MEM_RESERVE,0xf000},
+  {0x20001fff,MEM_RESERVE,0xf000},{0x2000ffff,MEM_RESERVE,0x1000},
+  {0x20010000,MEM_FREE,0x5ffd0000},{0x20010001,MEM_FREE,0x5ffd0000},
+  {NXV_HIGHEST-1,MEM_FREE,0x1000},
+ };
+ printf("regression release-wrap abi=%u earlier=00001000/2000f000 tail=20000000/00001000\n",QUERY_ABI_BITS);fflush(stdout);
+ for(unsigned i=0;i<sizeof(queries)/sizeof(*queries);i++){
+  MEMORY_BASIC_INFORMATION m=compare(queries[i].va,0);CHECK(m.State==queries[i].state && m.RegionSize==queries[i].size);
+  CHECK(m.BaseAddress==(PVOID)ROUND_DOWN((ULONG_PTR)queries[i].va,PAGE_SIZE));
+  if(m.State==MEM_RESERVE)CHECK(m.AllocationBase==(PVOID)0x1000 && m.AllocationProtect==PAGE_READWRITE && m.Protect==0 && m.Type==MEM_PRIVATE);
+  else CHECK(m.AllocationBase==NULL && m.AllocationProtect==0 && m.Protect==PAGE_NOACCESS && m.Type==0);
+ }
+ compare(NXV_HIGHEST,0);compare(NXV_HIGHEST+1,0);compare(UINT32_MAX,0);compare(0x20002000,1);
+ printf("regression release-wrap abi=%u passed\n",QUERY_ABI_BITS);
+}
+int main(int argc,char **argv){
+ int fast=argc>1 && !strcmp(argv[1],"fast");
+ const char *selected=argc>2?argv[2]:"all";
+ if(!strcmp(selected,"all") || !strcmp(selected,"tail-wrap"))tail_wrap();
+ if(!strcmp(selected,"all") || !strcmp(selected,"pde-wrap"))pde_wrap(fast);
+ if(!strcmp(selected,"all") || !strcmp(selected,"release-wrap"))release_wrap();
+ if(strcmp(selected,"all"))goto done;
+ scenario="main";
+ for(unsigned n=0;n<4;n++){
+  unsigned counts[]={0,1,16,256};unsigned count=counts[n];
+  for(unsigned adjacent=0;adjacent<2;adjacent++){
+   reset(count,0x10000000,0x10000,adjacent?0x10000:0x20000);
+   compare(0,0);compare(0xffff,0);compare(0x10000000-1,0);
+   for(unsigned i=0;i<count;i++){
+    ULONG_PTR b=regions[i].Base;
+    ULONG offsets[]={0,1,4095,4096,0xefff,0xffff,0x10000,0x11000,0x1ffff};
+    for(unsigned j=0;j<sizeof(offsets)/sizeof(*offsets);j++)compare(b+offsets[j],0);
+   }
+   MEMORY_BASIC_INFORMATION m=compare(0x70000000,0);CHECK(m.State==MEM_FREE && m.RegionSize==NXV_HIGHEST-0x70000000);
+   CHECK(base_work.nodes==count*2);if(fast){CHECK(candidate_work.nodes<=count);if(count && candidate_work.nodes==0)CHECK(candidate_work.tail==1);}
+   compare(NXV_HIGHEST-1,0);compare(NXV_HIGHEST,0);compare(UINT32_MAX,0);compare(0,1);
+  }
+ }
+ /* Sparse spans begin/end both inside PDEs and exactly on boundaries. */
+ const ULONG starts[]={0x20000000,0x20010000,0x203f0000};
+ const ULONG lengths[]={4096,0x10000,0x400000,0x401000,0xc03000};
+ for(unsigned a=0;a<3;a++)for(unsigned z=0;z<5;z++){
+  ULONG_PTR start=starts[a];ULONG length=lengths[z];reset(1,start,length,0);
+  MEMORY_BASIC_INFORMATION m=compare(start,0);CHECK(m.State==MEM_RESERVE && m.Protect==0 && m.RegionSize==length && m.AllocationBase==(PVOID)start && m.Type==MEM_PRIVATE);
+  if(fast && length>=0x400000)CHECK(candidate_work.pde<=6 && candidate_work.pte==0);
+  for(ULONG offset=0;offset<length;offset+=0x3f000)compare(start+offset+17,0);
+  compare(start+length-1,0);compare(start+length,0);
+ }
+ /* Mixed present page tables, software NOACCESS, cache flags and a missing PDE
+  * immediately before a present one; compare full bytes for every input page. */
+ reset(1,0x20000000,0x1001000,0);
+ const ULONG flags[]={1,3,0x800,1|8,3|16,0,1|16,3|8};
+ for(unsigned pattern=0;pattern<8;pattern++){
+  set_page(0x203ff000,flags[pattern]);set_page(0x20400000,flags[(pattern+1)%8]);
+  set_page(0x20800000,flags[(pattern+2)%8]);set_page(0x20fff000,flags[(pattern+3)%8]);
+  for(ULONG offset=0;offset<0x1001000;offset+=4096)compare(0x20000000+offset+19,0);
+ }
+ reset(256,0x30000000,0x10000,0x20000);compare(0x50000000,0);
+ printf("work free-after256 baseline_nodes=%u candidate_nodes=%u candidate_tail=%u\n",base_work.nodes,candidate_work.nodes,candidate_work.tail);
+ reset(1,0x20000000,0xc03000,0);compare(0x20000000,0);
+ printf("work sparse12MiB baseline_pde=%u candidate_pde=%u baseline_pte=%u candidate_pte=%u\n",base_work.pde,candidate_work.pde,base_work.pte,candidate_work.pte);
+ /* Present-but-empty tables cannot be treated as inaccessible; committed
+  * NOACCESS is a distinct state, and a query never crosses region boundaries. */
+ reset(2,0x7ffc0000,0x10000,0x10000);set_page(0x7ffc1000,0x800);
+ MEMORY_BASIC_INFORMATION m=compare(0x7ffc1001,0);CHECK(m.State==MEM_COMMIT && m.Protect==PAGE_NOACCESS && m.RegionSize==4096);
+ compare(0x7ffc0000,0);compare(0x7ffcf123,0);compare(0x7ffd0000,0);compare(0x7ffdffff,0);
+done:
+ printf("query actual-source differential: abi=%u cases=%u checks=%u fast=%d\n",QUERY_ABI_BITS,cases,checks,fast);return 0;
+}
