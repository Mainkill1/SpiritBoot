+ setup(2,0x3000);section(0,"INIT",0x1000,0x901,0xa00,IMAGE_SCN_MEM_DISCARDABLE);section(1,".rsrc",0x2000,0xac8,0xc00,IMAGE_SCN_MEM_DISCARDABLE);expect(1,0x1000,0x3000);
+ setup(1,0x2000);section(0,"INIT",0x1000,1,0,IMAGE_SCN_MEM_DISCARDABLE);expect(1,0x1000,0x2000);
+ setup(1,0x2000);section(0,"INIT",0x1000,0,0,IMAGE_SCN_MEM_DISCARDABLE);expect(0,0,0);
+ setup(2,0x3000);section(0,"INIT",0x1000,1,0,IMAGE_SCN_MEM_DISCARDABLE);section(1,".data",0x2000,1,0,0);expect(1,0x1000,0x2000);
+ setup(3,0x4000);section(0,"INIT",0x1000,1,0,IMAGE_SCN_MEM_DISCARDABLE);section(1,".data",0x2000,1,0,0);section(2,".rsrc",0x3000,1,0,IMAGE_SCN_MEM_DISCARDABLE);expect(2,0x1000,0x2000);assert(starts[1]==0x84003000u&&ends[1]==0x84004000u);
+ setup(1,0x3000);section(0,"INIT",0x1000,0x1001,0x1800,IMAGE_SCN_MEM_DISCARDABLE);expect(1,0x1000,0x3000);
+ setup(1,0x2000);section(0,"INIT",0x1000,0x3000,0,IMAGE_SCN_MEM_DISCARDABLE);expect(1,0x1000,0x2000);
+ setup(1,0x2000);section(0,"INIT",0x1000,1,0,IMAGE_SCN_MEM_DISCARDABLE);module.Flags=LDRP_MM_LOADED;expect(0,0,0);
+ setup(1,0x2000);section(0,"INIT",0x1000,1,0,IMAGE_SCN_MEM_DISCARDABLE);no_header=1;expect(0,0,0);
+ setup(1,0x2000);module.DllBase=(PVOID)(ALIGN_DOWN_BY((ULONG_PTR)&MiFindInitializationCode,4096)-4096);section(0,"INIT",0x1000,1,0,IMAGE_SCN_MEM_DISCARDABLE);
+ PVOID a=NULL,b=NULL;MiFindInitializationCode(&a,&b);assert(!freed&&phase==0&&a==(char *)module.DllBase+0x1000&&b==(char *)module.DllBase+0x2000);++checks;
+ printf("production discardable-section walker: %u/%u cases PASS\n",checks,checks);return 0;
+}
