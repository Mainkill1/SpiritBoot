+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise the production boot section walker with owned PE/layout fixtures."""
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve(); out.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location('extract', root/'tests/host/kernel-performance/check.py')
+extract = importlib.util.module_from_spec(spec); spec.loader.exec_module(extract)
+body = extract.function((root/'ntoskrnl/mm/ARM3/sysldr.c').read_text(), 'MiFindInitializationCode')
+(out/'actual.inc').write_text(body)
+subprocess.run(['cc','-std=c11','-O2','-Wall','-Wextra','-Werror','-I'+str(out),str(Path(__file__).with_name('fixture.c')),'-o',str(out/'discardable')],check=True)
+subprocess.run([str(out/'discardable')],check=True)
