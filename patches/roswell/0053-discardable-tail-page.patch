+#define FALSE 0
+#define PAGE_SIZE 4096u
+#define IMAGE_SCN_MEM_DISCARDABLE 0x02000000u
+#define LDRP_MM_LOADED 1u
+#define ASSERT assert
+#define max(a,b) ((a)>(b)?(a):(b))
+#define ALIGN_UP_BY(x,a) (((x)+(a)-1)&~(ULONG_PTR)((a)-1))
+#define ALIGN_DOWN_BY(x,a) ((x)&~(ULONG_PTR)((a)-1))
+#define DBG_UNREFERENCED_LOCAL_VARIABLE(x) (void)(x)
+#define MI_IS_PHYSICAL_ADDRESS(x) 0
+#define DPRINT(...) ((void)0)
+#define WrVirtualMemory 0
+#define KernelMode 0
+#define MUTANT_INCREMENT 0
+typedef struct LINK {struct LINK *Flink,*Blink;} LIST_ENTRY,*PLIST_ENTRY;
+typedef struct {char Name[8];union {ULONG VirtualSize;} Misc;ULONG VirtualAddress,SizeOfRawData,Characteristics;} IMAGE_SECTION_HEADER,*PIMAGE_SECTION_HEADER;
+typedef struct {struct {ULONG NumberOfSections;} FileHeader;struct {ULONG SectionAlignment;} OptionalHeader;IMAGE_SECTION_HEADER sections[8];} IMAGE_NT_HEADERS,*PIMAGE_NT_HEADERS;
+typedef struct {LIST_ENTRY InLoadOrderLinks;PVOID DllBase;ULONG Flags,SizeOfImage;int BaseDllName;} LDR_DATA_TABLE_ENTRY,*PLDR_DATA_TABLE_ENTRY;
+#define IMAGE_FIRST_SECTION(h) ((h)->sections)
+#define CONTAINING_RECORD(p,t,f) ((t *)((char *)(p)-offsetof(t,f)))
+static LIST_ENTRY PsLoadedModuleList;
+static LDR_DATA_TABLE_ENTRY module;
+static IMAGE_NT_HEADERS header;
+static int MmSystemLoadLock,PsLoadedModuleResource,phase,no_header;
+static ULONG_PTR starts[8],ends[8];static unsigned freed,checks;
+static void KeEnterCriticalRegion(void){assert(phase==0);phase=1;}
+static void KeWaitForSingleObject(int *l,int r,int m,int a,void *t){(void)l;(void)r;(void)m;(void)a;(void)t;assert(phase==1);phase=2;}
+static void ExAcquireResourceExclusiveLite(int *l,int w){(void)l;(void)w;assert(phase==2);phase=3;}
+static void ExReleaseResourceLite(int *l){(void)l;assert(phase==3);phase=2;}
+static void KeReleaseMutant(int *l,int i,int a,int b){(void)l;(void)i;(void)a;(void)b;assert(phase==2);phase=1;}
+static void KeLeaveCriticalRegion(void){assert(phase==1);phase=0;}
+static PIMAGE_NT_HEADERS RtlImageNtHeader(PVOID p){assert(p==module.DllBase);return no_header?NULL:&header;}
+static void MiFreeInitializationCode(PVOID a,PVOID b){assert(phase==3&&freed<8);starts[freed]=(ULONG_PTR)a;ends[freed++]=(ULONG_PTR)b;}
+#include "actual.inc"
+static void setup(unsigned n,ULONG size){
+ memset(&header,0,sizeof(header));memset(&module,0,sizeof(module));
+ header.FileHeader.NumberOfSections=n;header.OptionalHeader.SectionAlignment=4096;
+ module.DllBase=(PVOID)0x84000000u;module.SizeOfImage=size;
+ module.InLoadOrderLinks.Flink=&PsLoadedModuleList;PsLoadedModuleList.Flink=&module.InLoadOrderLinks;
+ freed=0;phase=0;no_header=0;
+}
+static void section(unsigned i,const char *name,ULONG rva,ULONG vs,ULONG raw,ULONG flags){
+ IMAGE_SECTION_HEADER *s=&header.sections[i];memcpy(s->Name,name,strlen(name));
+ s->VirtualAddress=rva;s->Misc.VirtualSize=vs;s->SizeOfRawData=raw;s->Characteristics=flags;
+}
+static void expect(unsigned count,ULONG first,ULONG end){
+ PVOID a=NULL,b=NULL;MiFindInitializationCode(&a,&b);assert(phase==0);
+ if(freed!=count||(count&&(starts[0]!=(ULONG_PTR)module.DllBase+first||ends[0]!=(ULONG_PTR)module.DllBase+end))){
+  fprintf(stderr,"discard check %u: ranges=%u expected=%u first=%lx end=%lx\n",checks,freed,count,(unsigned long)(freed?starts[0]:0),(unsigned long)(freed?ends[0]:0));exit(1);
+ }
+ assert(a==NULL);for(unsigned i=0;i<freed;++i){assert(!(starts[i]&4095)&&!(ends[i]&4095));assert(ends[i]<=(ULONG_PTR)module.DllBase+module.SizeOfImage);}
+ ++checks;
+}
