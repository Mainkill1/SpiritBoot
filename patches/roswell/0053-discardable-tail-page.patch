+    def test_partial_final_discardable_page_counts_toward_reset_budget(self):
+        # With 453 whole pages the workspace exactly fills the handoff.
+        # One byte in another mapped discardable page must exceed that budget.
+        raw = fixture()
+        sh = 0x178 + 2 * 40
+        raw[sh:sh+8] = b'INIT\0\0\0\0'
+        struct.pack_into('<I', raw, sh+8, 453 * 4096 + 1)
+        struct.pack_into('<I', raw, sh+36, 0x02000000)
+        struct.pack_into('<I', raw, 0xd0, (3 + 454) * 4096)
+        with self.assertRaisesRegex(ValueError, 'warm.*capacity'):
+            self.pack(raw)
+
