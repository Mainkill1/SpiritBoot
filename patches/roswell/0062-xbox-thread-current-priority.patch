diff --git a/ntoskrnl/xb/ordinals.map b/ntoskrnl/xb/ordinals.map
index 0ae18a5ccf4809b97fdd7ce63b8cb07e5f731e37..105b214519c47f0231e04fb0cca89a928f430a9f 100644
--- a/ntoskrnl/xb/ordinals.map
+++ b/ntoskrnl/xb/ordinals.map
@@ -193,7 +193,7 @@
 145  KeSetEvent
 146  KeSetEventBoostPriority
 147  KeSetPriorityProcess            # sets the field + the calling thread; others stay put
-148  KeSetPriorityThread
+148  XeKeSetPriorityThread           # resolve public thread shadow before native setter
 149  KeSetTimer                       # native KDPC/KTIMER; direct
