+PFN_NUMBER
+NTAPI
+NxkPageSupplyTakeTitleAny(ULONG Color)
+{
+#if XBOX_RESERVE_UPPER_RAM
+    PFN_NUMBER Pfn;
+    UNREFERENCED_PARAMETER(Color);
+    MI_ASSERT_PFN_LOCK_HELD();
+    if (NxpTitleGenericAvail == 0) return 0;
+    Pfn = NxpSpillHint < NXP_GENERIC_FLOOR_PFN ?
+              NXP_GENERIC_FLOOR_PFN : NxpSpillHint;
+    for (; Pfn < (NXK_KSEG0_RAM_SIZE >> PAGE_SHIFT); Pfn++)
+    {
+        if (!(NxpLinks[Pfn] & NXP_FREE)) continue;
+        NxpUnlink(Pfn);
+        NxpSpillHint = Pfn;
+        return Pfn;
+    }
+    return 0;
+#else
+    return NxkPageSupplyTakeAny(Color);
+#endif
+}
+
+PFN_NUMBER
+NTAPI
+NxkPageSupplyTakeTitleZero(ULONG Color)
+{
+    PFN_NUMBER Pfn = NxkPageSupplyTakeTitleAny(Color);
+    if (Pfn != 0)
+    {
+        PVOID Alias = NxkTryGetVerifiedWbDirectAlias(Pfn);
+        if (Alias != NULL)
+            KeZeroPages(Alias, PAGE_SIZE);
+        else
+            MiZeroPhysicalPage(Pfn);
+    }
+    return Pfn;
+}
+
+PFN_NUMBER
+NTAPI
+NxkPageSupplyTitleAvailable(VOID)
+{
+#if XBOX_RESERVE_UPPER_RAM
+    return NxpTitleAvail;
+#else
+    return MmAvailablePages;
+#endif
+}
