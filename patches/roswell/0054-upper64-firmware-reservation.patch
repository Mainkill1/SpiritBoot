+static void NxpUnmapRelocationPages(void) {}
+/* Substitute only the existing privileged copy/PTE/TLB backend. The
+ * maintained candidate search, capacity preflight, domain selection,
+ * owner transitions and free-list accounting execute without rewriting. */
