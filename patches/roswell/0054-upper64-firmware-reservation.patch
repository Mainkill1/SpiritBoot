+'''
+body = "".join(function(vm, name) for name in
+               ("NxvEnsurePageTable", "NxvFreePageAtPte", "NxvCommitRange"))
+main = r'''
+static void reset(void) {
+    static ULONG storage[0x8000 + 0x4000];
+    memset(storage,0,sizeof(storage));
+    memset((void*)0xc0000000,0,0x400000);
+    MmAvailablePages=0; NxpFreeHeadKernel=NxpFreeHeadTitle=0; NxpGenericAvail=0;
+    NxvCommitted=0;
