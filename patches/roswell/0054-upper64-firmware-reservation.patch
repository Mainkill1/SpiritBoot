+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check the real CMake contract with the production cross toolchain installed."""
+from pathlib import Path
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+base = ["cmake", "-G", "Ninja", "-S", str(root),
+        f"-DCMAKE_TOOLCHAIN_FILE={root / 'toolchain-gcc.cmake'}",
+        "-DCMAKE_BUILD_TYPE=Release", "-DDBG=0", "-DKDBG=FALSE"]
+backends = ("NXK_MM_PHYS", "NXK_MM_POOL", "NXK_MM_POOLPAGES", "NXK_MM_VM")
+for name in backends:
+    result = subprocess.run(base + ["-B", str(out / name), "-DXBOX_RAM_MIB=128",
+        "-DXBOX_RESERVE_UPPER_RAM=ON"] +
+        [f"-D{option}={'OFF' if option == name else 'ON'}" for option in backends],
+        capture_output=True, text=True)
+    (out / (name + ".log")).write_text(result.stdout + result.stderr)
+    assert result.returncode != 0 and "requires" in result.stderr, name
+for name, ram, profile, success in (("supported",128,"ON",True),
+                                   ("wrong-capacity",64,"ON",False),
+                                   ("default-fallback",128,"OFF",True)):
+    flags = ["-DNXK_MM_VM=OFF"] if name == "default-fallback" else []
+    result = subprocess.run(base + ["-B", str(out / name), f"-DXBOX_RAM_MIB={ram}",
+        f"-DXBOX_RESERVE_UPPER_RAM={profile}"] + flags, capture_output=True, text=True)
+    (out / (name + ".log")).write_text(result.stdout + result.stderr)
+    assert (result.returncode == 0) == success, name
+print("upper-ram-reservation: real CMake required-backend/capacity contract PASS")
