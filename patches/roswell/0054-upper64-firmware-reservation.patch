+page_macros = pool[pool.index("#ifdef NXK_MM_POOLPAGES"):pool.index("/* SIZE CLASSES")]
+functions = []
+for name in ("InitializePool", "NxpAllocFailed", "NxpAllocatePoolWithTag",
+             "ExAllocatePoolWithTag", "NxTitleAllocatePoolWithTag", "NxTitleAllocatePool", "ExAllocatePool",
