+def function(text, name):
+    # Match the declaration line, so API names mentioned in comments cannot
+    # accidentally pull includes or another function into the native fixture.
+    hit = re.search(r"(?m)^" + name + r"\s*\([^;]*?\)\s*\{", text)
+    assert hit, name
+    start = text.rfind("\n\n", 0, hit.start()) + 2
+    brace = text.index("{", hit.start())
+    depth, end = 1, brace + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end] + "\n"
+supply = (root / "ntoskrnl/xb/mm/pagesupply.c").read_text()
+vm = (root / "ntoskrnl/xb/mm/vm.c").read_text()
