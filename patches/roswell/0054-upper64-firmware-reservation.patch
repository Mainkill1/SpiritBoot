+    require(stats.TotalPhysicalPages==32768 && stats.AvailablePages==1,
+            "public statistics report actual128 total and lower-only available");
+    NxSysVaReady=1;NXPP_PDE((PVOID)NXK_SYSMEM_BASE)=0x07000003;
+    PVOID system=MmAllocateSystemMemory(4096,4);
+    require(system&&is_low(system),"public system-memory data stays low");
+    MmFreeSystemMemory(system,4096);
+    pool_reset();NxkPageSupplyReturn(0x20);NxkPageSupplyReturn(0x4001);
+    for(ULONG va=NXK_SYSMEM_BASE;va<NXK_SYSMEM_LIMIT;va+=PAGE_SIZE) {
+        NXPP_PDE((PVOID)(ULONG_PTR)va)=1;NXPP_PTE((PVOID)(ULONG_PTR)va)=1;
+    }
+    system=MmAllocateSystemMemory(4096,4);
+    require(system&&is_low(system),"aperture-exhausted public system fallback stays low");
+    MmFreeSystemMemory(system,4096);
+    puts("upper-ram-reservation: public actual128 statistics and system/fallback low backing PASS");
+}
+'''
+source = out / "pool.c"
+def ordinal_wrapper(name):
+    emitted = function(xbe, name)
+    return emitted[emitted.index("PVOID NTAPI\n" + name):]
+
+pool_compilation = (shim + core + pool_shim + pages[pages.index("#define NXPP_BASE"):]
+                  + page_macros + definitions + "ULONG NxpReclaimEmptyBucketPages(void);\n"
+                  + "".join(functions)
+                  + ordinal_wrapper("XeExAllocatePool")
+                  + ordinal_wrapper("XeExAllocatePoolWithTag")
+                  + function(xbe,"XeAllocTls")
+                  + (root / "ntoskrnl/xb/mm/sysva.c").read_text().split("static KSPIN_LOCK NxSysVaLock;")[1].join(["static KSPIN_LOCK NxSysVaLock;", ""])
+                  + function((root / "ntoskrnl/xb/mm/api.c").read_text(), "MmAllocateSystemMemory")
+                  + function((root / "ntoskrnl/xb/mm/api.c").read_text(), "MmFreeSystemMemory")
+                  + function((root / "ntoskrnl/xb/mm/api.c").read_text(), "NxMmCreateKernelStack")
+                  + function((root / "ntoskrnl/xb/mm/api.c").read_text(), "NxMmDeleteKernelStack")
+                  + (root / "ntoskrnl/xb/mm/api.c").read_text().split("typedef struct _MM_STATISTICS")[1].split("extern PFN_COUNT")[0].join(["typedef struct _MM_STATISTICS", ""])
+                  + function((root / "ntoskrnl/xb/mm/api.c").read_text(), "MmQueryStatistics"))
+source.write_text(pool_compilation + pool_main)
+exe = out / "pool"
+subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function",
+                "-Wno-multichar", str(source), "-o", str(exe)], check=True)
+subprocess.run([str(exe)], check=True)
+
+# The OFF profile must retain the existing 64/128 supply policy and shared
+# buckets. Compile the same maintained bodies with the feature disabled.
+default_main = pool_main.split("int main(void)")[0] + r'''
+int main(void) {
+    require(mmap((void*)0xc0000000,0x400000,PROT_READ|PROT_WRITE,
+        MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0)==(void*)0xc0000000,"self-map fixture");
+    require(mmap((void*)0xc1000000,0x1000000,PROT_READ|PROT_WRITE,
+        MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0)==(void*)0xc1000000,"pool fixture");
+    pool_reset();NxkPageSupplyReturn(0x20);
+    require(NxkPageSupplyTakeAny(0)==0x20,"default128 private allocator retains low spill");
+    pool_reset();NxkPageSupplyReturn(0x20);NxkPageSupplyReturn(0x4001);
+    PVOID p=ExAllocatePoolWithTag(NonPagedPool,64,123);
+    require(p&&!is_low(p),"default128 keeps preferred upper backing");
+    ExFreePoolWithTag(p,123);
+    PVOID title=XeExAllocatePoolWithTag(64,456);
+    require(title==p&&!is_low(title),"default128 public/private buckets remain shared");
+    ExFreePoolWithTag(title,456);
+    require(NxpReclaimEmptyBucketPages()==1,"default128 retains one shared bucket");
+    MM_STATISTICS stats={.Length=sizeof(stats)};
+    require(MmQueryStatistics(&stats)==STATUS_SUCCESS&&stats.AvailablePages==2,
+            "default128 public available remains global");
+    pool_reset();fixtureRetail=TRUE;
+    NxkPageSupplyInitialize(0x3fff,NxpLinks);
+    NxkPageSupplyReturn(0x20);NxkPageSupplyReturn(0x3401);
+    require(NxkPageSupplyTakeAny(0)==0x3401,"default64 retains high-zone preference");
+    require(NxkPageSupplyTakeAny(0)==0x20,"default64 retains low spill");
+    puts("upper-ram-reservation: feature-OFF default64/default128 supply, pools, statistics PASS");
+}
+'''
+source=out / "defaults.c"
+source.write_text(pool_compilation.replace("#define XBOX_RESERVE_UPPER_RAM 1",
+                                          "#define XBOX_RESERVE_UPPER_RAM 0") + default_main)
+exe=out / "defaults"
+subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function",
+                "-Wno-multichar", str(source), "-o", str(exe)], check=True)
+subprocess.run([str(exe)], check=True)
