+#define FALSE 0
+#define PAGE_SIZE 4096u
+#define PAGE_SHIFT 12
+#define NXK_KSEG0_RAM_SIZE 0x04000000u
+#define NXK_HIGH_ZONE_BASE 0x03400000u
+#define NXK_HIGH_ZONE_LIMIT 0x03c00000u
+#define XBOX_RESERVE_UPPER_RAM 1
+#define NXK_MM_PHYS 1
+#define ASSERT assert
+#define MI_ASSERT_PFN_LOCK_HELD() ((void)0)
+#define UNREFERENCED_PARAMETER(x) ((void)(x))
+#define RtlZeroMemory(p,n) memset(p,0,n)
+static PFN_NUMBER MmAvailablePages;
+static BOOLEAN fixtureRetail;
+static BOOLEAN NxkMmRetailShapedMap(void) { return fixtureRetail; }
+static BOOLEAN NxkMmPersistentPage(PFN_NUMBER p) { (void)p; return FALSE; }
+static PVOID NxkTryGetVerifiedWbDirectAlias(PFN_NUMBER p) { (void)p; return NULL; }
+static void KeZeroPages(PVOID p, SIZE_T n) { memset(p,0,n); }
+static void MiZeroPhysicalPage(PFN_NUMBER p) { assert(p>0); }
+static KIRQL MiAcquirePfnLock(void) { return 0; }
+static void MiReleasePfnLock(KIRQL i) { (void)i; }
+static void KeInvalidateTlbEntry(PVOID p) { (void)p; }
+'''
+core += function(supply, "NxkPageSupplyReturn")
+core += function(supply, "NxkPageSupplySetOwner")
+adapter = r'''
+#define MC_SYSTEM 0
+static PFN_NUMBER MmAllocPage(int c) { (void)c; return NxkPageSupplyTakeZero(0); }
+static void MmDereferencePage(PFN_NUMBER p) { NxkPageSupplyReturn(p); }
+#define NXV_PDE(Va) (((PULONG)0xC0300000)[(ULONG_PTR)(Va)>>22])
+#define NXV_PTE(Va) (((PULONG)0xC0000000)[(ULONG_PTR)(Va)>>12])
+#define NXV_PTE_P 1u
