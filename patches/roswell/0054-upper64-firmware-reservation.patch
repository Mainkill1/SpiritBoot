+'''
+relocation_functions = ""
+for name in ("NxkPageSupplyTakeAnyOutside", "NxpRelocationCapacity", "NxkPageSupplyTakeRunRelocate"):
+    if re.search(r"(?m)^"+name+r"\s*\([^;]*?\)\s*\{", supply):
+        relocation_functions += function(supply, name)
+relocation_main = r'''
+static void require(int ok,const char *m) { if(!ok){fprintf(stderr,"FAIL: %s\n",m);exit(1);} }
+static void reset(void) {
+    static ULONG storage[0xc000];memset(storage,0,sizeof(storage));
+    memset((void*)0xc0000000,0,0x400000);
+    MmAvailablePages=0;NxpFreeHeadKernel=NxpFreeHeadTitle=0;NxpGenericAvail=0;
+    NxkPageSupplyInitialize(0x7fff,storage);
+    NXV_PTE(0x10000)=0x00020003;
+    NxkPageSupplySetOwner(0x20,(ULONG_PTR)&NXV_PTE(0x10000));
+    memset(frames[0x20],0x5a,PAGE_SIZE);
+}
+int main(void) {
+    require(mmap((void*)0xc0000000,0x400000,PROT_READ|PROT_WRITE,
+            MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0)==(void*)0xc0000000,"self-map fixture");
+    reset();NxkPageSupplyReturn(0x4001);
+    require(NxkPageSupplyTakeRunRelocate(1,0x20,0x20,1)==0,
+            "low relocation preflight must not count only-high free capacity");
+    require(NXV_PTE(0x10000)==0x00020003&&MmAvailablePages==1,
+            "failed domain relocation leaves owner mapping/free count intact");
+    reset();NxkPageSupplyReturn(0x21);NxkPageSupplyReturn(0x4001);
+    require(NxkPageSupplyTakeRunRelocate(1,0x20,0x20,1)==0x20,"low relocation with low capacity succeeds");
+    require((NXV_PTE(0x10000)>>12)==0x21,"low title data relocates only to another low frame");
+    require(memcmp(frames[0x20],frames[0x21],PAGE_SIZE)==0,"relocation backend preserves contents");
+    require(NxkPageSupplyGetOwner(0x21)==(ULONG_PTR)&NXV_PTE(0x10000),"destination retains PTE ownership");
+    require(NxkPageSupplyGetOwner(0x20)==0,"claimed source is no longer movable");
+    require(NxkPageSupplyTakeAny(0)==0x4001,"relocation leaves private high capacity untouched");
+    puts("upper-ram-reservation: maintained relocation preflight, low destination, owners/canaries PASS");
+}
+'''
+source = out / "relocation.c"
+source.write_text(shim + core + adapter + relocation_shim
+                  + function(supply,"NxkPageSupplyGetOwner") + relocation_functions + relocation_main)
+exe = out / "relocation"
+subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function",
+                "-Wno-unused-variable", "-Wno-unused-but-set-variable", str(source), "-o", str(exe)], check=True)
+subprocess.run([str(exe)], check=True)
+
+# Compile the maintained pool page layer, bucket allocator and actual title
+# ordinal wrappers together. Native mappings stand in for the CPU's page walk;
+# production PTE/PFN metadata still controls every allocation and free.
+pages = (root / "ntoskrnl/xb/mm/poolpages.c").read_text()
+pool = (root / "ntoskrnl/xb/mm/pool.c").read_text()
+xbe = (root / "ntoskrnl/xb/xbe.c").read_text()
+pool_shim = r'''
