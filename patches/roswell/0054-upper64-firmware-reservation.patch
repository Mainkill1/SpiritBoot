+}
+static void require(int ok,const char *message) {
+    if(!ok) {fprintf(stderr,"FAIL: %s\n",message);exit(1);}
+}
+int main(void) {
+    void *map=mmap((void*)0xc0000000,0x400000,PROT_READ|PROT_WRITE,
+                   MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED_NOREPLACE,-1,0);
+    require(map==(void*)0xc0000000,"native fixture self-map reservation");
+    reset(); NxkPageSupplyReturn(0x20);
+    require(NxkPageSupplyTakeAny(0)==0,"private exhaustion must not steal a free low title page");
+    reset(); NxkPageSupplyReturn(0x20); NxkPageSupplyReturn(0x4001);
+    require(NxvCommitRange(0x10000,0x11000,3,TRUE)==STATUS_SUCCESS,"title commit succeeds on low RAM");
+    require((NXV_PTE(0x10000)>>12)==0x20,"title VM commit must select low RAM while high RAM is free");
+    reset(); NxkPageSupplyReturn(0x4001);
