+/* Break: a retained pending read pays two avoidable release/reacquire
+ * round trips even though neither window calls an external operation. */
+static int retained_submit_avoids_empty_lock_roundtrips(void)
+{
+    PDEVICE_OBJECT device=make_device(2);parent_fixture read;
+    init_parent(&read,IRP_MJ_READ,512);lower_pending=1;lower_calls=0;
+    unsigned before=__atomic_load_n(&spin_acquires,__ATOMIC_RELAXED);
+    CHECK(NxNativeDispatchReadWrite(device,&read.irp)==STATUS_PENDING);
+    unsigned used=__atomic_load_n(&spin_acquires,__ATOMIC_RELAXED)-before;
+    CHECK(complete_child(STATUS_SUCCESS,512,1)==STATUS_MORE_PROCESSING_REQUIRED);
+    CHECK(read.irp.host_completed&&read.irp.IoStatus.Status==STATUS_SUCCESS);
+    lower_pending=0;
+    printf("retained pending submit: %u adapter lock entries\n",used);
+    CHECK(used<=14);
+    return 1;
+}
+static pnp_thread reservation_removal;
+static pthread_t reservation_removal_id;
+static unsigned reservation_wait_seen;
+static void mark_reservation_wait(PKEVENT event)
+{
+    (void)event;
+    __atomic_store_n(&reservation_wait_seen,1,__ATOMIC_RELEASE);
+}
+static void remove_reserved_device(void)
+{
+    MUST(!spin_depth);
+    init_pnp(&reservation_removal,NxNativeDispatchPnp,created_device,IRP_MN_REMOVE_DEVICE);
+    __atomic_store_n(&reservation_wait_seen,0,__ATOMIC_RELAXED);
+    before_event_wait=mark_reservation_wait;
+    MUST(!pthread_create(&reservation_removal_id,NULL,run_pnp,&reservation_removal));
+    while(!__atomic_load_n(&reservation_wait_seen,__ATOMIC_ACQUIRE)&&
+          !__atomic_load_n(&reservation_removal.returned,__ATOMIC_ACQUIRE))sched_yield();
+}
+/* Break: reservation/publication leaves a window in which removal observes
+ * idle and unbinds, yet the outer call still accepts an unprotected parent. */
+static int seal_after_reservation_keeps_accepted_parent_live(void)
+{
+    PDEVICE_OBJECT device=make_device(2);parent_fixture read,late;
+    init_parent(&read,IRP_MJ_READ,512);lower_pending=1;lower_calls=0;
+    after_unlock=remove_reserved_device;unlock_countdown=1;
+    NTSTATUS status=NxNativeDispatchReadWrite(device,&read.irp);
+    CHECK(!after_unlock);
+    /* Both linearizations are valid. Acceptance requires removal to wait;
+     * removal that already returned requires rejection without lower I/O. */
+    if(status==STATUS_PENDING) {
+        CHECK(__atomic_load_n(&reservation_wait_seen,__ATOMIC_ACQUIRE));
+        CHECK(!__atomic_load_n(&reservation_removal.returned,__ATOMIC_ACQUIRE));
+        CHECK(!read.irp.host_completed&&lower_calls==1);
+        CHECK(complete_child(STATUS_SUCCESS,512,1)==STATUS_MORE_PROCESSING_REQUIRED);
+        CHECK(read.irp.host_completed&&read.irp.IoStatus.Status==STATUS_SUCCESS);
+    } else CHECK(status<0&&read.irp.host_completed&&lower_calls==0);
+    CHECK(!pthread_join(reservation_removal_id,NULL));before_event_wait=NULL;
+    CHECK(reservation_removal.returned&&reservation_removal.status==STATUS_SUCCESS);
+    init_parent(&late,IRP_MJ_READ,512);unsigned calls=lower_calls;
+    CHECK(NxNativeDispatchReadWrite(device,&late.irp)<0&&late.irp.host_completed&&lower_calls==calls);
+    lower_pending=0;return 1;
+}
