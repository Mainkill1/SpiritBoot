index 00000000..d78f7ccb
--- /dev/null
+++ b/tests/host/kernel-performance/pins-state.c
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Independent whole-request multiplicity oracle versus the production API.
+ * Pin itself is unchanged; compare its ordered execution with the new
+ * transactional caller, including every free-list link and owner entry. */
+#define main work_counts_main
+#include "pins.c"
+#undef main
+
+static PFN_NUMBER mapped[4096];
+static unsigned multiplicity[32768];
+typedef struct {
+    UCHAR bytes[sizeof(metadata)];
+    ULONG kernel, title, available, generic, spill;
+} STATE;
+static STATE initial, expected, actual;
+static void save(STATE *s)
+{
+    memcpy(s->bytes,metadata,sizeof(metadata));
+    s->kernel=NxpFreeHeadKernel;s->title=NxpFreeHeadTitle;
+    s->available=MmAvailablePages;s->generic=NxpGenericAvail;s->spill=NxpSpillHint;
+}
+static void restore(const STATE *s)
+{
+    memcpy(metadata,s->bytes,sizeof(metadata));
+    NxpFreeHeadKernel=s->kernel;NxpFreeHeadTitle=s->title;
+    MmAvailablePages=s->available;NxpGenericAvail=s->generic;NxpSpillHint=s->spill;
+}
+static void reference(unsigned n,BOOLEAN unlock)
+{
+    memset(multiplicity,0,sizeof(multiplicity));
+    for(unsigned i=0;i<n;++i) {
+        PFN_NUMBER p=mapped[i];
+        if(i==invalid_at||!NxkPageSupplyCanPin(p,unlock))return;
+        ++multiplicity[p];
+        if(unlock&&!(NxpPins[p]&NXP_PIN_OVERFLOW)&&
+           multiplicity[p]>(NxpPins[p]&NXP_PIN_LIMIT))return;
+    }
+    for(unsigned i=0;i<n;++i)NxkPageSupplyPin(mapped[i],unlock);
+}
+static void run_case(unsigned n,unsigned shape,unsigned scenario,BOOLEAN unlock)
+{
+    init(n,0);memset(multiplicity,0,sizeof(multiplicity));
+    for(unsigned i=0;i<n;++i) {
+        static const PFN_NUMBER mixed[]={4,16,16384,17,16,16384};
+        mapped[i]=shape==0?16+i:shape==1?16:shape==2?(i%3==1?17:16):
+                  shape==3?mixed[i%6]:16+n-i;
+        ++multiplicity[mapped[i]];
+    }
+    for(unsigned p=1;p<32768;++p)if(multiplicity[p]) {
+        NxpLinks[p]=0x100+p; /* stable owner must survive non-deferred paths */
+        NxpPins[p]=unlock?multiplicity[p]:0;
+        if(scenario==1||scenario==2||scenario==6) {
+            NxpPins[p]|=NXP_RETURN_PENDING;NxpLinks[p]=0;
+        }
+        if(scenario==6&&(p&1))NxpPins[p]|=NXP_PIN_OVERFLOW;
+        if(scenario==8)NxpPins[p]=NXP_PIN_LIMIT-1;
+    }
+    if(n) {
+        if(scenario==2)--NxpPins[mapped[n-1]];
+        if(scenario==3)invalid_at=n/2;
+        if(scenario==4)invalid_at=n-1;
+        if(scenario==5)mapped[n-1]=32768;
+        if(scenario==7){NxpPins[mapped[n-1]]=0;NxkPageSupplyReturn(mapped[n-1]);}
+    }
+    mapping=mapped;save(&initial);reference(n,unlock);save(&expected);
+    restore(&initial);
+    MmLockUnlockBufferPages((PVOID)0x1000,n*PAGE_SIZE,unlock);save(&actual);
+    if(memcmp(&expected,&actual,sizeof(actual))) {
+        fprintf(stderr,"state mismatch n=%u shape=%u scenario=%u unlock=%u\n",n,shape,scenario,unlock);exit(1);
+    }
+    CHECK(cleared==0&&clears==0);
+}
+int main(void)
+{
+    unsigned sizes[]={0,1,2,3,63,64,65,128,4096};
+    unsigned cases=0;
+    for(unsigned s=0;s<sizeof(sizes)/sizeof(*sizes);++s)
+        for(unsigned shape=0;shape<5;++shape)
+            for(unsigned scenario=0;scenario<9;++scenario)
+                for(unsigned unlock=0;unlock<2;++unlock) {
+                    run_case(sizes[s],shape,scenario,unlock);++cases;
+                }
+    /* Explicit last-alias order: B is released before A, hence A is head. */
+    run_case(3,2,1,TRUE);
+    CHECK(NxpFreeHeadTitle==16&&NXP_NEXT(NxpLinks[16])==17);
+    CHECK(MmAvailablePages==2&&NxpGenericAvail==2);
+    puts("pending A,B,A release retains B-then-A insertion: PASS");
+    printf("production pin state differential: %u/%u cases passed\n",cases,cases);
+    return 0;
+}
