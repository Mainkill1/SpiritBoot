+/* Ordinary requests have no cache-result consumer. Avoid constructing and
+ * copying their unused completion record. A callback/internal consumer still
+ * receives an explicit unstarted result so stale request storage cannot be
+ * mistaken for a current writer. */
+static inline int
+NxAtapiCacheCaptureResult(PATA_DEVICE_REQUEST request, int required)
+{
+    if (!required)
+        return 0;
+    NxAtapiCacheStoreResult(request, NxAtapiCacheRawResult(request));
+    return request->NxCacheResult.Started != 0;
+}
