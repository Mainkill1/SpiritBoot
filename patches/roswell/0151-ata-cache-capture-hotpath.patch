index 00000000..aee4448d
--- /dev/null
+++ b/tests/host/atapi-cache-hotpath/check.py
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import subprocess
+import sys
+
+source = Path(sys.argv[1]).resolve()
+out = Path(sys.argv[2]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+c = source / "tests/host/atapi-cache-hotpath/cache_hotpath_test.c"
+for name, flags in (
+    ("plain", ["-O2"]),
+    ("sanitized", ["-O1", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"]),
+):
+    exe = out / name
+    subprocess.run([
+        "cc", "-std=c11", "-Wall", "-Wextra", "-Werror", *flags,
+        "-I", str(source / "drivers/storage/class/nxstorage"),
+        str(c), "-o", str(exe),
+    ], check=True)
+    subprocess.run([str(exe)], check=True)
