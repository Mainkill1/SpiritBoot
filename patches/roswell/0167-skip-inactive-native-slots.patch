index 0000000..59caf2d
--- /dev/null
+++ b/drivers/storage/class/nxstorage/active_scan.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NX_STORAGE_ACTIVE_SCAN_H
+#define NX_STORAGE_ACTIVE_SCAN_H
+#include <stdint.h>
+
+static inline uint32_t nx_active_at_or_after(const uint32_t bits[2],uint32_t start)
+{
+    uint32_t tail;
+    if(start<32) {
+        tail=bits[0]&(UINT32_MAX<<start);
+        if(tail)return (uint32_t)__builtin_ctz(tail);
+        tail=bits[1];
+    } else tail=bits[1]&(UINT32_MAX<<(start-32));
+    return tail ? 32u+(uint32_t)__builtin_ctz(tail):UINT32_MAX;
+}
+
+/* Called under the core state lock, with 1 <= count <= 64, cursor < count,
+ * remaining <= count, and no set bits outside [0,count). Skip only inactive
+ * slots. Cursor/remaining match an ordinary circular scan exactly, including
+ * the final inactive suffix when no active entry remains in this pass. */
+static inline uint32_t nx_active_scan_next(const uint32_t bits[2],uint32_t count,
+    uint32_t *cursor,uint32_t *remaining)
+{
+    uint32_t index,distance;
+    if(!*remaining)return UINT32_MAX;
+    index=nx_active_at_or_after(bits,*cursor);
+    if(index==UINT32_MAX)index=nx_active_at_or_after(bits,0);
+    if(index!=UINT32_MAX) {
+        distance=index>=*cursor ? index-*cursor:count-*cursor+index;
+        if(distance<*remaining) {
+            *remaining-=distance+1;
+            *cursor=index+1==count ? 0:index+1;
+            return index;
+        }
+    }
+    index=*cursor+*remaining;
+    *cursor=index>=count ? index-count:index;
+    *remaining=0;
+    return UINT32_MAX;
+}
+#endif
