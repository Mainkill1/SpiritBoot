diff --git a/tests/host/nxstorage/active_scan_test.c b/tests/host/nxstorage/active_scan_test.c
new file mode 100644
index 0000000..6212ab4
--- /dev/null
+++ b/tests/host/nxstorage/active_scan_test.c
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "request.h"
+#include "active_scan.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define MUST(x) do { if(!(x)) { fprintf(stderr,"%s:%u: %s\n",__func__,__LINE__,#x); abort(); } } while(0)
+static uint32_t seed=0x672591a3u;
+static uint32_t random_word(void) {seed^=seed<<13;seed^=seed>>17;seed^=seed<<5;return seed;}
+static unsigned observations;
+/* Independent original scan: visit every slot, advancing even past inactive
+ * entries. The bitmap selector must produce identical active visits/cursors. */
+static uint32_t original_next(const unsigned active[64],uint32_t count,
+                              uint32_t *cursor,uint32_t *remaining)
+{
+    while(*remaining) {
+        uint32_t index=*cursor;
+        *cursor=index+1==count ? 0:index+1;
+        --*remaining;
+        if(active[index])return index;
+    }
+    return UINT32_MAX;
+}
+static void compare_scan(const unsigned active[64],uint32_t count,uint32_t start,
+                         const unsigned runnable[64])
+{
+    uint32_t bits[2]={0,0},old_cursor=start,new_cursor=start;
+    uint32_t old_left=count,new_left=count;
+    for(uint32_t i=0;i<count;++i)if(active[i])bits[i>>5]|=UINT32_C(1)<<(i&31);
+    for(;;) {
+        uint32_t old=original_next(active,count,&old_cursor,&old_left);
+        uint32_t next=nx_active_scan_next(bits,count,&new_cursor,&new_left);
+        MUST(old==next&&old_cursor==new_cursor&&old_left==new_left);
+        ++observations;
+        /* Stop at the first action, as the real pump does. Inflight/blocked
+         * slots remain active but need not produce any action this pass. */
+        if(old==UINT32_MAX || runnable[old])break;
+    }
+}
+static void differential_scans(void)
+{
+    unsigned active[64],runnable[64];
+    for(unsigned count=1;count<=8;++count)for(unsigned mask=0;mask<(1u<<count);++mask)
+        for(unsigned cursor=0;cursor<count;++cursor) {
+            for(unsigned i=0;i<count;++i){active[i]=(mask>>i)&1;runnable[i]=0;}
+            compare_scan(active,count,cursor,runnable);
+            for(unsigned chosen=0;chosen<count;++chosen) {
+                runnable[chosen]=1;compare_scan(active,count,cursor,runnable);runnable[chosen]=0;
+            }
+        }
+    for(unsigned count=1;count<=64;++count)for(unsigned trial=0;trial<2000;++trial) {
+        for(unsigned i=0;i<count;++i) {
+            unsigned state=random_word();active[i]=(state&3)==0;
+            runnable[i]=active[i]&&((state>>2)&1);
+        }
+        compare_scan(active,count,random_word()%count,runnable);
+        memset(runnable,0,sizeof(runnable));
+        compare_scan(active,count,random_word()%count,runnable);
+    }
+    /* Every boundary bit alone, at every starting cursor, including wrap. */
+    for(unsigned bit=0;bit<64;++bit)for(unsigned cursor=0;cursor<64;++cursor) {
+        memset(active,0,sizeof(active));memset(runnable,0,sizeof(runnable));
+        active[bit]=1;compare_scan(active,64,cursor,runnable);
+        runnable[bit]=1;compare_scan(active,64,cursor,runnable);
+    }
+}
+struct parent {unsigned completed;};
+struct transport {
+    nx_device device;
+    nx_slot slots[129];
+    nx_command commands[129];
+    unsigned live[129],locked,submits,retires,completes;
+};
+static void enter(void *p){struct transport *t=p;MUST(!t->locked);t->locked=1;}
+static void leave(void *p){struct transport *t=p;MUST(t->locked);t->locked=0;}
+static nx_status prepare(void *p,const nx_command *c){struct transport *t=p;MUST(!t->locked&&!t->live[c->token.slot]);t->commands[c->token.slot]=*c;t->live[c->token.slot]=1;return NX_OK;}
+static int submit(void *p,const nx_command *c){struct transport *t=p;MUST(!t->locked&&t->live[c->token.slot]);++t->submits;return 1;}
+static void retire(void *p,const nx_command *c){struct transport *t=p;MUST(!t->locked&&t->live[c->token.slot]);t->live[c->token.slot]=0;++t->retires;}
+static void cancel(void *p,const nx_command *c){(void)p;(void)c;abort();}
+static void pending(void *p,void *r){struct transport *t=p;(void)r;MUST(t->locked);}
+static void complete(void *p,void *r,nx_status status,uint64_t bytes){struct transport *t=p;struct parent *parent=r;MUST(!t->locked&&!parent->completed&&status==NX_OK&&bytes==512);parent->completed=1;++t->completes;}
+/* Break: bits at/above 32 are lost, a freed slot remains visible, or the
+ * non-bitmap >64-slot fallback cannot drain/reuse every admitted request. */
+static void lifecycle_boundaries(void)
+{
+    static const unsigned counts[]={1,31,32,33,63,64,65,129};
+    for(unsigned test=0;test<sizeof(counts)/sizeof(counts[0]);++test) {
+        struct transport t;memset(&t,0,sizeof(t));
+        struct parent parents[129];nx_handle handles[129];
+        nx_config config={512,4096,65536,17,0,128,1024*1024,0,NX_CACHE_ENABLED};
+        nx_port port={&t,enter,leave,prepare,submit,retire,cancel,pending,complete};
+        unsigned count=counts[test];
+        MUST(nx_device_init(&t.device,&config,&port,t.slots,count,sizeof(t.slots))==NX_OK);
+        for(unsigned round=0;round<8;++round) {
+            memset(parents,0,sizeof(parents));
+            for(unsigned i=0;i<count;++i) {
+                nx_request request={.parent=&parents[i],.operation=NX_READ,.offset=(int64_t)i*512,
+                    .bytes=512,.mdl_virtual=4096,.mdl_bytes=512,.mdl_present=1};
+                MUST(nx_start(&t.device,&request,&handles[i])==NX_PENDING);
+            }
+            for(unsigned left=count;left;--left) {
+                unsigned pick=random_word()%count;
+                while(!t.live[pick])pick=(pick+1)%count;
+                nx_command command=t.commands[pick];
+                nx_lower_done(&t.device,command.token,NX_OK,512,0);
+                MUST(!t.live[pick]);
+                /* A duplicate/stale completion must not recreate an active bit. */
+                nx_lower_done(&t.device,command.token,NX_OK,512,0);
+            }
+            for(unsigned i=0;i<count;++i)MUST(parents[i].completed==1);
+            MUST(t.submits==(round+1)*count&&t.retires==t.submits&&t.completes==t.submits);
+        }
+    }
+}
+int main(void){differential_scans();lifecycle_boundaries();printf("active scan: %u differential observations; 8 lifecycle capacities passed\n",observations);return 0;}
