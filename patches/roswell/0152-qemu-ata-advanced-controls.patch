index dda0e178..16ced520 100644
--- a/drivers/storage/ide/pciidex/pata.h
+++ b/drivers/storage/ide/pciidex/pata.h
@@ -31,6 +31,42 @@
 /** Delay of 400ns */
 #define ATA_IO_WAIT()           KeStallExecutionProcessor(1)
 
+#if defined(SARCH_XBOX)
+#define NXK_EXPERIMENT_ATA_FORCE_SAFE 0x00000004UL
+#define NXK_EXPERIMENT_ATA_FORCE_ALL  0x00000008UL
+extern ULONG NxkExperimentalFlags;
+extern volatile ULONG NxkQemuAtaDiskTargets;
+
+FORCEINLINE
+VOID
+PataDeviceSelectWait(
+    _In_ PCHANNEL_DATA_PATA ChanData,
+    _In_ ULONG DeviceNumber)
+{
+    if ((NxkExperimentalFlags & NXK_EXPERIMENT_ATA_FORCE_SAFE) ||
+        !NxkQemuAtaDiskTargets ||
+        (!(NxkExperimentalFlags & NXK_EXPERIMENT_ATA_FORCE_ALL) &&
+         !(NxkQemuAtaDiskTargets & (1u << DeviceNumber))))
+    {
+        ATA_IO_WAIT();
+        return;
+    }
+
+    /*
+     * QEMU completes legacy port reads synchronously, so these reads are a
+     * command-ordering barrier rather than elapsed time. Auto mode admits this
+     * path only for an IDENTIFY-proven QEMU ATA disk. ATAPI remains on the
+     * delay unless the advanced all-device experiment is selected.
+     */
+    (void)READ_PORT_UCHAR(ChanData->Regs.Control);
+    (void)READ_PORT_UCHAR(ChanData->Regs.Control);
+    (void)READ_PORT_UCHAR(ChanData->Regs.Control);
+    (void)READ_PORT_UCHAR(ChanData->Regs.Control);
+}
+#else
+#define PataDeviceSelectWait(ChanData, DeviceNumber) ATA_IO_WAIT()
+#endif
+
 #define NUM_TO_BITMAP(num)     (0xFFFFFFFF >> (RTL_BITS_OF(ULONG) - (num)))
 
 /** Supported transfer modes by SATA devices */
@@ -293,7 +329,7 @@ ATA_SELECT_DEVICE(
 #endif
 
     ATA_WRITE(ChanData->Regs.Device, DeviceSelect, ChanData, MRES_TF);
-    ATA_IO_WAIT();
+    PataDeviceSelectWait(ChanData, DeviceNumber);
 }
 
 FORCEINLINE
