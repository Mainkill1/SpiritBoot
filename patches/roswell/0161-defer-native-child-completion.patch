+static VOID NTAPI NxNativeCompletionDpc(PKDPC dpc,PVOID context,PVOID argument1,PVOID argument2)
+{
+    NX_NATIVE_ENVELOPE *envelope=context;
+    NX_NATIVE_ADAPTER *adapter=envelope->adapter;
+    nx_packet_result result;
+    nx_packet_status captured=NX_PACKET_OK;
+    unsigned report=0,control=0;
+    (void)dpc;(void)argument1;(void)argument2;
+    port_enter(adapter);
+    if(envelope->result_deferred) {
+        result=envelope->deferred_result;captured=envelope->deferred_capture;
+        control=envelope->deferred_control;envelope->result_deferred=0;
+        envelope->deferred_control=0;report=1;
+    }
+    port_leave(adapter);
+    if(!report) return;
+    if(control) (void)handle_control_result(envelope,&result,captured);
+    else report_result(envelope,&result,captured);
+}
