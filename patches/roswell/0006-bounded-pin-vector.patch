diff --git a/ntoskrnl/xb/mm/api.c b/ntoskrnl/xb/mm/api.c
index 42fb73611c71f0373b83e3ced1e758509776af65..103b40c3f7945020dcb38a4918803bea72c27b95 100644
--- a/ntoskrnl/xb/mm/api.c
+++ b/ntoskrnl/xb/mm/api.c
@@ -77,7 +77,8 @@ MmLockUnlockBufferPages(PVOID Base, SIZE_T Size, BOOLEAN Unlock)
 {
 #ifdef NXK_MM_PHYS
     ULONG_PTR first = (ULONG_PTR)Base & ~(PAGE_SIZE - 1), last, va;
-    ULONG_PTR translated = 0;
+    ULONG_PTR translated = 0, i;
+    PFN_NUMBER pages[NXK_PIN_BATCH_SMALL_PAGES];
     BOOLEAN applied = FALSE, sparse;
     KIRQL irql;
     if (Size == 0 || Size - 1 > MAXULONG_PTR - (ULONG_PTR)Base) return;
@@ -90,17 +91,28 @@ MmLockUnlockBufferPages(PVOID Base, SIZE_T Size, BOOLEAN Unlock)
         ULONG_PTR pa;
         if (!NxMmIsAddressValid((PVOID)va)) goto out;
         pa = NxMmGetPhysicalAddress((PVOID)va);
+        if (translated < NXK_PIN_BATCH_SMALL_PAGES)
+            pages[translated] = pa >> PAGE_SHIFT;
         /* Include the RecordPin that increments scratch and then rejects. */
         ++translated;
         if (!NxkPageSupplyRecordPin(pa >> PAGE_SHIFT, Unlock)) goto out;
         if (va == last) break;
     }
     sparse = translated <= NXK_PIN_BATCH_SMALL_PAGES;
-    for (va = first;; va += PAGE_SIZE) {
-        PFN_NUMBER page = NxMmGetPhysicalAddress((PVOID)va) >> PAGE_SHIFT;
-        NxkPageSupplyPin(page, Unlock);
-        if (sparse) NxkPageSupplyClearPinBatchPage(page);
-        if (va == last) break;
+    if (sparse) {
+        /* The PFN lock keeps these preflight translations stable. Keep
+         * duplicate PFNs: every alias contributes one pin transition. */
+        for (i = 0; i < translated; ++i) {
+            NxkPageSupplyPin(pages[i], Unlock);
+            NxkPageSupplyClearPinBatchPage(pages[i]);
+        }
+    } else {
+        /* Preserve whole-request preflight for oversized requests. */
+        for (va = first;; va += PAGE_SIZE) {
+            NxkPageSupplyPin(
+                NxMmGetPhysicalAddress((PVOID)va) >> PAGE_SHIFT, Unlock);
+            if (va == last) break;
+        }
     }
     applied = TRUE;
 out:
@@ -108,11 +120,10 @@ out:
         NxkPageSupplyBeginPinBatch(); /* One bulk reset, only at exit. */
     else if (!applied)
     {
-        /* Rejected small prefixes cost at most the bounded page budget of
-         * extra translations. The PFN lock still stabilizes the mappings. */
-        for (va = first; translated != 0; va += PAGE_SIZE, --translated)
-            NxkPageSupplyClearPinBatchPage(
-                NxMmGetPhysicalAddress((PVOID)va) >> PAGE_SHIFT);
+        /* Include an increment-then-reject PFN, but not an invalid VA
+         * that never reached RecordPin. No cleanup translation is needed. */
+        for (i = 0; i < translated; ++i)
+            NxkPageSupplyClearPinBatchPage(pages[i]);
     }
 #if DBG && defined(NXK_PIN_BATCH_DIAGNOSTICS)
     NxkPageSupplyAssertPinBatchEmpty();
