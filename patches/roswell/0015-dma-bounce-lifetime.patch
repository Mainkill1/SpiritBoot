@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Run production scatter/gather and paging I/O with relocation fault injection.
+
+Only the external NT object/device/allocator boundary is modeled. The actual
+request/MDL lifetime and pool-movability adapter are compiled without edits.
+"""
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+sys.dont_write_bytecode = True
+spec = importlib.util.spec_from_file_location('extract', root / 'tests/host/kernel-performance/check.py')
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+scatter = (root / 'ntoskrnl/xb/scattergather.c').read_text()
+scatter = '\n'.join(line for line in scatter.splitlines() if not line.startswith('#include'))
+movable = extract.function((root / 'ntoskrnl/xb/mm/poolpages.c').read_text(), 'NxPoolPagesSetMovable')
+paging = extract.function((root / 'ntoskrnl/xb/mm/cache.c').read_text(), 'NxcPagingIo')
+source = (Path(__file__).with_name('fixture.c').read_text()
+          .replace('/* PRODUCTION_MOVABLE */', movable)
+          .replace('/* PRODUCTION_SCATTER */', scatter)
+          .replace('/* PRODUCTION_PAGING */', paging))
+(out / 'dma.c').write_text(source)
+subprocess.run(['cc', '-D_GNU_SOURCE', '-std=c11', '-O2', '-Wall', '-Wextra',
+                '-Werror', '-Wno-multichar', str(out / 'dma.c'), '-o', str(out / 'dma')], check=True)
+subprocess.run([str(out / 'dma')], check=True)
