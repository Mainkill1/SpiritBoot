diff --git a/drivers/filesystems/vfatfs/fat.c b/drivers/filesystems/vfatfs/fat.c
index de041f6c..4cbf3bc5 100644
--- a/drivers/filesystems/vfatfs/fat.c
+++ b/drivers/filesystems/vfatfs/fat.c
@@ -38,6 +38,18 @@ FAT32EntryMask(
     return DeviceExt->FatInfo.FatType == FATX32 ? 0xffffffff : 0x0fffffff;
 }
 
+/* FATX32 volumes in the field use both the full-width FATX end markers and
+ * the conventional FAT32 28-bit markers.  Keep full-width data-cluster values
+ * intact while accepting either terminal encoding. */
+static
+BOOLEAN
+FAT32IsEndOfChain(
+    ULONG Entry)
+{
+    return (Entry >= 0x0ffffff8 && Entry <= 0x0fffffff) ||
+           Entry >= 0xfffffff8;
+}
+
 static
 BOOLEAN
 VfatIsValidDataCluster(
@@ -117,7 +129,7 @@ FAT32GetNextCluster(
     _SEH2_END;
 
     CurrentCluster = (*(PULONG)((char*)BaseAddress + (FATOffset % ChunkSize))) & EntryMask;
-    if (CurrentCluster >= EntryMask - 7)
+    if (FAT32IsEndOfChain(CurrentCluster))
         CurrentCluster = 0xffffffff;
 
     if (CurrentCluster == 0)
@@ -961,7 +973,10 @@ WalkFatChain(
                     CurrentCluster = *(PULONG)((char *)BaseAddress +
                                               FATOffset % ChunkSize);
                 CurrentCluster &= EntryMask;
-                if (CurrentCluster >= EntryMask - 7)
+                if ((EntrySize == sizeof(USHORT) &&
+                     CurrentCluster >= EntryMask - 7) ||
+                    (EntrySize == sizeof(ULONG) &&
+                     FAT32IsEndOfChain(CurrentCluster)))
                     CurrentCluster = 0xffffffff;
                 if (CurrentCluster == 0xffffffff)
                 {
@@ -1096,7 +1111,10 @@ GetContiguousClusterRun(
                     CurrentCluster = *(PULONG)((char *)BaseAddress +
                                               FATOffset % ChunkSize);
                 CurrentCluster &= EntryMask;
-                if (CurrentCluster >= EntryMask - 7)
+                if ((EntrySize == sizeof(USHORT) &&
+                     CurrentCluster >= EntryMask - 7) ||
+                    (EntrySize == sizeof(ULONG) &&
+                     FAT32IsEndOfChain(CurrentCluster)))
                     CurrentCluster = 0xffffffff;
                 if (CurrentCluster != 0xffffffff &&
                     !VfatIsValidDataCluster(DeviceExt, CurrentCluster))
