diff --git a/tests/host/cache/check-writeback-context.py b/tests/host/cache/check-writeback-context.py
new file mode 100644
index 00000000..750298bf
--- /dev/null
+++ b/tests/host/cache/check-writeback-context.py
@@ -0,0 +1,236 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise write-back reserve admission through the production cache bodies."""
+
+from pathlib import Path
+import importlib.util
+import subprocess
+import sys
+
+sys.dont_write_bytecode = True
+root = Path(__file__).resolve().parents[3]
+out = Path(sys.argv[1]).resolve()
+out.mkdir(parents=True, exist_ok=True)
+spec = importlib.util.spec_from_file_location(
+    "extract", root / "tests/host/kernel-performance/check.py")
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+source = (root / "ntoskrnl/xb/mm/cache.c").read_text()
+
+helpers = ""
+for name in ("NxcPushWritebackContext", "NxcPopWritebackContext",
+             "NxcOwnsWritebackContext"):
+    if name in source:
+        helpers += extract.function(source, name) + "\n"
+bodies = helpers + extract.function(source, "NxcFlushBlock") + "\n"
+bodies += extract.function(source, "NxcClaimSlot")
+
+legacy_state = "static ULONG NxcWbDepth;" if "NxcWbDepth" in bodies else ""
+
+shim = r'''
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef int32_t NTSTATUS;
+typedef unsigned ULONG;
+typedef int64_t LONGLONG;
+typedef size_t SIZE_T, *PSIZE_T;
+typedef int BOOLEAN;
+typedef void VOID;
+typedef void *PKTHREAD;
+#define IN
+#define OUT
+#define TRUE 1
+#define FALSE 0
+#define NT_SUCCESS(status) ((status) >= 0)
+#define STATUS_SUCCESS ((NTSTATUS)0)
+#define STATUS_DEVICE_DATA_ERROR ((NTSTATUS)0xc000009c)
+#define PAGE_SIZE 4
+#define NXC_BLOCK_SIZE 16
+#define NXC_MAX_BLOCKS 1
+#define NXC_WB_RESERVE 2
+#define NXC_TOTAL_BLOCKS (NXC_MAX_BLOCKS + NXC_WB_RESERVE)
+#define MAXLONGLONG INT64_MAX
+#define ROUND_UP(value, align) (((value) + (align) - 1) & ~((align) - 1))
+#define min(a, b) ((a) < (b) ? (a) : (b))
+#define ASSERT assert
+#define DECLSPEC_NOINLINE __attribute__((noinline))
+#define DPRINT1(...) ((void)0)
+#define CONTAINING_RECORD(p, t, f) ((t *)((char *)(p) - offsetof(t, f)))
+
+typedef struct { int64_t QuadPart; } LARGE_INTEGER;
+typedef struct _LIST_ENTRY {
+    struct _LIST_ENTRY *Flink;
+    struct _LIST_ENTRY *Blink;
+} LIST_ENTRY, *PLIST_ENTRY;
+typedef struct {
+    void *FileObject;
+    LARGE_INTEGER FileSize;
+    LARGE_INTEGER ValidDataLength;
+} NXC_MAP;
+typedef struct {
+    NXC_MAP *Map;
+    int64_t Offset;
+    unsigned char *Data;
+    LIST_ENTRY LruLink;
+    ULONG RefCount;
+    BOOLEAN Valid;
+    BOOLEAN Dirty;
+    BOOLEAN Busy;
+    BOOLEAN Reserved;
+} NXC_BLOCK;
+typedef struct _NXC_WB_CONTEXT {
+    PKTHREAD Thread;
+    struct _NXC_WB_CONTEXT *Next;
+} NXC_WB_CONTEXT;
+
+static NXC_BLOCK NxcBlocks[NXC_TOTAL_BLOCKS];
+static LIST_ENTRY NxcLruList;
+static int NxcMutex, held;
+static __attribute__((unused)) ULONG NxcActiveBlocks = NXC_MAX_BLOCKS;
+static ULONG CcDataFlushes, CcLazyWriteIos, CcLazyWritePages;
+static NXC_WB_CONTEXT *NxcWbContexts;
+LEGACY_STATE
+static int thread_a, thread_b;
+static PKTHREAD current_thread;
+static unsigned reserve_claims;
+
+static __attribute__((unused)) PKTHREAD KeGetCurrentThread(void)
+{
+    return current_thread;
+}
+static NTSTATUS NxcPagingIo(void *file, void *buffer, LONGLONG offset,
+                           ULONG length, BOOLEAN write,
+                           SIZE_T *transferred);
+static void ExReleaseFastMutex(int *mutex)
+{
+    (void)mutex;
+    assert(held);
+    held = 0;
+}
+static void ExAcquireFastMutex(int *mutex)
+{
+    (void)mutex;
+    assert(!held);
+    held = 1;
+}
+static void RemoveEntryList(LIST_ENTRY *entry)
+{
+    entry->Blink->Flink = entry->Flink;
+    entry->Flink->Blink = entry->Blink;
+}
+static NXC_BLOCK *NxcClaimReserve(void)
+{
+    for (unsigned i = NXC_MAX_BLOCKS; i < NXC_TOTAL_BLOCKS; ++i) {
+        if (NxcBlocks[i].Data && !NxcBlocks[i].Map) {
+            NxcBlocks[i].RefCount = 1;
+            ++reserve_claims;
+            return &NxcBlocks[i];
+        }
+    }
+    return NULL;
+}
+static void NxcShortWait(void) { assert(!"unexpected wait"); }
+static void ExRaiseStatus(NTSTATUS status)
+{
+    (void)status;
+    assert(!"unexpected write-back failure");
+}
+'''.replace("LEGACY_STATE", legacy_state)
+
+cases = r'''
+static unsigned char bytes[NXC_TOTAL_BLOCKS][NXC_BLOCK_SIZE];
+static NXC_MAP map;
+
+static void test_concurrent_contexts(void)
+{
+    NXC_WB_CONTEXT context_a, context_b;
+
+    current_thread = &thread_a;
+    NxcPushWritebackContext(&context_a);
+    current_thread = &thread_b;
+    NxcPushWritebackContext(&context_b);
+
+    current_thread = &thread_a;
+    assert(NxcOwnsWritebackContext());
+    NxcPopWritebackContext(&context_a);
+    assert(!NxcOwnsWritebackContext());
+
+    current_thread = &thread_b;
+    assert(NxcOwnsWritebackContext());
+    NxcPopWritebackContext(&context_b);
+    assert(!NxcOwnsWritebackContext() && NxcWbContexts == NULL);
+}
+
+static NTSTATUS NxcPagingIo(void *file, void *buffer, LONGLONG offset,
+                           ULONG length, BOOLEAN write, SIZE_T *transferred)
+{
+    NXC_BLOCK *block;
+
+    (void)file;
+    (void)buffer;
+    (void)offset;
+    assert(write && !held && current_thread == &thread_a);
+
+    held = 1;
+    current_thread = &thread_b;
+    block = NxcClaimSlot(FALSE);
+    assert(block == NULL);
+
+    current_thread = &thread_a;
+    block = NxcClaimSlot(FALSE);
+    assert(block == &NxcBlocks[NXC_MAX_BLOCKS]);
+    assert(reserve_claims == 1);
+    block->RefCount = 0;
+    block->Map = NULL;
+    held = 0;
+
+    *transferred = length;
+    return STATUS_SUCCESS;
+}
+
+int main(void)
+{
+    SIZE_T written = 0;
+    NTSTATUS status;
+
+    memset(&map, 0, sizeof(map));
+    memset(NxcBlocks, 0, sizeof(NxcBlocks));
+    map.FileObject = &map;
+    map.FileSize.QuadPart = NXC_BLOCK_SIZE;
+    NxcLruList.Flink = NxcLruList.Blink = &NxcLruList;
+    test_concurrent_contexts();
+
+    for (unsigned i = 0; i < NXC_TOTAL_BLOCKS; ++i)
+        NxcBlocks[i].Data = bytes[i];
+    NxcBlocks[0].Map = &map;
+    NxcBlocks[0].Data = bytes[0];
+    NxcBlocks[0].RefCount = 1;
+    NxcBlocks[0].Valid = TRUE;
+    NxcBlocks[0].Dirty = TRUE;
+    NxcBlocks[0].Busy = TRUE;
+    NxcBlocks[1].Reserved = NxcBlocks[2].Reserved = TRUE;
+
+    held = 1;
+    current_thread = &thread_a;
+    status = NxcFlushBlock(&NxcBlocks[0], &written);
+    assert(status == STATUS_SUCCESS && written == NXC_BLOCK_SIZE);
+    assert(!NxcBlocks[0].Dirty && !NxcBlocks[0].Busy);
+    assert(held && NxcWbContexts == NULL);
+    puts("cache write-back reserve: owner admitted, unrelated thread denied PASS");
+    return 0;
+}
+'''
+
+fixture = out / "writeback-context.c"
+fixture.write_text(shim + bodies + cases)
+binary = out / "writeback-context"
+subprocess.run([
+    "cc", "-std=c11", "-O1", "-g", "-Wall", "-Wextra", "-Werror",
+    "-fsanitize=address,undefined", str(fixture), "-o", str(binary),
+], check=True)
+subprocess.run([str(binary)], check=True,
+               env={"ASAN_OPTIONS": "detect_leaks=0"})
