diff --git a/ntoskrnl/xb/threadview.c b/ntoskrnl/xb/threadview.c
new file mode 100644
index 00000000..2c155048
--- /dev/null
+++ b/ntoskrnl/xb/threadview.c
@@ -0,0 +1,372 @@
+/*
+ * Public thread-object view for the Xbox ABI. Native scheduling, wait lists,
+ * APC storage and object reference counts always belong to the native object.
+ * A registered public address is its identity, never a discriminator byte in
+ * caller memory. The registry lives until final object deletion, not thread
+ * termination or handle closure, and owns no reference of its own.
+ */
+#include <ntoskrnl.h>
+
+#define VIEW_BUCKETS 32
+static LIST_ENTRY NxkThreadViews[VIEW_BUCKETS];
+/* Monotonic negative filter: a missing address residue cannot be a registered
+ * view. A present bit proves nothing and always requires exact membership.
+ * Leaving bits set on deletion is safe and avoids per-residue counters. */
+ULONG NxkThreadViewLowBits;
+/* One exact identity, populated only by registry membership and invalidated
+ * before unlinking. Cache hits do not follow any caller-controlled memory.
+ * A valid pointer caller already keeps the object alive; on this single CPU
+ * an aligned pointer load cannot tear across deletion or replacement. */
+PVOID volatile NxkThreadViewCachedPublic;
+
+/* Both address classes may be heavily aligned. Mix page and object bits. */
+static ULONG
+NxkViewBucket(ULONG_PTR Address)
+{
+    return ((Address >> 5) ^ (Address >> 10) ^ (Address >> 16)) &
+           (VIEW_BUCKETS - 1);
+}
+
+/* The Xbox is uniprocessor. Brief interrupt exclusion protects only this
+ * nonpaged exact-identity list; no object operation runs with interrupts off.
+ * It also permits initialization of the boot thread before ordinary IRQL
+ * services are ready. No title address is dereferenced during lookup. */
+static PKTHREAD
+NxkFindPublicThread(PVOID Pointer)
+{
+    ULONG_PTR Flags = __readeflags();
+    PLIST_ENTRY Head, Entry;
+    PKTHREAD Found = NULL;
+    PKTHREAD Current = KeGetCurrentThread();
+    if (Pointer == NULL) return NULL;
+    if (!(NxkThreadViewLowBits & (1UL << ((ULONG_PTR)Pointer & 31))))
+        return NULL;
+    if (Pointer == NxkThreadViewCachedPublic)
+        return (PKTHREAD)((ULONG_PTR)Pointer -
+                           FIELD_OFFSET(KTHREAD, XeXboxShadow));
+    if (Current != NULL && Pointer == (PVOID)Current->XeXboxShadow)
+        return Current;
+    Head = &NxkThreadViews[NxkViewBucket((ULONG_PTR)Pointer)];
+    /* A valid public pointer is registered before exposure and remains so
+     * while its caller holds a reference. An empty bucket cannot contain it.
+     * Avoid interrupt exclusion for this common non-thread-object miss. */
+    if (Head->Flink == NULL || Head->Flink == Head) return NULL;
+    _disable();
+    if (Head->Flink != NULL)
+    {
+        for (Entry = Head->Flink; Entry != Head; Entry = Entry->Flink)
+        {
+            PKTHREAD Thread = CONTAINING_RECORD(Entry, KTHREAD, XeThreadViewLink);
+            if ((PVOID)Thread->XeXboxShadow == Pointer)
+            {
+                Found = Thread;
+                NxkThreadViewCachedPublic = Pointer;
+                break;
+            }
+        }
+    }
+    __writeeflags(Flags);
+    return Found;
+}
+
+PVOID NxkThreadPublicPointer(PKTHREAD Thread)
+{
+    return Thread ? Thread->XeXboxShadow : NULL;
+}
+
+PKTHREAD NxkResolveThreadPointer(PVOID Pointer)
+{
+    PKTHREAD Thread;
+    if (Pointer != NULL && Pointer == (PVOID)KeGetCurrentThread())
+        return KeGetCurrentThread();
+    Thread = NxkFindPublicThread(Pointer);
+    if (Thread != NULL || Pointer == NULL) return Thread;
+    /* Compatibility with known native addresses still uses exact membership. */
+    Thread = NxkFindPublicThread((PVOID)((ULONG_PTR)Pointer +
+                                        FIELD_OFFSET(KTHREAD, XeXboxShadow)));
+    return Thread == (PKTHREAD)Pointer ? Thread : NULL;
+}
+
+PVOID NxkThreadNativeObject(PVOID Object)
+{
+    PKTHREAD Thread = NxkFindPublicThread(Object);
+    return Thread ? (PVOID)Thread : Object;
+}
+
+PVOID NxkThreadPublicObject(PVOID Object)
+{
+    PKTHREAD Thread;
+    if (Object == NULL) return NULL;
+    Thread = NxkFindPublicThread((PVOID)((ULONG_PTR)Object +
+                                        FIELD_OFFSET(KTHREAD, XeXboxShadow)));
+    return Thread == (PKTHREAD)Object ? Thread->XeXboxShadow : Object;
+}
+
+/* These offsets are the public nxdk ABI, qualified by standalone title tests.
+ * The complete allocation covers KTHREAD 0x110 and ETHREAD 0x140. */
+C_ASSERT(sizeof(((PKTHREAD)0)->XeXboxShadow) == 0x140);
+C_ASSERT(sizeof(KWAIT_BLOCK) == 0x18);
+
+static VOID
+NxkPublishThreadControls(PKTHREAD Thread)
+{
+    PUCHAR View = Thread->XeXboxShadow;
+    View[0x32] = (UCHAR)Thread->Priority;
+    View[0x70] = (UCHAR)Thread->BasePriority;
+    View[0x73] = (UCHAR)Thread->DisableBoost;
+    View[0x75] = (UCHAR)Thread->SuspendCount;
+}
+
+VOID
+NxkInitializeThreadView(PKTHREAD Thread, PKSTART_ROUTINE Start, PVOID Context)
+{
+    PUCHAR View = Thread->XeXboxShadow;
+    PLIST_ENTRY Head;
+    ULONG_PTR Flags;
+    RtlZeroMemory(View, sizeof(Thread->XeXboxShadow));
+    View[0] = ThreadObject;
+    View[2] = 0x110 / sizeof(ULONG);
+    InitializeListHead((PLIST_ENTRY)(View + 0x08)); /* dispatcher wait list */
+    InitializeListHead((PLIST_ENTRY)(View + 0x10)); /* mutant list */
+    InitializeListHead((PLIST_ENTRY)(View + 0x34)); /* kernel APC list */
+    InitializeListHead((PLIST_ENTRY)(View + 0x3c)); /* user APC list */
+    InitializeListHead((PLIST_ENTRY)(View + 0x5c)); /* wait list */
+    InitializeListHead((PLIST_ENTRY)(View + 0x7c)); /* queue list */
+    InitializeListHead((PLIST_ENTRY)(View + 0x104)); /* process thread list */
+    InitializeListHead((PLIST_ENTRY)(View + 0x124)); /* active timer list */
+    InitializeListHead((PLIST_ENTRY)(View + 0x134)); /* IRP list */
+    *(PVOID *)(View + 0x1c) = Thread->StackBase;
+    *(ULONG_PTR *)(View + 0x20) = Thread->StackLimit;
+    *(PVOID *)(View + 0x24) = Thread->KernelStack;
+    *(PVOID *)(View + 0x44) = NxkThreadProcessView(Thread);
+    View[0x4b] = TRUE;
+    *(PLONG)(View + 0x6c) = Thread->Quantum;
+    *(PHANDLE)(View + 0x12c) = ((PETHREAD)Thread)->Cid.UniqueThread;
+    NxkPublishThreadControls(Thread);
+    NxkInitializeTitleThreadFields(Thread, Start, Context);
+
+    /* Publish the identity only after every initial field has been written. */
+    Flags = __readeflags();
+    _disable();
+    Head = &NxkThreadViews[NxkViewBucket((ULONG_PTR)View)];
+    if (Head->Flink == NULL) InitializeListHead(Head);
+    InsertTailList(Head, &Thread->XeThreadViewLink);
+    NxkThreadViewLowBits |= 1UL << ((ULONG_PTR)View & 31);
+    __writeeflags(Flags);
+}
+
+VOID NxkDeleteThreadView(PKTHREAD Thread)
+{
+    ULONG_PTR Flags = __readeflags();
+    _disable();
+    if (NxkThreadViewCachedPublic == (PVOID)Thread->XeXboxShadow)
+        NxkThreadViewCachedPublic = NULL;
+    /* Failed allocation may reach deletion before KeInitThread succeeded. */
+    if (Thread->XeThreadViewLink.Flink != NULL)
+    {
+        RemoveEntryList(&Thread->XeThreadViewLink);
+        Thread->XeThreadViewLink.Flink = NULL;
+        Thread->XeThreadViewLink.Blink = NULL;
+    }
+    __writeeflags(Flags);
+}
+
+VOID NxkPublishThreadCreateTime(PETHREAD Thread)
+{
+    *(PLARGE_INTEGER)(Thread->Tcb.XeXboxShadow + 0x110) = Thread->CreateTime;
+}
+
+VOID NxkPublishThreadNotification(PETHREAD Thread, BOOLEAN Create)
+{
+    PUCHAR View = Thread->Tcb.XeXboxShadow;
+    NxkPublishThreadControls(&Thread->Tcb);
+    if (Create)
+    {
+        *(PHANDLE)(View + 0x12c) = Thread->Cid.UniqueThread;
+    }
+    else
+    {
+        /* Complex exposes termination before notify, but retains the ID and
+         * old exit status during the callback. Final status precedes signal. */
+        View[0x77] = TRUE;
+    }
+}
+
+VOID NxkPublishThreadTermination(PETHREAD Thread)
+{
+    PUCHAR View = Thread->Tcb.XeXboxShadow;
+    *(PLARGE_INTEGER)(View + 0x118) = Thread->ExitTime;
+    *(PNTSTATUS)(View + 0x120) = Thread->ExitStatus;
+    *(PHANDLE)(View + 0x12c) = NULL;
+    View[0x77] = TRUE;
+    View[0x4b] = FALSE;
+    *(PLONG)(View + 4) = TRUE;
+}
+
+ULONG NTAPI XeKeSuspendThread(PVOID Pointer)
+{
+    PKTHREAD Thread = NxkResolveThreadPointer(Pointer);
+    ULONG Previous;
+    KIRQL OldIrql = KeRaiseIrqlToDpcLevel();
+    Previous = KeSuspendThread(Thread);
+    NxkPublishThreadControls(Thread);
+    KeLowerIrql(OldIrql);
+    return Previous;
+}
+
+ULONG NTAPI XeKeResumeThread(PVOID Pointer)
+{
+    PKTHREAD Thread = NxkResolveThreadPointer(Pointer);
+    ULONG Previous;
+    KIRQL OldIrql = KeRaiseIrqlToDpcLevel();
+    Previous = KeResumeThread(Thread);
+    NxkPublishThreadControls(Thread);
+    KeLowerIrql(OldIrql);
+    return Previous;
+}
+
+ULONG NTAPI XeKeAlertResumeThread(PVOID Pointer)
+{
+    PKTHREAD Thread = NxkResolveThreadPointer(Pointer);
+    ULONG Previous;
+    KIRQL OldIrql = KeRaiseIrqlToDpcLevel();
+    Previous = KeAlertResumeThread(Thread);
+    NxkPublishThreadControls(Thread);
+    KeLowerIrql(OldIrql);
+    return Previous;
+}
+
+BOOLEAN NTAPI XeKeAlertThread(PVOID Pointer, KPROCESSOR_MODE Mode)
+{
+    return KeAlertThread(NxkResolveThreadPointer(Pointer), Mode);
+}
+
+VOID NTAPI XeKeBoostPriorityThread(PVOID Pointer, KPRIORITY Increment)
+{
+    PKTHREAD Thread = NxkResolveThreadPointer(Pointer);
+    KIRQL OldIrql = KeRaiseIrqlToDpcLevel();
+    KeBoostPriorityThread(Thread, Increment);
+    NxkPublishThreadControls(Thread);
+    KeLowerIrql(OldIrql);
