+VOID NTAPI XeKeSetEventBoostPriority(PKEVENT Event, PVOID *WaitingThread)
+{
+    PKTHREAD Native = NULL;
+    KIRQL OldIrql = KeRaiseIrqlToDpcLevel();
+    KeSetEventBoostPriority(Event, WaitingThread ? &Native : NULL);
+    /* Retain the caller's output when no WaitAny waiter was selected. */
+    if (Native != NULL) *WaitingThread = NxkThreadPublicPointer(Native);
+    KeLowerIrql(OldIrql);
+}
+
+NTSTATUS NTAPI
+XeKeWaitForSingleObject(PVOID Object, KWAIT_REASON Reason,
+                       KPROCESSOR_MODE Mode, BOOLEAN Alertable,
+                       PLARGE_INTEGER Timeout)
+{
+    return KeWaitForSingleObject(NxkThreadNativeObject(Object), Reason, Mode,
+                                 Alertable, Timeout);
+}
+
+NTSTATUS NTAPI
+XeKeWaitForMultipleObjects(ULONG Count, PVOID Object[], WAIT_TYPE Type,
+                          KWAIT_REASON Reason, KPROCESSOR_MODE Mode,
+                          BOOLEAN Alertable, PLARGE_INTEGER Timeout,
+                          PKWAIT_BLOCK WaitBlocks)
+{
+    ULONG Index, PublishCount;
+    NTSTATUS Status;
+    BOOLEAN Queued = FALSE;
+    /* Preserve native validation, including the caller-supplied-block limit. */
+    if (Count > MAXIMUM_WAIT_OBJECTS)
+        return KeWaitForMultipleObjects(Count, Object, Type, Reason, Mode,
+                                        Alertable, Timeout, WaitBlocks);
+    {
+        /* Bounded by 64 objects: at most 1792 bytes. Ordinary one/two-object
+         * calls reserve only their own blocks; NULL caller blocks need no
+         * backup. No pool allocation or extra scheduling boundary is added. */
+        PVOID Native[Count ? Count : 1];
+        KWAIT_BLOCK Saved[WaitBlocks && Count ? Count : 1];
+        for (Index = 0; Index < Count; ++Index)
+            Native[Index] = NxkThreadNativeObject(Object[Index]);
+        if (WaitBlocks != NULL)
+        {
+            RtlCopyMemory(Saved, WaitBlocks, Count * sizeof(*WaitBlocks));
+            /* Native queue insertion writes both links; KiUnlinkThread and
+             * RemoveEntryList leave the removed entry's links unchanged. */
+            for (Index = 0; Index < Count; ++Index)
+            {
+                WaitBlocks[Index].WaitListEntry.Flink = NULL;
+                WaitBlocks[Index].WaitListEntry.Blink = NULL;
+            }
+        }
+        /* Native wait remains the only owner of WaitNext, alert precedence,
+         * object consumption, dispatcher locking and scheduling. */
+        Status = NxkWaitForMultipleObjectsDeferredApc(Count, Native, Type, Reason, Mode,
+                                          Alertable, Timeout, WaitBlocks);
+        if (WaitBlocks == NULL)
+        {
+            if (Status == STATUS_USER_APC) KiDeliverUserApcs();
+            return Status;
+        }
+        for (Index = 0; Index < Count; ++Index)
+            if (WaitBlocks[Index].WaitListEntry.Flink != NULL ||
+                WaitBlocks[Index].WaitListEntry.Blink != NULL)
+                Queued = TRUE;
+
+        PublishCount = Count;
+        /* Public oracle: immediate WaitAny initializes the failed prefix,
+         * leaving the winning block and suffix untouched. WaitAll initializes
+         * all blocks, even on immediate success. A prior actual wait already
+         * published every block, so none can be restored in that case. */
+        if (!Queued && Type == WaitAny &&
+            Status >= STATUS_WAIT_0 && (ULONG)Status < Count)
+            PublishCount = (ULONG)Status;
+        else if (!Queued && Type == WaitAny &&
+                 Status >= STATUS_ABANDONED_WAIT_0 &&
+                 (ULONG)(Status - STATUS_ABANDONED_WAIT_0) < Count)
+            PublishCount = (ULONG)(Status - STATUS_ABANDONED_WAIT_0);
+
+        for (Index = 0; Index < Count; ++Index)
+        {
+            if (Index >= PublishCount)
+            {
+                WaitBlocks[Index] = Saved[Index];
+                continue;
+            }
+            if (!Queued)
+            {
+                WaitBlocks[Index].WaitListEntry = Saved[Index].WaitListEntry;
+                /* Before queueing, public failed/alerted/timed-out walks
+                 * retain the next element, including one past the last.
+                 * A fully satisfied WaitAll closes the circle instead. */
+                if (!(Type == WaitAll &&
+                      (Status == STATUS_WAIT_0 ||
+                       Status == STATUS_ABANDONED_WAIT_0)))
+                    WaitBlocks[Index].NextWaitBlock = &WaitBlocks[Index + 1];
+            }
+            WaitBlocks[Index].Thread = NxkThreadPublicPointer(KeGetCurrentThread());
+            WaitBlocks[Index].Object = NxkThreadPublicObject(WaitBlocks[Index].Object);
+            /* Public WaitType is a SHORT; native uses its upper byte as
+             * padding, which must not expose the caller's old sentinel. */
+            WaitBlocks[Index].SpareByte = 0;
+        }
+    }
+    /* Native wait has unlinked every dispatcher block and restored IRQL.
+     * Deliver exactly once with caller blocks repaired, still before return.
+     * A callback may reenter a wait without sharing adapter state. */
+    if (Status == STATUS_USER_APC) KiDeliverUserApcs();
+    return Status;
+}
