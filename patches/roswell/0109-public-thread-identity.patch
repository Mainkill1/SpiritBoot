+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+from pathlib import Path
+import subprocess
+import sys
+root=Path(__file__).resolve().parents[3]
+here=Path(sys.argv[1]).resolve()
+here.mkdir(parents=True,exist_ok=True)
+source=(root/'ntoskrnl/xb/threadview.c').read_text();body=source[source.index('NTSTATUS NTAPI\nXeKeWaitForMultipleObjects('):]
+native=(root/'ntoskrnl/ke/wait.c').read_text()
+# The two original multiwait delivery sites are gated, while all other wait
+# entries retain their own behavior. Actual entry wrappers are compiled below.
+implementation=native[native.index('static NTSTATUS\nNTAPI\nKiWaitForMultipleObjects('):native.index('/* Keep native callers')]
+assert implementation.count('if (DeliverUserApcs) KiDeliverXboxUserApcs(WaitStatus);')==2
+wrappers=native[native.index('NTSTATUS NTAPI\nKeWaitForMultipleObjects('):native.index('\nNTSTATUS\nNTAPI\nNtDelayExecution(')]
+pre=r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef void *PVOID;typedef unsigned ULONG;typedef int32_t NTSTATUS;typedef unsigned char BOOLEAN;
+typedef struct LIST_ENTRY {struct LIST_ENTRY *Flink,*Blink;} LIST_ENTRY;
+typedef struct BLOCK {LIST_ENTRY WaitListEntry;PVOID Thread,Object;struct BLOCK *NextWaitBlock;uint16_t WaitKey;unsigned char WaitType,SpareByte;} KWAIT_BLOCK,*PKWAIT_BLOCK;
+typedef int WAIT_TYPE,KWAIT_REASON,KPROCESSOR_MODE;typedef int64_t *PLARGE_INTEGER;
+#define NTAPI
+#define TRUE 1
+#define FALSE 0
+#define MAXIMUM_WAIT_OBJECTS 64
+#define STATUS_WAIT_0 0
+#define STATUS_ABANDONED_WAIT_0 0x80
+#define STATUS_USER_APC 0xc0
+#define WaitAll 0
+#define WaitAny 1
+#define RtlCopyMemory memcpy
+static PVOID Current=(PVOID)0x100000;
+static PVOID KeGetCurrentThread(void){return Current;}
+static PVOID NxkThreadPublicPointer(PVOID p){return (void *)((uintptr_t)p+0x1b4);}
+static PVOID NxkThreadNativeObject(PVOID p){return (void *)((uintptr_t)p-0x100);}
+static PVOID NxkThreadPublicObject(PVOID p){return (void *)((uintptr_t)p+0x100);}
+static unsigned calls,queue_it,expected_count,expected_type,expected_alert,wait_next;
+static int32_t outcome;
+static PKWAIT_BLOCK observed;static PVOID *observed_objects;static unsigned apc_calls;
+static void KiDeliverUserApcs(void){
+ apc_calls++;assert(outcome==STATUS_USER_APC);
+ if(observed)for(unsigned i=0;i<expected_count;i++)assert(observed[i].Thread==NxkThreadPublicPointer(Current)&&observed[i].Object==observed_objects[i]&&observed[i].SpareByte==0);
+}
+static int64_t *expected_timeout;
+static NTSTATUS KiWaitForMultipleObjects(ULONG n,PVOID *objects,WAIT_TYPE type,KWAIT_REASON reason,KPROCESSOR_MODE mode,BOOLEAN alert,PLARGE_INTEGER timeout,PKWAIT_BLOCK blocks,BOOLEAN DeliverUserApcs){
+ calls++;assert(n==expected_count&&type==(int)expected_type&&alert==expected_alert&&timeout==expected_timeout&&reason==6&&mode==0);
+ wait_next=0;
+ for(unsigned i=0;i<n;i++){
+  assert(objects[i]==(PVOID)(uintptr_t)(0x200000+i*0x400));
+  if(!blocks)continue;
+  blocks[i].Thread=Current;blocks[i].Object=objects[i];blocks[i].NextWaitBlock=&blocks[(i+1)%n];blocks[i].WaitKey=i;blocks[i].WaitType=type;
+  if(queue_it){blocks[i].WaitListEntry.Flink=(void *)0x700000;blocks[i].WaitListEntry.Blink=(void *)0x700004;}
+ }
+ if(DeliverUserApcs && outcome==STATUS_USER_APC)KiDeliverUserApcs();
+ return outcome;
+}
+'''
+pre += '\n#define SARCH_XBOX 1\n' + wrappers
+post=r'''
+int main(void){
+ unsigned checks=0;const unsigned sizes[]={1,2,3,64};
+ for(unsigned z=0;z<4;z++)for(unsigned type=0;type<2;type++)for(unsigned queue=0;queue<2;queue++)for(unsigned alert=0;alert<2;alert++)for(unsigned next=0;next<2;next++){
+  unsigned n=sizes[z];
+  for(unsigned result=0;result<2*n+3;result++){
+   struct {uint32_t a[4];KWAIT_BLOCK b[64];uint32_t c[4];} state,old;
+   PVOID objects[64];for(unsigned i=0;i<n;i++)objects[i]=(PVOID)(uintptr_t)(0x200100+i*0x400);
+   memset(&state,0xa5,sizeof(state));old=state;
+   int64_t timeout=0;outcome=result<n?(int32_t)result:result<2*n?(int32_t)(0x80+result-n):result==2*n?0x102:result==2*n+1?0x101:0xc0;
+   expected_count=n;expected_type=type;expected_alert=alert;expected_timeout=&timeout;calls=0;queue_it=queue;wait_next=next;apc_calls=0;observed=state.b;observed_objects=objects;
+   assert(XeKeWaitForMultipleObjects(n,objects,type,6,0,alert,&timeout,state.b)==outcome);checks++;
+   assert(calls==1 && !wait_next && apc_calls==(outcome==STATUS_USER_APC));checks++;
+   assert(memcmp(state.a,old.a,sizeof(state.a))==0&&memcmp(state.c,old.c,sizeof(state.c))==0);checks++;
+   unsigned prefix=(!queue&&type==WaitAny&&result<2*n)?result%n:n;
+   for(unsigned i=0;i<n;i++){
+    assert(objects[i]==(PVOID)(uintptr_t)(0x200100+i*0x400));checks++;
+    if(i>=prefix){assert(memcmp(&state.b[i],&old.b[i],sizeof(KWAIT_BLOCK))==0);checks++;continue;}
+    assert(state.b[i].Thread==NxkThreadPublicPointer(Current)&&state.b[i].Object==objects[i]&&state.b[i].WaitType==type&&state.b[i].SpareByte==0&&state.b[i].WaitKey==i);checks++;
+    if(!queue){assert(state.b[i].NextWaitBlock==((type==WaitAll&&(outcome==0||outcome==0x80))?&state.b[(i+1)%n]:&state.b[i+1]));checks++;assert(memcmp(&state.b[i].WaitListEntry,&old.b[i].WaitListEntry,sizeof(LIST_ENTRY))==0);checks++;}
+    else {assert(state.b[i].WaitListEntry.Flink==(void *)0x700000);checks++;}
+   }
+   assert(memcmp(&state.b[n],&old.b[n],sizeof(KWAIT_BLOCK)*(64-n))==0);checks++;
+  }
+ }
+ for(unsigned n=1;n<=2;n++)for(unsigned apc=0;apc<2;apc++) {
+  PVOID objects[]={(PVOID)0x200100,(PVOID)0x200500};int64_t timeout=0;
+  outcome=apc?STATUS_USER_APC:0x102;expected_count=n;expected_type=WaitAny;expected_alert=1;expected_timeout=&timeout;calls=0;queue_it=0;wait_next=0;apc_calls=0;observed=NULL;
+  assert(XeKeWaitForMultipleObjects(n,objects,WaitAny,6,0,1,&timeout,NULL)==outcome);checks++;
+  assert(calls==1&&apc_calls==apc);checks++;
+  calls=apc_calls=0;objects[0]=(PVOID)0x200000;objects[1]=(PVOID)0x200400;
+  assert(KeWaitForMultipleObjects(n,objects,WaitAny,6,0,1,&timeout,NULL)==outcome);checks++;
+  assert(calls==1&&apc_calls==apc);checks++;
+ }
+ puts("production wait adapter: immediate prefixes, full WaitAll/timeout/alert, queued success, guards and 64-object bound passed");
+ printf("wait_adapter_checks=%u\n",checks);return 0;
+}
+'''
+(here/'wait-adapter-host.c').write_text(pre+body+post)
+subprocess.run(['cc','-m32','-std=c11','-O1','-g','-fsanitize=address,undefined','-fno-omit-frame-pointer',str(here/'wait-adapter-host.c'),'-o',str(here/'wait-adapter-host')],check=True)
+subprocess.run([str(here/'wait-adapter-host')],check=True)
