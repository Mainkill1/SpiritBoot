+BOOLEAN NTAPI XeKeSetDisableBoostThread(PVOID Pointer, BOOLEAN Disable)
+{
+    PKTHREAD Thread = NxkResolveThreadPointer(Pointer);
+    BOOLEAN Previous;
+    KIRQL OldIrql = KeRaiseIrqlToDpcLevel();
+    Previous = KeSetDisableBoostThread(Thread, Disable);
+    NxkPublishThreadControls(Thread);
+    KeLowerIrql(OldIrql);
+    return Previous;
+}
