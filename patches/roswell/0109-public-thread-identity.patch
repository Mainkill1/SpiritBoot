+     assert(NxkResolveThreadPointer(t)==((i&1)?t:NULL));checks++;
+   }
+   for(unsigned i=0;i<COUNT;i+=2)register_thread(&threads[i]);
+ }
+ assert(NxkResolveThreadPointer(threads[1].XeXboxShadow)==&threads[1]);checks++;
+ NxkDeleteThreadView(&threads[0]);
+ assert(NxkThreadViewCachedPublic==threads[1].XeXboxShadow);checks++;
+ register_thread(&threads[0]);
+ current_thread=&threads[1];unsigned before=irq_entries;
+ assert(NxkResolveThreadPointer(current_thread->XeXboxShadow)==current_thread);checks++;
+ assert(NxkResolveThreadPointer(current_thread)==current_thread);checks++;
+ assert(irq_entries==before);checks++;current_thread=NULL;
+ irq_flags=2;
+ assert(NxkResolveThreadPointer(threads[1].XeXboxShadow)==&threads[1]);checks++;
+ assert(irq_flags==2);checks++;
+ for(unsigned i=0;i<COUNT;i++)NxkDeleteThreadView(&threads[i]);
+ assert(NxkThreadViewCachedPublic==NULL);checks++;
+ for(unsigned b=0;b<VIEW_BUCKETS;b++){assert(NxkThreadViews[b].Flink==&NxkThreadViews[b]);checks++;}
+ NxkDeleteThreadView(&threads[0]);assert(irq_flags==2);checks++;
+ /* Firmware pool buckets produce highly aligned body addresses. Measure
+  * collision counts for synthetic 1KiB objects without dereferencing them. */
+ for(unsigned n=8;n<=512;n*=2) {
+  memset(hist,0,sizeof(hist));max_chain=0;
+  for(unsigned i=0;i<n;i++)hist[NxkViewBucket(0xd0000018u+i*1024u+0x1b4u)]++;
+  for(unsigned b=0;b<VIEW_BUCKETS;b++)if(hist[b]>max_chain)max_chain=hist[b];
+  printf("aligned_native_objects=%u buckets=%u max_chain=%u\\n",n,VIEW_BUCKETS,max_chain);
+ }
+ printf("registry_checks=%u irq_sections=%u passed\\n",checks,irq_entries);
+ return 0;
+}
+'''
+(here/'registry-host.c').write_text(pre+registry+function('NxkDeleteThreadView')+post)
+subprocess.run(['cc','-std=c11','-O1','-g','-fsanitize=address,undefined','-fno-omit-frame-pointer',str(here/'registry-host.c'),'-o',str(here/'registry-host')],check=True)
+subprocess.run([str(here/'registry-host')],check=True)
diff --git a/tests/host/thread-view/check-wait-adapter.py b/tests/host/thread-view/check-wait-adapter.py
