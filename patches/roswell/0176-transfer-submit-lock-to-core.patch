diff --git a/drivers/storage/class/nxstorage/request.h b/drivers/storage/class/nxstorage/request.h
index 4f264aa7..1a4b70a9 100644
--- a/drivers/storage/class/nxstorage/request.h
+++ b/drivers/storage/class/nxstorage/request.h
@@ -12,6 +12,9 @@ typedef enum nx_status {
 typedef enum nx_operation { NX_READ, NX_WRITE, NX_FLUSH } nx_operation;
 typedef enum nx_cache { NX_CACHE_DISABLED, NX_CACHE_ENABLED, NX_CACHE_UNQUALIFIED } nx_cache;
 enum { NX_LOWER_QUEUE_FROZEN=1 };
+/* submit() may return with the port state lock held.  The request core then
+ * consumes that ownership without calling enter() and always calls leave(). */
+enum { NX_SUBMIT_PENDING=1, NX_SUBMIT_LOCK_HELD=2 };
 /* Valid only on NX_WRITE; one parent includes data and real durability sync. */
 enum { NX_WRITE_THROUGH=1 };
 
@@ -56,6 +59,8 @@ typedef struct nx_port {
     void (*enter)(void *);
     void (*leave)(void *);
     nx_status (*prepare)(void *, const nx_command *);
+    /* NX_SUBMIT_* bit mask.  LOCK_HELD transfers one enter/leave ownership
+     * to the request core; ports that return 0/1 retain the original ABI. */
     int (*submit)(void *, const nx_command *);
     void (*retire)(void *, const nx_command *);
     void (*cancel)(void *, const nx_command *);
