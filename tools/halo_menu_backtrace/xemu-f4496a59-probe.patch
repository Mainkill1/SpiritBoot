+/* Local diagnostic. Function PCs and optimized calling conventions were checked
+ * against f4496a59's xboxkrnl.unstripped.exe. No guest memory is written. */
+static uint32_t spirit_read32(CPUX86State *env, uint32_t address)
+{
+    uint8_t bytes[4];
+    if (!address || cpu_memory_rw_debug(env_cpu(env), address, bytes, 4, false)) {
+        return 0;
+    }
+    return ldl_le_p(bytes);
+}
+
+void helper_spirit_menu_trace(CPUX86State *env, uint32_t pc)
+{
+    uint32_t stack[10];
+    uint32_t irp = 0, mdl = 0, buffer = 0, length = 0;
+    uint32_t esp = env->regs[R_ESP];
+    for (int i = 0; i < 10; i++) {
+        stack[i] = spirit_read32(env, esp + i * 4);
+    }
+    if (pc == 0x8402815c) {
+        /* LTO-localized regparm(3): adapter, parent, operation. */
+        irp = env->regs[R_EDX];
+    } else if (pc == 0x840159f0) {
+        irp = env->regs[R_ECX]; /* exported fastcall */
+    } else if (pc == 0x840511a4) {
+        irp = stack[2]; /* port callback: cdecl */
+    }
+    if (irp) {
+        mdl = spirit_read32(env, irp + 0x6c);
+        if (mdl) {
+            buffer = spirit_read32(env, mdl + 0x10) +
+                     spirit_read32(env, mdl + 0x18);
+            length = spirit_read32(env, mdl + 0x14);
+        }
+    }
+    qemu_log_mask(LOG_GUEST_ERROR,
+        "spirit_menu pc=%08x ret=%08x eax=%08x ecx=%08x edx=%08x "
+        "a1=%08x a2=%08x a3=%08x a4=%08x a5=%08x a6=%08x a7=%08x a8=%08x "
+        "irp=%08x status=%08x info=%u iosb=%08x user=%08x "
+        "mdl=%08x buffer=%08x bytes=%u\n",
+        pc, stack[0], (uint32_t)env->regs[R_EAX],
+        (uint32_t)env->regs[R_ECX], (uint32_t)env->regs[R_EDX],
+        stack[1], stack[2], stack[3], stack[4], stack[5], stack[6], stack[7], stack[8],
+        irp, spirit_read32(env, irp + 0x10),
+        spirit_read32(env, irp + 0x14), spirit_read32(env, irp + 0x1c),
+        spirit_read32(env, irp + 0x30), mdl, buffer, length);
+}
